    (defun same-mod-wildcard (lst1 lst2)
      (declare (xargs :guard (and (true-listp lst1)
                                  (true-listp lst2)
                                  (equal (len lst1) (len lst2)))))
      (cond ((endp lst1) t)
            ((or (eq (car lst1) '*)
                 (eq (car lst2) '*))
             (same-mod-wildcard (cdr lst1) (cdr lst2)))
            ((equal (car lst1) (car lst2))
             (same-mod-wildcard (cdr lst1) (cdr lst2)))
            (t nil)))

  For example,

    (same-mod-wildcard '(a * c d *) '(a x c * d))
    =
    T

