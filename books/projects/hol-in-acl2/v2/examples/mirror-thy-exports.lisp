; This book displays the axioms generated by the translater on the mirror example.
; Specifically, it displays the encapsulate event generated by the
; import-theory call in mirror-thy.lisp.  Comments below explain that event and
; its groups of events, which may be viewed as the axioms exported by that
; encapsulate event.

(in-package "ZF")

; Include the book that imports the translator output into ACL2.
(include-book "mirror-thy")

; The next form guarantees that the encapsulate form below is already present
; upon evaluating the include-book form above.
(set-enforce-redundancy t)

; To generate the next two forms, start ACL2 in this directory and evaluate the
; following five forms.  The final two forms (the fourth and fifth) will print
; out the defun and encapsulate forms below, respectively, though below we have
; added comments to the latter and modified whitespace.

; (ld "cert.acl2")
; (rebuild "mirror-thy.lisp" t)
; (in-package "ZF")
; :pe hol::mirror$prop

; The first argument of encapsulate is the list of signatures of function
; symbols introduced.  The other arguments can be divided into groups as
; explained in comments below.

(ENCAPSULATE (((HOL::MIRROR$PROP) => *)
              ((HOL::NODE *) => *)
              ((HOL::LEAF *) => *)
              ((HOL::BTREE_CASE *) => *)
              ((HOL::BTREE_SIZE *) => *)
              ((HOL::BTREE_LEAF_PROJ *) => *)
              ((HOL::BTREE_NODE_PROJ_1 *) => *)
              ((HOL::BTREE_NODE_PROJ_2 *) => *)
              ((HOL::BTREE_NODE_PROJ_3 *) => *)
              ((HOL::MIRROR *) => *)
              ((HOL::BTREE$VALUE) => *))
  (LOCAL (DEFUN HOL::MIRROR$PROP NIL NIL))
  (LOCAL (DEFUN HOL::BTREE$VALUE NIL (OMEGA)))
  (LOCAL (DEFUN HOL::NODE (X) X))
  (LOCAL (DEFUN HOL::LEAF (X) X))
  (LOCAL (DEFUN HOL::BTREE_CASE (X) X))
  (LOCAL (DEFUN HOL::BTREE_SIZE (X) X))
  (LOCAL (DEFUN HOL::BTREE_LEAF_PROJ (X) X))
  (LOCAL (DEFUN HOL::BTREE_NODE_PROJ_1 (X) X))
  (LOCAL (DEFUN HOL::BTREE_NODE_PROJ_2 (X) X))
  (LOCAL (DEFUN HOL::BTREE_NODE_PROJ_3 (X) X))
  (LOCAL (DEFUN HOL::MIRROR (X) X))
  (DEFUN HOL::MIRROR$HTA NIL
    (APPEND (LIST (LIST* :BTREE (HOL::BTREE$VALUE) 1))
            (HTA0)))
  (DEFTHM
    HOL::ALIST-SUBSETP-MIRROR$HTA-IMPLIES-ALIST-SUBSETP-HTA0
    (IMPLIES (ALIST-SUBSETP (HOL::MIRROR$HTA) HTA)
             (ALIST-SUBSETP (HTA0) HTA))
    :HINTS (("Goal" :IN-THEORY (E/D (HTA0) (APPEND))))
    :RULE-CLASSES :FORWARD-CHAINING)
  (DEFTHMZ HOL::HTAP-MIRROR$HTA
    (IMPLIES (FORCE (HOL::MIRROR$PROP))
             (HTAP (HOL::MIRROR$HTA)))
    :PROPS (HTA-PROP))
  (DEFTHM HOL::MIRROR$PROP-IMPLIES-ZFC
    (IMPLIES (HOL::MIRROR$PROP) (ZFC))
    :RULE-CLASSES :FORWARD-CHAINING)
  (DEFTHM HOL::MIRROR$PROP-IMPLIES-PROD2$PROP
    (IMPLIES (HOL::MIRROR$PROP)
             (PROD2$PROP))
    :RULE-CLASSES :FORWARD-CHAINING)
  (DEFTHM HOL::MIRROR$PROP-IMPLIES-DOMAIN$PROP
    (IMPLIES (HOL::MIRROR$PROP)
             (DOMAIN$PROP))
    :RULE-CLASSES :FORWARD-CHAINING)
  (DEFTHM HOL::MIRROR$PROP-IMPLIES-INVERSE$PROP
    (IMPLIES (HOL::MIRROR$PROP)
             (INVERSE$PROP))
