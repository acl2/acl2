             (FUN-SPACE$PROP))
    :RULE-CLASSES :FORWARD-CHAINING)
  (DEFTHM HOL::NODE$TYPE
    (IMPLIES
     (FORCE (HOL::MIRROR$PROP))
     (AND
      (HPP (HOL::NODE (TYP (:ARROW* (:BTREE HOL::A)
                                    HOL::A (:BTREE HOL::A)
                                    (:BTREE HOL::A))))
           (HOL::MIRROR$HTA))
      (EQUAL
       (HP-TYPE (HOL::NODE (TYP (:ARROW* (:BTREE HOL::A)
                                         HOL::A (:BTREE HOL::A)
