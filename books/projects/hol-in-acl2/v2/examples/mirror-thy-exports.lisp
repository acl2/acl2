    :RULE-CLASSES :FORWARD-CHAINING)
  (DEFTHM HOL::MIRROR$PROP-IMPLIES-RESTRICT$PROP
    (IMPLIES (HOL::MIRROR$PROP)
             (RESTRICT$PROP))
    :RULE-CLASSES :FORWARD-CHAINING)
  (DEFTHM HOL::MIRROR$PROP-IMPLIES-FUN-SPACE$PROP
