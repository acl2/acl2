(in-package "ZF")

; See README.txt for relevant background.

; The goal in this book is to prove (DEFGOAL pair_fst_snd_eq ...) as displayed
; in a comment at the end of ex1-thy.lisp.  That goal is stated in the ZF
; package as the final theorem, HOL{pair_fst_snd_eq}, in the present book; it
; is redundantly phrased in terms of DEFGOAL in ex1-top.lisp.

; Although hol::HOL{pair_fst_snd_eq} is a bit of a nightmare to read, we can
; get a prettier picture as follows.

;  (include-book "../acl2/hol-pprint")
;  (include-book "ex1-thy")
;  (in-package "HOL")

; And then, applying hol-pprint to the quotation of the conclusion of the
; IMPLIES in that theorem -- that is, evaluating
;   (hol-pprint '(equal (hp= ...) (hp-true)))
; --  returns:

#|
(EQUAL (= (AND (= (FST P) (FST Q))
               (= (SND P) (SND Q)))
          (= P Q))
       HP-TRUE)
|#

; Import the translator output into ACL2:
(include-book "ex1-thy")

; Include a book of general lemmas, developed during the proof in
; eval-poly-proof.lisp and reusable here and elsewhere.
(include-book "../acl2/lemmas")

; Include the set-theory library (redundantly).
(include-book "projects/set-theory/top" :dir :system)

; Prove some necessary lemmas.

#!hol
(DEFTHM HOL{pair_fst_snd_eq}-lemma

; This lemma is stated in a way that supports the application of HOL::HOL{FST},
; which may be found in ex1-thy-exports.lisp.

  (let ((p (hp-comma p1 p2))
        (q (hp-comma q1 q2)))
    (implies
     (and (alist-subsetp (ex1$hta) hta)
          (hpp p hta)
          (equal (hp-type p) (typ (:hash a b)))
          (hpp q hta)
          (equal (hp-type q) (typ (:hash a b)))
          (force (ex1$prop)))
     (equal (hp= (hp-and (hp= (hap* (fst (typ (:arrow* (:hash a b) a))) p)
                              (hap* (fst (typ (:arrow* (:hash a b) a))) q))
                         (hp= (hap* (snd (typ (:arrow* (:hash a b) b))) p)
                              (hap* (snd (typ (:arrow* (:hash a b) b))) q)))
                 (hp= p q))
            (hp-true))))
  :rule-classes acl2::nil)

(defthmz hpp-hp-comma
; This lemma isn't necessary for the proof of hol::hol{pair_fst_snd_eq}, but it
; cut the times for that proof down by a bit.
  (equal (hpp (hp-comma x y) hta)
         (and (hpp x hta)
              (hpp y hta)))
  :props (zfc prod2$prop))

; The following is generated by the form
;   (DEFGOAL PAIR_FST_SND_EQ ...)
; in the superior book, ex1-top.lisp.
#!hol
(DEFTHM HOL{pair_fst_snd_eq}
  (implies
   (and (alist-subsetp (ex1$hta) hta)
        (hpp p hta)
        (equal (hp-type p) (typ (:hash a b)))
        (hpp q hta)
        (equal (hp-type q) (typ (:hash a b)))
        (force (ex1$prop)))
   (equal (hp= (hp-and (hp= (hap* (fst (typ (:arrow* (:hash a b) a))) p)
                            (hap* (fst (typ (:arrow* (:hash a b) a))) q))
                       (hp= (hap* (snd (typ (:arrow* (:hash a b) b))) p)
                            (hap* (snd (typ (:arrow* (:hash a b) b))) q)))
               (hp= p q))
          (hp-true)))
  :hints (("Goal"
           :use ((:instance HOL{pair_fst_snd_eq}-lemma
                            (p1 (hp-hash-car p))
                            (p2 (hp-hash-cdr p))
                            (q1 (hp-hash-car q))
                            (q2 (hp-hash-cdr q)))))))
