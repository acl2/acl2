#!/bin/sh

# Sizing comes from the environment, so the same launcher works on any host:
#
#   MILAWA_CCL                 CCL executable               (default: ccl)
#   MILAWA_CCL_THREAD_STACK    listener control/value stack (default: 128M)
#   MILAWA_CCL_STACK           initial control stack        (default: 128M)
#
# CCL has no separate "binding stack": special bindings live on the value
# stack, which -Z sizes.  The kernel images already carry 128 MB defaults from
# milawa.lsp, so these settings are only needed for extra headroom.

CCL="${MILAWA_CCL:-ccl}"
CCL_THREAD_STACK="${MILAWA_CCL_THREAD_STACK:-128M}"
CCL_STACK="${MILAWA_CCL_STACK:-128M}"

if [ "$#" -ne "1" ]
then
	echo "Usage: milawa-ccl <IMAGE-FILE>"
	echo "Where <IMAGE-FILE> is the name of a CCL image to use, typically a"
	echo "\".ccl-<platform>\" file, such as \"base.ccl-linux-aarch64\"."
	exit 1
fi

if ! command -v "$CCL" >/dev/null 2>&1
then
	echo "Error: CCL not found."
	echo ""
	echo "Possible causes:"
	echo "  - Clozure Common Lisp is not installed?"
	echo "  - CCL is not in your current \$PATH?"
	echo "  - CCL is in your path, but is not named '$CCL'?"
	echo "  - CCL is in your path and is named '$CCL', but is not executable?"
	echo ""
	echo "Possible fixes:"
	echo "  - Add a symlink to CCL named '$CCL' somewhere in your \$PATH?"
	echo "  - Set MILAWA_CCL to the name of your CCL executable?"
	echo "  - Make sure you can start CCL by typing '$CCL'"
	echo ""
	exit 1
fi

exec "$CCL" --batch \
     -Z "$CCL_THREAD_STACK" \
     -S "$CCL_STACK" \
     -I "$1"

