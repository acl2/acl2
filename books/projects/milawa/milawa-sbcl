#!/bin/sh

# Sizing comes from the environment, so one script works on any host:
#
#   MILAWA_SBCL                SBCL executable              (default: sbcl)
#   MILAWA_SBCL_DYNAMIC_SPACE  heap size, in MB             (default: 32000)
#   MILAWA_SBCL_CONTROL_STACK  control stack size, in MB    (default: 1024)
#   SBCL_USER_ARGS             extra SBCL arguments, appended last
#
# The *binding* stack cannot be set here: it is a compile-time constant of the
# SBCL runtime.

SBCL="${MILAWA_SBCL:-sbcl}"

if [ "$#" -ne "1" ]
then
	echo "Usage: milawa-sbcl <IMAGE-FILE>"
	echo "Where <IMAGE-FILE> is the name of an SBCL image to use, typically a"
	echo "\".sbcl-image\" file, such as \"milawa.sbcl-image\"."
	exit 1
fi

if [ -z "`which $SBCL`" ]
then
	echo "Error: SBCL not found."
	echo ""
	echo "Possible causes:"
	echo "  - SBCL is not installed?"
	echo "  - SBCL is not in your current \$PATH?"
	echo "  - SBCL is in your path, but is not named '$SBCL'?"
	echo "  - SBCL is in your path and is named '$SBCL', but is not executable?"
	echo ""
	echo "Possible fixes:"
	echo "  - Add a symlink to SBCL named '$SBCL' somewhere in your \$PATH?"
	echo "  - Edit the milawa-sbcl shell script and change SBCL=\"...\" to the name"
	echo "    of your SBCL executable?"
	echo "  - Make sure you can start SBCL by typing '$SBCL'"
	echo ""
fi

exec "$SBCL" --dynamic-space-size "${MILAWA_SBCL_DYNAMIC_SPACE:-32000}" \
             --control-stack-size "${MILAWA_SBCL_CONTROL_STACK:-1024}" \
             --noinform $SBCL_USER_ARGS --core "$1"
