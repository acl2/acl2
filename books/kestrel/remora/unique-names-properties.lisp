(in-package "REMORA")

(include-book "unique-names")
(include-book "abstract-syntax-core")

(include-book "portcullis")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defxdoc+ unique-names-properties
  :parents (unique-names)
  :short "Properties of the uniquification of binder names."
  :long
  (xdoc::topstring
   (xdoc::p
    "Here we prove that @(tsee expr-uniquify-names) preserves membership in
     the core subset of the abstract syntax (see @(see abstract-syntax-core)):
     if an expression satisfies @(tsee expr-corep), so does its
     uniquification.  This is @(tsee expr-corep-of-expr-uniquify-names).")
   (xdoc::p
    "The reason the property holds is that uniquification is
     kind-preserving: every case of @(tsee uniq-expr) and its companions
     rebuilds the AST node with the same constructor it took apart,
     changing only binder names, the variable occurrences that the
     renamings map, and the type and ispace components that the renaming
     operations of @(see variable-renaming-operations) rewrite --- and
     those operations are kind-preserving for the same reason, since they
     are generated by @(tsee fty::deffold-map).  Since @(tsee ast-corep)
     is a fold that depends only on the kinds of the nodes and on the
     lengths of the dimension lists of shapes, none of this can take an
     AST out of the core.")
   (xdoc::p
    "So the proof is in two layers: first that the renaming operations
     preserve the core predicates, then the main induction over the
     uniquification clique, which consumes the first layer at the type,
     ispace, and parameter components of the binders it descends through.")
   (xdoc::p
    "The non-core AST kinds need no attention in either layer: the core
     predicates are unconditionally @('nil') on them, so the hypothesis of
     each theorem is false in those cases."))
  :order-subtopics t
  :default-parent t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; First layer: the renaming operations preserve the core predicates.
;
; The only case in which the core predicate looks at anything beyond the
; kind of a node is a shape built from a list of dimensions, which is in
; the core exactly when that list is a singleton.  Renaming dimension
; variables maps the list elementwise, so the two CONSP facts below are
; all the shape case needs; they are stated in the CONSP form in which
; the goals arise, rather than via LEN.

(defruled consp-of-cdr-of-dim-list-rename-dim-vars
  :short "The renaming of a list of dimensions has more than one element
          exactly when the original does."
  (equal (consp (cdr (dim-list-rename-dim-vars dims renam)))
         (consp (cdr dims)))
  :enable (dim-list-rename-dim-vars
           consp-of-dim-list-rename-dim-vars))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Renaming ispace variables preserves the core shape and ispace predicates.

(defret-mutual ispace-corep-of-ispace-rename-ispace-vars
  (defret shape-corep-of-shape-rename-ispace-vars
    (implies (shape-corep shape)
             (shape-corep result))
    :fn shape-rename-ispace-vars)
  (defret shape-list-corep-of-shape-list-rename-ispace-vars
    (implies (shape-list-corep shape-list)
             (shape-list-corep result))
    :fn shape-list-rename-ispace-vars)
  (defret ispace-corep-of-ispace-rename-ispace-vars
    (implies (ispace-corep ispace)
             (ispace-corep result))
    :fn ispace-rename-ispace-vars)
  (defret ispace-list-corep-of-ispace-list-rename-ispace-vars
    (implies (ispace-list-corep ispace-list)
             (ispace-list-corep result))
    :fn ispace-list-rename-ispace-vars)
  :mutual-recursion shapes/ispaces-rename-ispace-vars
  :hints (("Goal" :in-theory (enable shape-rename-ispace-vars
                                     shape-list-rename-ispace-vars
                                     ispace-rename-ispace-vars
                                     ispace-list-rename-ispace-vars
                                     shape-corep
                                     shape-list-corep
                                     ispace-corep
                                     ispace-list-corep
                                     consp-of-dim-list-rename-dim-vars
                                     consp-of-cdr-of-dim-list-rename-dim-vars))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The two type-level renamings.  The binder cases of types (:forall, :pi,
; :sigma) reduce the renaming maps before descending, but that only
; changes which names are mapped, not the shape of the result, so the
; induction goes through with no additional facts about the reductions.

(defret-mutual type-corep-of-type-rename-ispace-vars
  (defret type-corep-of-type-rename-ispace-vars
    (implies (type-corep type)
             (type-corep result))
    :fn type-rename-ispace-vars)
  (defret type-list-corep-of-type-list-rename-ispace-vars
    (implies (type-list-corep type-list)
             (type-list-corep result))
    :fn type-list-rename-ispace-vars)
  :mutual-recursion types-rename-ispace-vars
  :hints (("Goal" :in-theory (enable type-rename-ispace-vars
                                     type-list-rename-ispace-vars
                                     type-corep
                                     type-list-corep))))

(defret-mutual type-corep-of-type-rename-type-vars
  (defret type-corep-of-type-rename-type-vars
    (implies (type-corep type)
             (type-corep result))
    :fn type-rename-type-vars)
  (defret type-list-corep-of-type-list-rename-type-vars
    (implies (type-list-corep type-list)
             (type-list-corep result))
    :fn type-list-rename-type-vars)
  :mutual-recursion types-rename-type-vars
  :hints (("Goal" :in-theory (enable type-rename-type-vars
                                     type-list-rename-type-vars
                                     type-corep
                                     type-list-corep))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The optional-type wrappers, and then the bundled renamings applied by
; the uniquification, which are just the composition of the ispace and
; type renamings above (expression variables do not occur in types).

(defrule type-option-corep-of-type-option-rename-ispace-vars
  :short "Renaming ispace variables preserves the core optional-type
          predicate."
  (implies (type-option-corep ty?)
           (type-option-corep
            (type-option-rename-ispace-vars ty? dim-renam shape-renam)))
  :enable (type-option-rename-ispace-vars
           type-option-corep))

(defrule type-option-corep-of-type-option-rename-type-vars
  :short "Renaming type variables preserves the core optional-type
          predicate."
  (implies (type-option-corep ty?)
           (type-option-corep
            (type-option-rename-type-vars ty? atom-renam array-renam)))
  :enable (type-option-rename-type-vars
           type-option-corep))

(defrule type-corep-of-type-rename-all-vars
  :short "Applying all the renamings to a type preserves the core type
          predicate."
  (implies (type-corep ty)
           (type-corep (type-rename-all-vars ty r)))
  :enable type-rename-all-vars)

(defrule type-option-corep-of-type-option-rename-all-vars
  :short "Applying all the renamings to an optional type preserves the
          core optional-type predicate."
  (implies (type-option-corep ty?)
           (type-option-corep (type-option-rename-all-vars ty? r)))
  :enable type-option-rename-all-vars)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Second layer: the uniquification itself.
;
; Each case rebuilds its node with the same constructor, so the core
; predicate of the result unfolds to the core predicates of the renamed
; and recursively uniquified components, which are supplied by the
; induction hypotheses and by the first layer.  The parameter freshening
; helpers (UNIQ-EXPR-PARAMS, UNIQ-TYPE-VAR-PARAMS, UNIQ-ISPACE-VAR-PARAMS)
; occur only in the cases of non-core kinds, except for the single ispace
; variable of an :UNBOX, which the core predicate does not look at.

(defret-mutual uniquify-names-impl-corep
  (defret expr-corep-of-uniq-expr
    (implies (expr-corep x)
             (expr-corep new-x))
    :fn uniq-expr)
  (defret expr-list-corep-of-uniq-expr-list
    (implies (expr-list-corep x)
             (expr-list-corep new-x))
    :fn uniq-expr-list)
  (defret atom-corep-of-uniq-atom
    (implies (atom-corep x)
             (atom-corep new-x))
    :fn uniq-atom)
  (defret atom-list-corep-of-uniq-atom-list
    (implies (atom-list-corep x)
             (atom-list-corep new-x))
    :fn uniq-atom-list)
  (defret bind-corep-of-uniq-bind
    (implies (bind-corep x)
             (bind-corep new-x))
    :fn uniq-bind)
  (defret bind-list-corep-of-uniq-bind-list
    (implies (bind-list-corep x)
             (bind-list-corep new-x))
    :fn uniq-bind-list)
  :mutual-recursion uniquify-names-impl
  :hints (("Goal" :in-theory (enable uniq-expr
                                     uniq-expr-list
                                     uniq-atom
                                     uniq-atom-list
                                     uniq-bind
                                     uniq-bind-list
                                     expr-corep
                                     expr-list-corep
                                     atom-corep
                                     atom-list-corep
                                     bind-corep
                                     bind-list-corep
                                     var+type?-corep))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defrule expr-corep-of-expr-uniquify-names
  :short "Uniquifying the binder names of a core expression
          yields a core expression."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the promised property: @(tsee expr-uniquify-names) can be
     applied to a program in the core subset of the abstract syntax
     without leaving that subset."))
  (implies (expr-corep expr)
           (expr-corep (expr-uniquify-names expr)))
  :enable expr-uniquify-names)
