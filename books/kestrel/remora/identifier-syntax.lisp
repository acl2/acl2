(defxdoc+ identifier-syntax
  :parents (concrete-syntax)
  :short "Syntactic constraints on Remora identifiers."
  :long
  (xdoc::topstring
   (xdoc::p
    "The Remora grammar's @('identifier') rule plus its side condition
     [SC2] together impose constraints on the text of an identifier:
     leading and continuation code points must come from specific
     character classes, and the resulting text must not match a
     reserved keyword.  This file collects those constraints in three
     categories, so that downstream consumers can use them without
     pulling in the parser.")
   (xdoc::p
    (xdoc::b "Code-point class predicates."))
   (xdoc::ul
    (xdoc::li
     "@(tsee non-asciip) &mdash; non-ASCII non-whitespace non-surrogate
      code point.")
    (xdoc::li
     "@(tsee id-startp) &mdash; valid identifier start code point
      (mirrors the @('id-start') ABNF rule).")
    (xdoc::li
     "@(tsee id-continuep) &mdash; valid identifier continuation code
      point (mirrors @('id-continue'); strict superset of
      @(tsee id-startp), adding digits).")
    (xdoc::li
     "@(tsee id-continue-list-p) &mdash; list extension of
      @(tsee id-continuep): every code point in the list passes.")
    (xdoc::li
     "@(tsee dec-digitp) and @(tsee dec-digit-listp) &mdash; decimal
      digit code points, the class that suffixes of generated names
      are made of."))
   (xdoc::p
    (xdoc::b "Keyword exclusion."))
   (xdoc::ul
    (xdoc::li
     "@(tsee *remora-keywords-as-natlists*) &mdash; the list of
      reserved keywords as code-point sequences.  Single-character
      Unicode keywords (lambda, arrow, forall, etc.) appear as
      one-element lists.")
    (xdoc::li
     "@(tsee remora-keyword-p) &mdash; membership predicate."))
   (xdoc::p
    (xdoc::b "Identifier validators."))
   (xdoc::ul
    (xdoc::li
     "@(tsee valid-identifier-codepoints-p) &mdash; checks a code-point
      list: non-empty, first is @(tsee id-startp), rest are
      @(tsee id-continuep), and the whole sequence is not a keyword.")
    (xdoc::li
     "@(tsee valid-identifier-string-p) &mdash; the user-facing
      string predicate: UTF-8 decodes to a list satisfying
      @(tsee valid-identifier-codepoints-p)."))
   (xdoc::p
    "Consumers within Remora:")
   (xdoc::ul
    (xdoc::li
     "@(tsee parser) consults @(tsee id-startp) and @(tsee id-continuep)
      when parsing the @('identifier') ABNF rule.")
    (xdoc::li
     "@(tsee post-parsing) consults @(tsee *remora-keywords-as-natlists*)
      and @(tsee remora-keyword-p) when walking a CST to enforce
      [SC2].")
    (xdoc::li
     "The AST-level well-formedness predicates @('xxx-wfp') consult
      @(tsee valid-identifier-string-p) on the identifiers stored inside
      AST nodes.  For example, @(tsee bind-wfp) and
      @(tsee expr-wfp).")))
  :order-subtopics t
  :default-parent t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Code-point class predicates.
;;
;; non-asciip, id-startp, and id-continuep mirror the corresponding
;; rules of grammar.abnf.  They are hand-written rather than
;; auto-generated because each rule has 9-13 range alternatives, which
;; cause combinatorial proof blowup when generated by ABNF tooling.
;; id-continue-list-p is a small list extension of id-continuep.
;; dec-digitp and dec-digit-listp single out the decimal digits, the
;; class of code points that suffixes of generated names are made of
;; (see the identifier extension theorems further down).
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define non-asciip ((nat natp))
  :returns (yes/no booleanp)
  :short "Check if a natural number is a non-ASCII non-whitespace
          non-surrogate code point."
  :long
  (xdoc::topstring
   (xdoc::p
    "Mirrors the @('non-ascii') rule of @('grammar.abnf'), which lists
     the Unicode ranges outside ASCII (above @('#x7F')) that are
     not whitespace per Haskell's @('Data.Char.isSpace') and are not
     surrogates."))
  (b* ((nat (nfix nat)))
    (or (and (<= #x80 nat) (<= nat #x9F))
        (and (<= #xA1 nat) (<= nat #x167F))
        (and (<= #x1681 nat) (<= nat #x1FFF))
        (and (<= #x200B nat) (<= nat #x2027))
        (and (<= #x202A nat) (<= nat #x202E))
        (and (<= #x2030 nat) (<= nat #x205E))
        (and (<= #x2060 nat) (<= nat #x2FFF))
        (and (<= #x3001 nat) (<= nat #xD7FF))
        (and (<= #xE000 nat) (<= nat #x10FFFF)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define id-startp ((nat natp))
  :returns (yes/no booleanp)
  :short "Check if a natural number is a valid identifier start code point."
  :long
  (xdoc::topstring
   (xdoc::p
    "Mirrors the @('id-start') rule of @('grammar.abnf').  The ASCII
     ranges below are the complement of the disallowed characters
     (whitespace and @('( ) [ ] @{ @} \" , ' ` ; # | \\\\ @@'),
     plus digits, which are excluded only at the start) within the
     printable ASCII range @('#x21')&ndash;@('#x7E').  Plus C0 control
     characters except whitespace (@('#x00')&ndash;@('#x08'),
     @('#x0E')&ndash;@('#x1F')) and DEL (@('#x7F')), and the
     @(tsee non-asciip) range."))
  (b* ((nat (nfix nat)))
    (or (and (<= #x00 nat) (<= nat #x08))
        (and (<= #x0E nat) (<= nat #x1F))
        (eql nat #x21)
        (and (<= #x24 nat) (<= nat #x26))
        (and (<= #x2A nat) (<= nat #x2B))
        (and (<= #x2D nat) (<= nat #x2F))
        (eql nat #x3A)
        (and (<= #x3C nat) (<= nat #x3F))
        (and (<= #x41 nat) (<= nat #x5A))
        (and (<= #x5E nat) (<= nat #x5F))
        (and (<= #x61 nat) (<= nat #x7A))
        (and (<= #x7E nat) (<= nat #x7F))
        (non-asciip nat))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define id-continuep ((nat natp))
  :returns (yes/no booleanp)
  :short "Check if a natural number is a valid identifier continuation
          code point."
  :long
  (xdoc::topstring
   (xdoc::p
    "Mirrors the @('id-continue') rule of @('grammar.abnf').  The same
     classes as @(tsee id-startp), augmented with the digit range
     @('#x30')&ndash;@('#x39') (folded into the range
     @('#x2D')&ndash;@('#x3A')).  Digits are valid in identifier
     positions other than the first."))
  (b* ((nat (nfix nat)))
    (or (and (<= #x00 nat) (<= nat #x08))
        (and (<= #x0E nat) (<= nat #x1F))
        (eql nat #x21)
        (and (<= #x24 nat) (<= nat #x26))
        (and (<= #x2A nat) (<= nat #x2B))
        (and (<= #x2D nat) (<= nat #x3A))   ; includes digits and :
        (and (<= #x3C nat) (<= nat #x3F))
        (and (<= #x41 nat) (<= nat #x5A))
        (and (<= #x5E nat) (<= nat #x5F))
        (and (<= #x61 nat) (<= nat #x7A))
        (and (<= #x7E nat) (<= nat #x7F))
        (non-asciip nat))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define id-continue-list-p ((nats nat-listp))
  :returns (yes/no booleanp)
  :short "Check that every code point in a list satisfies @(tsee id-continuep)."
  (cond ((endp nats) t)
        ((not (id-continuep (car nats))) nil)
        (t (id-continue-list-p (cdr nats))))
  ///
  (defruled id-continue-list-p-of-append
    (equal (id-continue-list-p (append a b))
           (and (id-continue-list-p a)
                (id-continue-list-p b)))
    :induct (len a)
    :enable id-continue-list-p)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define dec-digitp (x)
  :returns (yes/no booleanp)
  :short "Check that a value is a decimal digit code point."
  (and (natp x)
       (<= 48 x)
       (<= x 57)))

(std::deflist dec-digit-listp (x)
  :short "Check that a list consists of decimal digit code points."
  (dec-digitp x)
  :true-listp t
  :elementp-of-nil nil)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defsection identifier-character-classes-relations
  :short "Relationships among the identifier character-class predicates."
  :long
  (xdoc::topstring
   (xdoc::p
    "An @('id-start') code point is also an @('id-continue') code
     point: the @('id-continue') class is a strict superset of
     @('id-start') (it adds the digits @('#x30')&ndash;@('#x39'))."))

  (defrule id-continuep-when-id-startp
    (implies (id-startp nat)
             (id-continuep nat))
    :enable (id-startp id-continuep)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Reserved keyword list (side condition [SC2]).
;;
;; The grammar's identifier rule accepts any
;; id-start *id-continue sequence, including reserved keywords.
;; The keyword list below names the strings that may not be used as
;; identifier values.  Single-character Unicode keywords (lambda,
;; arrow, forall, etc.) are encoded by their code point directly
;; rather than via string=>nats, since the latter only handles
;; char-codes 0-255.
;;
;; This list is consulted both by the CST-level walk
;; check-tree-no-keyword-identifiers (xdoc topic post-parsing) and
;; (planned) by the AST-level identifier validator.
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defval *remora-keywords-as-natlists*
  :short "List of Remora reserved keywords, as code-point sequences."
  :long
  (xdoc::topstring
   (xdoc::p
    "Each element is a list of @(tsee natp) Unicode code points, one
     per character of the keyword.  Single-character Unicode keywords
     (lambda U+03BB, t-lambda, i-lambda, rightwards arrow U+2192,
     forall U+2200, capital Pi U+03A0, capital Sigma U+03A3) appear
     by their code point directly rather than via @(tsee
     string=>nats), since the latter only handles char-codes
     0&ndash;255.  ASCII-only keywords use @(tsee string=>nats)
     for readability.")
   (xdoc::p
    "Side condition [SC2] of the grammar (see @('grammar.abnf')) says
     that no identifier may match a reserved keyword.  This list
     drives the membership predicate @(tsee remora-keyword-p) used by
     both the CST-level walk @(tsee check-tree-no-keyword-identifiers)
     and the AST-level @(tsee valid-identifier-codepoints-p)."))
  (list (string=>nats "array")
        (string=>nats "frame")
        (string=>nats "t-app")
        (string=>nats "i-app")
        (string=>nats "unbox")
        (string=>nats "box")
        (string=>nats "dims")
        (string=>nats "fn")
        (list #x03BB)            ; lambda
        (string=>nats "t-fn")
        (list (char-code #\t) #x03BB)  ; t + lambda
        (string=>nats "i-fn")
        (list (char-code #\i) #x03BB)  ; i + lambda
        (string=>nats "A")
        (string=>nats "->")
        (list #x2192)            ; rightwards arrow
        (string=>nats "Forall")
        (list #x2200)            ; for all
        (string=>nats "Pi")
        (list #x03A0)            ; Greek capital letter Pi
        (string=>nats "Sigma")
        (list #x03A3)            ; Greek capital letter Sigma
        (string=>nats "let")
        (string=>nats "type")
        (string=>nats "ispace")
        (string=>nats "fun")
        (string=>nats "t-fun")
        (string=>nats "i-fun")
        (string=>nats "val")
        (string=>nats "def")
        (string=>nats "entry")
        (string=>nats "import")))

(define remora-keyword-p (nats)
  :returns (yes/no booleanp)
  :short "Check if a list of code points matches a Remora keyword."
  (if (member-equal nats *remora-keywords-as-natlists*) t nil))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Identifier validators.
;;
;; valid-identifier-codepoints-p answers yes/no over a list of code
;; points; valid-identifier-string-p answers yes/no over an ACL2
;; string (decoding UTF-8 first).  The string-level predicate is the
;; user-facing entry point; the codepoint-level one is useful when
;; callers have already done UTF-8 decoding (e.g., during CST-to-AST
;; abstraction, where the parser has produced a code-point list before
;; the abstractor re-encodes the identifier as UTF-8 bytes for storage
;; in an ACL2 string).
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define valid-identifier-codepoints-p ((codepoints nat-listp))
  :returns (yes/no booleanp)
  :short "Check that a list of code points forms a valid Remora identifier."
  :long
  (xdoc::topstring
   (xdoc::p
    "The list must be non-empty.  Its first element must satisfy
     @(tsee id-startp), and all remaining elements must satisfy
     @(tsee id-continuep).  Finally, the list itself, viewed as a
     code-point sequence, must not match any reserved keyword
     in @(tsee *remora-keywords-as-natlists*) (side condition [SC2]
     in @('grammar.abnf'))."))
  (and (consp codepoints)
       (id-startp (car codepoints))
       (id-continue-list-p (cdr codepoints))
       (not (remora-keyword-p codepoints))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define valid-identifier-string-p ((str stringp))
  :returns (yes/no booleanp)
  :hooks nil
  :short "Check that an ACL2 string is a valid Remora identifier."
  :long
  (xdoc::topstring
   (xdoc::p
    "Treats @('str') as a sequence of UTF-8 bytes (ACL2 strings have
     char-codes 0&ndash;255), decodes it to a Unicode code-point
     sequence, and applies @(tsee valid-identifier-codepoints-p) to
     the result.  Returns @('nil') if the byte sequence is not valid
     UTF-8 or if any of the code-point-level checks fail."))
  (b* ((bytes (string=>nats (str-fix str)))
       ((unless (acl2::unsigned-byte-listp 8 bytes)) nil)
       (codepoints (acl2::utf8=>ustring bytes))
       ((unless (nat-listp codepoints)) nil))
    (valid-identifier-codepoints-p codepoints)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Identifier extension.
;;
;; Theorems for reasoning about identifiers extended with suffixes, and
;; in particular with decimal digit suffixes, which is how fresh
;; variants of existing names are generated (see
;; fresh-variable-operations).  The general fact is that appending
;; identifier continuation characters to a valid identifier yields a
;; valid identifier, provided the result is not a keyword; digits are
;; such characters, and no Remora keyword ends in a digit, so a digit
;; suffix also settles the keyword proviso.
;;
;; Since VALID-IDENTIFIER-STRING-P checks a string by decoding its bytes
;; as UTF-8, lifting the code-point-level facts to strings needs the
;; byte level as well: a digit suffix is ASCII, hence its own UTF-8
;; encoding, and UTF-8 is self-synchronizing, so decoding the bytes of
;; an extended identifier does not cross the boundary between the
;; original bytes and the suffix (see
;; UTF8=>USTRING-OF-APPEND-WHEN-UTF8-PARTITION in unicode/utf8-decode).
;;
;; All rewrite rules are left disabled: they are aimed at specific proofs
;; about name generation, not at general use.

; The one source of such suffixes: the decimal representation of an index,
; which is how fresh variants of existing names are generated (see
; fresh-variable-operations) and how the monomorphizer names the instances
; it creates (see monomorphize).  The two facts about it are stated
; separately, since they are used differently: that the bytes are digits
; is a rewrite rule, left disabled like the rest of this section, while
; that they are non-empty is a type-prescription rule, and so is left
; enabled for type reasoning to pick up on its own.

(defruled dec-digit-listp-of-string=>nats-of-nat-to-dec-string
  :short "The decimal representation of a natural number is a sequence of
          digit code points."
  (dec-digit-listp (acl2::string=>nats (str::nat-to-dec-string n)))
  :enable acl2::string=>nats
  :use ((:instance dec-digit-listp-of-chars=>nats-when-dec-digits
                   (chars (str::explode (str::nat-to-dec-string n)))))
  :prep-lemmas
  ((defruled dec-digit-listp-of-chars=>nats-when-dec-digits
     (implies (str::dec-digit-char-list*p chars)
              (dec-digit-listp (acl2::chars=>nats chars)))
     :induct (len chars)
     :enable (acl2::chars=>nats
              dec-digitp
              str::dec-digit-char-list*p
              str::dec-digit-char-p))))

(defrule consp-of-string=>nats-of-nat-to-dec-string
  :short "The decimal representation of a natural number is non-empty."
  (consp (acl2::string=>nats (str::nat-to-dec-string n)))
  :rule-classes :type-prescription
  :enable acl2::string=>nats
  :use ((:instance str::nat-to-dec-string-nonempty (str::n n))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defsection identifier-extension-theorems
  :short "Theorems about extending identifiers with suffixes."

  ;; The code-point level.

  (defruled valid-identifier-codepoints-p-of-append-id-continues
    (implies (and (valid-identifier-codepoints-p cps)
                  (id-continue-list-p d)
                  (not (remora-keyword-p (append cps d))))
             (valid-identifier-codepoints-p (append cps d)))
    :enable (valid-identifier-codepoints-p
             id-continue-list-p-of-append))

  ;; REMORA-KEYWORD-P is membership in a constant list, so the keyword
  ;; check on a given last code point is a finite computation.

  (defruled not-remora-keyword-p-of-append-digits
    (implies (and (dec-digit-listp d)
                  (consp d))
             (not (remora-keyword-p (append cps d))))
    :use ((:instance not-remora-keyword-p-when-last-is-digit
                     (cps (append cps d)))
          ;; That the last code point of D is a digit is
          ;; DEC-DIGITP-OF-CAR-WHEN-DEC-DIGIT-LISTP applied to
          ;; DEC-DIGIT-LISTP-OF-LAST, both generated by the DEFLIST.
          (:instance dec-digitp-of-car-when-dec-digit-listp (x (last d))))
    :enable last-of-append-when-consp
    :prep-lemmas
    ((defruled last-of-append-when-consp
       (implies (consp b)
                (equal (last (append a b)) (last b)))
       :induct (len a))
     (defruled not-remora-keyword-p-when-last-is-digit
       (implies (dec-digitp (car (last cps)))
                (not (remora-keyword-p cps)))
       :enable (remora-keyword-p dec-digitp))))

  ;; The byte level lives with the ASCII suffix theorems below
  ;; (UTF8-IDENTITY-WHEN-ASCII-ID-CONTINUE-LISTP) and with the general
  ;; UTF-8 theorems of unicode.lisp
  ;; (UTF8-PARTITION-WHEN-DECODING-SUCCEEDS, which is how
  ;; VALID-IDENTIFIER-STRING-P of an identifier supplies the other
  ;; hypothesis of the self-synchronization rule).
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Extending an identifier with an ASCII suffix.
;;
;; VALID-IDENTIFIER-STRING-P-OF-STRING-APPEND says when appending a
;; suffix string to an identifier string yields an identifier.  The
;; suffix must consist of ASCII identifier continuation characters: the
;; ASCII restriction makes the suffix its own UTF-8 encoding, which is
;; what lets the byte-level reasoning above (UTF-8 self-synchronization)
;; apply.  The decimal digit suffixes used by fresh-variable-operations
;; are a special case (see ASCII-ID-CONTINUE-LISTP-WHEN-DEC-DIGIT-LISTP).
;;
;; Validity is not preserved by such an extension unconditionally: the
;; extended text could be a reserved keyword (e.g. extending "le" with
;; "t" yields the keyword "let").  Hence the extra condition that the
;; result is not a keyword; it is a finite check, since
;; REMORA-KEYWORD-STRING-P is membership in a constant list.
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define ascii-id-continuep (x)
  :returns (yes/no booleanp)
  :short "Check that a value is an ASCII identifier continuation code point."
  :long
  (xdoc::topstring
   (xdoc::p
    "The code point must be below @('#x80') and satisfy
     @(tsee id-continuep).  The ASCII restriction is what makes a list of
     such code points its own UTF-8 encoding."))
  (and (natp x)
       (< x #x80)
       (id-continuep x)))

(std::deflist ascii-id-continue-listp (x)
  :short "Check that a list consists of ASCII identifier continuation
          code points."
  (ascii-id-continuep x)
  :true-listp t
  :elementp-of-nil nil)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define ascii-id-continue-string-p ((str stringp))
  :returns (yes/no booleanp)
  :hooks nil
  :short "Check that a string consists of ASCII identifier continuation
          characters."
  :long
  (xdoc::topstring
   (xdoc::p
    "Since the characters are ASCII, no UTF-8 decoding is needed: the
     bytes of the string are the code points."))
  (ascii-id-continue-listp (acl2::string=>nats (str-fix str))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(std::deflist ascii-id-continue-string-list-p (x)
  :short "Check that every string in a list consists of ASCII identifier
          continuation characters."
  (ascii-id-continue-string-p x)
  :guard (string-listp x)
  ;; NIL is fixed to the empty string, which passes vacuously.
  :elementp-of-nil t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define remora-keyword-string-p ((str stringp))
  :returns (yes/no booleanp)
  :hooks nil
  :short "Check whether an ACL2 string denotes a Remora reserved keyword."
  :long
  (xdoc::topstring
   (xdoc::p
    "The string-level counterpart of @(tsee remora-keyword-p):
     the string is decoded as UTF-8 (see @(tsee
     valid-identifier-string-p)) and the resulting code-point sequence
     is looked up in @(tsee *remora-keywords-as-natlists*)."))
  (remora-keyword-p (acl2::utf8=>ustring (acl2::string=>nats (str-fix str)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defsection ascii-id-continue-theorems
  :short "Theorems about ASCII identifier continuation suffixes."

  (defruled ascii-id-continue-listp-when-dec-digit-listp
    :short "Decimal digit suffixes are a special case of ASCII
            continuation suffixes."
    (implies (dec-digit-listp x)
             (ascii-id-continue-listp x))
    :induct (len x)
    :enable (dec-digitp ascii-id-continuep id-continuep))

  (defruled id-continue-list-p-when-ascii-id-continue-listp
    (implies (ascii-id-continue-listp x)
             (id-continue-list-p x))
    :induct (len x)
    :enable (ascii-id-continuep id-continue-list-p))

  ;; ASCII-ID-CONTINUE-LISTP-OF-APPEND is generated by the DEFLIST.

  (defruled ascii-id-continue-string-p-of-string-append
    (implies (and (stringp a)
                  (stringp b))
             (equal (ascii-id-continue-string-p (string-append a b))
                    (and (ascii-id-continue-string-p a)
                         (ascii-id-continue-string-p b))))
    :enable (ascii-id-continue-string-p
             acl2::string=>nats-of-string-append
             ascii-id-continue-listp-of-append)
    :disable string-append)

  ;; ASCII code points are a Unicode string that is its own UTF-8
  ;; encoding, so via the encode/decode round trip of unicode/utf8-decode
  ;; they partition and decode to themselves.

  (defruled utf8-identity-when-ascii-id-continue-listp
    (implies (ascii-id-continue-listp x)
             (and (mv-nth 0 (acl2::utf8-partition x))
                  (equal (acl2::utf8=>ustring x) x)))
    :use ((:instance acl2::utf8=>ustring-of-ustring=>utf8 (acl2::x x))
          ;; UTF8-PARTITION-OF-USTRING=>UTF8 is from unicode.lisp.
          (:instance utf8-partition-of-ustring=>utf8)
          (:instance ascii-ustring-when-ascii-id-continue-listp))
    :disable acl2::utf8=>ustring-of-ustring=>utf8
    :prep-lemmas
    ((defruled ascii-ustring-when-ascii-id-continue-listp
       (implies (ascii-id-continue-listp x)
                (and (acl2::ustring? x)
                     (equal (acl2::ustring=>utf8 x) x)))
       :induct (len x)
       ;; The recognizer's own case split is much cheaper here than the
       ;; DEFLIST rewrite rules.
       :enable (ascii-id-continue-listp ascii-id-continuep
                acl2::ustring? acl2::uchar?
                acl2::ustring=>utf8 acl2::uchar=>utf8))))

  ;; The string level.  The keyword condition is necessary, not an
  ;; artifact of the proof: extending "le" with "t" yields the keyword
  ;; "let", which is not a valid identifier.

  (defruled valid-identifier-string-p-of-string-append
    :short "Extending a valid identifier with ASCII continuation
            characters yields a valid identifier,
            unless the result is a reserved keyword."
    (implies (and (stringp id)
                  (stringp suffix)
                  (valid-identifier-string-p id)
                  (ascii-id-continue-string-p suffix)
                  (not (remora-keyword-string-p (string-append id suffix))))
             (valid-identifier-string-p (string-append id suffix)))
    :enable (remora-keyword-string-p
             ascii-id-continue-string-p
             valid-identifier-string-p
             acl2::string=>nats-of-string-append
             utf8-partition-when-decoding-succeeds
             utf8-identity-when-ascii-id-continue-listp
             valid-identifier-codepoints-p-of-append-id-continues
             id-continue-list-p-when-ascii-id-continue-listp)
    :disable string-append)

  ;; A suffix that contains a slash settles the keyword condition on
  ;; its own: no Remora keyword contains a slash, so no extension by
  ;; such a suffix is a keyword.  This is how the monomorphizer's
  ;; instance names are known to be identifiers (see
  ;; VALID-IDENTIFIER-STRING-P-OF-CFUN-INST-NAME in monomorphize).

  (defruled not-remora-keyword-p-when-member-slash
    (implies (member-equal #x2F cps)
             (not (remora-keyword-p cps)))
    :enable remora-keyword-p)

  (defruled not-remora-keyword-string-p-of-string-append-when-slash
    (implies (and (stringp id)
                  (stringp suffix)
                  (valid-identifier-string-p id)
                  (ascii-id-continue-string-p suffix)
                  (member-equal #x2F (acl2::string=>nats suffix)))
             (not (remora-keyword-string-p (string-append id suffix))))
    :enable (remora-keyword-string-p
             valid-identifier-string-p
             ascii-id-continue-string-p
             acl2::string=>nats-of-string-append
             utf8-partition-when-decoding-succeeds
             utf8-identity-when-ascii-id-continue-listp
             not-remora-keyword-p-when-member-slash
             member-equal-of-append-when-member-of-second)
    :disable string-append
    :prep-lemmas
    ((defruled member-equal-of-append-when-member-of-second
       (implies (member-equal e b)
                (member-equal e (append a b)))
       :induct (len a))))

  (defruled valid-identifier-string-p-of-string-append-when-slash
    :short "Extending a valid identifier with ASCII continuation
            characters that include a slash always yields a valid
            identifier."
    (implies (and (stringp id)
                  (stringp suffix)
                  (valid-identifier-string-p id)
                  (ascii-id-continue-string-p suffix)
                  (member-equal #x2F (acl2::string=>nats suffix)))
             (valid-identifier-string-p (string-append id suffix)))
    :enable (valid-identifier-string-p-of-string-append
             not-remora-keyword-string-p-of-string-append-when-slash)
    :disable string-append)

  ;; The two facts that discharge the conditions above for a decimal
  ;; digit suffix, which is how fresh variants of existing names are
  ;; generated (see fresh-variable-operations): such a suffix consists
  ;; of ASCII continuation characters, and no Remora keyword ends in a
  ;; digit.

  (defruled ascii-id-continue-string-p-when-dec-bytes
    (implies (and (stringp str)
                  (dec-digit-listp (acl2::string=>nats str)))
             (ascii-id-continue-string-p str))
    :enable (ascii-id-continue-string-p
             ascii-id-continue-listp-when-dec-digit-listp))

  (defruled not-remora-keyword-string-p-of-string-append-digits
    (implies (and (stringp id)
                  (stringp suffix)
                  (valid-identifier-string-p id)
                  (dec-digit-listp (acl2::string=>nats suffix))
                  (consp (acl2::string=>nats suffix)))
             (not (remora-keyword-string-p (string-append id suffix))))
    :enable (remora-keyword-string-p
             valid-identifier-string-p
             acl2::string=>nats-of-string-append
             utf8-partition-when-decoding-succeeds
             utf8-identity-when-ascii-id-continue-listp
             ascii-id-continue-listp-when-dec-digit-listp
             not-remora-keyword-p-of-append-digits)
    :disable string-append)

  ;; The composition of the two facts above with
  ;; VALID-IDENTIFIER-STRING-P-OF-STRING-APPEND, ready for use: appending
  ;; the decimal representation of a number to a valid identifier yields
  ;; a valid identifier.  This is the form consumed by the name
  ;; generators of fresh-variable-operations.

  (defruled valid-identifier-string-p-of-string-append-nat-to-dec-string
    :short "Appending the decimal representation of a number to a valid
            identifier yields a valid identifier."
    (implies (and (stringp prefix)
                  (valid-identifier-string-p prefix))
             (valid-identifier-string-p
              (string-append prefix (str::nat-to-dec-string n))))
    :use ((:instance valid-identifier-string-p-of-string-append
                     (id prefix)
                     (suffix (str::nat-to-dec-string n)))
          (:instance dec-digit-listp-of-string=>nats-of-nat-to-dec-string))
    :enable (ascii-id-continue-string-p-when-dec-bytes
             not-remora-keyword-string-p-of-string-append-digits)
    :disable string-append))
