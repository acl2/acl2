; Move to ABNF library.

(defrule abnf::tree-terminatedp-of-check-tree-path
  (b* ((tree? (abnf::check-tree-path path tree)))
    (implies (and (abnf::tree-terminatedp tree)
                  tree?)
             (abnf::tree-terminatedp tree?)))
  :induct t
  :enable (abnf::check-tree-path
           abnf::tree-terminatedp))

(defrule abnf::tree-terminatedp-of-tree-at-path
  (implies (and (abnf::tree-path-validp path tree)
                (abnf::tree-terminatedp tree))
           (abnf::tree-terminatedp (abnf::tree-at-path path tree)))
  :enable (abnf::tree-path-validp abnf::tree-at-path))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defxdoc+ extra-grammatical-restrictions
  :parents (concrete-syntax)
  :short "Extra-grammatical restrictions on the syntax of Remora."
  :long
  (xdoc::topstring
   (xdoc::p
    "The ABNF @(see grammar) captures
     most of the syntactic requirements of Remora,
     but not all of them;
     this is very commonly the case in languages.
     To provide a complete formal specification of the Remora syntax,
     we complement the grammar with extra-grammatical restrictions,
     expressed as predicates over CSTs."))
  :order-subtopics t
  :default-parent t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define cst-match-any-rulename-p ((cst abnf::treep) (rulenames string-listp))
  :returns (yes/no booleanp)
  :short "Check if a CST matches any of the rule names in a list."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is a more general operation,
     which could perhaps be generated by @(tsee abnf::deftreeops)."))
  (and (consp rulenames)
       (or (cst-matchp$ cst
                        (abnf::element-rulename
                         (abnf::rulename
                          (car rulenames))))
           (cst-match-any-rulename-p cst (cdr rulenames)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-sk extensible-to-cst-fringe-p ((current nat-listp)
                                       (rest nat-listp)
                                       (rulenames string-listp))
  :returns (yes/no booleanp)
  :short "Check if a list of natural numbers
          can be extended to be the fringe of a CST,
          with some constraints."
  :long
  (xdoc::topstring
   (xdoc::p
    "The list of natural numbers to be extended is the @('current') parameter,
     while @('rest') is a list that we can take a non-empty prefix of,
     and add it after @('current') to obtain a fringe of a CST;
     the CST must match at least one of the rule names in the given list.")
   (xdoc::p
    "This is used by some predicates to see whether a CST is maximal or not.
     For instance, consider a CST matching @('identifier') in the grammar.
     Its fringe is passed as the @('current') input to this function.
     The fringe of one or more CSTs adjacent to the first one
     is passed as the @('rest') input of this function.
     Then the question is whether we can find another CST,
     matching @('identifier') or @('keyword') or perhaps other nonterminals,
     whose fringe is an extension of @('current') with a non-empty @('ext'),
     such that @('ext') is a prefix (maybe all) of @('rest'):
     that would indicate that the initial CST was not the longest."))
  (exists (cst ext)
          (and (abnf::treep cst)
               (cst-match-any-rulename-p cst rulenames)
               (nat-listp ext)
               (consp ext)
               (prefixp ext (nat-list-fix rest))
               (equal (abnf::tree->string cst)
                      (append (nat-list-fix current) ext)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-sk cst-identifier-like-keyword-p ((cst-ident abnf::treep))
  :guard (cst-matchp cst-ident "identifier")
  :returns (yes/no booleanp)
  :short "Check if an @('identifier') CST
          has the same fringe as some @('keyword') CST."
  (exists (cst-keywd)
          (and (abnf::treep cst-keywd)
               (cst-matchp cst-keywd "keyword")
               (equal (abnf::tree->string cst-keywd)
                      (abnf::tree->string cst-ident)))))

;;;;;;;;;;;;;;;;;;;;

(define-sk cst-identifiers-not-keywords-p ((cst abnf::treep))
  :returns (yes/no booleanp)
  :short "Check if a CST does not contain any @('identifier') CSTs
          that have the same fringe as some @('keyword') CSTs."
  (forall (cst-ident)
          (implies (and (set::in cst-ident (abnf::trees-in-tree cst))
                        (cst-matchp cst-ident "identifier"))
                   (not (cst-identifier-like-keyword-p cst-ident)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-sk cst-longest-comments-p ((cst abnf::treep))
  :guard (abnf::tree-terminatedp cst)
  :returns (yes/no booleanp)
  :short "Check if a CST does not contain any extensible @('comment') CST."
  :long
  (xdoc::topstring
   (xdoc::p
    "A comment starts with semicolon, and must extend as far as it can
     (i.e. to the end of line or end of file).
     Thus, if we have a CST matching @('comment') at a path,
     the fringe of the CST at the adjacent path (if any)
     must not be usable to extend the comment,
     i.e. any extension within the adjacent fringe
     must not be the fringe of any possible @('comment') CST.")
   (xdoc::p
    "Since only comments start with semicolon,
     an extension of a comment can only be another comment
     (e.g. not an identifier)."))
  (forall (path1 path2)
          (implies (and (abnf::tree-pathp path1)
                        (abnf::tree-pathp path2)
                        (abnf::tree-path-validp path1 cst)
                        (abnf::tree-path-validp path2 cst)
                        (abnf::tree-paths-adjacentp path1 path2 cst))
                   (b* ((cst1 (abnf::tree-at-path path1 cst))
                        (cst2 (abnf::tree-at-path path2 cst)))
                     (implies (cst-matchp cst1 "comment")
                              (not (extensible-to-cst-fringe-p
                                    (abnf::tree->string cst1)
                                    (abnf::tree->string cst2)
                                    (list "comment"))))))))

