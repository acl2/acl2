                         (eval-expr-ok (expr-value-ilambda->body funval)
                                       (expr-denv-add-ispace
                                        (expr-value-ilambda->param funval)
                                        ival
                                        (expr-value-ilambda->denv funval))
                                       (1- limit)))
                (expr-value-alpha-related-via-p new-funval funval w)
                (expr-value-wfp funval)
                (expr-value-wfp new-funval))
           (b* ((val (eval-iapp funval ival limit))
                (new-val (eval-iapp new-funval ival limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :use (eval-iapp-ok-when-ilambda-dim-aux
        eval-iapp-ok-when-ilambda-shape-aux))

(defruled eval-iapp-ok-when-ilambda
  (implies (and (equal (expr-value-kind funval) :ilambda)
                (implies (ispace-values-match-ispace-vars-p
                          (list ival) (list (expr-value-ilambda->param funval)))
                         (eval-expr-ok (expr-value-ilambda->body funval)
                                       (expr-denv-add-ispace
                                        (expr-value-ilambda->param funval)
                                        ival
                                        (expr-value-ilambda->denv funval))
                                       (1- limit))))
           (eval-iapp-ok funval ival limit))
  :expand ((eval-iapp-ok funval ival limit))
  :cases ((zp limit))
  :enable eval-iapp-when-zp-limit
  :use ((:instance eval-iapp-ok-when-ilambda-aux
                   (new-funval (mv-nth 0 (eval-iapp-ok-witness funval ival limit)))
                   (w (mv-nth 1 (eval-iapp-ok-witness funval ival limit))))))

(defruled eval-iapp-ok-cases
  (implies (and (implies (and (equal (expr-value-kind funval) :ilambda)
                              (ispace-values-match-ispace-vars-p
                               (list ival)
                               (list (expr-value-ilambda->param funval))))
                         (eval-expr-ok (expr-value-ilambda->body funval)
                                       (expr-denv-add-ispace
                                        (expr-value-ilambda->param funval)
                                        ival
                                        (expr-value-ilambda->denv funval))
                                       (1- limit)))
                (implies (equal (expr-value-kind funval) :vector)
                         (eval-iapp-list-ok (expr-value-vector->elems funval)
                                            ival (1- limit))))
           (eval-iapp-ok funval ival limit))
  :use (eval-iapp-ok-when-ilambda
        eval-iapp-ok-when-primop
        eval-iapp-ok-when-vector
        eval-iapp-ok-when-vector-empty
        eval-iapp-ok-when-otherwise))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The list of ispace applications (the elements of a vector function value).

(defruled eval-iapp-list-when-zp-limit
  (implies (zp limit)
           (equal (eval-iapp-list funvals ival limit) (reserr :limit)))
  :expand ((eval-iapp-list funvals ival limit)))

(defruled eval-iapp-list-when-endp
  (implies (and (not (zp limit))
                (not (consp funvals)))
           (equal (eval-iapp-list funvals ival limit) nil))
  :expand ((eval-iapp-list funvals ival limit)))

(defruled eval-iapp-list-when-consp
  (implies (and (not (zp limit))
                (consp funvals))
           (equal (eval-iapp-list funvals ival limit)
                  (b* (((ok val) (eval-iapp (car funvals) ival (1- limit)))
                       ((ok vals) (eval-iapp-list (cdr funvals) ival (1- limit))))
                    (cons val vals))))
  :expand ((eval-iapp-list funvals ival limit)))

(defruled eval-iapp-list-ok-when-zp-limit
  (implies (zp limit)
           (eval-iapp-list-ok funvals ival limit))
  :expand ((eval-iapp-list-ok funvals ival limit))
  :enable eval-iapp-list-when-zp-limit)

(defruled eval-iapp-list-ok-when-endp
  (implies (not (consp funvals))
           (eval-iapp-list-ok funvals ival limit))
  :expand ((eval-iapp-list-ok funvals ival limit)
           (:free (a b c) (expr-value-list-alpha-related-via-p a funvals c)))
  :cases ((zp limit))
  :enable (eval-iapp-list-when-zp-limit
           eval-iapp-list-when-endp)
  :use ((:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals nil) (vals nil) (ws nil))))

(defruled eval-iapp-list-ok-when-consp-aux
  (implies (and (consp funvals)
                (not (zp limit))
                (eval-iapp-ok (car funvals) ival (1- limit))
                (implies (not (reserrp (eval-iapp (car funvals) ival (1- limit))))
                         (eval-iapp-list-ok (cdr funvals) ival (1- limit)))
                (expr-value-list-alpha-related-via-p new-funvals funvals ws)
                (expr-value-list-wfp funvals)
                (expr-value-list-wfp new-funvals))
           (b* ((vals (eval-iapp-list funvals ival limit))
                (new-vals (eval-iapp-list new-funvals ival limit)))
             (and (equal (reserrp new-vals) (reserrp vals))
                  (implies (not (reserrp vals))
                           (expr-value-list-alpha-equiv-p new-vals vals)))))
  :expand ((expr-value-list-alpha-related-via-p new-funvals funvals ws)
           (:free (a b c d)
            (expr-value-list-alpha-related-via-p a (cons b c) d)))
  :enable (eval-iapp-list-when-consp
           expr-value-list-wfp
           not-reserrp-when-expr-value-listp
           expr-valuep-when-result-not-error
           expr-value-listp-when-result-not-error)
  :use ((:instance eval-iapp-ok-necc
                   (funval (car funvals))
                   (limit (1- limit))
                   (new-funval (car new-funvals))
                   (w (car ws)))
        (:instance eval-iapp-list-ok-necc
                   (funvals (cdr funvals))
                   (limit (1- limit))
                   (new-funvals (cdr new-funvals))
                   (ws (cdr ws)))
        (:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals (eval-iapp-list new-funvals ival limit))
                   (vals (eval-iapp-list funvals ival limit))
                   (ws (cons (expr-value-alpha-equiv-p-witness
                              (eval-iapp (car new-funvals) ival (1- limit))
                              (eval-iapp (car funvals) ival (1- limit)))
                             (expr-value-list-alpha-equiv-p-witness
                              (eval-iapp-list (cdr new-funvals) ival (1- limit))
                              (eval-iapp-list (cdr funvals) ival (1- limit))))))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-iapp (car new-funvals) ival (1- limit)))
                   (val (eval-iapp (car funvals) ival (1- limit))))
        (:instance expr-value-list-alpha-equiv-p
                   (new-vals (eval-iapp-list (cdr new-funvals) ival (1- limit)))
                   (vals (eval-iapp-list (cdr funvals) ival (1- limit))))))

(defruled eval-iapp-list-ok-when-consp
  (implies (and (consp funvals)
                (eval-iapp-ok (car funvals) ival (1- limit))
                (implies (not (reserrp (eval-iapp (car funvals) ival (1- limit))))
                         (eval-iapp-list-ok (cdr funvals) ival (1- limit))))
           (eval-iapp-list-ok funvals ival limit))
  :expand ((eval-iapp-list-ok funvals ival limit))
  :cases ((zp limit))
  :enable eval-iapp-list-when-zp-limit
  :use ((:instance eval-iapp-list-ok-when-consp-aux
                   (new-funvals (mv-nth 0 (eval-iapp-list-ok-witness funvals ival limit)))
                   (ws (mv-nth 1 (eval-iapp-list-ok-witness funvals ival limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The n-ary ispace application: the ispace arguments evaluate to the same
; (ground) values in related environments and are applied one at a time.

(defruled eval-iappn-when-zp-limit
  (implies (zp limit)
           (equal (eval-iappn funval args denv limit) (reserr :limit)))
  :expand ((eval-iappn funval args denv limit)))

(defruled eval-iappn-when-endp
  (implies (and (not (zp limit))
                (not (consp args)))
           (equal (eval-iappn funval args denv limit) (expr-value-fix funval)))
  :expand ((eval-iappn funval args denv limit)))

(defruled eval-iappn-when-consp
  (implies (and (not (zp limit))
                (consp args))
           (equal (eval-iappn funval args denv limit)
                  (b* (((ok ival) (eval-ispace (car args)
                                               (type-denv->ienv (expr-denv->tenv denv))))
                       ((ok val) (eval-iapp funval ival (1- limit))))
                    (eval-iappn val (cdr args) denv (1- limit)))))
  :expand ((eval-iappn funval args denv limit)))

(defruled eval-iappn-ok-when-zp-limit
  (implies (zp limit)
           (eval-iappn-ok funval args denv limit))
  :expand ((eval-iappn-ok funval args denv limit))
  :enable eval-iappn-when-zp-limit)

(defruled eval-iappn-ok-when-endp
  (implies (not (consp args))
           (eval-iappn-ok funval args denv limit))
  :expand ((eval-iappn-ok funval args denv limit))
  :cases ((zp limit))
  :enable (eval-iappn-when-zp-limit
           eval-iappn-when-endp
           ispace-list-rename-ispace-vars
           not-reserrp-when-expr-valuep)
  :use ((:instance expr-value-alpha-equiv-p-suff
                   (new-val (expr-value-fix
                             (mv-nth 0 (eval-iappn-ok-witness funval args denv limit))))
                   (val (expr-value-fix funval))
                   (w (mv-nth 1 (eval-iappn-ok-witness funval args denv limit))))))

(defruled eval-iappn-ok-when-consp-aux
  (implies (and (consp args)
                (not (zp limit))
                (implies (not (reserrp (eval-ispace (car args) (type-denv->ienv (expr-denv->tenv denv)))))
                         (eval-iapp-ok funval
                                       (eval-ispace (car args) (type-denv->ienv (expr-denv->tenv denv)))
                                       (1- limit)))
                (implies (and (not (reserrp (eval-ispace (car args)
                                                         (type-denv->ienv (expr-denv->tenv denv)))))
                              (not (reserrp (eval-iapp funval
                                                       (eval-ispace (car args)
                                                                    (type-denv->ienv (expr-denv->tenv denv)))
                                                       (1- limit)))))
                         (eval-iappn-ok (eval-iapp funval
                                                   (eval-ispace (car args)
                                                                (type-denv->ienv (expr-denv->tenv denv)))
                                                   (1- limit))
                                        (cdr args) denv (1- limit)))
                (expr-value-alpha-related-via-p new-funval funval w)
                                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (ispace-list-free-ispace-vars args)
                                           nil
                                           nil)
                (expr-value-wfp funval)
                (expr-value-wfp new-funval)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((val (eval-iappn funval args denv limit))
                (new-val (eval-iappn new-funval
                                     (ispace-list-rename-ispace-vars args (var-renamings->dim r) (var-renamings->shape r))
                                     new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((ispace-list-free-ispace-vars args)
           (ispace-list-rename-ispace-vars args (var-renamings->dim r)
                                           (var-renamings->shape r))
           (expr-denv-alpha-related-via-p new-denv denv r dw)
           (:free (a b r wm) (type-denv-alpha-related-via-p a b r wm))
           (:free (i tv e) (expr-denv-alpha-avoided-p new-denv denv r i tv e))
           (:free (i tv) (type-denv-alpha-avoided-p (expr-denv->tenv new-denv)
                                                    (expr-denv->tenv denv)
                                                    r i tv)))
  :enable (eval-iappn-when-consp
           denv-ispace-vars-avoided-p-monotone
           type-var-map-avoided-p-monotone
           string-expr-value-map-avoided-p-monotone
           expr-value-wfp-of-eval-iapp
           not-reserrp-when-expr-valuep
           expr-valuep-when-result-not-error)
  :use ((:instance eval-ispace-alpha
                   (ispace (car args))
                   (new-denv (type-denv->ienv (expr-denv->tenv new-denv)))
                   (denv (type-denv->ienv (expr-denv->tenv denv)))
                   (dim-renam (var-renamings->dim r))
                   (shape-renam (var-renamings->shape r)))
        (:instance eval-iapp-ok-necc
                   (ival (eval-ispace (car args) (type-denv->ienv (expr-denv->tenv denv))))
                   (limit (1- limit)))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-iapp new-funval
                                       (eval-ispace (car args) (type-denv->ienv (expr-denv->tenv denv)))
                                       (1- limit)))
                   (val (eval-iapp funval
                                   (eval-ispace (car args) (type-denv->ienv (expr-denv->tenv denv)))
                                   (1- limit))))
        (:instance eval-iappn-ok-necc
                   (funval (eval-iapp funval
                                      (eval-ispace (car args) (type-denv->ienv (expr-denv->tenv denv)))
                                      (1- limit)))
                   (args (cdr args))
                   (limit (1- limit))
                   (new-funval (eval-iapp new-funval
                                          (eval-ispace (car args) (type-denv->ienv (expr-denv->tenv denv)))
                                          (1- limit)))
                   (w (expr-value-alpha-equiv-p-witness
                       (eval-iapp new-funval
                                  (eval-ispace (car args) (type-denv->ienv (expr-denv->tenv denv)))
                                  (1- limit))
                       (eval-iapp funval
                                  (eval-ispace (car args) (type-denv->ienv (expr-denv->tenv denv)))
                                  (1- limit)))))))

(defruled eval-iappn-ok-when-consp
  (implies (and (consp args)
                (implies (not (reserrp (eval-ispace (car args) (type-denv->ienv (expr-denv->tenv denv)))))
                         (eval-iapp-ok funval
                                       (eval-ispace (car args) (type-denv->ienv (expr-denv->tenv denv)))
                                       (1- limit)))
                (implies (and (not (reserrp (eval-ispace (car args)
                                                         (type-denv->ienv (expr-denv->tenv denv)))))
                              (not (reserrp (eval-iapp funval
                                                       (eval-ispace (car args)
                                                                    (type-denv->ienv (expr-denv->tenv denv)))
                                                       (1- limit)))))
                         (eval-iappn-ok (eval-iapp funval
                                                   (eval-ispace (car args)
                                                                (type-denv->ienv (expr-denv->tenv denv)))
                                                   (1- limit))
                                        (cdr args) denv (1- limit))))
           (eval-iappn-ok funval args denv limit))
  :expand ((eval-iappn-ok funval args denv limit))
  :cases ((zp limit))
  :enable eval-iappn-when-zp-limit
  :use ((:instance eval-iappn-ok-when-consp-aux
                   (new-funval (mv-nth 0 (eval-iappn-ok-witness funval args denv limit)))
                   (w (mv-nth 1 (eval-iappn-ok-witness funval args denv limit)))
                   (new-denv (mv-nth 2 (eval-iappn-ok-witness funval args denv limit)))
                   (r (mv-nth 3 (eval-iappn-ok-witness funval args denv limit)))
                   (dw (mv-nth 4 (eval-iappn-ok-witness funval args denv limit)))
                   (b (mv-nth 5 (eval-iappn-ok-witness funval args denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Cell-wise function application (EVAL-APP-CELL): a lambda closure extends
; its environment with the argument at the parameter (the expression
; variable namespace); a primitive operation value is applied via the
; primitive application clique member.

(defruled eval-app-cell-when-zp-limit
  (implies (zp limit)
           (equal (eval-app-cell funcell argcell limit) (reserr :limit)))
  :expand ((eval-app-cell funcell argcell limit)))

(defruled eval-app-cell-when-lambda
  (implies (and (equal (expr-value-kind funcell) :lambda)
                (not (zp limit)))
           (equal (eval-app-cell funcell argcell limit)
                  (b* (((unless (expr-values-match-type-values-p
                                 (list argcell)
                                 (list (var+typevalue->type
                                        (expr-value-lambda->param funcell)))))
                        (reserr nil))
                       (denv (expr-denv-add-expr
                              (var+typevalue->var (expr-value-lambda->param funcell))
                              argcell
                              (expr-value-lambda->denv funcell))))
                    (eval-expr (expr-value-lambda->body funcell) denv (1- limit)))))
  :expand ((eval-app-cell funcell argcell limit)))

(defruled eval-app-cell-when-primop
  (implies (and (equal (expr-value-kind funcell) :primop)
                (not (zp limit)))
           (equal (eval-app-cell funcell argcell limit)
                  (if (primop-value-funp (expr-value-primop->val funcell))
                      (eval-primop-fun (expr-value-primop->val funcell)
                                       argcell (1- limit))
                    (reserr nil))))
  :expand ((eval-app-cell funcell argcell limit)))

(defruled eval-app-cell-when-otherwise
  (implies (and (not (equal (expr-value-kind funcell) :lambda))
                (not (equal (expr-value-kind funcell) :primop))
                (not (zp limit)))
           (equal (eval-app-cell funcell argcell limit) (reserr nil)))
  :expand ((eval-app-cell funcell argcell limit)))

; Support and non-capture at the expression variable layer.

(defruled expr-denv-keys-supported-p-of-add-expr-when-bound-or-kept
  (implies (and (expr-denv-keys-supported-p denv r b)
                (stringp name)
                (or (omap::assoc name (string-string-map-fix (var-renamings->expr r)))
                    (set::in name (string-sfix b))))
           (expr-denv-keys-supported-p (expr-denv-add-expr name val denv) r b))
  :enable (expr-denv-keys-supported-p
           expr-denv-add-expr
           omap::keys-of-update
           string-set-supported-p
           omap::assoc-to-in-of-keys
           set::subset-insert-x
           set::union-in))

(defruled not-in-expr-image-of-keys-when-within
  (implies (and (expr-denv-keys-within-p denv ivars tvars evars)
                (not (set::in x (rename-var-string-set (string-sfix evars) m))))
           (not (set::in x (rename-var-string-set
                            (set::delete v (omap::keys (expr-denv->exprs denv)))
                            m))))
  :enable (expr-denv-keys-within-p)
  :use ((:instance not-in-rename-var-string-set-when-subset
                   (elt x)
                   (a (set::delete v (omap::keys (expr-denv->exprs denv))))
                   (b (string-sfix evars)))
        (:instance set::subset-transitive
                   (x (set::delete v (omap::keys (expr-denv->exprs denv))))
                   (y (omap::keys (expr-denv->exprs denv)))
                   (z (string-sfix evars)))))

(defruled eval-app-cell-ok-when-lambda-aux
  (implies (and (equal (expr-value-kind funcell) :lambda)
                (not (zp limit))
                (implies (expr-values-match-type-values-p
                          (list argcell)
                          (list (var+typevalue->type
                                 (expr-value-lambda->param funcell))))
                         (eval-expr-ok (expr-value-lambda->body funcell)
                                       (expr-denv-add-expr
                                        (var+typevalue->var
                                         (expr-value-lambda->param funcell))
                                        argcell
                                        (expr-value-lambda->denv funcell))
                                       (1- limit)))
                (expr-value-alpha-related-via-p new-funcell funcell w)
                (expr-value-alpha-related-via-p new-argcell argcell aw)
                (expr-value-wfp funcell)
                (expr-value-wfp new-funcell)
                (expr-value-wfp argcell)
                (expr-value-wfp new-argcell))
           (b* ((val (eval-app-cell funcell argcell limit))
                (new-val (eval-app-cell new-funcell new-argcell limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((expr-value-alpha-related-via-p new-funcell funcell w))
  :enable (eval-app-cell-when-lambda
           not-expr-value-groundp-when-lambda
           expr-denv-wfp-of-expr-denv-add-expr
           expr-denv-keys-supported-p-of-add-expr-when-bound-or-kept
           not-in-expr-image-of-keys-when-within)
  :use ((:instance assoc-of-extend-renaming-or-kept
                   (name (var+typevalue->var (expr-value-lambda->param funcell)))
                   (new-name (var+typevalue->var (expr-value-lambda->param new-funcell)))
                   (m (var-renamings->expr (expr-value-witness-closure->r w))))
        (:instance expr-values-match-type-values-p-of-singletons-when-related
                   (new-val new-argcell)
                   (val argcell)
                   (w aw)
                   (new-tval (var+typevalue->type (expr-value-lambda->param new-funcell)))
                   (tval (var+typevalue->type (expr-value-lambda->param funcell)))
                   (tw (expr-value-witness-closure->ptype w)))
        (:instance eval-expr-ok-necc
                   (expr (expr-value-lambda->body funcell))
                   (denv (expr-denv-add-expr
                          (var+typevalue->var (expr-value-lambda->param funcell))
                          argcell
                          (expr-value-lambda->denv funcell)))
                   (limit (1- limit))
                   (new-expr (expr-value-lambda->body new-funcell))
                   (new-denv (expr-denv-add-expr
                              (var+typevalue->var (expr-value-lambda->param new-funcell))
                              new-argcell
                              (expr-value-lambda->denv new-funcell)))
                   (r (change-var-renamings
                       (expr-value-witness-closure->r w)
                       :expr (extend-renaming
                              (var+typevalue->var (expr-value-lambda->param funcell))
                              (var+typevalue->var (expr-value-lambda->param new-funcell))
                              (var-renamings->expr (expr-value-witness-closure->r w)))))
                   (dw (change-denv-witness
                        (expr-value-witness-closure->denv w)
                        :exprs (omap::update
                                (var+typevalue->var (expr-value-lambda->param funcell))
                                (expr-value-witness-fix aw)
                                (denv-witness->exprs
                                 (expr-value-witness-closure->denv w)))))
                   (b (set::insert (var+typevalue->var (expr-value-lambda->param new-funcell))
                                   (expr-value-witness-closure->b w))))
        (:instance expr-denv-alpha-related-via-p-of-add-expr
                   (new-denv (expr-value-lambda->denv new-funcell))
                   (denv (expr-value-lambda->denv funcell))
                   (r (expr-value-witness-closure->r w))
                   (dw (expr-value-witness-closure->denv w))
                   (name (var+typevalue->var (expr-value-lambda->param funcell)))
                   (new-name (var+typevalue->var (expr-value-lambda->param new-funcell)))
                   (val (expr-value-fix argcell))
                   (new-val (expr-value-fix new-argcell))
                   (w (expr-value-witness-fix aw)))
        (:instance expr-denv-alpha-avoided-p-of-add-expr
                   (new-denv (expr-value-lambda->denv new-funcell))
                   (denv (expr-value-lambda->denv funcell))
                   (r (expr-value-witness-closure->r w))
                   (name (var+typevalue->var (expr-value-lambda->param funcell)))
                   (new-name (var+typevalue->var (expr-value-lambda->param new-funcell)))
                   (val (expr-value-fix argcell))
                   (new-val (expr-value-fix new-argcell))
                   (ivars (expr-free-ispace-vars (expr-value-lambda->body funcell)))
                   (tvars (expr-free-type-vars (expr-value-lambda->body funcell)))
                   (evars (expr-free-expr-vars (expr-value-lambda->body funcell))))
        (:instance not-in-expr-image-of-keys-when-within
                   (denv (expr-value-lambda->denv funcell))
                   (ivars (expr-free-ispace-vars (expr-value-lambda->body funcell)))
                   (tvars (expr-free-type-vars (expr-value-lambda->body funcell)))
                   (evars (set::delete (var+typevalue->var (expr-value-lambda->param funcell))
                                       (expr-free-expr-vars
                                        (expr-value-lambda->body funcell))))
                   (x (var+typevalue->var (expr-value-lambda->param new-funcell)))
                   (v (var+typevalue->var (expr-value-lambda->param funcell)))
                   (m (var-renamings->expr (expr-value-witness-closure->r w))))))

(defruled eval-app-cell-ok-when-lambda
  (implies (and (equal (expr-value-kind funcell) :lambda)
                (implies (expr-values-match-type-values-p
                          (list argcell)
                          (list (var+typevalue->type
                                 (expr-value-lambda->param funcell))))
                         (eval-expr-ok (expr-value-lambda->body funcell)
                                       (expr-denv-add-expr
                                        (var+typevalue->var
                                         (expr-value-lambda->param funcell))
                                        argcell
                                        (expr-value-lambda->denv funcell))
                                       (1- limit))))
           (eval-app-cell-ok funcell argcell limit))
  :expand ((eval-app-cell-ok funcell argcell limit))
  :cases ((zp limit))
  :enable eval-app-cell-when-zp-limit
  :use ((:instance eval-app-cell-ok-when-lambda-aux
                   (new-funcell (mv-nth 0 (eval-app-cell-ok-witness funcell argcell limit)))
                   (new-argcell (mv-nth 1 (eval-app-cell-ok-witness funcell argcell limit)))
                   (w (mv-nth 2 (eval-app-cell-ok-witness funcell argcell limit)))
                   (aw (mv-nth 3 (eval-app-cell-ok-witness funcell argcell limit))))))

(defruled eval-app-cell-ok-when-primop-aux
  (implies (and (equal (expr-value-kind funcell) :primop)
                (not (zp limit))
                (implies (primop-value-funp (expr-value-primop->val funcell))
                         (eval-primop-fun-ok (expr-value-primop->val funcell)
                                             argcell (1- limit)))
                (expr-value-alpha-related-via-p new-funcell funcell w)
                (expr-value-alpha-related-via-p new-argcell argcell aw)
                (expr-value-wfp funcell)
                (expr-value-wfp new-funcell)
                (expr-value-wfp argcell)
                (expr-value-wfp new-argcell))
           (b* ((val (eval-app-cell funcell argcell limit))
                (new-val (eval-app-cell new-funcell new-argcell limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((expr-value-alpha-related-via-p new-funcell funcell w)
           (expr-value-groundp funcell))
  :enable (eval-app-cell-when-primop
           expr-value-kind-when-expr-value-alpha-related-via-p-safe
           primop-value-funp-when-primop-value-alpha-related-via-p-safe)
  :use ((:instance expr-value-primop->val-when-equal-fix
                   (x new-funcell) (y funcell))
        (:instance eval-primop-fun-ok-necc
                   (op (expr-value-primop->val funcell))
                   (arg argcell)
                   (limit (1- limit))
                   (new-op (expr-value-primop->val new-funcell))
                   (new-arg new-argcell)
                   (tws (expr-value-witness-primop->tws w))
                   (ws (expr-value-witness-primop->ws w))
                   (aw aw))
        (:instance eval-primop-fun-ok-necc
                   (op (expr-value-primop->val funcell))
                   (arg argcell)
                   (limit (1- limit))
                   (new-op (expr-value-primop->val funcell))
                   (new-arg new-argcell)
                   (tws nil)
                   (ws nil)
                   (aw aw))
        (:instance primop-value-alpha-related-via-p-of-same-when-ground
                   (op (expr-value-primop->val funcell)))))

(defruled eval-app-cell-ok-when-primop
  (implies (and (equal (expr-value-kind funcell) :primop)
                (implies (primop-value-funp (expr-value-primop->val funcell))
                         (eval-primop-fun-ok (expr-value-primop->val funcell)
                                             argcell (1- limit))))
           (eval-app-cell-ok funcell argcell limit))
  :expand ((eval-app-cell-ok funcell argcell limit))
  :cases ((zp limit))
  :enable eval-app-cell-when-zp-limit
  :use ((:instance eval-app-cell-ok-when-primop-aux
                   (new-funcell (mv-nth 0 (eval-app-cell-ok-witness funcell argcell limit)))
                   (new-argcell (mv-nth 1 (eval-app-cell-ok-witness funcell argcell limit)))
                   (w (mv-nth 2 (eval-app-cell-ok-witness funcell argcell limit)))
                   (aw (mv-nth 3 (eval-app-cell-ok-witness funcell argcell limit))))))

(defruled eval-app-cell-ok-when-otherwise-aux
  (implies (and (not (equal (expr-value-kind funcell) :lambda))
                (not (equal (expr-value-kind funcell) :primop))
                (not (zp limit))
                (expr-value-alpha-related-via-p new-funcell funcell w))
           (b* ((val (eval-app-cell funcell argcell limit))
                (new-val (eval-app-cell new-funcell new-argcell limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :enable (eval-app-cell-when-otherwise
           expr-value-kind-when-expr-value-alpha-related-via-p-safe))

(defruled eval-app-cell-ok-when-otherwise
  (implies (and (not (equal (expr-value-kind funcell) :lambda))
                (not (equal (expr-value-kind funcell) :primop)))
           (eval-app-cell-ok funcell argcell limit))
  :expand ((eval-app-cell-ok funcell argcell limit))
  :cases ((zp limit))
  :enable eval-app-cell-when-zp-limit
  :use ((:instance eval-app-cell-ok-when-otherwise-aux
                   (new-funcell (mv-nth 0 (eval-app-cell-ok-witness funcell argcell limit)))
                   (new-argcell (mv-nth 1 (eval-app-cell-ok-witness funcell argcell limit)))
                   (w (mv-nth 2 (eval-app-cell-ok-witness funcell argcell limit))))))

(defruled eval-app-cell-ok-cases
  (implies (and (implies (and (equal (expr-value-kind funcell) :lambda)
                              (expr-values-match-type-values-p
                               (list argcell)
                               (list (var+typevalue->type
                                      (expr-value-lambda->param funcell)))))
                         (eval-expr-ok (expr-value-lambda->body funcell)
                                       (expr-denv-add-expr
                                        (var+typevalue->var
                                         (expr-value-lambda->param funcell))
                                        argcell
                                        (expr-value-lambda->denv funcell))
                                       (1- limit)))
                (implies (and (equal (expr-value-kind funcell) :primop)
                              (primop-value-funp (expr-value-primop->val funcell)))
                         (eval-primop-fun-ok (expr-value-primop->val funcell)
                                             argcell (1- limit))))
           (eval-app-cell-ok funcell argcell limit))
  :use (eval-app-cell-ok-when-lambda
        eval-app-cell-ok-when-primop
        eval-app-cell-ok-when-otherwise))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The cell-wise application over the lists of function and argument cells.

(defruled eval-app-list-when-zp-limit
  (implies (zp limit)
           (equal (eval-app-list funcells argcells limit) (reserr :limit)))
  :expand ((eval-app-list funcells argcells limit)))

(defruled eval-app-list-when-endp
  (implies (and (not (zp limit))
                (not (consp funcells)))
           (equal (eval-app-list funcells argcells limit) nil))
  :expand ((eval-app-list funcells argcells limit)))

; (Named after its hypothesis: EVALUATION-RULES has an EVAL-APP-LIST-WHEN-CONSP
; of a different form, and both books are included by TOP.)
(defruled eval-app-list-when-consp-funcells
  (implies (and (not (zp limit))
                (consp funcells))
           (equal (eval-app-list funcells argcells limit)
                  (b* (((unless (consp argcells)) (reserr nil))
                       ((unless (expr-value-wfp (car argcells))) (reserr nil))
                       ((ok val) (eval-app-cell (car funcells) (car argcells) (1- limit)))
                       ((ok vals) (eval-app-list (cdr funcells) (cdr argcells) (1- limit))))
                    (cons val vals))))
  :expand ((eval-app-list funcells argcells limit)))

(defruled eval-app-list-ok-when-zp-limit
  (implies (zp limit)
           (eval-app-list-ok funcells argcells limit))
  :expand ((eval-app-list-ok funcells argcells limit))
  :enable eval-app-list-when-zp-limit)

(defruled eval-app-list-ok-when-endp
  (implies (not (consp funcells))
           (eval-app-list-ok funcells argcells limit))
  :expand ((eval-app-list-ok funcells argcells limit)
           (:free (a b c) (expr-value-list-alpha-related-via-p a funcells c)))
  :cases ((zp limit))
  :enable (eval-app-list-when-zp-limit
           eval-app-list-when-endp)
  :use ((:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals nil) (vals nil) (ws nil))))

(defruled eval-app-list-ok-when-consp-aux
  (implies (and (consp funcells)
                (not (zp limit))
                (implies (and (consp argcells)
                              (expr-value-wfp (car argcells)))
                         (eval-app-cell-ok (car funcells) (car argcells) (1- limit)))
                (implies (and (consp argcells)
                              (expr-value-wfp (car argcells))
                              (not (reserrp (eval-app-cell (car funcells)
                                                           (car argcells)
                                                           (1- limit)))))
                         (eval-app-list-ok (cdr funcells) (cdr argcells) (1- limit)))
                (expr-value-list-alpha-related-via-p new-funcells funcells ws1)
                (expr-value-list-alpha-related-via-p new-argcells argcells ws2)
                (expr-value-list-wfp funcells)
                (expr-value-list-wfp new-funcells)
                (expr-value-list-wfp argcells)
                (expr-value-list-wfp new-argcells))
           (b* ((vals (eval-app-list funcells argcells limit))
                (new-vals (eval-app-list new-funcells new-argcells limit)))
             (and (equal (reserrp new-vals) (reserrp vals))
                  (implies (not (reserrp vals))
                           (expr-value-list-alpha-equiv-p new-vals vals)))))
  :expand ((expr-value-list-alpha-related-via-p new-funcells funcells ws1)
           (expr-value-list-alpha-related-via-p new-argcells argcells ws2)
           (:free (a b c d)
            (expr-value-list-alpha-related-via-p a (cons b c) d)))
  :enable (eval-app-list-when-consp-funcells
           expr-value-list-wfp
           consp-when-expr-value-list-alpha-related-via-p-safe
           not-reserrp-when-expr-value-listp
           expr-valuep-when-result-not-error
           expr-value-listp-when-result-not-error)
  :use ((:instance eval-app-cell-ok-necc
                   (funcell (car funcells))
                   (argcell (car argcells))
                   (limit (1- limit))
                   (new-funcell (car new-funcells))
                   (new-argcell (car new-argcells))
                   (w (car ws1))
                   (aw (car ws2)))
        (:instance eval-app-list-ok-necc
                   (funcells (cdr funcells))
                   (argcells (cdr argcells))
                   (limit (1- limit))
                   (new-funcells (cdr new-funcells))
                   (new-argcells (cdr new-argcells))
                   (ws1 (cdr ws1))
                   (ws2 (cdr ws2)))
        (:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals (eval-app-list new-funcells new-argcells limit))
                   (vals (eval-app-list funcells argcells limit))
                   (ws (cons (expr-value-alpha-equiv-p-witness
                              (eval-app-cell (car new-funcells) (car new-argcells) (1- limit))
                              (eval-app-cell (car funcells) (car argcells) (1- limit)))
                             (expr-value-list-alpha-equiv-p-witness
                              (eval-app-list (cdr new-funcells) (cdr new-argcells) (1- limit))
                              (eval-app-list (cdr funcells) (cdr argcells) (1- limit))))))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-app-cell (car new-funcells) (car new-argcells) (1- limit)))
                   (val (eval-app-cell (car funcells) (car argcells) (1- limit))))
        (:instance expr-value-list-alpha-equiv-p
                   (new-vals (eval-app-list (cdr new-funcells) (cdr new-argcells) (1- limit)))
                   (vals (eval-app-list (cdr funcells) (cdr argcells) (1- limit))))))

(defruled eval-app-list-ok-when-consp
  (implies (and (consp funcells)
                (implies (and (consp argcells)
                              (expr-value-wfp (car argcells)))
                         (eval-app-cell-ok (car funcells) (car argcells) (1- limit)))
                (implies (and (consp argcells)
                              (expr-value-wfp (car argcells))
                              (not (reserrp (eval-app-cell (car funcells)
                                                           (car argcells)
                                                           (1- limit)))))
                         (eval-app-list-ok (cdr funcells) (cdr argcells) (1- limit))))
           (eval-app-list-ok funcells argcells limit))
  :expand ((eval-app-list-ok funcells argcells limit))
  :cases ((zp limit))
  :enable eval-app-list-when-zp-limit
  :use ((:instance eval-app-list-ok-when-consp-aux
                   (new-funcells (mv-nth 0 (eval-app-list-ok-witness funcells argcells limit)))
                   (new-argcells (mv-nth 1 (eval-app-list-ok-witness funcells argcells limit)))
                   (ws1 (mv-nth 2 (eval-app-list-ok-witness funcells argcells limit)))
                   (ws2 (mv-nth 3 (eval-app-list-ok-witness funcells argcells limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Frame lifting under the value relation: the cells of related values at a
; depth are related lists (concatenations of the cells of related elements),
; and replicating cells preserves relatedness.

(local
 (defun three-cdrs-induct-eq (x y z)
   (if (not (consp x))
       (list y z)
     (three-cdrs-induct-eq (cdr x) (cdr y) (cdr z)))))

(defruled expr-value-list-alpha-related-via-p-of-append
  (implies (and (expr-value-list-alpha-related-via-p new-vals1 vals1 ws1)
                (expr-value-list-alpha-related-via-p new-vals2 vals2 ws2)
                (true-listp new-vals1)
                (true-listp vals1))
           (expr-value-list-alpha-related-via-p (append new-vals1 new-vals2)
                                                (append vals1 vals2)
                                                (append (take (len vals1) ws1) ws2)))
  :induct (three-cdrs-induct-eq new-vals1 vals1 ws1)
  :enable (expr-value-list-alpha-related-via-p take len))

(defruled expr-value-list-alpha-equiv-p-of-append
  (implies (and (expr-value-list-alpha-equiv-p new-vals1 vals1)
                (expr-value-list-alpha-equiv-p new-vals2 vals2)
                (true-listp new-vals1)
                (true-listp vals1))
           (expr-value-list-alpha-equiv-p (append new-vals1 new-vals2)
                                          (append vals1 vals2)))
  :expand ((expr-value-list-alpha-equiv-p new-vals1 vals1)
           (expr-value-list-alpha-equiv-p new-vals2 vals2))
  :use ((:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals (append new-vals1 new-vals2))
                   (vals (append vals1 vals2))
                   (ws (append (take (len vals1)
                                     (expr-value-list-alpha-equiv-p-witness new-vals1 vals1))
                               (expr-value-list-alpha-equiv-p-witness new-vals2 vals2)))))
  :enable expr-value-list-alpha-related-via-p-of-append)

(defruled expr-value-list-alpha-equiv-p-of-singleton
  (implies (expr-value-alpha-related-via-p new-val val w)
           (expr-value-list-alpha-equiv-p (list new-val) (list val)))
  :use ((:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals (list new-val))
                   (vals (list val))
                   (ws (list w))))
  :enable expr-value-list-alpha-related-via-p)

(defruled expr-value-list-alpha-equiv-p-of-singleton-fix
  (implies (expr-value-alpha-related-via-p new-val val w)
           (expr-value-list-alpha-equiv-p (list (expr-value-fix new-val))
                                          (list (expr-value-fix val))))
  :use ((:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals (list (expr-value-fix new-val)))
                   (vals (list (expr-value-fix val)))
                   (ws (list w))))
  :enable expr-value-list-alpha-related-via-p)

(defruled expr-value-list-alpha-equiv-p-of-nil
  (expr-value-list-alpha-equiv-p nil nil)
  :use ((:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals nil) (vals nil) (ws nil)))
  :enable expr-value-list-alpha-related-via-p)

; Existential forms of the relation facts used by the induction below.

(defruled expr-value-alpha-equiv-p-when-related
  (implies (expr-value-alpha-related-via-p new-val val w)
           (expr-value-alpha-equiv-p new-val val))
  :use expr-value-alpha-equiv-p-suff)

(defruled expr-value-list-alpha-equiv-p-when-related
  (implies (expr-value-list-alpha-related-via-p new-vals vals ws)
           (expr-value-list-alpha-equiv-p new-vals vals))
  :use expr-value-list-alpha-equiv-p-suff)

(defruled expr-value-kind-when-expr-value-alpha-equiv-p
  (implies (and (expr-value-alpha-equiv-p new-val val)
                (syntaxp (not (equal new-val val))))
           (equal (expr-value-kind new-val) (expr-value-kind val)))
  :enable expr-value-alpha-equiv-p
  :use ((:instance expr-value-kind-when-expr-value-alpha-related-via-p
                   (w (expr-value-alpha-equiv-p-witness new-val val)))))

(defruled consp-when-expr-value-list-alpha-equiv-p
  (implies (and (expr-value-list-alpha-equiv-p new-vals vals)
                (syntaxp (not (equal new-vals vals))))
           (equal (consp new-vals) (consp vals)))
  :enable expr-value-list-alpha-equiv-p
  :expand ((expr-value-list-alpha-related-via-p
            new-vals vals (expr-value-list-alpha-equiv-p-witness new-vals vals))))

(defruled expr-value-alpha-equiv-p-of-car-when-list-alpha-equiv
  (implies (and (expr-value-list-alpha-equiv-p new-vals vals)
                (consp vals))
           (expr-value-alpha-equiv-p (car new-vals) (car vals)))
  :enable expr-value-alpha-equiv-p-when-related
  :expand ((expr-value-list-alpha-equiv-p new-vals vals)
           (expr-value-list-alpha-related-via-p
            new-vals vals (expr-value-list-alpha-equiv-p-witness new-vals vals))))

(defruled expr-value-list-alpha-equiv-p-of-cdr-when-list-alpha-equiv
  (implies (and (expr-value-list-alpha-equiv-p new-vals vals)
                (consp vals))
           (expr-value-list-alpha-equiv-p (cdr new-vals) (cdr vals)))
  :enable expr-value-list-alpha-equiv-p-when-related
  :expand ((expr-value-list-alpha-equiv-p new-vals vals)
           (expr-value-list-alpha-related-via-p
            new-vals vals (expr-value-list-alpha-equiv-p-witness new-vals vals))))

(defruled expr-value-list-alpha-equiv-p-of-vector-elems-when-alpha-equiv
  (implies (and (expr-value-alpha-equiv-p new-val val)
                (equal (expr-value-kind val) :vector))
           (expr-value-list-alpha-equiv-p (expr-value-vector->elems new-val)
                                          (expr-value-vector->elems val)))
  :enable (expr-value-list-alpha-equiv-p-when-related
           expr-value-kind-when-expr-value-alpha-equiv-p)
  :expand ((expr-value-alpha-equiv-p new-val val)
           (expr-value-alpha-related-via-p
            new-val val (expr-value-alpha-equiv-p-witness new-val val)))
  :use ((:instance expr-value-list-alpha-related-via-p-of-same-when-ground
                   (vals (expr-value-vector->elems val)))
        (:instance expr-value-vector->elems-when-equal-fix
                   (x new-val) (y val))
        (:instance expr-value-list-groundp-of-expr-value-vector->elems
                   (expr-value val))))

(defruled expr-value-list-alpha-equiv-p-of-singleton-fix-when-equiv
  (implies (expr-value-alpha-equiv-p new-val val)
           (expr-value-list-alpha-equiv-p (list (expr-value-fix new-val))
                                          (list (expr-value-fix val))))
  :enable expr-value-list-alpha-equiv-p-of-singleton-fix
  :expand ((expr-value-alpha-equiv-p new-val val)))

; The cell extraction preserves the (existential) relation: stated as
; induction statements over the new value, as for the evaluator clique.

(acl2::defun-sk cells-at-depth-alpha-ok (val depth)
  (forall (new-val)
    (implies (expr-value-alpha-equiv-p new-val val)
             (and (equal (reserrp (cells-at-depth-in-expr-value new-val depth))
                         (reserrp (cells-at-depth-in-expr-value val depth)))
                  (implies (not (reserrp (cells-at-depth-in-expr-value val depth)))
                           (expr-value-list-alpha-equiv-p
                            (cells-at-depth-in-expr-value new-val depth)
                            (cells-at-depth-in-expr-value val depth)))))))

(acl2::defun-sk cells-at-depth-list-alpha-ok (vals depth)
  (forall (new-vals)
    (implies (expr-value-list-alpha-equiv-p new-vals vals)
             (and (equal (reserrp (cells-at-depth-in-expr-value-list new-vals depth))
                         (reserrp (cells-at-depth-in-expr-value-list vals depth)))
                  (implies (not (reserrp (cells-at-depth-in-expr-value-list vals depth)))
                           (expr-value-list-alpha-equiv-p
                            (cells-at-depth-in-expr-value-list new-vals depth)
                            (cells-at-depth-in-expr-value-list vals depth)))))))

(defruled cells-at-depth-alpha-ok-when-zp
  (implies (zp depth)
           (cells-at-depth-alpha-ok val depth))
  :expand ((cells-at-depth-alpha-ok val depth)
           (:free (v) (cells-at-depth-in-expr-value v depth)))
  :enable (expr-value-list-alpha-equiv-p-of-singleton-fix-when-equiv
           not-reserrp-when-expr-value-listp))

(defruled cells-at-depth-alpha-ok-when-vector
  (implies (and (not (zp depth))
                (equal (expr-value-kind val) :vector)
                (cells-at-depth-list-alpha-ok (expr-value-vector->elems val)
                                              (1- depth)))
           (cells-at-depth-alpha-ok val depth))
  :expand ((cells-at-depth-alpha-ok val depth)
           (:free (v) (cells-at-depth-in-expr-value v depth)))
  :enable (expr-value-kind-when-expr-value-alpha-equiv-p
           expr-value-list-alpha-equiv-p-of-vector-elems-when-alpha-equiv
           not-reserrp-when-expr-value-listp
           expr-value-listp-when-result-not-error)
  :use ((:instance cells-at-depth-list-alpha-ok-necc
                   (vals (expr-value-vector->elems val))
                   (depth (1- depth))
                   (new-vals (expr-value-vector->elems
                              (cells-at-depth-alpha-ok-witness val depth))))))

(defruled cells-at-depth-alpha-ok-when-otherwise
  (implies (and (not (zp depth))
                (not (equal (expr-value-kind val) :vector)))
           (cells-at-depth-alpha-ok val depth))
  :expand ((cells-at-depth-alpha-ok val depth)
           (:free (v) (cells-at-depth-in-expr-value v depth)))
  :enable expr-value-kind-when-expr-value-alpha-equiv-p)

(defruled cells-at-depth-list-alpha-ok-when-endp
  (implies (not (consp vals))
           (cells-at-depth-list-alpha-ok vals depth))
  :expand ((cells-at-depth-list-alpha-ok vals depth)
           (cells-at-depth-in-expr-value-list vals depth)
           (cells-at-depth-in-expr-value-list
            (cells-at-depth-list-alpha-ok-witness vals depth) depth))
  :enable (consp-when-expr-value-list-alpha-equiv-p
           expr-value-list-alpha-equiv-p-of-nil))

(defruled cells-at-depth-list-alpha-ok-when-consp
  (implies (and (consp vals)
                (cells-at-depth-alpha-ok (car vals) depth)
                (implies (not (reserrp (cells-at-depth-in-expr-value (car vals) depth)))
                         (cells-at-depth-list-alpha-ok (cdr vals) depth)))
           (cells-at-depth-list-alpha-ok vals depth))
  :expand ((cells-at-depth-list-alpha-ok vals depth)
           (cells-at-depth-in-expr-value-list vals depth)
           (cells-at-depth-in-expr-value-list
            (cells-at-depth-list-alpha-ok-witness vals depth) depth))
  :enable (consp-when-expr-value-list-alpha-equiv-p
           expr-value-alpha-equiv-p-of-car-when-list-alpha-equiv
           expr-value-list-alpha-equiv-p-of-cdr-when-list-alpha-equiv
           expr-value-list-alpha-equiv-p-of-append
           not-reserrp-when-expr-value-listp
           expr-value-listp-when-result-not-error)
  :use ((:instance cells-at-depth-alpha-ok-necc
                   (val (car vals))
                   (new-val (car (cells-at-depth-list-alpha-ok-witness vals depth))))
        (:instance cells-at-depth-list-alpha-ok-necc
                   (vals (cdr vals))
                   (new-vals (cdr (cells-at-depth-list-alpha-ok-witness vals depth))))))

(defthm-cells-at-depth-in-expr-values-flag
  (defthm cells-at-depth-alpha-ok-holds
    (cells-at-depth-alpha-ok val depth)
    :flag cells-at-depth-in-expr-value)
  (defthm cells-at-depth-list-alpha-ok-holds
    (cells-at-depth-list-alpha-ok vals depth)
    :flag cells-at-depth-in-expr-value-list)
  :hints (("Goal"
           :in-theory (enable cells-at-depth-alpha-ok-when-zp
                              cells-at-depth-alpha-ok-when-vector
                              cells-at-depth-alpha-ok-when-otherwise
                              cells-at-depth-list-alpha-ok-when-endp
                              cells-at-depth-list-alpha-ok-when-consp))))

(defruled cells-at-depth-in-expr-value-alpha
  (implies (expr-value-alpha-related-via-p new-val val w)
           (and (equal (reserrp (cells-at-depth-in-expr-value new-val depth))
                       (reserrp (cells-at-depth-in-expr-value val depth)))
                (implies (not (reserrp (cells-at-depth-in-expr-value val depth)))
                         (expr-value-list-alpha-equiv-p
                          (cells-at-depth-in-expr-value new-val depth)
                          (cells-at-depth-in-expr-value val depth)))))
  :enable expr-value-alpha-equiv-p-when-related
  :use cells-at-depth-alpha-ok-necc)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Frame lifting under the relation: replication of related cells, and the
; lifting (cells at the frame depth, replicated over the rest of the
; principal frame) of related values.

(defruled expr-value-list-alpha-equiv-p-of-repeat
  (implies (expr-value-alpha-equiv-p new-val val)
           (expr-value-list-alpha-equiv-p (repeat n new-val) (repeat n val)))
  :expand ((expr-value-alpha-equiv-p new-val val))
  :use ((:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals (repeat n new-val))
                   (vals (repeat n val))
                   (ws (repeat n (expr-value-alpha-equiv-p-witness new-val val)))))
  :enable expr-value-list-alpha-related-via-p-of-repeat)

(local
 (defun two-cdrs-induct (x y)
   (if (not (consp x))
       y
     (two-cdrs-induct (cdr x) (cdr y)))))

(defruled expr-value-list-alpha-equiv-p-of-repeat-each
  (implies (expr-value-list-alpha-equiv-p new-vals vals)
           (expr-value-list-alpha-equiv-p (repeat-each n new-vals)
                                          (repeat-each n vals)))
  :induct (two-cdrs-induct vals new-vals)
  :enable (repeat-each
           consp-when-expr-value-list-alpha-equiv-p
           expr-value-alpha-equiv-p-of-car-when-list-alpha-equiv
           expr-value-list-alpha-equiv-p-of-cdr-when-list-alpha-equiv
           expr-value-list-alpha-equiv-p-of-repeat
           expr-value-list-alpha-equiv-p-of-append
           expr-value-list-alpha-equiv-p-of-nil))

(defruled lift-expr-value-to-frame-alpha
  (implies (expr-value-alpha-related-via-p new-val val w)
           (b* ((cells (lift-expr-value-to-frame val frame pframe))
                (new-cells (lift-expr-value-to-frame new-val frame pframe)))
             (and (equal (reserrp new-cells) (reserrp cells))
                  (implies (not (reserrp cells))
                           (expr-value-list-alpha-equiv-p new-cells cells)))))
  :enable (lift-expr-value-to-frame
           expr-value-list-alpha-equiv-p-of-repeat-each
           not-reserrp-when-expr-value-listp
           expr-value-listp-when-result-not-error)
  :use ((:instance cells-at-depth-in-expr-value-alpha
                   (depth (len frame)))))

; The first function leaf of related values: related (existentially), with
; the same error behavior.

(acl2::defun-sk first-fun-alpha-ok (val)
  (forall (new-val)
    (implies (expr-value-alpha-equiv-p new-val val)
             (and (equal (reserrp (expr-value-first-fun new-val))
                         (reserrp (expr-value-first-fun val)))
                  (implies (not (reserrp (expr-value-first-fun val)))
                           (expr-value-alpha-equiv-p
                            (expr-value-first-fun new-val)
                            (expr-value-first-fun val)))))))

(defruled primop-value-funp-when-expr-value-alpha-equiv-p
  (implies (and (expr-value-alpha-equiv-p new-val val)
                (equal (expr-value-kind val) :primop))
           (equal (primop-value-funp (expr-value-primop->val new-val))
                  (primop-value-funp (expr-value-primop->val val))))
  :enable expr-value-kind-when-expr-value-alpha-equiv-p
  :expand ((expr-value-alpha-equiv-p new-val val)
           (expr-value-alpha-related-via-p
            new-val val (expr-value-alpha-equiv-p-witness new-val val)))
  :use ((:instance primop-value-funp-when-primop-value-alpha-related-via-p
                   (new-op (expr-value-primop->val new-val))
                   (op (expr-value-primop->val val))
                   (tws (expr-value-witness-primop->tws
                         (expr-value-alpha-equiv-p-witness new-val val)))
                   (ws (expr-value-witness-primop->ws
                        (expr-value-alpha-equiv-p-witness new-val val))))
        (:instance expr-value-primop->val-when-equal-fix
                   (x new-val) (y val))))

(defruled expr-value-alpha-equiv-p-of-fix-when-equiv
  (implies (expr-value-alpha-equiv-p new-val val)
           (expr-value-alpha-equiv-p (expr-value-fix new-val)
                                     (expr-value-fix val)))
  :expand ((expr-value-alpha-equiv-p new-val val))
  :use ((:instance expr-value-alpha-equiv-p-suff
                   (new-val (expr-value-fix new-val))
                   (val (expr-value-fix val))
                   (w (expr-value-alpha-equiv-p-witness new-val val)))))

(defruled first-fun-alpha-ok-when-primop
  (implies (equal (expr-value-kind val) :primop)
           (first-fun-alpha-ok val))
  :expand ((first-fun-alpha-ok val)
           (expr-value-first-fun val)
           (expr-value-first-fun (first-fun-alpha-ok-witness val)))
  :enable (expr-value-kind-when-expr-value-alpha-equiv-p
           primop-value-funp-when-expr-value-alpha-equiv-p
           expr-value-alpha-equiv-p-of-fix-when-equiv
           not-reserrp-when-expr-valuep))

(defruled first-fun-alpha-ok-when-lambda
  (implies (equal (expr-value-kind val) :lambda)
           (first-fun-alpha-ok val))
  :expand ((first-fun-alpha-ok val)
           (expr-value-first-fun val)
           (expr-value-first-fun (first-fun-alpha-ok-witness val)))
  :enable (expr-value-kind-when-expr-value-alpha-equiv-p
           expr-value-alpha-equiv-p-of-fix-when-equiv
           not-reserrp-when-expr-valuep))

(defruled first-fun-alpha-ok-when-vector
  (implies (and (equal (expr-value-kind val) :vector)
                (implies (consp (expr-value-vector->elems val))
                         (first-fun-alpha-ok (car (expr-value-vector->elems val)))))
           (first-fun-alpha-ok val))
  :expand ((first-fun-alpha-ok val)
           (expr-value-first-fun val)
           (expr-value-first-fun (first-fun-alpha-ok-witness val)))
  :enable (expr-value-kind-when-expr-value-alpha-equiv-p
           expr-value-list-alpha-equiv-p-of-vector-elems-when-alpha-equiv
           consp-when-expr-value-list-alpha-equiv-p
           expr-value-alpha-equiv-p-of-car-when-list-alpha-equiv)
  :use ((:instance expr-value-list-alpha-equiv-p-of-vector-elems-when-alpha-equiv
                   (new-val (first-fun-alpha-ok-witness val)))
        (:instance first-fun-alpha-ok-necc
                   (val (car (expr-value-vector->elems val)))
                   (new-val (car (expr-value-vector->elems
                                  (first-fun-alpha-ok-witness val)))))))

(defruled first-fun-alpha-ok-when-otherwise
  (implies (and (not (equal (expr-value-kind val) :primop))
                (not (equal (expr-value-kind val) :lambda))
                (not (equal (expr-value-kind val) :vector)))
           (first-fun-alpha-ok val))
  :expand ((first-fun-alpha-ok val)
           (expr-value-first-fun val)
           (expr-value-first-fun (first-fun-alpha-ok-witness val)))
  :enable expr-value-kind-when-expr-value-alpha-equiv-p)

(defruled first-fun-alpha-ok-holds
  (first-fun-alpha-ok val)
  :induct (expr-value-first-fun val)
  :enable ((:induction expr-value-first-fun)
           first-fun-alpha-ok-when-primop
           first-fun-alpha-ok-when-lambda
           first-fun-alpha-ok-when-vector
           first-fun-alpha-ok-when-otherwise))

(defruled expr-value-first-fun-alpha
  (implies (expr-value-alpha-equiv-p new-val val)
           (and (equal (reserrp (expr-value-first-fun new-val))
                       (reserrp (expr-value-first-fun val)))
                (implies (not (reserrp (expr-value-first-fun val)))
                         (expr-value-alpha-equiv-p (expr-value-first-fun new-val)
                                                   (expr-value-first-fun val)))))
  :enable first-fun-alpha-ok-holds
  :use first-fun-alpha-ok-necc)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Function values under the relation: the expected argument cell
; dimensions are equal (they depend only on the ispace instantiation values
; of primitive operations and on the parameter type value dimensions of
; lambdas), and the result types are related.

(defruled dims-of-inputs-of-type-of-primop-value-fun-when-related
  (implies (primop-value-alpha-related-via-p new-op op tws ws)
           (equal (dims-of-type-value-list
                   (arrow-type-value-inputs
                    (type-value-array->elem (type-of-primop-value-fun new-op))))
                  (dims-of-type-value-list
                   (arrow-type-value-inputs
                    (type-value-array->elem (type-of-primop-value-fun op))))))
  :expand ((primop-value-alpha-related-via-p new-op op tws ws))
  :enable (type-of-primop-value-fun
           arrow-type-value-inputs
           dims-of-type-value-list
           dims-of-type-value
           nest-function-type-values))

(defruled dims-of-inputs-of-type-of-primop-value-fun-when-related-safe
  (implies (and (primop-value-alpha-related-via-p new-op op tws ws)
                (syntaxp (not (equal new-op op))))
           (equal (dims-of-type-value-list
                   (arrow-type-value-inputs
                    (type-value-array->elem (type-of-primop-value-fun new-op))))
                  (dims-of-type-value-list
                   (arrow-type-value-inputs
                    (type-value-array->elem (type-of-primop-value-fun op))))))
  :use dims-of-inputs-of-type-of-primop-value-fun-when-related)

(defruled param-dims-when-first-funs-related
  (implies (expr-value-alpha-related-via-p new-f f w)
           (equal (expr-value-case
                   new-f
                   :lambda (list (dims-of-type-value
                                  (var+typevalue->type
                                   (expr-value-lambda->param new-f))))
                   :primop (dims-of-type-value-list
                            (arrow-type-value-inputs
                             (type-value-array->elem
                              (type-of-primop-value-fun
                               (expr-value-primop->val new-f)))))
                   :otherwise (reserr nil))
                  (expr-value-case
                   f
                   :lambda (list (dims-of-type-value
                                  (var+typevalue->type
                                   (expr-value-lambda->param f))))
                   :primop (dims-of-type-value-list
                            (arrow-type-value-inputs
                             (type-value-array->elem
                              (type-of-primop-value-fun
                               (expr-value-primop->val f)))))
                   :otherwise (reserr nil))))
  :expand ((expr-value-alpha-related-via-p new-f f w))
  :enable (not-expr-value-groundp-when-lambda
           dims-of-inputs-of-type-of-primop-value-fun-when-related-safe)
  :use ((:instance expr-value-primop->val-when-equal-fix (x new-f) (y f))
        (:instance dims-of-type-value-when-type-value-alpha-related-via-p
                   (new-tval (var+typevalue->type (expr-value-lambda->param new-f)))
                   (tval (var+typevalue->type (expr-value-lambda->param f)))
                   (w (expr-value-witness-closure->ptype w)))))

(defruled fun-value-param-dims-alpha
  (implies (expr-value-alpha-equiv-p new-val val)
           (equal (fun-value-param-dims new-val)
                  (fun-value-param-dims val)))
  :enable (fun-value-param-dims)
  :use (expr-value-first-fun-alpha
        (:instance expr-value-alpha-equiv-p
                   (new-val (expr-value-first-fun new-val))
                   (val (expr-value-first-fun val)))
        (:instance param-dims-when-first-funs-related
                   (new-f (expr-value-first-fun new-val))
                   (f (expr-value-first-fun val))
                   (w (expr-value-alpha-equiv-p-witness
                       (expr-value-first-fun new-val)
                       (expr-value-first-fun val))))))

; The final output of related function type values is related.

(defruled type-value-alpha-equiv-p-of-fix-when-equiv
  (implies (type-value-alpha-equiv-p new-tval tval)
           (type-value-alpha-equiv-p (type-value-fix new-tval)
                                     (type-value-fix tval)))
  :expand ((type-value-alpha-equiv-p new-tval tval))
  :use ((:instance type-value-alpha-equiv-p-suff
                   (new-tval (type-value-fix new-tval))
                   (tval (type-value-fix tval))
                   (w (type-value-alpha-equiv-p-witness new-tval tval)))))

(local
 (defun arrow-output-induct2 (new tv w)
   (declare (xargs :measure (type-value-count tv)))
   (if (and (type-value-case tv :fun)
            (not (type-value-witness-case w :leaf)))
       (arrow-output-induct2 (type-value-fun->out new)
                            (type-value-fun->out tv)
                            (type-value-witness-fun->out w))
     (list new w))))

(defruled type-value-groundp-of-arrow-type-value-output
  (implies (type-value-groundp tv)
           (type-value-groundp (arrow-type-value-output tv)))
  :induct (arrow-type-value-output tv)
  :enable (arrow-type-value-output
           type-value-groundp-of-type-value-fun->out))

(defruled type-value-leaf-case-when-related
  (implies (and (type-value-alpha-related-via-p new tv w)
                (type-value-witness-case w :leaf))
           (and (equal (type-value-fix new) (type-value-fix tv))
                (type-value-groundp tv)))
  :expand ((type-value-alpha-related-via-p new tv w)))

(defruled fun-out-related-when-related
  (implies (and (type-value-alpha-related-via-p new tv w)
                (equal (type-value-kind tv) :fun)
                (not (type-value-witness-case w :leaf)))
           (type-value-alpha-related-via-p (type-value-fun->out new)
                                           (type-value-fun->out tv)
                                           (type-value-witness-fun->out w)))
  :expand ((type-value-alpha-related-via-p new tv w)))

(defruled arrow-type-value-output-alpha-equiv-when-leaf
  (implies (and (type-value-alpha-related-via-p new tv w)
                (type-value-witness-case w :leaf))
           (type-value-alpha-equiv-p (arrow-type-value-output new)
                                     (arrow-type-value-output tv)))
  :enable (type-value-groundp-of-arrow-type-value-output)
  :disable (type-value-alpha-related-via-p-when-groundp
            equal-when-type-value-alpha-related-via-p-groundp)
  :use (type-value-leaf-case-when-related
        (:instance arrow-type-value-output-type-value-equiv-congruence-on-tval
                   (tval new) (tval-equiv tv))
        (:instance type-value-alpha-equiv-p-of-same
                   (tval (arrow-type-value-output tv)))))

(defruled arrow-type-value-output-alpha-equiv
  (implies (type-value-alpha-related-via-p new tv w)
           (type-value-alpha-equiv-p (arrow-type-value-output new)
                                     (arrow-type-value-output tv)))
  :induct (arrow-output-induct2 new tv w)
  :enable (arrow-type-value-output
           type-value-kind-when-type-value-alpha-related-via-p-safe
           type-value-alpha-equiv-p-when-related
           type-value-alpha-equiv-p-of-fix-when-equiv
           fun-out-related-when-related
           arrow-type-value-output-alpha-equiv-when-leaf))

; Result types of related function values.

(defruled type-value-alpha-equiv-p-of-array-when-related
  (implies (type-value-alpha-related-via-p new-elem elem w)
           (type-value-alpha-equiv-p (type-value-array new-elem dims)
                                     (type-value-array elem dims)))
  :expand ((:free (nt w) (type-value-alpha-related-via-p
                          nt (type-value-array elem dims) w)))
  :use ((:instance type-value-alpha-equiv-p-suff
                   (new-tval (type-value-array new-elem dims))
                   (tval (type-value-array elem dims))
                   (w (type-value-witness-array w)))))

; The output type of the last stage of IOTA (a product type closure with an
; empty environment) is related to itself as the shape reification type.

(defruled type-value-alpha-related-via-p-of-iota-type-same
  (type-value-alpha-related-via-p
   '(:sigma (:shape "s") (:bracket (:base (:int)) ((:shape (:var "s"))))
            ((ienv (ispaces)) (types)))
   '(:sigma (:shape "s") (:bracket (:base (:int)) ((:shape (:var "s"))))
            ((ienv (ispaces)) (types)))
   '(:closure ((dim) (shape) (atom) (array) (expr) (avoid)) nil))
  :expand ((type-value-alpha-related-via-p
            '(:sigma (:shape "s") (:bracket (:base (:int)) ((:shape (:var "s"))))
                     ((ienv (ispaces)) (types)))
            '(:sigma (:shape "s") (:bracket (:base (:int)) ((:shape (:var "s"))))
                     ((ienv (ispaces)) (types)))
            '(:closure ((dim) (shape) (atom) (array) (expr) (avoid)) nil)))
  :enable (type-denv-alpha-related-via-p
           type-denv-alpha-avoided-p
           type-denv-keys-within-p
           type-fresh-ok
           denv-ispace-vars-covered-p-when-empty
           denv-ispace-vars-avoided-p-when-empty
           type-var-map-avoided-p-when-empty)
  :disable ((:e type-value-alpha-related-via-p)
            (:e type-denv-alpha-related-via-p)
            (:e type-denv-alpha-avoided-p)))

(defruled type-value-alpha-equiv-p-of-iota-type-same
  (type-value-alpha-equiv-p
   '(:sigma (:shape "s") (:bracket (:base (:int)) ((:shape (:var "s"))))
            ((ienv (ispaces)) (types)))
   '(:sigma (:shape "s") (:bracket (:base (:int)) ((:shape (:var "s"))))
            ((ienv (ispaces)) (types))))
  :use ((:instance type-value-alpha-equiv-p-suff
                   (new-tval '(:sigma (:shape "s")
                                      (:bracket (:base (:int)) ((:shape (:var "s"))))
                                      ((ienv (ispaces)) (types))))
                   (tval '(:sigma (:shape "s")
                                  (:bracket (:base (:int)) ((:shape (:var "s"))))
                                  ((ienv (ispaces)) (types))))
                   (w '(:closure ((dim) (shape) (atom) (array) (expr) (avoid)) nil))))
  :enable type-value-alpha-related-via-p-of-iota-type-same)

(defruled output-of-type-of-primop-value-fun-alpha-equiv
  (implies (primop-value-alpha-related-via-p new-op op tws ws)
           (type-value-alpha-equiv-p
            (arrow-type-value-output
             (type-value-array->elem (type-of-primop-value-fun new-op)))
            (arrow-type-value-output
             (type-value-array->elem (type-of-primop-value-fun op)))))
  :expand ((primop-value-alpha-related-via-p new-op op tws ws))
  :enable (type-of-primop-value-fun
           arrow-type-value-output
           nest-function-type-values
           type-value-alpha-equiv-p-of-array-when-related
           type-value-alpha-equiv-p-of-iota-type-same
           type-value-alpha-equiv-p-of-same))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Result types of related function values are related; hence the empty
; results of applications over empty frames are related.

(defruled type-value-alpha-equiv-p-of-vector-empty-elem-when-alpha-equiv
  (implies (and (expr-value-alpha-equiv-p new-val val)
                (equal (expr-value-kind val) :vector-empty))
           (type-value-alpha-equiv-p (expr-value-vector-empty->elem new-val)
                                     (expr-value-vector-empty->elem val)))
  :enable (type-value-alpha-equiv-p-when-related
           expr-value-kind-when-expr-value-alpha-equiv-p)
  :expand ((expr-value-alpha-equiv-p new-val val)
           (expr-value-alpha-related-via-p
            new-val val (expr-value-alpha-equiv-p-witness new-val val)))
  :use ((:instance expr-value-vector-empty->elem-when-equal-fix
                   (x new-val) (y val))
        (:instance type-value-groundp-of-expr-value-vector-empty->elem
                   (expr-value val))
        (:instance type-value-alpha-equiv-p-of-same
                   (tval (expr-value-vector-empty->elem val)))))

(defruled arrow-type-value-output-alpha-equiv-when-equiv
  (implies (type-value-alpha-equiv-p new tv)
           (type-value-alpha-equiv-p (arrow-type-value-output new)
                                     (arrow-type-value-output tv)))
  :expand ((type-value-alpha-equiv-p new tv))
  :use ((:instance arrow-type-value-output-alpha-equiv
                   (w (type-value-alpha-equiv-p-witness new tv)))))

(defruled result-type-when-first-funs-related
  (implies (expr-value-alpha-related-via-p new-f f w)
           (b* ((tval (expr-value-case
                       f
                       :primop (arrow-type-value-output
                                (type-value-array->elem
                                 (type-of-primop-value-fun
                                  (expr-value-primop->val f))))
                       :lambda (b* ((type? (expr-value-lambda->type? f)))
                                 (type-value-option-case
                                  type?
                                  :some type?.val
                                  :none (reserr nil)))
                       :otherwise (reserr nil)))
                (new-tval (expr-value-case
                           new-f
