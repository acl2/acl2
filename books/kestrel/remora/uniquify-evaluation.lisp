(defruled bind-alpha-fresh-p-when-cfun
  (implies (and (equal (bind-kind bind) :cfun)
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b))
           (b* ((tparams (cfun-tparams bind))
                (new-tparams (cfun-tparams new-bind))
                (iparams (cfun-iparams bind))
                (new-iparams (cfun-iparams new-bind))
                ((mv & atom-renam array-renam)
                 (type-var-list-alpha-extend new-tparams tparams
                                             (var-renamings->atom r)
                                             (var-renamings->array r)))
                ((mv & dim-renam shape-renam)
                 (ispace-var-list-alpha-extend new-iparams iparams
                                               (var-renamings->dim r)
                                               (var-renamings->shape r)))
                (tbody-r (change-var-renamings r
                                               :atom atom-renam
                                               :array array-renam))
                (inner-r (change-var-renamings tbody-r
                                               :dim dim-renam
                                               :shape shape-renam))
                (names (var+type?-list->var (bind-cfun->params bind)))
                (new-names (var+type?-list->var (bind-cfun->params new-bind)))
                (body-r (change-var-renamings
                         inner-r
                         :expr (extend-renaming-list names new-names
                                                     (var-renamings->expr r))))
                (lam-expr (cfun-lambda-expr (bind-cfun->params bind)
                                            (bind-cfun->expr bind)
                                            (bind-cfun->type bind)))
                (ilam-expr (cfun-ilambda-expr iparams lam-expr))
                (tbset (cfun-layer-support tparams
                                           (type-var-list->name new-tparams)
                                           ilam-expr tbody-r b))
                (ibset (cfun-layer-support iparams
                                           (ispace-var-list->name new-iparams)
                                           lam-expr inner-r tbset))
                (lbset (cfun-layer-support (bind-cfun->params bind) new-names
                                           (bind-cfun->expr bind) body-r ibset)))
             (and (name-fresh-ok (bind-cfun->var bind) (bind-cfun->var new-bind)
                                 (var-renamings->expr r) b)
                  (type-var-list-fresh-ok new-tparams tparams
                                          (var-renamings->atom r)
                                          (var-renamings->array r)
                                          b)
                  (no-duplicatesp-equal new-tparams)
                  (set::emptyp
                   (set::intersect
                    (set::mergesort new-tparams)
                    (type-var-set-rename-type-vars
                     (set::difference
                      (set::union
                       (var+type?-list-free-type-vars (bind-cfun->params bind))
                       (set::union (type-free-type-vars (bind-cfun->type bind))
                                   (expr-free-type-vars (bind-cfun->expr bind))))
                      (set::mergesort tparams))
                     (var-renamings->atom r)
                     (var-renamings->array r))))
                  (ispace-var-list-fresh-ok new-iparams iparams
                                            (var-renamings->dim r)
                                            (var-renamings->shape r)
                                            tbset)
                  (no-duplicatesp-equal new-iparams)
                  (set::emptyp
                   (set::intersect
                    (set::mergesort new-iparams)
                    (ispace-var-set-rename-ispace-vars
                     (set::difference
                      (set::union
                       (var+type?-list-free-ispace-vars (bind-cfun->params bind))
                       (set::union (type-free-ispace-vars (bind-cfun->type bind))
                                   (expr-free-ispace-vars (bind-cfun->expr bind))))
                      (set::mergesort iparams))
                     (var-renamings->dim r)
                     (var-renamings->shape r))))
                  (var+type?-list-types-fresh-ok (bind-cfun->params bind) inner-r)
                  (type-fresh-ok (bind-cfun->type bind) inner-r)
                  (string-list-fresh-ok names new-names
                                        (var-renamings->expr r) ibset)
                  (no-duplicatesp-equal new-names)
                  (set::emptyp
                   (set::intersect
                    (set::mergesort new-names)
                    (rename-var-string-set
                     (set::difference (expr-free-expr-vars (bind-cfun->expr bind))
                                      (set::mergesort names))
                     (var-renamings->expr r))))
                  (expr-alpha-fresh-p (bind-cfun->expr new-bind)
                                      (bind-cfun->expr bind)
                                      body-r lbset))))
  :expand ((bind-alpha-fresh-p new-bind bind r b)
           (bind-name bind)
           (bind-name new-bind))
  :enable (cfun-tparams cfun-iparams)
  :use bind-alpha-related-p-when-cfun)

(defruled expr-alpha-fresh-p-of-cfun-desugared-expr
  (implies (and (equal (bind-kind bind) :cfun)
                (bind-alpha-related-p new-bind bind r)
