;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The annotation check: the assembled types are absent together (when a
; parameter lacks its type), and their evaluations fail together: they are
; closures (never failing) when there are type or ispace parameters, and
; otherwise function types (or the result type) whose evaluations are
; related by EVAL-TYPE-ALPHA, the renamed one being the renaming of the
; original.

(defruled cfun-desugared-type-alpha
  (implies (and (equal (bind-kind bind) :cfun)
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind)))
           (b* ((type (cfun-desugared-type bind))
                (new-type (cfun-desugared-type new-bind)))
             (and (equal (reserrp new-type) (reserrp type))
                  (implies (not (reserrp type))
                           (equal (reserrp (eval-type new-type
                                                      (expr-denv->tenv new-denv)))
                                  (reserrp (eval-type type
                                                      (expr-denv->tenv denv))))))))
  :expand ((bind-free-ispace-vars bind)
           (bind-free-type-vars bind)
           (expr-denv-alpha-related-via-p new-denv denv r dw)
           (:free (i tv e) (expr-denv-alpha-avoided-p new-denv denv r i tv e))
           (:free (i tv) (type-denv-alpha-avoided-p (expr-denv->tenv new-denv)
                                                    (expr-denv->tenv denv) r i tv)))
  :enable (cfun-desugared-type
           cfun-tparams
           cfun-iparams
           type-list-or-err-of-cfun-new-params
           type-rename-all-vars-of-cfun-fun-type
           type-list-fresh-ok-of-type-list-or-err
           type-fresh-ok-of-cfun-fun-type
           type-list-free-ispace-vars-of-type-list-or-err
           type-list-free-type-vars-of-type-list-or-err
           type-free-ispace-vars-of-cfun-fun-type
           type-free-type-vars-of-cfun-fun-type
           not-reserrp-of-eval-type-of-make-type-forall/foralln
           not-reserrp-of-eval-type-of-make-type-pi/pin
           type-var-list-alpha-extend-of-nil
           ispace-var-list-alpha-extend-of-nil
           type-var-list-alpha-extend-when-not-consp
           ispace-var-list-alpha-extend-when-not-consp
           var+type?-list-types-fresh-ok-of-change-expr
           denv-ispace-vars-avoided-p-monotone
           type-var-map-avoided-p-monotone
           subset-of-union
           subset-of-union-right-1
           subset-of-union-right-2
           difference-of-nil-right
           not-reserrp-when-typep
           not-reserrp-when-type-listp)
  :use (bind-alpha-related-p-when-cfun
        bind-alpha-fresh-p-when-cfun
        type-list-or-err-of-cfun-new-params
        (:instance eval-type-alpha-when-equal
                   (new-type (cfun-fun-type
                              (var+type?-list->type-list-or-err
                               (bind-cfun->params new-bind))
                              (bind-cfun->type new-bind)))
                   (type (cfun-fun-type
                          (var+type?-list->type-list-or-err
                           (bind-cfun->params bind))
                          (bind-cfun->type bind)))
                   (denv (expr-denv->tenv denv))
                   (new-denv (expr-denv->tenv new-denv))
                   (wmap (denv-witness->types dw))))
  :disable (no-duplicatesp-equal-when-no-duplicatesp-equal-of-type-var-list->name
            no-duplicatesp-equal-when-no-duplicatesp-equal-of-ispace-var-list->name
            no-duplicatesp-equal-when-not-duplicated-names
            duplicated-names-when-no-duplicatesp-equal
            member-equal-of-type-var-list->name-when-member-equal
            member-equal-of-ispace-var-list->name-when-member-equal
            member-equal
            acl2::subsetp-car-member
            acl2::setp-when-string-setp
            acl2::string-setp-of-union))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The case lemma.

; Value-like binds whose annotation is only checked: the bound expression
; is evaluated, then a check (whose value is discarded) must not fail, and
; the environment is extended at the expression layer.  The combined
; function binds are of this form, the check being the evaluation of the
; desugared type.

(define eval-checked-value-bind ((var stringp)
                                 (expr exprp)
                                 check
                                 (denv expr-denvp)
                                 (limit natp))
  :returns (new-denv expr-denv-resultp)
  :verify-guards nil
  (b* (((ok val) (eval-expr expr denv (1- limit)))
       ((ok &) check))
    (expr-denv-add-expr var val denv)))

(defruled eval-checked-value-bind-alpha-equiv
  (implies (and (not (zp limit))
                (stringp var)
                (stringp new-var)
                (equal (reserrp new-check) (reserrp check))
                (eval-expr-ok expr denv (1- limit))
                (expr-alpha-related-p new-expr expr r)
                (expr-alpha-fresh-p new-expr expr r b)
                (name-fresh-ok var new-var (var-renamings->expr r) b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-free-ispace-vars expr)
                                           (expr-free-type-vars expr)
                                           (expr-free-expr-vars expr))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (change-var-renamings
                        r :expr (extend-renaming var new-var
                                                 (var-renamings->expr r))))
                (result (eval-checked-value-bind var expr check denv limit))
                (new-result (eval-checked-value-bind new-var new-expr new-check
                                                     new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (expr-denv-alpha-equiv-p new-result result new-r)))))
  :enable (eval-checked-value-bind
           not-reserrp-when-expr-valuep
           expr-valuep-when-result-not-error
           expr-value-wfp-of-eval-expr
           not-reserrp-when-expr-denvp)
  :use ((:instance eval-expr-ok-necc
                   (limit (1- limit)))
        (:instance expr-denv-alpha-equiv-p-of-add-expr-when-equiv
                   (new-val (eval-expr new-expr new-denv (1- limit)))
                   (val (eval-expr expr denv (1- limit))))))

(defruled eval-checked-value-bind-alpha
  (implies (and (not (zp limit))
                (stringp var)
                (stringp new-var)
                (equal (reserrp new-check) (reserrp check))
                (eval-expr-ok expr denv (1- limit))
                (expr-alpha-related-p new-expr expr r)
                (expr-alpha-fresh-p new-expr expr r b)
                (name-fresh-ok var new-var (var-renamings->expr r) b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-free-ispace-vars expr)
                                           (expr-free-type-vars expr)
                                           (expr-free-expr-vars expr))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (change-var-renamings
                        r :expr (extend-renaming var new-var
                                                 (var-renamings->expr r))))
                (result (eval-checked-value-bind var expr check denv limit))
                (new-result (eval-checked-value-bind new-var new-expr new-check
                                                     new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (and (expr-denv-alpha-equiv-p new-result result new-r)
                                (expr-denv-keys-supported-p
                                 result new-r
                                 (set::insert new-var (string-sfix b)))
                                (implies
                                 (and (expr-denv-alpha-avoided-p
                                       new-denv denv r
                                       ivars tvars
                                       (set::delete var (string-sfix evars)))
                                      (not (set::in new-var
                                                    (rename-var-string-set
                                                     (set::delete var
                                                                  (string-sfix evars))
                                                     (var-renamings->expr r)))))
                                 (expr-denv-alpha-avoided-p
                                  new-result result new-r
                                  ivars tvars evars)))))))
  :enable (eval-checked-value-bind
           expr-denv-keys-supported-p-of-add-expr
           not-reserrp-when-expr-valuep
           expr-valuep-when-result-not-error
           not-reserrp-when-expr-denvp)
  :use (eval-checked-value-bind-alpha-equiv
        (:instance expr-denv-alpha-avoided-p-of-add-expr
                   (name var)
                   (new-name new-var)
                   (new-val (eval-expr new-expr new-denv (1- limit)))
                   (val (eval-expr expr denv (1- limit))))))

; Combined function binds as checked value binds.

(defruled eval-bind-when-cfun-type-error
  (implies (and (equal (bind-kind bind) :cfun)
                (not (zp limit))
                (reserrp (cfun-desugared-type bind)))
           (reserrp (eval-bind bind denv limit)))
  :enable eval-bind-when-cfun)

(defruled eval-bind-when-cfun-checked
  (implies (and (equal (bind-kind bind) :cfun)
                (not (zp limit))
                (not (reserrp (cfun-desugared-type bind))))
           (equal (eval-bind bind denv limit)
                  (eval-checked-value-bind (bind-cfun->var bind)
                                           (cfun-desugared-expr bind)
                                           (eval-type (cfun-desugared-type bind)
                                                      (expr-denv->tenv denv))
                                           denv limit)))
  :enable (eval-bind-when-cfun eval-checked-value-bind))

(defruled eval-bind-ok-when-cfun-aux
  (implies (and (equal (bind-kind bind) :cfun)
                (not (zp limit))
                (implies (not (reserrp (cfun-desugared-type bind)))
                         (eval-expr-ok (cfun-desugared-expr bind) denv (1- limit)))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit))
                (new-result (eval-bind new-bind new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (and (expr-denv-alpha-equiv-p new-result result new-r)
                                (expr-denv-keys-supported-p
                                 result new-r
                                 (set::insert (str-fix (bind-name new-bind))
                                              (string-sfix b)))
                                (implies
                                 (and (expr-denv-alpha-avoided-p
                                       new-denv denv r
                                       (set::difference
                                        (ispace-var-set-fix ivars)
                                        (bind-bound-ispace-vars bind))
                                       (set::difference
                                        (type-var-set-fix tvars)
                                        (bind-bound-type-vars bind))
                                       (set::difference
                                        (string-sfix evars)
                                        (bind-bound-expr-vars bind)))
                                      (bind-nocapture-ok new-bind bind r
                                                         evars tvars ivars))
                                 (expr-denv-alpha-avoided-p
                                  new-result result new-r
                                  ivars tvars evars)))))))
  :expand ((bind-bound-ispace-vars bind)
           (bind-bound-type-vars bind)
           (bind-bound-expr-vars bind)
           (bind-nocapture-ok new-bind bind r evars tvars ivars)
           (bind-alpha-extended-renamings new-bind bind r)
           (bind-name bind)
           (bind-name new-bind))
  :cases ((reserrp (cfun-desugared-type bind)))
  :enable (eval-bind-when-cfun-type-error
           eval-bind-when-cfun-checked
           difference-of-nil-right)
  :use (bind-alpha-related-p-when-cfun
        bind-alpha-fresh-p-when-cfun
        cfun-desugared-type-alpha
        expr-alpha-related-p-of-cfun-desugared-expr
        expr-alpha-fresh-p-of-cfun-desugared-expr
        subset-expr-free-ispace-vars-of-cfun-desugared-expr
        subset-expr-free-type-vars-of-cfun-desugared-expr
        subset-expr-free-expr-vars-of-cfun-desugared-expr
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (bind-free-ispace-vars bind))
                   (tvars2 (bind-free-type-vars bind))
                   (evars2 (bind-free-expr-vars bind))
                   (ivars1 (expr-free-ispace-vars (cfun-desugared-expr bind)))
                   (tvars1 (expr-free-type-vars (cfun-desugared-expr bind)))
                   (evars1 (expr-free-expr-vars (cfun-desugared-expr bind))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (set::difference (ispace-var-set-fix ivars) nil))
                   (tvars2 (set::difference (type-var-set-fix tvars) nil))
                   (evars2 (set::delete (bind-cfun->var bind) (string-sfix evars)))
                   (ivars1 ivars)
                   (tvars1 tvars)
                   (evars1 (set::delete (bind-cfun->var bind) (string-sfix evars))))
        (:instance eval-checked-value-bind-alpha
                   (var (bind-cfun->var bind))
                   (new-var (bind-cfun->var new-bind))
                   (expr (cfun-desugared-expr bind))
                   (new-expr (cfun-desugared-expr new-bind))
                   (check (eval-type (cfun-desugared-type bind)
                                     (expr-denv->tenv denv)))
                   (new-check (eval-type (cfun-desugared-type new-bind)
                                         (expr-denv->tenv new-denv))))))

(defruled eval-bind-ok-when-cfun
  (implies (and (equal (bind-kind bind) :cfun)
                (implies (not (reserrp (cfun-desugared-type bind)))
                         (eval-expr-ok (cfun-desugared-expr bind) denv (1- limit))))
           (eval-bind-ok bind denv limit))
  :expand ((eval-bind-ok bind denv limit))
  :cases ((zp limit))
  :enable eval-bind-when-zp-limit
  :use ((:instance eval-bind-ok-when-cfun-aux
                   (new-bind (mv-nth 0 (eval-bind-ok-witness bind denv limit)))
                   (new-denv (mv-nth 1 (eval-bind-ok-witness bind denv limit)))
                   (r (mv-nth 2 (eval-bind-ok-witness bind denv limit)))
                   (dw (mv-nth 3 (eval-bind-ok-witness bind denv limit)))
                   (b (mv-nth 4 (eval-bind-ok-witness bind denv limit)))
                   (evars (mv-nth 5 (eval-bind-ok-witness bind denv limit)))
                   (tvars (mv-nth 6 (eval-bind-ok-witness bind denv limit)))
                   (ivars (mv-nth 7 (eval-bind-ok-witness bind denv limit))))))

