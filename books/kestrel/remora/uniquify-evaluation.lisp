;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Lists of binds: threading the environments, renamings, support sets,
; and avoided variables through the sequential scopes.

(defruled eval-bind-list-when-zp-limit
  (implies (zp limit)
           (equal (eval-bind-list binds denv limit)
                  (reserr :limit)))
  :expand ((eval-bind-list binds denv limit)))

(defruled eval-bind-list-when-endp
  (implies (and (not (zp limit))
                (endp binds))
           (equal (eval-bind-list binds denv limit)
                  (expr-denv-fix denv)))
  :expand ((eval-bind-list binds denv limit)))

(defruled eval-bind-list-when-consp
  (implies (and (not (zp limit))
                (consp binds))
           (equal (eval-bind-list binds denv limit)
                  (b* (((ok denv1) (eval-bind (car binds) denv (1- limit))))
                    (eval-bind-list (cdr binds) denv1 (1- limit)))))
  :expand ((eval-bind-list binds denv limit)))

(defruled subset-delete-monotone
  (implies (set::subset a b)
           (set::subset (set::delete x a) (set::delete x b)))
  :enable (set::pick-a-point-subset-strategy set::delete-in set::subset-in))

(defruled bind-nocapture-ok-anti-monotone
  (implies (and (bind-nocapture-ok new-b b r evars2 tvars2 ivars2)
                (set::subset (string-sfix evars1) (string-sfix evars2))
                (set::subset (type-var-set-fix tvars1) (type-var-set-fix tvars2))
                (set::subset (ispace-var-set-fix ivars1)
                             (ispace-var-set-fix ivars2)))
           (bind-nocapture-ok new-b b r evars1 tvars1 ivars1))
  :enable (bind-nocapture-ok subset-delete-monotone)
  :use ((:instance not-in-rename-var-string-set-when-subset
                   (elt (str-fix (bind-name new-b)))
                   (a (set::delete (str-fix (bind-name b)) (string-sfix evars1)))
                   (b (set::delete (str-fix (bind-name b)) (string-sfix evars2)))
                   (m (var-renamings->expr r)))
        (:instance not-in-type-var-image-when-subset
                   (elt (bind-type->var new-b))
                   (a (set::delete (bind-type->var b) (type-var-set-fix tvars1)))
                   (b (set::delete (bind-type->var b) (type-var-set-fix tvars2)))
                   (atom-m (var-renamings->atom r))
                   (array-m (var-renamings->array r)))
        (:instance not-in-ispace-var-image-when-subset
                   (elt (bind-ispace->var new-b))
                   (a (set::delete (bind-ispace->var b) (ispace-var-set-fix ivars1)))
                   (b (set::delete (bind-ispace->var b) (ispace-var-set-fix ivars2)))
                   (dim-m (var-renamings->dim r))
                   (shape-m (var-renamings->shape r)))))

; The empty list.

(defruled eval-bind-list-ok-when-endp-aux
  (implies (and (endp binds)
                (not (zp limit))
                (bind-list-alpha-related-p new-binds binds r)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw))
           (b* ((new-r (bind-list-alpha-extended-renamings new-binds binds r))
                (result (eval-bind-list binds denv limit))
                (new-result (eval-bind-list new-binds new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (and (expr-denv-alpha-equiv-p new-result result new-r)
                                (expr-denv-keys-supported-p
                                 result new-r
                                 (set::union (list-to-oset (bind-list-names new-binds))
                                             (string-sfix b)))
                                (implies
                                 (and (expr-denv-alpha-avoided-p
                                       new-denv denv r
                                       (set::difference
                                        (ispace-var-set-fix ivars)
                                        (bind-list-bound-ispace-vars binds))
                                       (set::difference
                                        (type-var-set-fix tvars)
                                        (bind-list-bound-type-vars binds))
                                       (set::difference
                                        (string-sfix evars)
                                        (bind-list-bound-expr-vars binds)))
                                      (bind-list-body-scope-fresh-ok
                                       new-binds binds r evars tvars ivars))
                                 (expr-denv-alpha-avoided-p
                                  new-result result new-r
                                  ivars tvars evars)))))))
  :expand ((bind-list-alpha-related-p new-binds binds r)
           (bind-list-alpha-extended-renamings new-binds binds r)
           (bind-list-names new-binds)
           (bind-list-bound-ispace-vars binds)
           (bind-list-bound-type-vars binds)
           (bind-list-bound-expr-vars binds))
  :enable (eval-bind-list-when-endp
           difference-of-nil-right
           expr-denv-keys-supported-p-monotone
           not-reserrp-when-expr-denvp)
  :use ((:instance expr-denv-alpha-equiv-p-suff
                   (new-denv (expr-denv-fix new-denv))
                   (denv (expr-denv-fix denv))
                   (r (var-renamings-fix r))
                   (dw dw))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (set::difference (ispace-var-set-fix ivars) nil))
                   (tvars2 (set::difference (type-var-set-fix tvars) nil))
                   (evars2 (set::difference (string-sfix evars) nil))
                   (ivars1 ivars)
                   (tvars1 tvars)
                   (evars1 evars))))

(defruled eval-bind-list-ok-when-endp
  (implies (endp binds)
           (eval-bind-list-ok binds denv limit))
  :expand ((eval-bind-list-ok binds denv limit))
  :cases ((zp limit))
  :enable eval-bind-list-when-zp-limit
  :use ((:instance eval-bind-list-ok-when-endp-aux
                   (new-binds (mv-nth 0 (eval-bind-list-ok-witness binds denv limit)))
                   (new-denv (mv-nth 1 (eval-bind-list-ok-witness binds denv limit)))
                   (r (mv-nth 2 (eval-bind-list-ok-witness binds denv limit)))
                   (dw (mv-nth 3 (eval-bind-list-ok-witness binds denv limit)))
                   (b (mv-nth 4 (eval-bind-list-ok-witness binds denv limit)))
                   (evars (mv-nth 5 (eval-bind-list-ok-witness binds denv limit)))
                   (tvars (mv-nth 6 (eval-bind-list-ok-witness binds denv limit)))
                   (ivars (mv-nth 7 (eval-bind-list-ok-witness binds denv limit))))))

; The non-empty list: the first bind (induction hypothesis on the bind),
; then the rest in the extended environments (induction hypothesis on the
; list), with the first bind's avoided variables being the rest's free
; variables, and the body-scope variables threaded through.

(defruled eval-bind-list-ok-when-consp-first
  (implies (and (consp binds)
                (not (zp limit))
                (eval-bind-ok (car binds) denv (1- limit))
                (bind-list-alpha-related-p new-binds binds r)
                (bind-list-alpha-fresh-p new-binds binds r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-list-free-ispace-vars binds)
                                           (bind-list-free-type-vars binds)
                                           (bind-list-free-expr-vars binds))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((r1 (bind-alpha-extended-renamings (car new-binds) (car binds) r))
                (denv1 (eval-bind (car binds) denv (1- limit)))
                (new-denv1 (eval-bind (car new-binds) new-denv (1- limit))))
             (and (consp new-binds)
                  (equal (reserrp new-denv1) (reserrp denv1))
                  (implies (not (reserrp denv1))
                           (and (expr-denv-alpha-equiv-p new-denv1 denv1 r1)
                                (expr-denv-keys-supported-p
                                 denv1 r1
                                 (set::insert (str-fix (bind-name (car new-binds)))
                                              (string-sfix b)))
                                (expr-denv-alpha-avoided-p
                                 new-denv1 denv1 r1
                                 (bind-list-free-ispace-vars (cdr binds))
                                 (bind-list-free-type-vars (cdr binds))
                                 (bind-list-free-expr-vars (cdr binds))))))))
  :expand ((bind-list-alpha-related-p new-binds binds r)
           (bind-list-alpha-fresh-p new-binds binds r b)
           (bind-list-free-ispace-vars binds)
           (bind-list-free-type-vars binds)
           (bind-list-free-expr-vars binds))
  :enable (set::pick-a-point-subset-strategy
           set::subset-in
           set::union-in
           set::difference-in)
  :use ((:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (bind-list-free-ispace-vars binds))
                   (tvars2 (bind-list-free-type-vars binds))
                   (evars2 (bind-list-free-expr-vars binds))
                   (ivars1 (bind-free-ispace-vars (car binds)))
                   (tvars1 (bind-free-type-vars (car binds)))
                   (evars1 (bind-free-expr-vars (car binds))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (bind-list-free-ispace-vars binds))
                   (tvars2 (bind-list-free-type-vars binds))
                   (evars2 (bind-list-free-expr-vars binds))
                   (ivars1 (set::difference
                            (bind-list-free-ispace-vars (cdr binds))
                            (bind-bound-ispace-vars (car binds))))
                   (tvars1 (set::difference
                            (bind-list-free-type-vars (cdr binds))
                            (bind-bound-type-vars (car binds))))
                   (evars1 (set::difference
                            (bind-list-free-expr-vars (cdr binds))
                            (bind-bound-expr-vars (car binds)))))
        (:instance eval-bind-ok-necc
                   (bind (car binds))
                   (limit (1- limit))
                   (new-bind (car new-binds))
                   (evars (bind-list-free-expr-vars (cdr binds)))
                   (tvars (bind-list-free-type-vars (cdr binds)))
                   (ivars (bind-list-free-ispace-vars (cdr binds))))))

(defruled subset-difference-difference-of-union
  (set::subset (set::difference (set::difference a b) c)
               (set::difference a (set::union c b)))
  :enable (set::pick-a-point-subset-strategy set::difference-in set::union-in))

(defruled bind-list-scope-nocapture-of-first
  (implies (bind-nocapture-ok (car new-binds) (car binds) r evars tvars ivars)
           (bind-nocapture-ok (car new-binds) (car binds) r
                              (set::difference (string-sfix evars)
                                               (bind-list-bound-expr-vars (cdr binds)))
                              (set::difference (type-var-set-fix tvars)
                                               (bind-list-bound-type-vars (cdr binds)))
                              (set::difference (ispace-var-set-fix ivars)
                                               (bind-list-bound-ispace-vars (cdr binds)))))
  :use ((:instance bind-nocapture-ok-anti-monotone
                   (new-b (car new-binds))
                   (b (car binds))
                   (evars2 evars)
                   (tvars2 tvars)
                   (ivars2 ivars)
                   (evars1 (set::difference (string-sfix evars)
                                            (bind-list-bound-expr-vars (cdr binds))))
                   (tvars1 (set::difference (type-var-set-fix tvars)
                                            (bind-list-bound-type-vars (cdr binds))))
                   (ivars1 (set::difference (ispace-var-set-fix ivars)
                                            (bind-list-bound-ispace-vars (cdr binds)))))))

(defruled bind-list-scope-avoided-of-first
  (implies (expr-denv-alpha-avoided-p
            new-denv denv r
            (set::difference (ispace-var-set-fix ivars)
                             (set::union (bind-bound-ispace-vars (car binds))
                                         (bind-list-bound-ispace-vars (cdr binds))))
            (set::difference (type-var-set-fix tvars)
                             (set::union (bind-bound-type-vars (car binds))
                                         (bind-list-bound-type-vars (cdr binds))))
            (set::difference (string-sfix evars)
                             (set::union (bind-bound-expr-vars (car binds))
                                         (bind-list-bound-expr-vars (cdr binds)))))
           (expr-denv-alpha-avoided-p
            new-denv denv r
            (set::difference
             (ispace-var-set-fix
              (set::difference (ispace-var-set-fix ivars)
                               (bind-list-bound-ispace-vars (cdr binds))))
             (bind-bound-ispace-vars (car binds)))
            (set::difference
             (type-var-set-fix
              (set::difference (type-var-set-fix tvars)
                               (bind-list-bound-type-vars (cdr binds))))
             (bind-bound-type-vars (car binds)))
            (set::difference
             (string-sfix
              (set::difference (string-sfix evars)
                               (bind-list-bound-expr-vars (cdr binds))))
             (bind-bound-expr-vars (car binds)))))
  :use ((:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (set::difference
                            (ispace-var-set-fix ivars)
                            (set::union (bind-bound-ispace-vars (car binds))
                                        (bind-list-bound-ispace-vars (cdr binds)))))
                   (tvars2 (set::difference
                            (type-var-set-fix tvars)
                            (set::union (bind-bound-type-vars (car binds))
                                        (bind-list-bound-type-vars (cdr binds)))))
                   (evars2 (set::difference
                            (string-sfix evars)
                            (set::union (bind-bound-expr-vars (car binds))
                                        (bind-list-bound-expr-vars (cdr binds)))))
                   (ivars1 (set::difference
                            (set::difference (ispace-var-set-fix ivars)
                                             (bind-list-bound-ispace-vars (cdr binds)))
                            (bind-bound-ispace-vars (car binds))))
                   (tvars1 (set::difference
                            (set::difference (type-var-set-fix tvars)
                                             (bind-list-bound-type-vars (cdr binds)))
                            (bind-bound-type-vars (car binds))))
                   (evars1 (set::difference
                            (set::difference (string-sfix evars)
                                             (bind-list-bound-expr-vars (cdr binds)))
                            (bind-bound-expr-vars (car binds))))))
  :enable subset-difference-difference-of-union)

(defruled eval-bind-list-ok-when-consp-first-scope
  (implies (and (consp binds)
                (not (zp limit))
                (eval-bind-ok (car binds) denv (1- limit))
                (bind-list-alpha-related-p new-binds binds r)
                (bind-list-alpha-fresh-p new-binds binds r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-list-free-ispace-vars binds)
                                           (bind-list-free-type-vars binds)
                                           (bind-list-free-expr-vars binds))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (expr-denv-alpha-avoided-p
                 new-denv denv r
                 (set::difference (ispace-var-set-fix ivars)
                                  (bind-list-bound-ispace-vars binds))
                 (set::difference (type-var-set-fix tvars)
                                  (bind-list-bound-type-vars binds))
                 (set::difference (string-sfix evars)
                                  (bind-list-bound-expr-vars binds)))
                (bind-list-body-scope-fresh-ok new-binds binds r evars tvars ivars))
           (b* ((r1 (bind-alpha-extended-renamings (car new-binds) (car binds) r))
                (denv1 (eval-bind (car binds) denv (1- limit)))
                (new-denv1 (eval-bind (car new-binds) new-denv (1- limit))))
             (implies (not (reserrp denv1))
                      (expr-denv-alpha-avoided-p
                       new-denv1 denv1 r1
                       (set::difference (ispace-var-set-fix ivars)
                                        (bind-list-bound-ispace-vars (cdr binds)))
                       (set::difference (type-var-set-fix tvars)
                                        (bind-list-bound-type-vars (cdr binds)))
                       (set::difference (string-sfix evars)
                                        (bind-list-bound-expr-vars (cdr binds)))))))
  :expand ((bind-list-alpha-related-p new-binds binds r)
           (bind-list-alpha-fresh-p new-binds binds r b)
           (bind-list-free-ispace-vars binds)
           (bind-list-free-type-vars binds)
           (bind-list-free-expr-vars binds)
           (bind-list-bound-ispace-vars binds)
           (bind-list-bound-type-vars binds)
           (bind-list-bound-expr-vars binds)
           (bind-list-body-scope-fresh-ok new-binds binds r evars tvars ivars))
  :enable (set::pick-a-point-subset-strategy
           set::subset-in
           set::union-in
           set::difference-in)
  :use ((:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (bind-list-free-ispace-vars binds))
                   (tvars2 (bind-list-free-type-vars binds))
                   (evars2 (bind-list-free-expr-vars binds))
                   (ivars1 (bind-free-ispace-vars (car binds)))
                   (tvars1 (bind-free-type-vars (car binds)))
                   (evars1 (bind-free-expr-vars (car binds))))
        bind-list-scope-avoided-of-first
        bind-list-scope-nocapture-of-first
        (:instance eval-bind-ok-necc
                   (bind (car binds))
                   (limit (1- limit))
                   (new-bind (car new-binds))
                   (evars (set::difference (string-sfix evars)
                                           (bind-list-bound-expr-vars (cdr binds))))
                   (tvars (set::difference (type-var-set-fix tvars)
                                           (bind-list-bound-type-vars (cdr binds))))
                   (ivars (set::difference (ispace-var-set-fix ivars)
                                           (bind-list-bound-ispace-vars (cdr binds)))))))

(defruled eval-bind-list-ok-when-consp-aux
  (implies (and (consp binds)
                (not (zp limit))
                (eval-bind-ok (car binds) denv (1- limit))
                (implies (not (reserrp (eval-bind (car binds) denv (1- limit))))
                         (eval-bind-list-ok (cdr binds)
                                            (eval-bind (car binds) denv (1- limit))
                                            (1- limit)))
                (bind-list-alpha-related-p new-binds binds r)
                (bind-list-alpha-fresh-p new-binds binds r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-list-free-ispace-vars binds)
                                           (bind-list-free-type-vars binds)
                                           (bind-list-free-expr-vars binds))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (bind-list-alpha-extended-renamings new-binds binds r))
                (result (eval-bind-list binds denv limit))
                (new-result (eval-bind-list new-binds new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (and (expr-denv-alpha-equiv-p new-result result new-r)
                                (expr-denv-keys-supported-p
                                 result new-r
                                 (set::union (list-to-oset (bind-list-names new-binds))
                                             (string-sfix b)))
                                (implies
                                 (and (expr-denv-alpha-avoided-p
                                       new-denv denv r
                                       (set::difference
                                        (ispace-var-set-fix ivars)
                                        (bind-list-bound-ispace-vars binds))
                                       (set::difference
                                        (type-var-set-fix tvars)
                                        (bind-list-bound-type-vars binds))
                                       (set::difference
                                        (string-sfix evars)
                                        (bind-list-bound-expr-vars binds)))
                                      (bind-list-body-scope-fresh-ok
                                       new-binds binds r evars tvars ivars))
                                 (expr-denv-alpha-avoided-p
                                  new-result result new-r
                                  ivars tvars evars)))))))
  :expand ((bind-list-alpha-related-p new-binds binds r)
           (bind-list-alpha-fresh-p new-binds binds r b)
           (bind-list-alpha-extended-renamings new-binds binds r)
           (bind-list-names new-binds)
           (bind-list-body-scope-fresh-ok new-binds binds r evars tvars ivars))
  :enable (eval-bind-list-when-consp
           expr-denv-wfp-of-eval-bind
           not-reserrp-when-expr-denvp
           mergesort-when-consp
           expr-denv-keys-supported-p-monotone)
  :use (eval-bind-list-ok-when-consp-first
        eval-bind-list-ok-when-consp-first-scope
        (:instance expr-denv-alpha-equiv-p
                   (new-denv (eval-bind (car new-binds) new-denv (1- limit)))
                   (denv (eval-bind (car binds) denv (1- limit)))
                   (r (bind-alpha-extended-renamings (car new-binds) (car binds) r)))
        (:instance eval-bind-list-ok-necc
                   (binds (cdr binds))
                   (denv (eval-bind (car binds) denv (1- limit)))
                   (limit (1- limit))
                   (new-binds (cdr new-binds))
                   (new-denv (eval-bind (car new-binds) new-denv (1- limit)))
                   (r (bind-alpha-extended-renamings (car new-binds) (car binds) r))
                   (dw (expr-denv-alpha-equiv-p-witness
                        (eval-bind (car new-binds) new-denv (1- limit))
                        (eval-bind (car binds) denv (1- limit))
                        (bind-alpha-extended-renamings (car new-binds) (car binds) r)))
                   (b (set::insert (str-fix (bind-name (car new-binds)))
                                   (string-sfix b))))))

(defruled eval-bind-list-ok-when-consp
  (implies (and (consp binds)
                (eval-bind-ok (car binds) denv (1- limit))
                (implies (not (reserrp (eval-bind (car binds) denv (1- limit))))
                         (eval-bind-list-ok (cdr binds)
                                            (eval-bind (car binds) denv (1- limit))
                                            (1- limit))))
           (eval-bind-list-ok binds denv limit))
  :expand ((eval-bind-list-ok binds denv limit))
  :cases ((zp limit))
  :enable eval-bind-list-when-zp-limit
  :use ((:instance eval-bind-list-ok-when-consp-aux
                   (new-binds (mv-nth 0 (eval-bind-list-ok-witness binds denv limit)))
                   (new-denv (mv-nth 1 (eval-bind-list-ok-witness binds denv limit)))
                   (r (mv-nth 2 (eval-bind-list-ok-witness binds denv limit)))
                   (dw (mv-nth 3 (eval-bind-list-ok-witness binds denv limit)))
                   (b (mv-nth 4 (eval-bind-list-ok-witness binds denv limit)))
                   (evars (mv-nth 5 (eval-bind-list-ok-witness binds denv limit)))
                   (tvars (mv-nth 6 (eval-bind-list-ok-witness binds denv limit)))
                   (ivars (mv-nth 7 (eval-bind-list-ok-witness binds denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Function binds with parameters: the bound value is the closure of the
; lambda atom over the parameters and the body, i.e. a unary closure over
; the first parameter whose body is the curried remainder, with no
; annotation; its environment is restricted to the free ispace and type
; variables of the curried body (which include those of the remaining
; parameters' types) and to the free expression variables of the body
; minus all the parameters.

(defruled eval-bind-when-fun-consp
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (zp limit)))
           (equal (eval-bind bind denv limit)
                  (b* (((ok param) (eval-var+type? (car (bind-fun->params bind))
                                                   (expr-denv->tenv denv)))
                       (body (lambda-curried-body (bind-fun->params bind)
                                                  (bind-fun->expr bind)
                                                  (bind-fun->type? bind)))
                       (val (make-expr-value-lambda
                             :param param
                             :body body
                             :type? nil
                             :denv (expr-denv-restrict
                                    (expr-free-ispace-vars body)
                                    (expr-free-type-vars body)
                                    (set::difference
                                     (expr-free-expr-vars (bind-fun->expr bind))
                                     (set::mergesort
                                      (var+type?-list->var (bind-fun->params bind))))
                                    denv)))
                       (type? (bind-fun->type? bind))
                       ((ok &) (type-option-case
                                type?
                                :some (eval-type type?.val (expr-denv->tenv denv))
                                :none nil)))
                    (expr-denv-add-expr (bind-fun->var bind) val denv))))
  :expand ((eval-bind bind denv limit)))

; Function binds with one parameter: the curried body is the body itself.

(defruled eval-bind-when-fun-1
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (consp (cdr (bind-fun->params bind))))
                (not (zp limit)))
           (equal (eval-bind bind denv limit)
                  (b* (((ok param) (eval-var+type? (car (bind-fun->params bind))
                                                   (expr-denv->tenv denv)))
                       (val (make-expr-value-lambda
                             :param param
                             :body (bind-fun->expr bind)
                             :type? nil
                             :denv (expr-denv-restrict
                                    (expr-free-ispace-vars (bind-fun->expr bind))
                                    (expr-free-type-vars (bind-fun->expr bind))
                                    (set::difference
                                     (expr-free-expr-vars (bind-fun->expr bind))
                                     (set::mergesort
                                      (var+type?-list->var (bind-fun->params bind))))
                                    denv)))
                       (type? (bind-fun->type? bind))
                       ((ok &) (type-option-case
                                type?
                                :some (eval-type type?.val (expr-denv->tenv denv))
                                :none nil)))
                    (expr-denv-add-expr (bind-fun->var bind) val denv))))
  :enable (eval-bind-when-fun-consp lambda-curried-body))

(defruled eval-atom-of-atom-lambda-nil
  (implies (and (var+type?-p param)
                (exprp body)
                (not (zp limit)))
           (equal (eval-atom (atom-lambda param body nil) denv limit)
                  (b* (((ok pv) (eval-var+type? param (expr-denv->tenv denv))))
                    (make-expr-value-lambda
                     :param pv
                     :body body
                     :type? nil
                     :denv (expr-denv-restrict
                            (expr-free-ispace-vars body)
                            (expr-free-type-vars body)
                            (set::delete (var+type?->var param)
                                         (expr-free-expr-vars body))
                            denv)))))
  :enable (eval-atom-when-lambda eval-type-option)
  :expand ((atom-free-expr-vars (atom-lambda param body nil))))

(defruled var+type?->type?-of-car-when-set-vars-of-rename
  (implies (and (equal ps (var+type?-list-set-vars
                          (var+type?-list->var ps)
                          (var+type?-list-rename-all-vars qs r)))
                (consp ps)
                (consp qs))
           (equal (var+type?->type? (car ps))
                  (type-option-rename-all-vars (var+type?->type? (car qs)) r)))
  :enable (var+type?-list-set-vars
           var+type?-list-rename-all-vars
           var+type?-list-rename-ispace-vars
           var+type?-list-rename-type-vars
           var+type?-rename-ispace-vars
           var+type?-rename-type-vars
           var+type?-list->var
           type-option-rename-all-vars))

(defruled atom-alpha-related-p-of-lambda-when-fun-1
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (consp (cdr (bind-fun->params bind))))
                (bind-alpha-related-p new-bind bind r))
           (and (equal (bind-kind new-bind) :fun)
                (consp (bind-fun->params new-bind))
                (not (consp (cdr (bind-fun->params new-bind))))
                (equal (bind-fun->type? new-bind)
                       (type-option-rename-all-vars (bind-fun->type? bind) r))
                (atom-alpha-related-p
                 (atom-lambda (car (bind-fun->params new-bind))
                              (bind-fun->expr new-bind)
                              nil)
                 (atom-lambda (car (bind-fun->params bind))
                              (bind-fun->expr bind)
                              nil)
                 r)))
  :expand ((bind-alpha-related-p new-bind bind r)
           (:free (a x) (atom-alpha-related-p a x r)))
  :use ((:instance var+type?->type?-of-car-when-set-vars-of-rename
                   (ps (bind-fun->params new-bind))
                   (qs (bind-fun->params bind))))
  :enable (extend-renaming-list
           var+type?-list->var
           type-option-rename-all-vars
           type-option-rename-ispace-vars
           type-option-rename-type-vars
           len))

(defruled atom-alpha-fresh-p-of-lambda-when-fun-1
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (consp (cdr (bind-fun->params bind))))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b))
           (atom-alpha-fresh-p
            (atom-lambda (car (bind-fun->params new-bind))
                         (bind-fun->expr new-bind)
                         nil)
            (atom-lambda (car (bind-fun->params bind))
                         (bind-fun->expr bind)
                         nil)
            r b))
  :expand ((bind-alpha-fresh-p new-bind bind r b)
           (:free (a x) (atom-alpha-fresh-p a x r b)))
  :use (atom-alpha-related-p-of-lambda-when-fun-1)
  :enable (var+type?-list-types-fresh-ok
           string-list-fresh-ok
           extend-renaming-list
           var+type?-list->var
           type-option-fresh-ok
           mergesort-when-consp
           set::difference-insert-y
           difference-of-nil-right
           not-in-when-emptyp-intersect-of-insert
           expr-alpha-fresh-p-insert-from-union-support
           len))

(defruled type-option-rename-all-vars-when-typep
  (implies (typep ty)
           (equal (type-option-rename-all-vars ty r)
                  (type-rename-all-vars ty r)))
  :enable (type-option-rename-all-vars
           type-option-rename-ispace-vars
           type-option-rename-type-vars
           type-rename-all-vars
           type-option-some->val-when-typep))

(defruled type-option-rename-all-vars-of-nil
  (equal (type-option-rename-all-vars nil r) nil)
  :enable (type-option-rename-all-vars
           type-option-rename-ispace-vars
           type-option-rename-type-vars))

; The pieces of a one-parameter function bind: the freshness of its name
; and annotation, and the failure-direction relation at the free variables
; of its lambda atom and of its annotation.

(defruled bind-alpha-fresh-p-when-fun-1
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (consp (cdr (bind-fun->params bind))))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b))
           (and (name-fresh-ok (bind-fun->var bind) (bind-fun->var new-bind)
                               (var-renamings->expr r) b)
                (type-option-fresh-ok (bind-fun->type? bind) r)))
  :expand ((bind-alpha-fresh-p new-bind bind r b)
           (bind-name bind)
           (bind-name new-bind))
  :use atom-alpha-related-p-of-lambda-when-fun-1)

(defruled expr-denv-alpha-avoided-p-of-fun-1-parts
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (consp (cdr (bind-fun->params bind))))
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind)))
           (and (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-free-ispace-vars (atom-lambda (car (bind-fun->params bind)) (bind-fun->expr bind) nil))
                                           (atom-free-type-vars (atom-lambda (car (bind-fun->params bind)) (bind-fun->expr bind) nil))
                                           (atom-free-expr-vars (atom-lambda (car (bind-fun->params bind)) (bind-fun->expr bind) nil)))
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (type-option-free-ispace-vars
                                            (bind-fun->type? bind))
                                           (type-option-free-type-vars
                                            (bind-fun->type? bind))
                                           nil)))
  :expand ((bind-free-ispace-vars bind)
           (bind-free-type-vars bind)
           (bind-free-expr-vars bind)
           (:free (p e) (atom-free-ispace-vars (atom-lambda p e nil)))
           (:free (p e) (atom-free-type-vars (atom-lambda p e nil)))
           (:free (p e) (atom-free-expr-vars (atom-lambda p e nil))))
  :enable (var+type?-list->var
           var+type?-list-free-ispace-vars
           var+type?-list-free-type-vars
           mergesort-when-consp
           set::difference-insert-y
           difference-of-nil-right
           type-option-free-ispace-vars
           type-option-free-type-vars
           subset-of-union-right-1
           subset-of-union-right-2
           subset-union-drop-middle
           set::pick-a-point-subset-strategy
           set::subset-in
           set::union-in)
  :use ((:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (bind-free-ispace-vars bind))
                   (tvars2 (bind-free-type-vars bind))
                   (evars2 (bind-free-expr-vars bind))
                   (ivars1 (atom-free-ispace-vars (atom-lambda (car (bind-fun->params bind)) (bind-fun->expr bind) nil)))
                   (tvars1 (atom-free-type-vars (atom-lambda (car (bind-fun->params bind)) (bind-fun->expr bind) nil)))
                   (evars1 (atom-free-expr-vars (atom-lambda (car (bind-fun->params bind)) (bind-fun->expr bind) nil))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (bind-free-ispace-vars bind))
                   (tvars2 (bind-free-type-vars bind))
                   (evars2 (bind-free-expr-vars bind))
                   (ivars1 (type-option-free-ispace-vars (bind-fun->type? bind)))
                   (tvars1 (type-option-free-type-vars (bind-fun->type? bind)))
                   (evars1 nil))))

(defruled eval-bind-ok-when-fun-1-equiv
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (consp (cdr (bind-fun->params bind))))
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit))
                (new-result (eval-bind new-bind new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (expr-denv-alpha-equiv-p new-result result new-r)))))
  :expand ((bind-alpha-extended-renamings new-bind bind r)
           (bind-name bind)
           (bind-name new-bind))
  :enable (eval-bind-when-fun-1
           eval-atom-of-atom-lambda-nil
           var+type?-list->var
           mergesort-when-consp
           set::difference-insert-y
           difference-of-nil-right
           type-option-rename-all-vars
           type-option-rename-ispace-vars
           type-option-rename-type-vars
           type-rename-all-vars
           type-option-some->val-when-typep
           not-reserrp-when-expr-valuep
           not-reserrp-when-expr-denvp)
  :use (atom-alpha-related-p-of-lambda-when-fun-1
        atom-alpha-fresh-p-of-lambda-when-fun-1
        bind-alpha-fresh-p-when-fun-1
        expr-denv-alpha-avoided-p-of-fun-1-parts
        (:instance eval-atom-ok-when-lambda-aux
                   (atom (atom-lambda (car (bind-fun->params bind))
                                      (bind-fun->expr bind)
                                      nil))
                   (new-atom (atom-lambda (car (bind-fun->params new-bind))
                                          (bind-fun->expr new-bind)
                                          nil)))
        (:instance eval-type-option-alpha-of-expr-denvs
                   (type? (bind-fun->type? bind))
                   (ivars (type-option-free-ispace-vars (bind-fun->type? bind)))
                   (tvars (type-option-free-type-vars (bind-fun->type? bind)))
                   (evars nil))
        (:instance expr-denv-alpha-equiv-p-of-add-expr-when-equiv
                   (var (bind-fun->var bind))
                   (new-var (bind-fun->var new-bind))
                   (val (expr-value-lambda
                    (eval-var+type? (car (bind-fun->params bind))
                                    (expr-denv->tenv denv))
                    (bind-fun->expr bind)
                    nil
                    (expr-denv-restrict
                     (expr-free-ispace-vars (bind-fun->expr bind))
                     (expr-free-type-vars (bind-fun->expr bind))
                     (set::delete (var+type?->var (car (bind-fun->params bind)))
                                  (expr-free-expr-vars (bind-fun->expr bind)))
                     denv)))
                   (new-val (expr-value-lambda
                    (eval-var+type? (car (bind-fun->params new-bind))
                                    (expr-denv->tenv new-denv))
                    (bind-fun->expr new-bind)
                    nil
                    (expr-denv-restrict
                     (expr-free-ispace-vars (bind-fun->expr new-bind))
                     (expr-free-type-vars (bind-fun->expr new-bind))
                     (set::delete (var+type?->var (car (bind-fun->params new-bind)))
                                  (expr-free-expr-vars (bind-fun->expr new-bind)))
                     new-denv))))))

(defruled eval-bind-ok-when-fun-1-supported
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (consp (cdr (bind-fun->params bind))))
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit)))
             (implies (not (reserrp result))
                      (expr-denv-keys-supported-p
                       result new-r
                       (set::insert (str-fix (bind-name new-bind))
                                    (string-sfix b))))))
  :expand ((bind-alpha-extended-renamings new-bind bind r)
           (bind-name bind)
           (bind-name new-bind))
  :enable (eval-bind-when-fun-1
           expr-denv-keys-supported-p-of-add-expr
           not-reserrp-when-expr-denvp)
  :use (atom-alpha-related-p-of-lambda-when-fun-1))

(defruled eval-bind-ok-when-fun-1-avoided
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (consp (cdr (bind-fun->params bind))))
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit))
                (new-result (eval-bind new-bind new-denv limit)))
             (implies (and (not (reserrp result))
                           (expr-denv-alpha-avoided-p
                            new-denv denv r
                            (set::difference (ispace-var-set-fix ivars)
                                             (bind-bound-ispace-vars bind))
                            (set::difference (type-var-set-fix tvars)
                                             (bind-bound-type-vars bind))
                            (set::difference (string-sfix evars)
                                             (bind-bound-expr-vars bind)))
                           (bind-nocapture-ok new-bind bind r evars tvars ivars))
                      (expr-denv-alpha-avoided-p new-result result new-r
                                                 ivars tvars evars))))
  :expand ((bind-bound-ispace-vars bind)
           (bind-bound-type-vars bind)
           (bind-bound-expr-vars bind)
           (bind-nocapture-ok new-bind bind r evars tvars ivars)
           (bind-alpha-extended-renamings new-bind bind r)
           (bind-name bind)
           (bind-name new-bind))
  :enable (eval-bind-when-fun-1
           eval-atom-of-atom-lambda-nil
           lambda-curried-body
           var+type?-list->var
           mergesort-when-consp
           set::difference-insert-y
           difference-of-nil-right
           not-reserrp-when-expr-valuep
           not-reserrp-when-expr-denvp
           expr-denv-alpha-avoided-p-of-add-expr)
  :use (atom-alpha-related-p-of-lambda-when-fun-1
        eval-bind-ok-when-fun-1-equiv
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (set::difference (ispace-var-set-fix ivars) nil))
                   (tvars2 (set::difference (type-var-set-fix tvars) nil))
                   (evars2 (set::delete (bind-fun->var bind) (string-sfix evars)))
                   (ivars1 ivars)
                   (tvars1 tvars)
                   (evars1 (set::delete (bind-fun->var bind) (string-sfix evars))))))

(defruled eval-bind-ok-when-fun-1-aux
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (consp (cdr (bind-fun->params bind))))
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit))
                (new-result (eval-bind new-bind new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (and (expr-denv-alpha-equiv-p new-result result new-r)
                                (expr-denv-keys-supported-p
                                 result new-r
                                 (set::insert (str-fix (bind-name new-bind))
                                              (string-sfix b)))
                                (implies
                                 (and (expr-denv-alpha-avoided-p
                                       new-denv denv r
                                       (set::difference
                                        (ispace-var-set-fix ivars)
                                        (bind-bound-ispace-vars bind))
                                       (set::difference
                                        (type-var-set-fix tvars)
                                        (bind-bound-type-vars bind))
                                       (set::difference
                                        (string-sfix evars)
                                        (bind-bound-expr-vars bind)))
                                      (bind-nocapture-ok new-bind bind r
                                                         evars tvars ivars))
                                 (expr-denv-alpha-avoided-p
                                  new-result result new-r
                                  ivars tvars evars)))))))
  :use (eval-bind-ok-when-fun-1-equiv
        eval-bind-ok-when-fun-1-supported
        eval-bind-ok-when-fun-1-avoided))

(defruled eval-bind-ok-when-fun-1
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (consp (cdr (bind-fun->params bind)))))
           (eval-bind-ok bind denv limit))
  :expand ((eval-bind-ok bind denv limit))
  :cases ((zp limit))
  :enable eval-bind-when-zp-limit
  :use ((:instance eval-bind-ok-when-fun-1-aux
                   (new-bind (mv-nth 0 (eval-bind-ok-witness bind denv limit)))
                   (new-denv (mv-nth 1 (eval-bind-ok-witness bind denv limit)))
                   (r (mv-nth 2 (eval-bind-ok-witness bind denv limit)))
                   (dw (mv-nth 3 (eval-bind-ok-witness bind denv limit)))
                   (b (mv-nth 4 (eval-bind-ok-witness bind denv limit)))
                   (evars (mv-nth 5 (eval-bind-ok-witness bind denv limit)))
                   (tvars (mv-nth 6 (eval-bind-ok-witness bind denv limit)))
                   (ivars (mv-nth 7 (eval-bind-ok-witness bind denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Values that embed abstract syntax (closures of the three kinds, and the
; type values of the three binder types) are not ground, so they are never
; related through leaf witnesses.

(defruled not-expr-value-groundp-when-lambda
  (implies (equal (expr-value-kind val) :lambda)
           (not (expr-value-groundp val)))
  :expand ((expr-value-groundp val)))

(defruled not-expr-value-groundp-when-tlambda
  (implies (equal (expr-value-kind val) :tlambda)
           (not (expr-value-groundp val)))
  :expand ((expr-value-groundp val)))

(defruled not-expr-value-groundp-when-ilambda
  (implies (equal (expr-value-kind val) :ilambda)
           (not (expr-value-groundp val)))
  :expand ((expr-value-groundp val)))

(defruled not-type-value-groundp-when-forall
  (implies (equal (type-value-kind tval) :forall)
           (not (type-value-groundp tval)))
  :expand ((type-value-groundp tval)))

(defruled not-type-value-groundp-when-pi
  (implies (equal (type-value-kind tval) :pi)
           (not (type-value-groundp tval)))
  :expand ((type-value-groundp tval)))

(defruled not-type-value-groundp-when-sigma
  (implies (equal (type-value-kind tval) :sigma)
           (not (type-value-groundp tval)))
  :expand ((type-value-groundp tval)))

; Accessors of values equal up to fixing (the leaf case of the relation).

(defruled expr-value-primop->val-when-equal-fix
  (implies (and (equal (expr-value-fix x) (expr-value-fix y))
                (equal (expr-value-kind x) :primop)
                (equal (expr-value-kind y) :primop))
           (equal (expr-value-primop->val x)
                  (expr-value-primop->val y)))
  :use ((:instance expr-value-fix-when-primop (x x))
        (:instance expr-value-fix-when-primop (x y)))
  :disable expr-value-fix-when-primop)

(defruled expr-value-vector->elems-when-equal-fix
  (implies (and (equal (expr-value-fix x) (expr-value-fix y))
                (equal (expr-value-kind x) :vector)
                (equal (expr-value-kind y) :vector))
           (equal (expr-value-vector->elems x)
                  (expr-value-vector->elems y)))
  :use ((:instance expr-value-fix-when-vector (x x))
        (:instance expr-value-fix-when-vector (x y)))
  :disable expr-value-fix-when-vector)

(defruled expr-value-vector-empty->elem-when-equal-fix
  (implies (and (equal (expr-value-fix x) (expr-value-fix y))
                (equal (expr-value-kind x) :vector-empty)
                (equal (expr-value-kind y) :vector-empty))
           (equal (expr-value-vector-empty->elem x)
                  (expr-value-vector-empty->elem y)))
  :use ((:instance expr-value-fix-when-vector-empty (x x))
        (:instance expr-value-fix-when-vector-empty (x y)))
  :disable expr-value-fix-when-vector-empty)

; Loop-safe variants of the "equal on related values" lemmas: with a value
; related to itself in the context (ground values), the originals rewrite a
; term to itself indefinitely.

(defruled primop-value-tfunp-when-primop-value-alpha-related-via-p-safe
  (implies (and (primop-value-alpha-related-via-p new-op op tws ws)
                (syntaxp (not (equal new-op op))))
           (equal (primop-value-tfunp new-op) (primop-value-tfunp op)))
  :use primop-value-tfunp-when-primop-value-alpha-related-via-p)

(defruled primop-value-ifunp-when-primop-value-alpha-related-via-p-safe
  (implies (and (primop-value-alpha-related-via-p new-op op tws ws)
                (syntaxp (not (equal new-op op))))
           (equal (primop-value-ifunp new-op) (primop-value-ifunp op)))
  :use primop-value-ifunp-when-primop-value-alpha-related-via-p)

(defruled dims-of-expr-value-list-when-alpha-related-safe
  (implies (and (expr-value-list-alpha-related-via-p new-vals vals ws)
                (expr-value-list-wfp new-vals)
                (expr-value-list-wfp vals)
                (syntaxp (not (equal new-vals vals))))
           (equal (dims-of-expr-value-list new-vals)
                  (dims-of-expr-value-list vals)))
  :use dims-of-expr-value-list-when-alpha-related)

(defruled type-value-kind-when-type-value-alpha-related-via-p-safe
  (implies (and (type-value-alpha-related-via-p new-tval tval w)
                (syntaxp (not (equal new-tval tval))))
           (equal (type-value-kind new-tval) (type-value-kind tval)))
  :use type-value-kind-when-type-value-alpha-related-via-p)

(defruled consp-when-expr-value-list-alpha-related-via-p-safe
  (implies (and (expr-value-list-alpha-related-via-p new-vals vals ws)
                (syntaxp (not (equal new-vals vals))))
           (equal (consp new-vals) (consp vals)))
  :expand ((expr-value-list-alpha-related-via-p new-vals vals ws)))

(defruled ispace-values-match-ispace-vars-p-of-singletons-when-equal-var
  (implies (equal new-var var)
           (equal (ispace-values-match-ispace-vars-p (list ival) (list new-var))
                  (ispace-values-match-ispace-vars-p (list ival) (list var)))))

(defruled primop-value-funp-when-primop-value-alpha-related-via-p-safe
  (implies (and (primop-value-alpha-related-via-p new-op op tws ws)
                (syntaxp (not (equal new-op op))))
           (equal (primop-value-funp new-op) (primop-value-funp op)))
  :use primop-value-funp-when-primop-value-alpha-related-via-p)

; Existential forms of the equal-on-related lemmas.

(defruled len-when-expr-value-list-alpha-equiv-p
  (implies (and (expr-value-list-alpha-equiv-p new-vals vals)
                (syntaxp (not (equal new-vals vals))))
           (equal (len new-vals) (len vals)))
  :enable expr-value-list-alpha-equiv-p
  :use ((:instance len-when-expr-value-list-alpha-related-via-p
                   (ws (expr-value-list-alpha-equiv-p-witness new-vals vals)))))

(defruled dims-of-expr-value-list-when-alpha-equiv
  (implies (and (expr-value-list-alpha-equiv-p new-vals vals)
                (expr-value-list-wfp new-vals)
                (expr-value-list-wfp vals)
                (syntaxp (not (equal new-vals vals))))
           (equal (dims-of-expr-value-list new-vals)
                  (dims-of-expr-value-list vals)))
  :enable expr-value-list-alpha-equiv-p
  :use ((:instance dims-of-expr-value-list-when-alpha-related
                   (ws (expr-value-list-alpha-equiv-p-witness new-vals vals)))))

(defruled dims-of-expr-value-when-alpha-equiv
  (implies (and (expr-value-alpha-equiv-p new-val val)
                (expr-value-wfp new-val)
                (expr-value-wfp val)
                (syntaxp (not (equal new-val val))))
           (equal (dims-of-expr-value new-val)
                  (dims-of-expr-value val)))
  :enable expr-value-alpha-equiv-p
  :use ((:instance dims-of-expr-value-when-expr-value-alpha-related-via-p
                   (w (expr-value-alpha-equiv-p-witness new-val val)))))

(defruled expr-value-with-empty-dim-alpha-equiv-when-equiv
  (implies (type-value-alpha-equiv-p new-elem elem)
           (expr-value-alpha-equiv-p (expr-value-with-empty-dim dims new-elem)
                                     (expr-value-with-empty-dim dims elem)))
  :expand ((type-value-alpha-equiv-p new-elem elem))
  :use ((:instance expr-value-with-empty-dim-alpha-equiv
                   (tw (type-value-alpha-equiv-p-witness new-elem elem)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Type application (EVAL-TAPP).  The type lambda closure case: the closure
; environment, extended by the parameter at the type layer, is related to
; the new closure's extended environment under the body renamings, with the
; argument's witness entering the witness map; the induction hypothesis on
; the body then applies.

(defruled eval-tapp-when-zp-limit
  (implies (zp limit)
           (equal (eval-tapp funval tval limit)
                  (reserr :limit)))
  :expand ((eval-tapp funval tval limit)))

(defruled eval-tapp-when-tlambda
  (implies (and (equal (expr-value-kind funval) :tlambda)
                (not (zp limit)))
           (equal (eval-tapp funval tval limit)
                  (if (type-values-match-type-vars-p
                       (list tval) (list (expr-value-tlambda->param funval)))
                      (eval-expr (expr-value-tlambda->body funval)
                                 (expr-denv-add-type (expr-value-tlambda->param funval)
                                                     tval
                                                     (expr-value-tlambda->denv funval))
                                 (1- limit))
                    (reserr nil))))
  :expand ((eval-tapp funval tval limit)))

(defruled type-values-match-type-vars-p-of-singletons-when-related-2
  (implies (and (type-value-alpha-related-via-p new-tval tval tw)
                (equal (type-var-kind new-var) (type-var-kind var)))
           (equal (type-values-match-type-vars-p (list new-tval) (list new-var))
                  (type-values-match-type-vars-p (list tval) (list var))))
  :enable (type-values-match-type-vars-p
           type-value-kind-when-type-value-alpha-related-via-p))

; The support invariant survives an extension by a variable whose name is
; a key of the renaming map or is in the support set (a renamed name enters
; the map, a kept name the support set).

(defrule assoc-of-extend-renaming-or-kept
  (implies (stringp name)
           (or (omap::assoc name (extend-renaming name new-name m))
               (equal (str-fix new-name) name)))
  :rule-classes nil
  :enable (extend-renaming omap::assoc-of-update))

(defruled expr-denv-keys-supported-p-of-add-type-when-bound-or-kept-atom
  (implies (and (expr-denv-keys-supported-p denv r b)
                (type-varp var)
                (type-var-case var :atom)
                (or (omap::assoc (type-var-atom->name var)
                                 (string-string-map-fix (var-renamings->atom r)))
                    (set::in (type-var-atom->name var) (string-sfix b))))
           (expr-denv-keys-supported-p (expr-denv-add-type var tval denv) r b))
  :enable (expr-denv-keys-supported-p
           expr-denv-add-type
           type-denv-add-type
           omap::keys-of-update
           string-set-supported-p
           omap::assoc-to-in-of-keys
           set::subset-insert-x
           set::union-in))

(defruled expr-denv-keys-supported-p-of-add-type-when-bound-or-kept-array
  (implies (and (expr-denv-keys-supported-p denv r b)
                (type-varp var)
                (type-var-case var :array)
                (or (omap::assoc (type-var-array->name var)
                                 (string-string-map-fix (var-renamings->array r)))
                    (set::in (type-var-array->name var) (string-sfix b))))
           (expr-denv-keys-supported-p (expr-denv-add-type var tval denv) r b))
  :enable (expr-denv-keys-supported-p
           expr-denv-add-type
           type-denv-add-type
           omap::keys-of-update
           string-set-supported-p
           omap::assoc-to-in-of-keys
           set::subset-insert-x
           set::union-in))

; No capture of the parameter against the captured keys, from the closure's
; no capture against the body's free variables.

(defruled not-in-type-image-of-keys-when-within
  (implies (and (expr-denv-keys-within-p denv ivars tvars evars)
                (not (set::in x (type-var-set-rename-type-vars
                                 (type-var-set-fix tvars) am arm))))
           (not (set::in x (type-var-set-rename-type-vars
                            (set::delete v (omap::keys
                                            (type-denv->types (expr-denv->tenv denv))))
                            am arm))))
  :enable (expr-denv-keys-within-p type-denv-keys-within-p)
  :use ((:instance not-in-type-var-image-when-subset
                   (elt x)
                   (a (set::delete v (omap::keys (type-denv->types (expr-denv->tenv denv)))))
                   (b (type-var-set-fix tvars))
                   (atom-m am)
                   (array-m arm))
        (:instance set::subset-transitive
                   (x (set::delete v (omap::keys (type-denv->types (expr-denv->tenv denv)))))
                   (y (omap::keys (type-denv->types (expr-denv->tenv denv))))
                   (z (type-var-set-fix tvars)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defruled type-var-list-alpha-extend-singletons-atom
  (implies (and (type-var-case var :atom)
                (type-varp var)
                (type-varp new-var))
           (and (iff (mv-nth 0 (type-var-list-alpha-extend (list new-var) (list var) am arm))
                     (type-var-case new-var :atom))
                (implies (type-var-case new-var :atom)
                         (and (equal (mv-nth 1 (type-var-list-alpha-extend
                                                (list new-var) (list var) am arm))
                                     (extend-renaming (type-var-atom->name var)
                                                      (type-var-atom->name new-var)
                                                      am))
                              (equal (mv-nth 2 (type-var-list-alpha-extend
                                                (list new-var) (list var) am arm))
                                     (string-string-map-fix arm))))))
  :enable (type-var-list-alpha-extend type-var-list-alpha-extend-of-nil))

(defruled type-var-list-alpha-extend-singletons-array
  (implies (and (type-var-case var :array)
                (type-varp var)
                (type-varp new-var))
           (and (iff (mv-nth 0 (type-var-list-alpha-extend (list new-var) (list var) am arm))
                     (type-var-case new-var :array))
                (implies (type-var-case new-var :array)
                         (and (equal (mv-nth 1 (type-var-list-alpha-extend
                                                (list new-var) (list var) am arm))
                                     (string-string-map-fix am))
                              (equal (mv-nth 2 (type-var-list-alpha-extend
                                                (list new-var) (list var) am arm))
                                     (extend-renaming (type-var-array->name var)
                                                      (type-var-array->name new-var)
                                                      arm))))))
  :enable (type-var-list-alpha-extend type-var-list-alpha-extend-of-nil))

(defruled eval-tapp-ok-when-tlambda-atom-aux
  (implies (and (equal (expr-value-kind funval) :tlambda)
                (not (zp limit))
                (implies (type-values-match-type-vars-p
                          (list tval) (list (expr-value-tlambda->param funval)))
                         (eval-expr-ok (expr-value-tlambda->body funval)
                                       (expr-denv-add-type
                                        (expr-value-tlambda->param funval)
                                        tval
                                        (expr-value-tlambda->denv funval))
                                       (1- limit)))
                (expr-value-alpha-related-via-p new-funval funval w)
                (type-value-alpha-related-via-p new-tval tval tw)
                (expr-value-wfp funval)
                (expr-value-wfp new-funval)
                (type-var-case (expr-value-tlambda->param funval) :atom))
           (b* ((val (eval-tapp funval tval limit))
                (new-val (eval-tapp new-funval new-tval limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((expr-value-alpha-related-via-p new-funval funval w))
  :enable (eval-tapp-when-tlambda
           not-expr-value-groundp-when-tlambda
           type-var-list-alpha-extend-singletons-atom
           type-var->name
           expr-denv-wfp-of-expr-denv-add-type
           expr-denv-keys-supported-p-of-add-type-when-bound-or-kept-atom
           not-in-type-image-of-keys-when-within)
  :use ((:instance assoc-of-extend-renaming-or-kept
                   (name (type-var-atom->name (expr-value-tlambda->param funval)))
                   (new-name (type-var-atom->name (expr-value-tlambda->param new-funval)))
                   (m (var-renamings->atom (expr-value-witness-closure->r w))))
        (:instance type-values-match-type-vars-p-of-singletons-when-related-2
                   (new-var (expr-value-tlambda->param new-funval))
                   (var (expr-value-tlambda->param funval)))
        (:instance eval-expr-ok-necc
                   (expr (expr-value-tlambda->body funval))
                   (denv (expr-denv-add-type (expr-value-tlambda->param funval)
                                             tval
                                             (expr-value-tlambda->denv funval)))
                   (limit (1- limit))
                   (new-expr (expr-value-tlambda->body new-funval))
                   (new-denv (expr-denv-add-type (expr-value-tlambda->param new-funval)
                                                 new-tval
                                                 (expr-value-tlambda->denv new-funval)))
                   (r (change-var-renamings
                       (expr-value-witness-closure->r w)
                       :atom (extend-renaming
                             (type-var-atom->name (expr-value-tlambda->param funval))
