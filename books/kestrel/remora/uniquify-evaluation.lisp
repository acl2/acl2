; The application step (EVAL-APP on a non-empty argument list): the frames
; are computed from equal dimensions, the lifted cells are related, the
; cell-wise application yields related result cells, and the result array
; built from them is related; the step then recurs on related values.

(defruled eval-app-when-zp-limit
  (implies (zp limit)
           (equal (eval-app funval argvals limit) (reserr :limit)))
  :expand ((eval-app funval argvals limit)))

(defruled eval-app-when-endp
  (implies (and (not (zp limit))
                (not (consp argvals)))
           (equal (eval-app funval argvals limit) (expr-value-fix funval)))
  :expand ((eval-app funval argvals limit)))

(defruled eval-app-when-consp
  (implies (and (not (zp limit))
                (consp argvals))
           (equal (eval-app funval argvals limit)
                  (b* ((argval (car argvals))
                       ((ok param-dims) (fun-value-param-dims funval))
                       ((unless (consp param-dims)) (reserr nil))
                       (arg-dims (dims-of-expr-value argval))
                       ((mv suffixp arg-frame)
                        (check-list-suffix arg-dims (car param-dims)))
                       ((unless suffixp) (reserr nil))
                       (fun-frame (dims-of-expr-value funval))
                       ((mv joinp pframe) (list-prefix-join (list fun-frame arg-frame)))
                       ((unless joinp) (reserr nil))
                       ((when (member-equal 0 pframe)) (eval-app-empty funval argvals))
                       ((ok fun-cells) (lift-expr-value-to-frame funval fun-frame pframe))
                       ((ok arg-cells) (lift-expr-value-to-frame argval arg-frame pframe))
                       ((ok result-cells) (eval-app-list fun-cells arg-cells (1- limit)))
                       ((unless (equal (len result-cells) (nat-list-product pframe)))
                        (reserr nil))
                       ((unless (expr-value-list-wfp result-cells)) (reserr nil))
                       ((unless (list-repeatp (dims-of-expr-value-list result-cells)))
                        (reserr nil))
                       (stepval (expr-value-with-nonempty-dims pframe result-cells)))
                    (eval-app stepval (cdr argvals) (1- limit)))))
  :expand ((eval-app funval argvals limit)))

(defruled expr-value-list-alpha-related-via-p-of-take-witness
  (implies (expr-value-list-alpha-related-via-p new-vals vals ws)
           (expr-value-list-alpha-related-via-p new-vals vals (take (len vals) ws)))
  :induct (three-cdrs-induct-eq new-vals vals ws)
  :enable (expr-value-list-alpha-related-via-p take len))

; The array builder on related (existentially) cell lists.

(defruled expr-value-alpha-equiv-p-of-with-nonempty-dims-when-equiv
  (implies (and (nat-listp dims)
                (not (member-equal 0 dims))
                (equal (len vals) (nat-list-product dims))
                (expr-value-list-alpha-equiv-p new-vals vals))
