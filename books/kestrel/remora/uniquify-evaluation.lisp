;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Function binds with parameters bind a closure, the same closure that the
; corresponding lambda atom evaluates to; the atom case lemmas apply.
; First, generic pieces: the type annotation (a universal or product type,
; which never fails to evaluate), and the parameter list correspondences.

(defruled not-reserrp-of-eval-type-of-make-type-forall/foralln
  (implies (consp params)
           (not (reserrp (eval-type (make-type-forall/foralln params body) denv))))
  :enable (make-type-forall/foralln not-reserrp-when-type-valuep)
  :expand ((:free (p b) (eval-type (type-forall p b) denv))
           (:free (p b) (eval-type (type-foralln p b) denv))))

(defruled not-reserrp-of-eval-type-of-make-type-pi/pin
  (implies (consp params)
           (not (reserrp (eval-type (make-type-pi/pin params body) denv))))
  :enable (make-type-pi/pin not-reserrp-when-type-valuep)
  :expand ((:free (p b) (eval-type (type-pi p b) denv))
           (:free (p b) (eval-type (type-pin p b) denv))))

(defruled emptyp-intersect-when-subset
  (implies (and (set::emptyp (set::intersect s y))
                (set::subset x y))
           (set::emptyp (set::intersect s x)))
  :use ((:instance set::in-head (x (set::intersect s x)))
        (:instance set::subset-in
                   (acl2::a (set::head (set::intersect s x))) (x x) (y y))
        (:instance set::never-in-empty
                   (acl2::a (set::head (set::intersect s x)))
                   (x (set::intersect s y))))
  :enable set::intersect-in
  :disable (set::in-head set::never-in-empty))

(defruled subset-of-type-var-set-rename-type-vars-when-subset
  (implies (and (set::subset a b)
                (type-var-setp a)
                (type-var-setp b))
           (set::subset (type-var-set-rename-type-vars a atom-m array-m)
                        (type-var-set-rename-type-vars b atom-m array-m)))
  :enable (set::pick-a-point-subset-strategy
           not-in-type-var-image-when-subset))

(defruled emptyp-intersect-of-type-var-image-when-subset
  (implies (and (set::emptyp (set::intersect s (type-var-set-rename-type-vars
                                                b atom-m array-m)))
                (set::subset a b)
                (type-var-setp a)
                (type-var-setp b))
           (set::emptyp (set::intersect s (type-var-set-rename-type-vars
                                           a atom-m array-m))))
  :use (subset-of-type-var-set-rename-type-vars-when-subset
        (:instance emptyp-intersect-when-subset
                   (x (type-var-set-rename-type-vars a atom-m array-m))
                   (y (type-var-set-rename-type-vars b atom-m array-m)))))

(defruled subset-of-ispace-var-set-rename-ispace-vars-when-subset
  (implies (and (set::subset a b)
                (ispace-var-setp a)
                (ispace-var-setp b))
           (set::subset (ispace-var-set-rename-ispace-vars a dim-m shape-m)
                        (ispace-var-set-rename-ispace-vars b dim-m shape-m)))
  :enable (set::pick-a-point-subset-strategy
           not-in-ispace-var-image-when-subset))

(defruled emptyp-intersect-of-ispace-var-image-when-subset
  (implies (and (set::emptyp (set::intersect s (ispace-var-set-rename-ispace-vars
                                                b dim-m shape-m)))
                (set::subset a b)
                (ispace-var-setp a)
                (ispace-var-setp b))
           (set::emptyp (set::intersect s (ispace-var-set-rename-ispace-vars
                                           a dim-m shape-m))))
  :use (subset-of-ispace-var-set-rename-ispace-vars-when-subset
        (:instance emptyp-intersect-when-subset
                   (x (ispace-var-set-rename-ispace-vars a dim-m shape-m))
                   (y (ispace-var-set-rename-ispace-vars b dim-m shape-m)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Type function binds with parameters: the bound value is the closure of
; the type lambda atom over the same parameters and body (unary for one
; parameter, n-ary for two or more), whose case lemmas apply.

(defruled subset-union-drop-middle
  (set::subset (set::union s1 s2) (set::union s1 (set::union b s2)))
  :enable (set::pick-a-point-subset-strategy set::union-in))

(defruled subset-insert-into-insert-union
  (set::subset (set::insert name s2)
               (set::insert name (set::union b s2)))
  :enable (set::pick-a-point-subset-strategy set::union-in set::in-insert))

(defruled expr-alpha-fresh-p-drop-middle-support
  (implies (and (expr-alpha-fresh-p new-x x r
                                    (set::union s1 (set::union (string-sfix b) s2)))
                (string-setp s1)
                (string-setp s2))
           (expr-alpha-fresh-p new-x x r (set::union s1 s2)))
  :use ((:instance expr-alpha-fresh-p-anti-monotone
                   (b2 (set::union s1 (set::union (string-sfix b) s2)))
                   (b1 (set::union s1 s2)))
        (:instance subset-union-drop-middle (b (string-sfix b)))))

(defruled expr-alpha-fresh-p-insert-from-union-support
  (implies (and (expr-alpha-fresh-p new-x x r
                                    (set::insert name
                                                 (set::union (string-sfix b) s2)))
                (stringp name)
                (string-setp s2))
           (expr-alpha-fresh-p new-x x r (set::insert name s2)))
  :use ((:instance expr-alpha-fresh-p-anti-monotone
                   (b2 (set::insert name (set::union (string-sfix b) s2)))
                   (b1 (set::insert name s2)))
        (:instance subset-insert-into-insert-union (b (string-sfix b)))))

(defruled eval-bind-when-tfun-consp
  (implies (and (equal (bind-kind bind) :tfun)
                (consp (bind-tfun->params bind))
                (not (zp limit)))
           (equal (eval-bind bind denv limit)
                  (b* ((val (make-expr-value-tlambda
                             :param (car (bind-tfun->params bind))
                             :body (tlambda-curried-body (bind-tfun->params bind)
                                                         (bind-tfun->expr bind))
                             :denv (expr-denv-restrict
                                    (expr-free-ispace-vars (bind-tfun->expr bind))
                                    (set::difference
                                     (expr-free-type-vars (bind-tfun->expr bind))
                                     (set::mergesort (bind-tfun->params bind)))
                                    (expr-free-expr-vars (bind-tfun->expr bind))
                                    denv)))
                       (type? (bind-tfun->type? bind))
                       ((ok &) (type-option-case
                                type?
                                :some (eval-type (make-type-forall/foralln
                                                  (bind-tfun->params bind)
                                                  type?.val)
                                                 (expr-denv->tenv denv))
                                :none nil)))
                    (expr-denv-add-expr (bind-tfun->var bind) val denv))))
  :expand ((eval-bind bind denv limit)))

(defruled eval-atom-of-atom-tlambdan
  (implies (and (type-var-listp params)
                (consp (cdr params))
                (exprp body)
                (not (zp limit)))
           (equal (eval-atom (atom-tlambdan params body) denv limit)
                  (make-expr-value-tlambda
                   :param (car params)
                   :body (tlambda-curried-body params body)
                   :denv (expr-denv-restrict
                          (expr-free-ispace-vars body)
                          (set::difference (expr-free-type-vars body)
                                           (set::mergesort params))
                          (expr-free-expr-vars body)
                          denv))))
  :enable eval-atom-when-tlambdan
  :expand ((atom-free-type-vars (atom-tlambdan params body))))

(defruled eval-atom-of-atom-tlambda
  (implies (and (type-varp param)
                (exprp body)
                (not (zp limit)))
           (equal (eval-atom (atom-tlambda param body) denv limit)
                  (make-expr-value-tlambda
                   :param param
                   :body body
                   :denv (expr-denv-restrict
                          (expr-free-ispace-vars body)
                          (set::delete param (expr-free-type-vars body))
                          (expr-free-expr-vars body)
                          denv))))
  :enable eval-atom-when-tlambda
  :expand ((atom-free-type-vars (atom-tlambda param body))))

; n-ary: the bind relations imply the atom relations.

(defruled atom-alpha-related-p-of-tlambdan-when-tfun
  (implies (and (equal (bind-kind bind) :tfun)
                (consp (cdr (bind-tfun->params bind)))
                (bind-alpha-related-p new-bind bind r))
           (and (equal (bind-kind new-bind) :tfun)
                (consp (bind-tfun->params new-bind))
                (consp (cdr (bind-tfun->params new-bind)))
                (atom-alpha-related-p
                 (atom-tlambdan (bind-tfun->params new-bind) (bind-tfun->expr new-bind))
                 (atom-tlambdan (bind-tfun->params bind) (bind-tfun->expr bind))
                 r)))
  :expand ((bind-alpha-related-p new-bind bind r)
           (:free (a x) (atom-alpha-related-p a x r)))
  :use ((:instance len-when-type-var-list-alpha-extend-okp
                   (new-params (bind-tfun->params new-bind))
                   (params (bind-tfun->params bind))
                   (atom-m (var-renamings->atom r))
                   (array-m (var-renamings->array r))))
  :enable (consp-of-cdr-when-len-equal len))

(defruled atom-alpha-fresh-p-of-tlambdan-when-tfun
  (implies (and (equal (bind-kind bind) :tfun)
                (consp (cdr (bind-tfun->params bind)))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b))
           (atom-alpha-fresh-p
            (atom-tlambdan (bind-tfun->params new-bind) (bind-tfun->expr new-bind))
            (atom-tlambdan (bind-tfun->params bind) (bind-tfun->expr bind))
            r b))
  :expand ((bind-alpha-fresh-p new-bind bind r b)
           (:free (a x) (atom-alpha-fresh-p a x r b)))
  :use (atom-alpha-related-p-of-tlambdan-when-tfun
        (:instance emptyp-intersect-of-type-var-image-when-subset
                   (s (set::mergesort (bind-tfun->params new-bind)))
                   (a (set::difference (expr-free-type-vars (bind-tfun->expr bind))
                                       (set::mergesort (bind-tfun->params bind))))
                   (b (set::difference
                       (set::union (type-option-free-type-vars (bind-tfun->type? bind))
                                   (expr-free-type-vars (bind-tfun->expr bind)))
                       (set::mergesort (bind-tfun->params bind))))
                   (atom-m (var-renamings->atom r))
                   (array-m (var-renamings->array r))))
  :enable (expr-alpha-fresh-p-drop-middle-support
           set::pick-a-point-subset-strategy
           set::subset-in))

(defruled eval-bind-ok-when-tfun-n-aux
  (implies (and (equal (bind-kind bind) :tfun)
                (consp (bind-tfun->params bind))
                (consp (cdr (bind-tfun->params bind)))
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
