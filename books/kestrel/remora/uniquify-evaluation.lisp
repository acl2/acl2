; The last stage of reduce (PRIM-REDUCE): the dimension check is
; preserved, the cells at depth 1 are related (existentially), and the
; loop starts from the first cell.

(defruled dims-of-expr-value-when-expr-value-alpha-related-via-p-safe
  (implies (and (expr-value-alpha-related-via-p new-val val w)
                (expr-value-wfp val)
                (expr-value-wfp new-val)
                (syntaxp (not (equal new-val val))))
           (equal (dims-of-expr-value new-val)
                  (dims-of-expr-value val)))
  :use dims-of-expr-value-when-expr-value-alpha-related-via-p)

(defruled prim-reduce-when-zp-limit
  (implies (zp limit)
           (equal (prim-reduce tval d s fval arg limit) (reserr :limit)))
  :expand ((prim-reduce tval d s fval arg limit)))

(defruled prim-reduce-when-not-zp-limit
  (implies (not (zp limit))
           (equal (prim-reduce tval d s fval arg limit)
                  (b* (((unless (equal (dims-of-expr-value arg)
                                       (cons (1+ (nfix d)) (nat-list-fix s))))
                        (reserr nil))
                       ((ok cells) (cells-at-depth-in-expr-value arg 1))
                       ((unless (consp cells)) (reserr nil)))
                    (prim-reduce/fold-loop (car cells) (cdr cells) fval (1- limit)))))
  :expand ((prim-reduce tval d s fval arg limit)))

(defruled prim-reduce-ok-aux
  (implies (and (not (zp limit))
                (implies (and (equal (dims-of-expr-value arg)
                                     (cons (1+ (nfix d)) (nat-list-fix s)))
