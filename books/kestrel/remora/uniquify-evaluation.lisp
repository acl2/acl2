(defruled prim-reduce/fold-loop-ok-cases
  (implies (and (implies (consp cells)
                         (eval-app-cell-ok fval acc (1- limit)))
                (implies (and (consp cells)
                              (not (reserrp (eval-app-cell fval acc (1- limit)))))
