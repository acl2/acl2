                   (vals (cells-at-depth-in-expr-value arg 1))
                   (ws (expr-value-list-alpha-equiv-p-witness
                        (cells-at-depth-in-expr-value new-arg 1)
                        (cells-at-depth-in-expr-value arg 1))))
        (:instance prim-reduce/fold-loop-ok-necc
                   (acc (car (cells-at-depth-in-expr-value arg 1)))
                   (cells (cdr (cells-at-depth-in-expr-value arg 1)))
                   (fval fval)
                   (limit (1- limit))
                   (new-acc (car (cells-at-depth-in-expr-value new-arg 1)))
                   (new-cells (cdr (cells-at-depth-in-expr-value new-arg 1)))
                   (new-fval new-fval)
                   (aw (car (expr-value-list-alpha-equiv-p-witness
