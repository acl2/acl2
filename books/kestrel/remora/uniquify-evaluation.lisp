                   (new-funval (eval-expr (expr-iappn->fun (mv-nth 0 (eval-expr-ok-witness expr denv limit))) (mv-nth 1 (eval-expr-ok-witness expr denv limit)) (1- limit))) (w (expr-value-alpha-equiv-p-witness (eval-expr (expr-iappn->fun (mv-nth 0 (eval-expr-ok-witness expr denv limit))) (mv-nth 1 (eval-expr-ok-witness expr denv limit)) (1- limit)) (eval-expr (expr-iappn->fun expr) denv (1- limit)))) (new-denv (mv-nth 1 (eval-expr-ok-witness expr denv limit))) (r (mv-nth 2 (eval-expr-ok-witness expr denv limit))) (dw (mv-nth 3 (eval-expr-ok-witness expr denv limit))) (b (mv-nth 4 (eval-expr-ok-witness expr denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defruled eval-expr-ok-when-let
  (implies (and (equal (expr-kind expr) :let)
                (eval-bind-list-ok (expr-let->binds expr) denv (1- limit))
