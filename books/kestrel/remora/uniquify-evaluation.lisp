                (expr-value-alpha-related-via-p new-arg arg aw)
                (expr-value-wfp fval)
                (expr-value-wfp new-fval)
                (expr-value-wfp arg)
                (expr-value-wfp new-arg))
           (b* ((val (prim-reduce tval d s fval arg limit))
                (new-val (prim-reduce new-tval d s new-fval new-arg limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((len (cells-at-depth-in-expr-value arg 1)))
  :enable (prim-reduce-when-not-zp-limit
           dims-of-expr-value-when-expr-value-alpha-related-via-p-safe
           consp-when-expr-value-list-alpha-related-via-p-safe
           expr-value-list-wfp
           expr-value-list-wfp-of-cells-at-depth-in-expr-value
           expr-value-listp-when-result-not-error)
  :use ((:instance cells-at-depth-in-expr-value-alpha
                   (new-val new-arg) (val arg) (w aw) (depth 1))
        (:instance expr-value-list-alpha-equiv-p
                   (new-vals (cells-at-depth-in-expr-value new-arg 1))
                   (vals (cells-at-depth-in-expr-value arg 1)))
        (:instance car-when-expr-value-list-alpha-related-via-p
                   (new-vals (cells-at-depth-in-expr-value new-arg 1))
                   (vals (cells-at-depth-in-expr-value arg 1))
