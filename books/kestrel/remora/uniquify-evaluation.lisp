  :expand ((prim-fold-ok tval t2val d s s2 fval zval arg limit))
  :cases ((zp limit))
  :enable prim-fold-when-zp-limit
  :use ((:instance prim-fold-ok-aux
                   (new-tval (mv-nth 0 (prim-fold-ok-witness tval t2val d s s2 fval zval arg limit)))
                   (new-t2val (mv-nth 1 (prim-fold-ok-witness tval t2val d s s2 fval zval arg limit)))
                   (new-fval (mv-nth 2 (prim-fold-ok-witness tval t2val d s s2 fval zval arg limit)))
                   (new-zval (mv-nth 3 (prim-fold-ok-witness tval t2val d s s2 fval zval arg limit)))
                   (new-arg (mv-nth 4 (prim-fold-ok-witness tval t2val d s s2 fval zval arg limit)))
                   (fw (mv-nth 7 (prim-fold-ok-witness tval t2val d s s2 fval zval arg limit)))
                   (zw (mv-nth 8 (prim-fold-ok-witness tval t2val d s s2 fval zval arg limit)))
                   (aw (mv-nth 9 (prim-fold-ok-witness tval t2val d s s2 fval zval arg limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Boxes with several witnesses (BOX-NEST and the :BOXN atom case): the
; witness ispace values are equal on both sides, the array values and the
; sum type values are related; the nested inner type values come from
; evaluating the sigma closure bodies, which yields existentially related
; type values, so the induction statement quantifies over the new side.

(defruled sigma-param-when-type-value-alpha-related-via-p
  (implies (and (type-value-alpha-related-via-p new-elem elem ew)
                (equal (type-value-kind elem) :sigma))
           (and (equal (type-value-kind new-elem) :sigma)
                (equal (type-value-sigma->param new-elem)
                       (type-value-sigma->param elem))))
  :expand ((type-value-alpha-related-via-p new-elem elem ew))
  :enable not-type-value-groundp-when-sigma)

(defruled eval-type-of-sigma-closure-body-alpha
  (implies (and (type-value-alpha-related-via-p new-elem elem ew)
                (equal (type-value-kind elem) :sigma))
           (b* ((iv (type-value-sigma->param elem))
                (bodyval (eval-type (type-value-sigma->body elem)
                                    (type-denv-add-ispace
                                     iv ival (type-value-sigma->denv elem))))
                (new-bodyval (eval-type (type-value-sigma->body new-elem)
                                        (type-denv-add-ispace
                                         iv ival (type-value-sigma->denv new-elem)))))
             (and (equal (reserrp new-bodyval) (reserrp bodyval))
                  (implies (not (reserrp bodyval))
                           (type-value-alpha-equiv-p new-bodyval bodyval)))))
  :expand ((type-value-alpha-related-via-p new-elem elem ew)
           (:free (i tv) (type-denv-alpha-avoided-p
                          (type-value-sigma->denv new-elem)
                          (type-value-sigma->denv elem)
                          (type-value-witness-closure->r ew)
                          i tv)))
  :enable (not-type-value-groundp-when-sigma
           type-rename-all-vars
           type-denv-add-ispace
           type-denv-alpha-related-via-p-of-add-ispace-same-remove-bound
           not-in-ispace-image-of-delete-keys-when-type-denv-keys-within-p
           type-denv-alpha-avoided-p)
  :use ((:instance eval-type-alpha-when-equal
                   (new-type (type-value-sigma->body new-elem))
                   (type (type-value-sigma->body elem))
                   (r (change-var-renamings
                       (type-value-witness-closure->r ew)
                       :dim (mv-nth 2 (dim/shape-rename-remove-bound
                                       (set::insert (type-value-sigma->param elem) nil)
                                       (var-renamings->dim
                                        (type-value-witness-closure->r ew))
                                       (var-renamings->shape
                                        (type-value-witness-closure->r ew))))
                       :shape (mv-nth 3 (dim/shape-rename-remove-bound
                                         (set::insert (type-value-sigma->param elem) nil)
                                         (var-renamings->dim
                                          (type-value-witness-closure->r ew))
                                         (var-renamings->shape
                                          (type-value-witness-closure->r ew))))))
                   (new-denv (type-denv-add-ispace (type-value-sigma->param elem)
                                                   ival
                                                   (type-value-sigma->denv new-elem)))
                   (denv (type-denv-add-ispace (type-value-sigma->param elem)
                                               ival
                                               (type-value-sigma->denv elem)))
                   (wmap (type-value-witness-closure->types ew)))
        (:instance type-denv-alpha-related-via-p-of-add-ispace-same-remove-bound
                   (new-tenv (type-value-sigma->denv new-elem))
                   (tenv (type-value-sigma->denv elem))
                   (r (type-value-witness-closure->r ew))
                   (wmap (type-value-witness-closure->types ew))
                   (iv (type-value-sigma->param elem)))
        (:instance denv-ispace-vars-avoided-p-of-add-ispace-same-remove-bound
                   (new-ienv (type-denv->ienv (type-value-sigma->denv new-elem)))
                   (ienv (type-denv->ienv (type-value-sigma->denv elem)))
                   (dim-renam (var-renamings->dim (type-value-witness-closure->r ew)))
                   (shape-renam (var-renamings->shape (type-value-witness-closure->r ew)))
                   (iv (type-value-sigma->param elem))
                   (vars (type-free-ispace-vars (type-value-sigma->body elem))))
        (:instance type-value-alpha-equiv-p-suff
                   (new-tval (eval-type (type-value-sigma->body new-elem)
                                        (type-denv-add-ispace
                                         (type-value-sigma->param elem)
                                         ival
                                         (type-value-sigma->denv new-elem))))
                   (tval (eval-type (type-value-sigma->body elem)
                                    (type-denv-add-ispace
                                     (type-value-sigma->param elem)
                                     ival
                                     (type-value-sigma->denv elem))))
                   (w (eval-type-witness
                       (type-value-sigma->body elem)
                       (change-var-renamings
                        (type-value-witness-closure->r ew)
                        :dim (mv-nth 2 (dim/shape-rename-remove-bound
                                        (set::insert (type-value-sigma->param elem) nil)
                                        (var-renamings->dim
                                         (type-value-witness-closure->r ew))
                                        (var-renamings->shape
                                         (type-value-witness-closure->r ew))))
                        :shape (mv-nth 3 (dim/shape-rename-remove-bound
                                          (set::insert (type-value-sigma->param elem) nil)
                                          (var-renamings->dim
                                           (type-value-witness-closure->r ew))
                                          (var-renamings->shape
                                           (type-value-witness-closure->r ew)))))
                       (type-value-witness-closure->types ew))))))

(defruled box-nest-when-endp
  (implies (not (consp ivals))
           (reserrp (box-nest ivals arrayval tval)))
  :expand ((box-nest ivals arrayval tval)))

(defruled box-nest-when-single
  (implies (and (consp ivals)
                (not (consp (cdr ivals))))
           (equal (box-nest ivals arrayval tval)
                  (make-expr-value-box :ispace (car ivals)
                                       :array arrayval
                                       :type tval)))
  :expand ((box-nest ivals arrayval tval)))

(defruled box-nest-when-consp-cdr
  (implies (and (consp ivals)
                (consp (cdr ivals)))
           (equal (box-nest ivals arrayval tval)
                  (b* (((unless (type-value-case tval :sigma)) (reserr nil))
                       (param (type-value-sigma->param tval))
                       ((unless (ispace-values-match-ispace-vars-p
                                 (list (car ivals)) (list param)))
                        (reserr nil))
                       (tenv (type-denv-add-ispace param
                                                   (car ivals)
                                                   (type-value-sigma->denv tval)))
                       ((ok subtval) (eval-type (type-value-sigma->body tval) tenv))
                       ((ok inner) (box-nest (cdr ivals) arrayval subtval)))
                    (make-expr-value-box :ispace (car ivals)
                                         :array inner
                                         :type tval))))
  :expand ((box-nest ivals arrayval tval)))

(acl2::defun-sk box-nest-alpha-ok (ivals arrayval tval)
  (forall (new-arrayval new-tval aw tw)
    (implies (and (expr-value-alpha-related-via-p new-arrayval arrayval aw)
                  (type-value-alpha-related-via-p new-tval tval tw))
             (b* ((val (box-nest ivals arrayval tval))
                  (new-val (box-nest ivals new-arrayval new-tval)))
               (and (equal (reserrp new-val) (reserrp val))
                    (implies (not (reserrp val))
                             (expr-value-alpha-equiv-p new-val val)))))))

(in-theory (disable box-nest-alpha-ok))

(defruled box-nest-alpha-ok-when-endp
  (implies (not (consp ivals))
           (box-nest-alpha-ok ivals arrayval tval))
  :expand ((box-nest-alpha-ok ivals arrayval tval))
  :enable box-nest-when-endp)

(defruled box-nest-alpha-ok-when-single-aux
  (implies (and (consp ivals)
                (not (consp (cdr ivals)))
                (expr-value-alpha-related-via-p new-arrayval arrayval aw)
                (type-value-alpha-related-via-p new-tval tval tw))
           (b* ((val (box-nest ivals arrayval tval))
                (new-val (box-nest ivals new-arrayval new-tval)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((:free (new-val w i a ty)
            (expr-value-alpha-related-via-p new-val (expr-value-box i a ty) w)))
  :enable (box-nest-when-single
           not-reserrp-when-expr-valuep)
  :use ((:instance expr-value-alpha-equiv-p-suff
                   (new-val (box-nest ivals new-arrayval new-tval))
                   (val (box-nest ivals arrayval tval))
                   (w (expr-value-witness-box tw aw)))))

(defruled box-nest-alpha-ok-when-single
  (implies (and (consp ivals)
                (not (consp (cdr ivals))))
           (box-nest-alpha-ok ivals arrayval tval))
  :expand ((box-nest-alpha-ok ivals arrayval tval))
  :use ((:instance box-nest-alpha-ok-when-single-aux
                   (new-arrayval (mv-nth 0 (box-nest-alpha-ok-witness ivals arrayval tval)))
                   (new-tval (mv-nth 1 (box-nest-alpha-ok-witness ivals arrayval tval)))
                   (aw (mv-nth 2 (box-nest-alpha-ok-witness ivals arrayval tval)))
                   (tw (mv-nth 3 (box-nest-alpha-ok-witness ivals arrayval tval))))))

(defruled box-nest-alpha-ok-when-consp-cdr-aux
  (implies (and (consp ivals)
                (consp (cdr ivals))
                (implies (and (equal (type-value-kind tval) :sigma)
                              (ispace-values-match-ispace-vars-p
                               (list (car ivals))
                               (list (type-value-sigma->param tval)))
                              (not (reserrp
                                    (eval-type (type-value-sigma->body tval)
                                               (type-denv-add-ispace
                                                (type-value-sigma->param tval)
                                                (car ivals)
                                                (type-value-sigma->denv tval))))))
                         (box-nest-alpha-ok
                          (cdr ivals)
                          arrayval
                          (eval-type (type-value-sigma->body tval)
                                     (type-denv-add-ispace
                                      (type-value-sigma->param tval)
                                      (car ivals)
                                      (type-value-sigma->denv tval)))))
                (expr-value-alpha-related-via-p new-arrayval arrayval aw)
                (type-value-alpha-related-via-p new-tval tval tw))
           (b* ((val (box-nest ivals arrayval tval))
                (new-val (box-nest ivals new-arrayval new-tval)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((:free (new-val w i a ty)
            (expr-value-alpha-related-via-p new-val (expr-value-box i a ty) w)))
  :cases ((equal (type-value-kind tval) :sigma))
  :enable (box-nest-when-consp-cdr
           sigma-param-when-type-value-alpha-related-via-p
           type-value-kind-when-type-value-alpha-related-via-p-safe
           not-reserrp-when-expr-valuep
           expr-valuep-when-result-not-error
           type-valuep-when-result-not-error)
  :use ((:instance eval-type-of-sigma-closure-body-alpha
                   (new-elem new-tval) (elem tval) (ew tw) (ival (car ivals)))
        (:instance type-value-alpha-equiv-p
                   (new-tval (eval-type (type-value-sigma->body new-tval)
                                        (type-denv-add-ispace
                                         (type-value-sigma->param tval)
                                         (car ivals)
                                         (type-value-sigma->denv new-tval))))
                   (tval (eval-type (type-value-sigma->body tval)
                                    (type-denv-add-ispace
                                     (type-value-sigma->param tval)
                                     (car ivals)
                                     (type-value-sigma->denv tval)))))
        (:instance box-nest-alpha-ok-necc
                   (ivals (cdr ivals))
                   (arrayval arrayval)
                   (tval (eval-type (type-value-sigma->body tval)
                                    (type-denv-add-ispace
                                     (type-value-sigma->param tval)
                                     (car ivals)
                                     (type-value-sigma->denv tval))))
                   (new-arrayval new-arrayval)
                   (new-tval (eval-type (type-value-sigma->body new-tval)
                                        (type-denv-add-ispace
                                         (type-value-sigma->param tval)
                                         (car ivals)
                                         (type-value-sigma->denv new-tval))))
                   (aw aw)
                   (tw (type-value-alpha-equiv-p-witness
                        (eval-type (type-value-sigma->body new-tval)
                                   (type-denv-add-ispace
                                    (type-value-sigma->param tval)
                                    (car ivals)
                                    (type-value-sigma->denv new-tval)))
                        (eval-type (type-value-sigma->body tval)
                                   (type-denv-add-ispace
                                    (type-value-sigma->param tval)
                                    (car ivals)
                                    (type-value-sigma->denv tval))))))
        (:instance expr-value-alpha-equiv-p
                   (new-val (box-nest (cdr ivals)
                                      new-arrayval
                                      (eval-type (type-value-sigma->body new-tval)
                                                 (type-denv-add-ispace
                                                  (type-value-sigma->param tval)
                                                  (car ivals)
                                                  (type-value-sigma->denv new-tval)))))
                   (val (box-nest (cdr ivals)
                                  arrayval
                                  (eval-type (type-value-sigma->body tval)
                                             (type-denv-add-ispace
                                              (type-value-sigma->param tval)
                                              (car ivals)
                                              (type-value-sigma->denv tval))))))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (box-nest ivals new-arrayval new-tval))
                   (val (box-nest ivals arrayval tval))
                   (w (expr-value-witness-box
                       tw
                       (expr-value-alpha-equiv-p-witness
                        (box-nest (cdr ivals)
                                  new-arrayval
                                  (eval-type (type-value-sigma->body new-tval)
                                             (type-denv-add-ispace
                                              (type-value-sigma->param tval)
                                              (car ivals)
                                              (type-value-sigma->denv new-tval))))
                        (box-nest (cdr ivals)
                                  arrayval
                                  (eval-type (type-value-sigma->body tval)
                                             (type-denv-add-ispace
                                              (type-value-sigma->param tval)
                                              (car ivals)
                                              (type-value-sigma->denv tval))))))))))

(defruled box-nest-alpha-ok-when-consp-cdr
  (implies (and (consp ivals)
                (consp (cdr ivals))
                (implies (and (equal (type-value-kind tval) :sigma)
                              (ispace-values-match-ispace-vars-p
                               (list (car ivals))
                               (list (type-value-sigma->param tval)))
                              (not (reserrp
                                    (eval-type (type-value-sigma->body tval)
                                               (type-denv-add-ispace
                                                (type-value-sigma->param tval)
                                                (car ivals)
                                                (type-value-sigma->denv tval))))))
                         (box-nest-alpha-ok
                          (cdr ivals)
                          arrayval
                          (eval-type (type-value-sigma->body tval)
                                     (type-denv-add-ispace
                                      (type-value-sigma->param tval)
                                      (car ivals)
                                      (type-value-sigma->denv tval))))))
           (box-nest-alpha-ok ivals arrayval tval))
  :expand ((box-nest-alpha-ok ivals arrayval tval))
  :use ((:instance box-nest-alpha-ok-when-consp-cdr-aux
                   (new-arrayval (mv-nth 0 (box-nest-alpha-ok-witness ivals arrayval tval)))
                   (new-tval (mv-nth 1 (box-nest-alpha-ok-witness ivals arrayval tval)))
                   (aw (mv-nth 2 (box-nest-alpha-ok-witness ivals arrayval tval)))
                   (tw (mv-nth 3 (box-nest-alpha-ok-witness ivals arrayval tval))))))

(defruled box-nest-alpha-ok-holds
  (box-nest-alpha-ok ivals arrayval tval)
  :induct (box-nest ivals arrayval tval)
  :enable ((:i box-nest)
           box-nest-alpha-ok-when-endp
           box-nest-alpha-ok-when-single
           box-nest-alpha-ok-when-consp-cdr))

(defruled box-nest-alpha
  (implies (and (expr-value-alpha-related-via-p new-arrayval arrayval aw)
                (type-value-alpha-related-via-p new-tval tval tw))
           (b* ((val (box-nest ivals arrayval tval))
                (new-val (box-nest ivals new-arrayval new-tval)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :use (box-nest-alpha-ok-holds
        box-nest-alpha-ok-necc))

; The :boxn atom case.  As for the unary box, the sum type is optional
; (absent only in the inner boxes of a desugared nest); when present, it
; evaluates to related type values (EVAL-TYPE-ALPHA), and BOX-NEST-ALPHA
; lifts the relatedness of the array and type values to the nest.

(defruled eval-atom-when-boxn
  (implies (and (equal (atom-kind atom) :boxn)
                (not (zp limit)))
           (equal (eval-atom atom denv limit)
                  (b* (((ok ivals) (eval-ispace-list (atom-boxn->ispaces atom)
                                                     (type-denv->ienv
                                                      (expr-denv->tenv denv))))
                       ((ok arrayval) (eval-expr (atom-boxn->array atom)
                                                 denv (1- limit)))
                       (type? (atom-boxn->type? atom))
                       ((ok tval) (type-option-case
                                   type?
                                   :some (eval-type type?.val
                                                    (expr-denv->tenv denv))
                                   :none (reserr nil))))
                    (box-nest ivals arrayval tval))))
  :expand ((eval-atom atom denv limit)))

; Decomposition of the relations at a boxn atom.

(defruled atom-alpha-related-p-when-boxn
  (implies (and (equal (atom-kind atom) :boxn)
                (atom-alpha-related-p new-atom atom r))
           (and (equal (atom-kind new-atom) :boxn)
                (equal (atom-boxn->ispaces new-atom)
                       (ispace-list-rename-ispace-vars (atom-boxn->ispaces atom)
                                                       (var-renamings->dim r)
                                                       (var-renamings->shape r)))
                (expr-alpha-related-p (atom-boxn->array new-atom)
                                      (atom-boxn->array atom)
                                      r)
                (equal (atom-boxn->type? new-atom)
                       (type-option-rename-all-vars (atom-boxn->type? atom) r))))
  :expand ((atom-alpha-related-p new-atom atom r)))

(defruled atom-alpha-fresh-p-when-boxn
  (implies (and (equal (atom-kind atom) :boxn)
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b))
           (and (expr-alpha-fresh-p (atom-boxn->array new-atom)
                                    (atom-boxn->array atom)
                                    r b)
                (type-option-fresh-ok (atom-boxn->type? atom) r)))
  :expand ((atom-alpha-fresh-p new-atom atom r b))
  :use atom-alpha-related-p-when-boxn)

(defruled eval-atom-ok-when-boxn-aux
  (implies (and (equal (atom-kind atom) :boxn)
                (not (zp limit))
                (implies (not (reserrp (eval-ispace-list (atom-boxn->ispaces atom)
                                                         (type-denv->ienv
                                                          (expr-denv->tenv denv)))))
                         (eval-expr-ok (atom-boxn->array atom) denv (1- limit)))
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-free-ispace-vars atom)
                                           (atom-free-type-vars atom)
                                           (atom-free-expr-vars atom))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((val (eval-atom atom denv limit))
                (new-val (eval-atom new-atom new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((atom-free-ispace-vars atom)
           (atom-free-type-vars atom)
           (atom-free-expr-vars atom))
  :enable (eval-atom-when-boxn
           type-option-rename-all-vars
           type-option-rename-ispace-vars
           type-option-rename-type-vars
           type-rename-all-vars
           type-option-some->val-when-typep
           not-reserrp-when-expr-valuep
           expr-valuep-when-result-not-error
           type-valuep-when-result-not-error
           subset-of-union-right-1
           subset-of-union-right-2
           set::union-subset-x)
  :use (atom-alpha-related-p-when-boxn
        atom-alpha-fresh-p-when-boxn
        (:instance eval-ispace-list-alpha-of-expr-denvs
                   (ispaces (atom-boxn->ispaces atom))
                   (ivars (atom-free-ispace-vars atom))
                   (tvars (atom-free-type-vars atom))
                   (evars (atom-free-expr-vars atom)))
        (:instance eval-type-option-alpha-of-expr-denvs
                   (type? (atom-boxn->type? atom))
                   (ivars (atom-free-ispace-vars atom))
                   (tvars (atom-free-type-vars atom))
                   (evars (atom-free-expr-vars atom)))
        (:instance eval-expr-ok-necc
                   (expr (atom-boxn->array atom))
                   (new-expr (atom-boxn->array new-atom))
                   (limit (1- limit)))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-expr (atom-boxn->array new-atom) new-denv (1- limit)))
                   (val (eval-expr (atom-boxn->array atom) denv (1- limit))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (atom-free-ispace-vars atom))
                   (tvars2 (atom-free-type-vars atom))
                   (evars2 (atom-free-expr-vars atom))
                   (ivars1 (expr-free-ispace-vars (atom-boxn->array atom)))
                   (tvars1 (expr-free-type-vars (atom-boxn->array atom)))
                   (evars1 (expr-free-expr-vars (atom-boxn->array atom))))
        (:instance box-nest-alpha
                   (ivals (eval-ispace-list (atom-boxn->ispaces atom)
                                            (type-denv->ienv (expr-denv->tenv denv))))
                   (arrayval (eval-expr (atom-boxn->array atom) denv (1- limit)))
                   (new-arrayval (eval-expr (atom-boxn->array new-atom) new-denv (1- limit)))
                   (aw (expr-value-alpha-equiv-p-witness
                        (eval-expr (atom-boxn->array new-atom) new-denv (1- limit))
                        (eval-expr (atom-boxn->array atom) denv (1- limit))))
                   (tval (eval-type (type-option-some->val (atom-boxn->type? atom))
                                    (expr-denv->tenv denv)))
                   (new-tval (eval-type (type-rename-all-vars
                                         (type-option-some->val (atom-boxn->type? atom)) r)
                                        (expr-denv->tenv new-denv)))
                   (tw (eval-type-witness (type-option-some->val (atom-boxn->type? atom))
                                          r (denv-witness->types dw))))))

(defruled eval-atom-ok-when-boxn
  (implies (and (equal (atom-kind atom) :boxn)
                (implies (not (reserrp (eval-ispace-list (atom-boxn->ispaces atom)
                                                         (type-denv->ienv
                                                          (expr-denv->tenv denv)))))
                         (eval-expr-ok (atom-boxn->array atom) denv (1- limit))))
           (eval-atom-ok atom denv limit))
  :expand ((eval-atom-ok atom denv limit)
           (:free (new-x r) (atom-alpha-related-p new-x atom r)))
  :cases ((zp limit))
  :enable eval-atom-when-zp-limit
  :use ((:instance eval-atom-ok-when-boxn-aux
                   (new-atom (mv-nth 0 (eval-atom-ok-witness atom denv limit)))
                   (new-denv (mv-nth 1 (eval-atom-ok-witness atom denv limit)))
                   (r (mv-nth 2 (eval-atom-ok-witness atom denv limit)))
                   (dw (mv-nth 3 (eval-atom-ok-witness atom denv limit)))
                   (b (mv-nth 4 (eval-atom-ok-witness atom denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The unboxing clique members (EVAL-UNBOX and EVAL-UNBOX-LIST): a box
; target binds the first ispace variable to the box's witness and either
; binds the term variable and evaluates the body (last ispace variable) or
; recurses over the remaining ispace variables; a vector target lifts the
; unboxing over its elements; an empty vector builds an empty result array.
; The induction statements (EVAL-UNBOX-OK and EVAL-UNBOX-LIST-OK above)
; take the renamings before the binders and carry the freshness and
; no-capture conditions in image form, so that
; the environment extension lemmas of the ispace-bind and val-bind cases
; apply directly.

(defruled eval-unbox-when-zp-limit
  (implies (zp limit)
           (equal (eval-unbox target ispaces var body type denv limit)
                  (reserr :limit)))
  :expand ((eval-unbox target ispaces var body type denv limit)))

(defruled eval-unbox-when-box-last
  (implies (and (not (zp limit))
                (equal (expr-value-kind target) :box)
                (not (consp (cdr ispaces))))
           (equal (eval-unbox target ispaces var body type denv limit)
                  (b* (((unless (ispace-values-match-ispace-vars-p
                                 (list (expr-value-box->ispace target))
                                 (list (car ispaces))))
                        (reserr nil))
                       (denv (expr-denv-add-ispace (car ispaces)
                                                   (expr-value-box->ispace target)
                                                   denv))
                       (denv (expr-denv-add-expr var
                                                 (expr-value-box->array target)
                                                 denv)))
                    (eval-expr body denv (1- limit)))))
  :expand ((eval-unbox target ispaces var body type denv limit)))

(defruled eval-unbox-when-box-more
  (implies (and (not (zp limit))
                (equal (expr-value-kind target) :box)
                (consp (cdr ispaces)))
           (equal (eval-unbox target ispaces var body type denv limit)
                  (b* (((unless (ispace-values-match-ispace-vars-p
                                 (list (expr-value-box->ispace target))
                                 (list (car ispaces))))
                        (reserr nil))
                       (denv (expr-denv-add-ispace (car ispaces)
                                                   (expr-value-box->ispace target)
                                                   denv)))
                    (eval-unbox (expr-value-box->array target)
                                (cdr ispaces)
                                var
                                body
                                type
                                denv
                                (1- limit)))))
  :expand ((eval-unbox target ispaces var body type denv limit)))

(defruled eval-unbox-when-vector
  (implies (and (not (zp limit))
                (equal (expr-value-kind target) :vector))
           (equal (eval-unbox target ispaces var body type denv limit)
                  (b* (((ok vals) (eval-unbox-list (expr-value-vector->elems target)
                                                   ispaces var body type denv
                                                   (1- limit)))
                       ((unless (consp vals)) (reserr nil))
                       ((unless (list-repeatp (dims-of-expr-value-list vals)))
                        (reserr nil)))
                    (expr-value-vector vals))))
  :expand ((eval-unbox target ispaces var body type denv limit)))

(defruled eval-unbox-when-vector-empty
  (implies (and (not (zp limit))
                (equal (expr-value-kind target) :vector-empty))
           (equal (eval-unbox target ispaces var body type denv limit)
                  (b* (((unless (member-equal 0 (expr-value-vector-empty->dims target)))
                        (reserr nil))
                       ((mv elem cell-dims)
                        (type-value-case type
                                         :array (mv (type-value-array->elem type)
                                                    (type-value-array->dims type))
                                         :otherwise (mv type nil)))
                       ((when (type-value-case elem :array)) (reserr nil))
                       (dims (append (expr-value-vector-empty->dims target) cell-dims)))
                    (expr-value-with-empty-dim dims elem))))
  :expand ((eval-unbox target ispaces var body type denv limit)))

(defruled eval-unbox-when-otherwise
  (implies (and (not (zp limit))
                (not (equal (expr-value-kind target) :box))
                (not (equal (expr-value-kind target) :vector))
                (not (equal (expr-value-kind target) :vector-empty)))
