                   (b (mv-nth 10 (eval-unbox-ok-witness target ispaces var body type denv limit)))
                   (b0 (mv-nth 11 (eval-unbox-ok-witness target ispaces var body type denv limit))))
        (:instance eval-unbox-ok-when-box-more-aux
                   (new-target (mv-nth 0 (eval-unbox-ok-witness target ispaces var body type denv limit)))
                   (w (mv-nth 1 (eval-unbox-ok-witness target ispaces var body type denv limit)))
                   (new-ispaces (ispace-var-list-fix (mv-nth 2 (eval-unbox-ok-witness target ispaces var body type denv limit))))
                   (new-var (str-fix (mv-nth 3 (eval-unbox-ok-witness target ispaces var body type denv limit))))
                   (new-body (mv-nth 4 (eval-unbox-ok-witness target ispaces var body type denv limit)))
                   (new-type (mv-nth 5 (eval-unbox-ok-witness target ispaces var body type denv limit)))
                   (tw (mv-nth 6 (eval-unbox-ok-witness target ispaces var body type denv limit)))
                   (new-denv (mv-nth 7 (eval-unbox-ok-witness target ispaces var body type denv limit)))
                   (r (mv-nth 8 (eval-unbox-ok-witness target ispaces var body type denv limit)))
                   (dw (mv-nth 9 (eval-unbox-ok-witness target ispaces var body type denv limit)))
                   (b (mv-nth 10 (eval-unbox-ok-witness target ispaces var body type denv limit)))
                   (b0 (mv-nth 11 (eval-unbox-ok-witness target ispaces var body type denv limit))))))

(defruled eval-unbox-ok-cases
  (implies (and (ispace-var-listp ispaces)
                (stringp var)
                (implies (and (equal (expr-value-kind target) :box)
                              (ispace-values-match-ispace-vars-p
                               (list (expr-value-box->ispace target))
                               (list (car ispaces)))
                              (not (consp (cdr ispaces))))
                         (eval-expr-ok body
                                       (expr-denv-add-expr
                                        var
                                        (expr-value-box->array target)
                                        (expr-denv-add-ispace
                                         (car ispaces)
                                         (expr-value-box->ispace target)
                                         denv))
                                       (1- limit)))
                (implies (and (equal (expr-value-kind target) :box)
                              (ispace-values-match-ispace-vars-p
                               (list (expr-value-box->ispace target))
                               (list (car ispaces)))
                              (consp (cdr ispaces)))
                         (eval-unbox-ok (expr-value-box->array target)
                                        (cdr ispaces)
                                        var body type
                                        (expr-denv-add-ispace
                                         (car ispaces)
                                         (expr-value-box->ispace target)
                                         denv)
                                        (1- limit)))
                (implies (equal (expr-value-kind target) :vector)
                         (eval-unbox-list-ok (expr-value-vector->elems target)
                                             ispaces var body type denv (1- limit))))
           (eval-unbox-ok target ispaces var body type denv limit))
  :use (eval-unbox-ok-when-box
        eval-unbox-ok-when-vector
        eval-unbox-ok-when-vector-empty
        eval-unbox-ok-when-otherwise))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The remaining limit-exhaustion lemmas.  The evaluator cases that follow
; --- the n-ary term lambda, the unboxing expressions, the function binds
; with two or more parameters, and the combined function binds --- complete
; the case lemmas; then comes the assembly: the flag function of the
; evaluator clique and the flag theorem stating all the induction
; statements.

(defruled eval-expr-list-when-zp-limit
  (implies (zp limit)
           (equal (eval-expr-list exprs denv limit) (reserr :limit)))
  :expand ((eval-expr-list exprs denv limit)))

(defruled eval-atom-list-when-zp-limit
  (implies (zp limit)
           (equal (eval-atom-list atoms denv limit) (reserr :limit)))
  :expand ((eval-atom-list atoms denv limit)))

(defruled eval-expr-ok-when-zp-limit
  (implies (zp limit) (eval-expr-ok expr denv limit))
  :expand ((eval-expr-ok expr denv limit))
  :enable eval-expr-when-zp-limit)

(defruled eval-expr-list-ok-when-zp-limit
  (implies (zp limit) (eval-expr-list-ok exprs denv limit))
  :expand ((eval-expr-list-ok exprs denv limit))
  :enable eval-expr-list-when-zp-limit)

(defruled eval-atom-ok-when-zp-limit
  (implies (zp limit) (eval-atom-ok atom denv limit))
  :expand ((eval-atom-ok atom denv limit))
  :enable eval-atom-when-zp-limit)

(defruled eval-atom-list-ok-when-zp-limit
  (implies (zp limit) (eval-atom-list-ok atoms denv limit))
  :expand ((eval-atom-list-ok atoms denv limit))
  :enable eval-atom-list-when-zp-limit)

(defruled eval-bind-ok-when-zp-limit
  (implies (zp limit) (eval-bind-ok bind denv limit))
  :expand ((eval-bind-ok bind denv limit))
  :enable eval-bind-when-zp-limit)

(defruled eval-bind-list-ok-when-zp-limit
  (implies (zp limit) (eval-bind-list-ok binds denv limit))
  :expand ((eval-bind-list-ok binds denv limit))
  :enable eval-bind-list-when-zp-limit)

(defruled eval-tapp-ok-when-zp-limit
  (implies (zp limit) (eval-tapp-ok funval tval limit))
  :expand ((eval-tapp-ok funval tval limit))
  :enable eval-tapp-when-zp-limit)

(defruled eval-iapp-ok-when-zp-limit
  (implies (zp limit) (eval-iapp-ok funval ival limit))
  :expand ((eval-iapp-ok funval ival limit))
  :enable eval-iapp-when-zp-limit)

(defruled eval-app-cell-ok-when-zp-limit
  (implies (zp limit) (eval-app-cell-ok funcell argcell limit))
  :expand ((eval-app-cell-ok funcell argcell limit))
  :enable eval-app-cell-when-zp-limit)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Atoms: n-ary term lambda.  The value is a unary closure over the first
; parameter whose body is the curried remainder (the lambda over the
; remaining parameters, carrying the annotation), with no annotation of its
; own; its environment is restricted to the free ispace and type variables
; of the curried body and to the free expression variables of the body
; minus all the parameters.  As for the n-ary type and ispace lambdas, the
; closure's support set is the outer one, since the freshness of the
; remaining parameters is known only relative to it.

(defruled eval-atom-when-lambdan
  (implies (and (equal (atom-kind atom) :lambdan)
                (not (zp limit)))
           (equal (eval-atom atom denv limit)
                  (b* (((ok param) (eval-var+type? (car (atom-lambdan->params atom))
                                                   (expr-denv->tenv denv)))
                       (body (lambda-curried-body (atom-lambdan->params atom)
                                                  (atom-lambdan->body atom)
                                                  (atom-lambdan->type? atom))))
                    (make-expr-value-lambda
                     :param param
                     :body body
                     :type? nil
                     :denv (expr-denv-restrict
                            (expr-free-ispace-vars body)
                            (expr-free-type-vars body)
                            (atom-free-expr-vars atom)
                            denv)))))
  :expand ((eval-atom atom denv limit)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The curried body: its free expression variables, and its free ispace and
; type variables within those of the atom.

(defruled expr-free-expr-vars-of-lambda-curried-body
  (implies (and (consp (cdr params))
                (var+type?-listp params))
           (equal (expr-free-expr-vars (lambda-curried-body params body type?))
                  (set::difference (expr-free-expr-vars body)
                                   (set::mergesort
                                    (var+type?-list->var (cdr params))))))
  :expand ((:free (a) (expr-free-expr-vars (expr-atom a)))
           (:free (ps b t?) (atom-free-expr-vars (atom-lambdan ps b t?)))
           (:free (p b t?) (atom-free-expr-vars (atom-lambda p b t?)))
           (var+type?-list->var (cdr params))
           (var+type?-list->var (cddr params)))
  :enable (lambda-curried-body
           make-atom-lambda/lambdan
           mergesort-of-cons
           set::difference-insert-y
           difference-of-nil-right))

(defruled subset-expr-free-ispace-vars-of-lambda-curried-body
  (implies (consp (cdr params))
           (set::subset (expr-free-ispace-vars
                         (lambda-curried-body params body type?))
                        (set::union (var+type?-list-free-ispace-vars params)
                                    (set::union
                                     (expr-free-ispace-vars body)
                                     (type-option-free-ispace-vars type?)))))
  :expand ((:free (a) (expr-free-ispace-vars (expr-atom a)))
           (:free (ps b t?) (atom-free-ispace-vars (atom-lambdan ps b t?)))
           (:free (p b t?) (atom-free-ispace-vars (atom-lambda p b t?)))
           (var+type?-list-free-ispace-vars params)
           (var+type?-list-free-ispace-vars (cdr params)))
  :enable (lambda-curried-body
           make-atom-lambda/lambdan
           set::pick-a-point-subset-strategy
           set::union-in
           set::subset-in))

(defruled subset-expr-free-type-vars-of-lambda-curried-body
  (implies (consp (cdr params))
           (set::subset (expr-free-type-vars
                         (lambda-curried-body params body type?))
                        (set::union (var+type?-list-free-type-vars params)
                                    (set::union
                                     (expr-free-type-vars body)
                                     (type-option-free-type-vars type?)))))
  :expand ((:free (a) (expr-free-type-vars (expr-atom a)))
           (:free (ps b t?) (atom-free-type-vars (atom-lambdan ps b t?)))
           (:free (p b t?) (atom-free-type-vars (atom-lambda p b t?)))
           (var+type?-list-free-type-vars params)
           (var+type?-list-free-type-vars (cdr params)))
  :enable (lambda-curried-body
           make-atom-lambda/lambdan
           set::pick-a-point-subset-strategy
           set::union-in
           set::subset-in))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The parameter correspondence of the n-ary relation, on the remaining
; parameters; and the type renamings do not depend on the expression
; renaming.

(defruled cdr-of-var+type?-list-set-vars
  (equal (cdr (var+type?-list-set-vars vars vts))
         (var+type?-list-set-vars (cdr vars) (cdr vts)))
  :expand ((var+type?-list-set-vars vars vts)
           (var+type?-list-set-vars (cdr vars) (cdr vts)))
  :enable cdr-of-var+type?-list-fix)

(defruled var+type?-list-rename-all-vars-of-change-expr
  (equal (var+type?-list-rename-all-vars params
                                         (change-var-renamings r :expr m))
         (var+type?-list-rename-all-vars params r))
  :enable var+type?-list-rename-all-vars)

(defruled cdr-of-var+type?-list-rename-all-vars
  (equal (cdr (var+type?-list-rename-all-vars params r))
         (var+type?-list-rename-all-vars (cdr params) r))
  :enable (var+type?-list-rename-all-vars
           var+type?-list-rename-ispace-vars
           var+type?-list-rename-type-vars))

(defruled type-option-rename-all-vars-of-change-expr
  (equal (type-option-rename-all-vars type? (change-var-renamings r :expr m))
         (type-option-rename-all-vars type? r))
  :enable type-option-rename-all-vars)

(defruled var+type?-list-types-fresh-ok-of-change-expr
  (equal (var+type?-list-types-fresh-ok params (change-var-renamings r :expr m))
         (var+type?-list-types-fresh-ok params r))
  :induct t
  :enable (var+type?-list-types-fresh-ok
           type-option-fresh-ok
           type-fresh-ok))

(defruled type-option-fresh-ok-of-change-expr
  (equal (type-option-fresh-ok type? (change-var-renamings r :expr m))
         (type-option-fresh-ok type? r))
  :enable (type-option-fresh-ok type-fresh-ok))

(defruled var+type?->var-of-car-when-set-vars-of-rename
  (implies (and (equal ps (var+type?-list-set-vars
                          (var+type?-list->var ps)
                          (var+type?-list-rename-all-vars qs r)))
                (consp ps)
                (consp qs))
           (equal (var+type?-list->var ps)
                  (cons (var+type?->var (car ps))
                        (var+type?-list->var (cdr ps)))))
  :expand ((var+type?-list->var ps)))

(defruled cdr-when-set-vars-of-rename
  (implies (and (equal ps (var+type?-list-set-vars
                          (var+type?-list->var ps)
                          (var+type?-list-rename-all-vars qs r)))
                (consp ps)
                (consp qs))
           (equal (cdr ps)
                  (var+type?-list-set-vars
                   (var+type?-list->var (cdr ps))
                   (var+type?-list-rename-all-vars (cdr qs) r))))
  :use ((:instance cdr-of-var+type?-list-set-vars
                   (vars (var+type?-list->var ps))
                   (vts (var+type?-list-rename-all-vars qs r))))
  :enable (cdr-of-var+type?-list-rename-all-vars
           var+type?-list->var))

(defruled len-of-cdr-when-len-equal
  (implies (equal (len a) (len b))
           (equal (len (cdr a)) (len (cdr b))))
  :expand ((len a) (len b)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Relatedness of the curried bodies under the renamings extended by the
; first parameters, from the n-ary atom's conditions.

(defruled expr-alpha-related-p-of-lambda-curried-body
  (implies (and (consp (cdr params))
                (var+type?-listp params)
                (var+type?-listp new-params)
                (equal (len new-params) (len params))
                (equal new-params
                       (var+type?-list-set-vars
                        (var+type?-list->var new-params)
                        (var+type?-list-rename-all-vars params r)))
                (equal new-type? (type-option-rename-all-vars type? r))
                (expr-alpha-related-p
                 new-body body
                 (change-var-renamings
                  r :expr (extend-renaming-list
                           (var+type?-list->var params)
                           (var+type?-list->var new-params)
                           (var-renamings->expr r)))))
           (expr-alpha-related-p
            (lambda-curried-body new-params new-body new-type?)
            (lambda-curried-body params body type?)
            (change-var-renamings
             r :expr (extend-renaming
                      (var+type?->var (car params))
                      (var+type?->var (car new-params))
                      (var-renamings->expr r)))))
  :expand ((:free (a1 a2 r) (expr-alpha-related-p (expr-atom a1) (expr-atom a2) r))
           (:free (a1 ps b t? r) (atom-alpha-related-p a1 (atom-lambdan ps b t?) r))
           (:free (a1 p b t? r) (atom-alpha-related-p a1 (atom-lambda p b t?) r))
           (var+type?-list->var params)
           (var+type?-list->var (cdr params))
           (var+type?-list->var (cddr params))
           (var+type?-list->var new-params)
           (var+type?-list->var (cdr new-params))
           (var+type?-list->var (cddr new-params))
           (:free (a b m) (extend-renaming-list (cons a b) (cons (var+type?->var (car new-params)) m) (var-renamings->expr r))))
  :enable (lambda-curried-body
           make-atom-lambda/lambdan
           extend-renaming-list
           var+type?-list-rename-all-vars-of-change-expr
           type-option-rename-all-vars-of-change-expr
           len)
  :use ((:instance consp-when-len-equal (a new-params) (b params))
        (:instance consp-of-cdr-when-len-equal (a new-params) (b params))
        (:instance consp-of-cddr-when-len-equal (a new-params) (b params))
        (:instance cdr-when-set-vars-of-rename (ps new-params) (qs params))
        (:instance var+type?->type?-of-car-when-set-vars-of-rename
                   (ps (cdr new-params)) (qs (cdr params)))
        (:instance len-of-cdr-when-len-equal (a new-params) (b params))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Freshness of the curried bodies, with respect to the outer support set
; extended by the first new parameter's name: the first parameter's
; freshness step is consumed, and the remaining conditions are the n-ary
; atom's conditions on the remaining parameters.

(defruled disjoint-of-expr-var-image-of-cdr-extend
  (implies (and (string-setp f)
                (string-listp names)
                (string-listp new-names)
                (consp names)
                (consp new-names)
                (no-duplicatesp-equal new-names)
                (set::emptyp
                 (set::intersect
                  (set::mergesort new-names)
                  (rename-var-string-set
                   (set::difference f (set::mergesort names)) m))))
           (set::emptyp
            (set::intersect
             (set::mergesort (cdr new-names))
             (rename-var-string-set
              (set::difference f (set::mergesort (cdr names)))
              (extend-renaming (car names) (car new-names) m)))))
  :enable (mergesort-of-cons
           set::difference-insert-y)
  :use ((:instance disjoint-of-image-of-extend-when-disjoint
                   (l (set::mergesort (cdr new-names)))
                   (s (set::difference f (set::mergesort (cdr names))))
                   (n (car names))
                   (n2 (car new-names)))
        (:instance disjoint-monotone
                   (l (set::mergesort new-names))
                   (l2 (set::mergesort (cdr new-names)))
                   (x (rename-var-string-set
                       (set::difference f (set::mergesort names)) m)))
        (:instance subset-of-mergesort-of-cdr (l new-names))))

(defruled expr-alpha-fresh-p-of-lambda-curried-body
  (implies (and (consp (cdr params))
                (var+type?-listp params)
                (var+type?-listp new-params)
                (equal (len new-params) (len params))
                (var+type?-list-types-fresh-ok params r)
                (type-option-fresh-ok type? r)
                (string-list-fresh-ok (var+type?-list->var params)
                                      (var+type?-list->var new-params)
                                      (var-renamings->expr r)
                                      b)
                (no-duplicatesp-equal (var+type?-list->var new-params))
                (set::emptyp
                 (set::intersect
                  (set::mergesort (var+type?-list->var new-params))
                  (rename-var-string-set
                   (set::difference (expr-free-expr-vars body)
                                    (set::mergesort (var+type?-list->var params)))
                   (var-renamings->expr r))))
                (expr-alpha-fresh-p
                 new-body body
                 (change-var-renamings
                  r :expr (extend-renaming-list
                           (var+type?-list->var params)
                           (var+type?-list->var new-params)
                           (var-renamings->expr r)))
                 (set::union
                  (set::mergesort (var+type?-list->var new-params))
                  (expr-body-support-names
                   body
                   (change-var-renamings
                    r :expr (extend-renaming-list
                             (var+type?-list->var params)
                             (var+type?-list->var new-params)
                             (var-renamings->expr r)))))))
           (expr-alpha-fresh-p
            (lambda-curried-body new-params new-body new-type?)
            (lambda-curried-body params body type?)
            (change-var-renamings
             r :expr (extend-renaming
                      (var+type?->var (car params))
                      (var+type?->var (car new-params))
                      (var-renamings->expr r)))
            (set::insert (var+type?->var (car new-params)) (string-sfix b))))
  :expand ((:free (a1 a2 r b) (expr-alpha-fresh-p (expr-atom a1) (expr-atom a2) r b))
           (:free (a1 ps bd t? r b) (atom-alpha-fresh-p a1 (atom-lambdan ps bd t?) r b))
           (:free (a1 p bd t? r b) (atom-alpha-fresh-p a1 (atom-lambda p bd t?) r b))
           (var+type?-list->var params)
           (var+type?-list->var (cdr params))
           (var+type?-list->var new-params)
           (var+type?-list->var (cdr new-params))
           (var+type?-list-types-fresh-ok params r)
           (var+type?-list-types-fresh-ok (cdr params) r))
  :enable (lambda-curried-body
           make-atom-lambda/lambdan
           extend-renaming-list
           string-list-fresh-ok
           var+type?-list-types-fresh-ok-of-change-expr
           type-option-fresh-ok-of-change-expr
           mergesort-of-cons
           set::difference-insert-y
           difference-of-nil-right
           expr-alpha-fresh-p-anti-monotone
           subset-of-union-right-1
           subset-of-union-right-2
           not-in-when-emptyp-intersect-of-insert)
  :use ((:instance consp-when-len-equal (a new-params) (b params))
        (:instance consp-of-cdr-when-len-equal (a new-params) (b params))
        (:instance consp-of-cddr-when-len-equal (a new-params) (b params))
        (:instance disjoint-of-expr-var-image-of-cdr-extend
                   (f (expr-free-expr-vars body))
                   (names (var+type?-list->var params))
                   (new-names (var+type?-list->var new-params))
                   (m (var-renamings->expr r)))
        (:instance subset-of-mergesort-of-cdr (l (var+type?-list->var new-params))))
  :disable (no-duplicatesp-equal-when-no-duplicatesp-equal-of-type-var-list->name
            no-duplicatesp-equal-when-no-duplicatesp-equal-of-ispace-var-list->name
            no-duplicatesp-equal-when-not-duplicated-names
            duplicated-names-when-no-duplicatesp-equal
            member-equal-of-type-var-list->name-when-member-equal
            member-equal-of-ispace-var-list->name-when-member-equal
            member-of-type-var->name-in-type-var-list->name
            member-of-ispace-var->name-in-ispace-var-list->name
            member-equal))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The support invariant survives the extension of the expression renaming
; by one parameter (the new name enters the support set); mirror of the
; type and ispace namespace versions.

(defruled expr-denv-keys-supported-p-of-expr-var-extend-1
  (implies (and (expr-denv-keys-supported-p denv r b)
                (stringp name)
                (stringp new-name))
           (expr-denv-keys-supported-p
            denv
            (change-var-renamings
             r :expr (extend-renaming name new-name (var-renamings->expr r)))
            (set::insert new-name (string-sfix b))))
  :enable (expr-denv-keys-supported-p
           string-set-supported-p-of-extend-other
           string-set-supported-p-monotone
           set::subset-insert))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The captured environment of the n-ary term lambda's closure: the
; restrictions of related environments to the free variables of the
; curried bodies are related, the original one is within its restriction
; sets, the avoidance carries over, and the support invariant holds at
; the renamings extended by the first parameter.  The new-side restriction
; sets are the images of the original ones by the free-variable image
; lemmas applied to the curried bodies.

; The curried bodies of related n-ary term lambdas are related and fresh
; under the renamings extended by the first parameters.

(defruled lambdan-curried-body-alpha
  (implies (and (equal (atom-kind atom) :lambdan)
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b))
           (b* ((params (atom-lambdan->params atom))
                (new-params (atom-lambdan->params new-atom))
                (cbody (lambda-curried-body params
                                            (atom-lambdan->body atom)
                                            (atom-lambdan->type? atom)))
                (new-cbody (lambda-curried-body new-params
                                                (atom-lambdan->body new-atom)
                                                (atom-lambdan->type? new-atom)))
                (body-r (change-var-renamings
                         r :expr (extend-renaming
                                  (var+type?->var (car params))
                                  (var+type?->var (car new-params))
                                  (var-renamings->expr r)))))
             (and (expr-alpha-related-p new-cbody cbody body-r)
                  (expr-alpha-fresh-p new-cbody cbody body-r
                                      (set::insert (var+type?->var (car new-params))
                                                   (string-sfix b))))))
  :expand ((atom-alpha-related-p new-atom atom r)
           (atom-alpha-fresh-p new-atom atom r b))
  :enable (consp-of-cdr-of-atom-lambdan->params)
  :disable (atom-free-expr-vars-of-alpha-related
            member-equal
            no-duplicatesp-equal-when-no-duplicatesp-equal-of-type-var-list->name
            no-duplicatesp-equal-when-no-duplicatesp-equal-of-ispace-var-list->name
            no-duplicatesp-equal-when-not-duplicated-names
            duplicated-names-when-no-duplicatesp-equal
            member-equal-of-type-var-list->name-when-member-equal
            member-equal-of-ispace-var-list->name-when-member-equal
            member-of-type-var->name-in-type-var-list->name
            member-of-ispace-var->name-in-ispace-var-list->name
            acl2::string-setp-of-union
            acl2::setp-when-string-setp
            set::sfix-when-emptyp)
  :use ((:instance expr-alpha-related-p-of-lambda-curried-body
                   (params (atom-lambdan->params atom))
                   (new-params (atom-lambdan->params new-atom))
                   (body (atom-lambdan->body atom))
                   (new-body (atom-lambdan->body new-atom))
                   (type? (atom-lambdan->type? atom))
                   (new-type? (atom-lambdan->type? new-atom)))
        (:instance expr-alpha-fresh-p-of-lambda-curried-body
                   (params (atom-lambdan->params atom))
                   (new-params (atom-lambdan->params new-atom))
                   (body (atom-lambdan->body atom))
                   (new-body (atom-lambdan->body new-atom))
                   (type? (atom-lambdan->type? atom))
                   (new-type? (atom-lambdan->type? new-atom)))))

(defruled lambdan-closure-denv-alpha
  (implies (and (equal (atom-kind atom) :lambdan)
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-free-ispace-vars atom)
                                           (atom-free-type-vars atom)
                                           (atom-free-expr-vars atom))
                (expr-denv-wfp denv))
           (b* ((params (atom-lambdan->params atom))
                (new-params (atom-lambdan->params new-atom))
                (cbody (lambda-curried-body params
                                            (atom-lambdan->body atom)
                                            (atom-lambdan->type? atom)))
                (new-cbody (lambda-curried-body new-params
                                                (atom-lambdan->body new-atom)
                                                (atom-lambdan->type? new-atom)))
                (ivars (expr-free-ispace-vars cbody))
                (tvars (expr-free-type-vars cbody))
                (evars (atom-free-expr-vars atom))
                (cdenv (expr-denv-restrict ivars tvars evars denv))
                (new-cdenv (expr-denv-restrict
                            (expr-free-ispace-vars new-cbody)
                            (expr-free-type-vars new-cbody)
                            (atom-free-expr-vars new-atom)
                            new-denv))
                (body-r (change-var-renamings
                         r :expr (extend-renaming
                                  (var+type?->var (car params))
                                  (var+type?->var (car new-params))
                                  (var-renamings->expr r)))))
             (and (expr-denv-alpha-related-via-p new-cdenv cdenv r dw)
                  (expr-denv-keys-within-p cdenv ivars tvars evars)
                  (expr-denv-alpha-avoided-p new-cdenv cdenv r
                                             ivars tvars evars)
                  (expr-denv-keys-supported-p
                   cdenv body-r
                   (set::insert (var+type?->var (car new-params))
                                (string-sfix b))))))
  :expand (           (atom-free-ispace-vars atom)
           (atom-free-type-vars atom))
  :enable (expr-denv-keys-within-p-of-expr-denv-restrict
           expr-denv-keys-supported-p-of-expr-denv-restrict
           expr-denv-keys-supported-p-of-expr-var-extend-1
           consp-of-cdr-of-atom-lambdan->params
           subset-expr-free-ispace-vars-of-lambda-curried-body
           subset-expr-free-type-vars-of-lambda-curried-body)
  :disable (atom-free-expr-vars-of-alpha-related
            member-equal
            no-duplicatesp-equal-when-no-duplicatesp-equal-of-type-var-list->name
            no-duplicatesp-equal-when-no-duplicatesp-equal-of-ispace-var-list->name
            no-duplicatesp-equal-when-not-duplicated-names
            duplicated-names-when-no-duplicatesp-equal
            member-equal-of-type-var-list->name-when-member-equal
            member-equal-of-ispace-var-list->name-when-member-equal
            member-of-type-var->name-in-type-var-list->name
            member-of-ispace-var->name-in-ispace-var-list->name
            acl2::string-setp-of-union
            acl2::setp-when-string-setp
            set::sfix-when-emptyp)
  :use ((:instance atom-free-expr-vars-of-alpha-related
                   (new-a new-atom) (a atom))
        lambdan-curried-body-alpha
                (:instance expr-free-ispace-vars-of-alpha-related
                   (new-x (lambda-curried-body (atom-lambdan->params new-atom)
                                               (atom-lambdan->body new-atom)
                                               (atom-lambdan->type? new-atom)))
                   (x (lambda-curried-body (atom-lambdan->params atom)
                                           (atom-lambdan->body atom)
                                           (atom-lambdan->type? atom)))
                   (r (change-var-renamings
                       r :expr (extend-renaming
                                (var+type?->var (car (atom-lambdan->params atom)))
                                (var+type?->var (car (atom-lambdan->params new-atom)))
                                (var-renamings->expr r))))
                   (b (set::insert (var+type?->var (car (atom-lambdan->params new-atom)))
                                   (string-sfix b))))
        (:instance expr-free-type-vars-of-alpha-related
                   (new-x (lambda-curried-body (atom-lambdan->params new-atom)
                                               (atom-lambdan->body new-atom)
                                               (atom-lambdan->type? new-atom)))
                   (x (lambda-curried-body (atom-lambdan->params atom)
                                           (atom-lambdan->body atom)
                                           (atom-lambdan->type? atom)))
                   (r (change-var-renamings
                       r :expr (extend-renaming
                                (var+type?->var (car (atom-lambdan->params atom)))
                                (var+type?->var (car (atom-lambdan->params new-atom)))
                                (var-renamings->expr r))))
                   (b (set::insert (var+type?->var (car (atom-lambdan->params new-atom)))
                                   (string-sfix b))))
        (:instance expr-denv-alpha-related-via-p-of-expr-denv-restrict
                   (ivars (expr-free-ispace-vars
                           (lambda-curried-body (atom-lambdan->params atom)
                                                (atom-lambdan->body atom)
                                                (atom-lambdan->type? atom))))
                   (tvars (expr-free-type-vars
                           (lambda-curried-body (atom-lambdan->params atom)
                                                (atom-lambdan->body atom)
                                                (atom-lambdan->type? atom))))
                   (evars (atom-free-expr-vars atom))
                   (new-ivars (expr-free-ispace-vars
                               (lambda-curried-body (atom-lambdan->params new-atom)
                                                    (atom-lambdan->body new-atom)
                                                    (atom-lambdan->type? new-atom))))
                   (new-tvars (expr-free-type-vars
                               (lambda-curried-body (atom-lambdan->params new-atom)
                                                    (atom-lambdan->body new-atom)
                                                    (atom-lambdan->type? new-atom))))
                   (new-evars (atom-free-expr-vars new-atom)))
        (:instance expr-denv-alpha-avoided-p-of-expr-denv-restrict
                   (ivars (expr-free-ispace-vars
                           (lambda-curried-body (atom-lambdan->params atom)
                                                (atom-lambdan->body atom)
                                                (atom-lambdan->type? atom))))
                   (tvars (expr-free-type-vars
                           (lambda-curried-body (atom-lambdan->params atom)
                                                (atom-lambdan->body atom)
                                                (atom-lambdan->type? atom))))
                   (evars (atom-free-expr-vars atom))
                   (ivars1 (expr-free-ispace-vars
                            (lambda-curried-body (atom-lambdan->params atom)
                                                 (atom-lambdan->body atom)
                                                 (atom-lambdan->type? atom))))
                   (tvars1 (expr-free-type-vars
                            (lambda-curried-body (atom-lambdan->params atom)
                                                 (atom-lambdan->body atom)
                                                 (atom-lambdan->type? atom))))
                   (evars1 (atom-free-expr-vars atom))
                   (new-ivars (expr-free-ispace-vars
                               (lambda-curried-body (atom-lambdan->params new-atom)
                                                    (atom-lambdan->body new-atom)
                                                    (atom-lambdan->type? new-atom))))
                   (new-tvars (expr-free-type-vars
                               (lambda-curried-body (atom-lambdan->params new-atom)
                                                    (atom-lambdan->body new-atom)
                                                    (atom-lambdan->type? new-atom))))
                   (new-evars (atom-free-expr-vars new-atom)))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (atom-free-ispace-vars atom))
                   (tvars2 (atom-free-type-vars atom))
                   (evars2 (atom-free-expr-vars atom))
                   (ivars1 (expr-free-ispace-vars
                            (lambda-curried-body (atom-lambdan->params atom)
                                                 (atom-lambdan->body atom)
                                                 (atom-lambdan->type? atom))))
                   (tvars1 (expr-free-type-vars
                            (lambda-curried-body (atom-lambdan->params atom)
                                                 (atom-lambdan->body atom)
                                                 (atom-lambdan->type? atom))))
                   (evars1 (atom-free-expr-vars atom)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The first parameter of an n-ary term lambda evaluates, under related
; environments, to the same variable with related type values.

(defruled eval-var+type?-of-car-of-lambdan-params-alpha
  (implies (and (equal (atom-kind atom) :lambdan)
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-free-ispace-vars atom)
                                           (atom-free-type-vars atom)
                                           (atom-free-expr-vars atom)))
           (b* ((vt (car (atom-lambdan->params atom)))
                (new-vt (car (atom-lambdan->params new-atom)))
                (val (eval-var+type? vt (expr-denv->tenv denv)))
                (new-val (eval-var+type? new-vt (expr-denv->tenv new-denv))))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (and (equal (var+typevalue->var new-val)
                                       (var+type?->var new-vt))
                                (equal (var+typevalue->var val)
                                       (var+type?->var vt))
                                (type-value-alpha-related-via-p
                                 (var+typevalue->type new-val)
                                 (var+typevalue->type val)
                                 (eval-type-witness
                                  (type-option-some->val (var+type?->type? vt))
                                  r (denv-witness->types dw))))))))
  :expand ((atom-alpha-related-p new-atom atom r)
           (atom-alpha-fresh-p new-atom atom r b)
           (atom-free-ispace-vars atom)
           (atom-free-type-vars atom)
           (var+type?-list-free-ispace-vars (atom-lambdan->params atom))
           (var+type?-list-free-type-vars (atom-lambdan->params atom)))
  :enable (consp-of-cdr-of-atom-lambdan->params
           expr-denv-alpha-avoided-p
           expr-denv-alpha-related-via-p
           type-denv-alpha-avoided-p
           denv-ispace-vars-avoided-p-monotone
           type-var-map-avoided-p-monotone
           subset-of-union-right-1
           subset-of-union-right-2
           var+type?-list-types-fresh-ok
           var+type?-list-free-ispace-vars
           var+type?-list-free-type-vars
           var+type?-free-ispace-vars
           var+type?-free-type-vars)
  :use ((:instance eval-var+type?-alpha
                   (vt (car (atom-lambdan->params atom)))
                   (new-vt (car (atom-lambdan->params new-atom)))
                   (tenv (expr-denv->tenv denv))
                   (new-tenv (expr-denv->tenv new-denv))
                   (wmap (denv-witness->types dw)))
        (:instance var+type?->type?-of-car-when-set-vars-of-rename
                   (ps (atom-lambdan->params new-atom))
                   (qs (atom-lambdan->params atom)))))

(defruled eval-atom-ok-when-lambdan-aux
  (implies (and (equal (atom-kind atom) :lambdan)
                (not (zp limit))
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-free-ispace-vars atom)
                                           (atom-free-type-vars atom)
                                           (atom-free-expr-vars atom))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((val (eval-atom atom denv limit))
                (new-val (eval-atom new-atom new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((atom-alpha-related-p new-atom atom r)
           (atom-alpha-fresh-p new-atom atom r b)
           (atom-free-ispace-vars atom)
           (atom-free-type-vars atom)
           (atom-free-expr-vars atom)
           (:free (new-val w param body type? cdenv)
            (expr-value-alpha-related-via-p
             new-val (expr-value-lambda param body type? cdenv) w)))
  :enable (eval-atom-when-lambdan
           expr-free-expr-vars-of-lambda-curried-body
           consp-of-cdr-of-atom-lambdan->params
           mergesort-when-consp
           set::difference-insert-y
           not-in-when-emptyp-intersect-of-insert
           var+type?-list-types-fresh-ok
           not-reserrp-when-expr-valuep)
  :disable (atom-free-expr-vars-of-alpha-related
            set::in-mergesort-under-iff
            set::delete-nonmember-cancel
            set::difference-in
            set::insert-identity
            set::delete-in
            acl2::subsetp-car-member
            member-of-var+type?->var-in-var+type?-list->var
            member-equal
            no-duplicatesp-equal-when-no-duplicatesp-equal-of-type-var-list->name
            no-duplicatesp-equal-when-no-duplicatesp-equal-of-ispace-var-list->name
            no-duplicatesp-equal-when-not-duplicated-names
            duplicated-names-when-no-duplicatesp-equal
            member-equal-of-type-var-list->name-when-member-equal
            member-equal-of-ispace-var-list->name-when-member-equal
            member-of-type-var->name-in-type-var-list->name
            member-of-ispace-var->name-in-ispace-var-list->name)
  :use (lambdan-closure-denv-alpha
        eval-var+type?-of-car-of-lambdan-params-alpha
        (:instance var+type?->var-of-car-when-set-vars-of-rename
                   (ps (atom-lambdan->params new-atom))
                   (qs (atom-lambdan->params atom)))
        lambdan-curried-body-alpha
        (:instance atom-free-expr-vars-of-alpha-related
                   (new-a new-atom) (a atom))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (eval-atom new-atom new-denv limit))
                   (val (eval-atom atom denv limit))
                   (w (expr-value-witness-closure
                       r
                       (eval-type-witness
                        (type-option-some->val
                         (var+type?->type? (car (atom-lambdan->params atom))))
                        r (denv-witness->types dw))
                       '(:leaf)
                       dw
                       b)))))

(defruled eval-atom-ok-when-lambdan
  (implies (equal (atom-kind atom) :lambdan)
           (eval-atom-ok atom denv limit))
  :expand ((eval-atom-ok atom denv limit)
           (:free (new-x r) (atom-alpha-related-p new-x atom r)))
  :cases ((zp limit))
  :enable eval-atom-when-zp-limit
  :use ((:instance eval-atom-ok-when-lambdan-aux
                   (new-atom (mv-nth 0 (eval-atom-ok-witness atom denv limit)))
                   (new-denv (mv-nth 1 (eval-atom-ok-witness atom denv limit)))
                   (r (mv-nth 2 (eval-atom-ok-witness atom denv limit)))
                   (dw (mv-nth 3 (eval-atom-ok-witness atom denv limit)))
                   (b (mv-nth 4 (eval-atom-ok-witness atom denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Expressions: unboxing.  The target evaluates to related values (the
; induction hypothesis), the result type to related type values
; (EVAL-TYPE-ALPHA), and the statement of the unboxing clique member (the
; induction hypothesis at the target and type values) gives the result,
; its side conditions being those of the relations at the unboxing
; expression; the relations are decomposed into those conditions first,
; stated in the shapes the statement takes them (in particular the unary
; form's single ispace variable as a singleton list).

(defruled eval-expr-when-unbox
  (implies (and (equal (expr-kind expr) :unbox)
                (not (zp limit)))
           (equal (eval-expr expr denv limit)
                  (b* (((ok targetval) (eval-expr (expr-unbox->target expr)
                                                  denv (1- limit)))
                       (type? (expr-unbox->type? expr))
                       ((ok tval) (type-option-case
                                   type?
                                   :some (eval-type type?.val
                                                    (expr-denv->tenv denv))
                                   :none (reserr nil))))
                    (eval-unbox targetval
                                (list (expr-unbox->ispace expr))
                                (expr-unbox->var expr)
                                (expr-unbox->body expr)
                                tval
                                denv
                                (1- limit)))))
  :expand ((eval-expr expr denv limit)))

(defruled eval-expr-when-unboxn
  (implies (and (equal (expr-kind expr) :unboxn)
                (not (zp limit)))
           (equal (eval-expr expr denv limit)
                  (b* (((ok targetval) (eval-expr (expr-unboxn->target expr)
                                                  denv (1- limit)))
                       (type? (expr-unboxn->type? expr))
                       ((ok tval) (type-option-case
                                   type?
                                   :some (eval-type type?.val
                                                    (expr-denv->tenv denv))
                                   :none (reserr nil))))
                    (eval-unbox targetval
                                (expr-unboxn->ispaces expr)
                                (expr-unboxn->var expr)
                                (expr-unboxn->body expr)
                                tval
                                denv
                                (1- limit)))))
  :expand ((eval-expr expr denv limit)))

;; The relations at an unboxing expression, decomposed.

(defruled expr-alpha-related-p-when-unbox
  (implies (and (equal (expr-kind expr) :unbox)
                (expr-alpha-related-p new-expr expr r))
           (b* ((ispaces (list (expr-unbox->ispace expr)))
                (new-ispaces (list (expr-unbox->ispace new-expr)))
                ((mv okp dim-renam shape-renam)
                 (ispace-var-list-alpha-extend new-ispaces ispaces
                                               (var-renamings->dim r)
                                               (var-renamings->shape r)))
                (body-r (change-var-renamings
                         r
                         :dim dim-renam
                         :shape shape-renam
                         :expr (extend-renaming (expr-unbox->var expr)
                                                (expr-unbox->var new-expr)
                                                (var-renamings->expr r)))))
             (and (equal (expr-kind new-expr) :unbox)
                  okp
                  (expr-alpha-related-p (expr-unbox->target new-expr)
                                        (expr-unbox->target expr) r)
                  (equal (expr-unbox->type? new-expr)
                         (type-option-rename-all-vars (expr-unbox->type? expr) r))
                  (expr-alpha-related-p (expr-unbox->body new-expr)
                                        (expr-unbox->body expr)
                                        body-r))))
  :expand ((expr-alpha-related-p new-expr expr r)))

(defruled expr-alpha-fresh-p-when-unbox
  (implies (and (equal (expr-kind expr) :unbox)
                (expr-alpha-related-p new-expr expr r)
                (expr-alpha-fresh-p new-expr expr r b))
           (b* ((ispaces (list (expr-unbox->ispace expr)))
                (new-ispaces (list (expr-unbox->ispace new-expr)))
                ((mv & dim-renam shape-renam)
                 (ispace-var-list-alpha-extend new-ispaces ispaces
                                               (var-renamings->dim r)
                                               (var-renamings->shape r)))
                (body-r (change-var-renamings
                         r
                         :dim dim-renam
                         :shape shape-renam
                         :expr (extend-renaming (expr-unbox->var expr)
                                                (expr-unbox->var new-expr)
                                                (var-renamings->expr r)))))
             (and (expr-alpha-fresh-p (expr-unbox->target new-expr)
                                      (expr-unbox->target expr) r b)
                  (type-option-fresh-ok (expr-unbox->type? expr) r)
                  (ispace-var-list-fresh-ok new-ispaces ispaces
                                            (var-renamings->dim r)
                                            (var-renamings->shape r)
                                            b)
                  (name-fresh-ok (expr-unbox->var expr) (expr-unbox->var new-expr)
                                 (var-renamings->expr r)
                                 (set::insert (ispace-var->name
                                               (expr-unbox->ispace new-expr))
                                              (string-sfix b)))
                  (set::emptyp
                   (set::intersect
                    (set::mergesort (ispace-var-list-fix new-ispaces))
                    (ispace-var-set-rename-ispace-vars
                     (set::difference (expr-free-ispace-vars (expr-unbox->body expr))
                                      (set::mergesort (ispace-var-list-fix ispaces)))
                     (var-renamings->dim r)
                     (var-renamings->shape r))))
                  (not (set::in (expr-unbox->var new-expr)
                                (rename-var-string-set
                                 (set::delete (expr-unbox->var expr)
                                              (expr-free-expr-vars
                                               (expr-unbox->body expr)))
                                 (var-renamings->expr r))))
                  (expr-alpha-fresh-p (expr-unbox->body new-expr)
                                      (expr-unbox->body expr)
                                      body-r
                                      (set::insert
                                       (expr-unbox->var new-expr)
                                       (set::insert (ispace-var->name
                                                     (expr-unbox->ispace new-expr))
                                                    (string-sfix b)))))))
  :expand ((expr-alpha-fresh-p new-expr expr r b))
  :enable (mergesort-of-cons
           set::difference-insert-y
           difference-of-nil-right
           emptyp-intersect-singleton)
  :use expr-alpha-related-p-when-unbox)

(defruled expr-alpha-related-p-when-unboxn
  (implies (and (equal (expr-kind expr) :unboxn)
                (expr-alpha-related-p new-expr expr r))
           (b* ((ispaces (expr-unboxn->ispaces expr))
                (new-ispaces (expr-unboxn->ispaces new-expr))
                ((mv okp dim-renam shape-renam)
                 (ispace-var-list-alpha-extend new-ispaces ispaces
                                               (var-renamings->dim r)
                                               (var-renamings->shape r)))
                (body-r (change-var-renamings
                         r
                         :dim dim-renam
                         :shape shape-renam
                         :expr (extend-renaming (expr-unboxn->var expr)
                                                (expr-unboxn->var new-expr)
                                                (var-renamings->expr r)))))
             (and (equal (expr-kind new-expr) :unboxn)
                  okp
                  (expr-alpha-related-p (expr-unboxn->target new-expr)
                                        (expr-unboxn->target expr) r)
                  (equal (expr-unboxn->type? new-expr)
