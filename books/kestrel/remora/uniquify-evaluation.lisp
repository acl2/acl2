           (and (consp (type-list-rename-all-vars l r))
                (equal (car (type-list-rename-all-vars l r))
                       (type-rename-all-vars (car l) r))
                (equal (cdr (type-list-rename-all-vars l r))
                       (type-list-rename-all-vars (cdr l) r))))
  :use ((:instance type-list-rename-all-vars-of-cons (a (car l)) (l (cdr l)))))

