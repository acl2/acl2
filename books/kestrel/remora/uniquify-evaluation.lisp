                             (cells-at-depth-in-expr-value arg 1))))
                   (ws (cdr (expr-value-list-alpha-equiv-p-witness
                             (cells-at-depth-in-expr-value new-arg 1)
                             (cells-at-depth-in-expr-value arg 1))))
                   (fw fw))))

(defruled prim-reduce-ok-cases
  (implies (implies (and (equal (dims-of-expr-value arg)
                                (cons (1+ (nfix d)) (nat-list-fix s)))
                         (not (reserrp (cells-at-depth-in-expr-value arg 1)))
                         (consp (cells-at-depth-in-expr-value arg 1)))
                    (prim-reduce/fold-loop-ok
                     (car (cells-at-depth-in-expr-value arg 1))
                     (cdr (cells-at-depth-in-expr-value arg 1))
                     fval
                     (1- limit)))
           (prim-reduce-ok tval d s fval arg limit))
  :expand ((prim-reduce-ok tval d s fval arg limit))
  :cases ((zp limit))
  :enable prim-reduce-when-zp-limit
  :use ((:instance prim-reduce-ok-aux
                   (new-tval (mv-nth 0 (prim-reduce-ok-witness tval d s fval arg limit)))
                   (new-fval (mv-nth 1 (prim-reduce-ok-witness tval d s fval arg limit)))
                   (new-arg (mv-nth 2 (prim-reduce-ok-witness tval d s fval arg limit)))
                   (fw (mv-nth 4 (prim-reduce-ok-witness tval d s fval arg limit)))
                   (aw (mv-nth 5 (prim-reduce-ok-witness tval d s fval arg limit))))))

; The last stage of fold (PRIM-FOLD): as for reduce, with the initial
; value's dimension check and the loop starting from the initial value.

(defruled prim-fold-when-zp-limit
  (implies (zp limit)
           (equal (prim-fold tval t2val d s s2 fval zval arg limit) (reserr :limit)))
  :expand ((prim-fold tval t2val d s s2 fval zval arg limit)))

(defruled prim-fold-when-not-zp-limit
  (implies (not (zp limit))
           (equal (prim-fold tval t2val d s s2 fval zval arg limit)
                  (b* (((unless (equal (dims-of-expr-value arg)
                                       (cons (1+ (nfix d)) (nat-list-fix s))))
                        (reserr nil))
                       ((unless (equal (dims-of-expr-value zval) (nat-list-fix s2)))
                        (reserr nil))
                       ((ok cells) (cells-at-depth-in-expr-value arg 1)))
                    (prim-reduce/fold-loop zval cells fval (1- limit)))))
  :expand ((prim-fold tval t2val d s s2 fval zval arg limit)))

(defruled prim-fold-ok-aux
  (implies (and (not (zp limit))
                (implies (and (equal (dims-of-expr-value arg)
                                     (cons (1+ (nfix d)) (nat-list-fix s)))
                              (equal (dims-of-expr-value zval) (nat-list-fix s2))
                              (not (reserrp (cells-at-depth-in-expr-value arg 1))))
                         (prim-reduce/fold-loop-ok
                          zval
                          (cells-at-depth-in-expr-value arg 1)
                          fval
                          (1- limit)))
                (expr-value-alpha-related-via-p new-fval fval fw)
                (expr-value-alpha-related-via-p new-zval zval zw)
                (expr-value-alpha-related-via-p new-arg arg aw)
                (expr-value-wfp fval)
                (expr-value-wfp new-fval)
                (expr-value-wfp zval)
                (expr-value-wfp new-zval)
                (expr-value-wfp arg)
                (expr-value-wfp new-arg))
           (b* ((val (prim-fold tval t2val d s s2 fval zval arg limit))
                (new-val (prim-fold new-tval new-t2val d s s2
                                    new-fval new-zval new-arg limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :enable (prim-fold-when-not-zp-limit
           dims-of-expr-value-when-expr-value-alpha-related-via-p-safe
           expr-value-list-wfp-of-cells-at-depth-in-expr-value
           expr-value-listp-when-result-not-error)
  :use ((:instance cells-at-depth-in-expr-value-alpha
                   (new-val new-arg) (val arg) (w aw) (depth 1))
        (:instance expr-value-list-alpha-equiv-p
                   (new-vals (cells-at-depth-in-expr-value new-arg 1))
                   (vals (cells-at-depth-in-expr-value arg 1)))
        (:instance prim-reduce/fold-loop-ok-necc
                   (acc zval)
                   (cells (cells-at-depth-in-expr-value arg 1))
                   (fval fval)
                   (limit (1- limit))
                   (new-acc new-zval)
                   (new-cells (cells-at-depth-in-expr-value new-arg 1))
                   (new-fval new-fval)
                   (aw zw)
                   (ws (expr-value-list-alpha-equiv-p-witness
                        (cells-at-depth-in-expr-value new-arg 1)
                        (cells-at-depth-in-expr-value arg 1)))
                   (fw fw))))

(defruled prim-fold-ok-cases
  (implies (implies (and (equal (dims-of-expr-value arg)
                                (cons (1+ (nfix d)) (nat-list-fix s)))
                         (equal (dims-of-expr-value zval) (nat-list-fix s2))
                         (not (reserrp (cells-at-depth-in-expr-value arg 1))))
