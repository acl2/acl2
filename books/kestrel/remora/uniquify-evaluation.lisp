                   :param (atom-tlambda->param atom)
                   :body (atom-tlambda->body atom)
                   :denv (expr-denv-restrict
                          (expr-free-ispace-vars (atom-tlambda->body atom))
                          (atom-free-type-vars atom)
                          (expr-free-expr-vars (atom-tlambda->body atom))
                          denv))))
  :expand ((eval-atom atom denv limit)))

(defruled tlambda-closure-denv-alpha
  (implies (and (equal (atom-kind atom) :tlambda)
