; Renaming the free variables of a body under the extension of a single
; type (ispace) parameter, minus the new parameter, is renaming them minus
; the old parameter under the unextended maps; the single-parameter forms
; of the per-kind lemmas of the relations book.

(defruled delete-of-type-var-set-rename-type-vars-of-alpha-extend-1
  (implies (and (type-var-setp s)
                (type-varp p)
                (type-varp new-p)
                (mv-nth 0 (type-var-list-alpha-extend (list new-p) (list p)
                                                      atom-m array-m))
                (not (set::in new-p (type-var-set-rename-type-vars
                                     (set::delete p s) atom-m array-m))))
           (equal (set::delete
                   new-p
                   (type-var-set-rename-type-vars
                    s
                    (mv-nth 1 (type-var-list-alpha-extend (list new-p) (list p)
                                                          atom-m array-m))
                    (mv-nth 2 (type-var-list-alpha-extend (list new-p) (list p)
                                                          atom-m array-m))))
                  (type-var-set-rename-type-vars (set::delete p s)
                                                 atom-m array-m)))
  :enable (type-var-list-alpha-extend
           type-var-list-alpha-extend-of-nil)
  :use ((:instance delete-of-type-var-set-rename-type-vars-of-atom-extend
                   (n (type-var-atom->name p))
                   (n2 (type-var-atom->name new-p)))
        (:instance delete-of-type-var-set-rename-type-vars-of-array-extend
                   (n (type-var-array->name p))
                   (n2 (type-var-array->name new-p)))
        (:instance type-var-fix-when-atom (x p))
        (:instance type-var-fix-when-atom (x new-p))
        (:instance type-var-fix-when-array (x p))
        (:instance type-var-fix-when-array (x new-p))))

