; Ispace binds: the bound ispace evaluates to the same (ground) ispace
; value on both sides, and the environments are extended by the bound
; variable at the ispace layer, in the dimension or the shape namespace.

(defruled eval-bind-when-ispace
  (implies (and (equal (bind-kind bind) :ispace)
                (not (zp limit)))
           (equal (eval-bind bind denv limit)
                  (b* (((ok ival) (eval-ispace (bind-ispace->ispace bind)
                                               (type-denv->ienv
                                                (expr-denv->tenv denv)))))
                    (expr-denv-add-ispace (bind-ispace->var bind) ival denv))))
  :expand ((eval-bind bind denv limit)))

; The new bind's ispace evaluates, in the new environment, to the value of
; the original bind's ispace in the original environment.

(defruled eval-ispace-alpha-when-equal
  (implies (and (equal new-ispace
                       (ispace-rename-ispace-vars ispace dim-renam shape-renam))
                (denv-ispace-vars-covered-p new-denv denv dim-renam shape-renam)
                (denv-ispace-vars-avoided-p new-denv denv dim-renam shape-renam
                                            (ispace-free-ispace-vars ispace)))
           (equal (eval-ispace new-ispace new-denv)
                  (eval-ispace ispace denv)))
  :use eval-ispace-alpha)

(defruled eval-bind-new-when-ispace
  (implies (and (equal (bind-kind bind) :ispace)
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           tvars evars))
           (equal (eval-bind new-bind new-denv limit)
                  (b* (((ok ival) (eval-ispace (bind-ispace->ispace bind)
                                               (type-denv->ienv
                                                (expr-denv->tenv denv)))))
                    (expr-denv-add-ispace (bind-ispace->var new-bind)
                                          ival new-denv))))
  :expand ((bind-alpha-related-p new-bind bind r)
           (bind-free-ispace-vars bind)
           (expr-denv-alpha-related-via-p new-denv denv r dw)
           (type-denv-alpha-related-via-p (expr-denv->tenv new-denv)
                                          (expr-denv->tenv denv)
                                          r (denv-witness->types dw))
           (:free (i tv e) (expr-denv-alpha-avoided-p new-denv denv r i tv e))
           (:free (i tv) (type-denv-alpha-avoided-p (expr-denv->tenv new-denv)
                                                    (expr-denv->tenv denv)
                                                    r i tv)))
  :enable eval-bind-when-ispace
  :use ((:instance eval-ispace-alpha-when-equal
                   (new-ispace (bind-ispace->ispace new-bind))
                   (ispace (bind-ispace->ispace bind))
                   (denv (type-denv->ienv (expr-denv->tenv denv)))
                   (new-denv (type-denv->ienv (expr-denv->tenv new-denv)))
                   (dim-renam (var-renamings->dim r))
                   (shape-renam (var-renamings->shape r)))))

(defruled eval-bind-ok-when-ispace-equiv-dim-aux
  (implies (and (equal (bind-kind bind) :ispace)
                (ispace-var-case (bind-ispace->var bind) :dim)
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit))
                (new-result (eval-bind new-bind new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (expr-denv-alpha-equiv-p new-result result new-r)))))
  :expand ((bind-alpha-related-p new-bind bind r)
           (bind-alpha-fresh-p new-bind bind r b)
           (bind-alpha-extended-renamings new-bind bind r)
           (bind-name bind)
           (bind-name new-bind)
           (expr-denv-keys-supported-p denv r b))
  :enable (eval-bind-when-ispace
           ispace-var->name
           not-reserrp-when-expr-denvp)
  :use ((:instance eval-bind-new-when-ispace
                   (tvars (bind-free-type-vars bind))
                   (evars (bind-free-expr-vars bind)))
        (:instance not-in-dim-image-of-keys-when-name-fresh-ok-and-supported
                   (name (ispace-var-dim->name (bind-ispace->var bind)))
                   (new-name (ispace-var-dim->name (bind-ispace->var new-bind)))
                   (dim-renam (var-renamings->dim r))
                   (shape-renam (var-renamings->shape r))
                   (keys (omap::keys (ispace-denv->ispaces
                                      (type-denv->ienv (expr-denv->tenv denv))))))
        (:instance expr-denv-alpha-related-via-p-of-add-ispace-dim
                   (var (bind-ispace->var bind))
                   (new-var (bind-ispace->var new-bind))
                   (ival (eval-ispace (bind-ispace->ispace bind)
                                      (type-denv->ienv (expr-denv->tenv denv)))))
        (:instance expr-denv-alpha-equiv-p-suff
                   (new-denv (eval-bind new-bind new-denv limit))
                   (denv (eval-bind bind denv limit))
                   (r (bind-alpha-extended-renamings new-bind bind r))
                   (dw dw)))
  :disable (not-in-type-var-set-when-name-not-in-names
            not-in-ispace-var-set-when-name-not-in-names
            not-in-type-var-set-rename-type-vars-when-fresh
            not-in-ispace-var-set-rename-ispace-vars-when-fresh
            in-of-type-var-set-names
            in-of-ispace-var-set-names
            set::delete-in
            set::in-tail
            in-names-when-in-rename-var-string-set-and-not-value
            set::never-in-empty
            set::delete-nonmember-cancel))

(defruled eval-bind-ok-when-ispace-equiv-shape-aux
  (implies (and (equal (bind-kind bind) :ispace)
                (ispace-var-case (bind-ispace->var bind) :shape)
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
