; The left fold of the combining function over the cells
; (PRIM-REDUCE/FOLD-LOOP): two cell-wise applications per step,
; the second one via the equivalence witness of the first result.

(defruled prim-reduce/fold-loop-when-zp-limit
  (implies (zp limit)
           (equal (prim-reduce/fold-loop acc cells fval limit) (reserr :limit)))
  :expand ((prim-reduce/fold-loop acc cells fval limit)))

(defruled prim-reduce/fold-loop-when-endp
  (implies (and (not (zp limit))
                (not (consp cells)))
           (equal (prim-reduce/fold-loop acc cells fval limit)
                  (expr-value-fix acc)))
  :expand ((prim-reduce/fold-loop acc cells fval limit)))

(defruled prim-reduce/fold-loop-when-consp
  (implies (and (not (zp limit))
                (consp cells))
           (equal (prim-reduce/fold-loop acc cells fval limit)
                  (b* (((ok fval1) (eval-app-cell fval acc (1- limit)))
                       ((ok acc1) (eval-app-cell fval1 (car cells) (1- limit))))
                    (prim-reduce/fold-loop acc1 (cdr cells) fval (1- limit)))))
  :expand ((prim-reduce/fold-loop acc cells fval limit)))

(defruled cdr-when-expr-value-list-alpha-related-via-p
  (implies (and (expr-value-list-alpha-related-via-p new-vals vals ws)
                (consp vals))
           (expr-value-list-alpha-related-via-p (cdr new-vals) (cdr vals) (cdr ws)))
  :expand ((expr-value-list-alpha-related-via-p new-vals vals ws)))

(defruled prim-reduce/fold-loop-ok-when-zp-limit
  (implies (zp limit)
           (prim-reduce/fold-loop-ok acc cells fval limit))
  :expand ((prim-reduce/fold-loop-ok acc cells fval limit))
  :enable prim-reduce/fold-loop-when-zp-limit)

(defruled prim-reduce/fold-loop-ok-when-endp-aux
  (implies (and (not (zp limit))
                (not (consp cells))
                (expr-value-alpha-related-via-p new-acc acc aw)
                (expr-value-list-alpha-related-via-p new-cells cells ws))
           (b* ((val (prim-reduce/fold-loop acc cells fval limit))
                (new-val (prim-reduce/fold-loop new-acc new-cells new-fval limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :enable (prim-reduce/fold-loop-when-endp
           consp-when-expr-value-list-alpha-related-via-p-safe
           not-reserrp-when-expr-valuep)
  :use ((:instance expr-value-alpha-equiv-p-suff
                   (new-val (expr-value-fix new-acc))
                   (val (expr-value-fix acc))
                   (w aw))))

(defruled prim-reduce/fold-loop-ok-when-endp
  (implies (not (consp cells))
           (prim-reduce/fold-loop-ok acc cells fval limit))
  :expand ((prim-reduce/fold-loop-ok acc cells fval limit))
  :cases ((zp limit))
  :enable prim-reduce/fold-loop-when-zp-limit
  :use ((:instance prim-reduce/fold-loop-ok-when-endp-aux
                   (new-acc (mv-nth 0 (prim-reduce/fold-loop-ok-witness acc cells fval limit)))
                   (new-cells (mv-nth 1 (prim-reduce/fold-loop-ok-witness acc cells fval limit)))
                   (new-fval (mv-nth 2 (prim-reduce/fold-loop-ok-witness acc cells fval limit)))
                   (aw (mv-nth 3 (prim-reduce/fold-loop-ok-witness acc cells fval limit)))
                   (ws (mv-nth 4 (prim-reduce/fold-loop-ok-witness acc cells fval limit))))))

(defruled prim-reduce/fold-loop-ok-when-consp-aux
  (implies (and (not (zp limit))
                (consp cells)
                (eval-app-cell-ok fval acc (1- limit))
                (implies (not (reserrp (eval-app-cell fval acc (1- limit))))
                         (eval-app-cell-ok (eval-app-cell fval acc (1- limit))
                                           (car cells)
                                           (1- limit)))
                (implies (and (not (reserrp (eval-app-cell fval acc (1- limit))))
                              (not (reserrp
                                    (eval-app-cell (eval-app-cell fval acc (1- limit))
                                                   (car cells)
                                                   (1- limit)))))
                         (prim-reduce/fold-loop-ok
                          (eval-app-cell (eval-app-cell fval acc (1- limit))
                                         (car cells)
                                         (1- limit))
                          (cdr cells)
                          fval
                          (1- limit)))
                (expr-value-alpha-related-via-p new-acc acc aw)
                (expr-value-list-alpha-related-via-p new-cells cells ws)
                (expr-value-alpha-related-via-p new-fval fval fw)
                (expr-value-wfp acc)
                (expr-value-wfp new-acc)
                (expr-value-list-wfp cells)
                (expr-value-list-wfp new-cells)
                (expr-value-wfp fval)
                (expr-value-wfp new-fval))
           (b* ((val (prim-reduce/fold-loop acc cells fval limit))
                (new-val (prim-reduce/fold-loop new-acc new-cells new-fval limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((len cells))
  :enable (prim-reduce/fold-loop-when-consp
           consp-when-expr-value-list-alpha-related-via-p-safe
           expr-value-list-wfp
           expr-valuep-when-result-not-error)
  :use ((:instance eval-app-cell-ok-necc
                   (funcell fval)
                   (argcell acc)
                   (limit (1- limit))
                   (new-funcell new-fval)
                   (new-argcell new-acc)
                   (w fw)
                   (aw aw))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-app-cell new-fval new-acc (1- limit)))
                   (val (eval-app-cell fval acc (1- limit))))
        (:instance car-when-expr-value-list-alpha-related-via-p
                   (new-vals new-cells) (vals cells) (ws ws))
        (:instance cdr-when-expr-value-list-alpha-related-via-p
