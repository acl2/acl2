           type-var-map-avoided-p-monotone
           string-expr-value-map-avoided-p-monotone
           type-fresh-ok
           expr-value-wfp-of-eval-expr
           expr-value-list-wfp-of-eval-expr-list
           not-reserrp-when-expr-valuep
           not-reserrp-when-expr-value-listp
           expr-valuep-when-result-not-error
           expr-value-listp-when-result-not-error
           expr-denv-wfp-of-eval-bind-list)
  :use ((:instance eval-bind-list-ok-necc
                   (binds (expr-let->binds expr)) (limit (1- limit))
                   (new-binds (expr-let->binds (mv-nth 0 (eval-expr-ok-witness expr denv limit)))) (new-denv (mv-nth 1 (eval-expr-ok-witness expr denv limit))) (r (mv-nth 2 (eval-expr-ok-witness expr denv limit))) (dw (mv-nth 3 (eval-expr-ok-witness expr denv limit))) (b (mv-nth 4 (eval-expr-ok-witness expr denv limit)))
                   (evars (expr-free-expr-vars (expr-let->body expr)))
                   (tvars (expr-free-type-vars (expr-let->body expr)))
                   (ivars (expr-free-ispace-vars (expr-let->body expr))))
        (:instance expr-denv-alpha-equiv-p (new-denv (eval-bind-list (expr-let->binds (mv-nth 0 (eval-expr-ok-witness expr denv limit))) (mv-nth 1 (eval-expr-ok-witness expr denv limit)) (1- limit))) (denv (eval-bind-list (expr-let->binds expr) denv (1- limit))) (r (bind-list-alpha-extended-renamings (expr-let->binds (mv-nth 0 (eval-expr-ok-witness expr denv limit))) (expr-let->binds expr) (mv-nth 2 (eval-expr-ok-witness expr denv limit)))))
        (:instance eval-expr-ok-necc
                   (expr (expr-let->body expr)) (denv (eval-bind-list (expr-let->binds expr) denv (1- limit))) (limit (1- limit))
