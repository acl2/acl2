                                       (1- limit)))
                   (cells (cdr cells))
                   (fval fval)
                   (limit (1- limit))
                   (new-acc (eval-app-cell (eval-app-cell new-fval new-acc (1- limit))
                                           (car new-cells)
                                           (1- limit)))
                   (new-cells (cdr new-cells))
                   (new-fval new-fval)
                   (aw (expr-value-alpha-equiv-p-witness
                        (eval-app-cell (eval-app-cell new-fval new-acc (1- limit))
                                       (car new-cells)
                                       (1- limit))
                        (eval-app-cell (eval-app-cell fval acc (1- limit))
