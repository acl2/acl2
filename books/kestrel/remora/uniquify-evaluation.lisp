                (new-val (eval-atom new-atom new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((atom-alpha-related-p new-atom atom r)
           (atom-alpha-fresh-p new-atom atom r b)
           (atom-free-ispace-vars atom)
           (:free (new-val w param body cdenv)
            (expr-value-alpha-related-via-p
             new-val (expr-value-ilambda param body cdenv) w)))
  :enable (eval-atom-when-ilambda
           atom-free-ispace-vars
           delete-of-ispace-var-set-rename-ispace-vars-of-alpha-extend-1
           not-reserrp-when-expr-valuep)
  :use (ilambda-closure-denv-alpha
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (eval-atom new-atom new-denv limit))
                   (val (eval-atom atom denv limit))
                   (w (expr-value-witness-closure
                       r '(:leaf) '(:leaf) dw
                       (expr-body-support-names
                        (atom-ilambda->body atom)
                        (change-var-renamings
                         r
                         :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                          (list (atom-ilambda->param new-atom))
                                          (list (atom-ilambda->param atom))
                                          (var-renamings->dim r)
                                          (var-renamings->shape r)))
                         :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                           (list (atom-ilambda->param new-atom))
                                           (list (atom-ilambda->param atom))
                                           (var-renamings->dim r)
                                           (var-renamings->shape r))))))))))

(defruled eval-atom-ok-when-ilambda
  (implies (equal (atom-kind atom) :ilambda)
           (eval-atom-ok atom denv limit))
  :expand ((eval-atom-ok atom denv limit)
           (:free (new-x r) (atom-alpha-related-p new-x atom r)))
  :cases ((zp limit))
  :enable eval-atom-when-zp-limit
  :use ((:instance eval-atom-ok-when-ilambda-aux
                   (new-atom (mv-nth 0 (eval-atom-ok-witness atom denv limit)))
                   (new-denv (mv-nth 1 (eval-atom-ok-witness atom denv limit)))
                   (r (mv-nth 2 (eval-atom-ok-witness atom denv limit)))
                   (dw (mv-nth 3 (eval-atom-ok-witness atom denv limit)))
                   (b (mv-nth 4 (eval-atom-ok-witness atom denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The evaluations of an ispace (list) and of an optional type under related
; environments, given the failure-direction relation at a superset of their
; free variables: the ispaces evaluate to the same values, and the types err
; together and otherwise evaluate to related type values.

(defruled eval-ispace-alpha-of-expr-denvs
  (implies (and (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r ivars tvars evars)
                (set::subset (ispace-free-ispace-vars ispace)
                             (ispace-var-set-fix ivars)))
           (equal (eval-ispace (ispace-rename-ispace-vars ispace
                                                          (var-renamings->dim r)
                                                          (var-renamings->shape r))
                               (type-denv->ienv (expr-denv->tenv new-denv)))
                  (eval-ispace ispace (type-denv->ienv (expr-denv->tenv denv)))))
  :expand ((expr-denv-alpha-related-via-p new-denv denv r dw)
           (expr-denv-alpha-avoided-p new-denv denv r ivars tvars evars)
           (:free (i tv) (type-denv-alpha-avoided-p (expr-denv->tenv new-denv)
                                                    (expr-denv->tenv denv) r i tv)))
  :enable (type-denv-alpha-related-via-p
           denv-ispace-vars-avoided-p-monotone)
  :use ((:instance eval-ispace-alpha
                   (denv (type-denv->ienv (expr-denv->tenv denv)))
                   (new-denv (type-denv->ienv (expr-denv->tenv new-denv)))
                   (dim-renam (var-renamings->dim r))
                   (shape-renam (var-renamings->shape r)))))

(defruled eval-ispace-list-alpha-of-expr-denvs
  (implies (and (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r ivars tvars evars)
                (set::subset (ispace-list-free-ispace-vars ispaces)
                             (ispace-var-set-fix ivars)))
           (equal (eval-ispace-list (ispace-list-rename-ispace-vars
                                     ispaces
                                     (var-renamings->dim r)
                                     (var-renamings->shape r))
                                    (type-denv->ienv (expr-denv->tenv new-denv)))
                  (eval-ispace-list ispaces
                                    (type-denv->ienv (expr-denv->tenv denv)))))
  :expand ((expr-denv-alpha-related-via-p new-denv denv r dw)
           (expr-denv-alpha-avoided-p new-denv denv r ivars tvars evars)
           (:free (i tv) (type-denv-alpha-avoided-p (expr-denv->tenv new-denv)
                                                    (expr-denv->tenv denv) r i tv)))
  :enable (type-denv-alpha-related-via-p
           denv-ispace-vars-avoided-p-monotone)
  :use ((:instance eval-ispace-list-alpha
                   (denv (type-denv->ienv (expr-denv->tenv denv)))
                   (new-denv (type-denv->ienv (expr-denv->tenv new-denv)))
                   (dim-renam (var-renamings->dim r))
                   (shape-renam (var-renamings->shape r)))))

(defruled eval-type-option-alpha-of-expr-denvs
  (implies (and (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r ivars tvars evars)
                (set::subset (type-option-free-ispace-vars type?) (ispace-var-set-fix ivars))
                (set::subset (type-option-free-type-vars type?) (type-var-set-fix tvars))
                (type-option-fresh-ok type? r)
                (type-option-case type? :some))
           (b* ((tval (eval-type (type-option-some->val type?) (expr-denv->tenv denv)))
                (new-tval (eval-type (type-rename-all-vars (type-option-some->val type?) r)
                                     (expr-denv->tenv new-denv))))
             (and (equal (reserrp new-tval) (reserrp tval))
                  (implies (not (reserrp tval))
                           (type-value-alpha-related-via-p
                            new-tval tval
                            (eval-type-witness (type-option-some->val type?)
                                               r (denv-witness->types dw)))))))
  :expand ((expr-denv-alpha-related-via-p new-denv denv r dw)
           (expr-denv-alpha-avoided-p new-denv denv r ivars tvars evars)
           (:free (i tv) (type-denv-alpha-avoided-p (expr-denv->tenv new-denv)
                                                    (expr-denv->tenv denv) r i tv)))
  :enable (type-option-fresh-ok
           type-fresh-ok
           type-option-free-ispace-vars
           type-option-free-type-vars
           denv-ispace-vars-avoided-p-monotone
           type-var-map-avoided-p-monotone)
  :use ((:instance eval-type-alpha
                   (type (type-option-some->val type?))
                   (denv (expr-denv->tenv denv))
                   (new-denv (expr-denv->tenv new-denv))
                   (wmap (denv-witness->types dw)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Atoms: unary box.  The ispace evaluates to equal values (EVAL-ISPACE-ALPHA),
; the array to related values (the induction hypothesis), and the sum type
; to related type values (EVAL-TYPE-ALPHA); the box witness pairs the
; latter two witnesses.

(defruled eval-atom-when-box
  (implies (and (equal (atom-kind atom) :box)
                (not (zp limit)))
           (equal (eval-atom atom denv limit)
                  (b* (((ok ival) (eval-ispace (atom-box->ispace atom)
                                               (type-denv->ienv
                                                (expr-denv->tenv denv))))
                       ((ok arrayval) (eval-expr (atom-box->array atom)
                                                 denv (1- limit)))
                       (type? (atom-box->type? atom))
                       ((ok tval) (type-option-case
                                   type?
                                   :some (eval-type type?.val
                                                    (expr-denv->tenv denv))
                                   :none (reserr nil))))
                    (make-expr-value-box :ispace ival
                                         :array arrayval
                                         :type tval))))
  :expand ((eval-atom atom denv limit)))

; Decomposition of the relations at a box atom.

(defruled atom-alpha-related-p-when-box
  (implies (and (equal (atom-kind atom) :box)
                (atom-alpha-related-p new-atom atom r))
           (and (equal (atom-kind new-atom) :box)
                (equal (atom-box->ispace new-atom)
                       (ispace-rename-ispace-vars (atom-box->ispace atom)
                                                  (var-renamings->dim r)
                                                  (var-renamings->shape r)))
                (expr-alpha-related-p (atom-box->array new-atom)
                                      (atom-box->array atom)
                                      r)
                (equal (atom-box->type? new-atom)
                       (type-option-rename-all-vars (atom-box->type? atom) r))))
  :expand ((atom-alpha-related-p new-atom atom r)))

(defruled atom-alpha-fresh-p-when-box
  (implies (and (equal (atom-kind atom) :box)
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b))
           (and (expr-alpha-fresh-p (atom-box->array new-atom)
                                    (atom-box->array atom)
                                    r b)
                (type-option-fresh-ok (atom-box->type? atom) r)))
  :expand ((atom-alpha-fresh-p new-atom atom r b))
  :use atom-alpha-related-p-when-box)

; Boxes of the same ispace value with related arrays and types are
; alpha-equivalent, via the box witness.

(defruled expr-value-alpha-equiv-p-of-expr-value-box
  (implies (and (expr-value-alpha-related-via-p new-arr arr aw)
                (type-value-alpha-related-via-p new-tval tval tw))
           (expr-value-alpha-equiv-p (expr-value-box ival new-arr new-tval)
                                     (expr-value-box ival arr tval)))
  :expand ((expr-value-alpha-related-via-p (expr-value-box ival new-arr new-tval)
                                           (expr-value-box ival arr tval)
                                           (expr-value-witness-box tw aw)))
  :use ((:instance expr-value-alpha-equiv-p-suff
                   (new-val (expr-value-box ival new-arr new-tval))
                   (val (expr-value-box ival arr tval))
                   (w (expr-value-witness-box tw aw)))))

(defruled eval-atom-ok-when-box-aux
  (implies (and (equal (atom-kind atom) :box)
                (not (zp limit))
                (implies (not (reserrp (eval-ispace (atom-box->ispace atom)
                                                    (type-denv->ienv
                                                     (expr-denv->tenv denv)))))
                         (eval-expr-ok (atom-box->array atom) denv (1- limit)))
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-free-ispace-vars atom)
                                           (atom-free-type-vars atom)
                                           (atom-free-expr-vars atom))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((val (eval-atom atom denv limit))
                (new-val (eval-atom new-atom new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((atom-free-ispace-vars atom)
           (atom-free-type-vars atom)
           (atom-free-expr-vars atom))
  :enable (eval-atom-when-box
           type-option-rename-all-vars
           type-option-rename-ispace-vars
           type-option-rename-type-vars
           type-rename-all-vars
           type-option-some->val-when-typep
           not-reserrp-when-expr-valuep
           expr-valuep-when-result-not-error
           type-valuep-when-result-not-error
           subset-of-union-right-1
           subset-of-union-right-2
           set::union-subset-x
           expr-value-alpha-equiv-p-of-expr-value-box)
  :use (atom-alpha-related-p-when-box
        atom-alpha-fresh-p-when-box
        (:instance eval-ispace-alpha-of-expr-denvs
                   (ispace (atom-box->ispace atom))
                   (ivars (atom-free-ispace-vars atom))
                   (tvars (atom-free-type-vars atom))
                   (evars (atom-free-expr-vars atom)))
        (:instance eval-type-option-alpha-of-expr-denvs
                   (type? (atom-box->type? atom))
                   (ivars (atom-free-ispace-vars atom))
                   (tvars (atom-free-type-vars atom))
                   (evars (atom-free-expr-vars atom)))
        (:instance eval-expr-ok-necc
                   (expr (atom-box->array atom))
                   (new-expr (atom-box->array new-atom))
                   (limit (1- limit)))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-expr (atom-box->array new-atom) new-denv (1- limit)))
                   (val (eval-expr (atom-box->array atom) denv (1- limit))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (atom-free-ispace-vars atom))
                   (tvars2 (atom-free-type-vars atom))
                   (evars2 (atom-free-expr-vars atom))
                   (ivars1 (expr-free-ispace-vars (atom-box->array atom)))
                   (tvars1 (expr-free-type-vars (atom-box->array atom)))
                   (evars1 (expr-free-expr-vars (atom-box->array atom))))))

(defruled eval-atom-ok-when-box
  (implies (and (equal (atom-kind atom) :box)
                (implies (not (reserrp (eval-ispace (atom-box->ispace atom)
                                                    (type-denv->ienv
                                                     (expr-denv->tenv denv)))))
                         (eval-expr-ok (atom-box->array atom) denv (1- limit))))
           (eval-atom-ok atom denv limit))
  :expand ((eval-atom-ok atom denv limit)
           (:free (new-x r) (atom-alpha-related-p new-x atom r)))
  :cases ((zp limit))
  :enable eval-atom-when-zp-limit
  :use ((:instance eval-atom-ok-when-box-aux
                   (new-atom (mv-nth 0 (eval-atom-ok-witness atom denv limit)))
                   (new-denv (mv-nth 1 (eval-atom-ok-witness atom denv limit)))
                   (r (mv-nth 2 (eval-atom-ok-witness atom denv limit)))
                   (dw (mv-nth 3 (eval-atom-ok-witness atom denv limit)))
                   (b (mv-nth 4 (eval-atom-ok-witness atom denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; n-ary type lambdas: the curried body.  Its free variables, and the
; relation and freshness of a pair of curried bodies under the renamings
; extended by the first parameters, from those of the n-ary atoms.

(defruled expr-free-ispace-vars-of-tlambda-curried-body
  (implies (consp (cdr params))
           (equal (expr-free-ispace-vars (tlambda-curried-body params body))
                  (expr-free-ispace-vars body)))
  :expand ((:free (a) (expr-free-ispace-vars (expr-atom a)))
           (:free (ps b) (atom-free-ispace-vars (atom-tlambdan ps b)))
           (:free (p b) (atom-free-ispace-vars (atom-tlambda p b))))
  :enable (tlambda-curried-body make-atom-tlambda/tlambdan))

(defruled expr-free-expr-vars-of-tlambda-curried-body
  (implies (consp (cdr params))
           (equal (expr-free-expr-vars (tlambda-curried-body params body))
                  (expr-free-expr-vars body)))
  :expand ((:free (a) (expr-free-expr-vars (expr-atom a)))
           (:free (ps b) (atom-free-expr-vars (atom-tlambdan ps b)))
           (:free (p b) (atom-free-expr-vars (atom-tlambda p b))))
  :enable (tlambda-curried-body make-atom-tlambda/tlambdan))

(defrule len-positive-when-consp
  (implies (consp x) (< 0 (len x)))
  :rule-classes :linear
  :expand ((len x)))

(defruled expr-free-type-vars-of-tlambda-curried-body
  (implies (and (consp (cdr params))
                (type-var-listp params))
           (equal (expr-free-type-vars (tlambda-curried-body params body))
                  (set::difference (expr-free-type-vars body)
                                   (set::mergesort (cdr params)))))
  :expand ((:free (a) (expr-free-type-vars (expr-atom a)))
           (:free (ps b) (atom-free-type-vars (atom-tlambdan ps b)))
           (:free (p b) (atom-free-type-vars (atom-tlambda p b))))
  :enable (tlambda-curried-body
           make-atom-tlambda/tlambdan
           mergesort-of-cons
           set::difference-insert-y
           difference-of-nil-right))

(defruled type-var-list-alpha-extend-okp-of-cons
  (implies (and (consp new-params)
                (consp params))
           (iff (mv-nth 0 (type-var-list-alpha-extend new-params params am arm))
                (and (mv-nth 0 (type-var-list-alpha-extend
                                (list (car new-params)) (list (car params)) am arm))
                     (mv-nth 0 (type-var-list-alpha-extend
                                (cdr new-params) (cdr params)
                                (mv-nth 1 (type-var-list-alpha-extend
                                           (list (car new-params)) (list (car params))
                                           am arm))
                                (mv-nth 2 (type-var-list-alpha-extend
                                           (list (car new-params)) (list (car params))
                                           am arm)))))))
  :expand ((type-var-list-alpha-extend new-params params am arm)
           (type-var-list-alpha-extend (list (car new-params)) (list (car params))
                                       am arm))
  :enable type-var-list-alpha-extend-of-nil)

(defruled type-var-list-alpha-extend-maps-of-cons
  (implies (and (consp new-params)
                (consp params)
                (mv-nth 0 (type-var-list-alpha-extend
                           (list (car new-params)) (list (car params)) am arm)))
           (and (equal (mv-nth 1 (type-var-list-alpha-extend new-params params am arm))
                       (mv-nth 1 (type-var-list-alpha-extend
                                  (cdr new-params) (cdr params)
                                  (mv-nth 1 (type-var-list-alpha-extend
                                             (list (car new-params)) (list (car params))
                                             am arm))
                                  (mv-nth 2 (type-var-list-alpha-extend
                                             (list (car new-params)) (list (car params))
                                             am arm)))))
                (equal (mv-nth 2 (type-var-list-alpha-extend new-params params am arm))
                       (mv-nth 2 (type-var-list-alpha-extend
                                  (cdr new-params) (cdr params)
                                  (mv-nth 1 (type-var-list-alpha-extend
                                             (list (car new-params)) (list (car params))
                                             am arm))
                                  (mv-nth 2 (type-var-list-alpha-extend
                                             (list (car new-params)) (list (car params))
                                             am arm)))))))
  :expand ((type-var-list-alpha-extend new-params params am arm)
           (type-var-list-alpha-extend (list (car new-params)) (list (car params))
                                       am arm))
  :enable type-var-list-alpha-extend-of-nil)

(defruled type-var-list-alpha-extend-okp-of-car
  (implies (and (consp new-params)
                (consp params)
                (mv-nth 0 (type-var-list-alpha-extend new-params params am arm)))
           (mv-nth 0 (type-var-list-alpha-extend
                      (list (car new-params)) (list (car params)) am arm)))
  :use type-var-list-alpha-extend-okp-of-cons)

(defruled type-var-list-alpha-extend-okp-of-cdr
  (implies (and (consp new-params)
                (consp params)
                (mv-nth 0 (type-var-list-alpha-extend new-params params am arm)))
           (mv-nth 0 (type-var-list-alpha-extend
                      (cdr new-params) (cdr params)
                      (mv-nth 1 (type-var-list-alpha-extend
                                 (list (car new-params)) (list (car params))
                                 am arm))
                      (mv-nth 2 (type-var-list-alpha-extend
                                 (list (car new-params)) (list (car params))
                                 am arm)))))
  :use type-var-list-alpha-extend-okp-of-cons)

(defruled consp-when-len-equal
  (implies (equal (len a) (len b))
           (iff (consp a) (consp b)))
  :expand ((len a) (len b)))

(defruled consp-of-cdr-when-len-equal
  (implies (equal (len a) (len b))
           (iff (consp (cdr a)) (consp (cdr b))))
  :expand ((len a) (len b) (len (cdr a)) (len (cdr b))))

(defruled consp-of-cddr-when-len-equal
  (implies (equal (len a) (len b))
           (iff (consp (cddr a)) (consp (cddr b))))
  :expand ((len a) (len b) (len (cdr a)) (len (cdr b))
           (len (cddr a)) (len (cddr b))))

(defruled expr-alpha-related-p-of-tlambda-curried-body
  (implies (and (consp (cdr params))
                (type-var-listp params)
                (type-var-listp new-params)
                (mv-nth 0 (type-var-list-alpha-extend new-params params
                                                      (var-renamings->atom r)
                                                      (var-renamings->array r)))
                (expr-alpha-related-p
                 new-body body
                 (change-var-renamings
                  r
                  :atom (mv-nth 1 (type-var-list-alpha-extend
                                   new-params params
                                   (var-renamings->atom r)
                                   (var-renamings->array r)))
                  :array (mv-nth 2 (type-var-list-alpha-extend
                                    new-params params
                                    (var-renamings->atom r)
                                    (var-renamings->array r))))))
           (expr-alpha-related-p
            (tlambda-curried-body new-params new-body)
            (tlambda-curried-body params body)
            (change-var-renamings
             r
             :atom (mv-nth 1 (type-var-list-alpha-extend
                              (list (car new-params)) (list (car params))
                              (var-renamings->atom r)
                              (var-renamings->array r)))
             :array (mv-nth 2 (type-var-list-alpha-extend
                               (list (car new-params)) (list (car params))
                               (var-renamings->atom r)
                               (var-renamings->array r))))))
  :expand ((:free (a1 a2 r) (expr-alpha-related-p (expr-atom a1) (expr-atom a2) r))
           (:free (a1 ps b r) (atom-alpha-related-p a1 (atom-tlambdan ps b) r))
           (:free (a1 p b r) (atom-alpha-related-p a1 (atom-tlambda p b) r)))
  :enable (tlambda-curried-body
           make-atom-tlambda/tlambdan)
  :disable type-var-list-alpha-extend
  :use ((:instance consp-when-len-equal
                   (a new-params) (b params))
        (:instance consp-of-cdr-when-len-equal
                   (a new-params) (b params))
        (:instance consp-of-cddr-when-len-equal
                   (a new-params) (b params))
        (:instance type-var-list-alpha-extend-okp-of-car
                   (am (var-renamings->atom r)) (arm (var-renamings->array r)))
        (:instance type-var-list-alpha-extend-okp-of-cdr
                   (am (var-renamings->atom r)) (arm (var-renamings->array r)))
        (:instance len-when-type-var-list-alpha-extend-okp
                   (new-params (cdr new-params)) (params (cdr params))
                   (atom-m (mv-nth 1 (type-var-list-alpha-extend
                                      (list (car new-params)) (list (car params))
                                      (var-renamings->atom r)
                                      (var-renamings->array r))))
                   (array-m (mv-nth 2 (type-var-list-alpha-extend
                                       (list (car new-params)) (list (car params))
                                       (var-renamings->atom r)
                                       (var-renamings->array r)))))
        (:instance type-var-list-alpha-extend-maps-of-cons
                   (am (var-renamings->atom r)) (arm (var-renamings->array r)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Freshness of the curried bodies, with respect to the outer support set
; extended by the first new parameter's name: the first parameter's
; freshness step is consumed, and the remaining conditions are the n-ary
; atom's conditions on the remaining parameters.

(defruled type-var-list-fresh-ok-of-cdr
  (implies (and (consp new-params)
                (consp params)
                (type-var-listp params)
                (type-var-listp new-params)
                (mv-nth 0 (type-var-list-alpha-extend
                           (list (car new-params)) (list (car params)) am arm))
                (type-var-list-fresh-ok new-params params am arm b))
           (type-var-list-fresh-ok
            (cdr new-params) (cdr params)
            (mv-nth 1 (type-var-list-alpha-extend
                       (list (car new-params)) (list (car params)) am arm))
            (mv-nth 2 (type-var-list-alpha-extend
                       (list (car new-params)) (list (car params)) am arm))
            (set::insert (type-var->name (car new-params)) (string-sfix b))))
  :expand ((type-var-list-fresh-ok new-params params am arm b)
           (type-var-list-alpha-extend (list (car new-params)) (list (car params))
                                       am arm))
  :enable (type-var->name type-var-list-alpha-extend-of-nil))

(defruled disjoint-of-type-var-image-of-cdr-extend
  (implies (and (type-var-setp f)
                (type-var-listp params)
                (type-var-listp new-params)
                (consp new-params)
                (consp params)
                (mv-nth 0 (type-var-list-alpha-extend
                           (list (car new-params)) (list (car params)) am arm))
                (no-duplicatesp-equal new-params)
                (set::emptyp
                 (set::intersect
                  (set::mergesort new-params)
                  (type-var-set-rename-type-vars
                   (set::difference f (set::mergesort params)) am arm))))
           (set::emptyp
            (set::intersect
             (set::mergesort (cdr new-params))
             (type-var-set-rename-type-vars
              (set::difference f (set::mergesort (cdr params)))
              (mv-nth 1 (type-var-list-alpha-extend
                         (list (car new-params)) (list (car params)) am arm))
              (mv-nth 2 (type-var-list-alpha-extend
                         (list (car new-params)) (list (car params)) am arm))))))
  :expand ((type-var-list-alpha-extend (list (car new-params)) (list (car params))
                                       am arm))
  :enable (type-var-list-alpha-extend-of-nil
           mergesort-of-cons
           set::difference-insert-y)
  :use ((:instance disjoint-of-type-var-image-of-atom-extend
                   (l (set::mergesort (cdr new-params)))
                   (s (set::difference f (set::mergesort (cdr params))))
                   (n (type-var-atom->name (car params)))
                   (n2 (type-var-atom->name (car new-params)))
                   (atom-m am) (array-m arm))
        (:instance disjoint-of-type-var-image-of-array-extend
                   (l (set::mergesort (cdr new-params)))
                   (s (set::difference f (set::mergesort (cdr params))))
                   (n (type-var-array->name (car params)))
                   (n2 (type-var-array->name (car new-params)))
                   (atom-m am) (array-m arm))
        (:instance disjoint-monotone
                   (l (set::mergesort new-params))
                   (l2 (set::mergesort (cdr new-params)))
                   (x (type-var-set-rename-type-vars
                       (set::difference f (set::mergesort params)) am arm)))
        (:instance subset-of-mergesort-of-cdr (l new-params))
        (:instance type-var-fix-when-atom (x (car params)))
        (:instance type-var-fix-when-atom (x (car new-params)))
        (:instance type-var-fix-when-array (x (car params)))
        (:instance type-var-fix-when-array (x (car new-params)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defruled subset-of-mergesort-of-names-of-cdr
  (set::subset (set::mergesort (type-var-list->name (cdr l)))
               (set::mergesort (type-var-list->name l)))
  :enable (set::pick-a-point-subset-strategy type-var-list->name))

(defruled expr-alpha-fresh-p-of-tlambda-curried-body
  (implies (and (consp (cdr params))
                (type-var-listp params)
                (type-var-listp new-params)
                (mv-nth 0 (type-var-list-alpha-extend new-params params
                                                      (var-renamings->atom r)
                                                      (var-renamings->array r)))
                (type-var-list-fresh-ok new-params params
                                        (var-renamings->atom r)
                                        (var-renamings->array r)
                                        b)
                (no-duplicatesp-equal new-params)
                (set::emptyp
                 (set::intersect
                  (set::mergesort new-params)
                  (type-var-set-rename-type-vars
                   (set::difference (expr-free-type-vars body)
                                    (set::mergesort params))
                   (var-renamings->atom r)
                   (var-renamings->array r))))
                (expr-alpha-fresh-p
                 new-body body
                 (change-var-renamings
                  r
                  :atom (mv-nth 1 (type-var-list-alpha-extend
                                   new-params params
                                   (var-renamings->atom r)
                                   (var-renamings->array r)))
                  :array (mv-nth 2 (type-var-list-alpha-extend
                                    new-params params
                                    (var-renamings->atom r)
                                    (var-renamings->array r))))
                 (set::union
                  (set::mergesort (type-var-list->name new-params))
                  (expr-body-support-names
                   body
                   (change-var-renamings
                    r
                    :atom (mv-nth 1 (type-var-list-alpha-extend
                                     new-params params
                                     (var-renamings->atom r)
                                     (var-renamings->array r)))
                    :array (mv-nth 2 (type-var-list-alpha-extend
                                      new-params params
                                      (var-renamings->atom r)
                                      (var-renamings->array r))))))))
           (expr-alpha-fresh-p
            (tlambda-curried-body new-params new-body)
            (tlambda-curried-body params body)
            (change-var-renamings
             r
             :atom (mv-nth 1 (type-var-list-alpha-extend
                              (list (car new-params)) (list (car params))
                              (var-renamings->atom r)
                              (var-renamings->array r)))
             :array (mv-nth 2 (type-var-list-alpha-extend
                               (list (car new-params)) (list (car params))
                               (var-renamings->atom r)
                               (var-renamings->array r))))
            (set::insert (type-var->name (car new-params)) (string-sfix b))))
  :expand ((:free (a1 a2 r b) (expr-alpha-fresh-p (expr-atom a1) (expr-atom a2) r b))
           (:free (a1 ps bd r b) (atom-alpha-fresh-p a1 (atom-tlambdan ps bd) r b))
           (:free (a1 p bd r b) (atom-alpha-fresh-p a1 (atom-tlambda p bd) r b)))
  :enable (tlambda-curried-body
           make-atom-tlambda/tlambdan
           mergesort-of-cons
           set::difference-insert-y
           difference-of-nil-right
           expr-alpha-fresh-p-anti-monotone
           subset-of-union-right-1
           subset-of-union-right-2
           not-in-when-emptyp-intersect-of-insert)
  :disable type-var-list-alpha-extend
  :use ((:instance consp-when-len-equal
                   (a new-params) (b params))
        (:instance consp-of-cdr-when-len-equal
                   (a new-params) (b params))
        (:instance consp-of-cddr-when-len-equal
                   (a new-params) (b params))
        (:instance type-var-list-alpha-extend-okp-of-car
                   (am (var-renamings->atom r)) (arm (var-renamings->array r)))
        (:instance type-var-list-alpha-extend-okp-of-cdr
                   (am (var-renamings->atom r)) (arm (var-renamings->array r)))
        (:instance len-when-type-var-list-alpha-extend-okp
                   (new-params (cdr new-params)) (params (cdr params))
                   (atom-m (mv-nth 1 (type-var-list-alpha-extend
                                      (list (car new-params)) (list (car params))
                                      (var-renamings->atom r)
                                      (var-renamings->array r))))
                   (array-m (mv-nth 2 (type-var-list-alpha-extend
                                       (list (car new-params)) (list (car params))
                                       (var-renamings->atom r)
                                       (var-renamings->array r)))))
        (:instance type-var-list-alpha-extend-maps-of-cons
                   (am (var-renamings->atom r)) (arm (var-renamings->array r)))
        (:instance type-var-list-fresh-ok-of-cdr
                   (am (var-renamings->atom r)) (arm (var-renamings->array r)))
        (:instance disjoint-of-type-var-image-of-cdr-extend
                   (f (expr-free-type-vars body))
                   (am (var-renamings->atom r)) (arm (var-renamings->array r)))
        (:instance subset-of-mergesort-of-names-of-cdr (l new-params))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The support invariant survives restriction of the environment (fewer
; keys) and the extension of the type-variable renamings by one
; parameter (the new name enters the support set).

(defruled dim-names-of-intersect-subset
  (implies (and (ispace-var-setp s) (ispace-var-setp keys))
           (set::subset (mv-nth 0 (dim/shape-names-of-ispace-vars (set::intersect s keys)))
                        (mv-nth 0 (dim/shape-names-of-ispace-vars keys))))
  :enable (set::pick-a-point-subset-strategy))

(defruled shape-names-of-intersect-subset
  (implies (and (ispace-var-setp s) (ispace-var-setp keys))
           (set::subset (mv-nth 1 (dim/shape-names-of-ispace-vars (set::intersect s keys)))
                        (mv-nth 1 (dim/shape-names-of-ispace-vars keys))))
  :enable (set::pick-a-point-subset-strategy))

(defruled atom-names-of-intersect-subset
  (implies (and (type-var-setp s) (type-var-setp keys))
           (set::subset (mv-nth 0 (atom/array-names-of-type-vars (set::intersect s keys)))
                        (mv-nth 0 (atom/array-names-of-type-vars keys))))
  :enable (set::pick-a-point-subset-strategy))

(defruled array-names-of-intersect-subset
  (implies (and (type-var-setp s) (type-var-setp keys))
           (set::subset (mv-nth 1 (atom/array-names-of-type-vars (set::intersect s keys)))
                        (mv-nth 1 (atom/array-names-of-type-vars keys))))
  :enable (set::pick-a-point-subset-strategy))

(defruled expr-denv-keys-supported-p-of-expr-denv-restrict
  (implies (and (expr-denv-keys-supported-p denv r b)
                (expr-denv-wfp denv))
           (expr-denv-keys-supported-p (expr-denv-restrict ivars tvars evars denv)
                                       r b))
  :enable (expr-denv-keys-supported-p
           expr-denv-restrict
           type-denv-restrict
           ispace-denv-restrict
           omap::keys-of-restrict
           string-set-supported-p-of-subset
           dim-names-of-intersect-subset
           shape-names-of-intersect-subset
           atom-names-of-intersect-subset
           array-names-of-intersect-subset
           set::intersect-subset-y))

(defruled expr-denv-keys-supported-p-of-type-var-extend-1
  (implies (and (expr-denv-keys-supported-p denv r b)
                (type-varp p)
                (type-varp new-p)
                (mv-nth 0 (type-var-list-alpha-extend (list new-p) (list p)
                                                      (var-renamings->atom r)
                                                      (var-renamings->array r))))
           (expr-denv-keys-supported-p
            denv
            (change-var-renamings
             r
             :atom (mv-nth 1 (type-var-list-alpha-extend (list new-p) (list p)
                                                         (var-renamings->atom r)
                                                         (var-renamings->array r)))
             :array (mv-nth 2 (type-var-list-alpha-extend (list new-p) (list p)
                                                          (var-renamings->atom r)
                                                          (var-renamings->array r))))
            (set::insert (type-var->name new-p) (string-sfix b))))
  :expand ((type-var-list-alpha-extend (list new-p) (list p)
                                       (var-renamings->atom r)
                                       (var-renamings->array r)))
  :enable (expr-denv-keys-supported-p
           type-var->name
           type-var-list-alpha-extend-of-nil
           string-set-supported-p-of-extend-other
           string-set-supported-p-monotone
           set::subset-insert))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Atoms: n-ary type lambda.  The value is a unary type closure over the
; first parameter whose body is the curried remainder; its support set is
; the outer one, since the freshness of the remaining parameters is known
; only relative to it.

(defruled eval-atom-when-tlambdan
  (implies (and (equal (atom-kind atom) :tlambdan)
                (not (zp limit)))
           (equal (eval-atom atom denv limit)
                  (make-expr-value-tlambda
                   :param (car (atom-tlambdan->params atom))
                   :body (tlambda-curried-body (atom-tlambdan->params atom)
                                               (atom-tlambdan->body atom))
                   :denv (expr-denv-restrict
                          (expr-free-ispace-vars (atom-tlambdan->body atom))
                          (atom-free-type-vars atom)
                          (expr-free-expr-vars (atom-tlambdan->body atom))
                          denv))))
  :expand ((eval-atom atom denv limit)))

(defruled tlambdan-closure-denv-alpha
  (implies (and (equal (atom-kind atom) :tlambdan)
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-free-ispace-vars atom)
                                           (atom-free-type-vars atom)
                                           (atom-free-expr-vars atom))
                (expr-denv-wfp denv))
           (b* ((ivars (expr-free-ispace-vars (atom-tlambdan->body atom)))
                (tvars (atom-free-type-vars atom))
                (evars (expr-free-expr-vars (atom-tlambdan->body atom)))
                (cdenv (expr-denv-restrict ivars tvars evars denv))
                (new-cdenv (expr-denv-restrict
                            (expr-free-ispace-vars (atom-tlambdan->body new-atom))
                            (atom-free-type-vars new-atom)
                            (expr-free-expr-vars (atom-tlambdan->body new-atom))
                            new-denv))
                ((mv & atom-renam array-renam)
                 (type-var-list-alpha-extend
                  (list (car (atom-tlambdan->params new-atom)))
                  (list (car (atom-tlambdan->params atom)))
                  (var-renamings->atom r)
                  (var-renamings->array r)))
                (body-r (change-var-renamings r :atom atom-renam :array array-renam)))
             (and (expr-denv-alpha-related-via-p new-cdenv cdenv r dw)
                  (expr-denv-keys-within-p cdenv ivars tvars evars)
                  (expr-denv-alpha-avoided-p new-cdenv cdenv r
                                             ivars tvars evars)
                  (expr-denv-keys-supported-p
                   cdenv body-r
                   (set::insert (type-var->name (car (atom-tlambdan->params new-atom)))
                                (string-sfix b))))))
  :expand ((atom-alpha-related-p new-atom atom r)
           (atom-alpha-fresh-p new-atom atom r b)
           (atom-free-ispace-vars atom)
           (atom-free-expr-vars atom))
  :enable (expr-denv-keys-within-p-of-expr-denv-restrict
           subset-of-union-right-1
           subset-of-union-right-2
           expr-denv-keys-supported-p-of-expr-denv-restrict
           expr-denv-keys-supported-p-of-type-var-extend-1)
  :disable atom-free-type-vars-of-alpha-related
  :use ((:instance type-var-list-alpha-extend-okp-of-car
                   (new-params (atom-tlambdan->params new-atom))
                   (params (atom-tlambdan->params atom))
                   (am (var-renamings->atom r)) (arm (var-renamings->array r)))
        (:instance atom-free-type-vars-of-alpha-related
                   (new-a new-atom) (a atom))
        (:instance expr-free-ispace-vars-of-alpha-related
                   (new-x (atom-tlambdan->body new-atom))
                   (x (atom-tlambdan->body atom))
                   (r (change-var-renamings
                       r
                       :atom (mv-nth 1 (type-var-list-alpha-extend
                                        (atom-tlambdan->params new-atom)
                                        (atom-tlambdan->params atom)
                                        (var-renamings->atom r)
                                        (var-renamings->array r)))
                       :array (mv-nth 2 (type-var-list-alpha-extend
                                         (atom-tlambdan->params new-atom)
                                         (atom-tlambdan->params atom)
                                         (var-renamings->atom r)
                                         (var-renamings->array r)))))
                   (b (set::union
                       (set::mergesort (type-var-list->name (atom-tlambdan->params new-atom)))
                       (expr-body-support-names
                        (atom-tlambdan->body atom)
                        (change-var-renamings
                         r
                         :atom (mv-nth 1 (type-var-list-alpha-extend
                                          (atom-tlambdan->params new-atom)
                                          (atom-tlambdan->params atom)
                                          (var-renamings->atom r)
                                          (var-renamings->array r)))
                         :array (mv-nth 2 (type-var-list-alpha-extend
                                           (atom-tlambdan->params new-atom)
                                           (atom-tlambdan->params atom)
                                           (var-renamings->atom r)
                                           (var-renamings->array r))))))))
        (:instance expr-free-expr-vars-of-alpha-related
                   (new-x (atom-tlambdan->body new-atom))
                   (x (atom-tlambdan->body atom))
                   (r (change-var-renamings
                       r
                       :atom (mv-nth 1 (type-var-list-alpha-extend
                                        (atom-tlambdan->params new-atom)
                                        (atom-tlambdan->params atom)
                                        (var-renamings->atom r)
                                        (var-renamings->array r)))
                       :array (mv-nth 2 (type-var-list-alpha-extend
                                         (atom-tlambdan->params new-atom)
                                         (atom-tlambdan->params atom)
                                         (var-renamings->atom r)
                                         (var-renamings->array r)))))
                   (b (set::union
                       (set::mergesort (type-var-list->name (atom-tlambdan->params new-atom)))
                       (expr-body-support-names
                        (atom-tlambdan->body atom)
                        (change-var-renamings
                         r
                         :atom (mv-nth 1 (type-var-list-alpha-extend
                                          (atom-tlambdan->params new-atom)
                                          (atom-tlambdan->params atom)
                                          (var-renamings->atom r)
                                          (var-renamings->array r)))
                         :array (mv-nth 2 (type-var-list-alpha-extend
                                           (atom-tlambdan->params new-atom)
                                           (atom-tlambdan->params atom)
                                           (var-renamings->atom r)
                                           (var-renamings->array r))))))))
        (:instance expr-denv-alpha-related-via-p-of-expr-denv-restrict
                   (ivars (expr-free-ispace-vars (atom-tlambdan->body atom)))
                   (tvars (atom-free-type-vars atom))
                   (evars (expr-free-expr-vars (atom-tlambdan->body atom)))
                   (new-ivars (expr-free-ispace-vars (atom-tlambdan->body new-atom)))
                   (new-tvars (atom-free-type-vars new-atom))
                   (new-evars (expr-free-expr-vars (atom-tlambdan->body new-atom))))
        (:instance expr-denv-alpha-avoided-p-of-expr-denv-restrict
                   (ivars (expr-free-ispace-vars (atom-tlambdan->body atom)))
                   (tvars (atom-free-type-vars atom))
                   (evars (expr-free-expr-vars (atom-tlambdan->body atom)))
                   (ivars1 (expr-free-ispace-vars (atom-tlambdan->body atom)))
                   (tvars1 (atom-free-type-vars atom))
                   (evars1 (expr-free-expr-vars (atom-tlambdan->body atom)))
                   (new-ivars (expr-free-ispace-vars (atom-tlambdan->body new-atom)))
                   (new-tvars (atom-free-type-vars new-atom))
                   (new-evars (expr-free-expr-vars (atom-tlambdan->body new-atom))))))

(defruled eval-atom-ok-when-tlambdan-aux
  (implies (and (equal (atom-kind atom) :tlambdan)
                (not (zp limit))
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-free-ispace-vars atom)
                                           (atom-free-type-vars atom)
                                           (atom-free-expr-vars atom))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((val (eval-atom atom denv limit))
                (new-val (eval-atom new-atom new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((atom-alpha-related-p new-atom atom r)
           (atom-alpha-fresh-p new-atom atom r b)
           (atom-free-type-vars atom)
           (:free (new-val w param body cdenv)
            (expr-value-alpha-related-via-p
             new-val (expr-value-tlambda param body cdenv) w)))
  :enable (eval-atom-when-tlambdan
           expr-free-ispace-vars-of-tlambda-curried-body
           expr-free-type-vars-of-tlambda-curried-body
           expr-free-expr-vars-of-tlambda-curried-body
           mergesort-when-consp
           set::difference-insert-y
           not-in-when-emptyp-intersect-of-insert
           consp-of-cdr-of-atom-tlambdan->params
           not-reserrp-when-expr-valuep)
  :disable (atom-free-type-vars-of-alpha-related
            not-in-type-var-set-when-name-not-in-names
            not-in-ispace-var-set-when-name-not-in-names
            not-in-type-var-set-rename-type-vars-when-fresh
            in-of-type-var-set-names
            in-type-var-set-names-when-in
            set::difference-in
            set::delete-in
            set::in-mergesort-under-iff
            set::delete-nonmember-cancel
            member-equal)
  :use (tlambdan-closure-denv-alpha
        (:instance type-var-list-alpha-extend-okp-of-car
                   (new-params (atom-tlambdan->params new-atom))
                   (params (atom-tlambdan->params atom))
                   (am (var-renamings->atom r)) (arm (var-renamings->array r)))
        (:instance expr-alpha-related-p-of-tlambda-curried-body
                   (new-params (atom-tlambdan->params new-atom))
                   (params (atom-tlambdan->params atom))
                   (new-body (atom-tlambdan->body new-atom))
                   (body (atom-tlambdan->body atom)))
        (:instance expr-alpha-fresh-p-of-tlambda-curried-body
                   (new-params (atom-tlambdan->params new-atom))
                   (params (atom-tlambdan->params atom))
                   (new-body (atom-tlambdan->body new-atom))
                   (body (atom-tlambdan->body atom)))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (eval-atom new-atom new-denv limit))
                   (val (eval-atom atom denv limit))
                   (w (expr-value-witness-closure r '(:leaf) '(:leaf) dw b)))))

(defruled eval-atom-ok-when-tlambdan
  (implies (equal (atom-kind atom) :tlambdan)
           (eval-atom-ok atom denv limit))
  :expand ((eval-atom-ok atom denv limit)
           (:free (new-x r) (atom-alpha-related-p new-x atom r)))
  :cases ((zp limit))
  :enable eval-atom-when-zp-limit
  :use ((:instance eval-atom-ok-when-tlambdan-aux
                   (new-atom (mv-nth 0 (eval-atom-ok-witness atom denv limit)))
                   (new-denv (mv-nth 1 (eval-atom-ok-witness atom denv limit)))
                   (r (mv-nth 2 (eval-atom-ok-witness atom denv limit)))
                   (dw (mv-nth 3 (eval-atom-ok-witness atom denv limit)))
                   (b (mv-nth 4 (eval-atom-ok-witness atom denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; n-ary ispace lambdas: the curried body (mirror of the type-lambda lemmas).

(defruled expr-free-type-vars-of-ilambda-curried-body
  (implies (consp (cdr params))
           (equal (expr-free-type-vars (ilambda-curried-body params body))
                  (expr-free-type-vars body)))
  :expand ((:free (a) (expr-free-type-vars (expr-atom a)))
           (:free (ps b) (atom-free-type-vars (atom-ilambdan ps b)))
           (:free (p b) (atom-free-type-vars (atom-ilambda p b))))
  :enable (ilambda-curried-body make-atom-ilambda/ilambdan))

(defruled expr-free-expr-vars-of-ilambda-curried-body
  (implies (consp (cdr params))
           (equal (expr-free-expr-vars (ilambda-curried-body params body))
                  (expr-free-expr-vars body)))
  :expand ((:free (a) (expr-free-expr-vars (expr-atom a)))
           (:free (ps b) (atom-free-expr-vars (atom-ilambdan ps b)))
           (:free (p b) (atom-free-expr-vars (atom-ilambda p b))))
  :enable (ilambda-curried-body make-atom-ilambda/ilambdan))

(defruled expr-free-ispace-vars-of-ilambda-curried-body
  (implies (and (consp (cdr params))
                (ispace-var-listp params))
           (equal (expr-free-ispace-vars (ilambda-curried-body params body))
                  (set::difference (expr-free-ispace-vars body)
                                   (set::mergesort (cdr params)))))
  :expand ((:free (a) (expr-free-ispace-vars (expr-atom a)))
           (:free (ps b) (atom-free-ispace-vars (atom-ilambdan ps b)))
           (:free (p b) (atom-free-ispace-vars (atom-ilambda p b))))
  :enable (ilambda-curried-body
           make-atom-ilambda/ilambdan
           mergesort-of-cons
           set::difference-insert-y
           difference-of-nil-right))

(defruled ispace-var-list-alpha-extend-okp-of-cons
  (implies (and (consp new-params)
                (consp params))
           (iff (mv-nth 0 (ispace-var-list-alpha-extend new-params params am arm))
                (and (mv-nth 0 (ispace-var-list-alpha-extend
                                (list (car new-params)) (list (car params)) am arm))
                     (mv-nth 0 (ispace-var-list-alpha-extend
                                (cdr new-params) (cdr params)
                                (mv-nth 1 (ispace-var-list-alpha-extend
                                           (list (car new-params)) (list (car params))
                                           am arm))
                                (mv-nth 2 (ispace-var-list-alpha-extend
                                           (list (car new-params)) (list (car params))
                                           am arm)))))))
  :expand ((ispace-var-list-alpha-extend new-params params am arm)
           (ispace-var-list-alpha-extend (list (car new-params)) (list (car params))
                                       am arm))
  :enable ispace-var-list-alpha-extend-of-nil)

(defruled ispace-var-list-alpha-extend-maps-of-cons
  (implies (and (consp new-params)
                (consp params)
                (mv-nth 0 (ispace-var-list-alpha-extend
                           (list (car new-params)) (list (car params)) am arm)))
           (and (equal (mv-nth 1 (ispace-var-list-alpha-extend new-params params am arm))
                       (mv-nth 1 (ispace-var-list-alpha-extend
                                  (cdr new-params) (cdr params)
                                  (mv-nth 1 (ispace-var-list-alpha-extend
                                             (list (car new-params)) (list (car params))
                                             am arm))
                                  (mv-nth 2 (ispace-var-list-alpha-extend
                                             (list (car new-params)) (list (car params))
                                             am arm)))))
                (equal (mv-nth 2 (ispace-var-list-alpha-extend new-params params am arm))
                       (mv-nth 2 (ispace-var-list-alpha-extend
                                  (cdr new-params) (cdr params)
                                  (mv-nth 1 (ispace-var-list-alpha-extend
                                             (list (car new-params)) (list (car params))
                                             am arm))
                                  (mv-nth 2 (ispace-var-list-alpha-extend
                                             (list (car new-params)) (list (car params))
                                             am arm)))))))
  :expand ((ispace-var-list-alpha-extend new-params params am arm)
           (ispace-var-list-alpha-extend (list (car new-params)) (list (car params))
                                       am arm))
  :enable ispace-var-list-alpha-extend-of-nil)

(defruled ispace-var-list-alpha-extend-okp-of-car
  (implies (and (consp new-params)
                (consp params)
                (mv-nth 0 (ispace-var-list-alpha-extend new-params params am arm)))
           (mv-nth 0 (ispace-var-list-alpha-extend
                      (list (car new-params)) (list (car params)) am arm)))
  :use ispace-var-list-alpha-extend-okp-of-cons)

(defruled ispace-var-list-alpha-extend-okp-of-cdr
  (implies (and (consp new-params)
                (consp params)
                (mv-nth 0 (ispace-var-list-alpha-extend new-params params am arm)))
           (mv-nth 0 (ispace-var-list-alpha-extend
                      (cdr new-params) (cdr params)
                      (mv-nth 1 (ispace-var-list-alpha-extend
                                 (list (car new-params)) (list (car params))
                                 am arm))
                      (mv-nth 2 (ispace-var-list-alpha-extend
                                 (list (car new-params)) (list (car params))
                                 am arm)))))
  :use ispace-var-list-alpha-extend-okp-of-cons)

(defruled expr-alpha-related-p-of-ilambda-curried-body
  (implies (and (consp (cdr params))
                (ispace-var-listp params)
                (ispace-var-listp new-params)
                (mv-nth 0 (ispace-var-list-alpha-extend new-params params
                                                      (var-renamings->dim r)
                                                      (var-renamings->shape r)))
                (expr-alpha-related-p
                 new-body body
                 (change-var-renamings
                  r
                  :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                   new-params params
                                   (var-renamings->dim r)
                                   (var-renamings->shape r)))
                  :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                    new-params params
                                    (var-renamings->dim r)
                                    (var-renamings->shape r))))))
           (expr-alpha-related-p
            (ilambda-curried-body new-params new-body)
            (ilambda-curried-body params body)
            (change-var-renamings
             r
             :dim (mv-nth 1 (ispace-var-list-alpha-extend
                              (list (car new-params)) (list (car params))
                              (var-renamings->dim r)
                              (var-renamings->shape r)))
             :shape (mv-nth 2 (ispace-var-list-alpha-extend
                               (list (car new-params)) (list (car params))
                               (var-renamings->dim r)
                               (var-renamings->shape r))))))
  :expand ((:free (a1 a2 r) (expr-alpha-related-p (expr-atom a1) (expr-atom a2) r))
           (:free (a1 ps b r) (atom-alpha-related-p a1 (atom-ilambdan ps b) r))
           (:free (a1 p b r) (atom-alpha-related-p a1 (atom-ilambda p b) r)))
  :enable (ilambda-curried-body
           make-atom-ilambda/ilambdan)
  :disable ispace-var-list-alpha-extend
  :use ((:instance consp-when-len-equal
                   (a new-params) (b params))
        (:instance consp-of-cdr-when-len-equal
                   (a new-params) (b params))
        (:instance consp-of-cddr-when-len-equal
                   (a new-params) (b params))
        (:instance ispace-var-list-alpha-extend-okp-of-car
                   (am (var-renamings->dim r)) (arm (var-renamings->shape r)))
        (:instance ispace-var-list-alpha-extend-okp-of-cdr
                   (am (var-renamings->dim r)) (arm (var-renamings->shape r)))
        (:instance len-when-ispace-var-list-alpha-extend-okp
                   (new-params (cdr new-params)) (params (cdr params))
                   (dim-m (mv-nth 1 (ispace-var-list-alpha-extend
                                      (list (car new-params)) (list (car params))
                                      (var-renamings->dim r)
                                      (var-renamings->shape r))))
                   (shape-m (mv-nth 2 (ispace-var-list-alpha-extend
                                       (list (car new-params)) (list (car params))
                                       (var-renamings->dim r)
                                       (var-renamings->shape r)))))
        (:instance ispace-var-list-alpha-extend-maps-of-cons
                   (am (var-renamings->dim r)) (arm (var-renamings->shape r)))))

; Freshness of the curried bodies, with respect to the outer support set
; extended by the first new parameter's name: the first parameter's
; freshness step is consumed, and the remaining conditions are the n-ary
; atom's conditions on the remaining parameters.

(defruled ispace-var-list-fresh-ok-of-cdr
  (implies (and (consp new-params)
                (consp params)
                (ispace-var-listp params)
                (ispace-var-listp new-params)
                (mv-nth 0 (ispace-var-list-alpha-extend
                           (list (car new-params)) (list (car params)) am arm))
                (ispace-var-list-fresh-ok new-params params am arm b))
           (ispace-var-list-fresh-ok
            (cdr new-params) (cdr params)
            (mv-nth 1 (ispace-var-list-alpha-extend
                       (list (car new-params)) (list (car params)) am arm))
            (mv-nth 2 (ispace-var-list-alpha-extend
                       (list (car new-params)) (list (car params)) am arm))
            (set::insert (ispace-var->name (car new-params)) (string-sfix b))))
  :expand ((ispace-var-list-fresh-ok new-params params am arm b)
           (ispace-var-list-alpha-extend (list (car new-params)) (list (car params))
                                       am arm))
  :enable (ispace-var->name ispace-var-list-alpha-extend-of-nil))

(defruled disjoint-of-ispace-var-image-of-cdr-extend
  (implies (and (ispace-var-setp f)
                (ispace-var-listp params)
                (ispace-var-listp new-params)
                (consp new-params)
                (consp params)
                (mv-nth 0 (ispace-var-list-alpha-extend
                           (list (car new-params)) (list (car params)) am arm))
                (no-duplicatesp-equal new-params)
                (set::emptyp
                 (set::intersect
                  (set::mergesort new-params)
                  (ispace-var-set-rename-ispace-vars
                   (set::difference f (set::mergesort params)) am arm))))
           (set::emptyp
            (set::intersect
             (set::mergesort (cdr new-params))
             (ispace-var-set-rename-ispace-vars
              (set::difference f (set::mergesort (cdr params)))
              (mv-nth 1 (ispace-var-list-alpha-extend
                         (list (car new-params)) (list (car params)) am arm))
              (mv-nth 2 (ispace-var-list-alpha-extend
                         (list (car new-params)) (list (car params)) am arm))))))
  :expand ((ispace-var-list-alpha-extend (list (car new-params)) (list (car params))
                                       am arm))
  :enable (ispace-var-list-alpha-extend-of-nil
           mergesort-of-cons
           set::difference-insert-y)
  :use ((:instance disjoint-of-ispace-var-image-of-dim-extend
                   (l (set::mergesort (cdr new-params)))
                   (s (set::difference f (set::mergesort (cdr params))))
                   (n (ispace-var-dim->name (car params)))
                   (n2 (ispace-var-dim->name (car new-params)))
                   (dim-m am) (shape-m arm))
        (:instance disjoint-of-ispace-var-image-of-shape-extend
                   (l (set::mergesort (cdr new-params)))
                   (s (set::difference f (set::mergesort (cdr params))))
                   (n (ispace-var-shape->name (car params)))
                   (n2 (ispace-var-shape->name (car new-params)))
                   (dim-m am) (shape-m arm))
        (:instance disjoint-monotone
                   (l (set::mergesort new-params))
                   (l2 (set::mergesort (cdr new-params)))
                   (x (ispace-var-set-rename-ispace-vars
                       (set::difference f (set::mergesort params)) am arm)))
        (:instance subset-of-mergesort-of-cdr (l new-params))
        (:instance ispace-var-fix-when-dim (x (car params)))
        (:instance ispace-var-fix-when-dim (x (car new-params)))
        (:instance ispace-var-fix-when-shape (x (car params)))
        (:instance ispace-var-fix-when-shape (x (car new-params)))))

(defruled subset-of-mergesort-of-ispace-names-of-cdr
  (set::subset (set::mergesort (ispace-var-list->name (cdr l)))
               (set::mergesort (ispace-var-list->name l)))
  :enable (set::pick-a-point-subset-strategy ispace-var-list->name))

(defruled expr-alpha-fresh-p-of-ilambda-curried-body
  (implies (and (consp (cdr params))
                (ispace-var-listp params)
                (ispace-var-listp new-params)
                (mv-nth 0 (ispace-var-list-alpha-extend new-params params
                                                      (var-renamings->dim r)
                                                      (var-renamings->shape r)))
                (ispace-var-list-fresh-ok new-params params
                                        (var-renamings->dim r)
                                        (var-renamings->shape r)
                                        b)
                (no-duplicatesp-equal new-params)
                (set::emptyp
                 (set::intersect
                  (set::mergesort new-params)
                  (ispace-var-set-rename-ispace-vars
                   (set::difference (expr-free-ispace-vars body)
                                    (set::mergesort params))
                   (var-renamings->dim r)
                   (var-renamings->shape r))))
                (expr-alpha-fresh-p
                 new-body body
                 (change-var-renamings
                  r
                  :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                   new-params params
                                   (var-renamings->dim r)
                                   (var-renamings->shape r)))
                  :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                    new-params params
                                    (var-renamings->dim r)
                                    (var-renamings->shape r))))
                 (set::union
                  (set::mergesort (ispace-var-list->name new-params))
                  (expr-body-support-names
                   body
                   (change-var-renamings
                    r
                    :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                     new-params params
                                     (var-renamings->dim r)
                                     (var-renamings->shape r)))
                    :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                      new-params params
                                      (var-renamings->dim r)
                                      (var-renamings->shape r))))))))
           (expr-alpha-fresh-p
            (ilambda-curried-body new-params new-body)
            (ilambda-curried-body params body)
            (change-var-renamings
             r
             :dim (mv-nth 1 (ispace-var-list-alpha-extend
                              (list (car new-params)) (list (car params))
                              (var-renamings->dim r)
                              (var-renamings->shape r)))
             :shape (mv-nth 2 (ispace-var-list-alpha-extend
                               (list (car new-params)) (list (car params))
                               (var-renamings->dim r)
                               (var-renamings->shape r))))
            (set::insert (ispace-var->name (car new-params)) (string-sfix b))))
  :expand ((:free (a1 a2 r b) (expr-alpha-fresh-p (expr-atom a1) (expr-atom a2) r b))
           (:free (a1 ps bd r b) (atom-alpha-fresh-p a1 (atom-ilambdan ps bd) r b))
           (:free (a1 p bd r b) (atom-alpha-fresh-p a1 (atom-ilambda p bd) r b)))
  :enable (ilambda-curried-body
           make-atom-ilambda/ilambdan
           mergesort-of-cons
           set::difference-insert-y
           difference-of-nil-right
           expr-alpha-fresh-p-anti-monotone
           subset-of-union-right-1
           subset-of-union-right-2
           not-in-when-emptyp-intersect-of-insert)
  :disable ispace-var-list-alpha-extend
  :use ((:instance consp-when-len-equal
                   (a new-params) (b params))
        (:instance consp-of-cdr-when-len-equal
                   (a new-params) (b params))
        (:instance consp-of-cddr-when-len-equal
                   (a new-params) (b params))
        (:instance ispace-var-list-alpha-extend-okp-of-car
                   (am (var-renamings->dim r)) (arm (var-renamings->shape r)))
        (:instance ispace-var-list-alpha-extend-okp-of-cdr
                   (am (var-renamings->dim r)) (arm (var-renamings->shape r)))
        (:instance len-when-ispace-var-list-alpha-extend-okp
                   (new-params (cdr new-params)) (params (cdr params))
                   (dim-m (mv-nth 1 (ispace-var-list-alpha-extend
                                      (list (car new-params)) (list (car params))
                                      (var-renamings->dim r)
                                      (var-renamings->shape r))))
                   (shape-m (mv-nth 2 (ispace-var-list-alpha-extend
                                       (list (car new-params)) (list (car params))
                                       (var-renamings->dim r)
                                       (var-renamings->shape r)))))
        (:instance ispace-var-list-alpha-extend-maps-of-cons
                   (am (var-renamings->dim r)) (arm (var-renamings->shape r)))
        (:instance ispace-var-list-fresh-ok-of-cdr
                   (am (var-renamings->dim r)) (arm (var-renamings->shape r)))
        (:instance disjoint-of-ispace-var-image-of-cdr-extend
                   (f (expr-free-ispace-vars body))
                   (am (var-renamings->dim r)) (arm (var-renamings->shape r)))
        (:instance subset-of-mergesort-of-ispace-names-of-cdr (l new-params))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defruled expr-denv-keys-supported-p-of-ispace-var-extend-1
  (implies (and (expr-denv-keys-supported-p denv r b)
                (ispace-varp p)
                (ispace-varp new-p)
                (mv-nth 0 (ispace-var-list-alpha-extend (list new-p) (list p)
                                                      (var-renamings->dim r)
                                                      (var-renamings->shape r))))
           (expr-denv-keys-supported-p
            denv
            (change-var-renamings
             r
             :dim (mv-nth 1 (ispace-var-list-alpha-extend (list new-p) (list p)
                                                         (var-renamings->dim r)
                                                         (var-renamings->shape r)))
             :shape (mv-nth 2 (ispace-var-list-alpha-extend (list new-p) (list p)
                                                          (var-renamings->dim r)
                                                          (var-renamings->shape r))))
            (set::insert (ispace-var->name new-p) (string-sfix b))))
  :expand ((ispace-var-list-alpha-extend (list new-p) (list p)
                                       (var-renamings->dim r)
                                       (var-renamings->shape r)))
  :enable (expr-denv-keys-supported-p
           ispace-var->name
           ispace-var-list-alpha-extend-of-nil
           string-set-supported-p-of-extend-other
           string-set-supported-p-monotone
           set::subset-insert))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Atoms: n-ary ispace lambda.  The value is a unary ispace closure over the
; first parameter whose body is the curried remainder; its support set is
; the outer one, since the freshness of the remaining parameters is known
; only relative to it.

(defruled eval-atom-when-ilambdan
  (implies (and (equal (atom-kind atom) :ilambdan)
                (not (zp limit)))
           (equal (eval-atom atom denv limit)
                  (make-expr-value-ilambda
                   :param (car (atom-ilambdan->params atom))
                   :body (ilambda-curried-body (atom-ilambdan->params atom)
                                               (atom-ilambdan->body atom))
                   :denv (expr-denv-restrict
                          (atom-free-ispace-vars atom)
                          (expr-free-type-vars (atom-ilambdan->body atom))
                          (expr-free-expr-vars (atom-ilambdan->body atom))
                          denv))))
  :expand ((eval-atom atom denv limit)))

(defruled ilambdan-closure-denv-alpha
  (implies (and (equal (atom-kind atom) :ilambdan)
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-free-ispace-vars atom)
                                           (atom-free-type-vars atom)
                                           (atom-free-expr-vars atom))
                (expr-denv-wfp denv))
           (b* ((ivars (atom-free-ispace-vars atom))
                (tvars (expr-free-type-vars (atom-ilambdan->body atom)))
                (evars (expr-free-expr-vars (atom-ilambdan->body atom)))
                (cdenv (expr-denv-restrict ivars tvars evars denv))
                (new-cdenv (expr-denv-restrict
                            (atom-free-ispace-vars new-atom)
                            (expr-free-type-vars (atom-ilambdan->body new-atom))
                            (expr-free-expr-vars (atom-ilambdan->body new-atom))
                            new-denv))
                ((mv & dim-renam shape-renam)
                 (ispace-var-list-alpha-extend
                  (list (car (atom-ilambdan->params new-atom)))
                  (list (car (atom-ilambdan->params atom)))
                  (var-renamings->dim r)
                  (var-renamings->shape r)))
                (body-r (change-var-renamings r :dim dim-renam :shape shape-renam)))
             (and (expr-denv-alpha-related-via-p new-cdenv cdenv r dw)
                  (expr-denv-keys-within-p cdenv ivars tvars evars)
                  (expr-denv-alpha-avoided-p new-cdenv cdenv r
                                             ivars tvars evars)
                  (expr-denv-keys-supported-p
                   cdenv body-r
                   (set::insert (ispace-var->name (car (atom-ilambdan->params new-atom)))
                                (string-sfix b))))))
  :expand ((atom-alpha-related-p new-atom atom r)
           (atom-alpha-fresh-p new-atom atom r b)
           (atom-free-type-vars atom)
           (atom-free-expr-vars atom))
  :enable (expr-denv-keys-within-p-of-expr-denv-restrict
           subset-of-union-right-1
           subset-of-union-right-2
           expr-denv-keys-supported-p-of-expr-denv-restrict
           expr-denv-keys-supported-p-of-ispace-var-extend-1)
  :disable atom-free-ispace-vars-of-alpha-related
  :use ((:instance ispace-var-list-alpha-extend-okp-of-car
                   (new-params (atom-ilambdan->params new-atom))
                   (params (atom-ilambdan->params atom))
                   (am (var-renamings->dim r)) (arm (var-renamings->shape r)))
        (:instance atom-free-ispace-vars-of-alpha-related
                   (new-a new-atom) (a atom))
        (:instance expr-free-type-vars-of-alpha-related
                   (new-x (atom-ilambdan->body new-atom))
                   (x (atom-ilambdan->body atom))
                   (r (change-var-renamings
                       r
                       :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                        (atom-ilambdan->params new-atom)
                                        (atom-ilambdan->params atom)
                                        (var-renamings->dim r)
                                        (var-renamings->shape r)))
                       :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                         (atom-ilambdan->params new-atom)
                                         (atom-ilambdan->params atom)
                                         (var-renamings->dim r)
                                         (var-renamings->shape r)))))
                   (b (set::union
                       (set::mergesort (ispace-var-list->name (atom-ilambdan->params new-atom)))
                       (expr-body-support-names
                        (atom-ilambdan->body atom)
                        (change-var-renamings
                         r
                         :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                          (atom-ilambdan->params new-atom)
                                          (atom-ilambdan->params atom)
                                          (var-renamings->dim r)
                                          (var-renamings->shape r)))
                         :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                           (atom-ilambdan->params new-atom)
                                           (atom-ilambdan->params atom)
                                           (var-renamings->dim r)
                                           (var-renamings->shape r))))))))
        (:instance expr-free-expr-vars-of-alpha-related
                   (new-x (atom-ilambdan->body new-atom))
                   (x (atom-ilambdan->body atom))
                   (r (change-var-renamings
                       r
                       :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                        (atom-ilambdan->params new-atom)
                                        (atom-ilambdan->params atom)
                                        (var-renamings->dim r)
                                        (var-renamings->shape r)))
                       :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                         (atom-ilambdan->params new-atom)
                                         (atom-ilambdan->params atom)
                                         (var-renamings->dim r)
                                         (var-renamings->shape r)))))
                   (b (set::union
                       (set::mergesort (ispace-var-list->name (atom-ilambdan->params new-atom)))
                       (expr-body-support-names
                        (atom-ilambdan->body atom)
                        (change-var-renamings
                         r
                         :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                          (atom-ilambdan->params new-atom)
                                          (atom-ilambdan->params atom)
                                          (var-renamings->dim r)
                                          (var-renamings->shape r)))
                         :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                           (atom-ilambdan->params new-atom)
                                           (atom-ilambdan->params atom)
                                           (var-renamings->dim r)
                                           (var-renamings->shape r))))))))
        (:instance expr-denv-alpha-related-via-p-of-expr-denv-restrict
                   (ivars (atom-free-ispace-vars atom))
                   (tvars (expr-free-type-vars (atom-ilambdan->body atom)))
                   (evars (expr-free-expr-vars (atom-ilambdan->body atom)))
                   (new-ivars (atom-free-ispace-vars new-atom))
                   (new-tvars (expr-free-type-vars (atom-ilambdan->body new-atom)))
                   (new-evars (expr-free-expr-vars (atom-ilambdan->body new-atom))))
        (:instance expr-denv-alpha-avoided-p-of-expr-denv-restrict
                   (ivars (atom-free-ispace-vars atom))
                   (tvars (expr-free-type-vars (atom-ilambdan->body atom)))
                   (evars (expr-free-expr-vars (atom-ilambdan->body atom)))
                   (ivars1 (atom-free-ispace-vars atom))
                   (tvars1 (expr-free-type-vars (atom-ilambdan->body atom)))
                   (evars1 (expr-free-expr-vars (atom-ilambdan->body atom)))
                   (new-ivars (atom-free-ispace-vars new-atom))
                   (new-tvars (expr-free-type-vars (atom-ilambdan->body new-atom)))
                   (new-evars (expr-free-expr-vars (atom-ilambdan->body new-atom))))))

(defruled eval-atom-ok-when-ilambdan-aux
  (implies (and (equal (atom-kind atom) :ilambdan)
                (not (zp limit))
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-free-ispace-vars atom)
                                           (atom-free-type-vars atom)
                                           (atom-free-expr-vars atom))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((val (eval-atom atom denv limit))
                (new-val (eval-atom new-atom new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((atom-alpha-related-p new-atom atom r)
           (atom-alpha-fresh-p new-atom atom r b)
           (atom-free-ispace-vars atom)
           (:free (new-val w param body cdenv)
            (expr-value-alpha-related-via-p
             new-val (expr-value-ilambda param body cdenv) w)))
  :enable (eval-atom-when-ilambdan
           expr-free-type-vars-of-ilambda-curried-body
           expr-free-ispace-vars-of-ilambda-curried-body
           expr-free-expr-vars-of-ilambda-curried-body
           mergesort-when-consp
           set::difference-insert-y
           not-in-when-emptyp-intersect-of-insert
           consp-of-cdr-of-atom-ilambdan->params
           not-reserrp-when-expr-valuep)
  :disable (atom-free-ispace-vars-of-alpha-related
            not-in-ispace-var-set-when-name-not-in-names
            not-in-type-var-set-when-name-not-in-names
            not-in-ispace-var-set-rename-ispace-vars-when-fresh
            in-of-ispace-var-set-names
            in-ispace-var-set-names-when-in
            set::difference-in
            set::delete-in
            set::in-mergesort-under-iff
            set::delete-nonmember-cancel
            member-equal)
  :use (ilambdan-closure-denv-alpha
        (:instance ispace-var-list-alpha-extend-okp-of-car
                   (new-params (atom-ilambdan->params new-atom))
                   (params (atom-ilambdan->params atom))
                   (am (var-renamings->dim r)) (arm (var-renamings->shape r)))
        (:instance expr-alpha-related-p-of-ilambda-curried-body
                   (new-params (atom-ilambdan->params new-atom))
                   (params (atom-ilambdan->params atom))
                   (new-body (atom-ilambdan->body new-atom))
                   (body (atom-ilambdan->body atom)))
        (:instance expr-alpha-fresh-p-of-ilambda-curried-body
                   (new-params (atom-ilambdan->params new-atom))
                   (params (atom-ilambdan->params atom))
                   (new-body (atom-ilambdan->body new-atom))
                   (body (atom-ilambdan->body atom)))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (eval-atom new-atom new-denv limit))
                   (val (eval-atom atom denv limit))
                   (w (expr-value-witness-closure r '(:leaf) '(:leaf) dw b)))))

(defruled eval-atom-ok-when-ilambdan
  (implies (equal (atom-kind atom) :ilambdan)
           (eval-atom-ok atom denv limit))
  :expand ((eval-atom-ok atom denv limit)
           (:free (new-x r) (atom-alpha-related-p new-x atom r)))
  :cases ((zp limit))
  :enable eval-atom-when-zp-limit
  :use ((:instance eval-atom-ok-when-ilambdan-aux
                   (new-atom (mv-nth 0 (eval-atom-ok-witness atom denv limit)))
                   (new-denv (mv-nth 1 (eval-atom-ok-witness atom denv limit)))
                   (r (mv-nth 2 (eval-atom-ok-witness atom denv limit)))
                   (dw (mv-nth 3 (eval-atom-ok-witness atom denv limit)))
                   (b (mv-nth 4 (eval-atom-ok-witness atom denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Arrays and frames with non-empty dimensions: the value built from
; related element lists by EXPR-VALUE-WITH-NONEMPTY-DIMS are related via
; the witness built by the same arrangement of the elements' witnesses.

(define expr-value-list-list-alpha-related-via-p ((new-valss expr-value-list-listp)
                                                  (valss expr-value-list-listp)
                                                  (wss true-listp))
  :returns (yes/no booleanp)
  :verify-guards nil
  (if (endp valss)
      (endp new-valss)
    (and (consp new-valss)
         (consp wss)
         (equal (len (car wss)) (len (car valss)))
         (expr-value-list-alpha-related-via-p (car new-valss) (car valss) (car wss))
         (expr-value-list-list-alpha-related-via-p (cdr new-valss) (cdr valss)
                                                   (cdr wss)))))

(local
 (defun take-three-induct (n x y z)
   (if (zp n)
       (list x y z)
     (take-three-induct (1- n) (cdr x) (cdr y) (cdr z)))))

(defruled expr-value-list-alpha-related-via-p-of-take
  (implies (and (expr-value-list-alpha-related-via-p new-vals vals ws)
                (<= (nfix n) (len vals)))
           (expr-value-list-alpha-related-via-p (take n new-vals) (take n vals)
                                                (take n ws)))
  :induct (take-three-induct n new-vals vals ws)
  :enable (expr-value-list-alpha-related-via-p len)
  :expand ((take n new-vals) (take n vals) (take n ws)
           (:free (a b c d e) (expr-value-list-alpha-related-via-p (cons a b) (cons c d) e))))

(defruled expr-value-list-alpha-related-via-p-of-nthcdr
  (implies (expr-value-list-alpha-related-via-p new-vals vals ws)
           (expr-value-list-alpha-related-via-p (nthcdr n new-vals) (nthcdr n vals)
                                                (nthcdr n ws)))
  :induct (take-three-induct n new-vals vals ws)
  :enable (expr-value-list-alpha-related-via-p nthcdr))

(defruled len-of-nthcdr-upper
  (<= (len (nthcdr n y)) (len y))
  :rule-classes :linear
  :induct (nthcdr n y)
  :enable (nthcdr len))

(defruled len-of-nthcdr-decreases
  (implies (and (consp y) (posp n))
           (< (len (nthcdr n y)) (len y)))
  :expand ((nthcdr n y) (len y))
  :use ((:instance len-of-nthcdr-upper (n (1- n)) (y (cdr y)))))

(local
 (defun list-split-three-induct (x y z chunk)
   (declare (xargs :measure (len y)
                   :hints (("Goal" :in-theory (enable len-of-nthcdr-decreases)))))
   (if (endp y)
       (list x z)
     (list-split-three-induct (nthcdr (pos-fix chunk) x)
                              (nthcdr (pos-fix chunk) y)
                              (nthcdr (pos-fix chunk) z)
                              chunk))))

(defruled len-of-nthcdr-exact
  (implies (<= (nfix n) (len y))
           (equal (len (nthcdr n y)) (- (len y) (nfix n))))
  :induct (nthcdr n y)
  :enable (nthcdr len))

(defruled chunk-le-len-when-divides
  (implies (and (posp chunk)
                (consp vals)
                (integerp (/ (len vals) chunk)))
           (<= chunk (len vals)))
  :rule-classes :linear
  :use ((:instance lt-to-zero-when-divided-by-pos (x (len vals)) (y chunk))))

(defruled expr-value-list-list-alpha-related-via-p-of-list-split
  (implies (and (expr-value-list-alpha-related-via-p new-vals vals ws)
                (equal (len ws) (len vals))
                (posp chunk)
                (integerp (/ (len vals) chunk)))
           (expr-value-list-list-alpha-related-via-p
            (list-split new-vals chunk)
            (list-split vals chunk)
            (list-split ws chunk)))
  :induct (list-split-three-induct new-vals vals ws chunk)
  :enable (expr-value-list-list-alpha-related-via-p
           expr-value-list-alpha-related-via-p-of-take
           expr-value-list-alpha-related-via-p-of-nthcdr
           len-when-expr-value-list-alpha-related-via-p
           len-of-nthcdr-exact
           chunk-le-len-when-divides
           acl2::len-of-take)
  :disable len
  :expand ((list-split new-vals chunk) (list-split vals chunk) (list-split ws chunk)
           (expr-value-list-alpha-related-via-p new-vals vals ws))
  :hints (("Subgoal *1/2" :use ((:instance integerp-of-div-of-diff
                                           (x (len vals)) (c chunk))
                                (:instance chunk-le-len-when-divides)
                                (:instance expr-value-list-alpha-related-via-p-of-take
                                           (n chunk))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The witness of a value built with non-empty dimensions from related
; element lists: the elements' witnesses arranged the same way (the
; witness list has the elements' length, so that both splits agree).

(defines expr-value-witnesses-with-nonempty-dims
  (define expr-value-witness-with-nonempty-dims ((dims nat-listp)
                                                 (ws expr-value-witness-listp))
    :returns (w expr-value-witness-p)
    :verify-guards nil
    (b* (((when (endp dims)) (expr-value-witness-fix (car ws)))
         (dim (lnfix (car dims)))
         (wss (list-split (expr-value-witness-list-fix ws) (/ (len ws) dim)))
         (ws (expr-value-witness-list-with-nonempty-dims (cdr dims) wss)))
      (expr-value-witness-vector ws))
    :measure (acl2::nat-list-measure (list (len dims) 0 0)))
  (define expr-value-witness-list-with-nonempty-dims ((dims nat-listp)
                                                      (wss true-listp))
    :returns (ws expr-value-witness-listp)
    :verify-guards nil
    (cond ((endp wss) nil)
          (t (cons (expr-value-witness-with-nonempty-dims dims (car wss))
                   (expr-value-witness-list-with-nonempty-dims dims (cdr wss)))))
    :measure (acl2::nat-list-measure (list (len dims) 1 (len wss))))
  :flag-local nil)

(defruled car-when-expr-value-list-alpha-related-via-p
  (implies (and (expr-value-list-alpha-related-via-p new-vals vals ws)
                (< 0 (len vals)))
           (expr-value-alpha-related-via-p (car new-vals) (car vals) (car ws)))
  :expand ((expr-value-list-alpha-related-via-p new-vals vals ws)
           (len vals)))

; The induction carries the three lists along the builders' recursion.

(defines nonempty-dims-alpha-induct
  (define nonempty-dims-alpha-induct ((dims nat-listp) new-vals vals ws)
    :verify-guards nil
    (b* (((when (endp dims)) (list new-vals vals ws))
         (dim (lnfix (car dims)))
         (n (/ (len vals) dim)))
      (nonempty-dims-list-alpha-induct
       (cdr dims)
       (list-split (expr-value-list-fix new-vals) n)
       (list-split (expr-value-list-fix vals) n)
       (list-split (expr-value-witness-list-fix ws) n)))
    :measure (acl2::nat-list-measure (list (len dims) 0 0)))
  (define nonempty-dims-list-alpha-induct ((dims nat-listp) new-valss valss wss)
    :verify-guards nil
    (cond ((endp valss) (list new-valss wss))
          (t (list (nonempty-dims-alpha-induct dims (car new-valss) (car valss)
                                               (car wss))
                   (nonempty-dims-list-alpha-induct dims (cdr new-valss) (cdr valss)
                                                    (cdr wss)))))
    :measure (acl2::nat-list-measure (list (len dims) 1 (len valss))))
  :flag-local nil)

; Arithmetic of the chunking: the chunk is a positive integer, and it
; divides the length exactly (the quotient being the first dimension).

(defruled posp-of-len-over-car-dims
  (implies (and (nat-listp dims)
                (not (member-equal 0 dims))
                (consp dims)
                (equal (len vals) (nat-list-product dims)))
           (posp (* (/ (car dims)) (len vals))))
  :enable posp
  :use nat-list-product-divided-by-car
  :prep-books ((include-book "arithmetic-3/top" :dir :system)))

(defruled integerp-of-len-over-chunk
  (implies (and (integerp d)
                (not (equal d 0))
                (natp l)
                (not (equal l 0)))
           (integerp (/ l (* (/ d) l))))
  :prep-books ((include-book "arithmetic-5/top" :dir :system)))

(defthm-nonempty-dims-alpha-induct-flag
  (defthm expr-value-with-nonempty-dims-alpha
    (implies (and (nat-listp dims)
                  (not (member-equal 0 dims))
                  (equal (len vals) (nat-list-product dims))
                  (equal (len ws) (len vals))
                  (expr-value-list-alpha-related-via-p new-vals vals ws))
             (expr-value-alpha-related-via-p
              (expr-value-with-nonempty-dims dims new-vals)
              (expr-value-with-nonempty-dims dims vals)
              (expr-value-witness-with-nonempty-dims dims ws)))
    :flag nonempty-dims-alpha-induct)
  (defthm expr-value-list-with-nonempty-dims-alpha
    (implies (and (nat-listp dims)
                  (not (member-equal 0 dims))
                  (all-of-len-p valss (nat-list-product dims))
                  (expr-value-list-list-alpha-related-via-p new-valss valss wss))
             (expr-value-list-alpha-related-via-p
              (expr-value-list-with-nonempty-dims dims new-valss)
              (expr-value-list-with-nonempty-dims dims valss)
              (expr-value-witness-list-with-nonempty-dims dims wss)))
    :flag nonempty-dims-list-alpha-induct)
  :hints (("Goal"
           :in-theory (e/d (expr-value-with-nonempty-dims
                            expr-value-list-with-nonempty-dims
                            expr-value-witness-with-nonempty-dims
                            expr-value-witness-list-with-nonempty-dims
                            expr-value-list-list-alpha-related-via-p
                            len-when-expr-value-list-alpha-related-via-p
                            car-when-expr-value-list-alpha-related-via-p
                            nat-list-product-of-cdr-to-ratio
                            all-of-len-p
                            pos-fix
                            posp-of-len-over-car-dims
                            integerp-of-len-over-chunk)
                           (len))
           :expand ((expr-value-witness-with-nonempty-dims dims ws)
                    (expr-value-with-nonempty-dims dims new-vals)
                    (expr-value-with-nonempty-dims dims vals)
                    (expr-value-witness-list-with-nonempty-dims dims wss)
                    (expr-value-list-with-nonempty-dims dims new-valss)
                    (expr-value-list-with-nonempty-dims dims valss)
                    (:free (a b w)
                     (expr-value-alpha-related-via-p a (expr-value-vector b) w))
                    (:free (w) (expr-value-list-alpha-related-via-p nil nil w))
                    (:free (a b c d e f)
                     (expr-value-list-alpha-related-via-p (cons a b) (cons c d)
                                                          (cons e f)))))
          (and stable-under-simplificationp
               '(:use ((:instance expr-value-list-list-alpha-related-via-p-of-list-split
                                  (new-vals (expr-value-list-fix new-vals))
                                  (vals (expr-value-list-fix vals))
                                  (ws (expr-value-witness-list-fix ws))
                                  (chunk (* (/ (car dims)) (len vals))))
                       (:instance posp-of-len-over-car-dims)
                       (:instance integerp-of-len-over-chunk
                                  (d (car dims)) (l (len vals))))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Truncating a witness list to the values' length keeps the relation.

(defruled expr-value-list-alpha-related-via-p-of-take-witness
  (implies (expr-value-list-alpha-related-via-p new-vals vals ws)
           (expr-value-list-alpha-related-via-p new-vals vals (take (len vals) ws)))
  :induct (three-cdrs-induct new-vals vals ws)
  :enable (three-cdrs-induct
           expr-value-list-alpha-related-via-p len)
  :expand ((:free (n) (take n ws))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Expressions: arrays and frames with non-empty dimensions.  The element
; lists are related by the induction hypothesis, with equal lengths and
; dimensions, so the arrangement checks agree and the arranged values are
; related via the arranged witnesses.

(defruled eval-expr-ok-when-array
  (implies (and (equal (expr-kind expr) :array)
                (implies (not (member-equal 0 (expr-array->dims expr)))
                         (eval-atom-list-ok (expr-array->atoms expr) denv (1- limit))))
           (eval-expr-ok expr denv limit))
  :expand ((eval-expr-ok expr denv limit)
           (:free (x d) (eval-expr x d limit))
           (:free (new-x r) (expr-alpha-related-p new-x expr r))
           (:free (new-x r b) (expr-alpha-fresh-p new-x expr r b))
           (expr-free-ispace-vars expr)
           (expr-free-type-vars expr)
           (expr-free-expr-vars expr))
  :enable (len-when-expr-value-list-alpha-related-via-p
           dims-of-expr-value-list-when-alpha-related
           expr-value-list-wfp-of-eval-atom-list
           not-reserrp-when-expr-valuep
           acl2::len-of-take)
  :disable expr-value-with-nonempty-dims-alpha
  :use ((:instance eval-atom-list-ok-necc
                   (atoms (expr-array->atoms expr))
                   (limit (1- limit))
                   (new-atoms (expr-array->atoms
                               (mv-nth 0 (eval-expr-ok-witness expr denv limit))))
                   (new-denv (mv-nth 1 (eval-expr-ok-witness expr denv limit)))
                   (r (mv-nth 2 (eval-expr-ok-witness expr denv limit)))
                   (dw (mv-nth 3 (eval-expr-ok-witness expr denv limit)))
                   (b (mv-nth 4 (eval-expr-ok-witness expr denv limit))))
        (:instance expr-value-list-alpha-equiv-p
                   (new-vals (eval-atom-list
                              (expr-array->atoms
                               (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                              (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                              (1- limit)))
                   (vals (eval-atom-list (expr-array->atoms expr) denv (1- limit))))
        (:instance expr-value-list-alpha-related-via-p-of-take-witness
                   (new-vals (eval-atom-list
                              (expr-array->atoms
                               (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                              (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                              (1- limit)))
                   (vals (eval-atom-list (expr-array->atoms expr) denv (1- limit)))
                   (ws (expr-value-list-alpha-equiv-p-witness
                        (eval-atom-list
                         (expr-array->atoms
                          (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                         (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                         (1- limit))
                        (eval-atom-list (expr-array->atoms expr) denv (1- limit)))))
        (:instance expr-value-with-nonempty-dims-alpha
                   (dims (expr-array->dims expr))
                   (new-vals (eval-atom-list
                              (expr-array->atoms
                               (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                              (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                              (1- limit)))
                   (vals (eval-atom-list (expr-array->atoms expr) denv (1- limit)))
                   (ws (take (len (eval-atom-list (expr-array->atoms expr) denv (1- limit)))
                             (expr-value-list-alpha-equiv-p-witness
                              (eval-atom-list
                               (expr-array->atoms
                                (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                               (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                               (1- limit))
                              (eval-atom-list (expr-array->atoms expr) denv (1- limit))))))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (expr-value-with-nonempty-dims
                             (expr-array->dims expr)
                             (eval-atom-list
                              (expr-array->atoms
                               (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                              (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                              (1- limit))))
                   (val (expr-value-with-nonempty-dims
                         (expr-array->dims expr)
                         (eval-atom-list (expr-array->atoms expr) denv (1- limit))))
                   (w (expr-value-witness-with-nonempty-dims
                       (expr-array->dims expr)
                       (take (len (eval-atom-list (expr-array->atoms expr) denv (1- limit)))
                             (expr-value-list-alpha-equiv-p-witness
                              (eval-atom-list
                               (expr-array->atoms
                                (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                               (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                               (1- limit))
                              (eval-atom-list (expr-array->atoms expr) denv (1- limit)))))))))

(defruled eval-expr-ok-when-frame
  (implies (and (equal (expr-kind expr) :frame)
                (implies (not (member-equal 0 (expr-frame->dims expr)))
                         (eval-expr-list-ok (expr-frame->exprs expr) denv (1- limit))))
           (eval-expr-ok expr denv limit))
  :expand ((eval-expr-ok expr denv limit)
           (:free (x d) (eval-expr x d limit))
           (:free (new-x r) (expr-alpha-related-p new-x expr r))
           (:free (new-x r b) (expr-alpha-fresh-p new-x expr r b))
           (expr-free-ispace-vars expr)
           (expr-free-type-vars expr)
           (expr-free-expr-vars expr))
  :enable (len-when-expr-value-list-alpha-related-via-p
           dims-of-expr-value-list-when-alpha-related
           expr-value-list-wfp-of-eval-expr-list
           not-reserrp-when-expr-valuep
           acl2::len-of-take)
  :disable expr-value-with-nonempty-dims-alpha
  :use ((:instance eval-expr-list-ok-necc
                   (exprs (expr-frame->exprs expr))
                   (limit (1- limit))
                   (new-exprs (expr-frame->exprs
                               (mv-nth 0 (eval-expr-ok-witness expr denv limit))))
                   (new-denv (mv-nth 1 (eval-expr-ok-witness expr denv limit)))
                   (r (mv-nth 2 (eval-expr-ok-witness expr denv limit)))
                   (dw (mv-nth 3 (eval-expr-ok-witness expr denv limit)))
                   (b (mv-nth 4 (eval-expr-ok-witness expr denv limit))))
        (:instance expr-value-list-alpha-equiv-p
                   (new-vals (eval-expr-list
                              (expr-frame->exprs
                               (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                              (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                              (1- limit)))
                   (vals (eval-expr-list (expr-frame->exprs expr) denv (1- limit))))
        (:instance expr-value-list-alpha-related-via-p-of-take-witness
                   (new-vals (eval-expr-list
                              (expr-frame->exprs
                               (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                              (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                              (1- limit)))
                   (vals (eval-expr-list (expr-frame->exprs expr) denv (1- limit)))
                   (ws (expr-value-list-alpha-equiv-p-witness
                        (eval-expr-list
                         (expr-frame->exprs
                          (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                         (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                         (1- limit))
                        (eval-expr-list (expr-frame->exprs expr) denv (1- limit)))))
        (:instance expr-value-with-nonempty-dims-alpha
                   (dims (expr-frame->dims expr))
                   (new-vals (eval-expr-list
                              (expr-frame->exprs
                               (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                              (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                              (1- limit)))
                   (vals (eval-expr-list (expr-frame->exprs expr) denv (1- limit)))
                   (ws (take (len (eval-expr-list (expr-frame->exprs expr) denv (1- limit)))
                             (expr-value-list-alpha-equiv-p-witness
                              (eval-expr-list
                               (expr-frame->exprs
                                (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                               (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                               (1- limit))
                              (eval-expr-list (expr-frame->exprs expr) denv (1- limit))))))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (expr-value-with-nonempty-dims
                             (expr-frame->dims expr)
                             (eval-expr-list
                              (expr-frame->exprs
                               (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                              (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                              (1- limit))))
                   (val (expr-value-with-nonempty-dims
                         (expr-frame->dims expr)
                         (eval-expr-list (expr-frame->exprs expr) denv (1- limit))))
                   (w (expr-value-witness-with-nonempty-dims
                       (expr-frame->dims expr)
                       (take (len (eval-expr-list (expr-frame->exprs expr) denv (1- limit)))
                             (expr-value-list-alpha-equiv-p-witness
                              (eval-expr-list
                               (expr-frame->exprs
                                (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                               (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                               (1- limit))
                              (eval-expr-list (expr-frame->exprs expr) denv (1- limit)))))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Binds.  The type layers of the environment relations do not depend on
; the expression-variable renaming, so extending that renaming (as a
; value bind does) leaves them unchanged.

(defruled eval-bind-when-zp-limit
  (implies (zp limit)
           (equal (eval-bind bind denv limit)
                  (reserr :limit)))
  :expand ((eval-bind bind denv limit)))

(defruled type-var-type-value-map-alpha-related-via-p-of-change-expr
  (equal (type-var-type-value-map-alpha-related-via-p
          new-map map (change-var-renamings r :expr m) wmap)
         (type-var-type-value-map-alpha-related-via-p new-map map r wmap))
  :induct (omap::size map)
  :enable omap::size
  :expand ((:free (r) (type-var-type-value-map-alpha-related-via-p
                       new-map map r wmap))))

(defruled type-denv-alpha-related-via-p-of-change-expr
  (equal (type-denv-alpha-related-via-p
          new-tenv tenv (change-var-renamings r :expr m) wmap)
         (type-denv-alpha-related-via-p new-tenv tenv r wmap))
  :expand ((:free (r) (type-denv-alpha-related-via-p new-tenv tenv r wmap)))
  :enable type-var-type-value-map-alpha-related-via-p-of-change-expr)

(defruled type-denv-alpha-avoided-p-of-change-expr
  (equal (type-denv-alpha-avoided-p
          new-tenv tenv (change-var-renamings r :expr m) ivars tvars)
         (type-denv-alpha-avoided-p new-tenv tenv r ivars tvars))
  :enable type-denv-alpha-avoided-p)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Environment extension by an expression variable, in the form the bind
; and closure-application cases use: the new name must not be the
; renaming of any other key of the original map (success direction), nor
; of any other variable of the avoided set (failure direction).

(defruled expr-denv-alpha-related-via-p-of-add-expr
  (implies (and (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-value-alpha-related-via-p new-val val w)
                (stringp name)
                (stringp new-name)
                (expr-valuep val)
                (expr-valuep new-val)
                (expr-value-witness-p w)
                (not (set::in new-name
                              (rename-var-string-set
                               (set::delete name (omap::keys (expr-denv->exprs denv)))
                               (var-renamings->expr r)))))
           (expr-denv-alpha-related-via-p
            (expr-denv-add-expr new-name new-val new-denv)
            (expr-denv-add-expr name val denv)
            (change-var-renamings r :expr (extend-renaming name new-name
                                                           (var-renamings->expr r)))
            (change-denv-witness dw :exprs (omap::update name w
                                                         (denv-witness->exprs dw)))))
  :expand ((:free (a b r dw) (expr-denv-alpha-related-via-p a b r dw)))
  :enable (expr-denv-add-expr
           type-denv-alpha-related-via-p-of-change-expr
           string-expr-value-map-alpha-related-via-p-when-covered-p
           string-expr-value-map-covered-p-when-alpha-related-via-p)
  :use ((:instance string-expr-value-map-covered-p-of-update-extend-image
                   (new-map (expr-denv->exprs new-denv))
                   (map (expr-denv->exprs denv))
                   (renam (var-renamings->expr r))
                   (wmap (denv-witness->exprs dw)))))

(defruled expr-denv-keys-supported-p-of-add-expr
  (implies (and (expr-denv-keys-supported-p denv r b)
                (stringp name)
                (stringp new-name))
           (expr-denv-keys-supported-p
            (expr-denv-add-expr name val denv)
            (change-var-renamings r :expr (extend-renaming name new-name
                                                           (var-renamings->expr r)))
            (set::insert new-name (string-sfix b))))
  :enable (expr-denv-keys-supported-p
           expr-denv-add-expr
           omap::keys-of-update
           string-set-supported-p-of-insert-extend
           string-set-supported-p-monotone
           set::subset-insert))

(defruled expr-denv-alpha-avoided-p-of-add-expr
  (implies (and (expr-denv-alpha-avoided-p new-denv denv r ivars tvars
                                           (set::delete name (string-sfix evars)))
                (stringp name)
                (stringp new-name)
                (expr-valuep val)
                (expr-valuep new-val)
                (not (set::in new-name
                              (rename-var-string-set
                               (set::delete name (string-sfix evars))
                               (var-renamings->expr r)))))
           (expr-denv-alpha-avoided-p
            (expr-denv-add-expr new-name new-val new-denv)
            (expr-denv-add-expr name val denv)
            (change-var-renamings r :expr (extend-renaming name new-name
                                                           (var-renamings->expr r)))
            ivars tvars evars))
  :expand ((:free (a b r i tv e) (expr-denv-alpha-avoided-p a b r i tv e)))
  :enable (expr-denv-add-expr
           type-denv-alpha-avoided-p-of-change-expr)
  :use ((:instance string-expr-value-map-avoided-p-of-update-extend-image
                   (new-map (expr-denv->exprs new-denv))
                   (map (expr-denv->exprs denv))
                   (renam (var-renamings->expr r))
                   (vars evars))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Extension of the ispace layer of the environments by one variable, in
; image form (the new variable is not the renaming of any other key of
; the original environment), for the dimension namespace.  These mirror
; the expression-layer lemmas above (EXPR-DENV-ALPHA-RELATED-VIA-P-OF-ADD-EXPR
; and companions), and serve the ispace binds and the ispace applications.

(defruled denv-ispace-vars-covered-p-of-add-dim-extend-image
  (implies (and (denv-ispace-vars-covered-p new-ienv ienv dim-renam shape-renam)
                (ispace-varp var)
                (ispace-varp new-var)
                (ispace-var-case var :dim)
                (ispace-var-case new-var :dim)
                (not (set::in new-var
                              (ispace-var-set-rename-ispace-vars
                               (set::delete var (omap::keys (ispace-denv->ispaces ienv)))
                               dim-renam shape-renam))))
           (denv-ispace-vars-covered-p
            (ispace-denv-add-ispace new-var ival new-ienv)
            (ispace-denv-add-ispace var ival ienv)
            (extend-renaming (ispace-var-dim->name var)
                             (ispace-var-dim->name new-var)
                             dim-renam)
            shape-renam))
  :expand ((:free (m1 m2 d s)
            (denv-ispace-vars-covered-p (ispace-denv m1) (ispace-denv m2) d s)))
  :enable (ispace-denv-add-ispace
           rename-ispace-var-of-dim-extend
           omap::assoc-of-update
           omap::in-of-keys-to-assoc
           ispace-var-equal-by-dim-name)
  :use ((:instance denv-ispace-vars-covered-p-necc
                   (new-denv new-ienv) (denv ienv)
                   (var (denv-ispace-vars-covered-p-witness
                         (ispace-denv
                          (omap::update new-var (ispace-value-fix ival)
                                        (ispace-denv->ispaces new-ienv)))
                         (ispace-denv
                          (omap::update var (ispace-value-fix ival)
                                        (ispace-denv->ispaces ienv)))
                         (extend-renaming (ispace-var-dim->name var)
                                          (ispace-var-dim->name new-var)
                                          dim-renam)
                         shape-renam)))
        (:instance in-of-rename-ispace-var-of-ispace-var-set-rename-ispace-vars
                   (var (denv-ispace-vars-covered-p-witness
                         (ispace-denv
                          (omap::update new-var (ispace-value-fix ival)
                                        (ispace-denv->ispaces new-ienv)))
                         (ispace-denv
                          (omap::update var (ispace-value-fix ival)
                                        (ispace-denv->ispaces ienv)))
                         (extend-renaming (ispace-var-dim->name var)
                                          (ispace-var-dim->name new-var)
                                          dim-renam)
                         shape-renam))
                   (vars (set::delete var (omap::keys (ispace-denv->ispaces ienv)))))))

(defruled denv-ispace-vars-avoided-p-of-add-dim-extend-image
  (implies (and (denv-ispace-vars-avoided-p new-ienv ienv dim-renam shape-renam
                                            (set::delete var (ispace-var-set-fix vars)))
                (ispace-varp var)
                (ispace-varp new-var)
                (ispace-var-case var :dim)
                (ispace-var-case new-var :dim)
                (not (set::in new-var
                              (ispace-var-set-rename-ispace-vars
                               (set::delete var (ispace-var-set-fix vars))
                               dim-renam shape-renam))))
           (denv-ispace-vars-avoided-p
            (ispace-denv-add-ispace new-var ival new-ienv)
            (ispace-denv-add-ispace var ival ienv)
            (extend-renaming (ispace-var-dim->name var)
                             (ispace-var-dim->name new-var)
                             dim-renam)
            shape-renam
            vars))
  :expand ((:free (m1 m2 d s)
            (denv-ispace-vars-avoided-p (ispace-denv m1) (ispace-denv m2) d s vars)))
  :enable (ispace-denv-add-ispace
           rename-ispace-var-of-dim-extend
           omap::assoc-of-update
           ispace-var-equal-by-dim-name)
  :use ((:instance denv-ispace-vars-avoided-p-necc
                   (new-denv new-ienv) (denv ienv)
                   (vars (set::delete var (ispace-var-set-fix vars)))
                   (var (denv-ispace-vars-avoided-p-witness
                         (ispace-denv
                          (omap::update new-var (ispace-value-fix ival)
                                        (ispace-denv->ispaces new-ienv)))
                         (ispace-denv
                          (omap::update var (ispace-value-fix ival)
                                        (ispace-denv->ispaces ienv)))
                         (extend-renaming (ispace-var-dim->name var)
                                          (ispace-var-dim->name new-var)
                                          dim-renam)
                         shape-renam
                         vars)))
        (:instance in-of-rename-ispace-var-of-ispace-var-set-rename-ispace-vars
                   (var (denv-ispace-vars-avoided-p-witness
                         (ispace-denv
                          (omap::update new-var (ispace-value-fix ival)
                                        (ispace-denv->ispaces new-ienv)))
                         (ispace-denv
                          (omap::update var (ispace-value-fix ival)
                                        (ispace-denv->ispaces ienv)))
                         (extend-renaming (ispace-var-dim->name var)
                                          (ispace-var-dim->name new-var)
                                          dim-renam)
                         shape-renam
                         vars))
                   (vars (set::delete var (ispace-var-set-fix vars))))))

; The name-freshness conditions and the support invariant exclude, in the
; dimension namespace, the collision of a new variable with the renaming
; of any other key.

(defruled in-dim-names-of-ispace-vars-when-in
  (implies (and (ispace-var-setp keys)
                (set::in x keys)
                (equal (ispace-var-kind x) :dim))
           (set::in (ispace-var-dim->name x)
                    (mv-nth 0 (dim/shape-names-of-ispace-vars keys))))
  :use ((:instance ispace-var-fix-when-dim)))

(defruled rename-ispace-var-dim-collision-refuted
  (implies (and (ispace-varp x)
                (ispace-var-setp keys)
                (set::in x keys)
                (not (equal x (ispace-var-dim name)))
                (name-fresh-ok name new-name dim-renam b)
                (string-set-supported-p
                 (mv-nth 0 (dim/shape-names-of-ispace-vars keys)) dim-renam b)
                (stringp name)
                (stringp new-name))
           (not (equal (rename-ispace-var x dim-renam shape-renam)
                       (ispace-var-dim new-name))))
  :enable (name-fresh-ok
           rename-ispace-var
           rename-var-string
           equal-of-ispace-var-dim
           omap::assoc-of-delete
           in-when-string-set-supported-p
           in-dim-names-of-ispace-vars-when-in)
  :use ((:instance omap::cdr-assoc-in-values
                   (omap::key (ispace-var-dim->name x))
                   (omap::map (omap::delete name (string-string-map-fix dim-renam))))
        (:instance omap::in-of-keys-to-assoc
                   (omap::key (ispace-var-dim->name x))
                   (omap::map (string-string-map-fix dim-renam)))))

(defruled not-in-dim-image-of-keys-when-name-fresh-ok-and-supported
  (implies (and (name-fresh-ok name new-name dim-renam b)
                (string-set-supported-p
                 (mv-nth 0 (dim/shape-names-of-ispace-vars keys)) dim-renam b)
                (ispace-var-setp keys)
                (stringp name)
                (stringp new-name))
           (not (set::in (ispace-var-dim new-name)
                         (ispace-var-set-rename-ispace-vars
                          (set::delete (ispace-var-dim name) keys)
                          dim-renam shape-renam))))
  :use ((:instance ispace-var-set-rename-ispace-vars-preimage-witnesses
                   (y (ispace-var-dim new-name))
                   (vars (set::delete (ispace-var-dim name) keys)))
        (:instance rename-ispace-var-dim-collision-refuted
                   (x (ispace-var-set-rename-ispace-vars-preimage
                       (ispace-var-dim new-name)
                       (set::delete (ispace-var-dim name) keys)
                       dim-renam shape-renam)))))

; The type-variable layer does not depend on the ispace renamings.

(defruled type-var-type-value-map-alpha-related-via-p-of-change-dim
  (equal (type-var-type-value-map-alpha-related-via-p
          new-map map (change-var-renamings r :dim m) wmap)
         (type-var-type-value-map-alpha-related-via-p new-map map r wmap))
  :induct (omap::size map)
  :enable omap::size
  :expand ((:free (r) (type-var-type-value-map-alpha-related-via-p
                       new-map map r wmap))))

(defruled expr-denv-alpha-related-via-p-of-add-ispace-dim
  (implies (and (expr-denv-alpha-related-via-p new-denv denv r dw)
                (ispace-varp var)
                (ispace-varp new-var)
                (ispace-var-case var :dim)
                (ispace-var-case new-var :dim)
                (not (set::in new-var
                              (ispace-var-set-rename-ispace-vars
                               (set::delete var
                                            (omap::keys
                                             (ispace-denv->ispaces
                                              (type-denv->ienv
                                               (expr-denv->tenv denv)))))
                               (var-renamings->dim r)
                               (var-renamings->shape r)))))
           (expr-denv-alpha-related-via-p
            (expr-denv-add-ispace new-var ival new-denv)
            (expr-denv-add-ispace var ival denv)
            (change-var-renamings r :dim (extend-renaming (ispace-var-dim->name var)
                                                          (ispace-var-dim->name new-var)
                                                          (var-renamings->dim r)))
            dw))
  :expand ((:free (a b r dw) (expr-denv-alpha-related-via-p a b r dw))
           (:free (a b r wm) (type-denv-alpha-related-via-p a b r wm)))
  :enable (expr-denv-add-ispace
           type-denv-add-ispace
           type-var-type-value-map-alpha-related-via-p-of-change-dim)
  :use ((:instance denv-ispace-vars-covered-p-of-add-dim-extend-image
                   (new-ienv (type-denv->ienv (expr-denv->tenv new-denv)))
                   (ienv (type-denv->ienv (expr-denv->tenv denv)))
                   (dim-renam (var-renamings->dim r))
                   (shape-renam (var-renamings->shape r)))))

(defruled expr-denv-keys-supported-p-of-add-ispace-dim
  (implies (and (expr-denv-keys-supported-p denv r b)
                (ispace-varp var)
                (ispace-var-case var :dim)
                (stringp new-name))
           (expr-denv-keys-supported-p
            (expr-denv-add-ispace var ival denv)
            (change-var-renamings r :dim (extend-renaming (ispace-var-dim->name var)
                                                          new-name
                                                          (var-renamings->dim r)))
            (set::insert new-name (string-sfix b))))
  :enable (expr-denv-keys-supported-p
           expr-denv-add-ispace
           type-denv-add-ispace
           ispace-denv-add-ispace
           omap::keys-of-update
           string-set-supported-p-of-insert-extend
           string-set-supported-p-monotone
           set::subset-insert))

(defruled expr-denv-alpha-avoided-p-of-add-ispace-dim
  (implies (and (expr-denv-alpha-avoided-p new-denv denv r
                                           (set::delete var (ispace-var-set-fix ivars))
                                           tvars evars)
                (ispace-varp var)
                (ispace-varp new-var)
                (ispace-var-case var :dim)
                (ispace-var-case new-var :dim)
                (not (set::in new-var
                              (ispace-var-set-rename-ispace-vars
                               (set::delete var (ispace-var-set-fix ivars))
                               (var-renamings->dim r)
                               (var-renamings->shape r)))))
           (expr-denv-alpha-avoided-p
            (expr-denv-add-ispace new-var ival new-denv)
            (expr-denv-add-ispace var ival denv)
            (change-var-renamings r :dim (extend-renaming (ispace-var-dim->name var)
                                                          (ispace-var-dim->name new-var)
                                                          (var-renamings->dim r)))
            ivars tvars evars))
  :expand ((:free (a b r i tv e) (expr-denv-alpha-avoided-p a b r i tv e)))
  :enable (expr-denv-add-ispace
           type-denv-add-ispace
           type-denv-alpha-avoided-p)
  :use ((:instance denv-ispace-vars-avoided-p-of-add-dim-extend-image
                   (new-ienv (type-denv->ienv (expr-denv->tenv new-denv)))
                   (ienv (type-denv->ienv (expr-denv->tenv denv)))
                   (dim-renam (var-renamings->dim r))
                   (shape-renam (var-renamings->shape r))
                   (vars ivars))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The shape-namespace mirrors of the dimension-namespace lemmas above.

(defruled denv-ispace-vars-covered-p-of-add-shape-extend-image
  (implies (and (denv-ispace-vars-covered-p new-ienv ienv dim-renam shape-renam)
                (ispace-varp var)
                (ispace-varp new-var)
                (ispace-var-case var :shape)
                (ispace-var-case new-var :shape)
                (not (set::in new-var
