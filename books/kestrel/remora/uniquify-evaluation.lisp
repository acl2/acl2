;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The list-level lemmas below were developed with arithmetic-3 loaded;
; it is included locally for their proofs only.

(encapsulate ()

(local (include-book "arithmetic-3/top" :dir :system))

; List-level helpers for the array primitives: indexing, reversal, and the
; chunking/transposition/flattening of related (existentially) value lists.

(local
 (defun nth-two-induct (i x y)
   (if (zp i)
       (list x y)
     (nth-two-induct (1- i) (cdr x) (cdr y)))))

(defruled expr-value-list-alpha-related-via-p-of-append-gen
  (implies (and (expr-value-list-alpha-related-via-p new-vals1 vals1 ws1)
                (expr-value-list-alpha-related-via-p new-vals2 vals2 ws2))
           (expr-value-list-alpha-related-via-p (append new-vals1 new-vals2)
                                                (append vals1 vals2)
                                                (append (take (len vals1) ws1) ws2)))
  :induct (three-cdrs-induct-eq new-vals1 vals1 ws1)
  :enable (expr-value-list-alpha-related-via-p take len))

(defruled expr-value-list-alpha-equiv-p-of-append-gen
  (implies (and (expr-value-list-alpha-equiv-p new-vals1 vals1)
                (expr-value-list-alpha-equiv-p new-vals2 vals2))
           (expr-value-list-alpha-equiv-p (append new-vals1 new-vals2)
                                          (append vals1 vals2)))
  :expand ((expr-value-list-alpha-equiv-p new-vals1 vals1)
           (expr-value-list-alpha-equiv-p new-vals2 vals2))
  :use ((:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals (append new-vals1 new-vals2))
                   (vals (append vals1 vals2))
                   (ws (append (take (len vals1)
                                     (expr-value-list-alpha-equiv-p-witness new-vals1 vals1))
                               (expr-value-list-alpha-equiv-p-witness new-vals2 vals2)))))
  :enable expr-value-list-alpha-related-via-p-of-append-gen)

(defruled nth-when-expr-value-list-alpha-equiv-p
  (implies (and (expr-value-list-alpha-equiv-p new-vals vals)
                (natp i)
                (< i (len vals)))
           (expr-value-alpha-equiv-p (nth i new-vals) (nth i vals)))
  :induct (nth-two-induct i vals new-vals)
  :enable (nth
           consp-when-expr-value-list-alpha-equiv-p
           expr-value-alpha-equiv-p-of-car-when-list-alpha-equiv
           expr-value-list-alpha-equiv-p-of-cdr-when-list-alpha-equiv))

(defruled expr-value-list-alpha-equiv-p-of-singleton-when-equiv
  (implies (expr-value-alpha-equiv-p new-val val)
           (expr-value-list-alpha-equiv-p (list new-val) (list val)))
  :expand ((expr-value-alpha-equiv-p new-val val))
  :enable expr-value-list-alpha-equiv-p-of-singleton)

(defruled expr-value-list-alpha-equiv-p-of-rev
  (implies (expr-value-list-alpha-equiv-p new-vals vals)
           (expr-value-list-alpha-equiv-p (rev new-vals) (rev vals)))
  :induct (two-cdrs-induct vals new-vals)
  :enable (rev
           consp-when-expr-value-list-alpha-equiv-p
           expr-value-alpha-equiv-p-of-car-when-list-alpha-equiv
           expr-value-list-alpha-equiv-p-of-cdr-when-list-alpha-equiv
           expr-value-list-alpha-equiv-p-of-singleton-when-equiv
           expr-value-list-alpha-equiv-p-of-append
           expr-value-list-alpha-equiv-p-of-nil))

; Lists of lists.

(define expr-value-list-list-alpha-equiv-p ((new-valss expr-value-list-listp)
                                            (valss expr-value-list-listp))
  :returns (yes/no booleanp)
  :verify-guards nil
  (if (not (consp valss))
      (not (consp new-valss))
    (and (consp new-valss)
         (expr-value-list-alpha-equiv-p (car new-valss) (car valss))
         (expr-value-list-list-alpha-equiv-p (cdr new-valss) (cdr valss)))))

(defruled expr-value-list-alpha-equiv-p-of-cons
  (implies (and (expr-value-alpha-equiv-p new-val val)
                (expr-value-list-alpha-equiv-p new-vals vals))
           (expr-value-list-alpha-equiv-p (cons new-val new-vals)
                                          (cons val vals)))
  :expand ((expr-value-alpha-equiv-p new-val val)
           (expr-value-list-alpha-equiv-p new-vals vals))
  :use ((:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals (cons new-val new-vals))
                   (vals (cons val vals))
                   (ws (cons (expr-value-alpha-equiv-p-witness new-val val)
                             (expr-value-list-alpha-equiv-p-witness new-vals vals)))))
  :enable expr-value-list-alpha-related-via-p)

(defruled expr-value-list-alpha-equiv-p-of-cdr
  (implies (expr-value-list-alpha-equiv-p new-vals vals)
           (expr-value-list-alpha-equiv-p (cdr new-vals) (cdr vals)))
  :use (expr-value-list-alpha-equiv-p-of-cdr-when-list-alpha-equiv
        consp-when-expr-value-list-alpha-equiv-p)
  :enable expr-value-list-alpha-equiv-p-of-nil)

(defruled expr-value-list-alpha-equiv-p-of-take
  (implies (and (expr-value-list-alpha-equiv-p new-vals vals)
                (<= (nfix n) (len vals)))
           (expr-value-list-alpha-equiv-p (take n new-vals) (take n vals)))
  :induct (nth-two-induct n vals new-vals)
  :enable (take
           consp-when-expr-value-list-alpha-equiv-p
           expr-value-alpha-equiv-p-of-car-when-list-alpha-equiv
           expr-value-list-alpha-equiv-p-of-cdr-when-list-alpha-equiv
           expr-value-list-alpha-equiv-p-of-cons
           expr-value-list-alpha-equiv-p-of-nil))

(defruled expr-value-list-alpha-equiv-p-of-nthcdr
  (implies (expr-value-list-alpha-equiv-p new-vals vals)
           (expr-value-list-alpha-equiv-p (nthcdr n new-vals) (nthcdr n vals)))
  :induct (nth-two-induct n vals new-vals)
  :enable (nthcdr
           expr-value-list-alpha-equiv-p-of-cdr))

(local
 (defruled len-of-nthcdr-upper-local
   (<= (len (nthcdr n x)) (len x))
   :induct (nthcdr n x)
   :enable (nthcdr len)))

(local
 (defruled len-of-nthcdr-lt-when-posp
   (implies (and (consp x) (posp n))
            (< (len (nthcdr n x)) (len x)))
   :expand ((nthcdr n x) (len x))
   :use ((:instance len-of-nthcdr-upper-local (n (1- n)) (x (cdr x))))))

(local
 (defun list-split-two-induct (x y chunk)
   (declare (xargs :measure (len x)
                   :hints (("Goal"
                            :use (:instance len-of-nthcdr-lt-when-posp
                                            (n (pos-fix chunk)))))))
   (if (or (not (consp x)) (zp (pos-fix chunk)))
       (list y chunk)
     (list-split-two-induct (nthcdr (pos-fix chunk) x)
                            (nthcdr (pos-fix chunk) y)
                            chunk))))

(local
 (defruled len-of-nthcdr-local
   (equal (len (nthcdr n x))
          (nfix (- (len x) (nfix n))))
   :induct (nthcdr n x)
   :enable (nthcdr len nfix)))

(defruled expr-value-list-list-alpha-equiv-p-of-list-split
  (implies (and (expr-value-list-alpha-equiv-p new-vals vals)
                (posp chunk)
                (integerp (/ (len vals) chunk)))
           (expr-value-list-list-alpha-equiv-p (list-split new-vals chunk)
                                               (list-split vals chunk)))
  :induct (list-split-two-induct vals new-vals chunk)
  :enable (list-split
           expr-value-list-list-alpha-equiv-p
           consp-when-expr-value-list-alpha-equiv-p
           len-when-expr-value-list-alpha-equiv-p
           expr-value-list-alpha-equiv-p-of-take
           expr-value-list-alpha-equiv-p-of-nthcdr
           len-of-nthcdr-local
           fix nfix
           lt-to-zero-when-divided-by-pos)
  :hints ('(:use (:instance integerp-of-div-of-diff
                            (x (len vals))
                            (c (pos-fix chunk))))))

(defruled expr-value-list-alpha-equiv-p-of-append-all
  (implies (expr-value-list-list-alpha-equiv-p new-valss valss)
           (expr-value-list-alpha-equiv-p (append-all new-valss)
