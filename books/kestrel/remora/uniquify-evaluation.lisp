                 (primop-value-fold-t-t2-d-s-s2-f-z->tval new-op)
                 (primop-value-fold-t-t2-d-s-s2-f-z->tval op)
                 (car tws))
                (type-value-alpha-related-via-p
                 (primop-value-fold-t-t2-d-s-s2-f-z->t2val new-op)
                 (primop-value-fold-t-t2-d-s-s2-f-z->t2val op)
                 (cadr tws))
                (equal (primop-value-fold-t-t2-d-s-s2-f-z->dval new-op)
                       (primop-value-fold-t-t2-d-s-s2-f-z->dval op))
                (equal (primop-value-fold-t-t2-d-s-s2-f-z->sval new-op)
