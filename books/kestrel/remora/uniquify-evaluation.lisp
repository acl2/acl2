;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Membership form of the invariant, from which its monotonicity in the
; support set and its preservation under the binder extensions follow (a
; renamed name enters the renaming's keys; a kept one is deleted from
; them but enters the support set), as does its restriction to fewer
; keys.

(defruled in-when-string-set-supported-p
  (implies (and (string-set-supported-p keys renam b)
                (set::in a (string-sfix keys))
                (not (set::in a (omap::keys (string-string-map-fix renam)))))
           (set::in a (string-sfix b)))
  :enable string-set-supported-p
  :use ((:instance set::subset-in
                   (acl2::a a)
                   (x (string-sfix keys))
                   (y (set::union (string-sfix b)
                                  (omap::keys (string-string-map-fix renam)))))))

(defruled string-set-supported-p-monotone
  (implies (and (string-set-supported-p keys renam b)
                (set::subset (string-sfix b) (string-sfix b1)))
           (string-set-supported-p keys renam b1))
  :expand ((string-set-supported-p keys renam b1))
  :enable (set::pick-a-point-subset-strategy
           in-when-string-set-supported-p
           set::subset-in))

(defruled expr-denv-keys-supported-p-monotone
  (implies (and (expr-denv-keys-supported-p denv r b)
                (set::subset (string-sfix b) (string-sfix b1)))
           (expr-denv-keys-supported-p denv r b1))
  :enable (expr-denv-keys-supported-p
           string-set-supported-p-monotone))

(defruled string-set-supported-p-of-subset
  (implies (and (string-set-supported-p keys renam b)
                (set::subset (string-sfix keys1) (string-sfix keys)))
           (string-set-supported-p keys1 renam b))
  :enable string-set-supported-p
  :use ((:instance set::subset-transitive
                   (x (string-sfix keys1))
                   (y (string-sfix keys))
                   (z (set::union (string-sfix b)
                                  (omap::keys (string-string-map-fix renam)))))))

(defruled string-set-supported-p-of-insert-extend
  (implies (and (string-set-supported-p keys renam b)
                (string-setp keys)
                (stringp name)
                (stringp new-name))
           (string-set-supported-p (set::insert name keys)
                                   (extend-renaming name new-name renam)
                                   (set::insert new-name (string-sfix b))))
  :expand ((:free (renam)
            (string-set-supported-p (set::insert name keys)
                                    renam
                                    (set::insert new-name (string-sfix b)))))
  :enable (extend-renaming
           omap::keys-of-update
           omap::keys-of-delete
           set::pick-a-point-subset-strategy
           in-when-string-set-supported-p)
  :disable set::subset-in)

(defruled string-set-supported-p-of-extend-other
  (implies (and (string-set-supported-p keys renam b)
                (stringp name)
                (stringp new-name))
           (string-set-supported-p keys
                                   (extend-renaming name new-name renam)
                                   (set::insert new-name (string-sfix b))))
  :expand ((:free (renam)
            (string-set-supported-p keys
                                    renam
                                    (set::insert new-name (string-sfix b)))))
  :enable (extend-renaming
           omap::keys-of-update
           omap::keys-of-delete
           set::pick-a-point-subset-strategy
           in-when-string-set-supported-p)
  :disable set::subset-in)

; The name-freshness conditions and the support invariant exclude, in the
; expression namespace, the collision of a new name with the renaming of
; any other key.

(defruled not-in-image-of-keys-when-name-fresh-ok-and-supported
  (implies (and (name-fresh-ok name new-name renam b)
                (string-set-supported-p keys renam b)
                (string-setp keys)
                (stringp name)
                (stringp new-name))
           (not (set::in new-name
                         (rename-var-string-set (set::delete name keys)
                                                renam))))
  :enable (name-fresh-ok rename-var-string in-when-string-set-supported-p)
  :use ((:instance rename-var-string-set-preimage-witnesses
                   (y new-name)
                   (names (set::delete name keys))
                   (renam renam))
        (:instance omap::cdr-assoc-in-values
                   (omap::key (rename-var-string-set-preimage
                               new-name (set::delete name keys) renam))
                   (omap::map (omap::delete name
                                            (string-string-map-fix renam))))
        (:instance omap::in-of-keys-to-assoc
                   (omap::key (rename-var-string-set-preimage
                               new-name (set::delete name keys) renam))
                   (omap::map (string-string-map-fix renam)))))

