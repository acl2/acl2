  (implies (expr-value-list-groundp vals)
           (expr-value-list-alpha-related-via-p vals vals (repeat (len vals) '(:atom))))
  :induct (len vals)
  :enable (expr-value-list-alpha-related-via-p repeat len)
  :expand ((expr-value-list-groundp vals)))

