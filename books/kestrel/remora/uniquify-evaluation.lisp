           type-denv-add-type
           type-var-type-value-map-alpha-related-via-p-when-covered-p
           type-var-type-value-map-covered-p-when-alpha-related-via-p)
  :use ((:instance type-var-type-value-map-covered-p-of-update-array-extend-image
                   (new-map (type-denv->types (expr-denv->tenv new-denv)))
                   (map (type-denv->types (expr-denv->tenv denv)))
                   (tv var)
                   (new-tv new-var)
                   (wmap (denv-witness->types dw)))))

(defruled expr-denv-keys-supported-p-of-add-type-array
  (implies (and (expr-denv-keys-supported-p denv r b)
                (type-varp var)
                (type-var-case var :array)
                (stringp new-name))
           (expr-denv-keys-supported-p
            (expr-denv-add-type var tval denv)
            (change-var-renamings r :array (extend-renaming (type-var-array->name var)
                                                            new-name
                                                            (var-renamings->array r)))
            (set::insert new-name (string-sfix b))))
  :enable (expr-denv-keys-supported-p
           expr-denv-add-type
           type-denv-add-type
           omap::keys-of-update
           string-set-supported-p-of-insert-extend
           string-set-supported-p-monotone
           set::subset-insert))

(defruled expr-denv-alpha-avoided-p-of-add-type-array
  (implies (and (expr-denv-alpha-avoided-p new-denv denv r
                                           ivars
                                           (set::delete var (type-var-set-fix tvars))
                                           evars)
                (type-varp var)
                (type-varp new-var)
                (type-var-case var :array)
                (type-var-case new-var :array)
                (type-valuep tval)
                (type-valuep new-tval)
                (not (set::in new-var
                              (type-var-set-rename-type-vars
                               (set::delete var (type-var-set-fix tvars))
                               (var-renamings->atom r)
                               (var-renamings->array r)))))
           (expr-denv-alpha-avoided-p
            (expr-denv-add-type new-var new-tval new-denv)
            (expr-denv-add-type var tval denv)
            (change-var-renamings r :array (extend-renaming (type-var-array->name var)
                                                            (type-var-array->name new-var)
                                                            (var-renamings->array r)))
            ivars tvars evars))
  :expand ((:free (a b r i tv e) (expr-denv-alpha-avoided-p a b r i tv e)))
  :enable (expr-denv-add-type
           type-denv-add-type
           type-denv-alpha-avoided-p)
  :use ((:instance type-var-map-avoided-p-of-update-array-extend-image
                   (new-map (type-denv->types (expr-denv->tenv new-denv)))
                   (map (type-denv->types (expr-denv->tenv denv)))
                   (atom-renam (var-renamings->atom r))
                   (array-renam (var-renamings->array r))
                   (vars tvars)
                   (tv var)
                   (new-tv new-var))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Type binds: the bound type evaluates to related type values (the
; evaluator-renaming lemma for types), and the environments are extended
; by the bound variable at the type-variable layer, in the atom or the
; array namespace, with the type value's witness entering the witness map.

(defruled eval-bind-when-type
  (implies (and (equal (bind-kind bind) :type)
                (not (zp limit)))
           (equal (eval-bind bind denv limit)
                  (b* (((ok tval) (eval-type (bind-type->type bind)
                                             (expr-denv->tenv denv))))
                    (expr-denv-add-type (bind-type->var bind) tval denv))))
  :expand ((eval-bind bind denv limit)))

(defruled eval-type-alpha-when-equal
  (implies
   (and (equal new-type (type-rename-all-vars type r))
        (type-denv-alpha-related-via-p new-denv denv r wmap)
        (denv-ispace-vars-avoided-p (type-denv->ienv new-denv)
                                    (type-denv->ienv denv)
                                    (var-renamings->dim r)
                                    (var-renamings->shape r)
                                    (type-free-ispace-vars type))
        (type-var-map-avoided-p (type-denv->types new-denv)
                                (type-denv->types denv)
                                (var-renamings->atom r)
                                (var-renamings->array r)
                                (type-free-type-vars type))
        (type-fresh-ok type r))
   (and (equal (reserrp (eval-type new-type new-denv))
               (reserrp (eval-type type denv)))
        (implies (not (reserrp (eval-type type denv)))
                 (type-value-alpha-related-via-p
                  (eval-type new-type new-denv)
                  (eval-type type denv)
                  (eval-type-witness type r wmap)))))
  :enable type-fresh-ok
  :use eval-type-alpha)

(defruled eval-bind-new-when-type
  (implies (and (equal (bind-kind bind) :type)
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           evars))
           (b* ((tval (eval-type (bind-type->type bind) (expr-denv->tenv denv)))
                (new-tval (eval-type (bind-type->type new-bind)
                                     (expr-denv->tenv new-denv))))
             (and (equal (reserrp new-tval) (reserrp tval))
                  (implies (not (reserrp tval))
                           (type-value-alpha-related-via-p
                            new-tval tval
                            (eval-type-witness (bind-type->type bind) r
                                               (denv-witness->types dw)))))))
  :expand ((bind-alpha-related-p new-bind bind r)
           (bind-alpha-fresh-p new-bind bind r b)
           (bind-free-ispace-vars bind)
           (bind-free-type-vars bind)
           (expr-denv-alpha-related-via-p new-denv denv r dw)
           (:free (i tv e) (expr-denv-alpha-avoided-p new-denv denv r i tv e))
           (:free (i tv) (type-denv-alpha-avoided-p (expr-denv->tenv new-denv)
                                                    (expr-denv->tenv denv)
                                                    r i tv)))
  :use ((:instance eval-type-alpha-when-equal
                   (new-type (bind-type->type new-bind))
                   (type (bind-type->type bind))
                   (denv (expr-denv->tenv denv))
                   (new-denv (expr-denv->tenv new-denv))
                   (wmap (denv-witness->types dw)))))

; The type bind case, separately for the two kinds of the bound type
; variable (each kind extends its own namespace).

(defruled eval-bind-ok-when-type-equiv-atom
  (implies (and (equal (bind-kind bind) :type)
                (equal (type-var-kind (bind-type->var bind)) :atom)
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit))
                (new-result (eval-bind new-bind new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (expr-denv-alpha-equiv-p new-result result new-r)))))
  :expand ((bind-alpha-related-p new-bind bind r)
           (bind-alpha-fresh-p new-bind bind r b)
           (bind-alpha-extended-renamings new-bind bind r)
           (bind-name bind)
           (bind-name new-bind)
           (expr-denv-keys-supported-p denv r b))
  :enable (eval-bind-when-type
           type-var->name
           type-valuep-when-result-not-error
           not-reserrp-when-expr-denvp)
  :use ((:instance eval-bind-new-when-type
                   (evars (bind-free-expr-vars bind)))
        (:instance not-in-atom-image-of-keys-when-name-fresh-ok-and-supported
                   (name (type-var-atom->name (bind-type->var bind)))
                   (new-name (type-var-atom->name (bind-type->var new-bind)))
                   (atom-renam (var-renamings->atom r))
                   (array-renam (var-renamings->array r))
                   (keys (omap::keys (type-denv->types (expr-denv->tenv denv)))))
        (:instance expr-denv-alpha-related-via-p-of-add-type-atom
                   (var (bind-type->var bind))
                   (new-var (bind-type->var new-bind))
                   (new-tval (eval-type (bind-type->type new-bind)
                                        (expr-denv->tenv new-denv)))
                   (tval (eval-type (bind-type->type bind) (expr-denv->tenv denv)))
                   (w (eval-type-witness (bind-type->type bind) r
                                         (denv-witness->types dw))))
        (:instance expr-denv-alpha-equiv-p-suff
                   (new-denv (eval-bind new-bind new-denv limit))
                   (denv (eval-bind bind denv limit))
                   (r (bind-alpha-extended-renamings new-bind bind r))
                   (dw (change-denv-witness
                        dw
                        :types (omap::update
                                (bind-type->var bind)
                                (eval-type-witness (bind-type->type bind) r
                                                   (denv-witness->types dw))
                                (denv-witness->types dw)))))))

(defruled eval-bind-ok-when-type-equiv-array
  (implies (and (equal (bind-kind bind) :type)
                (equal (type-var-kind (bind-type->var bind)) :array)
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit))
                (new-result (eval-bind new-bind new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (expr-denv-alpha-equiv-p new-result result new-r)))))
  :expand ((bind-alpha-related-p new-bind bind r)
           (bind-alpha-fresh-p new-bind bind r b)
           (bind-alpha-extended-renamings new-bind bind r)
           (bind-name bind)
           (bind-name new-bind)
           (expr-denv-keys-supported-p denv r b))
  :enable (eval-bind-when-type
           type-var->name
           type-valuep-when-result-not-error
           not-reserrp-when-expr-denvp)
  :use ((:instance eval-bind-new-when-type
                   (evars (bind-free-expr-vars bind)))
        (:instance not-in-array-image-of-keys-when-name-fresh-ok-and-supported
                   (name (type-var-array->name (bind-type->var bind)))
                   (new-name (type-var-array->name (bind-type->var new-bind)))
                   (atom-renam (var-renamings->atom r))
                   (array-renam (var-renamings->array r))
                   (keys (omap::keys (type-denv->types (expr-denv->tenv denv)))))
        (:instance expr-denv-alpha-related-via-p-of-add-type-array
                   (var (bind-type->var bind))
                   (new-var (bind-type->var new-bind))
                   (new-tval (eval-type (bind-type->type new-bind)
                                        (expr-denv->tenv new-denv)))
                   (tval (eval-type (bind-type->type bind) (expr-denv->tenv denv)))
                   (w (eval-type-witness (bind-type->type bind) r
                                         (denv-witness->types dw))))
        (:instance expr-denv-alpha-equiv-p-suff
                   (new-denv (eval-bind new-bind new-denv limit))
                   (denv (eval-bind bind denv limit))
                   (r (bind-alpha-extended-renamings new-bind bind r))
                   (dw (change-denv-witness
                        dw
                        :types (omap::update
                                (bind-type->var bind)
                                (eval-type-witness (bind-type->type bind) r
                                                   (denv-witness->types dw))
                                (denv-witness->types dw)))))))

(defruled eval-bind-ok-when-type-equiv
  (implies (and (equal (bind-kind bind) :type)
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit))
                (new-result (eval-bind new-bind new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (expr-denv-alpha-equiv-p new-result result new-r)))))
  :cases ((equal (type-var-kind (bind-type->var bind)) :atom))
  :use (eval-bind-ok-when-type-equiv-atom
        eval-bind-ok-when-type-equiv-array))

(defruled eval-bind-ok-when-type-supported
  (implies (and (equal (bind-kind bind) :type)
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (expr-denv-keys-supported-p denv r b))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit)))
             (implies (not (reserrp result))
                      (expr-denv-keys-supported-p
                       result new-r
                       (set::insert (str-fix (bind-name new-bind))
                                    (string-sfix b))))))
  :expand ((bind-alpha-related-p new-bind bind r)
           (bind-alpha-extended-renamings new-bind bind r)
           (bind-name bind)
           (bind-name new-bind))
  :enable (eval-bind-when-type
           type-var->name
           expr-denv-keys-supported-p-of-add-type-atom
           expr-denv-keys-supported-p-of-add-type-array
           not-reserrp-when-expr-denvp))

(defruled eval-bind-ok-when-type-avoided
  (implies (and (equal (bind-kind bind) :type)
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind)))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit))
                (new-result (eval-bind new-bind new-denv limit)))
             (implies (and (not (reserrp result))
                           (expr-denv-alpha-avoided-p
                            new-denv denv r
                            (set::difference (ispace-var-set-fix ivars)
                                             (bind-bound-ispace-vars bind))
                            (set::difference (type-var-set-fix tvars)
                                             (bind-bound-type-vars bind))
                            (set::difference (string-sfix evars)
                                             (bind-bound-expr-vars bind)))
                           (bind-nocapture-ok new-bind bind r evars tvars ivars))
                      (expr-denv-alpha-avoided-p new-result result new-r
                                                 ivars tvars evars))))
  :expand ((bind-alpha-related-p new-bind bind r)
           (bind-bound-ispace-vars bind)
           (bind-bound-type-vars bind)
           (bind-bound-expr-vars bind)
           (bind-nocapture-ok new-bind bind r evars tvars ivars)
           (bind-alpha-extended-renamings new-bind bind r)
           (bind-name bind)
           (bind-name new-bind))
  :enable (eval-bind-when-type
           type-var->name
           type-valuep-when-result-not-error
           set::difference-insert-y
           difference-of-nil-right
           not-reserrp-when-expr-denvp)
  :use ((:instance eval-bind-new-when-type
                   (evars (bind-free-expr-vars bind)))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (ispace-var-set-fix ivars))
                   (tvars2 (set::delete (bind-type->var bind)
                                        (type-var-set-fix tvars)))
                   (evars2 (string-sfix evars))
                   (ivars1 ivars)
                   (tvars1 (set::delete (bind-type->var bind)
                                        (type-var-set-fix tvars)))
                   (evars1 evars))
        (:instance expr-denv-alpha-avoided-p-of-add-type-atom
                   (var (bind-type->var bind))
                   (new-var (bind-type->var new-bind))
                   (new-tval (eval-type (bind-type->type new-bind)
                                        (expr-denv->tenv new-denv)))
                   (tval (eval-type (bind-type->type bind) (expr-denv->tenv denv))))
        (:instance expr-denv-alpha-avoided-p-of-add-type-array
                   (var (bind-type->var bind))
                   (new-var (bind-type->var new-bind))
                   (new-tval (eval-type (bind-type->type new-bind)
                                        (expr-denv->tenv new-denv)))
                   (tval (eval-type (bind-type->type bind) (expr-denv->tenv denv))))))

(defruled eval-bind-ok-when-type-aux
  (implies (and (equal (bind-kind bind) :type)
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit))
                (new-result (eval-bind new-bind new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (and (expr-denv-alpha-equiv-p new-result result new-r)
                                (expr-denv-keys-supported-p
                                 result new-r
                                 (set::insert (str-fix (bind-name new-bind))
                                              (string-sfix b)))
                                (implies
                                 (and (expr-denv-alpha-avoided-p
                                       new-denv denv r
                                       (set::difference
                                        (ispace-var-set-fix ivars)
                                        (bind-bound-ispace-vars bind))
                                       (set::difference
                                        (type-var-set-fix tvars)
                                        (bind-bound-type-vars bind))
                                       (set::difference
                                        (string-sfix evars)
                                        (bind-bound-expr-vars bind)))
                                      (bind-nocapture-ok new-bind bind r
                                                         evars tvars ivars))
                                 (expr-denv-alpha-avoided-p
                                  new-result result new-r
                                  ivars tvars evars)))))))
  :use (eval-bind-ok-when-type-equiv
        eval-bind-ok-when-type-supported
        eval-bind-ok-when-type-avoided))

(defruled eval-bind-ok-when-type
  (implies (equal (bind-kind bind) :type)
           (eval-bind-ok bind denv limit))
  :expand ((eval-bind-ok bind denv limit))
  :cases ((zp limit))
  :enable eval-bind-when-zp-limit
  :use ((:instance eval-bind-ok-when-type-aux
                   (new-bind (mv-nth 0 (eval-bind-ok-witness bind denv limit)))
                   (new-denv (mv-nth 1 (eval-bind-ok-witness bind denv limit)))
                   (r (mv-nth 2 (eval-bind-ok-witness bind denv limit)))
                   (dw (mv-nth 3 (eval-bind-ok-witness bind denv limit)))
                   (b (mv-nth 4 (eval-bind-ok-witness bind denv limit)))
                   (evars (mv-nth 5 (eval-bind-ok-witness bind denv limit)))
                   (tvars (mv-nth 6 (eval-bind-ok-witness bind denv limit)))
                   (ivars (mv-nth 7 (eval-bind-ok-witness bind denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Value-like binds, generically: a value bind, and a function bind of any
; kind without parameters, evaluate the bound expression (and check the
; optional type annotation) and extend the environment at the expression
; layer.  The lemmas are stated on the pieces (variable, expression,
; annotation) and instantiated by the bind kinds.

(define eval-value-bind ((var stringp)
                         (expr exprp)
                         (type? type-optionp)
                         (denv expr-denvp)
                         (limit natp))
  :returns (new-denv expr-denv-resultp)
  :verify-guards nil
  (b* (((ok val) (eval-expr expr denv (1- limit)))
       ((ok &) (type-option-case
                type?
                :some (eval-type type?.val (expr-denv->tenv denv))
                :none nil)))
    (expr-denv-add-expr var val denv)))

; The extension of related environments by alpha-equivalent values at a
; fresh name.

(defruled expr-denv-alpha-equiv-p-of-add-expr-when-equiv
  (implies (and (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-value-alpha-equiv-p new-val val)
                (expr-valuep val)
                (expr-valuep new-val)
                (stringp var)
                (stringp new-var)
                (name-fresh-ok var new-var (var-renamings->expr r) b)
                (expr-denv-keys-supported-p denv r b))
           (expr-denv-alpha-equiv-p
            (expr-denv-add-expr new-var new-val new-denv)
            (expr-denv-add-expr var val denv)
            (change-var-renamings r :expr (extend-renaming var new-var
                                                           (var-renamings->expr r)))))
  :expand ((expr-denv-keys-supported-p denv r b))
  :use ((:instance expr-value-alpha-equiv-p)
        (:instance not-in-image-of-keys-when-name-fresh-ok-and-supported
                   (name var)
                   (new-name new-var)
                   (renam (var-renamings->expr r))
                   (keys (omap::keys (expr-denv->exprs denv))))
        (:instance expr-denv-alpha-related-via-p-of-add-expr
                   (name var)
                   (new-name new-var)
                   (w (expr-value-witness-fix
                       (expr-value-alpha-equiv-p-witness new-val val))))
        (:instance expr-denv-alpha-equiv-p-suff
                   (new-denv (expr-denv-add-expr new-var new-val new-denv))
                   (denv (expr-denv-add-expr var val denv))
                   (r (change-var-renamings
                       r :expr (extend-renaming var new-var
                                                (var-renamings->expr r))))
                   (dw (change-denv-witness
                        dw
                        :exprs (omap::update
                                var
                                (expr-value-witness-fix
                                 (expr-value-alpha-equiv-p-witness new-val val))
                                (denv-witness->exprs dw)))))))

(defruled eval-value-bind-alpha-equiv
  (implies (and (not (zp limit))
                (stringp var)
                (stringp new-var)
                (eval-expr-ok expr denv (1- limit))
                (expr-alpha-related-p new-expr expr r)
                (expr-alpha-fresh-p new-expr expr r b)
                (equal new-type? (type-option-rename-all-vars type? r))
                (type-option-fresh-ok type? r)
                (name-fresh-ok var new-var (var-renamings->expr r) b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p
                 new-denv denv r
                 (set::union (type-option-free-ispace-vars type?)
                             (expr-free-ispace-vars expr))
                 (set::union (type-option-free-type-vars type?)
                             (expr-free-type-vars expr))
                 (expr-free-expr-vars expr))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (change-var-renamings
                        r :expr (extend-renaming var new-var
                                                 (var-renamings->expr r))))
                (result (eval-value-bind var expr type? denv limit))
                (new-result (eval-value-bind new-var new-expr new-type?
                                             new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (expr-denv-alpha-equiv-p new-result result new-r)))))
  :enable (eval-value-bind
           type-option-rename-all-vars
           type-option-rename-ispace-vars
           type-option-rename-type-vars
           type-rename-all-vars
           type-option-some->val-when-typep
           not-reserrp-when-expr-valuep
           expr-valuep-when-result-not-error
           expr-value-wfp-of-eval-expr
           not-reserrp-when-expr-denvp
