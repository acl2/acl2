           expr-value-list-alpha-equiv-p-of-vector-elems-when-alpha-equiv
           expr-value-list-alpha-equiv-p-of-nil))

; Atoms of related values.

(acl2::defun-sk atoms-alpha-ok (val)
  (forall (new-val)
    (implies (expr-value-alpha-equiv-p new-val val)
             (expr-value-list-alpha-equiv-p (expr-value-atoms new-val)
                                            (expr-value-atoms val)))))

(acl2::defun-sk list-atoms-alpha-ok (vals)
  (forall (new-vals)
    (implies (expr-value-list-alpha-equiv-p new-vals vals)
             (expr-value-list-alpha-equiv-p (expr-value-list-atoms new-vals)
                                            (expr-value-list-atoms vals)))))

(defruled atoms-alpha-ok-when-vector
  (implies (and (equal (expr-value-kind val) :vector)
                (list-atoms-alpha-ok (expr-value-vector->elems val)))
           (atoms-alpha-ok val))
  :expand ((atoms-alpha-ok val)
           (expr-value-atoms val)
           (expr-value-atoms (atoms-alpha-ok-witness val)))
  :enable (expr-value-kind-when-expr-value-alpha-equiv-p
           expr-value-list-alpha-equiv-p-of-vector-elems-when-alpha-equiv)
  :use ((:instance list-atoms-alpha-ok-necc
                   (vals (expr-value-vector->elems val))
                   (new-vals (expr-value-vector->elems (atoms-alpha-ok-witness val))))))

(defruled atoms-alpha-ok-when-vector-empty
  (implies (equal (expr-value-kind val) :vector-empty)
           (atoms-alpha-ok val))
  :expand ((atoms-alpha-ok val)
           (expr-value-atoms val)
           (expr-value-atoms (atoms-alpha-ok-witness val)))
  :enable (expr-value-kind-when-expr-value-alpha-equiv-p
           expr-value-list-alpha-equiv-p-of-nil))

(defruled atoms-alpha-ok-when-otherwise
  (implies (and (not (equal (expr-value-kind val) :vector))
                (not (equal (expr-value-kind val) :vector-empty)))
           (atoms-alpha-ok val))
  :expand ((atoms-alpha-ok val)
           (expr-value-atoms val)
           (expr-value-atoms (atoms-alpha-ok-witness val)))
  :enable (expr-value-kind-when-expr-value-alpha-equiv-p
           expr-value-list-alpha-equiv-p-of-singleton-fix-when-equiv))

(defruled list-atoms-alpha-ok-when-endp
  (implies (not (consp vals))
           (list-atoms-alpha-ok vals))
  :expand ((list-atoms-alpha-ok vals)
           (expr-value-list-atoms vals)
           (expr-value-list-atoms (list-atoms-alpha-ok-witness vals)))
  :enable (consp-when-expr-value-list-alpha-equiv-p
           expr-value-list-alpha-equiv-p-of-nil))

(defruled list-atoms-alpha-ok-when-consp
  (implies (and (consp vals)
                (atoms-alpha-ok (car vals))
                (list-atoms-alpha-ok (cdr vals)))
           (list-atoms-alpha-ok vals))
  :expand ((list-atoms-alpha-ok vals)
           (expr-value-list-atoms vals)
           (expr-value-list-atoms (list-atoms-alpha-ok-witness vals)))
  :enable (consp-when-expr-value-list-alpha-equiv-p
           expr-value-alpha-equiv-p-of-car-when-list-alpha-equiv
           expr-value-list-alpha-equiv-p-of-cdr-when-list-alpha-equiv
           expr-value-list-alpha-equiv-p-of-append)
  :use ((:instance atoms-alpha-ok-necc
                   (val (car vals))
                   (new-val (car (list-atoms-alpha-ok-witness vals))))
        (:instance list-atoms-alpha-ok-necc
                   (vals (cdr vals))
                   (new-vals (cdr (list-atoms-alpha-ok-witness vals))))))

; The atoms clique does not export its flag function.

(flag::make-flag expr-values-atoms-flag2 expr-value-atoms
                 :flag-mapping ((expr-value-atoms expr-value-atoms)
                                (expr-value-list-atoms expr-value-list-atoms)))

(defthm-expr-values-atoms-flag2
  (defthm atoms-alpha-ok-holds
    (atoms-alpha-ok val)
    :flag expr-value-atoms)
  (defthm list-atoms-alpha-ok-holds
    (list-atoms-alpha-ok vals)
    :flag expr-value-list-atoms)
  :hints (("Goal"
           :in-theory (enable atoms-alpha-ok-when-vector
                              atoms-alpha-ok-when-vector-empty
                              atoms-alpha-ok-when-otherwise
                              list-atoms-alpha-ok-when-endp
                              list-atoms-alpha-ok-when-consp))))

(defruled expr-value-atoms-alpha-equiv
  (implies (expr-value-alpha-equiv-p new-val val)
           (expr-value-list-alpha-equiv-p (expr-value-atoms new-val)
                                          (expr-value-atoms val)))
  :enable atoms-alpha-ok-holds
  :use atoms-alpha-ok-necc)

