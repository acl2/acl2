                   (aw (car ws)))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-app-cell (eval-app-cell new-fval new-acc (1- limit))
                                           (car new-cells)
                                           (1- limit)))
                   (val (eval-app-cell (eval-app-cell fval acc (1- limit))
