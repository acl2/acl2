;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Type closure application: the type environment captured by a universal
; type value, extended by the (unrenamed) parameter under the body renamings
; (the parameter removed from the maps), relates to the new closure's
; extended environment, with the argument's witness entering the witness
; map; and the failure direction carries over at the body's free variables.

(defruled rename-type-var-of-remove-bound-singleton-same
  (implies (type-varp var)
           (b* (((mv & & atom1 array1)
                 (atom/array-rename-remove-bound (set::insert var nil) am arm)))
             (equal (rename-type-var var atom1 array1) var)))
  :enable (atom/array-rename-remove-bound
           rename-type-var
           rename-var-string-of-delete*
           in-of-atom-names-of-type-vars
           in-of-array-names-of-type-vars))

(defruled type-var-type-value-map-covered-p-of-update-same-remove-bound
  (implies (and (type-var-type-value-map-covered-p new-map map r wmap)
                (type-var-type-value-mapp new-map)
                (type-var-type-value-mapp map)
                (type-varp tv)
                (type-valuep new-tval)
                (type-valuep tval)
                (type-value-witness-p w)
                (type-var-type-value-witness-mapp wmap)
                (type-value-alpha-related-via-p new-tval tval w)
                (not (set::in tv
                              (type-var-set-rename-type-vars
                               (set::delete tv (omap::keys map))
                               (mv-nth 2 (atom/array-rename-remove-bound
                                          (set::insert tv nil)
                                          (var-renamings->atom r)
                                          (var-renamings->array r)))
                               (mv-nth 3 (atom/array-rename-remove-bound
                                          (set::insert tv nil)
                                          (var-renamings->atom r)
                                          (var-renamings->array r)))))))
           (b* (((mv & & atom1 array1)
                 (atom/array-rename-remove-bound (set::insert tv nil)
                                                 (var-renamings->atom r)
                                                 (var-renamings->array r))))
             (type-var-type-value-map-covered-p
              (omap::update tv new-tval new-map)
              (omap::update tv tval map)
              (change-var-renamings r :atom atom1 :array array1)
              (omap::update tv w wmap))))
  :expand ((:free (renam)
            (type-var-type-value-map-covered-p
             (omap::update tv new-tval new-map)
             (omap::update tv tval map)
             renam
             (omap::update tv w wmap))))
  :enable (rename-type-var-of-remove-bound-when-not-in
           rename-type-var-of-remove-bound-singleton-same
           omap::assoc-of-update
           omap::in-of-keys-to-assoc)
  :use ((:instance type-var-type-value-map-covered-p-necc
                   (var (type-var-type-value-map-covered-p-witness
                         (omap::update tv new-tval new-map)
                         (omap::update tv tval map)
                         (change-var-renamings
                          r
                          :atom (mv-nth 2 (atom/array-rename-remove-bound
                                           (set::insert tv nil)
                                           (var-renamings->atom r)
                                           (var-renamings->array r)))
                          :array (mv-nth 3 (atom/array-rename-remove-bound
                                            (set::insert tv nil)
                                            (var-renamings->atom r)
                                            (var-renamings->array r))))
                         (omap::update tv w wmap))))
        (:instance in-of-rename-type-var-of-type-var-set-rename-type-vars
                   (var (type-var-type-value-map-covered-p-witness
                         (omap::update tv new-tval new-map)
                         (omap::update tv tval map)
                         (change-var-renamings
                          r
                          :atom (mv-nth 2 (atom/array-rename-remove-bound
                                           (set::insert tv nil)
                                           (var-renamings->atom r)
                                           (var-renamings->array r)))
                          :array (mv-nth 3 (atom/array-rename-remove-bound
                                            (set::insert tv nil)
                                            (var-renamings->atom r)
                                            (var-renamings->array r))))
                         (omap::update tv w wmap)))
                   (vars (set::delete tv (omap::keys map)))
                   (atom-renam (mv-nth 2 (atom/array-rename-remove-bound
                                          (set::insert tv nil)
                                          (var-renamings->atom r)
                                          (var-renamings->array r))))
                   (array-renam (mv-nth 3 (atom/array-rename-remove-bound
                                           (set::insert tv nil)
                                           (var-renamings->atom r)
                                           (var-renamings->array r)))))))

(defruled type-var-map-avoided-p-of-update-same-remove-bound
  (implies (and (type-var-map-avoided-p new-map map atom-renam array-renam
                                        (set::delete tv (type-var-set-fix vars)))
                (type-var-type-value-mapp new-map)
                (type-var-type-value-mapp map)
                (type-varp tv)
                (type-valuep new-tval)
                (type-valuep tval)
                (not (set::in tv
                              (type-var-set-rename-type-vars
                               (set::delete tv (type-var-set-fix vars))
                               (mv-nth 2 (atom/array-rename-remove-bound
                                          (set::insert tv nil)
                                          atom-renam array-renam))
                               (mv-nth 3 (atom/array-rename-remove-bound
                                          (set::insert tv nil)
                                          atom-renam array-renam))))))
           (b* (((mv & & atom1 array1)
                 (atom/array-rename-remove-bound (set::insert tv nil)
                                                 atom-renam array-renam)))
             (type-var-map-avoided-p
              (omap::update tv new-tval new-map)
              (omap::update tv tval map)
              atom1 array1
              vars)))
  :expand ((:free (m1 m2 a ar) (type-var-map-avoided-p m1 m2 a ar vars)))
  :enable (rename-type-var-of-remove-bound-when-not-in
           omap::assoc-of-update)
  :use ((:instance type-var-map-avoided-p-necc
                   (vars (set::delete tv (type-var-set-fix vars)))
                   (var (type-var-map-avoided-p-witness
                         (omap::update tv new-tval new-map)
                         (omap::update tv tval map)
                         (mv-nth 2 (atom/array-rename-remove-bound
                                    (set::insert tv nil) atom-renam array-renam))
                         (mv-nth 3 (atom/array-rename-remove-bound
                                    (set::insert tv nil) atom-renam array-renam))
                         vars)))
        (:instance in-of-rename-type-var-of-type-var-set-rename-type-vars
                   (var (type-var-map-avoided-p-witness
                         (omap::update tv new-tval new-map)
                         (omap::update tv tval map)
                         (mv-nth 2 (atom/array-rename-remove-bound
                                    (set::insert tv nil) atom-renam array-renam))
                         (mv-nth 3 (atom/array-rename-remove-bound
                                    (set::insert tv nil) atom-renam array-renam))
                         vars))
                   (vars (set::delete tv (type-var-set-fix vars)))
                   (atom-renam (mv-nth 2 (atom/array-rename-remove-bound
                                          (set::insert tv nil) atom-renam array-renam)))
                   (array-renam (mv-nth 3 (atom/array-rename-remove-bound
                                           (set::insert tv nil) atom-renam array-renam))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The type-environment level of the closure application lemmas.

(defruled type-denv-alpha-related-via-p-of-add-type-same-remove-bound
  (implies (and (type-denv-alpha-related-via-p new-tenv tenv r wmap)
                (type-varp tv)
                (type-valuep new-tval)
                (type-valuep tval)
                (type-value-witness-p w)
                (type-var-type-value-witness-mapp wmap)
                (type-value-alpha-related-via-p new-tval tval w)
                (not (set::in tv
                              (type-var-set-rename-type-vars
                               (set::delete tv (omap::keys (type-denv->types tenv)))
                               (mv-nth 2 (atom/array-rename-remove-bound
                                          (set::insert tv nil)
                                          (var-renamings->atom r)
                                          (var-renamings->array r)))
                               (mv-nth 3 (atom/array-rename-remove-bound
                                          (set::insert tv nil)
                                          (var-renamings->atom r)
                                          (var-renamings->array r)))))))
           (b* (((mv & & atom1 array1)
                 (atom/array-rename-remove-bound (set::insert tv nil)
                                                 (var-renamings->atom r)
                                                 (var-renamings->array r))))
             (type-denv-alpha-related-via-p
              (type-denv-add-type tv new-tval new-tenv)
              (type-denv-add-type tv tval tenv)
              (change-var-renamings r :atom atom1 :array array1)
              (omap::update tv w wmap))))
  :expand ((:free (a b r wm) (type-denv-alpha-related-via-p a b r wm)))
  :enable (type-denv-add-type
           type-var-type-value-map-alpha-related-via-p-when-covered-p
           type-var-type-value-map-covered-p-when-alpha-related-via-p)
  :use ((:instance type-var-type-value-map-covered-p-of-update-same-remove-bound
                   (new-map (type-denv->types new-tenv))
                   (map (type-denv->types tenv)))))

; The parameter's non-capture at the captured environment's keys follows
; from its non-capture at the body's free variables, which bound the keys.

(defruled not-in-type-image-of-delete-keys-when-type-denv-keys-within-p
  (implies (and (type-denv-keys-within-p tenv ivars tvars)
                (type-var-setp tvars)
                (not (set::in x (type-var-set-rename-type-vars tvars am arm))))
           (not (set::in x (type-var-set-rename-type-vars
                            (set::delete v (omap::keys (type-denv->types tenv)))
                            am arm))))
  :enable (type-denv-keys-within-p)
  :use ((:instance not-in-type-var-image-when-subset
                   (elt x)
                   (a (set::delete v (omap::keys (type-denv->types tenv))))
                   (b tvars)
                   (atom-m am)
                   (array-m arm))
        (:instance set::subset-transitive
                   (x (set::delete v (omap::keys (type-denv->types tenv))))
                   (y (omap::keys (type-denv->types tenv)))
                   (z tvars))))

; Applying related universal type closures to related type arguments: the
; bodies evaluate with the same error behavior, to related type values.

; The parameter of related universal type closures is the same.

(defruled forall-param-when-type-value-alpha-related-via-p
  (implies (and (type-value-alpha-related-via-p new-elem elem ew)
                (equal (type-value-kind elem) :forall))
           (and (equal (type-value-kind new-elem) :forall)
                (equal (type-value-forall->param new-elem)
                       (type-value-forall->param elem))))
  :expand ((type-value-alpha-related-via-p new-elem elem ew))
  :enable not-type-value-groundp-when-forall)

(defruled eval-type-of-forall-closure-body-alpha
  (implies (and (type-value-alpha-related-via-p new-elem elem ew)
                (equal (type-value-kind elem) :forall)
                (type-value-alpha-related-via-p new-tval tval tw))
           (b* ((tv (type-value-forall->param elem))
                (bodyval (eval-type (type-value-forall->body elem)
                                    (type-denv-add-type
                                     tv tval (type-value-forall->denv elem))))
                (new-bodyval (eval-type (type-value-forall->body new-elem)
                                        (type-denv-add-type
                                         tv new-tval
                                         (type-value-forall->denv new-elem)))))
             (and (equal (reserrp new-bodyval) (reserrp bodyval))
                  (implies (not (reserrp bodyval))
                           (type-value-alpha-equiv-p new-bodyval bodyval)))))
  :expand ((type-value-alpha-related-via-p new-elem elem ew)
           (:free (i tv) (type-denv-alpha-avoided-p
                          (type-value-forall->denv new-elem)
                          (type-value-forall->denv elem)
                          (type-value-witness-closure->r ew)
                          i tv)))
  :enable (not-type-value-groundp-when-forall
           type-rename-all-vars
           type-denv-add-type
           type-denv-alpha-related-via-p-of-add-type-same-remove-bound
           not-in-type-image-of-delete-keys-when-type-denv-keys-within-p
           type-denv-alpha-avoided-p)
  :use ((:instance eval-type-alpha-when-equal
                   (new-type (type-value-forall->body new-elem))
                   (type (type-value-forall->body elem))
                   (r (change-var-renamings
                       (type-value-witness-closure->r ew)
                       :atom (mv-nth 2 (atom/array-rename-remove-bound
                                        (set::insert (type-value-forall->param elem) nil)
                                        (var-renamings->atom
                                         (type-value-witness-closure->r ew))
                                        (var-renamings->array
                                         (type-value-witness-closure->r ew))))
                       :array (mv-nth 3 (atom/array-rename-remove-bound
                                         (set::insert (type-value-forall->param elem) nil)
                                         (var-renamings->atom
                                          (type-value-witness-closure->r ew))
                                         (var-renamings->array
                                          (type-value-witness-closure->r ew))))))
                   (new-denv (type-denv-add-type (type-value-forall->param elem)
                                                 new-tval
                                                 (type-value-forall->denv new-elem)))
                   (denv (type-denv-add-type (type-value-forall->param elem)
                                             tval
                                             (type-value-forall->denv elem)))
                   (wmap (omap::update (type-value-forall->param elem)
                                       (type-value-witness-fix tw)
                                       (type-value-witness-closure->types ew))))
        (:instance type-var-map-avoided-p-of-update-same-remove-bound
                   (new-map (type-denv->types (type-value-forall->denv new-elem)))
                   (map (type-denv->types (type-value-forall->denv elem)))
                   (atom-renam (var-renamings->atom (type-value-witness-closure->r ew)))
                   (array-renam (var-renamings->array (type-value-witness-closure->r ew)))
                   (tv (type-value-forall->param elem))
                   (new-tval (type-value-fix new-tval))
                   (tval (type-value-fix tval))
                   (vars (type-free-type-vars (type-value-forall->body elem))))
        (:instance type-denv-alpha-related-via-p-of-add-type-same-remove-bound
                   (new-tenv (type-value-forall->denv new-elem))
                   (tenv (type-value-forall->denv elem))
                   (r (type-value-witness-closure->r ew))
                   (wmap (type-value-witness-closure->types ew))
                   (tv (type-value-forall->param elem))
                   (new-tval (type-value-fix new-tval))
                   (tval (type-value-fix tval))
                   (w (type-value-witness-fix tw)))
        (:instance type-value-alpha-equiv-p-suff
                   (new-tval (eval-type (type-value-forall->body new-elem)
                                        (type-denv-add-type
                                         (type-value-forall->param elem)
                                         new-tval
                                         (type-value-forall->denv new-elem))))
                   (tval (eval-type (type-value-forall->body elem)
                                    (type-denv-add-type
                                     (type-value-forall->param elem)
                                     tval
                                     (type-value-forall->denv elem))))
                   (w (eval-type-witness
                       (type-value-forall->body elem)
                       (change-var-renamings
                        (type-value-witness-closure->r ew)
                        :atom (mv-nth 2 (atom/array-rename-remove-bound
                                         (set::insert (type-value-forall->param elem) nil)
                                         (var-renamings->atom
                                          (type-value-witness-closure->r ew))
                                         (var-renamings->array
                                          (type-value-witness-closure->r ew))))
                        :array (mv-nth 3 (atom/array-rename-remove-bound
                                          (set::insert (type-value-forall->param elem) nil)
                                          (var-renamings->atom
                                           (type-value-witness-closure->r ew))
                                          (var-renamings->array
                                           (type-value-witness-closure->r ew)))))
                       (omap::update (type-value-forall->param elem)
                                     (type-value-witness-fix tw)
                                     (type-value-witness-closure->types ew)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The empty-vector case of type application: the element type value (a
; universal type closure, or the application fails) is applied to the
; argument as above, and the resulting type value is decomposed into the
; element type value and the dimensions of the result.

(defruled eval-tapp-when-vector-empty
  (implies (and (equal (expr-value-kind funval) :vector-empty)
                (not (zp limit)))
           (equal (eval-tapp funval tval limit)
                  (b* ((elemtv (expr-value-vector-empty->elem funval)))
                    (if (type-value-case elemtv :forall)
                        (b* (((unless (type-values-match-type-vars-p
                                       (list tval)
                                       (list (type-value-forall->param elemtv))))
                              (reserr nil))
                             (tenv (type-denv-add-type
                                    (type-value-forall->param elemtv)
                                    tval
                                    (type-value-forall->denv elemtv)))
                             ((ok bodyval) (eval-type (type-value-forall->body elemtv)
                                                      tenv))
                             ((mv elem body-dims)
                              (type-value-case
                               bodyval
                               :array (mv (type-value-array->elem bodyval)
                                          (type-value-array->dims bodyval))
                               :otherwise (mv bodyval nil)))
                             ((when (type-value-case elem :array)) (reserr nil)))
                          (expr-value-vector-empty
                           (append (expr-value-vector-empty->dims funval) body-dims)
                           elem))
                      (reserr nil)))))
  :expand ((eval-tapp funval tval limit)))

(defruled type-value-kind-when-type-value-alpha-equiv-p
  (implies (type-value-alpha-equiv-p new-tval tval)
           (equal (type-value-kind new-tval) (type-value-kind tval)))
  :enable type-value-alpha-equiv-p
  :use ((:instance type-value-kind-when-type-value-alpha-related-via-p
                   (w (type-value-alpha-equiv-p-witness new-tval tval)))))

(defruled type-value-alpha-equiv-p-when-related
  (implies (type-value-alpha-related-via-p new-tval tval w)
           (type-value-alpha-equiv-p new-tval tval))
  :use type-value-alpha-equiv-p-suff)

(defruled type-value-alpha-equiv-p-of-array-elem-when-related
  (implies (and (type-value-alpha-related-via-p new-bv bv bw)
                (equal (type-value-kind bv) :array))
           (and (equal (type-value-array->dims new-bv) (type-value-array->dims bv))
                (type-value-alpha-equiv-p (type-value-array->elem new-bv)
                                          (type-value-array->elem bv))))
  :expand ((type-value-alpha-related-via-p new-bv bv bw))
  :enable (type-value-alpha-equiv-p-when-related
           type-value-kind-when-type-value-alpha-related-via-p
           type-value-groundp-of-type-value-array->elem)
  :use ((:instance type-value-fix-when-array (x new-bv))
        (:instance type-value-fix-when-array (x bv))
        (:instance type-value-alpha-equiv-p-suff
                   (new-tval (type-value-array->elem new-bv))
                   (tval (type-value-array->elem bv))
                   (w (if (type-value-witness-case bw :leaf)
                          bw
                        (type-value-witness-array->elem bw))))))

(defruled expr-value-alpha-equiv-p-of-vector-empty-when-elem-equiv
  (implies (type-value-alpha-equiv-p new-elem elem)
           (expr-value-alpha-equiv-p (expr-value-vector-empty dims new-elem)
                                     (expr-value-vector-empty dims elem)))
  :expand ((type-value-alpha-equiv-p new-elem elem)
           (:free (nv w) (expr-value-alpha-related-via-p
                          nv (expr-value-vector-empty dims elem) w)))
  :use ((:instance expr-value-alpha-equiv-p-suff
                   (new-val (expr-value-vector-empty dims new-elem))
                   (val (expr-value-vector-empty dims elem))
                   (w (expr-value-witness-vempty
                       (type-value-alpha-equiv-p-witness new-elem elem))))))

(defruled vector-empty-tapp-result-alpha-equiv-when-bodyvals-equiv
  (implies (type-value-alpha-equiv-p new-bv bv)
           (b* (((mv elem body-dims)
                 (type-value-case
                  bv
                  :array (mv (type-value-array->elem bv)
                             (type-value-array->dims bv))
                  :otherwise (mv bv nil)))
                ((mv new-elem new-body-dims)
                 (type-value-case
                  new-bv
                  :array (mv (type-value-array->elem new-bv)
                             (type-value-array->dims new-bv))
                  :otherwise (mv new-bv nil))))
             (and (equal new-body-dims body-dims)
                  (equal (type-value-kind new-elem) (type-value-kind elem))
                  (implies (not (equal (type-value-kind elem) :array))
                           (expr-value-alpha-equiv-p
                            (expr-value-vector-empty (append dims new-body-dims)
                                                     new-elem)
                            (expr-value-vector-empty (append dims body-dims)
                                                     elem))))))
  :enable (type-value-kind-when-type-value-alpha-equiv-p
           type-value-kind-when-type-value-alpha-related-via-p
           expr-value-alpha-equiv-p-of-vector-empty-when-elem-equiv)
  :use ((:instance type-value-alpha-equiv-p-of-array-elem-when-related
                   (bw (type-value-alpha-equiv-p-witness new-bv bv)))
        (:instance type-value-alpha-equiv-p (new-tval new-bv) (tval bv))))

(defruled eval-tapp-ok-when-vector-empty-aux
  (implies (and (equal (expr-value-kind funval) :vector-empty)
                (not (zp limit))
                (expr-value-alpha-related-via-p new-funval funval w)
                (type-value-alpha-related-via-p new-tval tval tw)
                (expr-value-wfp funval)
                (expr-value-wfp new-funval))
           (b* ((val (eval-tapp funval tval limit))
                (new-val (eval-tapp new-funval new-tval limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((expr-value-alpha-related-via-p new-funval funval w))
  :enable (eval-tapp-when-vector-empty
           expr-value-kind-when-expr-value-alpha-related-via-p-safe
           type-value-kind-when-type-value-alpha-related-via-p-safe
           type-values-match-type-vars-p-of-singletons-when-related-2
           not-type-value-groundp-when-forall
           type-value-groundp-of-expr-value-vector-empty->elem
           not-reserrp-when-expr-valuep)
  :use ((:instance expr-value-vector-empty->elem-when-equal-fix
                   (x new-funval) (y funval))
        (:instance type-value-groundp-of-expr-value-vector-empty->elem
                   (expr-value funval))
        (:instance forall-param-when-type-value-alpha-related-via-p
                   (new-elem (expr-value-vector-empty->elem new-funval))
                   (elem (expr-value-vector-empty->elem funval))
                   (ew (expr-value-witness-vempty->elem w)))
        (:instance type-values-match-type-vars-p-of-singletons-when-related-2
                   (new-var (type-value-forall->param
                             (expr-value-vector-empty->elem new-funval)))
                   (var (type-value-forall->param
                         (expr-value-vector-empty->elem funval))))
        (:instance eval-type-of-forall-closure-body-alpha
                   (new-elem (expr-value-vector-empty->elem new-funval))
                   (elem (expr-value-vector-empty->elem funval))
                   (ew (expr-value-witness-vempty->elem w)))
        (:instance vector-empty-tapp-result-alpha-equiv-when-bodyvals-equiv
                   (new-bv (eval-type
                            (type-value-forall->body
                             (expr-value-vector-empty->elem new-funval))
                            (type-denv-add-type
                             (type-value-forall->param
                              (expr-value-vector-empty->elem funval))
                             new-tval
                             (type-value-forall->denv
                              (expr-value-vector-empty->elem new-funval)))))
                   (bv (eval-type
                        (type-value-forall->body
                         (expr-value-vector-empty->elem funval))
                        (type-denv-add-type
                         (type-value-forall->param
                          (expr-value-vector-empty->elem funval))
                         tval
                         (type-value-forall->denv
                          (expr-value-vector-empty->elem funval)))))
                   (dims (expr-value-vector-empty->dims funval)))))

(defruled eval-tapp-ok-when-vector-empty
  (implies (equal (expr-value-kind funval) :vector-empty)
           (eval-tapp-ok funval tval limit))
  :expand ((eval-tapp-ok funval tval limit))
  :cases ((zp limit))
  :enable eval-tapp-when-zp-limit
  :use ((:instance eval-tapp-ok-when-vector-empty-aux
                   (new-funval (mv-nth 0 (eval-tapp-ok-witness funval tval limit)))
                   (new-tval (mv-nth 1 (eval-tapp-ok-witness funval tval limit)))
                   (w (mv-nth 2 (eval-tapp-ok-witness funval tval limit)))
                   (tw (mv-nth 3 (eval-tapp-ok-witness funval tval limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The type application case of the induction, from its four case lemmas.

(defruled eval-tapp-ok-cases
  (implies (and (implies (and (equal (expr-value-kind funval) :tlambda)
                              (type-values-match-type-vars-p
                               (list tval)
                               (list (expr-value-tlambda->param funval))))
                         (eval-expr-ok (expr-value-tlambda->body funval)
                                       (expr-denv-add-type
                                        (expr-value-tlambda->param funval)
                                        tval
                                        (expr-value-tlambda->denv funval))
                                       (1- limit)))
                (implies (equal (expr-value-kind funval) :vector)
                         (eval-tapp-list-ok (expr-value-vector->elems funval)
                                            tval (1- limit))))
           (eval-tapp-ok funval tval limit))
  :use (eval-tapp-ok-when-tlambda
        eval-tapp-ok-when-primop
        eval-tapp-ok-when-vector
        eval-tapp-ok-when-vector-empty
        eval-tapp-ok-when-otherwise))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The list of type applications (the elements of a vector function value).

(defruled eval-tapp-list-when-zp-limit
  (implies (zp limit)
           (equal (eval-tapp-list funvals tval limit) (reserr :limit)))
  :expand ((eval-tapp-list funvals tval limit)))

(defruled eval-tapp-list-when-endp
  (implies (and (not (zp limit))
                (not (consp funvals)))
           (equal (eval-tapp-list funvals tval limit) nil))
  :expand ((eval-tapp-list funvals tval limit)))

(defruled eval-tapp-list-when-consp
  (implies (and (not (zp limit))
                (consp funvals))
           (equal (eval-tapp-list funvals tval limit)
                  (b* (((ok val) (eval-tapp (car funvals) tval (1- limit)))
                       ((ok vals) (eval-tapp-list (cdr funvals) tval (1- limit))))
                    (cons val vals))))
  :expand ((eval-tapp-list funvals tval limit)))

(defruled eval-tapp-list-ok-when-zp-limit
  (implies (zp limit)
           (eval-tapp-list-ok funvals tval limit))
  :expand ((eval-tapp-list-ok funvals tval limit))
  :enable eval-tapp-list-when-zp-limit)

(defruled eval-tapp-list-ok-when-endp
  (implies (not (consp funvals))
           (eval-tapp-list-ok funvals tval limit))
  :expand ((eval-tapp-list-ok funvals tval limit)
           (:free (a b c) (expr-value-list-alpha-related-via-p a funvals c)))
  :cases ((zp limit))
  :enable (eval-tapp-list-when-zp-limit
           eval-tapp-list-when-endp)
  :use ((:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals nil) (vals nil) (ws nil))))

(defruled eval-tapp-list-ok-when-consp-aux
  (implies (and (consp funvals)
                (not (zp limit))
                (eval-tapp-ok (car funvals) tval (1- limit))
                (implies (not (reserrp (eval-tapp (car funvals) tval (1- limit))))
                         (eval-tapp-list-ok (cdr funvals) tval (1- limit)))
                (expr-value-list-alpha-related-via-p new-funvals funvals ws)
                (type-value-alpha-related-via-p new-tval tval tw)
                (expr-value-list-wfp funvals)
                (expr-value-list-wfp new-funvals))
           (b* ((vals (eval-tapp-list funvals tval limit))
                (new-vals (eval-tapp-list new-funvals new-tval limit)))
             (and (equal (reserrp new-vals) (reserrp vals))
                  (implies (not (reserrp vals))
                           (expr-value-list-alpha-equiv-p new-vals vals)))))
  :expand ((expr-value-list-alpha-related-via-p new-funvals funvals ws)
           (:free (a b c d)
            (expr-value-list-alpha-related-via-p a (cons b c) d)))
  :enable (eval-tapp-list-when-consp
           expr-value-list-wfp
           not-reserrp-when-expr-value-listp
           expr-valuep-when-result-not-error
           expr-value-listp-when-result-not-error)
  :use ((:instance eval-tapp-ok-necc
                   (funval (car funvals))
                   (limit (1- limit))
                   (new-funval (car new-funvals))
                   (w (car ws)))
        (:instance eval-tapp-list-ok-necc
                   (funvals (cdr funvals))
                   (limit (1- limit))
                   (new-funvals (cdr new-funvals))
                   (ws (cdr ws)))
        (:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals (eval-tapp-list new-funvals new-tval limit))
                   (vals (eval-tapp-list funvals tval limit))
                   (ws (cons (expr-value-alpha-equiv-p-witness
                              (eval-tapp (car new-funvals) new-tval (1- limit))
                              (eval-tapp (car funvals) tval (1- limit)))
                             (expr-value-list-alpha-equiv-p-witness
                              (eval-tapp-list (cdr new-funvals) new-tval (1- limit))
                              (eval-tapp-list (cdr funvals) tval (1- limit))))))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-tapp (car new-funvals) new-tval (1- limit)))
                   (val (eval-tapp (car funvals) tval (1- limit))))
        (:instance expr-value-list-alpha-equiv-p
                   (new-vals (eval-tapp-list (cdr new-funvals) new-tval (1- limit)))
                   (vals (eval-tapp-list (cdr funvals) tval (1- limit))))))

(defruled eval-tapp-list-ok-when-consp
  (implies (and (consp funvals)
                (eval-tapp-ok (car funvals) tval (1- limit))
                (implies (not (reserrp (eval-tapp (car funvals) tval (1- limit))))
                         (eval-tapp-list-ok (cdr funvals) tval (1- limit))))
           (eval-tapp-list-ok funvals tval limit))
  :expand ((eval-tapp-list-ok funvals tval limit))
  :cases ((zp limit))
  :enable eval-tapp-list-when-zp-limit
  :use ((:instance eval-tapp-list-ok-when-consp-aux
                   (new-funvals (mv-nth 0 (eval-tapp-list-ok-witness funvals tval limit)))
                   (new-tval (mv-nth 1 (eval-tapp-list-ok-witness funvals tval limit)))
                   (ws (mv-nth 2 (eval-tapp-list-ok-witness funvals tval limit)))
                   (tw (mv-nth 3 (eval-tapp-list-ok-witness funvals tval limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The n-ary type application: the type arguments are evaluated in the
; environment (the type evaluation lemma) and applied one at a time.

(defruled eval-tappn-when-zp-limit
  (implies (zp limit)
           (equal (eval-tappn funval args denv limit) (reserr :limit)))
  :expand ((eval-tappn funval args denv limit)))

(defruled eval-tappn-when-endp
  (implies (and (not (zp limit))
                (not (consp args)))
           (equal (eval-tappn funval args denv limit) (expr-value-fix funval)))
  :expand ((eval-tappn funval args denv limit)))

(defruled eval-tappn-when-consp
  (implies (and (not (zp limit))
                (consp args))
           (equal (eval-tappn funval args denv limit)
                  (b* (((ok tval) (eval-type (car args) (expr-denv->tenv denv)))
                       ((ok val) (eval-tapp funval tval (1- limit))))
                    (eval-tappn val (cdr args) denv (1- limit)))))
  :expand ((eval-tappn funval args denv limit)))

(defruled eval-tappn-ok-when-zp-limit
  (implies (zp limit)
           (eval-tappn-ok funval args denv limit))
  :expand ((eval-tappn-ok funval args denv limit))
  :enable eval-tappn-when-zp-limit)

(defruled eval-tappn-ok-when-endp
  (implies (not (consp args))
           (eval-tappn-ok funval args denv limit))
  :expand ((eval-tappn-ok funval args denv limit))
  :cases ((zp limit))
  :enable (eval-tappn-when-zp-limit
           eval-tappn-when-endp
           type-list-rename-all-vars
           type-list-rename-ispace-vars
           type-list-rename-type-vars
           not-reserrp-when-expr-valuep)
  :use ((:instance expr-value-alpha-equiv-p-suff
                   (new-val (expr-value-fix
                             (mv-nth 0 (eval-tappn-ok-witness funval args denv limit))))
                   (val (expr-value-fix funval))
                   (w (mv-nth 1 (eval-tappn-ok-witness funval args denv limit))))))

(defruled eval-tappn-ok-when-consp-aux
  (implies (and (consp args)
                (not (zp limit))
                (implies (not (reserrp (eval-type (car args) (expr-denv->tenv denv))))
                         (eval-tapp-ok funval
                                       (eval-type (car args) (expr-denv->tenv denv))
                                       (1- limit)))
                (implies (and (not (reserrp (eval-type (car args)
                                                       (expr-denv->tenv denv))))
                              (not (reserrp (eval-tapp funval
                                                       (eval-type (car args)
                                                                  (expr-denv->tenv denv))
                                                       (1- limit)))))
                         (eval-tappn-ok (eval-tapp funval
                                                   (eval-type (car args)
                                                              (expr-denv->tenv denv))
                                                   (1- limit))
                                        (cdr args) denv (1- limit)))
                (expr-value-alpha-related-via-p new-funval funval w)
                (type-list-fresh-ok args r)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (type-list-free-ispace-vars args)
                                           (type-list-free-type-vars args)
                                           nil)
                (expr-value-wfp funval)
                (expr-value-wfp new-funval)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((val (eval-tappn funval args denv limit))
                (new-val (eval-tappn new-funval
                                     (type-list-rename-all-vars args r)
                                     new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((type-list-fresh-ok args r)
           (type-list-free-ispace-vars args)
           (type-list-free-type-vars args)
           (expr-denv-alpha-related-via-p new-denv denv r dw)
           (:free (i tv e) (expr-denv-alpha-avoided-p new-denv denv r i tv e))
           (:free (i tv) (type-denv-alpha-avoided-p (expr-denv->tenv new-denv)
                                                    (expr-denv->tenv denv)
                                                    r i tv)))
  :enable (eval-tappn-when-consp
           type-list-rename-all-vars
           type-list-rename-ispace-vars
           type-list-rename-type-vars
           type-rename-all-vars
           denv-ispace-vars-avoided-p-monotone
           type-var-map-avoided-p-monotone
           string-expr-value-map-avoided-p-monotone
           expr-value-wfp-of-eval-tapp
           not-reserrp-when-expr-valuep
           expr-valuep-when-result-not-error)
  :use ((:instance eval-type-alpha-when-equal
                   (new-type (type-rename-all-vars (car args) r))
                   (type (car args))
                   (new-denv (expr-denv->tenv new-denv))
                   (denv (expr-denv->tenv denv))
                   (wmap (denv-witness->types dw)))
        (:instance eval-tapp-ok-necc
                   (tval (eval-type (car args) (expr-denv->tenv denv)))
                   (limit (1- limit))
                   (new-tval (eval-type (type-rename-all-vars (car args) r)
                                        (expr-denv->tenv new-denv)))
                   (tw (eval-type-witness (car args) r (denv-witness->types dw))))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-tapp new-funval
                                       (eval-type (type-rename-all-vars (car args) r)
                                                  (expr-denv->tenv new-denv))
                                       (1- limit)))
                   (val (eval-tapp funval
                                   (eval-type (car args) (expr-denv->tenv denv))
                                   (1- limit))))
        (:instance eval-tappn-ok-necc
                   (funval (eval-tapp funval
                                      (eval-type (car args) (expr-denv->tenv denv))
                                      (1- limit)))
                   (args (cdr args))
                   (limit (1- limit))
                   (new-funval (eval-tapp new-funval
                                          (eval-type (type-rename-all-vars (car args) r)
                                                     (expr-denv->tenv new-denv))
                                          (1- limit)))
                   (w (expr-value-alpha-equiv-p-witness
                       (eval-tapp new-funval
                                  (eval-type (type-rename-all-vars (car args) r)
                                             (expr-denv->tenv new-denv))
                                  (1- limit))
                       (eval-tapp funval
                                  (eval-type (car args) (expr-denv->tenv denv))
                                  (1- limit)))))))

(defruled eval-tappn-ok-when-consp
  (implies (and (consp args)
                (implies (not (reserrp (eval-type (car args) (expr-denv->tenv denv))))
                         (eval-tapp-ok funval
                                       (eval-type (car args) (expr-denv->tenv denv))
                                       (1- limit)))
                (implies (and (not (reserrp (eval-type (car args)
                                                       (expr-denv->tenv denv))))
                              (not (reserrp (eval-tapp funval
                                                       (eval-type (car args)
                                                                  (expr-denv->tenv denv))
                                                       (1- limit)))))
                         (eval-tappn-ok (eval-tapp funval
                                                   (eval-type (car args)
                                                              (expr-denv->tenv denv))
                                                   (1- limit))
                                        (cdr args) denv (1- limit))))
           (eval-tappn-ok funval args denv limit))
  :expand ((eval-tappn-ok funval args denv limit))
  :cases ((zp limit))
  :enable eval-tappn-when-zp-limit
  :use ((:instance eval-tappn-ok-when-consp-aux
                   (new-funval (mv-nth 0 (eval-tappn-ok-witness funval args denv limit)))
                   (w (mv-nth 1 (eval-tappn-ok-witness funval args denv limit)))
                   (new-denv (mv-nth 2 (eval-tappn-ok-witness funval args denv limit)))
                   (r (mv-nth 3 (eval-tappn-ok-witness funval args denv limit)))
                   (dw (mv-nth 4 (eval-tappn-ok-witness funval args denv limit)))
                   (b (mv-nth 5 (eval-tappn-ok-witness funval args denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Product type closure application (the empty-vector case of ispace
; application): the ispace layer counterparts of the lemmas for universal
; type closures.

(defruled rename-ispace-var-of-remove-bound-singleton-same
  (implies (ispace-varp var)
           (b* (((mv & & dim1 shape1)
                 (dim/shape-rename-remove-bound (set::insert var nil) dm sm)))
             (equal (rename-ispace-var var dim1 shape1) var)))
  :enable (dim/shape-rename-remove-bound
           rename-ispace-var
           rename-var-string-of-delete*
           in-of-dim-names-of-ispace-vars
           in-of-shape-names-of-ispace-vars))

(defruled denv-ispace-vars-covered-p-of-add-ispace-same-remove-bound
  (implies (and (denv-ispace-vars-covered-p new-ienv ienv dim-renam shape-renam)
                (ispace-varp iv)
                (not (set::in iv
                              (ispace-var-set-rename-ispace-vars
                               (set::delete iv (omap::keys (ispace-denv->ispaces ienv)))
                               (mv-nth 2 (dim/shape-rename-remove-bound
                                          (set::insert iv nil) dim-renam shape-renam))
                               (mv-nth 3 (dim/shape-rename-remove-bound
                                          (set::insert iv nil) dim-renam shape-renam))))))
           (b* (((mv & & dim1 shape1)
                 (dim/shape-rename-remove-bound (set::insert iv nil)
                                                dim-renam shape-renam)))
             (denv-ispace-vars-covered-p
              (ispace-denv-add-ispace iv ival new-ienv)
              (ispace-denv-add-ispace iv ival ienv)
              dim1 shape1)))
  :expand ((:free (m1 m2 d s)
            (denv-ispace-vars-covered-p (ispace-denv m1) (ispace-denv m2) d s)))
  :enable (ispace-denv-add-ispace
           rename-ispace-var-of-remove-bound-when-not-in
           rename-ispace-var-of-remove-bound-singleton-same
           omap::assoc-of-update
           omap::in-of-keys-to-assoc)
  :use ((:instance denv-ispace-vars-covered-p-necc
                   (new-denv new-ienv) (denv ienv)
                   (var (denv-ispace-vars-covered-p-witness
                         (ispace-denv
                          (omap::update iv (ispace-value-fix ival)
                                        (ispace-denv->ispaces new-ienv)))
                         (ispace-denv
                          (omap::update iv (ispace-value-fix ival)
                                        (ispace-denv->ispaces ienv)))
                         (mv-nth 2 (dim/shape-rename-remove-bound
                                    (set::insert iv nil) dim-renam shape-renam))
                         (mv-nth 3 (dim/shape-rename-remove-bound
                                    (set::insert iv nil) dim-renam shape-renam)))))
        (:instance in-of-rename-ispace-var-of-ispace-var-set-rename-ispace-vars
                   (var (denv-ispace-vars-covered-p-witness
                         (ispace-denv
                          (omap::update iv (ispace-value-fix ival)
                                        (ispace-denv->ispaces new-ienv)))
                         (ispace-denv
                          (omap::update iv (ispace-value-fix ival)
                                        (ispace-denv->ispaces ienv)))
                         (mv-nth 2 (dim/shape-rename-remove-bound
                                    (set::insert iv nil) dim-renam shape-renam))
                         (mv-nth 3 (dim/shape-rename-remove-bound
                                    (set::insert iv nil) dim-renam shape-renam))))
                   (vars (set::delete iv (omap::keys (ispace-denv->ispaces ienv))))
                   (dim-renam (mv-nth 2 (dim/shape-rename-remove-bound
                                         (set::insert iv nil) dim-renam shape-renam)))
                   (shape-renam (mv-nth 3 (dim/shape-rename-remove-bound
                                           (set::insert iv nil) dim-renam shape-renam))))))

(defruled denv-ispace-vars-avoided-p-of-add-ispace-same-remove-bound
  (implies (and (denv-ispace-vars-avoided-p new-ienv ienv dim-renam shape-renam
                                            (set::delete iv (ispace-var-set-fix vars)))
                (ispace-varp iv)
                (not (set::in iv
                              (ispace-var-set-rename-ispace-vars
                               (set::delete iv (ispace-var-set-fix vars))
                               (mv-nth 2 (dim/shape-rename-remove-bound
                                          (set::insert iv nil) dim-renam shape-renam))
                               (mv-nth 3 (dim/shape-rename-remove-bound
                                          (set::insert iv nil) dim-renam shape-renam))))))
           (b* (((mv & & dim1 shape1)
                 (dim/shape-rename-remove-bound (set::insert iv nil)
                                                dim-renam shape-renam)))
             (denv-ispace-vars-avoided-p
              (ispace-denv-add-ispace iv ival new-ienv)
              (ispace-denv-add-ispace iv ival ienv)
              dim1 shape1 vars)))
  :expand ((:free (m1 m2 d s)
            (denv-ispace-vars-avoided-p (ispace-denv m1) (ispace-denv m2) d s vars)))
  :enable (ispace-denv-add-ispace
           rename-ispace-var-of-remove-bound-when-not-in
           omap::assoc-of-update)
  :use ((:instance denv-ispace-vars-avoided-p-necc
                   (new-denv new-ienv) (denv ienv)
                   (vars (set::delete iv (ispace-var-set-fix vars)))
                   (var (denv-ispace-vars-avoided-p-witness
                         (ispace-denv
                          (omap::update iv (ispace-value-fix ival)
                                        (ispace-denv->ispaces new-ienv)))
                         (ispace-denv
                          (omap::update iv (ispace-value-fix ival)
                                        (ispace-denv->ispaces ienv)))
                         (mv-nth 2 (dim/shape-rename-remove-bound
                                    (set::insert iv nil) dim-renam shape-renam))
                         (mv-nth 3 (dim/shape-rename-remove-bound
                                    (set::insert iv nil) dim-renam shape-renam))
                         vars)))
        (:instance in-of-rename-ispace-var-of-ispace-var-set-rename-ispace-vars
                   (var (denv-ispace-vars-avoided-p-witness
                         (ispace-denv
                          (omap::update iv (ispace-value-fix ival)
                                        (ispace-denv->ispaces new-ienv)))
                         (ispace-denv
                          (omap::update iv (ispace-value-fix ival)
                                        (ispace-denv->ispaces ienv)))
                         (mv-nth 2 (dim/shape-rename-remove-bound
                                    (set::insert iv nil) dim-renam shape-renam))
                         (mv-nth 3 (dim/shape-rename-remove-bound
                                    (set::insert iv nil) dim-renam shape-renam))
                         vars))
                   (vars (set::delete iv (ispace-var-set-fix vars)))
                   (dim-renam (mv-nth 2 (dim/shape-rename-remove-bound
                                         (set::insert iv nil) dim-renam shape-renam)))
                   (shape-renam (mv-nth 3 (dim/shape-rename-remove-bound
                                           (set::insert iv nil) dim-renam shape-renam))))))

(defruled type-var-type-value-map-alpha-related-via-p-of-change-dim-shape
  (equal (type-var-type-value-map-alpha-related-via-p
          new-map map (change-var-renamings r :dim d :shape s) wmap)
         (type-var-type-value-map-alpha-related-via-p new-map map r wmap))
  :induct (omap::size map)
  :enable omap::size
  :expand ((:free (r) (type-var-type-value-map-alpha-related-via-p
                       new-map map r wmap))))

(defruled type-denv-alpha-related-via-p-of-add-ispace-same-remove-bound
  (implies (and (type-denv-alpha-related-via-p new-tenv tenv r wmap)
                (ispace-varp iv)
                (not (set::in iv
                              (ispace-var-set-rename-ispace-vars
                               (set::delete iv (omap::keys
                                                (ispace-denv->ispaces
                                                 (type-denv->ienv tenv))))
                               (mv-nth 2 (dim/shape-rename-remove-bound
                                          (set::insert iv nil)
                                          (var-renamings->dim r)
                                          (var-renamings->shape r)))
                               (mv-nth 3 (dim/shape-rename-remove-bound
                                          (set::insert iv nil)
                                          (var-renamings->dim r)
                                          (var-renamings->shape r)))))))
           (b* (((mv & & dim1 shape1)
                 (dim/shape-rename-remove-bound (set::insert iv nil)
                                                (var-renamings->dim r)
                                                (var-renamings->shape r))))
             (type-denv-alpha-related-via-p
              (type-denv-add-ispace iv ival new-tenv)
              (type-denv-add-ispace iv ival tenv)
              (change-var-renamings r :dim dim1 :shape shape1)
              wmap)))
  :expand ((:free (a b r wm) (type-denv-alpha-related-via-p a b r wm)))
  :enable (type-denv-add-ispace
           type-var-type-value-map-alpha-related-via-p-of-change-dim-shape)
  :use ((:instance denv-ispace-vars-covered-p-of-add-ispace-same-remove-bound
                   (new-ienv (type-denv->ienv new-tenv))
                   (ienv (type-denv->ienv tenv))
                   (dim-renam (var-renamings->dim r))
                   (shape-renam (var-renamings->shape r)))))

(defruled not-in-ispace-image-of-delete-keys-when-type-denv-keys-within-p
  (implies (and (type-denv-keys-within-p tenv ivars tvars)
                (ispace-var-setp ivars)
                (not (set::in x (ispace-var-set-rename-ispace-vars ivars dm sm))))
           (not (set::in x (ispace-var-set-rename-ispace-vars
                            (set::delete v (omap::keys
                                            (ispace-denv->ispaces
                                             (type-denv->ienv tenv))))
                            dm sm))))
  :enable (type-denv-keys-within-p)
  :use ((:instance not-in-ispace-var-image-when-subset
                   (elt x)
                   (a (set::delete v (omap::keys (ispace-denv->ispaces
                                                  (type-denv->ienv tenv)))))
                   (b ivars)
                   (dim-m dm)
                   (shape-m sm))
        (:instance set::subset-transitive
                   (x (set::delete v (omap::keys (ispace-denv->ispaces
                                                  (type-denv->ienv tenv)))))
                   (y (omap::keys (ispace-denv->ispaces (type-denv->ienv tenv))))
                   (z ivars))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Groundness of the values built by the array builders from ground elements,
; and hence of the results of the single-stage ispace primitives (except
; shape reification, whose box carries a product type closure: that result
; is related to itself via a closure witness with empty renamings).

(defruled expr-value-list-groundp-of-repeat
  (implies (expr-value-groundp val)
           (expr-value-list-groundp (repeat n val)))
  :induct (repeat n val)
  :enable (repeat
           expr-value-list-groundp-of-cons
           expr-value-list-groundp-when-atom))

(defruled expr-value-groundp-of-expr-value-with-empty-dim
  (implies (type-value-groundp elem)
           (expr-value-groundp (expr-value-with-empty-dim dims elem)))
  :induct (expr-value-with-empty-dim dims elem)
  :enable (expr-value-with-empty-dim
           expr-value-list-groundp-of-repeat))

(defruled expr-value-list-groundp-of-nthcdr
  (implies (expr-value-list-groundp vals)
           (expr-value-list-groundp (nthcdr n vals)))
  :induct (nthcdr n vals)
  :enable (nthcdr
         len
           expr-value-list-groundp-when-atom
           expr-value-list-groundp-of-cdr-when-expr-value-list-groundp))

(encapsulate ()

  (local (include-book "arithmetic-3/top" :dir :system))
  (local (include-book "std/lists/take" :dir :system))
  (local (include-book "std/lists/nthcdr" :dir :system))

  ; The take/nthcdr inductions below need this rule off.
  (local (in-theory (disable acl2::nthcdr-of-cdr)))

  (defruled expr-value-list-groundp-of-take
    (implies (and (expr-value-list-groundp vals)
                  (<= (nfix n) (len vals)))
             (expr-value-list-groundp (take n vals)))
    :induct (take n vals)
    :enable (take
             expr-value-list-groundp-of-cons
             expr-value-list-groundp-when-atom
             expr-value-groundp-of-car-when-expr-value-list-groundp
             expr-value-list-groundp-of-cdr-when-expr-value-list-groundp))

  (define expr-value-list-list-groundp ((valss expr-value-list-listp))
    :returns (yes/no booleanp)
    (or (endp valss)
        (and (expr-value-list-groundp (car valss))
             (expr-value-list-list-groundp (cdr valss)))))

  (defruled expr-value-list-list-groundp-of-list-split
    (implies (and (expr-value-list-groundp vals)
                  (posp chunk)
                  (integerp (/ (len vals) chunk)))
             (expr-value-list-list-groundp (list-split vals chunk)))
    :induct (list-split vals chunk)
    :enable (list-split
             expr-value-list-list-groundp
             expr-value-list-groundp-of-take
             expr-value-list-groundp-of-nthcdr
             fix nfix
             lt-to-zero-when-divided-by-pos)
    :hints ('(:use (:instance integerp-of-div-of-diff
                              (x (len vals))
                              (c (pos-fix chunk))))))

  ; The chunking performed by the builders is exact (as in the proofs about
  ; the same builders in EXPRESSION-VALUES-AND-ENVIRONMENTS, whose
  ; POSP-OF-LEN-OVER-CAR-OF-DIMS is used here too).

  (defruledl chunk-divides-lemma
    (implies (and (nat-listp dims)
                  (not (member-equal 0 dims))
                  (consp dims)
                  (equal (len vals) (nat-list-product dims)))
             (integerp (/ (len vals) (* (/ (car dims)) (len vals)))))
    :use nat-list-product-divided-by-car)

  (defruledl expr-value-list-list-groundp-of-list-split-chunk
    (implies (and (nat-listp dims)
                  (not (member-equal 0 dims))
                  (consp dims)
                  (equal (len vals) (nat-list-product dims))
                  (expr-value-list-groundp vals))
             (expr-value-list-list-groundp
              (list-split vals (* (/ (car dims)) (len vals)))))
    :use ((:instance expr-value-list-list-groundp-of-list-split
                     (chunk (* (/ (car dims)) (len vals))))
          posp-of-len-over-car-of-dims
          chunk-divides-lemma))

  (defthm-expr-values-with-nonempty-dims-flag
    (defthm expr-value-groundp-of-expr-value-with-nonempty-dims
      (implies (and (nat-listp dims)
                    (expr-value-listp vals)
                    (not (member-equal 0 dims))
                    (equal (len vals) (nat-list-product dims))
                    (expr-value-list-groundp vals))
               (expr-value-groundp (expr-value-with-nonempty-dims dims vals)))
      :flag expr-value-with-nonempty-dims)
    (defthm expr-value-list-groundp-of-expr-value-list-with-nonempty-dims
      (implies (and (nat-listp dims)
                    (expr-value-list-listp valss)
                    (not (member-equal 0 dims))
                    (all-of-len-p valss (nat-list-product dims))
                    (expr-value-list-list-groundp valss))
               (expr-value-list-groundp
                (expr-value-list-with-nonempty-dims dims valss)))
      :flag expr-value-list-with-nonempty-dims)
    :hints (("Goal"
             :in-theory (enable expr-value-with-nonempty-dims
                                expr-value-list-with-nonempty-dims
                                expr-value-list-list-groundp
                                expr-value-list-list-groundp-of-list-split-chunk
                                expr-value-list-groundp-of-cons
                                expr-value-list-groundp-when-atom
                                expr-value-groundp-of-car-when-expr-value-list-groundp
                                all-of-len-p
                                nat-list-product-of-cdr-to-ratio
                                pos-fix
                                posp-of-len-over-car-of-dims))))

  (in-theory (disable expr-value-groundp-of-expr-value-with-nonempty-dims
                      expr-value-list-groundp-of-expr-value-list-with-nonempty-dims))

  (defruled expr-value-groundp-of-prim-iota/static
    (expr-value-groundp (prim-iota/static s))
    :enable (prim-iota/static
             expr-value-groundp-of-expr-value-with-empty-dim
             nfix fix)
    :use ((:instance expr-value-groundp-of-expr-value-with-nonempty-dims
                     (dims (nat-list-fix s))
                     (vals (expr-value-base-list
                            (base-value-int-list
                             (int-value-list-of
                              (nat-list-from-to
                               0 (nat-list-product (nat-list-fix s)))))))))))

(defruled expr-value-groundp-of-prim-reify-dim
  (expr-value-groundp (prim-reify-dim d))
  :enable prim-reify-dim)

; Shape reification: the boxed array is ground, the box's type is a
; product type closure with an empty environment, related to itself via
; the closure witness with empty renamings.

(defruled denv-ispace-vars-covered-p-when-empty
  (implies (not (ispace-denv->ispaces denv))
           (denv-ispace-vars-covered-p new-denv denv d s))
  :expand ((denv-ispace-vars-covered-p new-denv denv d s)))

(defruled denv-ispace-vars-avoided-p-when-empty
  (implies (not (ispace-denv->ispaces new-denv))
           (denv-ispace-vars-avoided-p new-denv denv d s vars))
  :expand ((denv-ispace-vars-avoided-p new-denv denv d s vars)))

(defruled type-var-map-avoided-p-when-empty
  (implies (not (type-var-type-value-map-fix new-map))
           (type-var-map-avoided-p new-map map a ar vars))
  :expand ((type-var-map-avoided-p new-map map a ar vars)))

(defruled expr-value-alpha-related-via-p-of-box-same
  (implies (and (expr-value-alpha-related-via-p arr arr aw)
                (type-value-alpha-related-via-p ty ty tw))
           (expr-value-alpha-related-via-p
            (expr-value-box i arr ty)
            (expr-value-box i arr ty)
            (make-expr-value-witness-box :array aw :type tw)))
  :expand ((:free (nv w) (expr-value-alpha-related-via-p
                          nv (expr-value-box i arr ty) w))))

; The product type value of shape reification (a constant) is related to
; itself via the closure witness with empty renamings: the environment is
; empty and the renamings are the identity.

(defruled type-value-alpha-related-via-p-of-reify-shape-type-same
  (type-value-alpha-related-via-p
   '(:sigma (:dim "r")
            (:bracket (:base (:int)) ((:shape (:dims ((:var "r"))))))
            ((ienv (ispaces)) (types)))
   '(:sigma (:dim "r")
            (:bracket (:base (:int)) ((:shape (:dims ((:var "r"))))))
            ((ienv (ispaces)) (types)))
   '(:closure ((dim) (shape) (atom) (array) (expr) (avoid)) nil))
  :expand ((type-value-alpha-related-via-p
            '(:sigma (:dim "r")
                     (:bracket (:base (:int)) ((:shape (:dims ((:var "r"))))))
                     ((ienv (ispaces)) (types)))
            '(:sigma (:dim "r")
                     (:bracket (:base (:int)) ((:shape (:dims ((:var "r"))))))
                     ((ienv (ispaces)) (types)))
            '(:closure ((dim) (shape) (atom) (array) (expr) (avoid)) nil)))
  :enable (type-denv-alpha-related-via-p
           type-denv-alpha-avoided-p
           type-denv-keys-within-p
           type-fresh-ok
           denv-ispace-vars-covered-p-when-empty
           denv-ispace-vars-avoided-p-when-empty
           type-var-map-avoided-p-when-empty)
  :disable ((:e type-value-alpha-related-via-p)
            (:e type-denv-alpha-related-via-p)
            (:e type-denv-alpha-avoided-p)))

(defruled expr-value-alpha-equiv-p-of-prim-reify-shape-same
  (expr-value-alpha-equiv-p (prim-reify-shape s) (prim-reify-shape s))
  :enable (prim-reify-shape
           nat-list-product
           nfix fix
           type-value-alpha-related-via-p-of-reify-shape-type-same)
  :disable ((:e expr-value-alpha-related-via-p)
            (:e type-value-alpha-related-via-p))
  :use ((:instance expr-value-groundp-of-expr-value-with-nonempty-dims
                   (dims (list (len s)))
                   (vals (expr-value-base-list
                          (base-value-int-list
                           (int-value-list-of (nat-list-fix s))))))
        (:instance expr-value-groundp-of-expr-value-with-empty-dim
                   (dims (list 0))
                   (elem (type-value-base (base-type-int))))
        (:instance expr-value-alpha-related-via-p-of-box-same
                   (i (ispace-value-dim (len s)))
                   (arr (expr-value-with-nonempty-dims
                         (list (len s))
                         (expr-value-base-list
                          (base-value-int-list
                           (int-value-list-of (nat-list-fix s))))))
                   (ty '(:sigma (:dim "r")
                                (:bracket (:base (:int))
                                          ((:shape (:dims ((:var "r"))))))
                                ((ienv (ispaces)) (types))))
                   (aw '(:atom))
                   (tw '(:closure ((dim) (shape) (atom) (array) (expr) (avoid))
                                  nil)))
        (:instance expr-value-alpha-related-via-p-of-box-same
                   (i (ispace-value-dim 0))
                   (arr (expr-value-with-empty-dim (list 0)
                                                   (type-value-base (base-type-int))))
                   (ty '(:sigma (:dim "r")
                                (:bracket (:base (:int))
                                          ((:shape (:dims ((:var "r"))))))
                                ((ienv (ispaces)) (types))))
                   (aw '(:atom))
                   (tw '(:closure ((dim) (shape) (atom) (array) (expr) (avoid))
                                  nil)))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (prim-reify-shape s))
                   (val (prim-reify-shape s))
                   (w (make-expr-value-witness-box
                       :array (expr-value-witness-atom)
                       :type '(:closure ((dim) (shape) (atom) (array) (expr) (avoid))
                                        nil))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Ispace application (EVAL-IAPP): the ispace argument is a ground value,
; equal on both sides; the cases mirror those of type application.

(defruled eval-iapp-when-zp-limit
  (implies (zp limit)
           (equal (eval-iapp funval ival limit) (reserr :limit)))
  :expand ((eval-iapp funval ival limit)))

(defruled eval-iapp-when-ilambda
  (implies (and (equal (expr-value-kind funval) :ilambda)
                (not (zp limit)))
           (equal (eval-iapp funval ival limit)
                  (b* (((unless (ispace-values-match-ispace-vars-p
                                 (list ival)
                                 (list (expr-value-ilambda->param funval))))
                        (reserr nil))
                       (denv (expr-denv-add-ispace (expr-value-ilambda->param funval)
                                                   ival
                                                   (expr-value-ilambda->denv funval))))
                    (eval-expr (expr-value-ilambda->body funval) denv (1- limit)))))
  :expand ((eval-iapp funval ival limit)))

(defruled eval-iapp-when-primop
  (implies (and (equal (expr-value-kind funval) :primop)
                (not (zp limit)))
           (equal (eval-iapp funval ival limit)
                  (if (primop-value-ifunp (expr-value-primop->val funval))
                      (eval-primop-ifun (expr-value-primop->val funval) ival)
                    (reserr nil))))
  :expand ((eval-iapp funval ival limit)))

(defruled eval-iapp-when-vector
  (implies (and (equal (expr-value-kind funval) :vector)
                (not (zp limit)))
           (equal (eval-iapp funval ival limit)
                  (b* (((ok vals) (eval-iapp-list (expr-value-vector->elems funval)
                                                  ival (1- limit)))
                       ((unless (consp vals)) (reserr nil))
                       ((unless (list-repeatp (dims-of-expr-value-list vals)))
                        (reserr nil)))
                    (expr-value-vector vals))))
  :expand ((eval-iapp funval ival limit)))

(defruled eval-iapp-when-vector-empty
  (implies (and (equal (expr-value-kind funval) :vector-empty)
                (not (zp limit)))
           (equal (eval-iapp funval ival limit)
                  (b* ((elemtv (expr-value-vector-empty->elem funval)))
                    (if (type-value-case elemtv :pi)
                        (b* (((unless (ispace-values-match-ispace-vars-p
                                       (list ival)
                                       (list (type-value-pi->param elemtv))))
                              (reserr nil))
                             (tenv (type-denv-add-ispace
                                    (type-value-pi->param elemtv)
                                    ival
                                    (type-value-pi->denv elemtv)))
                             ((ok bodyval) (eval-type (type-value-pi->body elemtv)
                                                      tenv))
                             ((mv elem body-dims)
                              (type-value-case
                               bodyval
                               :array (mv (type-value-array->elem bodyval)
                                          (type-value-array->dims bodyval))
                               :otherwise (mv bodyval nil)))
                             ((when (type-value-case elem :array)) (reserr nil)))
                          (expr-value-vector-empty
                           (append (expr-value-vector-empty->dims funval) body-dims)
                           elem))
                      (reserr nil)))))
  :expand ((eval-iapp funval ival limit)))

(defruled eval-iapp-when-otherwise
  (implies (and (not (equal (expr-value-kind funval) :ilambda))
                (not (equal (expr-value-kind funval) :primop))
                (not (equal (expr-value-kind funval) :vector))
                (not (equal (expr-value-kind funval) :vector-empty))
                (not (zp limit)))
           (equal (eval-iapp funval ival limit)
                  (reserr nil)))
  :expand ((eval-iapp funval ival limit)))

; The primitive operations applied to ispace values: the next instantiation
; stage carries the same embedded type values (related via the same
; witnesses) and the ground ispace value; the single-stage operations
; yield ground results.

(defruled eval-primop-ifun-alpha
  (implies (primop-value-alpha-related-via-p new-op op tws ws)
           (b* ((val (eval-primop-ifun op ival))
                (new-val (eval-primop-ifun new-op ival)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :enable (eval-primop-ifun
           primop-value-kind-when-primop-value-alpha-related-via-p
           not-reserrp-when-expr-valuep
           expr-value-groundp-of-prim-iota/static
           expr-value-groundp-of-prim-reify-dim
           expr-value-alpha-equiv-p-of-prim-reify-shape-same)
  :expand ((primop-value-alpha-related-via-p new-op op tws ws)
           (:free (new-val val w)
            (expr-value-alpha-related-via-p new-val
                                            (expr-value-primop val)
                                            w))
           (:free (new-op op tws ws)
            (primop-value-alpha-related-via-p new-op op tws ws)))
  :use ((:instance expr-value-alpha-equiv-p-suff
                   (new-val (eval-primop-ifun new-op ival))
                   (val (eval-primop-ifun op ival))
                   (w (expr-value-witness-primop tws ws)))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (eval-primop-ifun new-op ival))
                   (val (eval-primop-ifun op ival))
                   (w (expr-value-witness-atom)))))

(defruled eval-iapp-ok-when-primop-aux
  (implies (and (equal (expr-value-kind funval) :primop)
                (not (zp limit))
                (expr-value-alpha-related-via-p new-funval funval w))
           (b* ((val (eval-iapp funval ival limit))
                (new-val (eval-iapp new-funval ival limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((expr-value-alpha-related-via-p new-funval funval w)
           (expr-value-groundp funval))
  :enable (eval-iapp-when-primop
           expr-value-kind-when-expr-value-alpha-related-via-p-safe
           primop-value-ifunp-when-primop-value-alpha-related-via-p-safe)
  :use ((:instance expr-value-primop->val-when-equal-fix
                   (x new-funval) (y funval))
        (:instance eval-primop-ifun-alpha
                   (new-op (expr-value-primop->val new-funval))
                   (op (expr-value-primop->val funval))
                   (tws (expr-value-witness-primop->tws w))
                   (ws (expr-value-witness-primop->ws w)))
        (:instance eval-primop-ifun-alpha
                   (new-op (expr-value-primop->val funval))
                   (op (expr-value-primop->val funval))
                   (tws nil)
                   (ws nil))
        (:instance primop-value-alpha-related-via-p-of-same-when-ground
                   (op (expr-value-primop->val funval)))))

(defruled eval-iapp-ok-when-primop
  (implies (equal (expr-value-kind funval) :primop)
           (eval-iapp-ok funval ival limit))
  :expand ((eval-iapp-ok funval ival limit))
  :cases ((zp limit))
  :enable eval-iapp-when-zp-limit
  :use ((:instance eval-iapp-ok-when-primop-aux
                   (new-funval (mv-nth 0 (eval-iapp-ok-witness funval ival limit)))
                   (w (mv-nth 1 (eval-iapp-ok-witness funval ival limit))))))

(defruled eval-iapp-ok-when-vector-aux
  (implies (and (equal (expr-value-kind funval) :vector)
                (not (zp limit))
                (eval-iapp-list-ok (expr-value-vector->elems funval) ival (1- limit))
                (expr-value-alpha-related-via-p new-funval funval w)
                (expr-value-wfp funval)
                (expr-value-wfp new-funval))
           (b* ((val (eval-iapp funval ival limit))
                (new-val (eval-iapp new-funval ival limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((expr-value-alpha-related-via-p new-funval funval w)
           (expr-value-groundp funval)
           (:free (a b w) (expr-value-alpha-related-via-p a (expr-value-vector b) w)))
  :enable (eval-iapp-when-vector
           expr-value-kind-when-expr-value-alpha-related-via-p-safe
           consp-when-expr-value-list-alpha-related-via-p-safe
           dims-of-expr-value-list-when-alpha-related-safe
           expr-value-list-wfp-of-eval-iapp-list
           not-reserrp-when-expr-value-listp
           not-reserrp-when-expr-valuep
           expr-value-listp-when-result-not-error)
  :use ((:instance expr-value-vector->elems-when-equal-fix
                   (x new-funval) (y funval))
        (:instance eval-iapp-list-ok-necc
                   (funvals (expr-value-vector->elems funval))
                   (limit (1- limit))
                   (new-funvals (expr-value-vector->elems new-funval))
                   (ws (expr-value-witness-vector->elems w)))
        (:instance eval-iapp-list-ok-necc
                   (funvals (expr-value-vector->elems funval))
                   (limit (1- limit))
                   (new-funvals (expr-value-vector->elems funval))
                   (ws (repeat (len (expr-value-vector->elems funval)) '(:atom))))
        (:instance expr-value-list-alpha-related-via-p-of-same-when-ground
                   (vals (expr-value-vector->elems funval)))
        (:instance expr-value-list-alpha-equiv-p
                   (new-vals (eval-iapp-list (expr-value-vector->elems new-funval)
                                             ival (1- limit)))
                   (vals (eval-iapp-list (expr-value-vector->elems funval)
                                         ival (1- limit))))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (eval-iapp new-funval ival limit))
                   (val (eval-iapp funval ival limit))
                   (w (expr-value-witness-vector
                       (expr-value-list-alpha-equiv-p-witness
                        (eval-iapp-list (expr-value-vector->elems new-funval)
                                        ival (1- limit))
                        (eval-iapp-list (expr-value-vector->elems funval)
                                        ival (1- limit))))))))

(defruled eval-iapp-ok-when-vector
  (implies (and (equal (expr-value-kind funval) :vector)
                (eval-iapp-list-ok (expr-value-vector->elems funval) ival (1- limit)))
           (eval-iapp-ok funval ival limit))
  :expand ((eval-iapp-ok funval ival limit))
  :cases ((zp limit))
  :enable eval-iapp-when-zp-limit
  :use ((:instance eval-iapp-ok-when-vector-aux
                   (new-funval (mv-nth 0 (eval-iapp-ok-witness funval ival limit)))
                   (w (mv-nth 1 (eval-iapp-ok-witness funval ival limit))))))

(defruled eval-iapp-ok-when-otherwise-aux
  (implies (and (not (equal (expr-value-kind funval) :ilambda))
                (not (equal (expr-value-kind funval) :primop))
                (not (equal (expr-value-kind funval) :vector))
                (not (equal (expr-value-kind funval) :vector-empty))
                (not (zp limit))
                (expr-value-alpha-related-via-p new-funval funval w))
           (b* ((val (eval-iapp funval ival limit))
                (new-val (eval-iapp new-funval ival limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :enable (eval-iapp-when-otherwise
           expr-value-kind-when-expr-value-alpha-related-via-p-safe))

(defruled eval-iapp-ok-when-otherwise
  (implies (and (not (equal (expr-value-kind funval) :ilambda))
                (not (equal (expr-value-kind funval) :primop))
                (not (equal (expr-value-kind funval) :vector))
                (not (equal (expr-value-kind funval) :vector-empty)))
           (eval-iapp-ok funval ival limit))
  :expand ((eval-iapp-ok funval ival limit))
  :cases ((zp limit))
  :enable eval-iapp-when-zp-limit
  :use ((:instance eval-iapp-ok-when-otherwise-aux
                   (new-funval (mv-nth 0 (eval-iapp-ok-witness funval ival limit)))
                   (w (mv-nth 1 (eval-iapp-ok-witness funval ival limit))))))

; Applying related product type closures to the same ispace argument.

(defruled pi-param-when-type-value-alpha-related-via-p
  (implies (and (type-value-alpha-related-via-p new-elem elem ew)
                (equal (type-value-kind elem) :pi))
           (and (equal (type-value-kind new-elem) :pi)
                (equal (type-value-pi->param new-elem)
                       (type-value-pi->param elem))))
  :expand ((type-value-alpha-related-via-p new-elem elem ew))
  :enable not-type-value-groundp-when-pi)

(defruled eval-type-of-pi-closure-body-alpha
  (implies (and (type-value-alpha-related-via-p new-elem elem ew)
                (equal (type-value-kind elem) :pi))
           (b* ((iv (type-value-pi->param elem))
                (bodyval (eval-type (type-value-pi->body elem)
                                    (type-denv-add-ispace
                                     iv ival (type-value-pi->denv elem))))
                (new-bodyval (eval-type (type-value-pi->body new-elem)
                                        (type-denv-add-ispace
