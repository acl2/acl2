        (:instance expr-value-list-alpha-related-via-p-of-take-witness
                   (ws (expr-value-list-alpha-equiv-p-witness new-vals vals)))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (expr-value-with-nonempty-dims dims new-vals))
                   (val (expr-value-with-nonempty-dims dims vals))
                   (w (expr-value-witness-with-nonempty-dims
