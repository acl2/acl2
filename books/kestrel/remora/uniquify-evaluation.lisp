; The induction: the flag function of the evaluator clique (its own flag
; function is local to the base book), and the flag theorem stating all the
; induction statements (typed on the clique's own formals for the unboxing
; members), each case being discharged by its case lemma.

(flag::make-flag eval-flag eval-expr
  :flag-mapping ((eval-expr expr)
                 (eval-expr-list exprs)
                 (eval-atom atom)
                 (eval-atom-list atoms)
                 (eval-bind bind)
                 (eval-bind-list binds)
                 (eval-tapp tapp)
                 (eval-tapp-list tapps)
                 (eval-tappn tappn)
                 (eval-iapp iapp)
                 (eval-iapp-list iapps)
                 (eval-iappn iappn)
                 (eval-app app)
                 (eval-app-list apps)
                 (eval-app-cell app-cell)
                 (eval-unbox unbox)
                 (eval-unbox-list unboxes)
                 (eval-primop-fun primop-fun)
                 (prim-reduce/fold-loop reduce/fold-loop)
                 (prim-reduce reduce)
                 (prim-fold fold)))

(defthm-eval-flag
  (defthm eval-expr-ok-holds
    (eval-expr-ok expr denv limit)
    :flag expr)
  (defthm eval-expr-list-ok-holds
    (eval-expr-list-ok exprs denv limit)
    :flag exprs)
  (defthm eval-atom-ok-holds
    (eval-atom-ok atom denv limit)
    :flag atom)
  (defthm eval-atom-list-ok-holds
    (eval-atom-list-ok atoms denv limit)
    :flag atoms)
  (defthm eval-bind-ok-holds
    (eval-bind-ok bind denv limit)
    :flag bind)
  (defthm eval-bind-list-ok-holds
    (eval-bind-list-ok binds denv limit)
    :flag binds)
  (defthm eval-tapp-ok-holds
    (eval-tapp-ok funval tval limit)
    :flag tapp)
  (defthm eval-tapp-list-ok-holds
    (eval-tapp-list-ok funvals tval limit)
    :flag tapps)
  (defthm eval-tappn-ok-holds
    (eval-tappn-ok funval args denv limit)
    :flag tappn)
  (defthm eval-iapp-ok-holds
    (eval-iapp-ok funval ival limit)
    :flag iapp)
  (defthm eval-iapp-list-ok-holds
    (eval-iapp-list-ok funvals ival limit)
    :flag iapps)
  (defthm eval-iappn-ok-holds
    (eval-iappn-ok funval args denv limit)
    :flag iappn)
  (defthm eval-app-ok-holds
    (eval-app-ok funval argvals limit)
    :flag app)
  (defthm eval-app-list-ok-holds
    (eval-app-list-ok funcells argcells limit)
    :flag apps)
  (defthm eval-app-cell-ok-holds
    (eval-app-cell-ok funcell argcell limit)
    :flag app-cell)
  (defthm eval-unbox-ok-holds
    (implies (and (ispace-var-listp ispaces)
                  (stringp var))
             (eval-unbox-ok target ispaces var body type denv limit))
    :flag unbox)
  (defthm eval-unbox-list-ok-holds
    (implies (and (ispace-var-listp ispaces)
                  (stringp var))
             (eval-unbox-list-ok targets ispaces var body type denv limit))
    :flag unboxes)
  (defthm eval-primop-fun-ok-holds
    (eval-primop-fun-ok op arg limit)
    :flag primop-fun)
  (defthm prim-reduce/fold-loop-ok-holds
    (prim-reduce/fold-loop-ok acc cells fval limit)
    :flag reduce/fold-loop)
  (defthm prim-reduce-ok-holds
    (prim-reduce-ok tval d s fval arg limit)
    :flag reduce)
  (defthm prim-fold-ok-holds
    (prim-fold-ok tval t2val d s s2 fval zval arg limit)
    :flag fold)
