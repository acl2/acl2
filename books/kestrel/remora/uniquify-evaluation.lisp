  :enable (cfun-desugared-expr)
  :use (bind-alpha-related-p-when-cfun
        bind-alpha-fresh-p-when-cfun
        (:instance expr-alpha-fresh-p-of-cfun-tlambda-expr
                   (tparams (cfun-tparams bind))
                   (new-tparams (cfun-tparams new-bind))
                   (f (set::union
                       (var+type?-list-free-type-vars (bind-cfun->params bind))
                       (set::union (type-free-type-vars (bind-cfun->type bind))
                                   (expr-free-type-vars (bind-cfun->expr bind)))))
                   (body (cfun-ilambda-expr (cfun-iparams bind)
                                            (cfun-lambda-expr (bind-cfun->params bind)
                                                              (bind-cfun->expr bind)
                                                              (bind-cfun->type bind))))
                   (new-body (cfun-ilambda-expr (cfun-iparams new-bind)
                                                (cfun-lambda-expr (bind-cfun->params new-bind)
                                                                  (bind-cfun->expr new-bind)
                                                                  (bind-cfun->type new-bind)))))
        (:instance subset-expr-free-type-vars-of-cfun-ilambda-lambda-expr
                   (iparams (cfun-iparams bind))
                   (params (bind-cfun->params bind))
                   (expr (bind-cfun->expr bind))
                   (type (bind-cfun->type bind)))
        (:instance expr-alpha-fresh-p-of-cfun-ilambda-expr
                   (r (change-var-renamings
                       r
                       :atom (mv-nth 1 (type-var-list-alpha-extend
                                        (cfun-tparams new-bind) (cfun-tparams bind)
                                        (var-renamings->atom r)
                                        (var-renamings->array r)))
                       :array (mv-nth 2 (type-var-list-alpha-extend
                                         (cfun-tparams new-bind) (cfun-tparams bind)
                                         (var-renamings->atom r)
                                         (var-renamings->array r)))))
                   (b (cfun-layer-support
                       (cfun-tparams bind)
                       (type-var-list->name (cfun-tparams new-bind))
                       (cfun-ilambda-expr (cfun-iparams bind)
                                          (cfun-lambda-expr (bind-cfun->params bind)
                                                            (bind-cfun->expr bind)
                                                            (bind-cfun->type bind)))
                       (change-var-renamings
                        r
                        :atom (mv-nth 1 (type-var-list-alpha-extend
                                         (cfun-tparams new-bind) (cfun-tparams bind)
                                         (var-renamings->atom r)
                                         (var-renamings->array r)))
                        :array (mv-nth 2 (type-var-list-alpha-extend
                                          (cfun-tparams new-bind) (cfun-tparams bind)
                                          (var-renamings->atom r)
                                          (var-renamings->array r))))
                       b))
                   (iparams (cfun-iparams bind))
                   (new-iparams (cfun-iparams new-bind))
                   (f (set::union
                       (var+type?-list-free-ispace-vars (bind-cfun->params bind))
                       (set::union (type-free-ispace-vars (bind-cfun->type bind))
                                   (expr-free-ispace-vars (bind-cfun->expr bind)))))
                   (body (cfun-lambda-expr (bind-cfun->params bind)
                                           (bind-cfun->expr bind)
                                           (bind-cfun->type bind)))
                   (new-body (cfun-lambda-expr (bind-cfun->params new-bind)
                                               (bind-cfun->expr new-bind)
                                               (bind-cfun->type new-bind))))
        (:instance subset-expr-free-ispace-vars-of-cfun-lambda-expr
                   (params (bind-cfun->params bind))
                   (expr (bind-cfun->expr bind))
                   (type (bind-cfun->type bind)))
        (:instance expr-alpha-fresh-p-of-cfun-lambda-expr
                   (r (change-var-renamings
                       r
                       :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                       (cfun-iparams new-bind) (cfun-iparams bind)
                                       (var-renamings->dim r)
                                       (var-renamings->shape r)))
                       :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                         (cfun-iparams new-bind) (cfun-iparams bind)
                                         (var-renamings->dim r)
                                         (var-renamings->shape r)))
                       :atom (mv-nth 1 (type-var-list-alpha-extend
                                        (cfun-tparams new-bind) (cfun-tparams bind)
                                        (var-renamings->atom r)
                                        (var-renamings->array r)))
                       :array (mv-nth 2 (type-var-list-alpha-extend
                                         (cfun-tparams new-bind) (cfun-tparams bind)
                                         (var-renamings->atom r)
                                         (var-renamings->array r)))))
                   (b (cfun-layer-support
                       (cfun-iparams bind)
                       (ispace-var-list->name (cfun-iparams new-bind))
                       (cfun-lambda-expr (bind-cfun->params bind)
                                         (bind-cfun->expr bind)
                                         (bind-cfun->type bind))
                       (change-var-renamings
                        r
                        :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                        (cfun-iparams new-bind) (cfun-iparams bind)
                                        (var-renamings->dim r)
                                        (var-renamings->shape r)))
                        :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                          (cfun-iparams new-bind) (cfun-iparams bind)
                                          (var-renamings->dim r)
                                          (var-renamings->shape r)))
                        :atom (mv-nth 1 (type-var-list-alpha-extend
                                         (cfun-tparams new-bind) (cfun-tparams bind)
                                         (var-renamings->atom r)
                                         (var-renamings->array r)))
                        :array (mv-nth 2 (type-var-list-alpha-extend
                                          (cfun-tparams new-bind) (cfun-tparams bind)
                                          (var-renamings->atom r)
                                          (var-renamings->array r))))
                       (cfun-layer-support
                        (cfun-tparams bind)
                        (type-var-list->name (cfun-tparams new-bind))
                        (cfun-ilambda-expr (cfun-iparams bind)
                                           (cfun-lambda-expr (bind-cfun->params bind)
                                                             (bind-cfun->expr bind)
                                                             (bind-cfun->type bind)))
                        (change-var-renamings
                         r
                         :atom (mv-nth 1 (type-var-list-alpha-extend
