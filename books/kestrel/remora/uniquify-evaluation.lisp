; Extension of the type-variable layer of the environments by one
; variable, in image form, for the atom namespace (the success direction
; is TYPE-VAR-TYPE-VALUE-MAP-COVERED-P-OF-UPDATE-ATOM-EXTEND-IMAGE above).

(defruled type-var-map-avoided-p-of-update-atom-extend-image
  (implies (and (type-var-map-avoided-p new-map map atom-renam array-renam
                                        (set::delete tv (type-var-set-fix vars)))
                (type-var-type-value-mapp new-map)
                (type-var-type-value-mapp map)
                (type-varp tv)
                (type-varp new-tv)
                (type-var-case tv :atom)
                (type-var-case new-tv :atom)
                (type-valuep new-tval)
                (type-valuep tval)
                (not (set::in new-tv
                              (type-var-set-rename-type-vars
                               (set::delete tv (type-var-set-fix vars))
                               atom-renam array-renam))))
           (type-var-map-avoided-p
            (omap::update new-tv new-tval new-map)
            (omap::update tv tval map)
            (extend-renaming (type-var-atom->name tv)
                             (type-var-atom->name new-tv)
                             atom-renam)
            array-renam
            vars))
  :expand ((:free (m1 m2 a ar) (type-var-map-avoided-p m1 m2 a ar vars)))
  :enable (rename-type-var-of-atom-extend
           omap::assoc-of-update
           type-var-equal-by-atom-name)
  :use ((:instance type-var-map-avoided-p-necc
                   (vars (set::delete tv (type-var-set-fix vars)))
                   (var (type-var-map-avoided-p-witness
                         (omap::update new-tv new-tval new-map)
                         (omap::update tv tval map)
                         (extend-renaming (type-var-atom->name tv)
                                          (type-var-atom->name new-tv)
                                          atom-renam)
                         array-renam
                         vars)))
        (:instance in-of-rename-type-var-of-type-var-set-rename-type-vars
                   (var (type-var-map-avoided-p-witness
                         (omap::update new-tv new-tval new-map)
                         (omap::update tv tval map)
                         (extend-renaming (type-var-atom->name tv)
                                          (type-var-atom->name new-tv)
                                          atom-renam)
                         array-renam
                         vars))
                   (vars (set::delete tv (type-var-set-fix vars))))))

(defruled in-atom-names-of-type-vars-when-in
  (implies (and (type-var-setp keys)
                (set::in x keys)
                (equal (type-var-kind x) :atom))
           (set::in (type-var-atom->name x)
                    (mv-nth 0 (atom/array-names-of-type-vars keys))))
  :use ((:instance type-var-fix-when-atom)))

(defruled rename-type-var-atom-collision-refuted
  (implies (and (type-varp x)
                (type-var-setp keys)
                (set::in x keys)
                (not (equal x (type-var-atom name)))
                (name-fresh-ok name new-name atom-renam b)
                (string-set-supported-p
                 (mv-nth 0 (atom/array-names-of-type-vars keys)) atom-renam b)
                (stringp name)
                (stringp new-name))
           (not (equal (rename-type-var x atom-renam array-renam)
                       (type-var-atom new-name))))
  :enable (name-fresh-ok
           rename-type-var
           rename-var-string
           equal-of-type-var-atom
           omap::assoc-of-delete
           in-when-string-set-supported-p
           in-atom-names-of-type-vars-when-in)
  :use ((:instance omap::cdr-assoc-in-values
                   (omap::key (type-var-atom->name x))
                   (omap::map (omap::delete name (string-string-map-fix atom-renam))))
        (:instance omap::in-of-keys-to-assoc
                   (omap::key (type-var-atom->name x))
                   (omap::map (string-string-map-fix atom-renam)))))

(defruled not-in-atom-image-of-keys-when-name-fresh-ok-and-supported
  (implies (and (name-fresh-ok name new-name atom-renam b)
                (string-set-supported-p
                 (mv-nth 0 (atom/array-names-of-type-vars keys)) atom-renam b)
                (type-var-setp keys)
                (stringp name)
                (stringp new-name))
           (not (set::in (type-var-atom new-name)
