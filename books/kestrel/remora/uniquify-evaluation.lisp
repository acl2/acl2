; Function binds with two or more parameters: the bound value is the value
; of the n-ary lambda atom over the parameters, the body, and the
; annotation (the mirror of the type and ispace function binds), and the
; annotation is evaluated separately.

(defruled eval-atom-of-atom-lambdan
  (implies (and (var+type?-listp params)
                (consp (cdr params))
                (exprp body)
                (type-optionp type?)
                (not (zp limit)))
           (equal (eval-atom (atom-lambdan params body type?) denv limit)
                  (b* (((ok param) (eval-var+type? (car params)
                                                   (expr-denv->tenv denv)))
                       (cbody (lambda-curried-body params body type?)))
                    (make-expr-value-lambda
                     :param param
                     :body cbody
                     :type? nil
                     :denv (expr-denv-restrict
                            (expr-free-ispace-vars cbody)
                            (expr-free-type-vars cbody)
                            (set::difference (expr-free-expr-vars body)
                                             (set::mergesort
                                              (var+type?-list->var params)))
                            denv)))))
  :enable (eval-atom-when-lambdan len)
  :expand ((atom-free-expr-vars (atom-lambdan params body type?))))

(defruled atom-alpha-related-p-of-lambdan-when-fun-n
  (implies (and (equal (bind-kind bind) :fun)
                (consp (cdr (bind-fun->params bind)))
                (bind-alpha-related-p new-bind bind r))
           (and (equal (bind-kind new-bind) :fun)
                (consp (bind-fun->params new-bind))
                (consp (cdr (bind-fun->params new-bind)))
                (equal (bind-fun->type? new-bind)
                       (type-option-rename-all-vars (bind-fun->type? bind) r))
                (atom-alpha-related-p
                 (atom-lambdan (bind-fun->params new-bind)
                               (bind-fun->expr new-bind)
                               (bind-fun->type? new-bind))
                 (atom-lambdan (bind-fun->params bind)
                               (bind-fun->expr bind)
                               (bind-fun->type? bind))
                 r)))
  :expand ((bind-alpha-related-p new-bind bind r)
           (:free (a x) (atom-alpha-related-p a x r)))
  :enable (consp-of-cdr-when-len-equal consp-when-len-equal len))

