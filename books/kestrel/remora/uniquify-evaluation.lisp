;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Combined function binds.  The evaluator desugars the bind into nested
; type, ispace, and term abstractions (see CFUN-LAMBDA-EXPR and company in
; the relations book) and evaluates the result like a value bind, after
; checking the annotation (the function type assembled from the parameter
; types and the result type, universally quantified over the type and
; ispace parameters).  The relations of the bind yield the relations of the
; desugared expressions, layer by layer, so the induction hypothesis at the
; desugared expression gives the value relation; the assembled types are
; closures when there are type or ispace parameters (so their evaluation
; never fails), and otherwise function types whose evaluation is related
; by EVAL-TYPE-ALPHA.

(define cfun-tparams ((bind bindp))
  :guard (bind-case bind :cfun)
  :returns (tparams type-var-listp)
  (b* (((bind-cfun b) bind))
    (type-var-list-option-case b.tparams? :some b.tparams?.val :none nil)))

(define cfun-iparams ((bind bindp))
  :guard (bind-case bind :cfun)
  :returns (iparams ispace-var-listp)
  (b* (((bind-cfun b) bind))
    (ispace-var-list-option-case b.iparams? :some b.iparams?.val :none nil)))

(define cfun-desugared-expr ((bind bindp))
  :guard (bind-case bind :cfun)
  :returns (expr exprp)
  (b* (((bind-cfun b) bind))
    (cfun-tlambda-expr (cfun-tparams bind)
                       (cfun-ilambda-expr (cfun-iparams bind)
                                          (cfun-lambda-expr b.params b.expr b.type)))))

(define cfun-fun-type ((in type-listp) (out typep))
  :returns (type typep)
  (cond ((endp in) (type-fix out))
        ((endp (cdr in)) (make-type-fun :in (car in) :out out))
        (t (make-type-funn :in in :out out))))

(define cfun-desugared-type ((bind bindp))
  :guard (bind-case bind :cfun)
  :returns (type type-resultp)
  (b* (((bind-cfun b) bind)
       ((ok in) (var+type?-list->type-list-or-err b.params))
       (cfun-type (cfun-fun-type in b.type))
       (iparams (cfun-iparams bind))
       (cfun-type (if (consp iparams)
                      (make-type-pi/pin iparams cfun-type)
                    cfun-type))
       (tparams (cfun-tparams bind))
       (cfun-type (if (consp tparams)
                      (make-type-forall/foralln tparams cfun-type)
                    cfun-type)))
    cfun-type)
  :verify-guards nil)

(defruled eval-bind-when-cfun
  (implies (and (equal (bind-kind bind) :cfun)
                (not (zp limit)))
           (equal (eval-bind bind denv limit)
                  (b* (((ok cfun-type) (cfun-desugared-type bind))
                       ((ok val) (eval-expr (cfun-desugared-expr bind)
                                            denv (1- limit)))
                       ((ok &) (eval-type cfun-type (expr-denv->tenv denv))))
                    (expr-denv-add-expr (bind-cfun->var bind) val denv))))
  :expand ((eval-bind bind denv limit))
  :enable (cfun-desugared-type
           cfun-desugared-expr
           cfun-fun-type
           not-reserrp-when-typep
           cfun-tparams
           cfun-iparams
           cfun-tlambda-expr
           cfun-ilambda-expr
           cfun-lambda-expr))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Alpha-extensions over empty parameter lists (not necessarily NIL) are the
; identity, as for the NIL case.

(defruled type-var-list-alpha-extend-when-not-consp
  (implies (and (not (consp new-vars))
                (not (consp vars)))
           (and (mv-nth 0 (type-var-list-alpha-extend new-vars vars atom-m array-m))
                (equal (mv-nth 1 (type-var-list-alpha-extend new-vars vars atom-m array-m))
                       (string-string-map-fix atom-m))
                (equal (mv-nth 2 (type-var-list-alpha-extend new-vars vars atom-m array-m))
                       (string-string-map-fix array-m))))
  :enable type-var-list-alpha-extend)

(defruled ispace-var-list-alpha-extend-when-not-consp
  (implies (and (not (consp new-vars))
                (not (consp vars)))
           (and (mv-nth 0 (ispace-var-list-alpha-extend new-vars vars dim-m shape-m))
                (equal (mv-nth 1 (ispace-var-list-alpha-extend new-vars vars dim-m shape-m))
                       (string-string-map-fix dim-m))
                (equal (mv-nth 2 (ispace-var-list-alpha-extend new-vars vars dim-m shape-m))
                       (string-string-map-fix shape-m))))
  :enable ispace-var-list-alpha-extend)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Relatedness of the desugared layers from the bind's relation.

(defruled expr-alpha-related-p-of-cfun-tlambda-expr
  (implies (and (type-var-listp tparams)
                (type-var-listp new-tparams)
                (mv-nth 0 (type-var-list-alpha-extend new-tparams tparams
                                                      (var-renamings->atom r)
                                                      (var-renamings->array r)))
                (expr-alpha-related-p
                 new-body body
                 (change-var-renamings
                  r
                  :atom (mv-nth 1 (type-var-list-alpha-extend
                                   new-tparams tparams
                                   (var-renamings->atom r)
                                   (var-renamings->array r)))
                  :array (mv-nth 2 (type-var-list-alpha-extend
                                    new-tparams tparams
                                    (var-renamings->atom r)
                                    (var-renamings->array r))))))
           (expr-alpha-related-p (cfun-tlambda-expr new-tparams new-body)
                                 (cfun-tlambda-expr tparams body)
                                 r))
  :expand ((:free (d a1 a2) (expr-alpha-related-p (expr-array d a1) (expr-array d a2) r))
           (:free (a1 l1 a2 l2) (atom-list-alpha-related-p (cons a1 l1) (cons a2 l2) r))
           (atom-list-alpha-related-p nil nil r)
           (:free (a1 ps b) (atom-alpha-related-p a1 (atom-tlambdan ps b) r))
           (:free (a1 p b) (atom-alpha-related-p a1 (atom-tlambda p b) r)))
  :enable (cfun-tlambda-expr
           make-atom-tlambda/tlambdan
           type-var-list-alpha-extend-of-nil
           list-of-car-when-len-1
           len)
  :use ((:instance len-when-type-var-list-alpha-extend-okp
                   (new-params new-tparams) (params tparams)
                   (atom-m (var-renamings->atom r))
                   (array-m (var-renamings->array r)))
        (:instance consp-when-len-equal (a new-tparams) (b tparams))
        (:instance consp-of-cdr-when-len-equal (a new-tparams) (b tparams))))

(defruled expr-alpha-related-p-of-cfun-ilambda-expr
  (implies (and (ispace-var-listp iparams)
                (ispace-var-listp new-iparams)
                (mv-nth 0 (ispace-var-list-alpha-extend new-iparams iparams
                                                        (var-renamings->dim r)
                                                        (var-renamings->shape r)))
                (expr-alpha-related-p
                 new-body body
                 (change-var-renamings
                  r
                  :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                  new-iparams iparams
                                  (var-renamings->dim r)
                                  (var-renamings->shape r)))
                  :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                    new-iparams iparams
                                    (var-renamings->dim r)
                                    (var-renamings->shape r))))))
           (expr-alpha-related-p (cfun-ilambda-expr new-iparams new-body)
                                 (cfun-ilambda-expr iparams body)
                                 r))
  :expand ((:free (d a1 a2) (expr-alpha-related-p (expr-array d a1) (expr-array d a2) r))
           (:free (a1 l1 a2 l2) (atom-list-alpha-related-p (cons a1 l1) (cons a2 l2) r))
           (atom-list-alpha-related-p nil nil r)
           (:free (a1 ps b) (atom-alpha-related-p a1 (atom-ilambdan ps b) r))
           (:free (a1 p b) (atom-alpha-related-p a1 (atom-ilambda p b) r)))
  :enable (cfun-ilambda-expr
           make-atom-ilambda/ilambdan
           ispace-var-list-alpha-extend-of-nil
           list-of-car-when-len-1
           len)
  :use ((:instance len-when-ispace-var-list-alpha-extend-okp
                   (new-params new-iparams) (params iparams)
                   (dim-m (var-renamings->dim r))
                   (shape-m (var-renamings->shape r)))
        (:instance consp-when-len-equal (a new-iparams) (b iparams))
        (:instance consp-of-cdr-when-len-equal (a new-iparams) (b iparams))))

(defruled expr-alpha-related-p-of-cfun-lambda-expr
  (implies (and (var+type?-listp params)
                (var+type?-listp new-params)
                (typep type)
                (equal (len new-params) (len params))
                (equal new-params
                       (var+type?-list-set-vars
                        (var+type?-list->var new-params)
                        (var+type?-list-rename-all-vars params r)))
                (equal new-type (type-rename-all-vars type r))
                (expr-alpha-related-p
                 new-body body
                 (change-var-renamings
                  r :expr (extend-renaming-list
                           (var+type?-list->var params)
                           (var+type?-list->var new-params)
                           (var-renamings->expr r)))))
           (expr-alpha-related-p (cfun-lambda-expr new-params new-body new-type)
                                 (cfun-lambda-expr params body type)
                                 r))
  :expand ((:free (d a1 a2) (expr-alpha-related-p (expr-array d a1) (expr-array d a2) r))
           (:free (a1 l1 a2 l2) (atom-list-alpha-related-p (cons a1 l1) (cons a2 l2) r))
           (atom-list-alpha-related-p nil nil r)
           (:free (a1 ps b t?) (atom-alpha-related-p a1 (atom-lambdan ps b t?) r))
           (:free (a1 p b t?) (atom-alpha-related-p a1 (atom-lambda p b t?) r))
           (var+type?-list->var params)
           (var+type?-list->var new-params)
           (var+type?-list->var (cdr params))
           (var+type?-list->var (cdr new-params)))
  :enable (cfun-lambda-expr
           make-atom-lambda/lambdan
           extend-renaming-list
           type-option-rename-all-vars-when-typep
           len)
  :use ((:instance consp-when-len-equal (a new-params) (b params))
        (:instance consp-of-cdr-when-len-equal (a new-params) (b params))
        (:instance var+type?->type?-of-car-when-set-vars-of-rename
                   (ps new-params) (qs params))))

(defruled bind-alpha-related-p-when-cfun
  (implies (and (equal (bind-kind bind) :cfun)
                (bind-alpha-related-p new-bind bind r))
           (b* ((tparams (cfun-tparams bind))
                (new-tparams (cfun-tparams new-bind))
                (iparams (cfun-iparams bind))
                (new-iparams (cfun-iparams new-bind))
                ((mv okp1 atom-renam array-renam)
                 (type-var-list-alpha-extend new-tparams tparams
                                             (var-renamings->atom r)
                                             (var-renamings->array r)))
                ((mv okp2 dim-renam shape-renam)
                 (ispace-var-list-alpha-extend new-iparams iparams
                                               (var-renamings->dim r)
                                               (var-renamings->shape r)))
                (inner-r (change-var-renamings r
                                               :dim dim-renam
                                               :shape shape-renam
                                               :atom atom-renam
                                               :array array-renam)))
             (and (equal (bind-kind new-bind) :cfun)
                  (equal (type-var-list-option-case (bind-cfun->tparams? new-bind) :some)
                         (type-var-list-option-case (bind-cfun->tparams? bind) :some))
                  (equal (ispace-var-list-option-case (bind-cfun->iparams? new-bind) :some)
                         (ispace-var-list-option-case (bind-cfun->iparams? bind) :some))
                  (iff (consp new-tparams) (consp tparams))
                  (iff (consp new-iparams) (consp iparams))
                  okp1
                  okp2
                  (equal (len (bind-cfun->params new-bind))
                         (len (bind-cfun->params bind)))
                  (equal (bind-cfun->params new-bind)
                         (var+type?-list-set-vars
                          (var+type?-list->var (bind-cfun->params new-bind))
                          (var+type?-list-rename-all-vars (bind-cfun->params bind)
                                                          inner-r)))
                  (equal (bind-cfun->type new-bind)
                         (type-rename-all-vars (bind-cfun->type bind) inner-r))
                  (expr-alpha-related-p
                   (bind-cfun->expr new-bind)
                   (bind-cfun->expr bind)
                   (change-var-renamings
                    inner-r
                    :expr (extend-renaming-list
                           (var+type?-list->var (bind-cfun->params bind))
                           (var+type?-list->var (bind-cfun->params new-bind))
                           (var-renamings->expr r)))))))
  :expand ((bind-alpha-related-p new-bind bind r))
  :enable (cfun-tparams cfun-iparams)
  :use ((:instance consp-when-len-equal
                   (a (cfun-tparams new-bind)) (b (cfun-tparams bind)))
        (:instance consp-when-len-equal
                   (a (cfun-iparams new-bind)) (b (cfun-iparams bind)))
        (:instance len-when-type-var-list-alpha-extend-okp
                   (new-params (cfun-tparams new-bind)) (params (cfun-tparams bind))
                   (atom-m (var-renamings->atom r))
                   (array-m (var-renamings->array r)))
        (:instance len-when-ispace-var-list-alpha-extend-okp
                   (new-params (cfun-iparams new-bind)) (params (cfun-iparams bind))
                   (dim-m (var-renamings->dim r))
                   (shape-m (var-renamings->shape r)))))

(defruled expr-alpha-related-p-of-cfun-desugared-expr
  (implies (and (equal (bind-kind bind) :cfun)
                (bind-alpha-related-p new-bind bind r))
           (expr-alpha-related-p (cfun-desugared-expr new-bind)
                                 (cfun-desugared-expr bind)
                                 r))
  :enable (cfun-desugared-expr)
  :use (bind-alpha-related-p-when-cfun
        (:instance expr-alpha-related-p-of-cfun-tlambda-expr
                   (tparams (cfun-tparams bind))
                   (new-tparams (cfun-tparams new-bind))
                   (body (cfun-ilambda-expr (cfun-iparams bind)
                                            (cfun-lambda-expr (bind-cfun->params bind)
                                                              (bind-cfun->expr bind)
                                                              (bind-cfun->type bind))))
                   (new-body (cfun-ilambda-expr (cfun-iparams new-bind)
                                                (cfun-lambda-expr (bind-cfun->params new-bind)
                                                                  (bind-cfun->expr new-bind)
                                                                  (bind-cfun->type new-bind)))))
        (:instance expr-alpha-related-p-of-cfun-ilambda-expr
                   (r (change-var-renamings
                       r
                       :atom (mv-nth 1 (type-var-list-alpha-extend
                                        (cfun-tparams new-bind) (cfun-tparams bind)
                                        (var-renamings->atom r)
                                        (var-renamings->array r)))
                       :array (mv-nth 2 (type-var-list-alpha-extend
                                         (cfun-tparams new-bind) (cfun-tparams bind)
                                         (var-renamings->atom r)
                                         (var-renamings->array r)))))
                   (iparams (cfun-iparams bind))
                   (new-iparams (cfun-iparams new-bind))
                   (body (cfun-lambda-expr (bind-cfun->params bind)
                                           (bind-cfun->expr bind)
                                           (bind-cfun->type bind)))
                   (new-body (cfun-lambda-expr (bind-cfun->params new-bind)
                                               (bind-cfun->expr new-bind)
                                               (bind-cfun->type new-bind))))
        (:instance expr-alpha-related-p-of-cfun-lambda-expr
                   (r (change-var-renamings
                       r
                       :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                       (cfun-iparams new-bind) (cfun-iparams bind)
                                       (var-renamings->dim r)
                                       (var-renamings->shape r)))
                       :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                         (cfun-iparams new-bind) (cfun-iparams bind)
                                         (var-renamings->dim r)
                                         (var-renamings->shape r)))
                       :atom (mv-nth 1 (type-var-list-alpha-extend
                                        (cfun-tparams new-bind) (cfun-tparams bind)
                                        (var-renamings->atom r)
                                        (var-renamings->array r)))
                       :array (mv-nth 2 (type-var-list-alpha-extend
                                         (cfun-tparams new-bind) (cfun-tparams bind)
                                         (var-renamings->atom r)
                                         (var-renamings->array r)))))
                   (params (bind-cfun->params bind))
                   (new-params (bind-cfun->params new-bind))
                   (type (bind-cfun->type bind))
                   (new-type (bind-cfun->type new-bind))
                   (body (bind-cfun->expr bind))
                   (new-body (bind-cfun->expr new-bind)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The free variables of the desugared expression are within those of the
; bind.

(defruled subset-expr-free-ispace-vars-of-cfun-desugared-expr
  (implies (equal (bind-kind bind) :cfun)
           (set::subset (expr-free-ispace-vars (cfun-desugared-expr bind))
                        (bind-free-ispace-vars bind)))
  :expand ((bind-free-ispace-vars bind))
  :enable (cfun-desugared-expr
           cfun-tparams
           cfun-iparams
           expr-free-ispace-vars-of-cfun-tlambda-expr
           expr-free-ispace-vars-of-cfun-ilambda-expr
           expr-free-ispace-vars-of-cfun-lambda-expr
           set::pick-a-point-subset-strategy
           set::union-in
           set::difference-in))

(defruled subset-expr-free-type-vars-of-cfun-desugared-expr
  (implies (equal (bind-kind bind) :cfun)
           (set::subset (expr-free-type-vars (cfun-desugared-expr bind))
                        (bind-free-type-vars bind)))
  :expand ((bind-free-type-vars bind))
  :enable (cfun-desugared-expr
           cfun-tparams
           cfun-iparams
           expr-free-type-vars-of-cfun-tlambda-expr
           expr-free-type-vars-of-cfun-ilambda-expr
           expr-free-type-vars-of-cfun-lambda-expr
           set::pick-a-point-subset-strategy
           set::union-in
           set::difference-in))

(defruled subset-expr-free-expr-vars-of-cfun-desugared-expr
  (implies (equal (bind-kind bind) :cfun)
           (set::subset (expr-free-expr-vars (cfun-desugared-expr bind))
                        (bind-free-expr-vars bind)))
  :expand ((bind-free-expr-vars bind))
  :enable (cfun-desugared-expr
           cfun-tparams
           cfun-iparams
           expr-free-expr-vars-of-cfun-tlambda-expr
           expr-free-expr-vars-of-cfun-ilambda-expr
           expr-free-expr-vars-of-cfun-lambda-expr))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Freshness of the desugared layers from the bind's freshness: each layer's
; conditions are those of the corresponding abstraction atom, with the
; no-capture conditions weakened from the bind's (flat) free-variable sets
; to the layer body's, and the support set of each layer's body being the
; one the bind passes down (CFUN-LAYER-SUPPORT).

(defruled expr-alpha-fresh-p-of-cfun-tlambda-expr
  (implies (and (type-var-listp tparams)
                (type-var-listp new-tparams)
                (type-var-setp f)
                (set::subset (expr-free-type-vars body) f)
                (mv-nth 0 (type-var-list-alpha-extend new-tparams tparams
                                                      (var-renamings->atom r)
                                                      (var-renamings->array r)))
                (type-var-list-fresh-ok new-tparams tparams
                                        (var-renamings->atom r)
                                        (var-renamings->array r)
                                        b)
                (no-duplicatesp-equal new-tparams)
                (set::emptyp
                 (set::intersect
                  (set::mergesort new-tparams)
                  (type-var-set-rename-type-vars
                   (set::difference f (set::mergesort tparams))
                   (var-renamings->atom r)
                   (var-renamings->array r))))
                (expr-alpha-fresh-p
                 new-body body
                 (change-var-renamings
                  r
                  :atom (mv-nth 1 (type-var-list-alpha-extend
                                   new-tparams tparams
                                   (var-renamings->atom r)
                                   (var-renamings->array r)))
                  :array (mv-nth 2 (type-var-list-alpha-extend
                                    new-tparams tparams
                                    (var-renamings->atom r)
                                    (var-renamings->array r))))
                 (cfun-layer-support
                  tparams
                  (type-var-list->name new-tparams)
                  body
                  (change-var-renamings
                   r
                   :atom (mv-nth 1 (type-var-list-alpha-extend
                                    new-tparams tparams
                                    (var-renamings->atom r)
                                    (var-renamings->array r)))
                   :array (mv-nth 2 (type-var-list-alpha-extend
                                     new-tparams tparams
                                     (var-renamings->atom r)
                                     (var-renamings->array r))))
                  b)))
           (expr-alpha-fresh-p (cfun-tlambda-expr new-tparams new-body)
                               (cfun-tlambda-expr tparams body)
                               r b))
  :expand ((:free (d a1 a2) (expr-alpha-fresh-p (expr-array d a1) (expr-array d a2) r b))
           (:free (a1 l1 a2 l2) (atom-list-alpha-fresh-p (cons a1 l1) (cons a2 l2) r b))
           (atom-list-alpha-fresh-p nil nil r b)
           (:free (a1 ps bd) (atom-alpha-fresh-p a1 (atom-tlambdan ps bd) r b))
           (:free (a1 p bd) (atom-alpha-fresh-p a1 (atom-tlambda p bd) r b)))
  :enable (cfun-tlambda-expr
           cfun-layer-support
           make-atom-tlambda/tlambdan
           type-var-list-alpha-extend-of-nil
           list-of-car-when-len-1
           mergesort-of-cons
           set::difference-insert-y
           difference-of-nil-right
           emptyp-intersect-singleton
           type-var->name
           len)
  :use ((:instance len-when-type-var-list-alpha-extend-okp
                   (new-params new-tparams) (params tparams)
                   (atom-m (var-renamings->atom r))
                   (array-m (var-renamings->array r)))
        (:instance consp-when-len-equal (a new-tparams) (b tparams))
        (:instance consp-of-cdr-when-len-equal (a new-tparams) (b tparams))
        (:instance emptyp-intersect-of-type-var-image-when-subset
                   (s (set::mergesort new-tparams))
                   (a (set::difference (expr-free-type-vars body)
                                       (set::mergesort tparams)))
                   (b (set::difference f (set::mergesort tparams)))
                   (atom-m (var-renamings->atom r))
                   (array-m (var-renamings->array r)))
        (:instance not-in-type-var-image-when-subset
                   (elt (car new-tparams))
                   (a (set::delete (car tparams) (expr-free-type-vars body)))
                   (b (set::delete (car tparams) f))
                   (atom-m (var-renamings->atom r))
                   (array-m (var-renamings->array r)))
        (:instance subset-of-delete-when-subset
                   (n (car tparams))
                   (s (expr-free-type-vars body))
                   (f f))))

(defruled expr-alpha-fresh-p-of-cfun-ilambda-expr
  (implies (and (ispace-var-listp iparams)
                (ispace-var-listp new-iparams)
                (ispace-var-setp f)
                (set::subset (expr-free-ispace-vars body) f)
                (mv-nth 0 (ispace-var-list-alpha-extend new-iparams iparams
                                                        (var-renamings->dim r)
                                                        (var-renamings->shape r)))
                (ispace-var-list-fresh-ok new-iparams iparams
                                          (var-renamings->dim r)
                                          (var-renamings->shape r)
                                          b)
                (no-duplicatesp-equal new-iparams)
                (set::emptyp
                 (set::intersect
                  (set::mergesort new-iparams)
                  (ispace-var-set-rename-ispace-vars
                   (set::difference f (set::mergesort iparams))
                   (var-renamings->dim r)
                   (var-renamings->shape r))))
                (expr-alpha-fresh-p
                 new-body body
                 (change-var-renamings
                  r
                  :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                  new-iparams iparams
                                  (var-renamings->dim r)
                                  (var-renamings->shape r)))
                  :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                    new-iparams iparams
                                    (var-renamings->dim r)
                                    (var-renamings->shape r))))
                 (cfun-layer-support
                  iparams
                  (ispace-var-list->name new-iparams)
                  body
                  (change-var-renamings
                   r
                   :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                   new-iparams iparams
                                   (var-renamings->dim r)
                                   (var-renamings->shape r)))
                   :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                     new-iparams iparams
                                     (var-renamings->dim r)
                                     (var-renamings->shape r))))
                  b)))
           (expr-alpha-fresh-p (cfun-ilambda-expr new-iparams new-body)
                               (cfun-ilambda-expr iparams body)
                               r b))
  :expand ((:free (d a1 a2) (expr-alpha-fresh-p (expr-array d a1) (expr-array d a2) r b))
           (:free (a1 l1 a2 l2) (atom-list-alpha-fresh-p (cons a1 l1) (cons a2 l2) r b))
           (atom-list-alpha-fresh-p nil nil r b)
           (:free (a1 ps bd) (atom-alpha-fresh-p a1 (atom-ilambdan ps bd) r b))
           (:free (a1 p bd) (atom-alpha-fresh-p a1 (atom-ilambda p bd) r b)))
  :enable (cfun-ilambda-expr
           cfun-layer-support
           make-atom-ilambda/ilambdan
           ispace-var-list-alpha-extend-of-nil
           list-of-car-when-len-1
           mergesort-of-cons
           set::difference-insert-y
           difference-of-nil-right
           emptyp-intersect-singleton
           ispace-var->name
           len)
  :use ((:instance len-when-ispace-var-list-alpha-extend-okp
                   (new-params new-iparams) (params iparams)
                   (dim-m (var-renamings->dim r))
                   (shape-m (var-renamings->shape r)))
        (:instance consp-when-len-equal (a new-iparams) (b iparams))
        (:instance consp-of-cdr-when-len-equal (a new-iparams) (b iparams))
        (:instance emptyp-intersect-of-ispace-var-image-when-subset
                   (s (set::mergesort new-iparams))
                   (a (set::difference (expr-free-ispace-vars body)
                                       (set::mergesort iparams)))
                   (b (set::difference f (set::mergesort iparams)))
                   (dim-m (var-renamings->dim r))
                   (shape-m (var-renamings->shape r)))
        (:instance not-in-ispace-var-image-when-subset
                   (elt (car new-iparams))
                   (a (set::delete (car iparams) (expr-free-ispace-vars body)))
                   (b (set::delete (car iparams) f))
                   (dim-m (var-renamings->dim r))
                   (shape-m (var-renamings->shape r)))
        (:instance subset-of-delete-when-subset
                   (n (car iparams))
                   (s (expr-free-ispace-vars body))
                   (f f))))

(defruled expr-alpha-fresh-p-of-cfun-lambda-expr
  (implies (and (var+type?-listp params)
                (var+type?-listp new-params)
                (typep type)
                (equal (len new-params) (len params))
                (var+type?-list-types-fresh-ok params r)
                (type-fresh-ok type r)
                (string-list-fresh-ok (var+type?-list->var params)
                                      (var+type?-list->var new-params)
                                      (var-renamings->expr r)
                                      b)
                (no-duplicatesp-equal (var+type?-list->var new-params))
                (set::emptyp
                 (set::intersect
                  (set::mergesort (var+type?-list->var new-params))
                  (rename-var-string-set
                   (set::difference (expr-free-expr-vars body)
                                    (set::mergesort (var+type?-list->var params)))
                   (var-renamings->expr r))))
                (expr-alpha-fresh-p
                 new-body body
                 (change-var-renamings
                  r :expr (extend-renaming-list
                           (var+type?-list->var params)
                           (var+type?-list->var new-params)
                           (var-renamings->expr r)))
                 (cfun-layer-support
                  params
                  (var+type?-list->var new-params)
                  body
                  (change-var-renamings
                   r :expr (extend-renaming-list
                            (var+type?-list->var params)
                            (var+type?-list->var new-params)
                            (var-renamings->expr r)))
                  b)))
           (expr-alpha-fresh-p (cfun-lambda-expr new-params new-body new-type)
                               (cfun-lambda-expr params body type)
                               r b))
  :expand ((:free (d a1 a2) (expr-alpha-fresh-p (expr-array d a1) (expr-array d a2) r b))
           (:free (a1 l1 a2 l2) (atom-list-alpha-fresh-p (cons a1 l1) (cons a2 l2) r b))
           (atom-list-alpha-fresh-p nil nil r b)
           (:free (a1 ps bd t?) (atom-alpha-fresh-p a1 (atom-lambdan ps bd t?) r b))
           (:free (a1 p bd t?) (atom-alpha-fresh-p a1 (atom-lambda p bd t?) r b))
           (var+type?-list->var params)
           (var+type?-list->var new-params)
           (var+type?-list->var (cdr params))
           (var+type?-list->var (cdr new-params))
           (var+type?-list-types-fresh-ok params r))
  :enable (cfun-lambda-expr
           cfun-layer-support
           make-atom-lambda/lambdan
           extend-renaming-list
           string-list-fresh-ok
           type-option-fresh-ok
           type-option-some->val-when-typep
           mergesort-of-cons
           set::difference-insert-y
           difference-of-nil-right
           emptyp-intersect-singleton
           len)
  :use ((:instance consp-when-len-equal (a new-params) (b params))
        (:instance consp-of-cdr-when-len-equal (a new-params) (b params)))
  :disable (no-duplicatesp-equal-when-no-duplicatesp-equal-of-type-var-list->name
            no-duplicatesp-equal-when-no-duplicatesp-equal-of-ispace-var-list->name
            no-duplicatesp-equal-when-not-duplicated-names
            duplicated-names-when-no-duplicatesp-equal
            member-equal-of-type-var-list->name-when-member-equal
            member-equal-of-ispace-var-list->name-when-member-equal
            member-of-type-var->name-in-type-var-list->name
            member-of-ispace-var->name-in-ispace-var-list->name
            member-equal))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The annotation of a combined function bind: the parameter types of the
; renamed parameters are the renamed parameter types (and are absent
; together), the assembled function type of the renamed pieces is the
; renaming of the assembled function type, and its freshness and free
; variables are those of the pieces.

(defruled type-listp-of-var+type?-list->type-list-or-err
  (implies (not (reserrp (var+type?-list->type-list-or-err params)))
           (type-listp (var+type?-list->type-list-or-err params)))
  :induct t
  :enable (var+type?-list->type-list-or-err
           var+type?->type-or-err
           typep-when-type-optionp
           not-reserrp-when-typep
           not-reserrp-when-type-listp))

(defruled var+type?-list->type-list-or-err-of-set-vars-of-rename-all-vars
  (implies (equal (len names) (len params))
           (equal (var+type?-list->type-list-or-err
                   (var+type?-list-set-vars
                    names (var+type?-list-rename-all-vars params r)))
                  (b* ((in (var+type?-list->type-list-or-err params)))
                    (if (reserrp in)
                        in
                      (type-list-rename-all-vars in r)))))
  :induct (var+type?-list-set-vars names params)
  :enable (var+type?-list->type-list-or-err
           var+type?->type-or-err
           var+type?-list-set-vars
           var+type?-list-rename-all-vars
           var+type?-list-rename-ispace-vars
           var+type?-list-rename-type-vars
           var+type?-rename-ispace-vars
           var+type?-rename-type-vars
           type-list-rename-all-vars
           type-list-rename-ispace-vars
           type-list-rename-type-vars
           type-option-rename-all-vars
           type-option-rename-ispace-vars
           type-option-rename-type-vars
           type-rename-all-vars
           type-option-some->val-when-typep
           not-reserrp-of-var+type?->type?
           not-reserrp-when-typep
           not-reserrp-when-type-listp
           type-listp-of-var+type?-list->type-list-or-err
           typep-when-type-optionp
           len))

; The parameter types of the renamed bind, from the bind's relation.

(defruled type-list-or-err-of-cfun-new-params
  (implies (and (equal (bind-kind bind) :cfun)
                (bind-alpha-related-p new-bind bind r))
           (equal (var+type?-list->type-list-or-err (bind-cfun->params new-bind))
                  (b* ((in (var+type?-list->type-list-or-err
                            (bind-cfun->params bind))))
                    (if (reserrp in)
                        in
                      (type-list-rename-all-vars
                       in
                       (change-var-renamings
                       r
                       :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                       (cfun-iparams new-bind) (cfun-iparams bind)
                                       (var-renamings->dim r)
                                       (var-renamings->shape r)))
                       :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                         (cfun-iparams new-bind) (cfun-iparams bind)
                                         (var-renamings->dim r)
                                         (var-renamings->shape r)))
                       :atom (mv-nth 1 (type-var-list-alpha-extend
                                        (cfun-tparams new-bind) (cfun-tparams bind)
                                        (var-renamings->atom r)
                                        (var-renamings->array r)))
                       :array (mv-nth 2 (type-var-list-alpha-extend
                                         (cfun-tparams new-bind) (cfun-tparams bind)
                                         (var-renamings->atom r)
                                         (var-renamings->array r)))))))))
  :use (bind-alpha-related-p-when-cfun
        (:instance var+type?-list->type-list-or-err-of-set-vars-of-rename-all-vars
                   (names (var+type?-list->var (bind-cfun->params new-bind)))
                   (params (bind-cfun->params bind))
                   (r (change-var-renamings
                       r
                       :dim (mv-nth 1 (ispace-var-list-alpha-extend
                                       (cfun-iparams new-bind) (cfun-iparams bind)
                                       (var-renamings->dim r)
                                       (var-renamings->shape r)))
                       :shape (mv-nth 2 (ispace-var-list-alpha-extend
                                         (cfun-iparams new-bind) (cfun-iparams bind)
                                         (var-renamings->dim r)
                                         (var-renamings->shape r)))
                       :atom (mv-nth 1 (type-var-list-alpha-extend
                                        (cfun-tparams new-bind) (cfun-tparams bind)
                                        (var-renamings->atom r)
                                        (var-renamings->array r)))
                       :array (mv-nth 2 (type-var-list-alpha-extend
                                         (cfun-tparams new-bind) (cfun-tparams bind)
                                         (var-renamings->atom r)
                                         (var-renamings->array r))))))))

(defruled type-list-rename-all-vars-of-cons
  (equal (type-list-rename-all-vars (cons a l) r)
         (cons (type-rename-all-vars a r)
               (type-list-rename-all-vars l r)))
  :enable (type-list-rename-all-vars
           type-rename-all-vars
           type-list-rename-ispace-vars
           type-list-rename-type-vars))

(defruled type-list-rename-all-vars-when-not-consp
