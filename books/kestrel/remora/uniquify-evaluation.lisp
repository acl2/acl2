(defruled eval-value-bind-alpha-supported
  (implies (and (stringp var)
                (stringp new-var)
                (expr-denv-keys-supported-p denv r b))
           (b* ((new-r (change-var-renamings
                        r :expr (extend-renaming var new-var
                                                 (var-renamings->expr r))))
                (result (eval-value-bind var expr type? denv limit)))
             (implies (not (reserrp result))
                      (expr-denv-keys-supported-p
                       result new-r
                       (set::insert new-var (string-sfix b))))))
  :enable (eval-value-bind
           expr-denv-keys-supported-p-of-add-expr
           not-reserrp-when-expr-denvp))

(defruled eval-value-bind-alpha-avoided
  (implies (and (not (zp limit))
                (stringp var)
                (stringp new-var)
                (eval-expr-ok expr denv (1- limit))
                (expr-alpha-related-p new-expr expr r)
                (expr-alpha-fresh-p new-expr expr r b)
                (equal new-type? (type-option-rename-all-vars type? r))
                (type-option-fresh-ok type? r)
                (name-fresh-ok var new-var (var-renamings->expr r) b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p
                 new-denv denv r
                 (set::union (type-option-free-ispace-vars type?)
                             (expr-free-ispace-vars expr))
                 (set::union (type-option-free-type-vars type?)
                             (expr-free-type-vars expr))
                 (expr-free-expr-vars expr))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (change-var-renamings
                        r :expr (extend-renaming var new-var
                                                 (var-renamings->expr r))))
                (result (eval-value-bind var expr type? denv limit))
                (new-result (eval-value-bind new-var new-expr new-type?
                                             new-denv limit)))
             (implies (and (not (reserrp result))
                           (expr-denv-alpha-avoided-p
                            new-denv denv r
                            ivars tvars
                            (set::delete var (string-sfix evars)))
                           (not (set::in new-var
                                         (rename-var-string-set
                                          (set::delete var (string-sfix evars))
                                          (var-renamings->expr r)))))
                      (expr-denv-alpha-avoided-p new-result result new-r
                                                 ivars tvars evars))))
  :enable (eval-value-bind
           not-reserrp-when-expr-valuep
           expr-valuep-when-result-not-error
           not-reserrp-when-expr-denvp)
  :use ((:instance eval-value-bind-alpha-equiv)
        (:instance expr-denv-alpha-avoided-p-of-add-expr
                   (name var)
                   (new-name new-var)
                   (new-val (eval-expr new-expr new-denv (1- limit)))
                   (val (eval-expr expr denv (1- limit))))))

(defruled eval-value-bind-alpha
  (implies (and (not (zp limit))
                (stringp var)
                (stringp new-var)
                (eval-expr-ok expr denv (1- limit))
                (expr-alpha-related-p new-expr expr r)
                (expr-alpha-fresh-p new-expr expr r b)
                (equal new-type? (type-option-rename-all-vars type? r))
                (type-option-fresh-ok type? r)
                (name-fresh-ok var new-var (var-renamings->expr r) b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p
                 new-denv denv r
                 (set::union (type-option-free-ispace-vars type?)
                             (expr-free-ispace-vars expr))
                 (set::union (type-option-free-type-vars type?)
                             (expr-free-type-vars expr))
                 (expr-free-expr-vars expr))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (change-var-renamings
                        r :expr (extend-renaming var new-var
                                                 (var-renamings->expr r))))
                (result (eval-value-bind var expr type? denv limit))
                (new-result (eval-value-bind new-var new-expr new-type?
                                             new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (and (expr-denv-alpha-equiv-p new-result result new-r)
                                (expr-denv-keys-supported-p
                                 result new-r
                                 (set::insert new-var (string-sfix b)))
                                (implies
                                 (and (expr-denv-alpha-avoided-p
                                       new-denv denv r
                                       ivars tvars
                                       (set::delete var (string-sfix evars)))
                                      (not (set::in new-var
                                                    (rename-var-string-set
                                                     (set::delete var
                                                                  (string-sfix evars))
                                                     (var-renamings->expr r)))))
                                 (expr-denv-alpha-avoided-p
                                  new-result result new-r
                                  ivars tvars evars)))))))
  :use (eval-value-bind-alpha-equiv
        eval-value-bind-alpha-supported
        eval-value-bind-alpha-avoided))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Value binds are value-like: their evaluation is the generic value bind,
; and their relation and freshness supply the hypotheses of the generic
; lemmas.

; Freshness at a support set follows from freshness at a superset that is
; a union with it (the binds' layered support sets have these shapes).

(defruled expr-alpha-fresh-p-when-fresh-at-union-support-2
  (implies (and (expr-alpha-fresh-p new-x x r (set::union (string-sfix b) s2))
                (string-setp s2))
           (expr-alpha-fresh-p new-x x r b))
  :use ((:instance expr-alpha-fresh-p-anti-monotone
                   (b2 (set::union (string-sfix b) s2))
                   (b1 b)))
  :enable (set::union-subset-x))

(defruled eval-bind-when-val
  (implies (and (equal (bind-kind bind) :val)
                (not (zp limit)))
           (equal (eval-bind bind denv limit)
                  (eval-value-bind (bind-val->var bind)
                                   (bind-val->expr bind)
                                   (bind-val->type? bind)
                                   denv limit)))
  :expand ((eval-bind bind denv limit))
  :enable eval-value-bind)

(defruled bind-alpha-related-p-when-val
  (implies (and (equal (bind-kind bind) :val)
                (bind-alpha-related-p new-bind bind r))
           (and (equal (bind-kind new-bind) :val)
                (equal (bind-val->type? new-bind)
                       (type-option-rename-all-vars (bind-val->type? bind) r))
                (expr-alpha-related-p (bind-val->expr new-bind)
                                      (bind-val->expr bind)
                                      r)))
  :expand ((bind-alpha-related-p new-bind bind r)))

(defruled bind-alpha-fresh-p-when-val
  (implies (and (equal (bind-kind bind) :val)
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b))
           (and (name-fresh-ok (bind-val->var bind) (bind-val->var new-bind)
                               (var-renamings->expr r) b)
                (type-option-fresh-ok (bind-val->type? bind) r)
                (expr-alpha-fresh-p (bind-val->expr new-bind)
                                    (bind-val->expr bind)
                                    r b)))
  :expand ((bind-alpha-fresh-p new-bind bind r b)
           (bind-name bind)
           (bind-name new-bind))
  :enable expr-alpha-fresh-p-when-fresh-at-union-support-2
  :use bind-alpha-related-p-when-val)

(defruled eval-bind-ok-when-val-aux
  (implies (and (equal (bind-kind bind) :val)
                (not (zp limit))
                (eval-expr-ok (bind-val->expr bind) denv (1- limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit))
                (new-result (eval-bind new-bind new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (and (expr-denv-alpha-equiv-p new-result result new-r)
                                (expr-denv-keys-supported-p
                                 result new-r
                                 (set::insert (str-fix (bind-name new-bind))
                                              (string-sfix b)))
                                (implies
                                 (and (expr-denv-alpha-avoided-p
                                       new-denv denv r
                                       (set::difference
                                        (ispace-var-set-fix ivars)
                                        (bind-bound-ispace-vars bind))
                                       (set::difference
                                        (type-var-set-fix tvars)
                                        (bind-bound-type-vars bind))
                                       (set::difference
                                        (string-sfix evars)
                                        (bind-bound-expr-vars bind)))
                                      (bind-nocapture-ok new-bind bind r
                                                         evars tvars ivars))
                                 (expr-denv-alpha-avoided-p
                                  new-result result new-r
                                  ivars tvars evars)))))))
  :expand ((bind-free-ispace-vars bind)
           (bind-free-type-vars bind)
           (bind-free-expr-vars bind)
           (bind-bound-ispace-vars bind)
           (bind-bound-type-vars bind)
           (bind-bound-expr-vars bind)
           (bind-nocapture-ok new-bind bind r evars tvars ivars)
           (bind-alpha-extended-renamings new-bind bind r)
           (bind-name bind)
           (bind-name new-bind))
  :enable (eval-bind-when-val
           set::difference-insert-y
           difference-of-nil-right
           set::pick-a-point-subset-strategy
           set::subset-in)
  :use (bind-alpha-related-p-when-val
        bind-alpha-fresh-p-when-val
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (bind-free-ispace-vars bind))
                   (tvars2 (bind-free-type-vars bind))
                   (evars2 (bind-free-expr-vars bind))
                   (ivars1 (set::union (type-option-free-ispace-vars
                                        (bind-val->type? bind))
                                       (expr-free-ispace-vars
                                        (bind-val->expr bind))))
                   (tvars1 (set::union (type-option-free-type-vars
                                        (bind-val->type? bind))
                                       (expr-free-type-vars
                                        (bind-val->expr bind))))
                   (evars1 (expr-free-expr-vars (bind-val->expr bind))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (set::difference (ispace-var-set-fix ivars) nil))
                   (tvars2 (set::difference (type-var-set-fix tvars) nil))
                   (evars2 (set::delete (bind-val->var bind) (string-sfix evars)))
                   (ivars1 ivars)
                   (tvars1 tvars)
                   (evars1 (set::delete (bind-val->var bind) (string-sfix evars))))
        (:instance eval-value-bind-alpha
                   (var (bind-val->var bind))
                   (new-var (bind-val->var new-bind))
                   (expr (bind-val->expr bind))
                   (new-expr (bind-val->expr new-bind))
                   (type? (bind-val->type? bind))
                   (new-type? (bind-val->type? new-bind)))))

(defruled eval-bind-ok-when-val
  (implies (and (equal (bind-kind bind) :val)
