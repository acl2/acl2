; Related values: kinds, dimensions, and the singleton matching checks.

(defruled dims-of-type-value-when-type-value-alpha-related-via-p
  (implies (type-value-alpha-related-via-p new-tval tval w)
           (equal (dims-of-type-value new-tval)
                  (dims-of-type-value tval)))
  :enable dims-of-type-value
  :expand ((type-value-alpha-related-via-p new-tval tval w)))

(defruled type-values-match-type-vars-p-of-singletons-when-related
  (implies (type-value-alpha-related-via-p new-tval tval w)
           (equal (type-values-match-type-vars-p (list new-tval) (list var))
                  (type-values-match-type-vars-p (list tval) (list var))))
  :enable (type-values-match-type-vars-p
           type-value-kind-when-type-value-alpha-related-via-p))

(defruled expr-values-match-type-values-p-of-singletons-when-related
  (implies (and (expr-value-alpha-related-via-p new-val val w)
                (expr-value-wfp new-val)
                (expr-value-wfp val)
                (type-value-alpha-related-via-p new-tval tval tw))
           (equal (expr-values-match-type-values-p (list new-val)
                                                   (list new-tval))
                  (expr-values-match-type-values-p (list val) (list tval))))
  :enable (expr-values-match-type-values-p
           dims-of-expr-value-when-expr-value-alpha-related-via-p
           type-value-kind-when-type-value-alpha-related-via-p)
  :use dims-of-type-value-when-type-value-alpha-related-via-p
  :expand ((type-value-alpha-related-via-p new-tval tval tw)))

