  (implies (and (equal (bind-kind bind) :tfun)
                (endp (bind-tfun->params bind))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b))
           (and (name-fresh-ok (bind-tfun->var bind) (bind-tfun->var new-bind)
                               (var-renamings->expr r) b)
                (type-option-fresh-ok (bind-tfun->type? bind) r)
                (expr-alpha-fresh-p (bind-tfun->expr new-bind)
