                (equal (expr-value-box->ispace new-target)
                       (expr-value-box->ispace target))
                (expr-value-alpha-related-via-p (expr-value-box->array new-target)
                                                (expr-value-box->array target)
                                                (expr-value-witness-box->array w))))
  :expand ((expr-value-alpha-related-via-p new-target target w)))

