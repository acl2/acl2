                          (set::delete (type-var-atom name) keys)
                          atom-renam array-renam))))
  :use ((:instance type-var-set-rename-type-vars-preimage-witnesses
                   (y (type-var-atom new-name))
                   (vars (set::delete (type-var-atom name) keys)))
        (:instance rename-type-var-atom-collision-refuted
                   (x (type-var-set-rename-type-vars-preimage
                       (type-var-atom new-name)
                       (set::delete (type-var-atom name) keys)
                       atom-renam array-renam)))))

(defruled expr-denv-alpha-related-via-p-of-add-type-atom
  (implies (and (expr-denv-alpha-related-via-p new-denv denv r dw)
                (type-value-alpha-related-via-p new-tval tval w)
                (type-varp var)
                (type-varp new-var)
                (type-var-case var :atom)
                (type-var-case new-var :atom)
                (type-valuep tval)
                (type-valuep new-tval)
                (type-value-witness-p w)
                (not (set::in new-var
                              (type-var-set-rename-type-vars
                               (set::delete var
                                            (omap::keys
                                             (type-denv->types
                                              (expr-denv->tenv denv))))
                               (var-renamings->atom r)
                               (var-renamings->array r)))))
           (expr-denv-alpha-related-via-p
            (expr-denv-add-type new-var new-tval new-denv)
            (expr-denv-add-type var tval denv)
            (change-var-renamings r :atom (extend-renaming (type-var-atom->name var)
                                                           (type-var-atom->name new-var)
                                                           (var-renamings->atom r)))
            (change-denv-witness dw :types (omap::update var w
                                                         (denv-witness->types dw)))))
  :expand ((:free (a b r dw) (expr-denv-alpha-related-via-p a b r dw))
           (:free (a b r wm) (type-denv-alpha-related-via-p a b r wm)))
  :enable (expr-denv-add-type
           type-denv-add-type
           type-var-type-value-map-alpha-related-via-p-when-covered-p
           type-var-type-value-map-covered-p-when-alpha-related-via-p)
  :use ((:instance type-var-type-value-map-covered-p-of-update-atom-extend-image
                   (new-map (type-denv->types (expr-denv->tenv new-denv)))
                   (map (type-denv->types (expr-denv->tenv denv)))
                   (tv var)
                   (new-tv new-var)
                   (wmap (denv-witness->types dw)))))

(defruled expr-denv-keys-supported-p-of-add-type-atom
  (implies (and (expr-denv-keys-supported-p denv r b)
                (type-varp var)
                (type-var-case var :atom)
                (stringp new-name))
           (expr-denv-keys-supported-p
            (expr-denv-add-type var tval denv)
            (change-var-renamings r :atom (extend-renaming (type-var-atom->name var)
                                                           new-name
                                                           (var-renamings->atom r)))
            (set::insert new-name (string-sfix b))))
  :enable (expr-denv-keys-supported-p
           expr-denv-add-type
           type-denv-add-type
           omap::keys-of-update
           string-set-supported-p-of-insert-extend
           string-set-supported-p-monotone
           set::subset-insert))

(defruled expr-denv-alpha-avoided-p-of-add-type-atom
  (implies (and (expr-denv-alpha-avoided-p new-denv denv r
                                           ivars
                                           (set::delete var (type-var-set-fix tvars))
                                           evars)
                (type-varp var)
                (type-varp new-var)
                (type-var-case var :atom)
                (type-var-case new-var :atom)
                (type-valuep tval)
                (type-valuep new-tval)
                (not (set::in new-var
                              (type-var-set-rename-type-vars
                               (set::delete var (type-var-set-fix tvars))
                               (var-renamings->atom r)
                               (var-renamings->array r)))))
           (expr-denv-alpha-avoided-p
            (expr-denv-add-type new-var new-tval new-denv)
            (expr-denv-add-type var tval denv)
            (change-var-renamings r :atom (extend-renaming (type-var-atom->name var)
                                                           (type-var-atom->name new-var)
                                                           (var-renamings->atom r)))
            ivars tvars evars))
  :expand ((:free (a b r i tv e) (expr-denv-alpha-avoided-p a b r i tv e)))
  :enable (expr-denv-add-type
           type-denv-add-type
           type-denv-alpha-avoided-p)
  :use ((:instance type-var-map-avoided-p-of-update-atom-extend-image
                   (new-map (type-denv->types (expr-denv->tenv new-denv)))
                   (map (type-denv->types (expr-denv->tenv denv)))
                   (atom-renam (var-renamings->atom r))
                   (array-renam (var-renamings->array r))
                   (vars tvars)
                   (tv var)
                   (new-tv new-var))))

(defruled type-var-type-value-map-covered-p-of-update-array-extend-image
  (implies (and (type-var-type-value-map-covered-p new-map map r wmap)
                (type-var-type-value-mapp new-map)
                (type-var-type-value-mapp map)
                (type-varp tv)
                (type-varp new-tv)
                (type-var-case tv :array)
                (type-var-case new-tv :array)
                (type-valuep new-tval)
                (type-valuep tval)
                (type-value-witness-p w)
                (type-var-type-value-witness-mapp wmap)
                (type-value-alpha-related-via-p new-tval tval w)
                (not (set::in new-tv
                              (type-var-set-rename-type-vars
                               (set::delete tv (omap::keys map))
                               (var-renamings->atom r)
                               (var-renamings->array r)))))
           (type-var-type-value-map-covered-p
            (omap::update new-tv new-tval new-map)
            (omap::update tv tval map)
            (var-renamings (var-renamings->dim r)
                           (var-renamings->shape r)
                           (var-renamings->atom r)
                           (extend-renaming (type-var-array->name tv)
                                            (type-var-array->name new-tv)
                                            (var-renamings->array r))
                           (var-renamings->expr r)
                           (var-renamings->avoid r))
            (omap::update tv w wmap)))
  :expand ((:free (renam)
            (type-var-type-value-map-covered-p
             (omap::update new-tv new-tval new-map)
             (omap::update tv tval map)
             renam
             (omap::update tv w wmap))))
  :enable (rename-type-var-of-array-extend
           omap::assoc-of-update
           omap::in-of-keys-to-assoc
           type-var-equal-by-array-name)
  :use ((:instance type-var-type-value-map-covered-p-necc
                   (var (type-var-type-value-map-covered-p-witness
                         (omap::update new-tv new-tval new-map)
                         (omap::update tv tval map)
                         (var-renamings (var-renamings->dim r)
                           (var-renamings->shape r)
                           (var-renamings->atom r)
                           (extend-renaming (type-var-array->name tv)
                                            (type-var-array->name new-tv)
                                            (var-renamings->array r))
                           (var-renamings->expr r)
                           (var-renamings->avoid r))
                         (omap::update tv w wmap))))
        (:instance in-of-rename-type-var-of-type-var-set-rename-type-vars
                   (var (type-var-type-value-map-covered-p-witness
                         (omap::update new-tv new-tval new-map)
                         (omap::update tv tval map)
                         (var-renamings (var-renamings->dim r)
                           (var-renamings->shape r)
                           (var-renamings->atom r)
                           (extend-renaming (type-var-array->name tv)
                                            (type-var-array->name new-tv)
                                            (var-renamings->array r))
                           (var-renamings->expr r)
                           (var-renamings->avoid r))
                         (omap::update tv w wmap)))
                   (vars (set::delete tv (omap::keys map)))
                   (atom-renam (var-renamings->atom r))
                   (array-renam (var-renamings->array r)))))

