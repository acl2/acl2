; Environment extension at a binder, in the form the closure cases can
; discharge: the new name must not be the renaming of any other key of the
; original map (for the success direction), or of any other variable of the
; failure-direction set.  Both follow from the closure's no-capture
; condition, since the captured keys are among the body's free variables.
; The kept-name case (new name = old name) is covered by the same lemmas:
; the extension is then a deletion of the old entry, and the image
; condition excludes the collisions.

(defruled string-expr-value-map-covered-p-of-update-extend-image
  (implies (and (string-expr-value-map-covered-p new-map map renam wmap)
                (string-expr-value-mapp new-map)
                (string-expr-value-mapp map)
                (stringp name)
                (stringp new-name)
                (expr-valuep new-val)
                (expr-valuep val)
                (expr-value-witness-p w)
                (string-expr-value-witness-mapp wmap)
                (expr-value-alpha-related-via-p new-val val w)
                (not (set::in new-name
                              (rename-var-string-set
                               (set::delete name (omap::keys map))
                               renam))))
           (string-expr-value-map-covered-p
            (omap::update new-name new-val new-map)
            (omap::update name val map)
            (extend-renaming name new-name renam)
            (omap::update name w wmap)))
  :expand ((string-expr-value-map-covered-p
            (omap::update new-name new-val new-map)
            (omap::update name val map)
            (extend-renaming name new-name renam)
            (omap::update name w wmap)))
  :enable (rename-var-string-of-extend-renaming
           omap::assoc-of-update
           omap::in-of-keys-to-assoc)
  :use ((:instance string-expr-value-map-covered-p-necc
                   (var (string-expr-value-map-covered-p-witness
                         (omap::update new-name new-val new-map)
                         (omap::update name val map)
                         (extend-renaming name new-name renam)
                         (omap::update name w wmap))))
        (:instance in-of-rename-var-string-of-rename-var-string-set
                   (x (string-expr-value-map-covered-p-witness
                       (omap::update new-name new-val new-map)
                       (omap::update name val map)
                       (extend-renaming name new-name renam)
                       (omap::update name w wmap)))
                   (vars (set::delete name (omap::keys map))))))

(defruled string-expr-value-map-avoided-p-of-update-extend-image
  (implies (and (string-expr-value-map-avoided-p new-map map renam
                                                 (set::delete name
                                                              (string-sfix vars)))
                (string-expr-value-mapp new-map)
                (string-expr-value-mapp map)
                (stringp name)
                (stringp new-name)
                (expr-valuep new-val)
                (expr-valuep val)
                (not (set::in new-name
                              (rename-var-string-set
                               (set::delete name (string-sfix vars))
                               renam))))
           (string-expr-value-map-avoided-p
            (omap::update new-name new-val new-map)
            (omap::update name val map)
            (extend-renaming name new-name renam)
            vars))
  :expand ((string-expr-value-map-avoided-p
            (omap::update new-name new-val new-map)
            (omap::update name val map)
            (extend-renaming name new-name renam)
            vars))
  :enable (rename-var-string-of-extend-renaming
           omap::assoc-of-update)
  :use ((:instance string-expr-value-map-avoided-p-necc
                   (vars (set::delete name (string-sfix vars)))
                   (var (string-expr-value-map-avoided-p-witness
                         (omap::update new-name new-val new-map)
                         (omap::update name val map)
                         (extend-renaming name new-name renam)
                         vars)))
        (:instance in-of-rename-var-string-of-rename-var-string-set
                   (x (string-expr-value-map-avoided-p-witness
                       (omap::update new-name new-val new-map)
                       (omap::update name val map)
                       (extend-renaming name new-name renam)
                       vars))
                   (vars (set::delete name (string-sfix vars))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defruled type-var-type-value-map-covered-p-of-update-atom-extend-image
  (implies (and (type-var-type-value-map-covered-p new-map map r wmap)
                (type-var-type-value-mapp new-map)
                (type-var-type-value-mapp map)
                (type-varp tv)
                (type-varp new-tv)
                (type-var-case tv :atom)
                (type-var-case new-tv :atom)
                (type-valuep new-tval)
                (type-valuep tval)
                (type-value-witness-p w)
                (type-var-type-value-witness-mapp wmap)
                (type-value-alpha-related-via-p new-tval tval w)
                (not (set::in new-tv
                              (type-var-set-rename-type-vars
                               (set::delete tv (omap::keys map))
                               (var-renamings->atom r)
                               (var-renamings->array r)))))
           (type-var-type-value-map-covered-p
            (omap::update new-tv new-tval new-map)
            (omap::update tv tval map)
            (var-renamings (var-renamings->dim r)
                           (var-renamings->shape r)
                           (extend-renaming (type-var-atom->name tv)
                                            (type-var-atom->name new-tv)
                                            (var-renamings->atom r))
                           (var-renamings->array r)
                           (var-renamings->expr r)
                           (var-renamings->avoid r))
            (omap::update tv w wmap)))
  :expand ((:free (renam)
            (type-var-type-value-map-covered-p
             (omap::update new-tv new-tval new-map)
             (omap::update tv tval map)
             renam
             (omap::update tv w wmap))))
  :enable (rename-type-var-of-atom-extend
           omap::assoc-of-update
           omap::in-of-keys-to-assoc
           type-var-equal-by-atom-name)
  :use ((:instance type-var-type-value-map-covered-p-necc
                   (var (type-var-type-value-map-covered-p-witness
                         (omap::update new-tv new-tval new-map)
                         (omap::update tv tval map)
                         (var-renamings (var-renamings->dim r)
                           (var-renamings->shape r)
                           (extend-renaming (type-var-atom->name tv)
                                            (type-var-atom->name new-tv)
                                            (var-renamings->atom r))
                           (var-renamings->array r)
                           (var-renamings->expr r)
                           (var-renamings->avoid r))
                         (omap::update tv w wmap))))
        (:instance in-of-rename-type-var-of-type-var-set-rename-type-vars
                   (var (type-var-type-value-map-covered-p-witness
                         (omap::update new-tv new-tval new-map)
                         (omap::update tv tval map)
                         (var-renamings (var-renamings->dim r)
                           (var-renamings->shape r)
                           (extend-renaming (type-var-atom->name tv)
                                            (type-var-atom->name new-tv)
                                            (var-renamings->atom r))
                           (var-renamings->array r)
                           (var-renamings->expr r)
                           (var-renamings->avoid r))
                         (omap::update tv w wmap)))
                   (vars (set::delete tv (omap::keys map)))
                   (atom-renam (var-renamings->atom r))
                   (array-renam (var-renamings->array r)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Restriction of related environments, as performed at closure creation:
; restricting the new side to sets that include the renaming-images of the
; sets the original side is restricted to preserves the success-direction
; relation; restricting both sides preserves the failure-direction
; relation at the variables kept; and the keys of the restriction are
; within the restriction sets.

(defruled expr-denv-alpha-related-via-p-of-expr-denv-restrict
  (implies (and (expr-denv-alpha-related-via-p new-denv denv r dw)
                (ispace-var-setp ivars)
                (type-var-setp tvars)
                (string-setp evars)
                (ispace-var-setp new-ivars)
                (type-var-setp new-tvars)
                (string-setp new-evars)
                (set::subset (ispace-var-set-rename-ispace-vars
                              ivars
                              (var-renamings->dim r)
                              (var-renamings->shape r))
                             new-ivars)
                (set::subset (type-var-set-rename-type-vars
                              tvars
                              (var-renamings->atom r)
                              (var-renamings->array r))
                             new-tvars)
                (set::subset (rename-var-string-set evars
                                                    (var-renamings->expr r))
                             new-evars))
           (expr-denv-alpha-related-via-p
            (expr-denv-restrict new-ivars new-tvars new-evars new-denv)
            (expr-denv-restrict ivars tvars evars denv)
            r dw))
  :expand ((expr-denv-alpha-related-via-p new-denv denv r dw)
           (:free (a b)
            (expr-denv-alpha-related-via-p a b r dw))
           (type-denv-alpha-related-via-p (expr-denv->tenv new-denv)
                                          (expr-denv->tenv denv)
                                          r (denv-witness->types dw))
           (:free (a b)
            (type-denv-alpha-related-via-p a b r (denv-witness->types dw))))
  :enable (expr-denv-restrict
           type-denv-restrict
           ispace-denv-restrict)
  :use ((:instance denv-ispace-vars-covered-p-of-restrict
                   (new-ienv (type-denv->ienv (expr-denv->tenv new-denv)))
                   (ienv (type-denv->ienv (expr-denv->tenv denv)))
                   (dim-renam (var-renamings->dim r))
                   (shape-renam (var-renamings->shape r))
                   (vars ivars)
                   (new-vars new-ivars))
        (:instance type-var-type-value-map-covered-p-of-restrict-mapp
                   (new-map (type-denv->types (expr-denv->tenv new-denv)))
                   (map (type-denv->types (expr-denv->tenv denv)))
                   (wmap (denv-witness->types dw))
                   (vars tvars)
                   (new-vars new-tvars))
        (:instance type-var-type-value-map-covered-p-when-alpha-related-via-p
                   (new-map (type-denv->types (expr-denv->tenv new-denv)))
                   (map (type-denv->types (expr-denv->tenv denv)))
                   (wmap (denv-witness->types dw)))
        (:instance type-var-type-value-map-alpha-related-via-p-when-covered-p
                   (new-map (omap::restrict new-tvars
                                            (type-denv->types
                                             (expr-denv->tenv new-denv))))
                   (map (omap::restrict tvars
                                        (type-denv->types (expr-denv->tenv denv))))
                   (wmap (denv-witness->types dw)))
        (:instance string-expr-value-map-covered-p-of-restrict
                   (new-map (expr-denv->exprs new-denv))
                   (map (expr-denv->exprs denv))
                   (renam (var-renamings->expr r))
                   (wmap (denv-witness->exprs dw))
                   (vars evars)
                   (new-vars new-evars))
        (:instance string-expr-value-map-covered-p-when-alpha-related-via-p
                   (new-map (expr-denv->exprs new-denv))
                   (map (expr-denv->exprs denv))
                   (renam (var-renamings->expr r))
                   (wmap (denv-witness->exprs dw)))
        (:instance string-expr-value-map-alpha-related-via-p-when-covered-p
                   (new-map (omap::restrict new-evars (expr-denv->exprs new-denv)))
                   (map (omap::restrict evars (expr-denv->exprs denv)))
                   (renam (var-renamings->expr r))
                   (wmap (denv-witness->exprs dw)))))

(defruled expr-denv-alpha-avoided-p-of-expr-denv-restrict
  (implies (and (expr-denv-alpha-avoided-p new-denv denv r ivars tvars evars)
                (set::subset (ispace-var-set-fix ivars)
                             (ispace-var-set-fix ivars1))
                (set::subset (type-var-set-fix tvars)
                             (type-var-set-fix tvars1))
                (set::subset (string-sfix evars) (string-sfix evars1)))
           (expr-denv-alpha-avoided-p
            (expr-denv-restrict new-ivars new-tvars new-evars new-denv)
            (expr-denv-restrict ivars1 tvars1 evars1 denv)
            r ivars tvars evars))
  :enable (expr-denv-alpha-avoided-p
           type-denv-alpha-avoided-p
           expr-denv-restrict
           type-denv-restrict
           ispace-denv-restrict
           denv-ispace-vars-avoided-p-of-restrict
           type-var-map-avoided-p-of-restrict
           string-expr-value-map-avoided-p-of-restrict))

(defruled expr-denv-keys-within-p-of-expr-denv-restrict
  (expr-denv-keys-within-p (expr-denv-restrict ivars tvars evars denv)
                           ivars tvars evars)
  :enable (expr-denv-keys-within-p
           type-denv-keys-within-p
           expr-denv-restrict
           type-denv-restrict
           ispace-denv-restrict
           omap::keys-of-restrict))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Variable lookup under the relations: a lookup of a variable in the
; failure-direction set errs on the new side exactly when it errs on the
; original side, and on success finds an alpha-equivalent value.

(defruled expr-denv-lookup-expr-alpha
  (implies (and (expr-denv-alpha-related-via-p new-denv denv r dw)
                (string-expr-value-map-avoided-p (expr-denv->exprs new-denv)
                                                 (expr-denv->exprs denv)
                                                 (var-renamings->expr r)
                                                 vars)
                (set::in (str-fix var) (string-sfix vars)))
           (b* ((val (expr-denv-lookup-expr var denv))
                (new-val (expr-denv-lookup-expr
                          (rename-var-string var (var-renamings->expr r))
                          new-denv)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :enable (expr-denv-lookup-expr
           expr-denv-alpha-related-via-p
           not-reserrp-when-expr-valuep)
  :use ((:instance string-expr-value-map-alpha-related-via-p-implies-check
                   (new-map (expr-denv->exprs new-denv))
                   (map (expr-denv->exprs denv))
                   (renam (var-renamings->expr r))
                   (wmap (denv-witness->exprs dw))
                   (var (str-fix var)))
        (:instance string-expr-value-map-avoided-p-necc
                   (new-map (expr-denv->exprs new-denv))
                   (map (expr-denv->exprs denv))
                   (renam (var-renamings->expr r))
                   (var (str-fix var)))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (cdr (omap::assoc
                                  (rename-var-string var (var-renamings->expr r))
                                  (expr-denv->exprs new-denv))))
                   (val (cdr (omap::assoc (str-fix var)
                                          (expr-denv->exprs denv))))
                   (w (b* ((wpair (omap::assoc
                                   (str-fix var)
                                   (string-expr-value-witness-map-fix
                                    (denv-witness->exprs dw)))))
                        (if wpair (cdr wpair) (expr-value-witness-atom)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The cases of the induction: one lemma per case of each function of the
; clique, each concluding the function's statement from the statements at
; the recursive calls of that case (its induction hypotheses).

; The existential forms are consumed through their witnesses and
; established through their SUFF rules; their definitions stay closed.

(in-theory (disable expr-value-alpha-equiv-p
                    expr-value-list-alpha-equiv-p
                    expr-denv-alpha-equiv-p
                    type-value-alpha-equiv-p))

; Expressions: variables and strings need no induction hypothesis.

(defruled eval-expr-ok-when-var
  (implies (equal (expr-kind expr) :var)
           (eval-expr-ok expr denv limit))
  :expand ((eval-expr-ok expr denv limit)
           (:free (x d) (eval-expr x d limit))
           (:free (new-x r) (expr-alpha-related-p new-x expr r)))
  :enable (expr-denv-alpha-avoided-p
           expr-free-expr-vars
           expr-denv-lookup-expr-alpha))

; Equal values are related via the leaf witnesses, hence alpha-equivalent.
; (The rules are stated with the witness constants evaluated, as they
; appear in goals.)

(defrule expr-value-alpha-related-via-p-of-same-via-atom
  (implies (expr-value-groundp val)
           (expr-value-alpha-related-via-p val val '(:atom)))
  :expand ((:free (w) (expr-value-alpha-related-via-p val val w))))

(defrule expr-value-alpha-equiv-p-of-same
  (implies (expr-value-groundp val)
           (expr-value-alpha-equiv-p val val))
  :use ((:instance expr-value-alpha-equiv-p-suff
                   (new-val val) (val val) (w '(:atom))))
  :disable expr-value-alpha-equiv-p-suff)

(defrule type-value-alpha-related-via-p-of-same-via-leaf
  (implies (type-value-groundp tval)
           (type-value-alpha-related-via-p tval tval '(:leaf)))
  :expand ((:free (w) (type-value-alpha-related-via-p tval tval w))))

(defrule type-value-alpha-equiv-p-of-same
  (implies (type-value-groundp tval)
           (type-value-alpha-equiv-p tval tval))
  :use ((:instance type-value-alpha-equiv-p-suff
                   (new-tval tval) (tval tval) (w '(:leaf))))
  :disable type-value-alpha-equiv-p-suff)

(defruled string-expr-value-map-avoided-p-monotone
  (implies (and (string-expr-value-map-avoided-p new-map map renam vars2)
                (set::subset (string-sfix vars1) (string-sfix vars2)))
           (string-expr-value-map-avoided-p new-map map renam vars1))
  :expand ((string-expr-value-map-avoided-p new-map map renam vars1))
  :use ((:instance string-expr-value-map-avoided-p-necc
                   (vars vars2)
                   (var (string-expr-value-map-avoided-p-witness
                         new-map map renam vars1)))
        (:instance set::subset-in
                   (a (string-expr-value-map-avoided-p-witness
                       new-map map renam vars1))
                   (x (string-sfix vars1))
                   (y (string-sfix vars2)))))

(defruled eval-expr-ok-when-string
  (implies (equal (expr-kind expr) :string)
           (eval-expr-ok expr denv limit))
  :expand ((eval-expr-ok expr denv limit)
           (:free (x d) (eval-expr x d limit))
           (:free (new-x r) (expr-alpha-related-p new-x expr r))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Dimensions of related lists of well-formed values are equal.

(defruled dims-of-expr-value-list-when-alpha-related
  (implies (and (expr-value-list-alpha-related-via-p new-vals vals ws)
                (expr-value-list-wfp new-vals)
                (expr-value-list-wfp vals))
           (equal (dims-of-expr-value-list new-vals)
                  (dims-of-expr-value-list vals)))
  :induct (three-cdrs-induct new-vals vals ws)
  :enable (three-cdrs-induct
           dims-of-expr-value-when-expr-value-alpha-related-via-p)
  :expand ((expr-value-list-alpha-related-via-p new-vals vals ws)))

; Expressions: an atom expression delegates to the atom.

(defruled eval-expr-ok-when-atom
  (implies (and (equal (expr-kind expr) :atom)
                (eval-atom-ok (expr-atom->atom expr) denv (1- limit)))
           (eval-expr-ok expr denv limit))
  :expand ((eval-expr-ok expr denv limit)
           (:free (x d) (eval-expr x d limit))
           (:free (new-x r) (expr-alpha-related-p new-x expr r))
           (:free (new-x r b) (expr-alpha-fresh-p new-x expr r b)))
  :enable (expr-free-ispace-vars expr-free-type-vars expr-free-expr-vars)
  :use ((:instance eval-atom-ok-necc
                   (atom (expr-atom->atom expr))
                   (limit (1- limit))
                   (new-atom (expr-atom->atom
                              (mv-nth 0 (eval-expr-ok-witness expr denv limit))))
                   (new-denv (mv-nth 1 (eval-expr-ok-witness expr denv limit)))
                   (r (mv-nth 2 (eval-expr-ok-witness expr denv limit)))
                   (dw (mv-nth 3 (eval-expr-ok-witness expr denv limit)))
                   (b (mv-nth 4 (eval-expr-ok-witness expr denv limit))))))

; Atoms: literals need no induction hypothesis.

(defruled eval-atom-ok-when-base
  (implies (equal (atom-kind atom) :base)
           (eval-atom-ok atom denv limit))
  :expand ((eval-atom-ok atom denv limit)
           (:free (x d) (eval-atom x d limit))
           (:free (new-x r) (atom-alpha-related-p new-x atom r))))

; Lists of expressions and of atoms.

(defruled eval-expr-list-ok-when-endp
  (implies (not (consp exprs))
           (eval-expr-list-ok exprs denv limit))
  :expand ((eval-expr-list-ok exprs denv limit)
           (:free (x d) (eval-expr-list x d limit))
           (:free (new-x r) (expr-list-alpha-related-p new-x exprs r)))
  :use ((:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals nil) (vals nil) (ws nil)))
  :enable expr-value-list-alpha-related-via-p)

; The failure-direction relation is monotone in the variable sets.

(defruled expr-denv-alpha-avoided-p-monotone
  (implies (and (expr-denv-alpha-avoided-p new-denv denv r ivars2 tvars2 evars2)
                (set::subset (ispace-var-set-fix ivars1)
                             (ispace-var-set-fix ivars2))
                (set::subset (type-var-set-fix tvars1)
                             (type-var-set-fix tvars2))
                (set::subset (string-sfix evars1) (string-sfix evars2)))
           (expr-denv-alpha-avoided-p new-denv denv r ivars1 tvars1 evars1))
  :enable (expr-denv-alpha-avoided-p
           type-denv-alpha-avoided-p
           denv-ispace-vars-avoided-p-monotone
           type-var-map-avoided-p-monotone
           string-expr-value-map-avoided-p-monotone))

; Lists of exprs: the relations at a non-empty list, piecewise.

(defruled expr-list-alpha-related-p-when-consp
  (implies (and (consp exprs)
                (expr-list-alpha-related-p new-exprs exprs r))
           (and (consp new-exprs)
                (expr-alpha-related-p (car new-exprs) (car exprs) r)
                (expr-list-alpha-related-p (cdr new-exprs) (cdr exprs) r)))
  :expand ((expr-list-alpha-related-p new-exprs exprs r)))

(defruled expr-list-alpha-fresh-p-when-consp
  (implies (and (consp exprs)
                (expr-list-alpha-related-p new-exprs exprs r)
                (expr-list-alpha-fresh-p new-exprs exprs r b))
           (and (expr-alpha-fresh-p (car new-exprs) (car exprs) r b)
                (expr-list-alpha-fresh-p (cdr new-exprs) (cdr exprs) r b)))
  :expand ((expr-list-alpha-fresh-p new-exprs exprs r b))
  :use expr-list-alpha-related-p-when-consp)

(defruled expr-denv-alpha-avoided-p-of-expr-list-parts
  (implies (and (consp exprs)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-list-free-ispace-vars exprs)
                                           (expr-list-free-type-vars exprs)
                                           (expr-list-free-expr-vars exprs)))
           (and (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-free-ispace-vars (car exprs))
                                           (expr-free-type-vars (car exprs))
                                           (expr-free-expr-vars (car exprs)))
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-list-free-ispace-vars (cdr exprs))
                                           (expr-list-free-type-vars (cdr exprs))
                                           (expr-list-free-expr-vars (cdr exprs)))))
  :expand ((expr-list-free-ispace-vars exprs)
           (expr-list-free-type-vars exprs)
           (expr-list-free-expr-vars exprs))
  :enable (subset-of-union-right-1
           subset-of-union-right-2)
  :use ((:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (expr-list-free-ispace-vars exprs))
                   (tvars2 (expr-list-free-type-vars exprs))
                   (evars2 (expr-list-free-expr-vars exprs))
                   (ivars1 (expr-free-ispace-vars (car exprs)))
                   (tvars1 (expr-free-type-vars (car exprs)))
                   (evars1 (expr-free-expr-vars (car exprs))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (expr-list-free-ispace-vars exprs))
                   (tvars2 (expr-list-free-type-vars exprs))
                   (evars2 (expr-list-free-expr-vars exprs))
                   (ivars1 (expr-list-free-ispace-vars (cdr exprs)))
                   (tvars1 (expr-list-free-type-vars (cdr exprs)))
                   (evars1 (expr-list-free-expr-vars (cdr exprs))))))

(defruled eval-expr-list-ok-when-consp-aux
  (implies (and (consp exprs)
                (eval-expr-ok (car exprs) denv (1- limit))
                (implies (not (reserrp (eval-expr (car exprs) denv (1- limit))))
                         (eval-expr-list-ok (cdr exprs) denv (1- limit)))
                (expr-list-alpha-related-p new-exprs exprs r)
                (expr-list-alpha-fresh-p new-exprs exprs r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-list-free-ispace-vars exprs)
                                           (expr-list-free-type-vars exprs)
                                           (expr-list-free-expr-vars exprs))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((vals (eval-expr-list exprs denv limit))
                (new-vals (eval-expr-list new-exprs new-denv limit)))
             (and (equal (reserrp new-vals) (reserrp vals))
                  (implies (not (reserrp vals))
                           (expr-value-list-alpha-equiv-p new-vals vals)))))
  :expand ((eval-expr-list exprs denv limit)
           (eval-expr-list new-exprs new-denv limit)
           (:free (a b c d)
            (expr-value-list-alpha-related-via-p a (cons b c) d)))
  :enable (not-reserrp-when-expr-value-listp
           expr-valuep-when-result-not-error
           expr-value-listp-when-result-not-error)
  :use (expr-list-alpha-related-p-when-consp
        expr-list-alpha-fresh-p-when-consp
        expr-denv-alpha-avoided-p-of-expr-list-parts
        (:instance eval-expr-ok-necc
                   (expr (car exprs))
                   (new-expr (car new-exprs))
                   (limit (1- limit)))
        (:instance eval-expr-list-ok-necc
                   (exprs (cdr exprs))
                   (new-exprs (cdr new-exprs))
                   (limit (1- limit)))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-expr (car new-exprs) new-denv (1- limit)))
                   (val (eval-expr (car exprs) denv (1- limit))))
        (:instance expr-value-list-alpha-equiv-p
                   (new-vals (eval-expr-list (cdr new-exprs) new-denv (1- limit)))
                   (vals (eval-expr-list (cdr exprs) denv (1- limit))))
        (:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals (eval-expr-list new-exprs new-denv limit))
                   (vals (eval-expr-list exprs denv limit))
                   (ws (cons (expr-value-alpha-equiv-p-witness
                              (eval-expr (car new-exprs) new-denv (1- limit))
                              (eval-expr (car exprs) denv (1- limit)))
                             (expr-value-list-alpha-equiv-p-witness
                              (eval-expr-list (cdr new-exprs) new-denv (1- limit))
                              (eval-expr-list (cdr exprs) denv (1- limit))))))))

(defruled eval-expr-list-ok-when-consp
  (implies (and (consp exprs)
                (eval-expr-ok (car exprs) denv (1- limit))
                (implies (not (reserrp (eval-expr (car exprs) denv (1- limit))))
                         (eval-expr-list-ok (cdr exprs) denv (1- limit))))
           (eval-expr-list-ok exprs denv limit))
  :expand ((eval-expr-list-ok exprs denv limit))
  :use ((:instance eval-expr-list-ok-when-consp-aux
                   (new-exprs (mv-nth 0 (eval-expr-list-ok-witness exprs denv limit)))
                   (new-denv (mv-nth 1 (eval-expr-list-ok-witness exprs denv limit)))
                   (r (mv-nth 2 (eval-expr-list-ok-witness exprs denv limit)))
                   (dw (mv-nth 3 (eval-expr-list-ok-witness exprs denv limit)))
                   (b (mv-nth 4 (eval-expr-list-ok-witness exprs denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defruled eval-atom-list-ok-when-endp
  (implies (not (consp atoms))
           (eval-atom-list-ok atoms denv limit))
  :expand ((eval-atom-list-ok atoms denv limit)
           (:free (x d) (eval-atom-list x d limit))
           (:free (new-x r) (atom-list-alpha-related-p new-x atoms r)))
  :use ((:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals nil) (vals nil) (ws nil)))
  :enable expr-value-list-alpha-related-via-p)

; Lists of atoms: the relations at a non-empty list, piecewise.

(defruled atom-list-alpha-related-p-when-consp
  (implies (and (consp atoms)
                (atom-list-alpha-related-p new-atoms atoms r))
           (and (consp new-atoms)
                (atom-alpha-related-p (car new-atoms) (car atoms) r)
                (atom-list-alpha-related-p (cdr new-atoms) (cdr atoms) r)))
  :expand ((atom-list-alpha-related-p new-atoms atoms r)))

(defruled atom-list-alpha-fresh-p-when-consp
  (implies (and (consp atoms)
                (atom-list-alpha-related-p new-atoms atoms r)
                (atom-list-alpha-fresh-p new-atoms atoms r b))
           (and (atom-alpha-fresh-p (car new-atoms) (car atoms) r b)
                (atom-list-alpha-fresh-p (cdr new-atoms) (cdr atoms) r b)))
  :expand ((atom-list-alpha-fresh-p new-atoms atoms r b))
  :use atom-list-alpha-related-p-when-consp)

(defruled expr-denv-alpha-avoided-p-of-atom-list-parts
  (implies (and (consp atoms)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-list-free-ispace-vars atoms)
                                           (atom-list-free-type-vars atoms)
                                           (atom-list-free-expr-vars atoms)))
           (and (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-free-ispace-vars (car atoms))
                                           (atom-free-type-vars (car atoms))
                                           (atom-free-expr-vars (car atoms)))
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-list-free-ispace-vars (cdr atoms))
                                           (atom-list-free-type-vars (cdr atoms))
                                           (atom-list-free-expr-vars (cdr atoms)))))
  :expand ((atom-list-free-ispace-vars atoms)
           (atom-list-free-type-vars atoms)
           (atom-list-free-expr-vars atoms))
  :enable (subset-of-union-right-1
           subset-of-union-right-2)
  :use ((:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (atom-list-free-ispace-vars atoms))
                   (tvars2 (atom-list-free-type-vars atoms))
                   (evars2 (atom-list-free-expr-vars atoms))
                   (ivars1 (atom-free-ispace-vars (car atoms)))
                   (tvars1 (atom-free-type-vars (car atoms)))
                   (evars1 (atom-free-expr-vars (car atoms))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (atom-list-free-ispace-vars atoms))
                   (tvars2 (atom-list-free-type-vars atoms))
                   (evars2 (atom-list-free-expr-vars atoms))
                   (ivars1 (atom-list-free-ispace-vars (cdr atoms)))
                   (tvars1 (atom-list-free-type-vars (cdr atoms)))
                   (evars1 (atom-list-free-expr-vars (cdr atoms))))))

(defruled eval-atom-list-ok-when-consp-aux
  (implies (and (consp atoms)
                (eval-atom-ok (car atoms) denv (1- limit))
                (implies (not (reserrp (eval-atom (car atoms) denv (1- limit))))
                         (eval-atom-list-ok (cdr atoms) denv (1- limit)))
                (atom-list-alpha-related-p new-atoms atoms r)
                (atom-list-alpha-fresh-p new-atoms atoms r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-list-free-ispace-vars atoms)
                                           (atom-list-free-type-vars atoms)
                                           (atom-list-free-expr-vars atoms))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((vals (eval-atom-list atoms denv limit))
                (new-vals (eval-atom-list new-atoms new-denv limit)))
             (and (equal (reserrp new-vals) (reserrp vals))
                  (implies (not (reserrp vals))
                           (expr-value-list-alpha-equiv-p new-vals vals)))))
  :expand ((eval-atom-list atoms denv limit)
           (eval-atom-list new-atoms new-denv limit)
           (:free (a b c d)
            (expr-value-list-alpha-related-via-p a (cons b c) d)))
  :enable (not-reserrp-when-expr-value-listp
           expr-valuep-when-result-not-error
           expr-value-listp-when-result-not-error)
  :use (atom-list-alpha-related-p-when-consp
        atom-list-alpha-fresh-p-when-consp
        expr-denv-alpha-avoided-p-of-atom-list-parts
        (:instance eval-atom-ok-necc
                   (atom (car atoms))
                   (new-atom (car new-atoms))
                   (limit (1- limit)))
        (:instance eval-atom-list-ok-necc
                   (atoms (cdr atoms))
                   (new-atoms (cdr new-atoms))
                   (limit (1- limit)))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-atom (car new-atoms) new-denv (1- limit)))
                   (val (eval-atom (car atoms) denv (1- limit))))
        (:instance expr-value-list-alpha-equiv-p
                   (new-vals (eval-atom-list (cdr new-atoms) new-denv (1- limit)))
                   (vals (eval-atom-list (cdr atoms) denv (1- limit))))
        (:instance expr-value-list-alpha-equiv-p-suff
                   (new-vals (eval-atom-list new-atoms new-denv limit))
                   (vals (eval-atom-list atoms denv limit))
                   (ws (cons (expr-value-alpha-equiv-p-witness
                              (eval-atom (car new-atoms) new-denv (1- limit))
                              (eval-atom (car atoms) denv (1- limit)))
                             (expr-value-list-alpha-equiv-p-witness
                              (eval-atom-list (cdr new-atoms) new-denv (1- limit))
                              (eval-atom-list (cdr atoms) denv (1- limit))))))))

(defruled eval-atom-list-ok-when-consp
  (implies (and (consp atoms)
                (eval-atom-ok (car atoms) denv (1- limit))
                (implies (not (reserrp (eval-atom (car atoms) denv (1- limit))))
                         (eval-atom-list-ok (cdr atoms) denv (1- limit))))
           (eval-atom-list-ok atoms denv limit))
  :expand ((eval-atom-list-ok atoms denv limit))
  :use ((:instance eval-atom-list-ok-when-consp-aux
                   (new-atoms (mv-nth 0 (eval-atom-list-ok-witness atoms denv limit)))
                   (new-denv (mv-nth 1 (eval-atom-list-ok-witness atoms denv limit)))
                   (r (mv-nth 2 (eval-atom-list-ok-witness atoms denv limit)))
                   (dw (mv-nth 3 (eval-atom-list-ok-witness atoms denv limit)))
                   (b (mv-nth 4 (eval-atom-list-ok-witness atoms denv limit))))))

(defruled consp-when-expr-value-list-alpha-related-via-p
  (implies (expr-value-list-alpha-related-via-p new-vals vals ws)
           (equal (consp new-vals) (consp vals)))
  :expand ((expr-value-list-alpha-related-via-p new-vals vals ws)))

; Expressions: brackets evaluate their elements and form a vector.

(defruled eval-expr-ok-when-bracket
  (implies (and (equal (expr-kind expr) :bracket)
                (eval-expr-list-ok (expr-bracket->exprs expr) denv (1- limit)))
           (eval-expr-ok expr denv limit))
  :expand ((eval-expr-ok expr denv limit)
           (:free (x d) (eval-expr x d limit))
           (:free (new-x r) (expr-alpha-related-p new-x expr r))
           (:free (new-x r b) (expr-alpha-fresh-p new-x expr r b))
           (expr-free-ispace-vars expr)
           (expr-free-type-vars expr)
           (expr-free-expr-vars expr)
           (:free (a b w)
            (expr-value-alpha-related-via-p a (expr-value-vector b) w))
           (:free (a w) (expr-value-list-alpha-related-via-p a nil w)))
  :enable (len-when-expr-value-list-alpha-related-via-p
           consp-when-expr-value-list-alpha-related-via-p
           dims-of-expr-value-list-when-alpha-related
           expr-value-list-wfp-of-eval-expr-list
           not-reserrp-when-expr-valuep)
  :use ((:instance eval-expr-list-ok-necc
                   (exprs (expr-bracket->exprs expr))
                   (limit (1- limit))
                   (new-exprs (expr-bracket->exprs
                               (mv-nth 0 (eval-expr-ok-witness expr denv limit))))
                   (new-denv (mv-nth 1 (eval-expr-ok-witness expr denv limit)))
                   (r (mv-nth 2 (eval-expr-ok-witness expr denv limit)))
                   (dw (mv-nth 3 (eval-expr-ok-witness expr denv limit)))
                   (b (mv-nth 4 (eval-expr-ok-witness expr denv limit))))
        (:instance expr-value-list-alpha-equiv-p
                   (new-vals (eval-expr-list
                              (expr-bracket->exprs
                               (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                              (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                              (1- limit)))
                   (vals (eval-expr-list (expr-bracket->exprs expr) denv (1- limit))))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (expr-value-vector
                             (eval-expr-list
                              (expr-bracket->exprs
                               (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                              (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                              (1- limit))))
                   (val (expr-value-vector
                         (eval-expr-list (expr-bracket->exprs expr) denv (1- limit))))
                   (w (expr-value-witness-vector
                       (expr-value-list-alpha-equiv-p-witness
                        (eval-expr-list
                         (expr-bracket->exprs
                          (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                         (mv-nth 1 (eval-expr-ok-witness expr denv limit))
                         (1- limit))
                        (eval-expr-list (expr-bracket->exprs expr) denv (1- limit))))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Primitive operations under the relation: related stages are at the same
; stage, and applying them to related type values, or to the same ispace
; value, yields related next stages (or equal final results).

(defruled primop-value-kind-when-primop-value-alpha-related-via-p
  (implies (primop-value-alpha-related-via-p new-op op tws ws)
           (equal (primop-value-kind new-op)
                  (primop-value-kind op)))
  :expand ((primop-value-alpha-related-via-p new-op op tws ws)))

(defruled primop-value-tfunp-when-primop-value-alpha-related-via-p
  (implies (primop-value-alpha-related-via-p new-op op tws ws)
           (equal (primop-value-tfunp new-op)
                  (primop-value-tfunp op)))
  :enable (primop-value-tfunp
           primop-value-kind-when-primop-value-alpha-related-via-p))

(defruled primop-value-ifunp-when-primop-value-alpha-related-via-p
  (implies (primop-value-alpha-related-via-p new-op op tws ws)
           (equal (primop-value-ifunp new-op)
                  (primop-value-ifunp op)))
  :enable (primop-value-ifunp
           primop-value-kind-when-primop-value-alpha-related-via-p))

(defruled primop-value-funp-when-primop-value-alpha-related-via-p
  (implies (primop-value-alpha-related-via-p new-op op tws ws)
           (equal (primop-value-funp new-op)
                  (primop-value-funp op)))
  :enable (primop-value-funp
           primop-value-kind-when-primop-value-alpha-related-via-p))

(defruled eval-primop-tfun-alpha
  (implies (and (primop-value-alpha-related-via-p new-op op tws ws)
                (type-value-alpha-related-via-p new-tval tval tw))
           (b* ((val (eval-primop-tfun op tval))
                (new-val (eval-primop-tfun new-op new-tval)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :enable (eval-primop-tfun
           primop-value-kind-when-primop-value-alpha-related-via-p
           type-values-match-type-vars-p-of-singletons-when-related
           not-reserrp-when-expr-valuep)
  :expand ((primop-value-alpha-related-via-p new-op op tws ws)
           (:free (new-val val w)
            (expr-value-alpha-related-via-p new-val
                                            (expr-value-primop val)
                                            w))
           (:free (new-op op tws ws)
            (primop-value-alpha-related-via-p new-op op tws ws)))
  :use ((:instance expr-value-alpha-equiv-p-suff
                   (new-val (eval-primop-tfun new-op new-tval))
                   (val (eval-primop-tfun op tval))
                   (w (expr-value-witness-primop (list tw) nil)))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (eval-primop-tfun new-op new-tval))
                   (val (eval-primop-tfun op tval))
                   (w (expr-value-witness-primop (list (car tws) tw) nil)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defruled eval-expr-when-zp-limit
  (implies (zp limit)
           (equal (eval-expr expr denv limit)
                  (reserr :limit)))
  :expand ((eval-expr expr denv limit)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Expressions: the applications.  The function sub-expression's induction
; hypothesis yields related function values; the type argument is related
; by EVAL-TYPE-ALPHA under the freshness of its renaming; the ispace
; argument evaluates equally by EVAL-ISPACE-ALPHA; the application
; functions' hypotheses then relate the results.  The hypotheses on later
; sub-evaluations are conditioned on the earlier ones not erring, as in
; the evaluator's induction scheme.

; Applications: the relations at an application, piecewise.

(defruled expr-alpha-related-p-when-app
  (implies (and (equal (expr-kind expr) :app)
                (expr-alpha-related-p new-expr expr r))
           (and (equal (expr-kind new-expr) :app)
                (expr-alpha-related-p (expr-app->fun new-expr) (expr-app->fun expr) r)
                (expr-alpha-related-p (expr-app->arg new-expr) (expr-app->arg expr) r)))
  :expand ((expr-alpha-related-p new-expr expr r)))

(defruled expr-alpha-fresh-p-when-app
  (implies (and (equal (expr-kind expr) :app)
                (expr-alpha-related-p new-expr expr r)
                (expr-alpha-fresh-p new-expr expr r b))
           (and (expr-alpha-fresh-p (expr-app->fun new-expr) (expr-app->fun expr) r b)
                (expr-alpha-fresh-p (expr-app->arg new-expr) (expr-app->arg expr) r b)))
  :expand ((expr-alpha-fresh-p new-expr expr r b))
  :use expr-alpha-related-p-when-app)

(defruled expr-denv-alpha-avoided-p-of-app-parts
  (implies (and (equal (expr-kind expr) :app)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-free-ispace-vars expr)
                                           (expr-free-type-vars expr)
                                           (expr-free-expr-vars expr)))
           (and (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-free-ispace-vars (expr-app->fun expr))
                                           (expr-free-type-vars (expr-app->fun expr))
                                           (expr-free-expr-vars (expr-app->fun expr)))
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-free-ispace-vars (expr-app->arg expr))
                                           (expr-free-type-vars (expr-app->arg expr))
                                           (expr-free-expr-vars (expr-app->arg expr)))))
  :expand ((expr-free-ispace-vars expr)
           (expr-free-type-vars expr)
           (expr-free-expr-vars expr))
  :enable (subset-of-union-right-1
           subset-of-union-right-2)
  :use ((:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (expr-free-ispace-vars expr))
                   (tvars2 (expr-free-type-vars expr))
                   (evars2 (expr-free-expr-vars expr))
                   (ivars1 (expr-free-ispace-vars (expr-app->fun expr)))
                   (tvars1 (expr-free-type-vars (expr-app->fun expr)))
                   (evars1 (expr-free-expr-vars (expr-app->fun expr))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (expr-free-ispace-vars expr))
                   (tvars2 (expr-free-type-vars expr))
                   (evars2 (expr-free-expr-vars expr))
                   (ivars1 (expr-free-ispace-vars (expr-app->arg expr)))
                   (tvars1 (expr-free-type-vars (expr-app->arg expr)))
                   (evars1 (expr-free-expr-vars (expr-app->arg expr))))))

(defruled eval-expr-ok-when-app-aux
  (implies (and (equal (expr-kind expr) :app)
                (not (zp limit))
                (eval-expr-ok (expr-app->fun expr) denv (1- limit))
                (implies (not (reserrp (eval-expr (expr-app->fun expr) denv (1- limit))))
                         (eval-expr-ok (expr-app->arg expr) denv (1- limit)))
                (implies (and (not (reserrp (eval-expr (expr-app->fun expr) denv (1- limit)))) (not (reserrp (eval-expr (expr-app->arg expr) denv (1- limit)))))
                         (eval-app-ok (eval-expr (expr-app->fun expr) denv (1- limit)) (list (eval-expr (expr-app->arg expr) denv (1- limit))) (1- limit)))
                (expr-alpha-related-p new-expr expr r)
                (expr-alpha-fresh-p new-expr expr r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-free-ispace-vars expr)
                                           (expr-free-type-vars expr)
                                           (expr-free-expr-vars expr))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((val (eval-expr expr denv limit))
                (new-val (eval-expr new-expr new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((eval-expr expr denv limit)
           (eval-expr new-expr new-denv limit)
           (:free (a b c d) (expr-value-list-alpha-related-via-p a (cons b c) d))
           (:free (a d) (expr-value-list-alpha-related-via-p a nil d)))
  :enable (expr-value-wfp-of-eval-expr
           not-reserrp-when-expr-valuep
           expr-valuep-when-result-not-error)
  :use (expr-alpha-related-p-when-app
        expr-alpha-fresh-p-when-app
        expr-denv-alpha-avoided-p-of-app-parts
        (:instance eval-expr-ok-necc
                   (expr (expr-app->fun expr))
                   (new-expr (expr-app->fun new-expr))
                   (limit (1- limit)))
        (:instance eval-expr-ok-necc
                   (expr (expr-app->arg expr))
                   (new-expr (expr-app->arg new-expr))
                   (limit (1- limit)))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-expr (expr-app->fun new-expr) new-denv (1- limit)))
                   (val (eval-expr (expr-app->fun expr) denv (1- limit))))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-expr (expr-app->arg new-expr) new-denv (1- limit)))
                   (val (eval-expr (expr-app->arg expr) denv (1- limit))))
        (:instance eval-app-ok-necc
                   (funval (eval-expr (expr-app->fun expr) denv (1- limit)))
                   (argvals (list (eval-expr (expr-app->arg expr) denv (1- limit))))
                   (limit (1- limit))
                   (new-funval (eval-expr (expr-app->fun new-expr) new-denv (1- limit)))
                   (new-argvals (list (eval-expr (expr-app->arg new-expr) new-denv (1- limit))))
                   (w (expr-value-alpha-equiv-p-witness
                       (eval-expr (expr-app->fun new-expr) new-denv (1- limit))
                       (eval-expr (expr-app->fun expr) denv (1- limit))))
                   (ws (list (expr-value-alpha-equiv-p-witness
                              (eval-expr (expr-app->arg new-expr) new-denv (1- limit))
                              (eval-expr (expr-app->arg expr) denv (1- limit))))))))

(defruled eval-expr-ok-when-app
  (implies (and (equal (expr-kind expr) :app)
                (eval-expr-ok (expr-app->fun expr) denv (1- limit))
                (implies (not (reserrp (eval-expr (expr-app->fun expr) denv (1- limit))))
                         (eval-expr-ok (expr-app->arg expr) denv (1- limit)))
                (implies (and (not (reserrp (eval-expr (expr-app->fun expr) denv (1- limit)))) (not (reserrp (eval-expr (expr-app->arg expr) denv (1- limit)))))
                         (eval-app-ok (eval-expr (expr-app->fun expr) denv (1- limit)) (list (eval-expr (expr-app->arg expr) denv (1- limit))) (1- limit))))
           (eval-expr-ok expr denv limit))
  :expand ((eval-expr-ok expr denv limit)
           (:free (new-x r) (expr-alpha-related-p new-x expr r)))
  :cases ((zp limit))
  :enable eval-expr-when-zp-limit
  :use ((:instance eval-expr-ok-when-app-aux
                   (new-expr (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                   (new-denv (mv-nth 1 (eval-expr-ok-witness expr denv limit)))
                   (r (mv-nth 2 (eval-expr-ok-witness expr denv limit)))
                   (dw (mv-nth 3 (eval-expr-ok-witness expr denv limit)))
                   (b (mv-nth 4 (eval-expr-ok-witness expr denv limit))))))

; Type applications: the relations at a type application, piecewise, and
; the evaluation of a type under the environment relations.

(defruled eval-type-alpha-of-expr-denvs
  (implies (and (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r ivars tvars evars)
                (set::subset (type-free-ispace-vars type) (ispace-var-set-fix ivars))
                (set::subset (type-free-type-vars type) (type-var-set-fix tvars))
                (type-fresh-ok type r))
           (b* ((tval (eval-type type (expr-denv->tenv denv)))
                (new-tval (eval-type (type-rename-all-vars type r)
                                     (expr-denv->tenv new-denv))))
             (and (equal (reserrp new-tval) (reserrp tval))
                  (implies (not (reserrp tval))
                           (type-value-alpha-related-via-p
                            new-tval tval
                            (eval-type-witness type r (denv-witness->types dw)))))))
  :expand ((expr-denv-alpha-related-via-p new-denv denv r dw)
           (expr-denv-alpha-avoided-p new-denv denv r ivars tvars evars)
           (:free (i tv) (type-denv-alpha-avoided-p (expr-denv->tenv new-denv)
                                                    (expr-denv->tenv denv) r i tv)))
  :enable (type-fresh-ok
           denv-ispace-vars-avoided-p-monotone
           type-var-map-avoided-p-monotone)
  :use ((:instance eval-type-alpha
                   (denv (expr-denv->tenv denv))
                   (new-denv (expr-denv->tenv new-denv))
                   (wmap (denv-witness->types dw)))))

(defruled expr-alpha-related-p-when-tapp
  (implies (and (equal (expr-kind expr) :tapp)
                (expr-alpha-related-p new-expr expr r))
           (and (equal (expr-kind new-expr) :tapp)
                (expr-alpha-related-p (expr-tapp->fun new-expr) (expr-tapp->fun expr) r)
                (equal (expr-tapp->arg new-expr)
                       (type-rename-all-vars (expr-tapp->arg expr) r))))
  :expand ((expr-alpha-related-p new-expr expr r)))

(defruled expr-alpha-fresh-p-when-tapp
  (implies (and (equal (expr-kind expr) :tapp)
