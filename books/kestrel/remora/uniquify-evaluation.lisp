;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Empty arrays: the value built from dimensions and an element type value
; relates, given a witness for the element type values, via the witness
; of the same shape.

(defruled expr-value-list-alpha-related-via-p-of-repeat
  (implies (expr-value-alpha-related-via-p new-val val w)
           (expr-value-list-alpha-related-via-p (repeat n new-val)
                                                (repeat n val)
                                                (repeat n w)))
  :induct (repeat n val)
  :enable (repeat expr-value-list-alpha-related-via-p))

(define with-empty-dim-witness ((dims nat-listp) (tw type-value-witness-p))
  :returns (w expr-value-witness-p)
  :short "Witness for the relation between two empty arrays of the same
          dimensions whose element type values are related via a witness."
  (b* (((when (not (consp dims))) (expr-value-witness-vempty tw))
       (dim (lnfix (car dims))))
    (if (= dim 0)
        (expr-value-witness-vempty tw)
      (expr-value-witness-vector
       (repeat dim (with-empty-dim-witness (cdr dims) tw))))))

(defruled expr-value-with-empty-dim-alpha
  (implies (type-value-alpha-related-via-p new-elem elem tw)
           (expr-value-alpha-related-via-p
            (expr-value-with-empty-dim dims new-elem)
            (expr-value-with-empty-dim dims elem)
            (with-empty-dim-witness dims tw)))
  :induct (expr-value-with-empty-dim dims elem)
  :enable (expr-value-with-empty-dim
           with-empty-dim-witness
           expr-value-list-alpha-related-via-p-of-repeat)
  :expand ((:free (a b c w)
            (expr-value-alpha-related-via-p a (expr-value-vector-empty b c) w))
           (:free (a b w)
            (expr-value-alpha-related-via-p a (expr-value-vector b) w))))

(defruled expr-value-with-empty-dim-alpha-equiv
  (implies (type-value-alpha-related-via-p new-elem elem tw)
           (expr-value-alpha-equiv-p (expr-value-with-empty-dim dims new-elem)
                                     (expr-value-with-empty-dim dims elem)))
  :use ((:instance expr-value-alpha-equiv-p-suff
                   (new-val (expr-value-with-empty-dim dims new-elem))
                   (val (expr-value-with-empty-dim dims elem))
                   (w (with-empty-dim-witness dims tw))))
  :enable expr-value-with-empty-dim-alpha)

; Expressions: the empty arrays and frames.

(defruled eval-expr-ok-when-array-empty
  (implies (equal (expr-kind expr) :array-empty)
           (eval-expr-ok expr denv limit))
  :expand ((eval-expr-ok expr denv limit)
           (:free (x d) (eval-expr x d limit))
           (:free (new-x r) (expr-alpha-related-p new-x expr r))
           (:free (new-x r b) (expr-alpha-fresh-p new-x expr r b))
           (expr-free-ispace-vars expr)
           (expr-free-type-vars expr)
           (expr-free-expr-vars expr))
  :enable (expr-denv-alpha-avoided-p
           type-denv-alpha-avoided-p
           expr-denv-alpha-related-via-p
           type-fresh-ok
           not-reserrp-when-expr-valuep
           type-value-kind-when-type-value-alpha-related-via-p
           expr-value-with-empty-dim-alpha-equiv)
  :use ((:instance eval-type-alpha
                   (type (expr-array-empty->type expr))
                   (denv (expr-denv->tenv denv))
                   (new-denv (expr-denv->tenv
                              (mv-nth 1 (eval-expr-ok-witness expr denv limit))))
                   (r (mv-nth 2 (eval-expr-ok-witness expr denv limit)))
                   (wmap (denv-witness->types
                          (mv-nth 3 (eval-expr-ok-witness expr denv limit)))))))

; Decomposing a related array type value: the element type values are
; related (via the element witness, or the leaf witness when the whole
; witness is a leaf), and the dimensions are equal.

(define type-value-witness-array-elem ((w type-value-witness-p))
  :returns (ew type-value-witness-p)
  (type-value-witness-case w
                           :array w.elem
                           :otherwise (type-value-witness-leaf)))

(defruled type-value-array-decompose-when-alpha-related
  (implies (and (type-value-alpha-related-via-p new-tval tval w)
                (type-value-case tval :array))
           (and (type-value-alpha-related-via-p
                 (type-value-array->elem new-tval)
                 (type-value-array->elem tval)
                 (type-value-witness-array-elem w))
                (equal (type-value-array->dims new-tval)
                       (type-value-array->dims tval))))
  :enable (type-value-witness-array-elem
           type-value-groundp-of-type-value-array->elem)
  :expand ((type-value-alpha-related-via-p new-tval tval w)))

(defruled eval-expr-ok-when-frame-empty
  (implies (equal (expr-kind expr) :frame-empty)
           (eval-expr-ok expr denv limit))
  :expand ((eval-expr-ok expr denv limit)
           (:free (x d) (eval-expr x d limit))
           (:free (new-x r) (expr-alpha-related-p new-x expr r))
           (:free (new-x r b) (expr-alpha-fresh-p new-x expr r b))
           (expr-free-ispace-vars expr)
           (expr-free-type-vars expr)
           (expr-free-expr-vars expr))
  :enable (expr-denv-alpha-avoided-p
           type-denv-alpha-avoided-p
           expr-denv-alpha-related-via-p
           type-fresh-ok
           not-reserrp-when-expr-valuep
           expr-value-with-empty-dim-alpha-equiv)
  :disable (type-value-witness-array-elem
            eval-type-witness
            type-rename-all-vars)
  :use ((:instance eval-type-alpha
                   (type (expr-frame-empty->type expr))
                   (denv (expr-denv->tenv denv))
                   (new-denv (expr-denv->tenv
                              (mv-nth 1 (eval-expr-ok-witness expr denv limit))))
                   (r (mv-nth 2 (eval-expr-ok-witness expr denv limit)))
                   (wmap (denv-witness->types
                          (mv-nth 3 (eval-expr-ok-witness expr denv limit)))))
        (:instance type-value-kind-when-type-value-alpha-related-via-p
                   (new-tval (eval-type (type-rename-all-vars
                                         (expr-frame-empty->type expr)
                                         (mv-nth 2 (eval-expr-ok-witness expr denv limit)))
                                        (expr-denv->tenv
                                         (mv-nth 1 (eval-expr-ok-witness expr denv limit)))))
                   (tval (eval-type (expr-frame-empty->type expr)
                                    (expr-denv->tenv denv)))
                   (w (eval-type-witness (expr-frame-empty->type expr)
                                         (mv-nth 2 (eval-expr-ok-witness expr denv limit))
                                         (denv-witness->types
                                          (mv-nth 3 (eval-expr-ok-witness expr denv limit))))))
        (:instance type-value-kind-when-type-value-alpha-related-via-p
                   (new-tval (type-value-array->elem (eval-type (type-rename-all-vars
                                         (expr-frame-empty->type expr)
                                         (mv-nth 2 (eval-expr-ok-witness expr denv limit)))
                                        (expr-denv->tenv
                                         (mv-nth 1 (eval-expr-ok-witness expr denv limit))))))
                   (tval (type-value-array->elem (eval-type (expr-frame-empty->type expr)
                                    (expr-denv->tenv denv))))
                   (w (type-value-witness-array-elem (eval-type-witness (expr-frame-empty->type expr)
                                         (mv-nth 2 (eval-expr-ok-witness expr denv limit))
                                         (denv-witness->types
                                          (mv-nth 3 (eval-expr-ok-witness expr denv limit)))))))
        (:instance type-value-array-decompose-when-alpha-related
                   (new-tval (eval-type (type-rename-all-vars
                                         (expr-frame-empty->type expr)
                                         (mv-nth 2 (eval-expr-ok-witness expr denv limit)))
                                        (expr-denv->tenv
                                         (mv-nth 1 (eval-expr-ok-witness expr denv limit)))))
                   (tval (eval-type (expr-frame-empty->type expr)
                                    (expr-denv->tenv denv)))
                   (w (eval-type-witness (expr-frame-empty->type expr)
                                         (mv-nth 2 (eval-expr-ok-witness expr denv limit))
                                         (denv-witness->types
                                          (mv-nth 3 (eval-expr-ok-witness expr denv limit))))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Combined applications.  The two optional instantiation stages are
; abstracted into functions, against which the evaluator's case is
; restated, so that the case lemma sees each stage as a unit and the
; case splits of the stages do not multiply.

(define capp-tstage ((funval expr-valuep)
                     (targs type-list-optionp)
                     (denv expr-denvp)
                     (limit natp))
  :returns (val expr-value-resultp)
  :verify-guards nil
  (type-list-option-case
   targs
   :some (eval-tappn funval targs.val denv limit)
   :none (expr-value-fix funval)))

(define capp-istage ((funval expr-valuep)
                     (iargs ispace-list-optionp)
                     (denv expr-denvp)
                     (limit natp))
  :returns (val expr-value-resultp)
  :verify-guards nil
  (ispace-list-option-case
   iargs
   :some (eval-iappn funval iargs.val denv limit)
   :none (expr-value-fix funval)))

(defruled eval-expr-when-capp
  (implies (and (equal (expr-kind expr) :capp)
                (not (zp limit)))
           (equal (eval-expr expr denv limit)
                  (b* (((ok funval) (eval-expr (expr-capp->fun expr)
                                               denv (1- limit)))
                       ((ok funval) (capp-tstage funval (expr-capp->targs expr)
                                                 denv (1- limit)))
                       ((ok funval) (capp-istage funval (expr-capp->iargs expr)
                                                 denv (1- limit)))
                       ((ok argvals) (eval-expr-list (expr-capp->args expr)
                                                     denv (1- limit))))
                    (eval-app funval argvals (1- limit)))))
  :expand ((eval-expr expr denv limit))
  :enable (capp-tstage capp-istage expr-valuep-when-result-not-error))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defruled capp-tstage-alpha
  (implies (and (expr-value-alpha-related-via-p new-funval funval w)
                (implies (type-list-option-case targs :some)
                         (eval-tappn-ok funval (type-list-option-some->val targs)
                                        denv limit))
                (type-list-option-fresh-ok targs r)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (type-list-option-free-ispace-vars targs)
                                           (type-list-option-free-type-vars targs)
                                           nil)
                (expr-value-wfp funval)
                (expr-value-wfp new-funval)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((val (capp-tstage funval targs denv limit))
                (new-val (capp-tstage new-funval
                                      (type-list-option-rename-all-vars targs r)
                                      new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :enable (capp-tstage
           type-list-option-rename-all-vars
           type-list-option-rename-ispace-vars
           type-list-option-rename-type-vars
           type-list-rename-all-vars
           type-list-option-fresh-ok
           type-list-option-free-ispace-vars
           type-list-option-free-type-vars
           not-reserrp-when-expr-valuep)
  :use ((:instance eval-tappn-ok-necc
                   (args (type-list-option-some->val targs)))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (expr-value-fix new-funval))
                   (val (expr-value-fix funval)))))

(defruled capp-istage-alpha
  (implies (and (expr-value-alpha-related-via-p new-funval funval w)
                (implies (ispace-list-option-case iargs :some)
                         (eval-iappn-ok funval (ispace-list-option-some->val iargs)
                                        denv limit))
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (ispace-list-option-free-ispace-vars iargs)
                                           nil
                                           nil)
                (expr-value-wfp funval)
                (expr-value-wfp new-funval)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((val (capp-istage funval iargs denv limit))
                (new-val (capp-istage new-funval
                                      (ispace-list-option-rename-ispace-vars
                                       iargs
                                       (var-renamings->dim r)
                                       (var-renamings->shape r))
                                      new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :enable (capp-istage
           ispace-list-option-rename-ispace-vars
           ispace-list-option-free-ispace-vars
           not-reserrp-when-expr-valuep)
  :use ((:instance eval-iappn-ok-necc
                   (args (ispace-list-option-some->val iargs)))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (expr-value-fix new-funval))
                   (val (expr-value-fix funval)))))

(defrule expr-value-wfp-of-capp-tstage
  (implies (and (expr-value-wfp funval)
                (expr-denv-wfp denv)
                (not (reserrp (capp-tstage funval targs denv limit))))
           (expr-value-wfp (capp-tstage funval targs denv limit)))
  :enable (capp-tstage expr-value-wfp-of-eval-tappn))

(defrule expr-value-wfp-of-capp-istage
  (implies (and (expr-value-wfp funval)
                (expr-denv-wfp denv)
                (not (reserrp (capp-istage funval iargs denv limit))))
           (expr-value-wfp (capp-istage funval iargs denv limit)))
  :enable (capp-istage expr-value-wfp-of-eval-iappn))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The function part of a combined application after its two optional
; instantiation stages, as a unit, so that the case lemma only sees two
; sub-evaluations (this unit and the argument list), exactly like the
; application cases; the unit's own lemma sees only the three-stage chain.

(define capp-funval ((expr exprp) (denv expr-denvp) (limit natp))
  :guard (expr-case expr :capp)
  :returns (val expr-value-resultp)
  :verify-guards nil
  (b* (((expr-capp expr) expr)
       ((ok funval) (eval-expr expr.fun denv limit))
       ((ok funval) (capp-tstage funval expr.targs denv limit)))
    (capp-istage funval expr.iargs denv limit)))

(defruled eval-expr-when-capp-funval
  (implies (and (equal (expr-kind expr) :capp)
                (not (zp limit)))
           (equal (eval-expr expr denv limit)
                  (b* (((ok funval) (capp-funval expr denv (1- limit)))
                       ((ok argvals) (eval-expr-list (expr-capp->args expr)
                                                     denv (1- limit))))
                    (eval-app funval argvals (1- limit)))))
  :use eval-expr-when-capp
  :enable capp-funval)

; The function part of a combined application under the relations: the
; function sub-expressions, and the type and ispace arguments.

(defruled expr-alpha-related-p-when-capp-funpart
  (implies (and (equal (expr-kind expr) :capp)
                (expr-alpha-related-p new-expr expr r))
           (and (equal (expr-kind new-expr) :capp)
                (expr-alpha-related-p (expr-capp->fun new-expr)
                                      (expr-capp->fun expr)
                                      r)
                (equal (expr-capp->targs new-expr)
                       (type-list-option-rename-all-vars (expr-capp->targs expr) r))
                (equal (expr-capp->iargs new-expr)
                       (ispace-list-option-rename-ispace-vars
                        (expr-capp->iargs expr)
                        (var-renamings->dim r)
                        (var-renamings->shape r)))))
  :expand ((expr-alpha-related-p new-expr expr r)))

(defruled expr-alpha-fresh-p-when-capp-funpart
  (implies (and (equal (expr-kind expr) :capp)
                (expr-alpha-related-p new-expr expr r)
                (expr-alpha-fresh-p new-expr expr r b))
           (and (expr-alpha-fresh-p (expr-capp->fun new-expr)
                                    (expr-capp->fun expr)
                                    r b)
                (type-list-option-fresh-ok (expr-capp->targs expr) r)))
  :expand ((expr-alpha-fresh-p new-expr expr r b))
  :use expr-alpha-related-p-when-capp-funpart)

(defruled expr-denv-alpha-avoided-p-of-capp-funpart
  (implies (and (equal (expr-kind expr) :capp)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-free-ispace-vars expr)
                                           (expr-free-type-vars expr)
                                           (expr-free-expr-vars expr)))
           (and (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-free-ispace-vars (expr-capp->fun expr))
                                           (expr-free-type-vars (expr-capp->fun expr))
                                           (expr-free-expr-vars (expr-capp->fun expr)))
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (type-list-option-free-ispace-vars
                                            (expr-capp->targs expr))
                                           (type-list-option-free-type-vars
                                            (expr-capp->targs expr))
                                           nil)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (ispace-list-option-free-ispace-vars
                                            (expr-capp->iargs expr))
                                           nil
                                           nil)))
  :expand ((expr-free-ispace-vars expr)
           (expr-free-type-vars expr)
           (expr-free-expr-vars expr))
  :enable (subset-of-union-right-1
           subset-of-union-right-2
           set::union-subset-x)
  :use ((:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (expr-free-ispace-vars expr))
                   (tvars2 (expr-free-type-vars expr))
                   (evars2 (expr-free-expr-vars expr))
                   (ivars1 (expr-free-ispace-vars (expr-capp->fun expr)))
                   (tvars1 (expr-free-type-vars (expr-capp->fun expr)))
                   (evars1 (expr-free-expr-vars (expr-capp->fun expr))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (expr-free-ispace-vars expr))
                   (tvars2 (expr-free-type-vars expr))
                   (evars2 (expr-free-expr-vars expr))
                   (ivars1 (type-list-option-free-ispace-vars (expr-capp->targs expr)))
                   (tvars1 (type-list-option-free-type-vars (expr-capp->targs expr)))
                   (evars1 nil))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (expr-free-ispace-vars expr))
                   (tvars2 (expr-free-type-vars expr))
                   (evars2 (expr-free-expr-vars expr))
                   (ivars1 (ispace-list-option-free-ispace-vars (expr-capp->iargs expr)))
                   (tvars1 nil)
                   (evars1 nil))))

(defruled capp-funval-alpha
  (implies (and (equal (expr-kind expr) :capp)
                (eval-expr-ok (expr-capp->fun expr) denv limit)
                (implies (and (not (reserrp (eval-expr (expr-capp->fun expr) denv limit)))
                              (type-list-option-case (expr-capp->targs expr) :some))
                         (eval-tappn-ok (eval-expr (expr-capp->fun expr) denv limit)
                                        (type-list-option-some->val (expr-capp->targs expr))
                                        denv limit))
                (implies (and (not (reserrp (eval-expr (expr-capp->fun expr) denv limit)))
                              (not (reserrp (capp-tstage (eval-expr (expr-capp->fun expr) denv limit)
                                                         (expr-capp->targs expr) denv limit)))
                              (ispace-list-option-case (expr-capp->iargs expr) :some))
                         (eval-iappn-ok (capp-tstage (eval-expr (expr-capp->fun expr) denv limit)
                                                     (expr-capp->targs expr) denv limit)
                                        (ispace-list-option-some->val (expr-capp->iargs expr))
                                        denv limit))
                (expr-alpha-related-p new-expr expr r)
                (expr-alpha-fresh-p new-expr expr r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-free-ispace-vars expr)
                                           (expr-free-type-vars expr)
                                           (expr-free-expr-vars expr))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((val (capp-funval expr denv limit))
                (new-val (capp-funval new-expr new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :enable (capp-funval
           expr-value-wfp-of-eval-expr
           expr-value-wfp-of-capp-tstage
           not-reserrp-when-expr-valuep
           expr-valuep-when-result-not-error)
  :use (expr-alpha-related-p-when-capp-funpart
        expr-alpha-fresh-p-when-capp-funpart
        expr-denv-alpha-avoided-p-of-capp-funpart
        (:instance eval-expr-ok-necc
                   (expr (expr-capp->fun expr))
                   (new-expr (expr-capp->fun new-expr)))
        (:instance expr-value-alpha-equiv-p
                   (new-val (eval-expr (expr-capp->fun new-expr) new-denv limit))
                   (val (eval-expr (expr-capp->fun expr) denv limit)))
        (:instance capp-tstage-alpha
                   (funval (eval-expr (expr-capp->fun expr) denv limit))
                   (new-funval (eval-expr (expr-capp->fun new-expr) new-denv limit))
                   (w (expr-value-alpha-equiv-p-witness
                       (eval-expr (expr-capp->fun new-expr) new-denv limit)
                       (eval-expr (expr-capp->fun expr) denv limit)))
                   (targs (expr-capp->targs expr)))
        (:instance expr-value-alpha-equiv-p
                   (new-val (capp-tstage (eval-expr (expr-capp->fun new-expr) new-denv limit)
                                         (type-list-option-rename-all-vars
                                          (expr-capp->targs expr) r)
                                         new-denv limit))
                   (val (capp-tstage (eval-expr (expr-capp->fun expr) denv limit)
                                     (expr-capp->targs expr) denv limit)))
        (:instance capp-istage-alpha
                   (funval (capp-tstage (eval-expr (expr-capp->fun expr) denv limit)
                                        (expr-capp->targs expr) denv limit))
                   (new-funval (capp-tstage (eval-expr (expr-capp->fun new-expr) new-denv limit)
                                            (type-list-option-rename-all-vars
                                             (expr-capp->targs expr) r)
                                            new-denv limit))
                   (w (expr-value-alpha-equiv-p-witness
                       (capp-tstage (eval-expr (expr-capp->fun new-expr) new-denv limit)
                                    (type-list-option-rename-all-vars
                                     (expr-capp->targs expr) r)
                                    new-denv limit)
                       (capp-tstage (eval-expr (expr-capp->fun expr) denv limit)
                                    (expr-capp->targs expr) denv limit)))
                   (iargs (expr-capp->iargs expr)))))

(defrule expr-value-wfp-of-capp-funval
  (implies (and (expr-denv-wfp denv)
                (not (reserrp (capp-funval expr denv limit))))
           (expr-value-wfp (capp-funval expr denv limit)))
  :enable (capp-funval
           expr-value-wfp-of-eval-expr
           expr-value-wfp-of-capp-tstage
           expr-value-wfp-of-capp-istage
           expr-valuep-when-result-not-error))

; The argument list of a combined application under the relations.

(defruled expr-alpha-related-p-when-capp
  (implies (and (equal (expr-kind expr) :capp)
                (expr-alpha-related-p new-expr expr r))
           (and (equal (expr-kind new-expr) :capp)
                (expr-list-alpha-related-p (expr-capp->args new-expr)
                                           (expr-capp->args expr)
                                           r)))
  :expand ((expr-alpha-related-p new-expr expr r)))

(defruled expr-alpha-fresh-p-when-capp
  (implies (and (equal (expr-kind expr) :capp)
                (expr-alpha-related-p new-expr expr r)
                (expr-alpha-fresh-p new-expr expr r b))
           (expr-list-alpha-fresh-p (expr-capp->args new-expr)
                                    (expr-capp->args expr)
                                    r b))
  :expand ((expr-alpha-fresh-p new-expr expr r b))
  :use expr-alpha-related-p-when-capp)

; The failure-direction relation at the free variables of a combined
; application carries over to its argument list.

(defruled expr-denv-alpha-avoided-p-of-capp-args
  (implies (and (equal (expr-kind expr) :capp)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-free-ispace-vars expr)
                                           (expr-free-type-vars expr)
                                           (expr-free-expr-vars expr)))
           (expr-denv-alpha-avoided-p new-denv denv r
                                      (expr-list-free-ispace-vars (expr-capp->args expr))
                                      (expr-list-free-type-vars (expr-capp->args expr))
                                      (expr-list-free-expr-vars (expr-capp->args expr))))
  :expand ((expr-free-ispace-vars expr)
           (expr-free-type-vars expr)
           (expr-free-expr-vars expr))
  :enable (subset-of-union-right-1
           subset-of-union-right-2
           set::union-subset-x)
  :use ((:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (expr-free-ispace-vars expr))
                   (tvars2 (expr-free-type-vars expr))
                   (evars2 (expr-free-expr-vars expr))
                   (ivars1 (expr-list-free-ispace-vars (expr-capp->args expr)))
                   (tvars1 (expr-list-free-type-vars (expr-capp->args expr)))
                   (evars1 (expr-list-free-expr-vars (expr-capp->args expr))))))

(defruled eval-expr-ok-when-capp-aux
  (implies (and (equal (expr-kind expr) :capp)
                (not (zp limit))
                (eval-expr-ok (expr-capp->fun expr) denv (1- limit))
                (implies (and (not (reserrp (eval-expr (expr-capp->fun expr) denv (1- limit))))
                              (type-list-option-case (expr-capp->targs expr) :some))
                         (eval-tappn-ok (eval-expr (expr-capp->fun expr) denv (1- limit))
                                        (type-list-option-some->val (expr-capp->targs expr))
                                        denv (1- limit)))
                (implies (and (not (reserrp (eval-expr (expr-capp->fun expr) denv (1- limit))))
                              (not (reserrp (capp-tstage (eval-expr (expr-capp->fun expr) denv (1- limit))
                                                         (expr-capp->targs expr) denv (1- limit))))
                              (ispace-list-option-case (expr-capp->iargs expr) :some))
                         (eval-iappn-ok (capp-tstage (eval-expr (expr-capp->fun expr) denv (1- limit))
                                                     (expr-capp->targs expr) denv (1- limit))
                                        (ispace-list-option-some->val (expr-capp->iargs expr))
                                        denv (1- limit)))
                (implies (not (reserrp (capp-funval expr denv (1- limit))))
                         (eval-expr-list-ok (expr-capp->args expr) denv (1- limit)))
                (implies (and (not (reserrp (capp-funval expr denv (1- limit))))
                              (not (reserrp (eval-expr-list (expr-capp->args expr) denv (1- limit)))))
                         (eval-app-ok (capp-funval expr denv (1- limit))
                                      (eval-expr-list (expr-capp->args expr) denv (1- limit))
                                      (1- limit)))
                (expr-alpha-related-p new-expr expr r)
                (expr-alpha-fresh-p new-expr expr r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (expr-free-ispace-vars expr)
                                           (expr-free-type-vars expr)
                                           (expr-free-expr-vars expr))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((val (eval-expr expr denv limit))
                (new-val (eval-expr new-expr new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :enable (eval-expr-when-capp-funval
           expr-value-list-wfp-of-eval-expr-list
           not-reserrp-when-expr-valuep
           not-reserrp-when-expr-value-listp
           expr-valuep-when-result-not-error
           expr-value-listp-when-result-not-error)
  :use (expr-alpha-related-p-when-capp
        expr-alpha-fresh-p-when-capp
        (:instance capp-funval-alpha (limit (1- limit)))
        (:instance expr-value-alpha-equiv-p
                   (new-val (capp-funval new-expr new-denv (1- limit)))
                   (val (capp-funval expr denv (1- limit))))
        expr-denv-alpha-avoided-p-of-capp-args
        (:instance eval-expr-list-ok-necc
                   (exprs (expr-capp->args expr))
                   (new-exprs (expr-capp->args new-expr))
                   (limit (1- limit)))
        (:instance expr-value-list-alpha-equiv-p
                   (new-vals (eval-expr-list (expr-capp->args new-expr) new-denv (1- limit)))
                   (vals (eval-expr-list (expr-capp->args expr) denv (1- limit))))
        (:instance eval-app-ok-necc
                   (funval (capp-funval expr denv (1- limit)))
                   (argvals (eval-expr-list (expr-capp->args expr) denv (1- limit)))
                   (limit (1- limit))
                   (new-funval (capp-funval new-expr new-denv (1- limit)))
                   (new-argvals (eval-expr-list (expr-capp->args new-expr) new-denv (1- limit)))
                   (w (expr-value-alpha-equiv-p-witness
                       (capp-funval new-expr new-denv (1- limit))
                       (capp-funval expr denv (1- limit))))
                   (ws (expr-value-list-alpha-equiv-p-witness
                        (eval-expr-list (expr-capp->args new-expr) new-denv (1- limit))
                        (eval-expr-list (expr-capp->args expr) denv (1- limit)))))))

(defruled eval-expr-ok-when-capp
  (implies (and (equal (expr-kind expr) :capp)
                (eval-expr-ok (expr-capp->fun expr) denv (1- limit))
                (implies (and (not (reserrp (eval-expr (expr-capp->fun expr) denv (1- limit))))
                              (type-list-option-case (expr-capp->targs expr) :some))
                         (eval-tappn-ok (eval-expr (expr-capp->fun expr) denv (1- limit))
                                        (type-list-option-some->val (expr-capp->targs expr))
                                        denv (1- limit)))
                (implies (and (not (reserrp (eval-expr (expr-capp->fun expr) denv (1- limit))))
                              (not (reserrp (capp-tstage (eval-expr (expr-capp->fun expr) denv (1- limit))
                                                         (expr-capp->targs expr) denv (1- limit))))
                              (ispace-list-option-case (expr-capp->iargs expr) :some))
                         (eval-iappn-ok (capp-tstage (eval-expr (expr-capp->fun expr) denv (1- limit))
                                                     (expr-capp->targs expr) denv (1- limit))
                                        (ispace-list-option-some->val (expr-capp->iargs expr))
                                        denv (1- limit)))
                (implies (not (reserrp (capp-funval expr denv (1- limit))))
                         (eval-expr-list-ok (expr-capp->args expr) denv (1- limit)))
                (implies (and (not (reserrp (capp-funval expr denv (1- limit))))
                              (not (reserrp (eval-expr-list (expr-capp->args expr) denv (1- limit)))))
                         (eval-app-ok (capp-funval expr denv (1- limit))
                                      (eval-expr-list (expr-capp->args expr) denv (1- limit))
                                      (1- limit))))
           (eval-expr-ok expr denv limit))
  :expand ((eval-expr-ok expr denv limit)
           (:free (new-x r) (expr-alpha-related-p new-x expr r)))
  :cases ((zp limit))
  :enable eval-expr-when-zp-limit
  :use ((:instance eval-expr-ok-when-capp-aux
                   (new-expr (mv-nth 0 (eval-expr-ok-witness expr denv limit)))
                   (new-denv (mv-nth 1 (eval-expr-ok-witness expr denv limit)))
                   (r (mv-nth 2 (eval-expr-ok-witness expr denv limit)))
                   (dw (mv-nth 3 (eval-expr-ok-witness expr denv limit)))
                   (b (mv-nth 4 (eval-expr-ok-witness expr denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Anti-monotonicity of the freshness predicates in the support set: what
; is fresh with respect to a larger set is fresh with respect to a
; smaller one.  Stated with the larger set as a union with a fixed extra
; set, so that the flag induction on the predicates carries the extra set
; along unchanged.

(defruled union-commutes-under-union
  (equal (set::union x (set::union y z))
         (set::union y (set::union x z)))
  :enable (set::pick-a-point-subset-strategy set::double-containment
           set::subset-in set::union-in))

(defruled name-fresh-ok-of-union
  (implies (and (string-setp s)
                (name-fresh-ok name new-name m (set::union s (string-sfix b))))
           (name-fresh-ok name new-name m b))
  :enable name-fresh-ok)

(defruled string-list-fresh-ok-of-union
  (implies (and (string-setp s)
                (string-list-fresh-ok names new-names m
                                      (set::union s (string-sfix b))))
           (string-list-fresh-ok names new-names m b))
  :induct (string-list-fresh-ok names new-names m b)
  :enable (string-list-fresh-ok name-fresh-ok-of-union))

(defruled type-var-list-fresh-ok-of-union
  (implies (and (string-setp s)
                (type-var-list-fresh-ok new-vars vars atom-renam array-renam
                                        (set::union s (string-sfix b))))
           (type-var-list-fresh-ok new-vars vars atom-renam array-renam b))
  :induct (type-var-list-fresh-ok new-vars vars atom-renam array-renam b)
  :enable (type-var-list-fresh-ok name-fresh-ok-of-union))

(defruled ispace-var-list-fresh-ok-of-union
  (implies (and (string-setp s)
                (ispace-var-list-fresh-ok new-vars vars dim-renam shape-renam
                                          (set::union s (string-sfix b))))
           (ispace-var-list-fresh-ok new-vars vars dim-renam shape-renam b))
  :induct (ispace-var-list-fresh-ok new-vars vars dim-renam shape-renam b)
  :enable (ispace-var-list-fresh-ok name-fresh-ok-of-union))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The support sets of the layers of a combined function bind (see
; CFUN-LAYER-SUPPORT in the relations book): a present layer replaces the
; incoming support set, an absent one passes it through, so a union in the
; incoming set either disappears or passes through.

(defruled cfun-layer-support-when-not-consp
  (implies (not (consp params))
           (equal (cfun-layer-support params new-names body r bset)
                  (string-sfix bset)))
  :enable cfun-layer-support)

(defruled cfun-layer-support-of-union
  (implies (string-setp s)
           (equal (cfun-layer-support params new-names body r
                                      (set::union s (string-sfix bset)))
                  (if (consp params)
                      (cfun-layer-support params new-names body r bset)
                    (set::union s (string-sfix bset)))))
  :enable cfun-layer-support)

(defthm-exprs-alpha-fresh-p-flag
  (defthm expr-alpha-fresh-p-of-union
    (implies (and (string-setp s)
                  (expr-alpha-fresh-p new-x x r (set::union s (string-sfix b))))
             (expr-alpha-fresh-p new-x x r b))
    :flag expr-alpha-fresh-p)
  (defthm expr-list-alpha-fresh-p-of-union
    (implies (and (string-setp s)
                  (expr-list-alpha-fresh-p new-x x r (set::union s (string-sfix b))))
             (expr-list-alpha-fresh-p new-x x r b))
    :flag expr-list-alpha-fresh-p)
  (defthm atom-alpha-fresh-p-of-union
    (implies (and (string-setp s)
                  (atom-alpha-fresh-p new-a a r (set::union s (string-sfix b))))
             (atom-alpha-fresh-p new-a a r b))
    :flag atom-alpha-fresh-p)
  (defthm atom-list-alpha-fresh-p-of-union
    (implies (and (string-setp s)
                  (atom-list-alpha-fresh-p new-a a r (set::union s (string-sfix b))))
             (atom-list-alpha-fresh-p new-a a r b))
    :flag atom-list-alpha-fresh-p)
  (defthm bind-alpha-fresh-p-of-union
    (implies (and (string-setp s)
                  (bind-alpha-fresh-p new-b b r (set::union s (string-sfix bset))))
             (bind-alpha-fresh-p new-b b r bset))
    :flag bind-alpha-fresh-p)
  (defthm bind-list-alpha-fresh-p-of-union
    (implies (and (string-setp s)
                  (bind-list-alpha-fresh-p new-b b r (set::union s (string-sfix bset))))
             (bind-list-alpha-fresh-p new-b b r bset))
    :flag bind-list-alpha-fresh-p)
  :hints (("Goal"
           :expand ((:free (b) (expr-alpha-fresh-p new-x x r b))
                    (:free (b) (expr-list-alpha-fresh-p new-x x r b))
                    (:free (b) (atom-alpha-fresh-p new-a a r b))
                    (:free (b) (atom-list-alpha-fresh-p new-a a r b))
                    (:free (bset) (bind-alpha-fresh-p new-b b r bset))
                    (:free (bset) (bind-list-alpha-fresh-p new-b b r bset)))
           :in-theory (e/d (name-fresh-ok-of-union
                              string-list-fresh-ok-of-union
                              type-var-list-fresh-ok-of-union
                              ispace-var-list-fresh-ok-of-union
                              union-commutes-under-union
                              cfun-layer-support-when-not-consp
                              cfun-layer-support-of-union)
                           (no-duplicatesp-equal-when-no-duplicatesp-equal-of-type-var-list->name
                            no-duplicatesp-equal-when-no-duplicatesp-equal-of-ispace-var-list->name
                            no-duplicatesp-equal-when-not-duplicated-names
                            duplicated-names-when-no-duplicatesp-equal
                            member-equal-of-type-var-list->name-when-member-equal
                            member-equal-of-ispace-var-list->name-when-member-equal
                            member-equal
                            acl2::subsetp-car-member)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The subset form.

(defruled expr-alpha-fresh-p-anti-monotone
  (implies (and (expr-alpha-fresh-p new-x x r b2)
                (set::subset (string-sfix b1) (string-sfix b2)))
           (expr-alpha-fresh-p new-x x r b1))
  :use ((:instance expr-alpha-fresh-p-of-union
                   (s (string-sfix b2)) (b b1)))
  :enable set::union-with-subset-right)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; A kept variable (one whose name is not a key of its namespace's
; renaming map) is renamed to itself, so its name is among the names of
; the renamed set.

(defruled in-of-rename-var-string-set-when-not-assoc
  (implies (and (set::in name (string-sfix names))
                (not (omap::assoc name (string-string-map-fix renam))))
           (set::in name (rename-var-string-set names renam)))
  :use ((:instance in-of-rename-var-string-of-rename-var-string-set
                   (x name) (vars names)))
  :enable rename-var-string)

; Variable-level forms: a kept variable is in the renamed set as itself.

(defruled in-rename-ispace-vars-when-dim-kept
  (implies (and (stringp name)
                (ispace-var-setp vars)
                (set::in (ispace-var-dim name) vars)
                (not (omap::assoc name (string-string-map-fix dim-renam))))
           (set::in (ispace-var-dim name)
                    (ispace-var-set-rename-ispace-vars vars dim-renam shape-renam)))
  :use ((:instance in-of-rename-ispace-var-of-ispace-var-set-rename-ispace-vars
                   (var (ispace-var-dim name))
                   (vars vars)))
  :enable (rename-ispace-var rename-var-string))

(defruled in-rename-ispace-vars-when-shape-kept
  (implies (and (stringp name)
                (ispace-var-setp vars)
                (set::in (ispace-var-shape name) vars)
                (not (omap::assoc name (string-string-map-fix shape-renam))))
           (set::in (ispace-var-shape name)
                    (ispace-var-set-rename-ispace-vars vars dim-renam shape-renam)))
  :use ((:instance in-of-rename-ispace-var-of-ispace-var-set-rename-ispace-vars
                   (var (ispace-var-shape name))
                   (vars vars)))
  :enable (rename-ispace-var rename-var-string))

(defruled in-rename-type-vars-when-atom-kept
  (implies (and (stringp name)
                (type-var-setp vars)
                (set::in (type-var-atom name) vars)
                (not (omap::assoc name (string-string-map-fix atom-renam))))
           (set::in (type-var-atom name)
                    (type-var-set-rename-type-vars vars atom-renam array-renam)))
  :use ((:instance in-of-rename-type-var-of-type-var-set-rename-type-vars
                   (var (type-var-atom name))
                   (vars vars)))
  :enable (rename-type-var rename-var-string))

(defruled in-rename-type-vars-when-array-kept
  (implies (and (stringp name)
                (type-var-setp vars)
                (set::in (type-var-array name) vars)
                (not (omap::assoc name (string-string-map-fix array-renam))))
           (set::in (type-var-array name)
                    (type-var-set-rename-type-vars vars atom-renam array-renam)))
  :use ((:instance in-of-rename-type-var-of-type-var-set-rename-type-vars
                   (var (type-var-array name))
                   (vars vars)))
  :enable (rename-type-var rename-var-string))

; Hence the keys of an environment restricted to some variable sets are
; supported by the names of those sets' renamings: each key is either a
; key of its renaming map or a kept name.

(defruled string-set-supported-p-by-rename-var-string-set
  (implies (and (string-setp keys)
                (set::subset keys (string-sfix names)))
           (string-set-supported-p keys renam (rename-var-string-set names renam)))
  :enable (string-set-supported-p
           set::pick-a-point-subset-strategy
           set::subset-in
           in-of-rename-var-string-set-when-not-assoc
           omap::assoc-to-in-of-keys))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The per-kind forms, from the membership characterizations of the name
; sets of variable sets.

(defruled dim-names-supported-p-by-names-of-rename-ispace-vars
  (implies (and (ispace-var-setp keys)
                (ispace-var-setp vars)
                (set::subset keys vars))
           (string-set-supported-p
            (mv-nth 0 (dim/shape-names-of-ispace-vars keys))
            dim-renam
            (ispace-var-set-names
             (ispace-var-set-rename-ispace-vars vars dim-renam shape-renam))))
  :enable (string-set-supported-p
           set::pick-a-point-subset-strategy
           set::subset-in
           in-rename-ispace-vars-when-dim-kept
           omap::assoc-to-in-of-keys))

(defruled shape-names-supported-p-by-names-of-rename-ispace-vars
  (implies (and (ispace-var-setp keys)
                (ispace-var-setp vars)
                (set::subset keys vars))
           (string-set-supported-p
            (mv-nth 1 (dim/shape-names-of-ispace-vars keys))
            shape-renam
            (ispace-var-set-names
             (ispace-var-set-rename-ispace-vars vars dim-renam shape-renam))))
  :enable (string-set-supported-p
           set::pick-a-point-subset-strategy
           set::subset-in
           in-rename-ispace-vars-when-shape-kept
           omap::assoc-to-in-of-keys))

(defruled atom-names-supported-p-by-names-of-rename-type-vars
  (implies (and (type-var-setp keys)
                (type-var-setp vars)
                (set::subset keys vars))
           (string-set-supported-p
            (mv-nth 0 (atom/array-names-of-type-vars keys))
            atom-renam
            (type-var-set-names
             (type-var-set-rename-type-vars vars atom-renam array-renam))))
  :enable (string-set-supported-p
           set::pick-a-point-subset-strategy
           set::subset-in
           in-rename-type-vars-when-atom-kept
           omap::assoc-to-in-of-keys))

(defruled array-names-supported-p-by-names-of-rename-type-vars
  (implies (and (type-var-setp keys)
                (type-var-setp vars)
                (set::subset keys vars))
           (string-set-supported-p
            (mv-nth 1 (atom/array-names-of-type-vars keys))
            array-renam
            (type-var-set-names
             (type-var-set-rename-type-vars vars atom-renam array-renam))))
  :enable (string-set-supported-p
           set::pick-a-point-subset-strategy
           set::subset-in
           in-rename-type-vars-when-array-kept
           omap::assoc-to-in-of-keys))

(defruled subset-of-intersect-when-subset
  (implies (set::subset x z)
           (set::subset (set::intersect x y) z))
  :use ((:instance set::subset-transitive
                   (x (set::intersect x y)) (y x) (z z))))

; The keys of a restricted environment are supported, under any
; renamings, by the support names of any body whose free variables
; include the restriction sets.

(defruled expr-denv-keys-supported-p-of-restrict-by-support-names
  (implies (and (expr-denv-wfp denv)
                (set::subset (ispace-var-set-fix ivars)
                             (expr-free-ispace-vars body))
                (set::subset (type-var-set-fix tvars)
                             (expr-free-type-vars body))
                (set::subset (string-sfix evars)
                             (expr-free-expr-vars body)))
           (expr-denv-keys-supported-p
            (expr-denv-restrict ivars tvars evars denv)
            r
            (expr-body-support-names body r)))
  :enable (expr-denv-keys-supported-p
           expr-body-support-names
           expr-denv-restrict
           type-denv-restrict
           ispace-denv-restrict
           omap::keys-of-restrict
           string-set-supported-p-monotone
           subset-of-union-right-1
           subset-of-union-right-2
           subset-of-intersect-when-subset)
  :use ((:instance dim-names-supported-p-by-names-of-rename-ispace-vars
                   (keys (set::intersect
                          (ispace-var-set-fix ivars)
                          (omap::keys (ispace-denv->ispaces
                                       (type-denv->ienv (expr-denv->tenv denv))))))
                   (vars (expr-free-ispace-vars body))
                   (dim-renam (var-renamings->dim r))
                   (shape-renam (var-renamings->shape r)))
        (:instance shape-names-supported-p-by-names-of-rename-ispace-vars
                   (keys (set::intersect
                          (ispace-var-set-fix ivars)
                          (omap::keys (ispace-denv->ispaces
                                       (type-denv->ienv (expr-denv->tenv denv))))))
                   (vars (expr-free-ispace-vars body))
                   (dim-renam (var-renamings->dim r))
                   (shape-renam (var-renamings->shape r)))
        (:instance atom-names-supported-p-by-names-of-rename-type-vars
                   (keys (set::intersect
                          (type-var-set-fix tvars)
                          (omap::keys (type-denv->types (expr-denv->tenv denv)))))
                   (vars (expr-free-type-vars body))
                   (atom-renam (var-renamings->atom r))
                   (array-renam (var-renamings->array r)))
        (:instance array-names-supported-p-by-names-of-rename-type-vars
                   (keys (set::intersect
                          (type-var-set-fix tvars)
                          (omap::keys (type-denv->types (expr-denv->tenv denv)))))
                   (vars (expr-free-type-vars body))
                   (atom-renam (var-renamings->atom r))
                   (array-renam (var-renamings->array r)))
        (:instance string-set-supported-p-by-rename-var-string-set
                   (keys (set::intersect (string-sfix evars)
                                         (omap::keys (expr-denv->exprs denv))))
                   (names (expr-free-expr-vars body))
                   (renam (var-renamings->expr r)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Atoms: closure creation.  The evaluation of the pieces that all the
; closure-creating atoms share: the optional result type, and a parameter
; with its optional type, each related to its renamed counterpart via the
; type-evaluation witness.

(defruled eval-atom-when-zp-limit
  (implies (zp limit)
           (equal (eval-atom atom denv limit)
                  (reserr :limit)))
  :expand ((eval-atom atom denv limit)))

(define eval-type-option ((type? type-optionp) (tenv type-denvp))
  :verify-guards nil
  (type-option-case type?
                    :none nil
                    :some (eval-type type?.val tenv)))

(defrule type-value-optionp-of-eval-type-option
  (implies (not (reserrp (eval-type-option type? tenv)))
           (type-value-optionp (eval-type-option type? tenv)))
  :enable (eval-type-option type-valuep-when-result-not-error)
  :use ((:instance type-valuep-when-result-not-error
                   (x (eval-type (type-option-some->val type?) tenv)))))

(defruled eval-atom-when-lambda
  (implies (and (equal (atom-kind atom) :lambda)
                (not (zp limit)))
           (equal (eval-atom atom denv limit)
                  (b* (((ok param) (eval-var+type? (atom-lambda->param atom)
                                                   (expr-denv->tenv denv)))
                       ((ok type?) (eval-type-option (atom-lambda->type? atom)
                                                     (expr-denv->tenv denv))))
                    (make-expr-value-lambda
                     :param param
                     :body (atom-lambda->body atom)
                     :type? type?
                     :denv (expr-denv-restrict
                            (expr-free-ispace-vars (atom-lambda->body atom))
                            (expr-free-type-vars (atom-lambda->body atom))
                            (atom-free-expr-vars atom)
                            denv)))))
  :expand ((eval-atom atom denv limit))
  :enable eval-type-option)

; The evaluation of a type is a type value or an error, hence never nil;
; stated as a type prescription, since the optional type values treat nil
; as the absent value.

(defrule consp-of-eval-type
  (consp (eval-type ty tenv))
  :rule-classes :type-prescription
  :use ((:instance return-type-of-eval-type.tval (type ty) (denv tenv)))
  :enable type-value-resultp)

(defruled type-value-option-some->val-when-type-valuep
  (implies (type-valuep x)
           (equal (type-value-option-some->val x) x))
  :enable type-value-option-some->val)

(defruled eval-type-option-alpha
  (implies (and (type-option-fresh-ok type? r)
                (type-denv-alpha-related-via-p new-tenv tenv r wmap)
                (type-denv-alpha-avoided-p new-tenv tenv r
                                           (type-option-free-ispace-vars type?)
                                           (type-option-free-type-vars type?)))
           (b* ((val (eval-type-option type? tenv))
                (new-val (eval-type-option (type-option-rename-all-vars type? r)
                                           new-tenv)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (type-value-option-alpha-related-via-p
                            new-val val
                            (eval-type-witness (type-option-some->val type?)
                                               r wmap))))))
  :enable (eval-type-option
           type-option-rename-all-vars
           type-option-rename-ispace-vars
           type-option-rename-type-vars
           type-rename-all-vars
           type-option-some->val-when-typep
           type-value-option-some->val-when-type-valuep
           type-valuep-when-result-not-error
           type-option-fresh-ok
           type-option-free-ispace-vars
           type-option-free-type-vars
           type-denv-alpha-avoided-p
           type-fresh-ok
           type-value-option-alpha-related-via-p)
  :use ((:instance eval-type-alpha
                   (type (type-option-some->val type?))
                   (denv tenv)
                   (new-denv new-tenv))
        (:instance type-valuep-when-result-not-error
                   (x (eval-type (type-option-some->val type?) tenv)))
        (:instance type-valuep-when-result-not-error
                   (x (eval-type (type-rename-all-vars
                                  (type-option-some->val type?) r)
                                 new-tenv)))))

; An optional type annotation is never an error value.

(defruled not-reserrp-of-var+type?->type?
  (not (reserrp (var+type?->type? vt)))
  :use ((:instance not-reserrp-when-typep (x (var+type?->type? vt))))
  :cases ((var+type?->type? vt)))

(defruled eval-var+type?-alpha
  (implies (and (equal (var+type?->type? new-vt)
                       (type-option-rename-all-vars (var+type?->type? vt) r))
                (type-option-fresh-ok (var+type?->type? vt) r)
                (type-denv-alpha-related-via-p new-tenv tenv r wmap)
                (type-denv-alpha-avoided-p
                 new-tenv tenv r
                 (type-option-free-ispace-vars (var+type?->type? vt))
                 (type-option-free-type-vars (var+type?->type? vt))))
           (b* ((val (eval-var+type? vt tenv))
                (new-val (eval-var+type? new-vt new-tenv)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (and (equal (var+typevalue->var new-val)
                                       (var+type?->var new-vt))
                                (equal (var+typevalue->var val)
                                       (var+type?->var vt))
                                (type-value-alpha-related-via-p
                                 (var+typevalue->type new-val)
                                 (var+typevalue->type val)
                                 (eval-type-witness
                                  (type-option-some->val (var+type?->type? vt))
                                  r wmap)))))))
  :enable (eval-var+type?
           var+type?->type-or-err
           not-reserrp-of-var+type?->type?
           not-reserrp-when-var+typevalue-p
           type-option-rename-all-vars
           type-option-rename-ispace-vars
           type-option-rename-type-vars
           type-rename-all-vars
           type-option-some->val-when-typep
           type-value-option-some->val-when-type-valuep
           type-valuep-when-result-not-error
           type-option-fresh-ok
           type-option-free-ispace-vars
           type-option-free-type-vars
           type-denv-alpha-avoided-p
           type-fresh-ok)
  :use ((:instance eval-type-alpha
                   (type (type-option-some->val (var+type?->type? vt)))
                   (denv tenv)
                   (new-denv new-tenv))
        (:instance type-valuep-when-result-not-error
                   (x (eval-type (type-option-some->val (var+type?->type? vt))
                                 tenv)))
        (:instance type-valuep-when-result-not-error
                   (x (eval-type (type-rename-all-vars
                                  (type-option-some->val (var+type?->type? vt))
                                  r)
                                 new-tenv)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The captured environment of a unary term lambda: the restrictions of
; related environments to the free variables of the bodies are related,
; the original one is within its restriction sets, and the avoidance
; carries over.  The new-side restriction sets are the images of the
; original ones by the free-variable image lemmas.

(defruled lambda-closure-denv-alpha
  (implies (and (equal (atom-kind atom) :lambda)
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-free-ispace-vars atom)
                                           (atom-free-type-vars atom)
                                           (atom-free-expr-vars atom))
                (expr-denv-wfp denv))
           (b* ((ivars (expr-free-ispace-vars (atom-lambda->body atom)))
                (tvars (expr-free-type-vars (atom-lambda->body atom)))
                (evars (atom-free-expr-vars atom))
                (cdenv (expr-denv-restrict ivars tvars evars denv))
                (new-cdenv (expr-denv-restrict
                            (expr-free-ispace-vars (atom-lambda->body new-atom))
                            (expr-free-type-vars (atom-lambda->body new-atom))
                            (atom-free-expr-vars new-atom)
                            new-denv)))
             (and (expr-denv-alpha-related-via-p new-cdenv cdenv r dw)
                  (expr-denv-keys-within-p cdenv ivars tvars evars)
                  (expr-denv-alpha-avoided-p new-cdenv cdenv r
                                             ivars tvars evars)
                  (expr-denv-keys-supported-p
                   cdenv
                   (change-var-renamings
                    r :expr (extend-renaming
                             (var+type?->var (atom-lambda->param atom))
                             (var+type?->var (atom-lambda->param new-atom))
                             (var-renamings->expr r)))
                   (set::insert
                    (var+type?->var (atom-lambda->param new-atom))
                    (expr-body-support-names
                     (atom-lambda->body atom)
                     (change-var-renamings
                      r :expr (extend-renaming
                               (var+type?->var (atom-lambda->param atom))
                               (var+type?->var (atom-lambda->param new-atom))
                               (var-renamings->expr r)))))))))
  :expand ((atom-alpha-related-p new-atom atom r)
           (atom-alpha-fresh-p new-atom atom r b)
           (atom-free-ispace-vars atom)
           (atom-free-type-vars atom))
  :enable (expr-denv-keys-within-p-of-expr-denv-restrict
           subset-of-union-right-1
           subset-of-union-right-2
           expr-denv-keys-supported-p-monotone
           atom-free-expr-vars
           delete-of-rename-var-string-set-of-extend-renaming)
  :use ((:instance expr-denv-keys-supported-p-of-restrict-by-support-names
                   (ivars (expr-free-ispace-vars (atom-lambda->body atom)))
                   (tvars (expr-free-type-vars (atom-lambda->body atom)))
                   (evars (atom-free-expr-vars atom))
                   (body (atom-lambda->body atom))
                   (r (change-var-renamings
                       r :expr (extend-renaming
                                (var+type?->var (atom-lambda->param atom))
                                (var+type?->var (atom-lambda->param new-atom))
                                (var-renamings->expr r)))))
        (:instance atom-free-expr-vars-of-alpha-related
                   (new-a new-atom) (a atom))
        (:instance expr-free-ispace-vars-of-alpha-related
                   (new-x (atom-lambda->body new-atom))
                   (x (atom-lambda->body atom))
                   (r (change-var-renamings
                       r :expr (extend-renaming
                                (var+type?->var (atom-lambda->param atom))
                                (var+type?->var (atom-lambda->param new-atom))
                                (var-renamings->expr r))))
                   (b (set::insert
                       (str-fix (var+type?->var (atom-lambda->param new-atom)))
                       (expr-body-support-names
                        (atom-lambda->body atom)
                        (change-var-renamings
                         r :expr (extend-renaming
                                  (var+type?->var (atom-lambda->param atom))
                                  (var+type?->var (atom-lambda->param new-atom))
                                  (var-renamings->expr r)))))))
        (:instance expr-free-type-vars-of-alpha-related
                   (new-x (atom-lambda->body new-atom))
                   (x (atom-lambda->body atom))
                   (r (change-var-renamings
                       r :expr (extend-renaming
                                (var+type?->var (atom-lambda->param atom))
                                (var+type?->var (atom-lambda->param new-atom))
                                (var-renamings->expr r))))
                   (b (set::insert
                       (str-fix (var+type?->var (atom-lambda->param new-atom)))
                       (expr-body-support-names
                        (atom-lambda->body atom)
                        (change-var-renamings
                         r :expr (extend-renaming
                                  (var+type?->var (atom-lambda->param atom))
                                  (var+type?->var (atom-lambda->param new-atom))
                                  (var-renamings->expr r)))))))
        (:instance expr-denv-alpha-related-via-p-of-expr-denv-restrict
                   (ivars (expr-free-ispace-vars (atom-lambda->body atom)))
                   (tvars (expr-free-type-vars (atom-lambda->body atom)))
                   (evars (atom-free-expr-vars atom))
                   (new-ivars (expr-free-ispace-vars (atom-lambda->body new-atom)))
                   (new-tvars (expr-free-type-vars (atom-lambda->body new-atom)))
                   (new-evars (atom-free-expr-vars new-atom)))
        (:instance expr-denv-alpha-avoided-p-of-expr-denv-restrict
                   (ivars (expr-free-ispace-vars (atom-lambda->body atom)))
                   (tvars (expr-free-type-vars (atom-lambda->body atom)))
                   (evars (atom-free-expr-vars atom))
                   (ivars1 (expr-free-ispace-vars (atom-lambda->body atom)))
                   (tvars1 (expr-free-type-vars (atom-lambda->body atom)))
                   (evars1 (atom-free-expr-vars atom))
                   (new-ivars (expr-free-ispace-vars (atom-lambda->body new-atom)))
                   (new-tvars (expr-free-type-vars (atom-lambda->body new-atom)))
                   (new-evars (atom-free-expr-vars new-atom)))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (atom-free-ispace-vars atom))
                   (tvars2 (atom-free-type-vars atom))
                   (evars2 (atom-free-expr-vars atom))
                   (ivars1 (expr-free-ispace-vars (atom-lambda->body atom)))
                   (tvars1 (expr-free-type-vars (atom-lambda->body atom)))
                   (evars1 (atom-free-expr-vars atom)))))

(defruled eval-atom-ok-when-lambda-aux
  (implies (and (equal (atom-kind atom) :lambda)
                (not (zp limit))
                (atom-alpha-related-p new-atom atom r)
                (atom-alpha-fresh-p new-atom atom r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (atom-free-ispace-vars atom)
                                           (atom-free-type-vars atom)
                                           (atom-free-expr-vars atom))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((val (eval-atom atom denv limit))
                (new-val (eval-atom new-atom new-denv limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :expand ((atom-alpha-related-p new-atom atom r)
           (atom-alpha-fresh-p new-atom atom r b)
           (atom-free-ispace-vars atom)
           (atom-free-type-vars atom)
           (:free (new-val w param body type? cdenv)
            (expr-value-alpha-related-via-p
             new-val (expr-value-lambda param body type? cdenv) w)))
  :enable (eval-atom-when-lambda
           atom-free-expr-vars
           delete-of-rename-var-string-set-of-extend-renaming
           var+type?-free-ispace-vars
           var+type?-free-type-vars
           expr-denv-alpha-avoided-p
           expr-denv-alpha-related-via-p
           type-denv-alpha-avoided-p
           denv-ispace-vars-avoided-p-monotone
           type-var-map-avoided-p-monotone
           string-expr-value-map-avoided-p-monotone
           subset-of-union-right-1
           subset-of-union-right-2
           not-reserrp-when-expr-valuep)
  :use ((:instance eval-var+type?-alpha
                   (vt (atom-lambda->param atom))
                   (new-vt (atom-lambda->param new-atom))
                   (tenv (expr-denv->tenv denv))
                   (new-tenv (expr-denv->tenv new-denv))
                   (wmap (denv-witness->types dw)))
        (:instance eval-type-option-alpha
                   (type? (atom-lambda->type? atom))
                   (tenv (expr-denv->tenv denv))
                   (new-tenv (expr-denv->tenv new-denv))
                   (wmap (denv-witness->types dw)))
        lambda-closure-denv-alpha
        (:instance atom-free-expr-vars-of-alpha-related
                   (new-a new-atom) (a atom))
        (:instance expr-value-alpha-equiv-p-suff
                   (new-val (eval-atom new-atom new-denv limit))
                   (val (eval-atom atom denv limit))
                   (w (expr-value-witness-closure
                       r
                       (eval-type-witness
                        (type-option-some->val
                         (var+type?->type? (atom-lambda->param atom)))
                        r (denv-witness->types dw))
                       (eval-type-witness
                        (type-option-some->val (atom-lambda->type? atom))
                        r (denv-witness->types dw))
                       dw
                       (expr-body-support-names
                        (atom-lambda->body atom)
                        (change-var-renamings
                         r :expr (extend-renaming
                                  (var+type?->var (atom-lambda->param atom))
                                  (var+type?->var (atom-lambda->param new-atom))
                                  (var-renamings->expr r))))))))
  :disable (expr-alpha-fresh-p-of-union
            in-names-when-in-rename-var-string-set-and-not-value
            not-in-rename-var-string-set-when-fresh
            set::union-insert-y
            set::in-tail
            set::insert-identity))

(defruled eval-atom-ok-when-lambda
  (implies (equal (atom-kind atom) :lambda)
           (eval-atom-ok atom denv limit))
  :expand ((eval-atom-ok atom denv limit)
           (:free (new-x r) (atom-alpha-related-p new-x atom r)))
  :cases ((zp limit))
  :enable eval-atom-when-zp-limit
  :use ((:instance eval-atom-ok-when-lambda-aux
                   (new-atom (mv-nth 0 (eval-atom-ok-witness atom denv limit)))
                   (new-denv (mv-nth 1 (eval-atom-ok-witness atom denv limit)))
                   (r (mv-nth 2 (eval-atom-ok-witness atom denv limit)))
                   (dw (mv-nth 3 (eval-atom-ok-witness atom denv limit)))
                   (b (mv-nth 4 (eval-atom-ok-witness atom denv limit))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Fixing congruences, in the renamings and environments, of the
; environment relations that lack them: the closure witnesses carry fixed
; renamings.

(fty::deffixequiv type-denv-alpha-avoided-p
  :args ((new-tenv type-denvp) (tenv type-denvp) (r var-renamings-p))
  :hints (("Goal" :in-theory (enable type-denv-alpha-avoided-p))))

