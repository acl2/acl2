(defruled eval-bind-when-ifun-consp
  (implies (and (equal (bind-kind bind) :ifun)
                (consp (bind-ifun->params bind))
                (not (zp limit)))
           (equal (eval-bind bind denv limit)
                  (b* ((val (make-expr-value-ilambda
                             :param (car (bind-ifun->params bind))
                             :body (ilambda-curried-body (bind-ifun->params bind)
                                                         (bind-ifun->expr bind))
                             :denv (expr-denv-restrict
                                    (set::difference
                                     (expr-free-ispace-vars (bind-ifun->expr bind))
                                     (set::mergesort (bind-ifun->params bind)))
                                    (expr-free-type-vars (bind-ifun->expr bind))
                                    (expr-free-expr-vars (bind-ifun->expr bind))
                                    denv)))
                       (type? (bind-ifun->type? bind))
                       ((ok &) (type-option-case
                                type?
                                :some (eval-type (make-type-pi/pin
                                                  (bind-ifun->params bind)
                                                  type?.val)
                                                 (expr-denv->tenv denv))
                                :none nil)))
                    (expr-denv-add-expr (bind-ifun->var bind) val denv))))
  :expand ((eval-bind bind denv limit)))

(defruled eval-atom-of-atom-ilambdan
  (implies (and (ispace-var-listp params)
                (consp (cdr params))
                (exprp body)
                (not (zp limit)))
           (equal (eval-atom (atom-ilambdan params body) denv limit)
                  (make-expr-value-ilambda
                   :param (car params)
                   :body (ilambda-curried-body params body)
                   :denv (expr-denv-restrict
                          (set::difference (expr-free-ispace-vars body)
                                           (set::mergesort params))
                          (expr-free-type-vars body)
                          (expr-free-expr-vars body)
                          denv))))
  :enable eval-atom-when-ilambdan
  :expand ((atom-free-ispace-vars (atom-ilambdan params body))))

(defruled eval-atom-of-atom-ilambda
  (implies (and (ispace-varp param)
                (exprp body)
                (not (zp limit)))
           (equal (eval-atom (atom-ilambda param body) denv limit)
                  (make-expr-value-ilambda
                   :param param
                   :body body
                   :denv (expr-denv-restrict
                          (set::delete param (expr-free-ispace-vars body))
                          (expr-free-type-vars body)
                          (expr-free-expr-vars body)
                          denv))))
  :enable eval-atom-when-ilambda
  :expand ((atom-free-ispace-vars (atom-ilambda param body))))

