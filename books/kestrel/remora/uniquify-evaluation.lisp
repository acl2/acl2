                (consp x)
                (car x))
           (consp (car x))))

(defruled expr-value-list-alpha-equiv-p-of-car-list
  (implies (and (expr-value-list-list-alpha-equiv-p new-valss valss)
                (expr-value-list-listp valss)
                (not (member-equal nil valss)))
           (expr-value-list-alpha-equiv-p (car-list new-valss) (car-list valss)))
  :induct (two-cdrs-induct valss new-valss)
  :enable (car-list
           expr-value-list-list-alpha-equiv-p
           consp-when-expr-value-list-alpha-equiv-p
           consp-of-car-when-expr-value-list-listp-and-non-nil
