; The unboxing statement takes the renamings before the binders it
; introduces (the ispace variables and the term variable), so that the
; recursion over the remaining ispace variables re-instantiates it.

(acl2::defun-sk eval-unbox-ok (target ispaces var body type denv limit)
  (forall (new-target w new-ispaces new-var new-body new-type tw
           new-denv r dw b b0)
    (implies (and (expr-value-alpha-related-via-p new-target target w)
                  (b* (((mv okp dim-renam shape-renam)
                        (ispace-var-list-alpha-extend new-ispaces ispaces
                                                      (var-renamings->dim r)
                                                      (var-renamings->shape r)))
                       (body-r (change-var-renamings
                                r
                                :dim dim-renam
                                :shape shape-renam
                                :expr (extend-renaming var new-var
                                                       (var-renamings->expr r)))))
                    (and okp
                         (expr-alpha-related-p new-body body body-r)
                         (expr-alpha-fresh-p new-body body body-r b)))
                  (consp ispaces)
                  (ispace-var-list-fresh-ok new-ispaces ispaces
                                            (var-renamings->dim r)
                                            (var-renamings->shape r)
                                            b0)
                  (no-duplicatesp-equal (ispace-var-list-fix new-ispaces))
                  (name-fresh-ok var new-var (var-renamings->expr r)
                                 (set::union (list-to-oset
                                              (ispace-var-list->name new-ispaces))
                                             (string-sfix b0)))
                  (equal (string-sfix b)
                         (set::insert (str-fix new-var)
                                      (set::union (list-to-oset
                                                   (ispace-var-list->name new-ispaces))
                                                  (string-sfix b0))))
                  (expr-denv-keys-supported-p denv r b0)
                  (set::emptyp
                   (set::intersect
                    (set::mergesort (ispace-var-list-fix new-ispaces))
                    (ispace-var-set-rename-ispace-vars
                     (set::difference (expr-free-ispace-vars body)
                                      (set::mergesort
                                       (ispace-var-list-fix ispaces)))
                     (var-renamings->dim r)
                     (var-renamings->shape r))))
                  (not (set::in (str-fix new-var)
                                (rename-var-string-set
                                 (set::delete (str-fix var)
                                              (expr-free-expr-vars body))
                                 (var-renamings->expr r))))
                  (type-value-alpha-related-via-p new-type type tw)
                  (expr-denv-alpha-related-via-p new-denv denv r dw)
                  (expr-denv-alpha-avoided-p
                   new-denv denv r
                   (set::difference (expr-free-ispace-vars body)
                                    (set::mergesort
                                     (ispace-var-list-fix ispaces)))
                   (expr-free-type-vars body)
                   (set::delete (str-fix var) (expr-free-expr-vars body)))
                  (expr-value-wfp target)
                  (expr-value-wfp new-target)
                  (expr-denv-wfp denv)
                  (expr-denv-wfp new-denv))
             (b* ((val (eval-unbox target ispaces var body type denv limit))
                  (new-val (eval-unbox new-target new-ispaces new-var new-body
                                       new-type new-denv limit)))
               (and (equal (reserrp new-val) (reserrp val))
                    (implies (not (reserrp val))
                             (expr-value-alpha-equiv-p new-val val)))))))

