        atom-alpha-fresh-p-of-ilambdan-when-ifun
        (:instance eval-atom-ok-when-ilambdan-aux
                   (atom (atom-ilambdan (bind-ifun->params bind)
                                        (bind-ifun->expr bind)))
                   (new-atom (atom-ilambdan (bind-ifun->params new-bind)
                                            (bind-ifun->expr new-bind))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (bind-free-ispace-vars bind))
                   (tvars2 (bind-free-type-vars bind))
                   (evars2 (bind-free-expr-vars bind))
                   (ivars1 (set::difference
                            (expr-free-ispace-vars (bind-ifun->expr bind))
                            (set::mergesort (bind-ifun->params bind))))
                   (tvars1 (expr-free-type-vars (bind-ifun->expr bind)))
                   (evars1 (expr-free-expr-vars (bind-ifun->expr bind))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (set::difference (ispace-var-set-fix ivars) nil))
                   (tvars2 (set::difference (type-var-set-fix tvars) nil))
                   (evars2 (set::delete (bind-ifun->var bind) (string-sfix evars)))
                   (ivars1 ivars)
                   (tvars1 tvars)
                   (evars1 (set::delete (bind-ifun->var bind) (string-sfix evars))))))

(defruled atom-alpha-related-p-of-ilambda-when-ifun
  (implies (and (equal (bind-kind bind) :ifun)
                (consp (bind-ifun->params bind))
                (not (consp (cdr (bind-ifun->params bind))))
                (bind-alpha-related-p new-bind bind r))
           (and (equal (bind-kind new-bind) :ifun)
                (consp (bind-ifun->params new-bind))
                (not (consp (cdr (bind-ifun->params new-bind))))
                (atom-alpha-related-p
                 (atom-ilambda (car (bind-ifun->params new-bind))
                               (bind-ifun->expr new-bind))
                 (atom-ilambda (car (bind-ifun->params bind))
                               (bind-ifun->expr bind))
                 r)))
  :expand ((bind-alpha-related-p new-bind bind r)
           (:free (a x) (atom-alpha-related-p a x r)))
  :use ((:instance len-when-ispace-var-list-alpha-extend-okp
                   (new-params (bind-ifun->params new-bind))
                   (params (bind-ifun->params bind))
                   (dim-m (var-renamings->dim r))
                   (shape-m (var-renamings->shape r))))
  :enable (list-of-car-when-len-1 len))

(defruled atom-alpha-fresh-p-of-ilambda-when-ifun
  (implies (and (equal (bind-kind bind) :ifun)
                (consp (bind-ifun->params bind))
                (not (consp (cdr (bind-ifun->params bind))))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b))
           (atom-alpha-fresh-p
            (atom-ilambda (car (bind-ifun->params new-bind))
                          (bind-ifun->expr new-bind))
            (atom-ilambda (car (bind-ifun->params bind))
                          (bind-ifun->expr bind))
            r b))
  :expand ((bind-alpha-fresh-p new-bind bind r b)
           (:free (a x) (atom-alpha-fresh-p a x r b)))
  :use (atom-alpha-related-p-of-ilambda-when-ifun
        (:instance not-in-ispace-var-image-of-delete-when-emptyp-intersect
                   (p2 (car (bind-ifun->params new-bind)))
                   (p (car (bind-ifun->params bind)))
                   (t1 (type-option-free-ispace-vars (bind-ifun->type? bind)))
                   (e (expr-free-ispace-vars (bind-ifun->expr bind)))
                   (dm (var-renamings->dim r))
                   (sm (var-renamings->shape r))))
  :enable (list-of-car-when-len-1
           len
           mergesort-when-consp
           expr-alpha-fresh-p-insert-from-union-support))

(defruled eval-bind-ok-when-ifun-1-aux
  (implies (and (equal (bind-kind bind) :ifun)
                (consp (bind-ifun->params bind))
                (not (consp (cdr (bind-ifun->params bind))))
                (not (zp limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
                (expr-denv-alpha-avoided-p new-denv denv r
                                           (bind-free-ispace-vars bind)
                                           (bind-free-type-vars bind)
                                           (bind-free-expr-vars bind))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                (result (eval-bind bind denv limit))
                (new-result (eval-bind new-bind new-denv limit)))
             (and (equal (reserrp new-result) (reserrp result))
                  (implies (not (reserrp result))
                           (and (expr-denv-alpha-equiv-p new-result result new-r)
                                (expr-denv-keys-supported-p
                                 result new-r
                                 (set::insert (str-fix (bind-name new-bind))
                                              (string-sfix b)))
                                (implies
                                 (and (expr-denv-alpha-avoided-p
                                       new-denv denv r
                                       (set::difference
                                        (ispace-var-set-fix ivars)
                                        (bind-bound-ispace-vars bind))
                                       (set::difference
                                        (type-var-set-fix tvars)
                                        (bind-bound-type-vars bind))
                                       (set::difference
                                        (string-sfix evars)
                                        (bind-bound-expr-vars bind)))
                                      (bind-nocapture-ok new-bind bind r
                                                         evars tvars ivars))
                                 (expr-denv-alpha-avoided-p
                                  new-result result new-r
                                  ivars tvars evars)))))))
  :expand ((bind-alpha-fresh-p new-bind bind r b)
           (bind-free-ispace-vars bind)
           (bind-free-type-vars bind)
           (bind-free-expr-vars bind)
           (bind-bound-ispace-vars bind)
           (bind-bound-type-vars bind)
           (bind-bound-expr-vars bind)
           (bind-nocapture-ok new-bind bind r evars tvars ivars)
           (bind-alpha-extended-renamings new-bind bind r)
           (bind-name bind)
           (bind-name new-bind)
           (:free (p e) (atom-free-ispace-vars (atom-ilambda p e)))
           (:free (p e) (atom-free-type-vars (atom-ilambda p e)))
           (:free (p e) (atom-free-expr-vars (atom-ilambda p e))))
  :enable (eval-bind-when-ifun-consp
           eval-atom-of-atom-ilambda
           subset-delete-of-union-right
           ilambda-curried-body
           mergesort-when-consp
           not-reserrp-of-eval-type-of-make-type-pi/pin
           not-reserrp-when-expr-valuep
           not-reserrp-when-expr-denvp
           expr-denv-keys-supported-p-of-add-expr
           expr-denv-alpha-avoided-p-of-add-expr
           expr-denv-alpha-equiv-p-of-add-expr-when-equiv
           set::difference-insert-y
           difference-of-nil-right
           set::pick-a-point-subset-strategy
           set::subset-in)
  :use (atom-alpha-related-p-of-ilambda-when-ifun
        atom-alpha-fresh-p-of-ilambda-when-ifun
        (:instance eval-atom-ok-when-ilambda-aux
                   (atom (atom-ilambda (car (bind-ifun->params bind))
                                       (bind-ifun->expr bind)))
                   (new-atom (atom-ilambda (car (bind-ifun->params new-bind))
                                           (bind-ifun->expr new-bind))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (bind-free-ispace-vars bind))
                   (tvars2 (bind-free-type-vars bind))
                   (evars2 (bind-free-expr-vars bind))
                   (ivars1 (set::delete (car (bind-ifun->params bind))
                                        (expr-free-ispace-vars (bind-ifun->expr bind))))
                   (tvars1 (expr-free-type-vars (bind-ifun->expr bind)))
                   (evars1 (expr-free-expr-vars (bind-ifun->expr bind))))
        (:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (set::difference (ispace-var-set-fix ivars) nil))
                   (tvars2 (set::difference (type-var-set-fix tvars) nil))
                   (evars2 (set::delete (bind-ifun->var bind) (string-sfix evars)))
                   (ivars1 ivars)
                   (tvars1 tvars)
                   (evars1 (set::delete (bind-ifun->var bind) (string-sfix evars))))))

(defruled eval-bind-ok-when-ifun-consp
  (implies (and (equal (bind-kind bind) :ifun)
                (consp (bind-ifun->params bind)))
           (eval-bind-ok bind denv limit))
  :expand ((eval-bind-ok bind denv limit))
  :cases ((zp limit) (consp (cdr (bind-ifun->params bind))))
  :enable eval-bind-when-zp-limit
  :use ((:instance eval-bind-ok-when-ifun-n-aux
                   (new-bind (mv-nth 0 (eval-bind-ok-witness bind denv limit)))
                   (new-denv (mv-nth 1 (eval-bind-ok-witness bind denv limit)))
                   (r (mv-nth 2 (eval-bind-ok-witness bind denv limit)))
                   (dw (mv-nth 3 (eval-bind-ok-witness bind denv limit)))
                   (b (mv-nth 4 (eval-bind-ok-witness bind denv limit)))
                   (evars (mv-nth 5 (eval-bind-ok-witness bind denv limit)))
                   (tvars (mv-nth 6 (eval-bind-ok-witness bind denv limit)))
                   (ivars (mv-nth 7 (eval-bind-ok-witness bind denv limit))))
        (:instance eval-bind-ok-when-ifun-1-aux
                   (new-bind (mv-nth 0 (eval-bind-ok-witness bind denv limit)))
                   (new-denv (mv-nth 1 (eval-bind-ok-witness bind denv limit)))
                   (r (mv-nth 2 (eval-bind-ok-witness bind denv limit)))
                   (dw (mv-nth 3 (eval-bind-ok-witness bind denv limit)))
                   (b (mv-nth 4 (eval-bind-ok-witness bind denv limit)))
                   (evars (mv-nth 5 (eval-bind-ok-witness bind denv limit)))
                   (tvars (mv-nth 6 (eval-bind-ok-witness bind denv limit)))
                   (ivars (mv-nth 7 (eval-bind-ok-witness bind denv limit))))))

