  :use ((:instance expr-denv-alpha-avoided-p-monotone
                   (ivars2 (set::union (type-option-free-ispace-vars type?)
                                       (expr-free-ispace-vars expr)))
                   (tvars2 (set::union (type-option-free-type-vars type?)
                                       (expr-free-type-vars expr)))
                   (evars2 (expr-free-expr-vars expr))
                   (ivars1 (expr-free-ispace-vars expr))
                   (tvars1 (expr-free-type-vars expr))
                   (evars1 (expr-free-expr-vars expr)))
        (:instance eval-expr-ok-necc
                   (limit (1- limit)))
        (:instance eval-type-option-alpha-of-expr-denvs
                   (ivars (set::union (type-option-free-ispace-vars type?)
                                      (expr-free-ispace-vars expr)))
