                (expr-value-wfp new-arg))
           (b* ((val (eval-primop-fun op arg limit))
                (new-val (eval-primop-fun new-op new-arg limit)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-alpha-equiv-p new-val val)))))
  :enable (eval-primop-fun-when-fo
           primop-value-fun-fo-p-when-primop-value-alpha-related-via-p-safe)
