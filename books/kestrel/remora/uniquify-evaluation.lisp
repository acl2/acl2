  :expand ((bind-alpha-fresh-p new-bind bind r b)
           (bind-name bind)
           (bind-name new-bind))
  :enable (type-var-list-alpha-extend
           type-var-list-fresh-ok
           expr-alpha-fresh-p-when-fresh-at-union-support-2)
  :use bind-alpha-related-p-when-tfun-endp)

(defruled eval-bind-ok-when-tfun-endp-aux
  (implies (and (equal (bind-kind bind) :tfun)
                (endp (bind-tfun->params bind))
                (not (zp limit))
                (eval-expr-ok (bind-tfun->expr bind) denv (1- limit))
                (bind-alpha-related-p new-bind bind r)
                (bind-alpha-fresh-p new-bind bind r b)
                (expr-denv-keys-supported-p denv r b)
                (expr-denv-alpha-related-via-p new-denv denv r dw)
