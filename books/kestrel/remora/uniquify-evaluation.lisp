;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The primitive application clique member (EVAL-PRIMOP-FUN): first-order
; operations are delegated to the first-order evaluator, covered by
; EVAL-PRIMOP-FUN-FO-ALPHA; the last stages of reduce and fold are
; delegated to the clique members PRIM-REDUCE and PRIM-FOLD, whose
; induction statements supply the hypotheses.

(defruled eval-primop-fun-when-zp-limit
  (implies (zp limit)
           (equal (eval-primop-fun op arg limit) (reserr :limit)))
  :expand ((eval-primop-fun op arg limit)))

(defruled eval-primop-fun-when-fo
  (implies (and (not (zp limit))
                (primop-value-fun-fo-p op))
           (equal (eval-primop-fun op arg limit)
                  (eval-primop-fun-fo op arg)))
  :expand ((eval-primop-fun op arg limit)))

(defruled eval-primop-fun-when-reduce
  (implies (and (not (zp limit))
                (not (primop-value-fun-fo-p op))
                (equal (primop-value-kind op) :reduce-t-d-s-f))
           (equal (eval-primop-fun op arg limit)
                  (prim-reduce (primop-value-reduce-t-d-s-f->tval op)
                               (primop-value-reduce-t-d-s-f->dval op)
                               (primop-value-reduce-t-d-s-f->sval op)
                               (primop-value-reduce-t-d-s-f->fval op)
                               arg
                               (1- limit))))
  :expand ((eval-primop-fun op arg limit)))

(defruled eval-primop-fun-when-fold
  (implies (and (not (zp limit))
                (not (primop-value-fun-fo-p op))
                (equal (primop-value-kind op) :fold-t-t2-d-s-s2-f-z))
           (equal (eval-primop-fun op arg limit)
                  (prim-fold (primop-value-fold-t-t2-d-s-s2-f-z->tval op)
                             (primop-value-fold-t-t2-d-s-s2-f-z->t2val op)
                             (primop-value-fold-t-t2-d-s-s2-f-z->dval op)
                             (primop-value-fold-t-t2-d-s-s2-f-z->sval op)
                             (primop-value-fold-t-t2-d-s-s2-f-z->s2val op)
                             (primop-value-fold-t-t2-d-s-s2-f-z->fval op)
                             (primop-value-fold-t-t2-d-s-s2-f-z->zval op)
                             arg
                             (1- limit))))
  :expand ((eval-primop-fun op arg limit)))

(defruled eval-primop-fun-when-otherwise
  (implies (and (not (zp limit))
                (not (primop-value-fun-fo-p op))
                (not (equal (primop-value-kind op) :reduce-t-d-s-f))
                (not (equal (primop-value-kind op) :fold-t-t2-d-s-s2-f-z)))
           (reserrp (eval-primop-fun op arg limit)))
  :expand ((eval-primop-fun op arg limit)))

; Kind and first-orderness are preserved by the relation.

(defruled primop-value-kind-when-primop-value-alpha-related-via-p-safe
  (implies (and (primop-value-alpha-related-via-p new-op op tws ws)
                (syntaxp (not (equal new-op op))))
           (equal (primop-value-kind new-op) (primop-value-kind op)))
  :use primop-value-kind-when-primop-value-alpha-related-via-p)

(defruled primop-value-fun-fo-p-when-primop-value-alpha-related-via-p-safe
  (implies (and (primop-value-alpha-related-via-p new-op op tws ws)
