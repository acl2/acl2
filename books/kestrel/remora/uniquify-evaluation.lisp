  :induct (two-cdrs-induct valss new-valss)
  :enable (append-all
           expr-value-list-list-alpha-equiv-p
           expr-value-list-alpha-equiv-p-of-append-gen
           expr-value-list-alpha-equiv-p-of-nil))

(defruled consp-of-car-when-expr-value-list-listp-and-non-nil
