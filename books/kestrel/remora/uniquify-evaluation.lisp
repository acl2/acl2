; The existential form of the list relation, alongside the ones of the
; relations book.

(acl2::defun-sk expr-value-list-alpha-equiv-p (new-vals vals)
  (exists (ws) (expr-value-list-alpha-related-via-p new-vals vals ws)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The statements of the induction, one per function of the evaluator
; clique, each universally quantified over the new-side counterparts of
; the function's arguments and over the witnesses and renamings that
; relate them.  Only the clique's own formals are parameters, so that the
; induction hypotheses of the flag proof are these statements at the
; recursive calls, instantiable at whatever new-side arguments the case
; constructs.

(acl2::defun-sk eval-expr-ok (expr denv limit)
  (forall (new-expr new-denv r dw b)
    (implies (and (expr-alpha-related-p new-expr expr r)
                  (expr-alpha-fresh-p new-expr expr r b)
                  (expr-denv-keys-supported-p denv r b)
                  (expr-denv-alpha-related-via-p new-denv denv r dw)
                  (expr-denv-alpha-avoided-p new-denv denv r
                                             (expr-free-ispace-vars expr)
                                             (expr-free-type-vars expr)
                                             (expr-free-expr-vars expr))
                  (expr-denv-wfp denv)
                  (expr-denv-wfp new-denv))
             (b* ((val (eval-expr expr denv limit))
                  (new-val (eval-expr new-expr new-denv limit)))
               (and (equal (reserrp new-val) (reserrp val))
                    (implies (not (reserrp val))
                             (expr-value-alpha-equiv-p new-val val)))))))

(acl2::defun-sk eval-expr-list-ok (exprs denv limit)
  (forall (new-exprs new-denv r dw b)
    (implies (and (expr-list-alpha-related-p new-exprs exprs r)
                  (expr-list-alpha-fresh-p new-exprs exprs r b)
                  (expr-denv-keys-supported-p denv r b)
                  (expr-denv-alpha-related-via-p new-denv denv r dw)
                  (expr-denv-alpha-avoided-p new-denv denv r
                                             (expr-list-free-ispace-vars exprs)
                                             (expr-list-free-type-vars exprs)
                                             (expr-list-free-expr-vars exprs))
                  (expr-denv-wfp denv)
                  (expr-denv-wfp new-denv))
             (b* ((vals (eval-expr-list exprs denv limit))
                  (new-vals (eval-expr-list new-exprs new-denv limit)))
               (and (equal (reserrp new-vals) (reserrp vals))
                    (implies (not (reserrp vals))
                             (expr-value-list-alpha-equiv-p new-vals vals)))))))

(acl2::defun-sk eval-atom-ok (atom denv limit)
  (forall (new-atom new-denv r dw b)
    (implies (and (atom-alpha-related-p new-atom atom r)
                  (atom-alpha-fresh-p new-atom atom r b)
                  (expr-denv-keys-supported-p denv r b)
                  (expr-denv-alpha-related-via-p new-denv denv r dw)
                  (expr-denv-alpha-avoided-p new-denv denv r
                                             (atom-free-ispace-vars atom)
                                             (atom-free-type-vars atom)
                                             (atom-free-expr-vars atom))
                  (expr-denv-wfp denv)
                  (expr-denv-wfp new-denv))
             (b* ((val (eval-atom atom denv limit))
                  (new-val (eval-atom new-atom new-denv limit)))
               (and (equal (reserrp new-val) (reserrp val))
                    (implies (not (reserrp val))
                             (expr-value-alpha-equiv-p new-val val)))))))

(acl2::defun-sk eval-atom-list-ok (atoms denv limit)
  (forall (new-atoms new-denv r dw b)
    (implies (and (atom-list-alpha-related-p new-atoms atoms r)
                  (atom-list-alpha-fresh-p new-atoms atoms r b)
                  (expr-denv-keys-supported-p denv r b)
                  (expr-denv-alpha-related-via-p new-denv denv r dw)
                  (expr-denv-alpha-avoided-p new-denv denv r
                                             (atom-list-free-ispace-vars atoms)
                                             (atom-list-free-type-vars atoms)
                                             (atom-list-free-expr-vars atoms))
                  (expr-denv-wfp denv)
                  (expr-denv-wfp new-denv))
             (b* ((vals (eval-atom-list atoms denv limit))
                  (new-vals (eval-atom-list new-atoms new-denv limit)))
               (and (equal (reserrp new-vals) (reserrp vals))
                    (implies (not (reserrp vals))
                             (expr-value-list-alpha-equiv-p new-vals vals)))))))

; A bind's statement also carries the failure-direction relation forward:
; the resulting environments, under the extended renamings, avoid any
; variable set that the incoming ones avoided outside the bind's bound
; variables and that the bind's new name does not capture.

(acl2::defun-sk eval-bind-ok (bind denv limit)
  (forall (new-bind new-denv r dw b evars tvars ivars)
    (implies (and (bind-alpha-related-p new-bind bind r)
                  (bind-alpha-fresh-p new-bind bind r b)
                  (expr-denv-keys-supported-p denv r b)
                  (expr-denv-alpha-related-via-p new-denv denv r dw)
                  (expr-denv-alpha-avoided-p new-denv denv r
                                             (bind-free-ispace-vars bind)
                                             (bind-free-type-vars bind)
                                             (bind-free-expr-vars bind))
                  (expr-denv-wfp denv)
                  (expr-denv-wfp new-denv))
             (b* ((new-r (bind-alpha-extended-renamings new-bind bind r))
                  (result (eval-bind bind denv limit))
                  (new-result (eval-bind new-bind new-denv limit)))
               (and (equal (reserrp new-result) (reserrp result))
                    (implies (not (reserrp result))
                             (and (expr-denv-alpha-equiv-p new-result result
                                                           new-r)
                                  (expr-denv-keys-supported-p
                                   result new-r
                                   (set::insert (str-fix (bind-name new-bind))
                                                (string-sfix b)))
                                  (implies
                                   (and (expr-denv-alpha-avoided-p
                                         new-denv denv r
                                         (set::difference
                                          (ispace-var-set-fix ivars)
                                          (bind-bound-ispace-vars bind))
                                         (set::difference
                                          (type-var-set-fix tvars)
                                          (bind-bound-type-vars bind))
                                         (set::difference
                                          (string-sfix evars)
                                          (bind-bound-expr-vars bind)))
                                        (bind-nocapture-ok new-bind bind r
                                                           evars tvars ivars))
                                   (expr-denv-alpha-avoided-p
                                    new-result result new-r
                                    ivars tvars evars)))))))))

(acl2::defun-sk eval-bind-list-ok (binds denv limit)
  (forall (new-binds new-denv r dw b evars tvars ivars)
    (implies (and (bind-list-alpha-related-p new-binds binds r)
                  (bind-list-alpha-fresh-p new-binds binds r b)
                  (expr-denv-keys-supported-p denv r b)
                  (expr-denv-alpha-related-via-p new-denv denv r dw)
                  (expr-denv-alpha-avoided-p new-denv denv r
                                             (bind-list-free-ispace-vars binds)
                                             (bind-list-free-type-vars binds)
                                             (bind-list-free-expr-vars binds))
                  (expr-denv-wfp denv)
                  (expr-denv-wfp new-denv))
             (b* ((new-r (bind-list-alpha-extended-renamings new-binds binds r))
                  (result (eval-bind-list binds denv limit))
                  (new-result (eval-bind-list new-binds new-denv limit)))
               (and (equal (reserrp new-result) (reserrp result))
                    (implies (not (reserrp result))
                             (and (expr-denv-alpha-equiv-p new-result result
                                                           new-r)
                                  (expr-denv-keys-supported-p
                                   result new-r
                                   (set::union (list-to-oset
                                                (bind-list-names new-binds))
                                               (string-sfix b)))
                                  (implies
                                   (and (expr-denv-alpha-avoided-p
                                         new-denv denv r
                                         (set::difference
                                          (ispace-var-set-fix ivars)
                                          (bind-list-bound-ispace-vars binds))
                                         (set::difference
                                          (type-var-set-fix tvars)
                                          (bind-list-bound-type-vars binds))
                                         (set::difference
                                          (string-sfix evars)
                                          (bind-list-bound-expr-vars binds)))
                                        (bind-list-body-scope-fresh-ok
                                         new-binds binds r
                                         evars tvars ivars))
                                   (expr-denv-alpha-avoided-p
                                    new-result result new-r
                                    ivars tvars evars)))))))))

