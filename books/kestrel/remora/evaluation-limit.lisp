; The same, with the limits related by <=; the rules are left disabled,
; since their free variable makes them awkward as rewrite rules.

(defruled eval-expr-when-larger-limit
  :short "A result of @(tsee eval-expr) that is not the limit error
          is also the result at every larger limit."
  (implies (and (natp limit)
                (natp limit2)
                (<= limit limit2)
                (not (equal (eval-expr expr denv limit) (reserr :limit))))
           (equal (eval-expr expr denv limit2)
                  (eval-expr expr denv limit)))
  :use ((:instance eval-expr-of-larger-limit (k (- limit2 limit)))))

(defruled eval-top-expr-when-larger-limit
  :short "A result of @(tsee eval-top-expr) that is not the limit error
          is also the result at every larger limit."
  (implies (and (natp limit)
                (natp limit2)
                (<= limit limit2)
                (not (equal (eval-top-expr expr limit) (reserr :limit))))
           (equal (eval-top-expr expr limit2)
                  (eval-top-expr expr limit)))
  :use ((:instance eval-expr-when-larger-limit (denv (init-expr-denv))))
  :enable eval-top-expr)
