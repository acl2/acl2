(in-package "REMORA")

(include-book "evaluation")

(include-book "portcullis")

(local (in-theory (disable (:e tau-system))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defxdoc+ evaluation-limit
  :parents (evaluation)
  :short "Evaluation is monotone in the limit."
  :long
  (xdoc::topstring
   (xdoc::p
    "The evaluation functions of @(see eval-exprs/atoms/binds) take a
     limit that bounds the depth of their recursion, whose exhaustion
     yields the error @('(reserr :limit)').  That is the only effect of
     the limit: a result that is not that error is also the result at
     every larger limit.  This is @('eval-expr-of-larger-limit') and
     its companions, one per function of the clique, proved together by
     the mutual induction of the clique; the corollaries at the end state
     them with the two limits related by @('<=') instead of by a
     difference, and lift them to @(tsee eval-top-expr).")
   (xdoc::p
    "Transformations of Remora programs that change the shape of the
     evaluation, like monomorphization (see @(see monomorphize)), change
     the limit at which a program's evaluation completes; their
     correctness theorems compare the two evaluations at different
     limits, which is where these theorems come in."))
  :order-subtopics t
  :default-parent t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The flag function of the evaluation clique, for the mutual induction.
; (The one generated by DEFINES in EVALUATION is local to that book.)

(acl2::make-flag eval-exprs/atoms/binds-flag eval-expr
                 :hints (("Goal" :in-theory (enable o-p o< o-finp))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The two evaluations, at the limit and at the limit increased by K, are
; opened together; the case analysis of each function propagates the limit
; error of a recursive call to the result, so the hypothesis that the
; result is not that error discharges the induction hypotheses of the
; recursive calls.

(defthm-eval-exprs/atoms/binds-flag
  (defthm eval-expr-of-larger-limit
    (implies (and (natp limit) (natp k)
                  (not (equal (eval-expr expr denv limit) (reserr :limit))))
             (equal (eval-expr expr denv (+ k limit))
                    (eval-expr expr denv limit)))
    :flag eval-expr)
  (defthm eval-expr-list-of-larger-limit
    (implies (and (natp limit) (natp k)
                  (not (equal (eval-expr-list exprs denv limit) (reserr :limit))))
             (equal (eval-expr-list exprs denv (+ k limit))
                    (eval-expr-list exprs denv limit)))
    :flag eval-expr-list)
  (defthm eval-atom-of-larger-limit
    (implies (and (natp limit) (natp k)
                  (not (equal (eval-atom atom denv limit) (reserr :limit))))
             (equal (eval-atom atom denv (+ k limit))
                    (eval-atom atom denv limit)))
    :flag eval-atom)
  (defthm eval-atom-list-of-larger-limit
    (implies (and (natp limit) (natp k)
                  (not (equal (eval-atom-list atoms denv limit) (reserr :limit))))
             (equal (eval-atom-list atoms denv (+ k limit))
                    (eval-atom-list atoms denv limit)))
    :flag eval-atom-list)
  (defthm eval-bind-of-larger-limit
