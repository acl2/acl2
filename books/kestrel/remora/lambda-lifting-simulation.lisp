  :disable (prim-reduce/fold-loop eval-app-cell eval-app-cell-ll-ok
            prim-reduce/fold-loop-ll-ok prim-reduce/fold-loop-ll-ok-necc
            prim-reduce/fold-loop-ll-reaches-p eval-app-cell-ll-reaches-p
            expr-value-ll-related-p expr-value-list-ll-related-p
            expr-value-wfp-of-eval-app-cell))

(defruled prim-reduce/fold-loop-ll-reaches-p-step1
  (implies (and (consp cells)
                (not (reserrp (prim-reduce/fold-loop acc cells fval limit)))
                (eval-app-cell-ll-ok fval acc (1- limit))
                (implies (not (reserrp (eval-app-cell fval acc (1- limit))))
                         (eval-app-cell-ll-ok
                          (eval-app-cell fval acc (1- limit))
