(defruled free-and-binders-of-singleton-array
  (and (equal (expr-free-expr-vars (expr-array d (list a)))
              (atom-free-expr-vars a))
       (equal (expr-binder-names (expr-array d (list a)))
              (atom-binder-names a)))
  :expand ((expr-free-expr-vars (expr-array d (list a)))
           (expr-binder-names (expr-array d (list a)))
           (:free (a as) (atom-list-free-expr-vars (cons a as)))
           (:free (a as) (atom-list-binder-names (cons a as)))))

; The atom case, for any expression X around the lambda atom with its free
; variables, binders and lifted definitions: the expression atom itself, or
; the singleton array of it.

(defmacro %atomlam-shape-hyps ()
  '(and (var+type?-listp pa)
        (consp pa)
        (exprp ba)
        (type-optionp ta)
        (equal (expr-free-expr-vars x)
               (atom-free-expr-vars (make-atom-lambda/lambdan pa ba ta)))
        (equal (expr-free-expr-vars (ll-context-new-expr x ctx))
               (atom-free-expr-vars (make-atom-lambda/lambdan pa (%anb) ta)))
        (equal (expr-binder-names x)
               (append (var+type?-list->var pa) (expr-binder-names ba)))
        (equal (ll-context-lifted x ctx) (ll-context-lifted ba (%actx)))))

(defruled atomlam-params-facts
  (implies (equal (expr-binder-names x)
                  (append (var+type?-list->var pa) (expr-binder-names ba)))
           (and (subsetp-equal (var+type?-list->var pa) (expr-binder-names x))
                (subsetp-equal (expr-binder-names ba) (expr-binder-names x))
                (implies (no-duplicatesp-equal (expr-binder-names x))
                         (and (no-duplicatesp-equal (var+type?-list->var pa))
                              (no-duplicatesp-equal
                               (expr-binder-names ba)))))))

(defruled atomlam-inner-replacement-at
  (implies (and (var+type?-listp pa)
                (equal (expr-binder-names x)
                       (append (var+type?-list->var pa) (expr-binder-names ba)))
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        (expr-binder-names x) genv)
                (omap::assoc k (ll-context->lmap (%actx))))
           (ll-replacement-ok-p (cdr (omap::assoc k (ll-context->lmap (%actx))))
                                (ll-context->locals (%actx))
                                (expr-binder-names ba)
                                genv))
  :use (atomlam-params-facts
        atomlam-aps
        (:instance ll-lambda-parts-context (params pa) (body '(:var ""))
                   (type? nil))
        (:instance ll-lambda-parts-locals (params pa) (body '(:var ""))
                   (type? nil))
        (:instance ll-replacement-ok-p-when-lmap-replacements-ok-p
                   (lmap (ll-context->lmap ctx))
                   (locals (ll-context->locals ctx))
                   (pnames (expr-binder-names x)))
        (:instance ll-replacement-ok-p-of-more-locals
                   (repl (cdr (omap::assoc k (ll-context->lmap ctx))))
                   (locals (ll-context->locals ctx))
                   (pnames (expr-binder-names x))
                   (more (var+type?-list->var pa))
                   (pnames2 (expr-binder-names ba))))
  :disable (ll-lambda-parts ll-replacement-ok-p))

(defruled atomlam-inner-replacements
  (implies (and (var+type?-listp pa)
                (equal (expr-binder-names x)
                       (append (var+type?-list->var pa) (expr-binder-names ba)))
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        (expr-binder-names x) genv))
           (lmap-replacements-ok-p (ll-context->lmap (%actx))
                                   (ll-context->locals (%actx))
                                   (expr-binder-names ba)
                                   genv))
  :use ((:instance lmap-replacements-ok-p-when-pointwise
                   (lmap (ll-context->lmap (%actx)))
                   (locals (ll-context->locals (%actx)))
                   (pnames (expr-binder-names ba)))
        (:instance atomlam-inner-replacement-at
                   (k (lmap-replacements-pointwise-p-witness
                       (ll-context->lmap (%actx))
                       (ll-context->locals (%actx))
                       (expr-binder-names ba)
                       genv))))
  :expand ((lmap-replacements-pointwise-p
            (ll-context->lmap (%actx)) (ll-context->locals (%actx))
            (expr-binder-names ba) genv))
  :disable (ll-lambda-parts ll-replacement-ok-p lmap-replacements-ok-p))

(defruled ll-context-ok-p-of-atomlam-inner
  (implies (and (%atomlam-shape-hyps)
                (ll-context-ok-p x ctx genv))
