           (equal (set::difference s nil) s)))

(defruled expr-free-expr-vars-when-atom-kind
  (implies (equal (expr-kind e) :atom)
           (equal (expr-free-expr-vars e)
                  (atom-free-expr-vars (expr-atom->atom e))))
  :expand ((expr-free-expr-vars e)))

(defruled lifted-closure-env-facts
  (implies (and (%lifted-atom-hyps)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv))
           (let ((lam (%lam))
                 (fvx (expr-free-expr-vars x)))
             (and (string-expr-value-map-ll-related-p
                   new-denv (expr-denv->exprs denv) fvx (%nfvx) ctx dw genv)
                  (new-values-meet-types-p (set::intersect
                                            (%nfvx)
                                            (ll-context->locals ctx))
                                           new-denv (ll-context->tenv ctx)))))
  :use lifted-atom-transform-facts
  :expand ((expr-denv-ll-related-p new-denv denv x ctx nil dw genv))
  :enable (difference-of-nil-when-setp emptyp-when-not-consp-setp
           union-of-emptyp-right)
  :disable (ll-context-ok-p ll-lambda-parts ll-expr lambda-closure
            apply-to-names string-expr-value-map-ll-related-p
            new-values-meet-types-p names-bound-as-in-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled lifted-closure-fv-subset
  (implies (and (equal (expr-kind x) :atom)
                (equal (expr-atom->atom x) (make-atom-lambda/lambdan pa ba ta)))
           (let ((fvx (expr-free-expr-vars x))
                 (fvv
                  (atom-free-expr-vars (make-atom-lambda/lambdan pa ba ta))))
             (set::subset (set::intersect
                           (set::difference
                            (expr-free-expr-vars (mv-nth 1 (%lp)))
                            (set::mergesort (var+type?-list->var (%ps))))
                           (string-sfix fvv))
