(defruled posp-of-len-when-consp-local
  (implies (consp x) (posp (len x))))

(defun two-cdrs-induct (x y)
  (if (not (consp x))
      y
    (two-cdrs-induct (cdr x) (cdr y))))

(defun three-cdrs-induct-eq (x y z)
  (if (not (consp x))
      (list y z)
    (three-cdrs-induct-eq (cdr x) (cdr y) (cdr z))))

