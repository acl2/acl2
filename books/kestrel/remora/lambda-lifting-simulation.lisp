;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The list-level lemmas and the array primitives below were developed with
; arithmetic-3 loaded; it is included locally for their proofs only.

(encapsulate ()

(local (include-book "arithmetic-3/top" :dir :system))

; List-level helpers for the array primitives: indexing, reversal, and the
; chunking/transposition/flattening of related (existentially) value lists.

(local
 (defun nth-two-induct (i x y)
   (if (zp i)
       (list x y)
     (nth-two-induct (1- i) (cdr x) (cdr y)))))

(defruled expr-value-list-ll-related-via-p-of-append-gen
  (implies (and (expr-value-list-ll-related-p new-vals1 vals1 ws1 genv)
                (expr-value-list-ll-related-p new-vals2 vals2 ws2 genv))
           (expr-value-list-ll-related-p (append new-vals1 new-vals2)
                                         (append vals1 vals2) (append
                                                               (take (len vals1)
                                                                     ws1) ws2)
                                                                     genv))
  :induct (three-cdrs-induct-eq new-vals1 vals1 ws1)
  :enable (expr-value-list-ll-related-p take len))

(defruled expr-value-list-ll-equiv-p-of-append-gen
  (implies (and (expr-value-list-ll-equiv-p new-vals1 vals1 genv)
                (expr-value-list-ll-equiv-p new-vals2 vals2 genv))
           (expr-value-list-ll-equiv-p (append new-vals1 new-vals2)
                                       (append vals1 vals2) genv))
  :expand ((expr-value-list-ll-equiv-p new-vals1 vals1 genv)
           (expr-value-list-ll-equiv-p new-vals2 vals2 genv))
  :use ((:instance expr-value-list-ll-equiv-p-suff
                   (new-vals (append new-vals1 new-vals2))
                   (vals (append vals1 vals2))
                   (ws (append (take (len vals1)
                                     (expr-value-list-ll-equiv-p-witness
                                      new-vals1 vals1 genv))
                               (expr-value-list-ll-equiv-p-witness new-vals2
                                                                   vals2
                                                                   genv)))))
  :enable expr-value-list-ll-related-via-p-of-append-gen)

(defruled nth-when-expr-value-list-ll-equiv-p
  (implies (and (expr-value-list-ll-equiv-p new-vals vals genv)
                (natp i)
                (< i (len vals)))
           (expr-value-ll-equiv-p (nth i new-vals) (nth i vals) genv))
  :induct (nth-two-induct i vals new-vals)
  :enable (nth
           consp-when-expr-value-list-ll-equiv-p
           expr-value-ll-equiv-p-of-car-when-list-ll-equiv
           expr-value-list-ll-equiv-p-of-cdr-when-list-ll-equiv))

(defruled expr-value-list-ll-equiv-p-of-singleton-when-equiv
  (implies (expr-value-ll-equiv-p new-val val genv)
           (expr-value-list-ll-equiv-p (list new-val) (list val) genv))
  :expand ((expr-value-ll-equiv-p new-val val genv))
  :enable expr-value-list-ll-equiv-p-of-singleton)

(defruled expr-value-list-ll-equiv-p-of-rev
  (implies (expr-value-list-ll-equiv-p new-vals vals genv)
           (expr-value-list-ll-equiv-p (rev new-vals) (rev vals) genv))
  :induct (two-cdrs-induct vals new-vals)
  :enable (rev
           consp-when-expr-value-list-ll-equiv-p
           expr-value-ll-equiv-p-of-car-when-list-ll-equiv
           expr-value-list-ll-equiv-p-of-cdr-when-list-ll-equiv
           expr-value-list-ll-equiv-p-of-singleton-when-equiv
           expr-value-list-ll-equiv-p-of-append
           expr-value-list-ll-equiv-p-of-nil))

; Lists of lists.

(define expr-value-list-list-ll-equiv-p ((new-valss expr-value-list-listp)
                                            (valss expr-value-list-listp) genv)
  :returns (yes/no booleanp)
  :verify-guards nil
  (if (not (consp valss))
      (not (consp new-valss))
    (and (consp new-valss)
         (expr-value-list-ll-equiv-p (car new-valss) (car valss) genv)
         (expr-value-list-list-ll-equiv-p (cdr new-valss) (cdr valss) genv))))

(defruled expr-value-list-ll-equiv-p-of-cons
  (implies (and (expr-value-ll-equiv-p new-val val genv)
                (expr-value-list-ll-equiv-p new-vals vals genv))
           (expr-value-list-ll-equiv-p (cons new-val new-vals) (cons val vals)
                                       genv))
  :expand ((expr-value-ll-equiv-p new-val val genv)
           (expr-value-list-ll-equiv-p new-vals vals genv))
  :use ((:instance expr-value-list-ll-equiv-p-suff
                   (new-vals (cons new-val new-vals))
                   (vals (cons val vals))
                   (ws (cons (expr-value-ll-equiv-p-witness new-val val genv)
                             (expr-value-list-ll-equiv-p-witness new-vals vals
                                                                 genv)))))
  :enable expr-value-list-ll-related-p)

(defruled expr-value-list-ll-equiv-p-of-cdr
  (implies (expr-value-list-ll-equiv-p new-vals vals genv)
           (expr-value-list-ll-equiv-p (cdr new-vals) (cdr vals) genv))
  :use (expr-value-list-ll-equiv-p-of-cdr-when-list-ll-equiv
        consp-when-expr-value-list-ll-equiv-p)
  :enable expr-value-list-ll-equiv-p-of-nil)

(defruled expr-value-list-ll-equiv-p-of-take
  (implies (and (expr-value-list-ll-equiv-p new-vals vals genv)
                (<= (nfix n) (len vals)))
           (expr-value-list-ll-equiv-p (take n new-vals) (take n vals) genv))
  :induct (nth-two-induct n vals new-vals)
  :enable (take
           consp-when-expr-value-list-ll-equiv-p
           expr-value-ll-equiv-p-of-car-when-list-ll-equiv
           expr-value-list-ll-equiv-p-of-cdr-when-list-ll-equiv
           expr-value-list-ll-equiv-p-of-cons
           expr-value-list-ll-equiv-p-of-nil))

(defruled expr-value-list-ll-equiv-p-of-nthcdr
  (implies (expr-value-list-ll-equiv-p new-vals vals genv)
           (expr-value-list-ll-equiv-p (nthcdr n new-vals) (nthcdr n vals)
                                       genv))
  :induct (nth-two-induct n vals new-vals)
  :enable (nthcdr
           expr-value-list-ll-equiv-p-of-cdr))

(local
 (defruled len-of-nthcdr-upper-local
   (<= (len (nthcdr n x)) (len x))
   :induct (nthcdr n x)
   :enable (nthcdr len)))

(local
 (defruled len-of-nthcdr-lt-when-posp
   (implies (and (consp x) (posp n))
            (< (len (nthcdr n x)) (len x)))
   :expand ((nthcdr n x) (len x))
   :use ((:instance len-of-nthcdr-upper-local (n (1- n)) (x (cdr x))))))

(local
 (defun list-split-two-induct (x y chunk)
   (declare (xargs :measure (len x)
                   :hints (("Goal"
                            :use (:instance len-of-nthcdr-lt-when-posp
                                            (n (pos-fix chunk)))))))
   (if (or (not (consp x)) (zp (pos-fix chunk)))
       (list y chunk)
     (list-split-two-induct (nthcdr (pos-fix chunk) x)
                            (nthcdr (pos-fix chunk) y)
                            chunk))))

(local
 (defruled len-of-nthcdr-local
   (equal (len (nthcdr n x))
          (nfix (- (len x) (nfix n))))
   :induct (nthcdr n x)
   :enable (nthcdr len nfix)))

(defruled expr-value-list-list-ll-equiv-p-of-list-split
  (implies (and (expr-value-list-ll-equiv-p new-vals vals genv)
                (posp chunk)
                (integerp (/ (len vals) chunk)))
           (expr-value-list-list-ll-equiv-p (list-split new-vals chunk)
                                               (list-split vals chunk) genv))
  :induct (list-split-two-induct vals new-vals chunk)
  :enable (list-split
           expr-value-list-list-ll-equiv-p
           consp-when-expr-value-list-ll-equiv-p
           len-when-expr-value-list-ll-equiv-p
           expr-value-list-ll-equiv-p-of-take
           expr-value-list-ll-equiv-p-of-nthcdr
           len-of-nthcdr-local
           fix nfix
           lt-to-zero-when-divided-by-pos)
  :hints ('(:use (:instance integerp-of-div-of-diff
                            (x (len vals))
                            (c (pos-fix chunk))))))

(defruled expr-value-list-ll-equiv-p-of-append-all
  (implies (expr-value-list-list-ll-equiv-p new-valss valss genv)
           (expr-value-list-ll-equiv-p (append-all new-valss) (append-all valss)
                                       genv))
  :induct (two-cdrs-induct valss new-valss)
  :enable (append-all
           expr-value-list-list-ll-equiv-p
           expr-value-list-ll-equiv-p-of-append-gen
           expr-value-list-ll-equiv-p-of-nil))

(defruled consp-of-car-when-expr-value-list-listp-and-non-nil
  (implies (and (expr-value-list-listp x)
                (consp x)
                (car x))
           (consp (car x))))

(defruled expr-value-list-ll-equiv-p-of-car-list
  (implies (and (expr-value-list-list-ll-equiv-p new-valss valss genv)
                (expr-value-list-listp valss)
                (not (member-equal nil valss)))
           (expr-value-list-ll-equiv-p (car-list new-valss) (car-list valss)
                                       genv))
  :induct (two-cdrs-induct valss new-valss)
  :enable (car-list
           expr-value-list-list-ll-equiv-p
           consp-when-expr-value-list-ll-equiv-p
           consp-of-car-when-expr-value-list-listp-and-non-nil
           expr-value-ll-equiv-p-of-car-when-list-ll-equiv
           expr-value-list-ll-equiv-p-of-cons
           expr-value-list-ll-equiv-p-of-nil))

(defruled expr-value-list-ll-equiv-p-of-true-list-fix
  (implies (expr-value-list-ll-equiv-p new-vals vals genv)
           (expr-value-list-ll-equiv-p (true-list-fix new-vals)
                                       (true-list-fix vals) genv))
  :induct (two-cdrs-induct vals new-vals)
  :enable (true-list-fix
           consp-when-expr-value-list-ll-equiv-p
           expr-value-ll-equiv-p-of-car-when-list-ll-equiv
           expr-value-list-ll-equiv-p-of-cdr-when-list-ll-equiv
           expr-value-list-ll-equiv-p-of-cons
           expr-value-list-ll-equiv-p-of-nil))

(defruled expr-value-list-list-ll-equiv-p-of-cdr-list
  (implies (expr-value-list-list-ll-equiv-p new-valss valss genv)
           (expr-value-list-list-ll-equiv-p (cdr-list new-valss)
                                            (cdr-list valss) genv))
  :induct (two-cdrs-induct valss new-valss)
  :enable (cdr-list
           expr-value-list-list-ll-equiv-p
           expr-value-list-ll-equiv-p-of-cdr
           expr-value-list-ll-equiv-p-of-true-list-fix))

(defruled len-of-car-when-all-of-len-p
  (implies (and (all-of-len-p x n)
                (consp x))
           (equal (len (car x)) (nfix n)))
  :enable all-of-len-p)

(defruled not-member-nil-when-all-of-len-p-posp
  (implies (and (all-of-len-p x n)
                (posp n))
           (not (member-equal nil x)))
  :induct (len x)
  :enable (all-of-len-p len))

(defruled all-of-len-p-of-cdr-list-of-len-car
  (implies (and (all-of-len-p x (len (car x)))
                (consp x)
                (consp (car x)))
           (all-of-len-p (cdr-list x) (len (car (cdr-list x)))))
  :enable (cdr-list len-of-car-when-all-of-len-p)
  :use ((:instance all-of-len-p-of-cdr-list
                   (lists x)
                   (len (len (car x)))
                   (n (1- (len (car x)))))))

(local
 (defun transpose-two-induct (x y)
   (declare (xargs :measure (len (car x))
                   :hints (("Goal" :expand ((cdr-list x))))))
   (cond ((endp x) (list y))
         ((endp (car x)) (list y))
         (t (transpose-two-induct (cdr-list x) (cdr-list y))))))

(defruled expr-value-list-list-ll-equiv-p-of-transpose-list-list
  (implies (and (expr-value-list-list-ll-equiv-p new-valss valss genv)
                (expr-value-list-listp valss)
                (all-of-len-p valss (len (car valss))))
           (expr-value-list-list-ll-equiv-p (transpose-list-list new-valss)
