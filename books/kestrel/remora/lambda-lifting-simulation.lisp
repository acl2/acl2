; The statement for EVAL-APP-CELL.

(defmacro %acw () '(eval-app-cell-ll-ok-witness funcell argcell limit))

(defruled eval-app-cell-not-error-kinds
  (implies (not (reserrp (eval-app-cell funcell argcell limit)))
           (member-equal (expr-value-kind funcell) '(:lambda :primop)))
  :expand ((eval-app-cell funcell argcell limit)))

(defruled eval-app-cell-ll-ok-when-ok
  (implies (and (implies (equal (expr-value-kind funcell) :lambda)
                         (eval-expr-ll-ok
                          (expr-value-lambda->body funcell)
                          (expr-denv-add-expr
                           (var+typevalue->var
                            (expr-value-lambda->param funcell))
                           argcell
                           (expr-value-lambda->denv funcell))
                          (1- limit)))
                (implies (equal (expr-value-kind funcell) :primop)
                         (eval-primop-fun-ll-ok
                          (expr-value-primop->val funcell) argcell
                          (1- limit))))
           (eval-app-cell-ll-ok funcell argcell limit))
  :expand ((eval-app-cell-ll-ok funcell argcell limit))
  :use (eval-app-cell-not-error-kinds
        (:instance eval-app-cell-ll-reaches-p-when-lambda-last
                   (f funcell) (a argcell)
                   (nf (mv-nth 0 (%acw))) (na (mv-nth 1 (%acw)))
                   (w (mv-nth 2 (%acw))) (w2 (mv-nth 3 (%acw)))
                   (genv (mv-nth 4 (%acw))))
        (:instance eval-app-cell-ll-reaches-p-when-lambda-more-nonflat
                   (f funcell) (a argcell)
                   (nf (mv-nth 0 (%acw))) (na (mv-nth 1 (%acw)))
                   (w (mv-nth 2 (%acw))) (w2 (mv-nth 3 (%acw)))
                   (genv (mv-nth 4 (%acw))))
        (:instance eval-app-cell-ll-reaches-p-when-lambda-more-flat
                   (f funcell) (a argcell)
                   (nf (mv-nth 0 (%acw))) (na (mv-nth 1 (%acw)))
                   (w (mv-nth 2 (%acw))) (w2 (mv-nth 3 (%acw)))
                   (genv (mv-nth 4 (%acw))))
        (:instance eval-app-cell-ll-reaches-p-when-primop
                   (f funcell) (a argcell)
                   (nf (mv-nth 0 (%acw))) (na (mv-nth 1 (%acw)))
                   (w (mv-nth 2 (%acw))) (w2 (mv-nth 3 (%acw)))
                   (genv (mv-nth 4 (%acw)))))
  :disable (eval-app-cell eval-app-cell-ll-reaches-p eval-expr-ll-ok
            eval-primop-fun-ll-ok expr-value-ll-related-p))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; EVAL-APP-LIST: the cells are applied pairwise.

(defruled posp-limit-when-eval-app-list-ok
  (implies (not (reserrp (eval-app-list funcells argcells limit)))
           (posp limit))
  :expand ((eval-app-list funcells argcells limit)))

(defruled eval-app-list-ll-reaches-p-elim
  (implies (eval-app-list-ll-reaches-p new-funcells new-argcells vals genv)
           (b* (((mv l ws)
                 (eval-app-list-ll-reaches-p-witness new-funcells new-argcells
                                                     vals genv))
                (nvs (eval-app-list new-funcells new-argcells l)))
             (and (not (reserrp nvs))
                  (expr-value-list-ll-related-p nvs vals ws genv))))
  :enable eval-app-list-ll-reaches-p)

(defruled eval-app-list-when-ok-local
  (implies (not (reserrp (eval-app-list fs as l)))
           (and (posp l)
                (implies (not (consp fs)) (equal (eval-app-list fs as l) nil))
                (implies (consp fs)
                         (and (consp as)
                              (expr-value-wfp (car as))
                              (not (reserrp (eval-app-cell (car fs) (car as)
                                                           (1- l))))
                              (not (reserrp (eval-app-list (cdr fs) (cdr as)
                                                           (1- l))))
                              (equal (eval-app-list fs as l)
                                     (cons (eval-app-cell (car fs) (car as)
                                                          (1- l))
                                           (eval-app-list (cdr fs) (cdr as)
                                                          (1- l))))))))
  :expand ((eval-app-list fs as l)))

(defruled eval-app-list-of-nil-at-limit
  (implies (and (not (consp fs)) (posp l))
           (equal (eval-app-list fs as l) nil))
  :expand ((eval-app-list fs as l)))

(defruled eval-app-list-of-cons-at-sum
  (implies (and (consp fs)
                (consp as)
                (expr-value-wfp (car as))
                (not (reserrp (eval-app-cell (car fs) (car as) l1)))
                (not (reserrp (eval-app-list (cdr fs) (cdr as) l2))))
           (equal (eval-app-list fs as (+ 1 l1 l2))
                  (cons (eval-app-cell (car fs) (car as) l1)
                        (eval-app-list (cdr fs) (cdr as) l2))))
  :use ((:instance posp-limit-when-eval-app-cell-ok
                   (funcell (car fs)) (argcell (car as)) (limit l1))
        (:instance posp-limit-when-eval-app-list-ok
                   (funcells (cdr fs)) (argcells (cdr as)) (limit l2))
        (:instance eval-app-cell-at-larger-limit
                   (funcell (car fs)) (argcell (car as))
                   (limit l1) (limit2 (+ l1 l2)))
        (:instance eval-app-list-of-larger-limit
                   (funcells (cdr fs)) (argcells (cdr as)) (limit l2)
                   (k l1)))
  :expand ((eval-app-list fs as (+ 1 l1 l2))))

(defruled eval-app-list-ll-reaches-p-of-cons-generic
  (implies (and (consp nfs)
                (consp nas)
                (expr-value-wfp (car nas))
                (not (reserrp (eval-app-cell (car nfs) (car nas) l1)))
                (expr-value-ll-related-p (eval-app-cell (car nfs) (car nas) l1)
                                         v w1 genv)
                (not (reserrp (eval-app-list (cdr nfs) (cdr nas) l2)))
                (expr-value-list-ll-related-p
                 (eval-app-list (cdr nfs) (cdr nas) l2) vs ws2 genv)
                (equal vals (cons v vs)))
           (eval-app-list-ll-reaches-p nfs nas vals genv))
  :use ((:instance eval-app-list-of-cons-at-sum (fs nfs) (as nas))
        (:instance eval-app-list-ll-reaches-p-suff
                   (new-funcells nfs) (new-argcells nas) (val vals)
                   (limit2 (+ 1 l1 l2)) (w (cons w1 ws2))))
  :expand ((:free (a b c d e f)
                  (expr-value-list-ll-related-p (cons a b) (cons c d) (cons e f)
                                                genv)))
  :disable (eval-app-cell eval-app-list eval-app-list-ll-reaches-p-suff
            expr-value-ll-related-p)
  :enable (not-reserrp-when-expr-value-listp expr-valuep-when-result-not-error
           expr-value-listp-when-result-not-error))

(defmacro %alw () '(eval-app-list-ll-ok-witness funcells argcells limit))

(defmacro %alnf () '(mv-nth 0 (%alw)))

(defmacro %alna () '(mv-nth 1 (%alw)))

(defmacro %alws1 () '(mv-nth 2 (%alw)))

(defmacro %alws2 () '(mv-nth 3 (%alw)))

(defmacro %alg () '(mv-nth 4 (%alw)))

(defruled eval-app-list-ll-reaches-p-of-cons-step
  (implies (and (consp nfs)
                (consp nas)
                (eval-app-cell-ll-ok f a l)
                (eval-app-list-ll-ok fs as l)
                (not (reserrp (eval-app-cell f a l)))
                (not (reserrp (eval-app-list fs as l)))
                (expr-value-ll-related-p (car nfs) f w1 g)
                (expr-value-ll-related-p (car nas) a w2 g)
                (expr-value-list-ll-related-p (cdr nfs) fs ws1 g)
                (expr-value-list-ll-related-p (cdr nas) as ws2 g)
                (expr-value-wfp f)
                (expr-value-wfp (car nfs))
                (expr-value-wfp a)
                (expr-value-wfp (car nas))
                (expr-value-list-wfp fs)
                (expr-value-list-wfp (cdr nfs))
                (expr-value-list-wfp as)
                (expr-value-list-wfp (cdr nas)))
           (eval-app-list-ll-reaches-p
            nfs nas (cons (eval-app-cell f a l) (eval-app-list fs as l)) g))
  :use ((:instance eval-app-cell-ll-ok-necc
                   (funcell f) (argcell a) (limit l)
                   (new-funcell (car nfs)) (new-argcell (car nas))
                   (genv g))
        (:instance eval-app-list-ll-ok-necc
                   (funcells fs) (argcells as) (limit l)
                   (new-funcells (cdr nfs)) (new-argcells (cdr nas))
                   (genv g))
        (:instance eval-app-cell-ll-reaches-p-elim
                   (new-funcell (car nfs)) (new-argcell (car nas))
                   (val (eval-app-cell f a l)) (genv g))
        (:instance eval-app-list-ll-reaches-p-elim
                   (new-funcells (cdr nfs)) (new-argcells (cdr nas))
                   (vals (eval-app-list fs as l)) (genv g))
        (:instance eval-app-list-ll-reaches-p-of-cons-generic
                   (l1 (mv-nth 0 (eval-app-cell-ll-reaches-p-witness
                                  (car nfs) (car nas) (eval-app-cell f a l) g)))
                   (l2 (mv-nth 0 (eval-app-list-ll-reaches-p-witness
                                  (cdr nfs) (cdr nas) (eval-app-list fs as l)
                                  g)))
                   (v (eval-app-cell f a l)) (vs (eval-app-list fs as l))
                   (w1 (mv-nth 1 (eval-app-cell-ll-reaches-p-witness
                                  (car nfs) (car nas) (eval-app-cell f a l) g)))
                   (ws2 (mv-nth 1 (eval-app-list-ll-reaches-p-witness
                                   (cdr nfs) (cdr nas) (eval-app-list fs as l)
                                   g)))
                   (vals (cons (eval-app-cell f a l) (eval-app-list fs as l)))
                   (genv g)))
  :in-theory (theory 'minimal-theory))

(defruled eval-app-list-ll-ok-when-ok
  (implies (implies (consp funcells)
                    (and (eval-app-cell-ll-ok (car funcells) (car argcells)
                                              (1- limit))
                         (eval-app-list-ll-ok (cdr funcells) (cdr argcells)
                                              (1- limit))))
           (eval-app-list-ll-ok funcells argcells limit))
  :cases ((consp funcells))
  :hints (("Subgoal 2"
           :use ((:instance eval-app-list-when-ok-local
                            (fs funcells) (as argcells) (l limit))
                 (:instance eval-app-list-of-nil-at-limit
                            (fs (%alnf)) (as (%alna)) (l limit))
                 (:instance eval-app-list-ll-reaches-p-suff
                            (new-funcells (%alnf)) (new-argcells (%alna))
                            (limit2 limit) (w nil)
                            (val (eval-app-list funcells argcells limit))
                            (genv (%alg))))
           :expand ((eval-app-list-ll-ok funcells argcells limit)
                    (expr-value-list-ll-related-p (%alnf) funcells (%alws1)
                                                  (%alg))
                    (expr-value-list-ll-related-p nil nil nil (%alg))))
          ("Subgoal 1"
           :use ((:instance eval-app-list-when-ok-local
                            (fs funcells) (as argcells) (l limit))
                 (:instance eval-app-list-ll-reaches-p-of-cons-step
                            (f (car funcells)) (a (car argcells))
                            (fs (cdr funcells)) (as (cdr argcells))
                            (l (1- limit)) (nfs (%alnf)) (nas (%alna))
                            (w1 (car (%alws1))) (w2 (car (%alws2)))
                            (ws1 (cdr (%alws1))) (ws2 (cdr (%alws2)))
                            (g (%alg))))
           :expand ((eval-app-list-ll-ok funcells argcells limit)
                    (expr-value-list-ll-related-p (%alnf) funcells (%alws1)
                                                  (%alg))
                    (expr-value-list-ll-related-p (%alna) argcells (%alws2)
                                                  (%alg)))))
  :disable (eval-app-cell eval-app-list eval-app-cell-ll-ok-necc
            eval-app-list-ll-ok-necc eval-app-list-ll-reaches-p-suff
            expr-value-ll-related-p))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; EVAL-APP: frames.  The cells of related values at a depth are related,
; via the witnesses of the cells.

(defmacro %ews (v w)
  `(if (equal (ll-value-witness-kind ,w) :ground)
       (ll-ground-ws (expr-value-vector->elems ,v))
     (ll-value-witness-vector->elems ,w)))

(mutual-recursion
 (defun ll-cells-ws (v w depth)
   (declare (xargs :measure (two-nats-measure (expr-value-count v) 1)
                   :verify-guards nil))
   (if (zp depth)
       (list w)
     (if (equal (expr-value-kind v) :vector)
         (ll-cells-ws-list (expr-value-vector->elems v) (%ews v w)
                           (1- depth))
       nil)))
 (defun ll-cells-ws-list (vs ws depth)
   (declare (xargs :measure (two-nats-measure (expr-value-list-count vs) 0)
                   :verify-guards nil))
   (if (endp vs)
       nil
     (append (ll-cells-ws (car vs) (car ws) depth)
             (ll-cells-ws-list (cdr vs) (cdr ws) depth)))))

(mutual-recursion
 (defun cells-rel-ind (nv v w depth)
   (declare (xargs :measure (two-nats-measure (expr-value-count v) 1)
                   :verify-guards nil))
   (if (zp depth)
       (list nv v w)
     (if (equal (expr-value-kind v) :vector)
         (cells-rel-ind-list (expr-value-vector->elems nv)
                             (expr-value-vector->elems v) (%ews v w)
                             (1- depth))
       nil)))
 (defun cells-rel-ind-list (nvs vs ws depth)
   (declare (xargs :measure (two-nats-measure (expr-value-list-count vs) 0)
                   :verify-guards nil))
   (if (endp vs)
       (list nvs)
     (list (cells-rel-ind (car nvs) (car vs) (car ws) depth)
           (cells-rel-ind-list (cdr nvs) (cdr vs) (cdr ws) depth)))))

(flag::make-flag cells-rel-ind-flag cells-rel-ind)

(defruled vector-related-kind
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (expr-value-kind f) :vector))
           (equal (expr-value-kind nf) :vector))
  :use vector-related-unpack)

(defruled vector-related-elems
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (expr-value-kind f) :vector)
                (not (equal (ll-value-witness-kind w) :ground)))
           (expr-value-list-ll-related-p (expr-value-vector->elems nf)
                                         (expr-value-vector->elems f)
                                         (ll-value-witness-vector->elems w)
                                         genv))
  :use vector-related-unpack)

(defruled vector-related-elems-ground
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (expr-value-kind f) :vector)
                (equal (ll-value-witness-kind w) :ground))
           (expr-value-list-ll-related-p (expr-value-vector->elems nf)
                                         (expr-value-vector->elems f)
                                         (ll-ground-ws
                                          (expr-value-vector->elems f))
                                         genv))
  :use vector-related-unpack)

(defruled expr-value-list-ll-related-p-of-append
  (implies (and (expr-value-list-ll-related-p a1 b1 w1 genv)
                (expr-value-list-ll-related-p a2 b2 w2 genv)
                (equal (len w1) (len b1)))
           (expr-value-list-ll-related-p (append a1 a2) (append b1 b2)
                                         (append w1 w2) genv))
  :induct (cdr-cdr-cdr-ind a1 b1 w1)
  :expand ((expr-value-list-ll-related-p a1 b1 w1 genv)
           (:free (x y) (expr-value-list-ll-related-p (cons x y) b w genv))
           (:free (a b c d e f)
                  (expr-value-list-ll-related-p (cons a b) (cons c d)
                                                (cons e f) genv))
           (len w1) (len b1))
  :disable (expr-value-ll-related-p))

(defthm-cells-rel-ind-flag
  (defthm cells-at-depth-when-ll-related
    (implies (and (expr-value-ll-related-p nv v w genv)
                  (not (reserrp (cells-at-depth-in-expr-value v depth))))
             (and (not (reserrp (cells-at-depth-in-expr-value nv depth)))
                  (expr-value-list-ll-related-p
                   (cells-at-depth-in-expr-value nv depth)
                   (cells-at-depth-in-expr-value v depth)
                   (ll-cells-ws v w depth) genv)
                  (equal (len (ll-cells-ws v w depth))
                         (len (cells-at-depth-in-expr-value v depth)))))
    :flag cells-rel-ind)
  (defthm cells-at-depth-list-when-ll-related
    (implies (and (expr-value-list-ll-related-p nvs vs ws genv)
                  (not (reserrp (cells-at-depth-in-expr-value-list vs depth))))
             (and (not (reserrp (cells-at-depth-in-expr-value-list nvs depth)))
                  (expr-value-list-ll-related-p
                   (cells-at-depth-in-expr-value-list nvs depth)
                   (cells-at-depth-in-expr-value-list vs depth)
                   (ll-cells-ws-list vs ws depth) genv)
                  (equal (len (ll-cells-ws-list vs ws depth))
                         (len (cells-at-depth-in-expr-value-list vs depth)))))
    :flag cells-rel-ind-list)
  :rule-classes nil
  :hints (("Goal"
           :expand ((cells-at-depth-in-expr-value nv depth)
                    (cells-at-depth-in-expr-value v depth)
                    (cells-at-depth-in-expr-value-list nvs depth)
                    (cells-at-depth-in-expr-value-list vs depth)
                    (ll-cells-ws v w depth)
                    (ll-cells-ws-list vs ws depth)
                    (expr-value-list-ll-related-p nvs vs ws genv)
                    (:free (a b) (expr-value-list-ll-related-p
                                  (list a) (list b) (list w) genv))
                    (expr-value-list-ll-related-p nil nil nil genv))
           :in-theory (e/d
                       (vector-related-kind vector-related-elems
                                            vector-related-elems-ground
                            expr-value-ll-related-p-of-fixes
                            expr-value-list-ll-related-p-of-append
                            not-reserrp-when-expr-value-listp
                            expr-value-listp-when-result-not-error)
                           (expr-value-ll-related-p)))))

(defruled expr-value-list-ll-related-p-of-repeat-2
  (implies (expr-value-ll-related-p x y w genv)
           (expr-value-list-ll-related-p (repeat n x) (repeat n y)
                                         (repeat n w) genv))
  :induct (repeat n x)
  :enable (repeat)
  :expand ((:free (a b c d e f)
                  (expr-value-list-ll-related-p (cons a b) (cons c d)
                                                (cons e f) genv))
           (expr-value-list-ll-related-p nil nil nil genv))
  :disable (expr-value-ll-related-p))

(defruled expr-value-list-ll-related-p-of-repeat-each
  (implies (and (expr-value-list-ll-related-p a b ws genv)
                (equal (len ws) (len b)))
           (and
            (expr-value-list-ll-related-p (repeat-each n a) (repeat-each n b)
                                              (repeat-each n ws) genv)
                (equal (len (repeat-each n ws)) (len (repeat-each n b)))))
  :induct (cdr-cdr-cdr-ind a b ws)
  :expand ((expr-value-list-ll-related-p a b ws genv)
           (repeat-each n a) (repeat-each n b) (repeat-each n ws)
           (len ws) (len b))
  :enable (expr-value-list-ll-related-p-of-append
           expr-value-list-ll-related-p-of-repeat-2)
  :disable (expr-value-ll-related-p))

(defruled expr-value-listp-of-repeat-each-local
  (implies (expr-value-listp l)
           (expr-value-listp (repeat-each n l)))
  :induct (len l)
  :enable (repeat-each len repeat))

(defmacro %lift-ws (v w frame pframe)
  `(repeat-each (nat-list-product (nthcdr (len ,frame) ,pframe))
                (ll-cells-ws ,v ,w (len ,frame))))

(defruled lift-expr-value-to-frame-when-ll-related
  (implies (and (expr-value-ll-related-p nv v w genv)
                (not (reserrp (lift-expr-value-to-frame v frame pframe))))
           (and (not (reserrp (lift-expr-value-to-frame nv frame pframe)))
                (expr-value-list-ll-related-p
                 (lift-expr-value-to-frame nv frame pframe)
                 (lift-expr-value-to-frame v frame pframe)
                 (%lift-ws v w frame pframe) genv)))
  :use ((:instance cells-at-depth-when-ll-related (depth (len frame)))
        (:instance expr-value-list-ll-related-p-of-repeat-each
                   (n (nat-list-product (nthcdr (len frame) pframe)))
                   (a (cells-at-depth-in-expr-value nv (len frame)))
                   (b (cells-at-depth-in-expr-value v (len frame)))
                   (ws (ll-cells-ws v w (len frame)))))
  :enable (lift-expr-value-to-frame expr-value-listp-of-repeat-each-local
           not-reserrp-when-expr-value-listp
           expr-value-listp-when-result-not-error)
  :disable (expr-value-ll-related-p expr-value-list-ll-related-p
            cells-at-depth-in-expr-value repeat-each))

; The type of a primitive operation value does not depend on the expression
; values in it.

(defruled type-of-primop-value-fun-when-related
  (implies (primop-value-ll-related-p new-op op ws genv)
           (equal (type-of-primop-value-fun new-op)
                  (type-of-primop-value-fun op)))
  :expand ((primop-value-ll-related-p new-op op ws genv))
  :enable (type-of-primop-value-fun))

(defun first-fun-ind (nv v w)
  (declare (xargs :measure (expr-value-count v)
                  :hints (("Goal" :expand ((expr-value-count v)
                                           (expr-value-list-count
                                            (expr-value-vector->elems v)))))))
  (if (and (equal (expr-value-kind v) :vector)
           (consp (expr-value-vector->elems v)))
      (first-fun-ind (car (expr-value-vector->elems nv))
                     (car (expr-value-vector->elems v))
                     (car (%ews v w)))
    (list nv v w)))

(defruled car-related-when-list-related-local
  (implies (and (expr-value-list-ll-related-p nvs vs ws genv)
                (consp vs))
           (and (consp nvs)
                (expr-value-ll-related-p (car nvs) (car vs) (car ws) genv)))
  :expand ((expr-value-list-ll-related-p nvs vs ws genv)))

(defruled first-fun-when-ll-related
  (implies (and (expr-value-ll-related-p nv v w genv)
                (not (reserrp (expr-value-first-fun v))))
           (b* ((nf (expr-value-first-fun nv))
                (f (expr-value-first-fun v)))
             (and (not (reserrp nf))
                  (equal (expr-value-kind nf) (expr-value-kind f))
                  (implies (equal (expr-value-kind f) :lambda)
                           (and (equal (expr-value-lambda->param nf)
                                       (expr-value-lambda->param f))
                                (equal (expr-value-lambda->type? nf)
                                       (expr-value-lambda->type? f))))
                  (implies (equal (expr-value-kind f) :primop)
                           (equal (type-of-primop-value-fun
                                   (expr-value-primop->val nf))
                                  (type-of-primop-value-fun
                                   (expr-value-primop->val f)))))))
  :induct (first-fun-ind nv v w)
  :expand ((expr-value-first-fun nv)
           (expr-value-first-fun v))
  :hints (("Subgoal *1/2"
           :use ((:instance lambda-related-unpack (nf nv) (f v))
                 (:instance primop-related-unpack-any (nf nv) (f v))
                 (:instance primop-value-funp-when-related
                            (new-op (expr-value-primop->val nv))
                            (op (expr-value-primop->val v))
                            (ws (%pws)))
                 (:instance type-of-primop-value-fun-when-related
                            (new-op (expr-value-primop->val nv))
                            (op (expr-value-primop->val v))
                            (ws (%pws)))))
          ("Subgoal *1/1"
           :use ((:instance vector-related-kind (nf nv) (f v))
                 (:instance vector-related-elems (nf nv) (f v))
                 (:instance vector-related-elems-ground (nf nv) (f v))
                 (:instance car-related-when-list-related-local
                            (nvs (expr-value-vector->elems nv))
                            (vs (expr-value-vector->elems v))
                            (ws (%ews v w))))))
  :enable (not-reserrp-when-expr-valuep)
  :disable (expr-value-ll-related-p primop-value-ll-related-p
            type-of-primop-value-fun primop-value-funp))

(defruled expr-value-kind-when-ll-related
  (implies (expr-value-ll-related-p nv v w genv)
           (equal (expr-value-kind nv) (expr-value-kind v)))
  :use ((:instance kind-and-primop-equal-when-fixes-equal (x nv) (y v)))
  :expand ((expr-value-ll-related-p nv v w genv))
  :disable (expr-denv-ll-related-p ll-context-ok-p primop-value-ll-related-p
            expr-value-list-ll-related-p))

(defruled fun-value-param-dims-when-ll-related
  (implies (and (expr-value-ll-related-p nv v w genv)
                (not (reserrp (fun-value-param-dims v))))
           (equal (fun-value-param-dims nv) (fun-value-param-dims v)))
  :use (first-fun-when-ll-related)
  :enable (fun-value-param-dims)
  :disable (expr-value-ll-related-p type-of-primop-value-fun))

(defruled fun-value-result-type-when-ll-related
  (implies (and (expr-value-ll-related-p nv v w genv)
                (not (reserrp (fun-value-result-type v))))
           (equal (fun-value-result-type nv) (fun-value-result-type v)))
  :cases ((equal (expr-value-kind v) :vector-empty))
  :hints (("Subgoal 1"
           :use ((:instance vector-empty-related-unpack (nf nv) (f v))
                 (:instance fun-value-result-type-of-expr-value-fix-funval
                            (funval nv))
                 (:instance fun-value-result-type-of-expr-value-fix-funval
                            (funval v)))
           :in-theory
           (disable fun-value-result-type-of-expr-value-fix-funval
                    fun-value-result-type-expr-value-equiv-congruence-on-funval
                    expr-value-ll-related-p))
          ("Subgoal 2"
           :use (first-fun-when-ll-related
                 expr-value-kind-when-ll-related)
           :in-theory (e/d (fun-value-result-type)
                           (expr-value-ll-related-p
                            type-of-primop-value-fun)))))

; An empty principal frame: related applications give equal results.

(defruled eval-app-empty-when-ll-related
  (implies (and (expr-value-ll-related-p nf f w genv)
                (expr-value-list-ll-related-p nas as ws genv)
                (expr-value-wfp nf)
                (expr-value-wfp f)
                (expr-value-list-wfp nas)
                (expr-value-list-wfp as)
                (not (reserrp (eval-app-empty f as))))
           (equal (eval-app-empty nf nas) (eval-app-empty f as)))
  :use ((:instance fun-value-param-dims-when-ll-related (nv nf) (v f))
        (:instance fun-value-result-type-when-ll-related (nv nf) (v f))
        (:instance dims-of-expr-value-when-ll-related (new-val nf) (val f))
        (:instance dims-of-expr-value-list-when-ll-related
                   (new-vals nas) (vals as))
        (:instance len-when-expr-value-list-ll-related-p
                   (new-vals nas) (vals as)))
  :expand ((eval-app-empty nf nas) (eval-app-empty f as))
  :disable (expr-value-ll-related-p expr-value-list-ll-related-p))

(defun ll-app-empty-dims (funval argvals)
  (declare (xargs :verify-guards nil))
  (b* ((param-dims (fun-value-param-dims funval))
       (arg-dims (dims-of-expr-value-list argvals))
       ((mv & arg-frames) (check-list-suffixes arg-dims param-dims))
       (fun-frame (dims-of-expr-value funval))
       ((mv & pframe) (list-prefix-join (cons fun-frame arg-frames)))
       (tval (fun-value-result-type funval))
       (cell-dims (if (and (type-valuep tval) (type-value-case tval :array))
                      (type-value-array->dims tval)
                    nil)))
    (append pframe cell-dims)))

(defruled eval-app-empty-related-to-itself
  (implies (not (reserrp (eval-app-empty f as)))
           (expr-value-ll-related-p (eval-app-empty f as) (eval-app-empty f as)
                                    (ll-empty-dim-witness
                                     (ll-app-empty-dims f as))
                                    genv))
  :expand ((eval-app-empty f as))
  :enable (expr-value-ll-related-p-of-empty-dim
           type-valuep-when-result-not-error)
  :disable (expr-value-with-empty-dim ll-empty-dim-witness))

; The frames of an application step, as EVAL-APP computes them.

(defun eval-app-frames (funval argvals)
  (declare (xargs :verify-guards nil))
  (b* ((param-dims (fun-value-param-dims funval))
       ((when (reserrp param-dims)) (mv nil nil nil nil))
       ((unless (consp param-dims)) (mv nil nil nil nil))
       (arg-dims (dims-of-expr-value (car argvals)))
       ((mv suffixp arg-frame) (check-list-suffix arg-dims (car param-dims)))
       ((unless suffixp) (mv nil nil nil nil))
       (fun-frame (dims-of-expr-value funval))
       ((mv joinp pframe) (list-prefix-join (list fun-frame arg-frame)))
       ((unless joinp) (mv nil nil nil nil)))
    (mv t pframe fun-frame arg-frame)))

(defmacro %afr (f as) `(eval-app-frames ,f ,as))

(defmacro %afc (f as)
  `(lift-expr-value-to-frame ,f (mv-nth 2 (%afr ,f ,as))
                             (mv-nth 1 (%afr ,f ,as))))

(defmacro %aac (f as)
  `(lift-expr-value-to-frame (car ,as) (mv-nth 3 (%afr ,f ,as))
                             (mv-nth 1 (%afr ,f ,as))))

(defmacro %ares (f as l) `(eval-app-list (%afc ,f ,as) (%aac ,f ,as) ,l))

(defmacro %astep (f as l)
  `(expr-value-with-nonempty-dims (mv-nth 1 (%afr ,f ,as)) (%ares ,f ,as ,l)))

(defruled eval-app-when-ok-local
  (implies (not (reserrp (eval-app f as l)))
           (and (posp l)
                (implies (not (consp as))
                         (equal (eval-app f as l) (expr-value-fix f)))
                (implies (consp as)
                         (and (mv-nth 0 (%afr f as))
                              (implies (member-equal 0 (mv-nth 1 (%afr f as)))
                                       (equal (eval-app f as l)
                                              (eval-app-empty f as)))
                              (implies
                               (not (member-equal 0 (mv-nth 1 (%afr f as))))
                               (and (not (reserrp (%afc f as)))
                                    (not (reserrp (%aac f as)))
                                    (not (reserrp (%ares f as (1- l))))
                                    (equal (len (%ares f as (1- l)))
                                           (nat-list-product
                                            (mv-nth 1 (%afr f as))))
                                    (expr-value-list-wfp (%ares f as (1- l)))
                                    (list-repeatp (dims-of-expr-value-list
                                                   (%ares f as (1- l))))
                                    (equal (eval-app f as l)
                                           (eval-app (%astep f as (1- l))
                                                     (cdr as) (1- l)))))))))
  :expand ((eval-app f as l))
  :enable (eval-app-frames))

(defruled eval-app-frames-when-ll-related
  (implies (and (expr-value-ll-related-p nf f w genv)
                (expr-value-list-ll-related-p nas as ws genv)
                (consp as)
                (expr-value-wfp nf)
                (expr-value-wfp f)
                (expr-value-list-wfp nas)
                (expr-value-list-wfp as)
                (mv-nth 0 (%afr f as)))
           (equal (%afr nf nas) (%afr f as)))
  :use ((:instance fun-value-param-dims-when-ll-related (nv nf) (v f))
        (:instance dims-of-expr-value-when-ll-related (new-val nf) (val f))
        (:instance car-related-when-list-related-local (nvs nas) (vs as))
        (:instance dims-of-expr-value-when-ll-related
                   (new-val (car nas)) (val (car as)) (w (car ws))))
  :enable (eval-app-frames)
  :disable (expr-value-ll-related-p expr-value-list-ll-related-p))

; One application step at a limit of the form (+ 1 m), proved apart so that
; the expansion of EVAL-APP does not meet the limit lemmas below.

(defruled eval-app-of-step-opener
  (implies (and (natp m)
                (consp as)
                (mv-nth 0 (%afr f as))
                (not (member-equal 0 (mv-nth 1 (%afr f as))))
                (not (reserrp (%afc f as)))
                (not (reserrp (%aac f as)))
                (not (reserrp (%ares f as m)))
                (equal (len (%ares f as m))
                       (nat-list-product (mv-nth 1 (%afr f as))))
                (expr-value-list-wfp (%ares f as m))
                (list-repeatp (dims-of-expr-value-list (%ares f as m))))
           (equal (eval-app f as (+ 1 m))
                  (eval-app (%astep f as m) (cdr as) m)))
  :expand ((eval-app f as (+ 1 m)))
  :enable (eval-app-frames)
  :disable (eval-app-list lift-expr-value-to-frame
            expr-value-with-nonempty-dims))

(defruled eval-app-of-step-at-sum
  (implies (and (consp as)
                (mv-nth 0 (%afr f as))
                (not (member-equal 0 (mv-nth 1 (%afr f as))))
                (not (reserrp (%afc f as)))
                (not (reserrp (%aac f as)))
                (not (reserrp (%ares f as l1)))
                (equal (len (%ares f as l1))
                       (nat-list-product (mv-nth 1 (%afr f as))))
                (expr-value-list-wfp (%ares f as l1))
                (list-repeatp (dims-of-expr-value-list (%ares f as l1)))
                (not (reserrp (eval-app (%astep f as l1) (cdr as) l2))))
           (equal (eval-app f as (+ 1 l1 l2))
                  (eval-app (%astep f as l1) (cdr as) l2)))
  :use ((:instance posp-limit-when-eval-app-list-ok
                   (funcells (%afc f as)) (argcells (%aac f as)) (limit l1))
        (:instance posp-limit-when-eval-app-ok
                   (funval (%astep f as l1)) (argvals (cdr as)) (limit l2))
        (:instance eval-app-list-of-larger-limit
                   (funcells (%afc f as)) (argcells (%aac f as)) (limit l1)
                   (k l2))
        (:instance eval-app-at-larger-limit
                   (funval (%astep f as l1)) (argvals (cdr as))
                   (limit l2) (limit2 (+ l1 l2)))
        (:instance eval-app-of-step-opener (m (+ l1 l2))))
  :disable (eval-app eval-app-list lift-expr-value-to-frame
            expr-value-with-nonempty-dims eval-app-frames))

(defmacro %app-rel-hyps ()
  '(and (expr-value-ll-related-p nf f w genv)
        (expr-value-list-ll-related-p nas as ws genv)
        (consp as)
        (expr-value-wfp nf)
        (expr-value-wfp f)
        (expr-value-list-wfp nas)
        (expr-value-list-wfp as)
        (mv-nth 0 (%afr f as))))

(defmacro %afcw ()
  '(%lift-ws f w (mv-nth 2 (%afr f as)) (mv-nth 1 (%afr f as))))

(defmacro %aacw ()
  '(%lift-ws (car as) (car ws) (mv-nth 3 (%afr f as)) (mv-nth 1 (%afr f as))))

(defruled eval-app-cells-when-ll-related
  (implies (and (%app-rel-hyps)
                (not (reserrp (%afc f as)))
                (not (reserrp (%aac f as))))
           (and (equal (%afr nf nas) (%afr f as))
                (not (reserrp (%afc nf nas)))
                (not (reserrp (%aac nf nas)))
                (expr-value-list-ll-related-p (%afc nf nas) (%afc f as) (%afcw)
                                              genv)
                (expr-value-list-ll-related-p (%aac nf nas) (%aac f as) (%aacw)
                                              genv)
                (expr-value-list-wfp (%afc nf nas))
                (expr-value-list-wfp (%afc f as))
                (expr-value-list-wfp (%aac nf nas))
                (expr-value-list-wfp (%aac f as))))
  :use (eval-app-frames-when-ll-related
        (:instance car-related-when-list-related-local (nvs nas) (vs as))
        (:instance lift-expr-value-to-frame-when-ll-related
                   (nv nf) (v f)
                   (frame (mv-nth 2 (%afr f as))) (pframe
                                                   (mv-nth 1 (%afr f as))))
        (:instance lift-expr-value-to-frame-when-ll-related
                   (nv (car nas)) (v (car as)) (w (car ws))
                   (frame (mv-nth 3 (%afr f as))) (pframe
                                                   (mv-nth 1 (%afr f as))))
        (:instance expr-value-list-wfp-of-lift-expr-value-to-frame
                   (val nf) (frame (mv-nth 2 (%afr f as)))
                   (pframe (mv-nth 1 (%afr f as))))
        (:instance expr-value-list-wfp-of-lift-expr-value-to-frame
                   (val f) (frame (mv-nth 2 (%afr f as)))
                   (pframe (mv-nth 1 (%afr f as))))
        (:instance expr-value-list-wfp-of-lift-expr-value-to-frame
                   (val (car nas)) (frame (mv-nth 3 (%afr f as)))
                   (pframe (mv-nth 1 (%afr f as))))
        (:instance expr-value-list-wfp-of-lift-expr-value-to-frame
                   (val (car as)) (frame (mv-nth 3 (%afr f as)))
                   (pframe (mv-nth 1 (%afr f as)))))
  :disable (expr-value-ll-related-p expr-value-list-ll-related-p
            lift-expr-value-to-frame eval-app-frames
            expr-value-list-wfp-of-lift-expr-value-to-frame))

(defmacro %aw1 ()
  '(eval-app-list-ll-reaches-p-witness (%afc nf nas) (%aac nf nas)
                                       (%ares f as (1- limit)) genv))

(defmacro %astepw ()
  '(ll-nd-witness 'one (mv-nth 1 (%afr f as))
                  (take (len (%ares f as (1- limit))) (mv-nth 1 (%aw1)))))

(defruled nat-listp-of-eval-app-frames
  (implies (mv-nth 0 (%afr f as))
           (nat-listp (mv-nth 1 (%afr f as))))
  :enable (eval-app-frames))

(defruled eval-app-step-when-ll-related
  (implies (and (%app-rel-hyps)
                (not (member-equal 0 (mv-nth 1 (%afr f as))))
                (not (reserrp (%afc f as)))
                (not (reserrp (%aac f as)))
                (not (reserrp (%ares f as (1- limit))))
                (equal (len (%ares f as (1- limit)))
                       (nat-list-product (mv-nth 1 (%afr f as))))
                (expr-value-list-wfp (%ares f as (1- limit)))
                (list-repeatp (dims-of-expr-value-list (%ares f as (1- limit))))
                (eval-app-list-ll-ok (%afc f as) (%aac f as) (1- limit)))
           (b* ((l1 (mv-nth 0 (%aw1)))
                (nres (%ares nf nas l1)))
             (and (not (reserrp nres))
                  (equal (len nres) (nat-list-product (mv-nth 1 (%afr f as))))
                  (expr-value-list-wfp nres)
                  (list-repeatp (dims-of-expr-value-list nres))
                  (expr-value-ll-related-p (%astep nf nas l1)
                                           (%astep f as (1- limit))
                                           (%astepw) genv)
                  (expr-value-wfp (%astep nf nas l1))
                  (expr-value-wfp (%astep f as (1- limit))))))
  :use (eval-app-cells-when-ll-related
        nat-listp-of-eval-app-frames
        (:instance eval-app-list-ll-ok-necc
                   (funcells (%afc f as)) (argcells (%aac f as))
                   (limit (1- limit))
                   (new-funcells (%afc nf nas)) (new-argcells (%aac nf nas))
                   (ws1 (%afcw)) (ws2 (%aacw)))
        (:instance eval-app-list-ll-reaches-p-elim
                   (new-funcells (%afc nf nas)) (new-argcells (%aac nf nas))
                   (vals (%ares f as (1- limit))))
        (:instance len-when-expr-value-list-ll-related-p
                   (new-vals (%ares nf nas (mv-nth 0 (%aw1))))
                   (vals (%ares f as (1- limit)))
                   (ws (mv-nth 1 (%aw1))))
        (:instance expr-value-list-wfp-of-eval-app-list
                   (funcells (%afc nf nas)) (argcells (%aac nf nas))
                   (limit (mv-nth 0 (%aw1))))
        (:instance dims-of-expr-value-list-when-ll-related
                   (new-vals (%ares nf nas (mv-nth 0 (%aw1))))
                   (vals (%ares f as (1- limit)))
                   (ws (mv-nth 1 (%aw1))))
        (:instance expr-value-ll-related-p-of-nonempty-dims
                   (dims (mv-nth 1 (%afr f as)))
                   (nvals (%ares nf nas (mv-nth 0 (%aw1))))
                   (vals (%ares f as (1- limit)))
                   (ws (mv-nth 1 (%aw1))))
        (:instance expr-value-wfp-of-expr-value-with-nonempty-dims
                   (dims (mv-nth 1 (%afr f as)))
                   (vals (%ares nf nas (mv-nth 0 (%aw1)))))
        (:instance expr-value-wfp-of-expr-value-with-nonempty-dims
                   (dims (mv-nth 1 (%afr f as)))
                   (vals (%ares f as (1- limit)))))
  :enable (expr-value-listp-when-result-not-error)
  :disable (expr-value-ll-related-p expr-value-list-ll-related-p
            lift-expr-value-to-frame eval-app-frames eval-app-list
            eval-app-list-ll-ok eval-app-list-ll-ok-necc
            eval-app-list-ll-reaches-p expr-value-with-nonempty-dims
            expr-value-list-wfp-of-eval-app-list
            expr-value-wfp-of-expr-value-with-nonempty-dims))

(defruled eval-app-of-empty-frame
  (implies (and (consp as)
                (mv-nth 0 (%afr f as))
                (member-equal 0 (mv-nth 1 (%afr f as)))
                (posp l))
           (equal (eval-app f as l) (eval-app-empty f as)))
  :expand ((eval-app f as l))
  :enable (eval-app-frames))

(defruled eval-app-ll-reaches-p-when-no-args
  (implies (and (not (consp as))
                (not (reserrp (eval-app f as limit)))
                (expr-value-ll-related-p nf f w genv)
                (expr-value-list-ll-related-p nas as ws genv))
           (eval-app-ll-reaches-p nf nas (eval-app f as limit) genv))
  :use ((:instance eval-app-when-ok-local (l limit))
        (:instance consp-when-expr-value-list-ll-related-p
                   (nvals nas) (vals as))
        (:instance eval-app-when-endp-args (f nf) (vs nas) (limit 1))
        (:instance expr-value-ll-related-p-of-fixes (nv nf) (v f))
        (:instance eval-app-ll-reaches-p-suff
                   (new-funval nf) (new-argvals nas) (limit2 1)
                   (val (eval-app f as limit))))
  :enable (not-reserrp-when-expr-valuep)
  :disable (eval-app expr-value-ll-related-p expr-value-list-ll-related-p
            eval-app-ll-reaches-p-suff))

(defruled eval-app-ll-reaches-p-when-empty-frame
  (implies (and (%app-rel-hyps)
                (member-equal 0 (mv-nth 1 (%afr f as)))
                (not (reserrp (eval-app f as limit))))
           (eval-app-ll-reaches-p nf nas (eval-app f as limit) genv))
  :use ((:instance eval-app-when-ok-local (l limit))
        eval-app-frames-when-ll-related
        (:instance eval-app-of-empty-frame (f nf) (as nas) (l 1))
        (:instance consp-when-expr-value-list-ll-related-p
                   (nvals nas) (vals as))
        eval-app-empty-when-ll-related
        (:instance eval-app-empty-related-to-itself (as as))
        (:instance eval-app-ll-reaches-p-suff
                   (new-funval nf) (new-argvals nas) (limit2 1)
                   (w (ll-empty-dim-witness (ll-app-empty-dims f as)))
                   (val (eval-app f as limit))))
  :disable (eval-app expr-value-ll-related-p expr-value-list-ll-related-p
            eval-app-ll-reaches-p-suff eval-app-empty eval-app-frames
            ll-app-empty-dims ll-empty-dim-witness))

(defmacro %aw2 ()
  '(eval-app-ll-reaches-p-witness (%astep nf nas (mv-nth 0 (%aw1))) (cdr nas)
                                  (eval-app (%astep f as (1- limit)) (cdr as)
                                            (1- limit))
                                  genv))

(defruled cdr-related-when-list-related-local
  (implies (and (expr-value-list-ll-related-p nvs vs ws genv)
                (consp vs))
           (expr-value-list-ll-related-p (cdr nvs) (cdr vs) (cdr ws) genv))
  :expand ((expr-value-list-ll-related-p nvs vs ws genv)))

(defruled eval-app-ll-reaches-p-when-step
  (implies (and (%app-rel-hyps)
                (not (member-equal 0 (mv-nth 1 (%afr f as))))
                (not (reserrp (eval-app f as limit)))
                (eval-app-list-ll-ok (%afc f as) (%aac f as) (1- limit))
                (eval-app-ll-ok (%astep f as (1- limit)) (cdr as) (1- limit)))
           (eval-app-ll-reaches-p nf nas (eval-app f as limit) genv))
  :use ((:instance eval-app-when-ok-local (l limit))
        eval-app-cells-when-ll-related
        eval-app-step-when-ll-related
        (:instance cdr-related-when-list-related-local (nvs nas) (vs as))
        (:instance consp-when-expr-value-list-ll-related-p
                   (nvals nas) (vals as))
        (:instance eval-app-ll-ok-necc
                   (funval (%astep f as (1- limit))) (argvals (cdr as))
                   (limit (1- limit))
                   (new-funval (%astep nf nas (mv-nth 0 (%aw1))))
                   (new-argvals (cdr nas)) (w (%astepw)) (ws (cdr ws)))
        (:instance eval-app-ll-reaches-p-elim
                   (new-funval (%astep nf nas (mv-nth 0 (%aw1))))
                   (new-argvals (cdr nas))
                   (val (eval-app (%astep f as (1- limit)) (cdr as)
                                  (1- limit))))
        (:instance eval-app-of-step-at-sum
                   (f nf) (as nas) (l1 (mv-nth 0 (%aw1)))
                   (l2 (mv-nth 0 (%aw2))))
        (:instance eval-app-ll-reaches-p-suff
                   (new-funval nf) (new-argvals nas)
                   (limit2 (+ 1 (mv-nth 0 (%aw1)) (mv-nth 0 (%aw2))))
                   (w (mv-nth 1 (%aw2)))
                   (val (eval-app f as limit))))
  :disable (eval-app expr-value-ll-related-p expr-value-list-ll-related-p
            eval-app-ll-reaches-p-suff eval-app-frames eval-app-list
            lift-expr-value-to-frame expr-value-with-nonempty-dims
            eval-app-ll-ok eval-app-ll-ok-necc eval-app-list-ll-ok
            eval-app-ll-reaches-p ll-nd-witness))

; The statement for EVAL-APP.

(defmacro %aokw () '(eval-app-ll-ok-witness funval argvals limit))

(defruled eval-app-ll-ok-when-ok
  (implies (implies (and (consp argvals)
                         (mv-nth 0 (%afr funval argvals))
                         (not
                          (member-equal 0 (mv-nth 1 (%afr funval argvals)))))
                    (and (eval-app-list-ll-ok (%afc funval argvals)
                                              (%aac funval argvals) (1- limit))
                         (eval-app-ll-ok (%astep funval argvals (1- limit))
                                         (cdr argvals) (1- limit))))
           (eval-app-ll-ok funval argvals limit))
  :expand ((eval-app-ll-ok funval argvals limit))
  :use ((:instance eval-app-when-ok-local (f funval) (as argvals) (l limit))
        (:instance eval-app-ll-reaches-p-when-no-args
                   (f funval) (as argvals)
                   (nf (mv-nth 0 (%aokw))) (nas (mv-nth 1 (%aokw)))
                   (w (mv-nth 2 (%aokw))) (ws (mv-nth 3 (%aokw)))
                   (genv (mv-nth 4 (%aokw))))
        (:instance eval-app-ll-reaches-p-when-empty-frame
                   (f funval) (as argvals)
                   (nf (mv-nth 0 (%aokw))) (nas (mv-nth 1 (%aokw)))
                   (w (mv-nth 2 (%aokw))) (ws (mv-nth 3 (%aokw)))
                   (genv (mv-nth 4 (%aokw))))
        (:instance eval-app-ll-reaches-p-when-step
                   (f funval) (as argvals)
                   (nf (mv-nth 0 (%aokw))) (nas (mv-nth 1 (%aokw)))
                   (w (mv-nth 2 (%aokw))) (ws (mv-nth 3 (%aokw)))
                   (genv (mv-nth 4 (%aokw)))))
  :in-theory (theory 'minimal-theory))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; EVAL-UNBOX: the boxes are opened alike, binding the same ispace variable
; and related arrays.

(defmacro %bxw (w)
  `(if (equal (ll-value-witness-kind ,w) :ground)
       (ll-value-witness-ground)
     (ll-value-witness-box->array ,w)))

(defruled box-related-unpack
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (expr-value-kind f) :box))
           (and (equal (expr-value-kind nf) :box)
                (equal (expr-value-box->ispace nf) (expr-value-box->ispace f))
                (equal (expr-value-box->type nf) (expr-value-box->type f))
                (expr-value-ll-related-p (expr-value-box->array nf)
                                         (expr-value-box->array f)
                                         (%bxw w) genv)))
  :cases ((equal (ll-value-witness-kind w) :ground))
  :hints (("Subgoal 1"
           :use ((:instance groundp-when-related-via-ground)
                 (:instance kind-and-primop-equal-when-fixes-equal
                            (x nf) (y f))
                 (:instance expr-value-ll-related-p-of-ground-constant
                            (val (expr-value-box->array f)))
                 (:instance box-fields-equal-when-fixes-equal-local
                            (x nf) (y f)))
           :expand ((expr-value-groundp f))
           :in-theory (disable expr-value-ll-related-p
                               expr-value-ll-related-p-when-groundp))
          ("Subgoal 2"
           :expand ((expr-value-ll-related-p nf f w genv))))
  :prep-lemmas
  ((defruled box-fields-equal-when-fixes-equal-local
     (implies (equal (expr-value-fix x) (expr-value-fix y))
              (and (equal (expr-value-box->ispace x) (expr-value-box->ispace y))
                   (equal (expr-value-box->type x) (expr-value-box->type y))
                   (equal (expr-value-box->array x) (expr-value-box->array y))))
     :use ((:instance (:theorem
                       (implies (equal a b)
                                (and (equal (expr-value-box->ispace a)
                                            (expr-value-box->ispace b))
                                     (equal (expr-value-box->type a)
                                            (expr-value-box->type b))
                                     (equal (expr-value-box->array a)
                                            (expr-value-box->array b)))))
                      (a (expr-value-fix x)) (b (expr-value-fix y)))))))

(defruled value-meets-required-type-p-when-not-typed
  (implies (and (stringp n)
                (not (omap::assoc n (string-type-map-fix tenv))))
           (value-meets-required-type-p v n tenv))
  :enable (value-meets-required-type-p var-required-type
           name-to-type-option))

(defmacro %ubx-env (tg d)
  `(expr-denv-add-ispace (car ispaces) (expr-value-box->ispace ,tg) ,d))

(defruled eval-unbox-when-box-local
  (implies (and (equal (expr-value-kind tg) :box)
                (not (reserrp (eval-unbox tg ispaces var body type d l))))
           (and (posp l)
                (ispace-values-match-ispace-vars-p
                 (list (expr-value-box->ispace tg)) (list (car ispaces)))
                (implies (not (consp (cdr ispaces)))
                         (equal (eval-unbox tg ispaces var body type d l)
                                (eval-expr body
                                           (expr-denv-add-expr
                                            var (expr-value-box->array tg)
                                            (%ubx-env tg d))
                                           (1- l))))
                (implies (consp (cdr ispaces))
                         (equal (eval-unbox tg ispaces var body type d l)
                                (eval-unbox (expr-value-box->array tg)
                                            (cdr ispaces) var body type
                                            (%ubx-env tg d) (1- l))))))
  :expand ((eval-unbox tg ispaces var body type d l)))

(defruled eval-unbox-of-box-at-succ
  (implies (and (equal (expr-value-kind tg) :box)
                (ispace-values-match-ispace-vars-p
                 (list (expr-value-box->ispace tg)) (list (car ispaces)))
                (natp l))
           (and (implies (not (consp (cdr ispaces)))
                         (equal (eval-unbox tg ispaces var body type d (+ 1 l))
                                (eval-expr body
                                           (expr-denv-add-expr
                                            var (expr-value-box->array tg)
                                            (%ubx-env tg d))
                                           l)))
                (implies (consp (cdr ispaces))
                         (equal (eval-unbox tg ispaces var body type d (+ 1 l))
                                (eval-unbox (expr-value-box->array tg)
                                            (cdr ispaces) var body type
                                            (%ubx-env tg d) l)))))
  :expand ((eval-unbox tg ispaces var body type d (+ 1 l))))

; The environments extended with the same ispace variable stay related.

(defruled expr-denv-ll-related-p-of-add-ispace-both
  (implies (and (expr-denv-ll-related-p nd d y ctx excl dw genv)
                (ll-context-ok-p y ctx genv))
           (expr-denv-ll-related-p (expr-denv-add-ispace i iv nd)
                                   (expr-denv-add-ispace i iv d)
                                   y ctx excl dw genv))
  :use ((:instance ll-context-ok-p-facts-nb (x y))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (new-denv nd) (denv d) (x y))
        (:instance expr-denv-ll-related-p-when-same-exprs
                   (nd2 (expr-denv-add-ispace i iv nd))
                   (d2 (expr-denv-add-ispace i iv d))
                   (pnames (expr-binder-names y))))
  :enable (expr-denv-add-ispace)
  :disable (ll-context-ok-p expr-denv-ll-related-p lmap-replacements-ok-p))

(defmacro %ubx-hyps ()
  '(and (expr-value-ll-related-p new-target target w genv)
        (names-in-context-p (list var) ctx)
        (lmap-replacements-ok-p (ll-context->lmap ctx)
                                (ll-context->locals ctx)
                                (list var) genv)
        (not (omap::assoc var (ll-context->tenv ctx)))
        (stringp var)
        (expr-denv-ll-related-p new-denv denv body ctx (list var) dw genv)
        (ll-context-ok-p body ctx genv)
        (expr-value-wfp target)
        (expr-value-wfp new-target)
        (expr-denv-wfp denv)
        (expr-denv-wfp new-denv)))

(defmacro %ubx-e () '(expr-denv-add-expr var (expr-value-box->array target)
                                         (%ubx-env target denv)))

(defmacro %ubx-ne () '(expr-denv-add-expr var (expr-value-box->array new-target)
                                          (%ubx-env target new-denv)))

(defmacro %ubx-dw () '(ll-denv-witness-add var (%bxw w) dw))

(defruled unbox-last-env-related
  (implies (and (%ubx-hyps)
                (equal (expr-value-kind target) :box))
           (expr-denv-ll-related-p (%ubx-ne) (%ubx-e) body ctx nil (%ubx-dw)
                                   genv))
  :use ((:instance box-related-unpack (nf new-target) (f target))
        (:instance expr-denv-ll-related-p-of-add-ispace-both
                   (nd new-denv) (d denv) (y body) (excl (list var))
                   (i (car ispaces)) (iv (expr-value-box->ispace target)))
        (:instance expr-value-ll-related-p-of-fixes
                   (nv (expr-value-box->array new-target))
                   (v (expr-value-box->array target)) (w (%bxw w)))
        (:instance value-meets-required-type-p-when-not-typed
                   (n var) (tenv (ll-context->tenv ctx))
                   (v (expr-value-fix (expr-value-box->array target))))
        (:instance value-meets-required-type-p-when-not-typed
                   (n var) (tenv (ll-context->tenv ctx))
                   (v (expr-value-fix (expr-value-box->array new-target))))
        (:instance expr-denv-ll-related-p-of-add-excluded
                   (nd (%ubx-env target new-denv)) (d (%ubx-env target denv))
                   (y body) (v0 var) (pnames (list var))
                   (val (expr-value-fix (expr-value-box->array target)))
                   (nv (expr-value-fix (expr-value-box->array new-target)))
                   (w (ll-value-witness-fix (%bxw w)))))
  :expand ((names-in-context-p (list var) ctx))
  :enable (ll-denv-witness-add-of-ll-value-witness-fix)
  :disable (expr-value-ll-related-p expr-denv-ll-related-p ll-context-ok-p
            lmap-replacements-ok-p value-meets-required-type-p
            names-in-context-p))

(defmacro %ubls-w ()
  '(eval-expr-ll-reaches-p-witness
    nb (expr-denv-add-expr var (expr-value-box->array nt) (%ubx-env nt nd))
    val genv))

(defruled eval-unbox-ll-reaches-p-of-box-last-step
  (implies (and (equal (expr-value-kind nt) :box)
                (ispace-values-match-ispace-vars-p
                 (list (expr-value-box->ispace nt)) (list (car ispaces)))
                (not (consp (cdr ispaces)))
                (eval-expr-ll-reaches-p
                 nb (expr-denv-add-expr var (expr-value-box->array nt)
                                        (%ubx-env nt nd))
                 val genv))
           (eval-unbox-ll-reaches-p nt ispaces var nb type nd val genv))
  :use ((:instance eval-expr-ll-reaches-p-elim
                   (new-expr nb)
                   (new-denv (expr-denv-add-expr var (expr-value-box->array nt)
                                                 (%ubx-env nt nd))))
        (:instance posp-limit-when-eval-expr-ok
                   (expr nb)
                   (denv (expr-denv-add-expr var (expr-value-box->array nt)
                                             (%ubx-env nt nd)))
                   (limit (mv-nth 0 (%ubls-w))))
        (:instance eval-unbox-of-box-at-succ
                   (tg nt) (body nb) (d nd) (l (mv-nth 0 (%ubls-w))))
        (:instance eval-unbox-ll-reaches-p-suff
                   (new-target nt) (new-body nb) (new-denv nd)
                   (limit2 (+ 1 (mv-nth 0 (%ubls-w))))
                   (w (mv-nth 1 (%ubls-w)))))
  :in-theory (union-theories (theory 'minimal-theory)
                             '(posp natp)))

(defruled eval-unbox-ll-reaches-p-when-box-last
  (implies (and (%ubx-hyps)
                (equal (expr-value-kind target) :box)
                (not (consp (cdr ispaces)))
                (not (reserrp (eval-unbox target ispaces var body type denv
                                          limit)))
                (eval-expr-ll-ok body (%ubx-e) (1- limit)))
           (eval-unbox-ll-reaches-p new-target ispaces var
                                    (ll-context-new-expr body ctx)
                                    type new-denv
                                    (eval-unbox target ispaces var body type
                                                denv limit)
                                    genv))
  :use ((:instance eval-unbox-when-box-local (tg target) (d denv) (l limit))
        (:instance box-related-unpack (nf new-target) (f target))
        unbox-last-env-related
        (:instance eval-expr-ll-ok-necc
                   (expr body) (denv (%ubx-e)) (limit (1- limit))
                   (new-denv (%ubx-ne)) (dw (%ubx-dw)))
        (:instance expr-denv-wfp-of-expr-denv-add-expr
                   (var var) (val (expr-value-box->array target))
                   (denv (%ubx-env target denv)))
        (:instance expr-denv-wfp-of-expr-denv-add-expr
                   (var var) (val (expr-value-box->array new-target))
                   (denv (%ubx-env target new-denv)))
        (:instance eval-unbox-ll-reaches-p-of-box-last-step
                   (nt new-target) (nb (ll-context-new-expr body ctx))
                   (nd new-denv)
                   (val (eval-unbox target ispaces var body type denv limit))))
  :disable (expr-value-ll-related-p expr-denv-ll-related-p ll-context-ok-p
            lmap-replacements-ok-p names-in-context-p eval-unbox eval-expr
            eval-expr-ll-ok eval-expr-ll-ok-necc eval-expr-ll-reaches-p
            eval-unbox-ll-reaches-p eval-unbox-ll-reaches-p-suff))

(defmacro %ubms-w ()
  '(eval-unbox-ll-reaches-p-witness
    (expr-value-box->array nt) (cdr ispaces) var nb type (%ubx-env nt nd)
    val genv))

(defruled eval-unbox-ll-reaches-p-of-box-more-step
  (implies (and (equal (expr-value-kind nt) :box)
                (ispace-values-match-ispace-vars-p
                 (list (expr-value-box->ispace nt)) (list (car ispaces)))
                (consp (cdr ispaces))
                (eval-unbox-ll-reaches-p (expr-value-box->array nt)
                                         (cdr ispaces) var nb type
                                         (%ubx-env nt nd) val genv))
           (eval-unbox-ll-reaches-p nt ispaces var nb type nd val genv))
  :use ((:instance eval-unbox-ll-reaches-p-elim
                   (new-target (expr-value-box->array nt))
                   (ispaces (cdr ispaces)) (new-body nb)
                   (new-denv (%ubx-env nt nd)))
        (:instance posp-limit-when-eval-unbox-ok
                   (target (expr-value-box->array nt))
                   (ispaces (cdr ispaces)) (body nb)
                   (denv (%ubx-env nt nd))
                   (limit (mv-nth 0 (%ubms-w))))
        (:instance eval-unbox-of-box-at-succ
                   (tg nt) (body nb) (d nd) (l (mv-nth 0 (%ubms-w))))
        (:instance eval-unbox-ll-reaches-p-suff
                   (new-target nt) (new-body nb) (new-denv nd)
                   (limit2 (+ 1 (mv-nth 0 (%ubms-w))))
                   (w (mv-nth 1 (%ubms-w)))))
  :in-theory (union-theories (theory 'minimal-theory)
