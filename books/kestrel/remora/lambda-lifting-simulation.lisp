(defmacro %rcells () '(cells-at-depth-in-expr-value arg 1))

(defruled prim-reduce-when-ok-local
  (implies (not (reserrp (prim-reduce tval d s fval arg l)))
           (and (posp l)
                (equal (dims-of-expr-value arg)
                       (cons (1+ (nfix d)) (nat-list-fix s)))
                (not (reserrp (%rcells)))
                (consp (%rcells))
                (equal (prim-reduce tval d s fval arg l)
                       (prim-reduce/fold-loop (car (%rcells)) (cdr (%rcells))
                                              fval (1- l)))))
  :expand ((prim-reduce tval d s fval arg l)))

(defruled prim-reduce-at-succ
  (implies (and (natp l)
                (equal (dims-of-expr-value arg)
                       (cons (1+ (nfix d)) (nat-list-fix s)))
                (not (reserrp (%rcells)))
                (consp (%rcells)))
           (equal (prim-reduce tval d s fval arg (+ 1 l))
                  (prim-reduce/fold-loop (car (%rcells)) (cdr (%rcells))
                                         fval l)))
  :expand ((prim-reduce tval d s fval arg (+ 1 l))))

(defruled prim-fold-when-ok-local
  (implies (not (reserrp (prim-fold tval t2val d s s2 fval zval arg l)))
           (and (posp l)
                (equal (dims-of-expr-value arg)
                       (cons (1+ (nfix d)) (nat-list-fix s)))
                (equal (dims-of-expr-value zval) (nat-list-fix s2))
                (not (reserrp (%rcells)))
                (equal (prim-fold tval t2val d s s2 fval zval arg l)
                       (prim-reduce/fold-loop zval (%rcells) fval (1- l)))))
  :expand ((prim-fold tval t2val d s s2 fval zval arg l)))

(defruled prim-fold-at-succ
  (implies (and (natp l)
                (equal (dims-of-expr-value arg)
                       (cons (1+ (nfix d)) (nat-list-fix s)))
                (equal (dims-of-expr-value zval) (nat-list-fix s2))
                (not (reserrp (%rcells))))
           (equal (prim-fold tval t2val d s s2 fval zval arg (+ 1 l))
                  (prim-reduce/fold-loop zval (%rcells) fval l)))
  :expand ((prim-fold tval t2val d s s2 fval zval arg (+ 1 l))))

(defmacro %rncells () '(cells-at-depth-in-expr-value new-arg 1))

(defmacro %rws () '(ll-cells-ws arg w2 1))

