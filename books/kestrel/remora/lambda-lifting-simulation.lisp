        (:instance nested-lambda-params-consp (body in1)))
  :expand ((:free (ty) (lambda-chain in1 ty))
           (:free (a d l) (eval-atom a d l)))
  :enable (lambda-closure make-atom-lambda/lambdan not-reserrp-when-expr-valuep)
  :cases ((consp (cdr m2))
