   fresh-expr-var ll-expr ll-lambda-parts ll-context-ok-p apply-to-names
   lambda-closure ll-context-new-expr eval-expr expr-value-ll-related-p
   value-meets-required-type-p value-has-inferred-type-p expr-denv-ll-related-p
   make-atom-lambda/lambdan set::intersect-under-set-equiv
   set::difference-under-set-equiv set::union-under-set-equiv
   set::mergesort-under-set-equiv))
(defruled hoisted-var-types-ok
  (implies (and (%hstep-hyps)
                (ll-bound-value-ok-p (%v) (bind-name b) (%ctx2)))
           (ll-var-types-ok-p (bind-name b) (%v) (%ctx2)))
  :use hoisted-ctx2-facts
  :enable (ll-var-types-ok-p ll-bound-value-ok-p)
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var ll-expr
            ll-lambda-parts ll-context-ok-p lambda-closure
