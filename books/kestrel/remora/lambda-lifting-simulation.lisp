           (:free (p b) (atom-free-expr-vars (atom-ilambdan p b)))
           (atom-binder-names a)
           (ispace-var-list->name (atom-ilambdan->params a)))
  :use ((:instance atom-ilambdan-requirements (x a)))
  :enable (ll-context-new-atom ll-context-new-expr ll-context-lifted))

(defruled eval-atom-ll-reaches-p-when-ilambdan
  (b* ((x (expr-array nil (list a))))
    (implies (and (atomp a)
                  (equal (atom-kind a) :ilambdan)
                  (not (reserrp (eval-atom a denv limit)))
                  (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
