                   )
        (:instance eval-iapp-ll-reaches-p-elim
                   (new-funval (%iapp-nfv)) (ival
                                             (eval-ispace (expr-iapp->arg x)
                                                          (type-denv->ienv
                                                           (expr-denv->tenv
                                                            denv))))
                   (val
                    (eval-iapp (%iapp-fv)
                               (eval-ispace (expr-iapp->arg x)
                                            (type-denv->ienv
                                             (expr-denv->tenv denv))) (1-
                                                                       limit))))
