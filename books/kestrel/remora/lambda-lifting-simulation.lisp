                   (limit (mv-nth 0 (%ubvw))))
        (:instance expr-value-list-wfp-of-eval-unbox-list
                   (targets (expr-value-vector->elems target))
                   (limit (1- limit)))
        (:instance expr-value-list-wfp-of-eval-unbox-list
                   (targets (expr-value-vector->elems new-target))
                   (body (ll-context-new-expr body ctx)) (denv new-denv)
                   (limit (mv-nth 0 (%ubvw))))
        (:instance eval-unbox-ll-reaches-p-of-vector-generic
