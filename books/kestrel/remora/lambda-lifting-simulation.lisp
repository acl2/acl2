            set::union-under-set-equiv set::mergesort-under-set-equiv))

; The walker at the hoisted variable, after the binding.

(defmacro %hw ()
  '(ll-value-witness-lambda (%hxictx) (cdr pa) nil (%hxdw2)))

(defmacro %hdw (l)
  `(ll-denv-witness-add (bind-name b) (%hw)
                        (change-ll-denv-witness dw :limit ,l)))

(defruled replacement-sets-local
  (implies (and (set::subset fve l0)
                (not (set::in lam l2))
                (set::subset l0 l2))
           (and (equal (set::intersect (set::insert lam fve) l2)
                       (set::sfix fve))
                (equal (set::difference (set::insert lam fve) l2)
                       (set::insert lam nil))))
  :enable (set::double-containment set::pick-a-point-subset-strategy
           set::subset-in))

(defruled hoisted-step-replacement-sets
  (implies (%hstep-hyps)
           (b* ((rvars (expr-free-expr-vars
                        (apply-to-names (expr-var lam) (%hxfve))))
                (locals2 (ll-context->locals (%ctx2))))
             (and (equal (set::intersect rvars locals2) (%hxfve))
                  (equal (set::difference rvars locals2)
                         (set::insert lam nil)))))
  :use (hoisted-ctx2-facts hoisted-fve-local let-step-hoisted-shape
        (:instance free-of-hoisted-replacement (fve (%hxfve)))
        (:instance replacement-sets-local
                   (fve (%hxfve)) (l0 (ll-context->locals ctx))
                   (l2 (ll-context->locals (%ctx2)))))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var ll-expr
            ll-lambda-parts ll-context-ok-p apply-to-names
            ll-context-new-expr free-of-hoisted-replacement
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled hoisted-replacement-eval
  (implies (and (%hstep-hyps)
                (set::subset (%hxfve) (%hnfvx))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (expr-denv-wfp new-denv)
                (integerp l)
                (<= (+ 7 (len (%hxfve))) l))
           (equal (eval-expr (apply-to-names (expr-var lam) (%hxfve))
                             (expr-denv-with-names-from (set::insert lam nil)
                                                        new-denv genv)
                             l)
                  (%hxu)))
  :use (hoisted-def-closure hoisted-apply-ok hoisted-fve-local
        let-step-hoisted-shape atomlam-aps
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance eval-hoisted-replacement
                   (fv (%hxfve)) (name lam) (tenv (ll-context->tenv (%hxictx)))
                   (nd new-denv) (ps pa) (nb (%hxnb)) (ity ta))
        (:instance set::subset-in (a lam) (x (%hxfve))
                   (y (ll-context->locals ctx))))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var ll-expr
            ll-lambda-parts ll-context-ok-p apply-to-names lambda-closure
            ll-context-new-expr set::subset-in)
  :enable (hoisted-def-closure hoisted-apply-ok hoisted-fve-local
           let-step-hoisted-shape atomlam-aps))

(defruled hoisted-closure-related
  (implies (and (%hstep-hyps)
                (set::subset (%hxfve) (%hnfvx))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (not (reserrp (eval-bind b denv limit)))
                (expr-denv-wfp new-denv))
           (and (not (reserrp (%hxu)))
                (expr-value-ll-related-p
                 (%hxu) (%v)
                 (ll-value-witness-lambda (%hxictx) (cdr pa) nil (%hxdw2))
                 genv)))
  :use (hoisted-closure-hyps-hold hoisted-body-ctx-ok
        (:instance expr-value-ll-related-p-of-hoisted-closure
                   (fvx (expr-free-expr-vars (expr-let (cons b rest) body)))
                   (fvv (atom-free-expr-vars
                         (make-atom-lambda/lambdan pa ba ta)))))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var ll-expr
            ll-lambda-parts ll-context-ok-p apply-to-names lambda-closure
            ll-context-new-expr eval-expr expr-value-ll-related-p
            expr-denv-ll-related-p make-atom-lambda/lambdan))

(defruled hoisted-var-referred-ok
  (implies (and (%hstep-hyps)
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (not (reserrp (eval-bind b denv limit)))
                (expr-denv-wfp new-denv)
                (ll-bound-value-ok-p (%v) (bind-name b) (%ctx2))
                (integerp l)
                (<= (+ 7 (len (%hxfve))) l))
           (ll-var-referred-ok-p (bind-name b) (%v) new-denv (%hnfvx) (%ctx2)
                                 (%hdw l) genv))
  :use (hoisted-ctx2-facts hoisted-step-replacement-sets
