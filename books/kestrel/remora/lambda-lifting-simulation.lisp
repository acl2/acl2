; Each case is the instance of its case lemma: a computed hint picks it from
; the kind that the case assumes, so the other case lemmas are not tried.

(local
 (defun fo-ll-case-hint (clause)
   (declare (xargs :mode :program))
   (if (endp clause)
       nil
     (let ((lit (car clause)))
       (if (and (consp lit)
                (eq (car lit) 'not)
                (consp (cadr lit))
                (eq (car (cadr lit)) 'equal)
                (equal (cadr (cadr lit)) '(primop-value-kind$inline op))
                (quotep (caddr (cadr lit))))
           (let ((kind (unquote (caddr (cadr lit)))))
             `(:use ,(intern-in-package-of-symbol
                      (concatenate 'string "EVAL-PRIMOP-FUN-FO-LL-WHEN-"
                                   (symbol-name kind))
                      'fo-ll-case-hint)
               :in-theory (theory 'minimal-theory)))
         (fo-ll-case-hint (cdr clause)))))))

(defruled eval-primop-fun-fo-ll
  (implies (and (primop-value-fun-fo-p op)
                (primop-value-ll-related-p new-op op ws genv)
                (expr-value-ll-related-p new-arg arg aw genv)
                (primop-value-wfp op)
                (primop-value-wfp new-op)
                (expr-value-wfp arg)
                (expr-value-wfp new-arg))
           (b* ((val (eval-primop-fun-fo op arg))
                (new-val (eval-primop-fun-fo new-op new-arg)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-ll-equiv-p new-val val genv)))))
  :cases (
          (equal (primop-value-kind op) :int-unary)
          (equal (primop-value-kind op) :int-binary)
          (equal (primop-value-kind op) :int-binary-x)
          (equal (primop-value-kind op) :int-rel)
          (equal (primop-value-kind op) :int-rel-x)
          (equal (primop-value-kind op) :int-to-float)
          (equal (primop-value-kind op) :int-to-bool)
          (equal (primop-value-kind op) :float-unary)
          (equal (primop-value-kind op) :float-binary)
          (equal (primop-value-kind op) :float-binary-x)
          (equal (primop-value-kind op) :float-rel)
          (equal (primop-value-kind op) :float-rel-x)
          (equal (primop-value-kind op) :float-truncate)
          (equal (primop-value-kind op) :float-round)
          (equal (primop-value-kind op) :float-ceiling)
          (equal (primop-value-kind op) :float-floor)
          (equal (primop-value-kind op) :bool-unary)
          (equal (primop-value-kind op) :bool-binary)
          (equal (primop-value-kind op) :bool-binary-x)
          (equal (primop-value-kind op) :bool-rel)
          (equal (primop-value-kind op) :bool-rel-x)
          (equal (primop-value-kind op) :bool-to-int)
          (equal (primop-value-kind op) :bool-to-float)
          (equal (primop-value-kind op) :head-t-d-s)
          (equal (primop-value-kind op) :tail-t-d-s)
          (equal (primop-value-kind op) :length-t-d-s)
          (equal (primop-value-kind op) :append-t-m-n-s)
          (equal (primop-value-kind op) :append-t-m-n-s-x)
          (equal (primop-value-kind op) :reverse-t-d-s)
          (equal (primop-value-kind op) :index-t-m)
          (equal (primop-value-kind op) :index-t-m-x)
          (equal (primop-value-kind op) :index2d-t-m-n)
          (equal (primop-value-kind op) :index2d-t-m-n-x)
          (equal (primop-value-kind op) :sum-s)
          (equal (primop-value-kind op) :reshape-t-s1-s2)
          (equal (primop-value-kind op) :flatten-t-m-n-s)
          (equal (primop-value-kind op) :transpose2d-t-m-n)
          (equal (primop-value-kind op) :reduce-t-d-s)
          (equal (primop-value-kind op) :fold-t-t2-d-s-s2)
          (equal (primop-value-kind op) :fold-t-t2-d-s-s2-f)
          (equal (primop-value-kind op) :iota-d)
          (equal (primop-value-kind op) :trace-t-r-s-q)
          (equal (primop-value-kind op) :trace-t-r-s-q-x))
  :in-theory (enable primop-value-fun-fo-p)
  :hints ((fo-ll-case-hint clause)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; PRIM-REDUCE/FOLD-LOOP: each step is two cell applications followed by
; the rest of the loop; the lifted evaluation reaches the related result
; at the sum of the three limits.

(defruled prim-reduce/fold-loop-when-ok-local
  (implies (not (reserrp (prim-reduce/fold-loop acc cells fval l)))
           (and (posp l)
                (implies (not (consp cells))
                         (equal (prim-reduce/fold-loop acc cells fval l)
                                (expr-value-fix acc)))
                (implies
                 (consp cells)
                 (and (not (reserrp (eval-app-cell fval acc (1- l))))
                      (not (reserrp (eval-app-cell
                                     (eval-app-cell fval acc (1- l))
                                     (car cells) (1- l))))
                      (equal (prim-reduce/fold-loop acc cells fval l)
                             (prim-reduce/fold-loop
                              (eval-app-cell (eval-app-cell fval acc (1- l))
                                             (car cells) (1- l))
                              (cdr cells) fval (1- l)))))))
  :expand ((prim-reduce/fold-loop acc cells fval l)))

(defruled prim-reduce/fold-loop-of-endp-at-limit
  (implies (and (not (consp cells)) (posp l))
           (equal (prim-reduce/fold-loop acc cells fval l)
                  (expr-value-fix acc)))
  :expand ((prim-reduce/fold-loop acc cells fval l)))

(defruled posp-limit-when-prim-reduce/fold-loop-ok
  (implies (not (reserrp (prim-reduce/fold-loop acc cells fval limit)))
           (posp limit))
  :expand ((prim-reduce/fold-loop acc cells fval limit)))

(defruled prim-reduce/fold-loop-of-cons-at-sum
  (implies (and (consp cells)
                (not (reserrp (eval-app-cell fval acc l1)))
                (not (reserrp (eval-app-cell (eval-app-cell fval acc l1)
                                             (car cells) l2)))
                (not (reserrp (prim-reduce/fold-loop
                               (eval-app-cell (eval-app-cell fval acc l1)
                                              (car cells) l2)
                               (cdr cells) fval l3))))
           (equal (prim-reduce/fold-loop acc cells fval (+ 1 l1 l2 l3))
                  (prim-reduce/fold-loop
                   (eval-app-cell (eval-app-cell fval acc l1) (car cells) l2)
                   (cdr cells) fval l3)))
  :use ((:instance posp-limit-when-eval-app-cell-ok
                   (funcell fval) (argcell acc) (limit l1))
        (:instance posp-limit-when-eval-app-cell-ok
                   (funcell (eval-app-cell fval acc l1)) (argcell (car cells))
                   (limit l2))
        (:instance posp-limit-when-prim-reduce/fold-loop-ok
                   (acc (eval-app-cell (eval-app-cell fval acc l1)
                                       (car cells) l2))
                   (cells (cdr cells)) (limit l3))
        (:instance eval-app-cell-at-larger-limit
                   (funcell fval) (argcell acc)
                   (limit l1) (limit2 (+ l1 l2 l3)))
        (:instance eval-app-cell-at-larger-limit
                   (funcell (eval-app-cell fval acc l1)) (argcell (car cells))
                   (limit l2) (limit2 (+ l1 l2 l3)))
        (:instance prim-reduce/fold-loop-of-larger-limit
                   (acc (eval-app-cell (eval-app-cell fval acc l1)
                                       (car cells) l2))
                   (cells (cdr cells)) (limit l3) (k (+ l1 l2))))
  :expand ((prim-reduce/fold-loop acc cells fval (+ 1 l1 l2 l3)))
  :disable (eval-app-cell prim-reduce/fold-loop))

(defruled prim-reduce/fold-loop-ll-reaches-p-elim
  (implies (prim-reduce/fold-loop-ll-reaches-p new-acc new-cells new-fval val
                                               genv)
           (b* (((mv l w)
                 (prim-reduce/fold-loop-ll-reaches-p-witness
                  new-acc new-cells new-fval val genv))
                (nv (prim-reduce/fold-loop new-acc new-cells new-fval l)))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv val w genv))))
  :enable prim-reduce/fold-loop-ll-reaches-p)

(defruled prim-reduce/fold-loop-ll-reaches-p-of-cons-generic
  (implies (and (consp ncs)
                (equal nf1 (eval-app-cell nf na l1))
                (not (reserrp nf1))
                (equal na1 (eval-app-cell nf1 (car ncs) l2))
                (not (reserrp na1))
                (not (reserrp (prim-reduce/fold-loop na1 (cdr ncs) nf l3)))
                (expr-value-ll-related-p
                 (prim-reduce/fold-loop na1 (cdr ncs) nf l3) val w genv))
           (prim-reduce/fold-loop-ll-reaches-p na ncs nf val genv))
  :use ((:instance prim-reduce/fold-loop-of-cons-at-sum
                   (acc na) (cells ncs) (fval nf))
        (:instance prim-reduce/fold-loop-ll-reaches-p-suff
                   (new-acc na) (new-cells ncs) (new-fval nf)
                   (limit2 (+ 1 l1 l2 l3))))
  :disable (eval-app-cell prim-reduce/fold-loop
            prim-reduce/fold-loop-ll-reaches-p-suff expr-value-ll-related-p))

; The step lemmas, one application at a time: after the second
; application, the rest of the loop; after the first, the second
; application and the rest.

(defruled prim-reduce/fold-loop-ll-reaches-p-step2
  (implies (and (consp ncs)
                (equal nf1 (eval-app-cell nf na l1))
                (not (reserrp nf1))
                (expr-value-wfp nf1)
                (expr-value-wfp (car ncs))
                (eval-app-cell-ll-reaches-p nf1 (car ncs) v2 genv)
                (not (reserrp v2))
                (prim-reduce/fold-loop-ll-ok v2 rest fval lim)
                (not (reserrp (prim-reduce/fold-loop v2 rest fval lim)))
                (expr-value-list-ll-related-p (cdr ncs) rest ws genv)
                (expr-value-ll-related-p nf fval w2 genv)
                (expr-value-wfp v2)
                (expr-value-list-wfp rest)
                (expr-value-list-wfp (cdr ncs))
                (expr-value-wfp fval)
                (expr-value-wfp nf))
           (prim-reduce/fold-loop-ll-reaches-p
            na ncs nf (prim-reduce/fold-loop v2 rest fval lim) genv))
  :use ((:instance eval-app-cell-ll-reaches-p-elim
                   (new-funcell nf1) (new-argcell (car ncs)) (val v2))
        (:instance expr-value-wfp-of-eval-app-cell
                   (funcell nf1) (argcell (car ncs))
                   (limit (mv-nth 0 (eval-app-cell-ll-reaches-p-witness
                                     nf1 (car ncs) v2 genv))))
        (:instance prim-reduce/fold-loop-ll-ok-necc
                   (acc v2) (cells rest) (limit lim)
                   (new-acc (eval-app-cell nf1 (car ncs)
                                           (mv-nth 0
                                                   (eval-app-cell-ll-reaches-p-witness
                                                    nf1 (car ncs) v2 genv))))
                   (new-cells (cdr ncs)) (new-fval nf)
                   (w1 (mv-nth 1 (eval-app-cell-ll-reaches-p-witness
                                  nf1 (car ncs) v2 genv)))
                   (ws ws) (w2 w2))
        (:instance prim-reduce/fold-loop-ll-reaches-p-elim
                   (new-acc (eval-app-cell nf1 (car ncs)
                                           (mv-nth 0
                                                   (eval-app-cell-ll-reaches-p-witness
                                                    nf1 (car ncs) v2 genv))))
                   (new-cells (cdr ncs)) (new-fval nf)
                   (val (prim-reduce/fold-loop v2 rest fval lim)))
        (:instance prim-reduce/fold-loop-ll-reaches-p-of-cons-generic
                   (na1 (eval-app-cell nf1 (car ncs)
                                       (mv-nth 0
                                               (eval-app-cell-ll-reaches-p-witness
