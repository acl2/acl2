;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The kept-lambda case: a liftable lambda whose definition EMIT-LIFTED-LAMBDA
; does not emit is rebuilt as a lambda over the parameters LL-LAMBDA
; collects and the lifted innermost body.  Its closure is over the
; environment where the lambda is, so every variable of the body other than
; a parameter has the value it has there.

(defmacro %kept-atom-hyps ()
  '(and (%lifted-atom-hyps-base)
        (liftable-lambda-p (expr-atom->atom x) (ll-context->tenv ctx)
                           (ll-context->locals ctx) (ll-context->lmap ctx))
        (not (consp (mv-nth 1 (%emit))))))

(defmacro %katom () '(make-atom-lambda/lambdan (%ps) (%nb) (%ity)))
(defmacro %ku () '(lambda-closure (%ps) (%nb) (%ity) new-denv))
(defmacro %kudenv () '(expr-value-lambda->denv (%ku)))
(defmacro %knfvx () '(atom-free-expr-vars (%katom)))

(defruled consp-of-ll-lambda-parts-params
  (implies (consp params)
           (consp (mv-nth 0 (ll-lambda-parts params body type? ctx))))
  :induct (ll-lambda-parts params body type? ctx)
  :enable ((:induction ll-lambda-parts))
  :expand ((:free (type?) (ll-lambda-parts params body type? ctx))))

(defruled true-list-fix-when-true-listp-local
  (implies (true-listp x)
           (equal (true-list-fix x) x)))

(defrule true-list-fix-of-ll-expr-lifted
  (equal (true-list-fix (mv-nth 1 (ll-expr x tenv tlets locals lmap used)))
         (mv-nth 1 (ll-expr x tenv tlets locals lmap used)))
  :use ((:instance true-list-fix-when-true-listp-local
                   (x (mv-nth 1 (ll-expr x tenv tlets locals lmap used))))
        (:instance true-listp-when-bind-listp-compound-recognizer
                   (acl2::x
                    (mv-nth 1 (ll-expr x tenv tlets locals lmap used))))))

(defruled kept-atom-transform-facts
  (implies (%kept-atom-hyps)
           (and (equal (ll-context-new-expr x ctx) (expr-atom (%katom)))
                (equal (ll-context-lifted x ctx)
                       (ll-context-lifted (mv-nth 1 (%lp)) (%ictx)))
                (consp (%ps))))
  :use ((:instance ll-expr-of-liftable-atom
                   (tenv (ll-context->tenv ctx)) (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx)) (lmap
                                                      (ll-context->lmap ctx))
                   (used (ll-context->used ctx)))
        (:instance ll-lambda-decomposition (params pa) (body ba) (type? ta))
        (:instance consp-of-ll-lambda-parts-params
                   (params pa) (body ba) (type? ta))
        (:instance true-list-fix-when-true-listp-local
                   (x (mv-nth 1 (%ll-inner)))))
  :enable (ll-expr-of-liftable-atom ll-lambda-decomposition
           consp-of-ll-lambda-parts-params true-list-fix-when-true-listp-local
           ll-context-new-expr ll-context-lifted emit-lifted-lambda
           true-list-fix-when-true-listp-local)
  :disable
  (ll-lambda-parts ll-expr ll-lambda set::intersect-under-set-equiv
   set::difference-under-set-equiv set::mergesort-under-set-equiv
   acl2::set-equiv-implies-equal-consp-1))

(defruled kept-knfvx
  (implies (consp (%ps))
           (equal (%knfvx)
                  (set::difference (expr-free-expr-vars (%nb))
                                   (set::mergesort
                                    (var+type?-list->var (%ps))))))
  :use ((:instance atom-free-expr-vars-of-make-atom-lambda/lambdan
                   (params (%ps)) (body (%nb)) (type? (%ity))))
  :disable (ll-lambda-parts))

(defruled lookup-in-kept-closure-env
  (implies (and (consp (%ps))
                (not (reserrp (%ku)))
                (stringp n)
                (set::in n (expr-free-expr-vars (%nb)))
                (not (member-equal n (var+type?-list->var (%ps)))))
           (equal (expr-denv-lookup-expr n (%kudenv))
                  (expr-denv-lookup-expr n new-denv)))
  :use ((:instance lookup-in-lambda-closure-denv
                   (params (%ps)) (body (%nb)) (type? (%ity)) (denv new-denv)))
  :disable (ll-lambda-parts lambda-closure))

(defruled ll-var-referred-ok-p-of-kept-closure-plain
  (implies (and (stringp v)
                (not (member-equal v (var+type?-list->var (%ps))))
                (not (omap::assoc v (ll-context->lmap ctx)))
                (ll-var-referred-ok-p v val new-denv (%knfvx) ctx dw genv)
                (consp (%ps))
                (not (reserrp (%ku))))
           (ll-var-referred-ok-p v val (%kudenv) (expr-free-expr-vars (%nb))
                                 (%ictx) dw genv))
  :use ((:instance ll-lambda-parts-context-at-other
                   (params pa) (body ba) (type? ta))
        kept-knfvx
        (:instance lookup-in-kept-closure-env (n v)))
  :enable (ll-var-referred-ok-p)
  :disable (ll-lambda-parts lambda-closure
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled kept-replacement-sets
  (b* ((ic-locals (set::union (set::mergesort pnames) locals))
       (rvars (set::union (set::insert h nil) (set::mergesort hns))))
    (implies (and (stringp h)
                  (string-listp hns)
                  (string-listp pnames)
                  (string-setp locals)
                  (string-setp nbfv)
                  (not (set::in h locals))
                  (not (member-equal h pnames))
                  (subsetp-equal hns locals)
                  (not (intersectp-equal hns pnames))
                  (set::subset (set::intersect rvars ic-locals) nbfv))
             (and (set::subset (set::intersect rvars locals)
                               (set::difference nbfv (set::mergesort pnames)))
                  (equal (set::difference rvars ic-locals) (set::insert h nil))
                  (equal (set::difference rvars locals) (set::insert h nil))
                  (set::subset (set::mergesort hns) nbfv))))
  :enable (set::pick-a-point-subset-strategy set::double-containment
           set::subset-in in-when-member-of-subsetp
           not-member-when-not-intersectp)
  :disable (set::union-under-set-equiv set::intersect-under-set-equiv
            set::difference-under-set-equiv set::mergesort-under-set-equiv))

(defruled lookups-agree-p-of-kept-closure-env
  (implies (and (string-listp hns)
                (set::subset (set::mergesort hns) (expr-free-expr-vars (%nb)))
                (not (intersectp-equal hns (var+type?-list->var (%ps))))
                (consp (%ps))
                (not (reserrp (%ku))))
           (lookups-agree-p hns (%kudenv) new-denv))
  :induct (len hns)
  :enable (lookups-agree-p len intersectp-equal set::subset-in)
  :expand ((set::mergesort hns))
  :hints (("Subgoal *1/1"
           :use ((:instance lookup-in-kept-closure-env (n (car hns)))))))

(defruled ll-var-referred-ok-p-of-kept-closure-hoisted
  (implies (and (stringp v)
                (not (member-equal v (var+type?-list->var (%ps))))
                (equal (cdr (omap::assoc v (ll-context->lmap ctx)))
                       (apply-to-names (expr-var h) hns))
                (omap::assoc v (ll-context->lmap ctx))
                (stringp h)
                (string-listp hns)
                (not (set::in h (ll-context->locals ctx)))
                (not (member-equal h (var+type?-list->var (%ps))))
                (not (reserrp (expr-denv-lookup-expr h genv)))
                (subsetp-equal hns (ll-context->locals ctx))
                (not (intersectp-equal hns (var+type?-list->var (%ps))))
                (ll-var-referred-ok-p v val new-denv (%knfvx) ctx dw genv)
                (consp (%ps))
                (not (reserrp (%ku))))
           (ll-var-referred-ok-p v val (%kudenv) (expr-free-expr-vars (%nb))
                                 (%ictx) dw genv))
  :use ((:instance ll-lambda-parts-context-at-other
                   (params pa) (body ba) (type? ta))
        kept-knfvx
        (:instance kept-replacement-sets
                   (pnames (var+type?-list->var (%ps)))
                   (locals (ll-context->locals ctx))
                   (nbfv (expr-free-expr-vars (%nb))))
        (:instance lookups-agree-p-of-kept-closure-env)
        (:instance lookups-agree-p-of-with-names-from-insert
                   (d1 (%kudenv)) (d2 new-denv) (g genv))
        (:instance eval-expr-of-apply-to-names-when-agree
                   (names hns)
                   (d1 (expr-denv-with-names-from (set::insert h nil)
                                                  (%kudenv) genv))
                   (d2 (expr-denv-with-names-from (set::insert h nil)
                                                  new-denv genv))
                   (l (ll-denv-witness->limit dw)))
        (:instance lookup-of-expr-denv-with-names-from
                   (n h) (names (set::insert h nil)) (d (%kudenv)) (g genv))
        (:instance lookup-of-expr-denv-with-names-from
                   (n h) (names (set::insert h nil)) (d new-denv) (g genv))
        (:instance in-when-member-of-subsetp
                   (e h) (l hns) (s (ll-context->locals ctx))))
  :enable (ll-var-referred-ok-p ll-lambda-parts-locals)
  :expand ((:free (n) (expr-free-expr-vars (expr-var n))))
  :disable (lambda-closure ll-lambda-parts
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv
            apply-to-names))

(defruled ll-var-ok-p-of-kept-closure
  (implies (and (stringp v)
                (expr-valuep val)
                (not (member-equal v (var+type?-list->var (%ps))))
                (ll-var-ok-p v val new-denv (%knfvx) ctx dw genv)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        (var+type?-list->var (%ps))
                                        genv)
                (consp (%ps))
                (not (reserrp (%ku))))
           (ll-var-ok-p v val (%kudenv) (expr-free-expr-vars (%nb))
                        (%ictx) dw genv))
  :use ((:instance ll-var-ok-p-split (var v) (nfv (%knfvx)))
        (:instance ll-var-ok-p-split
                   (var v) (new-denv (%kudenv))
                   (nfv (expr-free-expr-vars (%nb))) (ctx (%ictx)))
        (:instance ll-var-types-ok-p-of-ll-lambda-parts
                   (params pa) (body ba) (type? ta))
        ll-var-referred-ok-p-of-kept-closure-plain
        (:instance ll-var-referred-ok-p-of-kept-closure-hoisted
                   (h (mv-nth 1 (replacement-parts
                                 (cdr (omap::assoc v (ll-context->lmap ctx))))))
                   (hns (mv-nth 2 (replacement-parts
                                   (cdr (omap::assoc v
                                                     (ll-context->lmap
                                                      ctx)))))))
        (:instance ll-replacement-ok-p-unpack
                   (repl (cdr (omap::assoc v (ll-context->lmap ctx))))
                   (locals (ll-context->locals ctx))
                   (pnames (var+type?-list->var (%ps))))
        (:instance ll-replacement-ok-p-when-lmap-replacements-ok-p
                   (lmap (ll-context->lmap ctx)) (k v)
                   (locals (ll-context->locals ctx))
                   (pnames (var+type?-list->var (%ps)))))
  :disable (ll-var-referred-ok-p ll-var-ok-p ll-var-types-ok-p
            ll-lambda-parts lambda-closure))

(defmacro %kept-env-hyps ()
  '(and (string-expr-value-map-ll-related-p
         new-denv (expr-denv->exprs denv) fvx (%knfvx) ctx dw genv)
        (set::subset (set::intersect (%fvin) (string-sfix fvv)) fvx)
        (lmap-replacements-ok-p (ll-context->lmap ctx)
                                (ll-context->locals ctx)
                                (var+type?-list->var (%ps))
                                genv)
        (consp (%ps))
        (not (reserrp (%ku)))))

(defruled walker-of-kept-closure-env-at
  (implies (and (%kept-env-hyps)
                (omap::assoc w (%vmap))
                (set::in w (%fvin)))
           (ll-var-ok-p w (cdr (omap::assoc w (%vmap)))
                        (%kudenv) (expr-free-expr-vars (%nb))
                        (%ictx) dw genv))
  :use ((:instance walker-ll-var-ok-p-at
                   (map (expr-denv->exprs denv))
                   (fv fvx) (nfv (%knfvx)) (var w))
        (:instance ll-var-ok-p-of-kept-closure
                   (v w) (val (cdr (omap::assoc w (expr-denv->exprs denv)))))
        (:instance stringp-when-assoc-of-string-expr-value-mapp
                   (m (expr-denv->exprs denv)) (k w))
        (:instance set::subset-in
                   (a w) (x (set::intersect (%fvin) (string-sfix fvv)))
                   (y fvx))
        (:instance assoc-of-restrict-when-assoc
                   (s (string-sfix fvv)) (m (expr-denv->exprs denv))))
  :disable (ll-var-ok-p omap::assoc-of-restrict
            ll-var-ok-p-of-kept-closure lambda-closure ll-lambda-parts))

(defruled walker-of-kept-closure-env
  (implies (%kept-env-hyps)
           (string-expr-value-map-ll-related-p
            (%kudenv) (%vmap) (%fvin) (expr-free-expr-vars (%nb))
            (%ictx) dw genv))
  :use ((:instance string-expr-value-map-ll-related-p-when-pointwise
                   (new-denv (%kudenv)) (map (%vmap)) (fv (%fvin))
                   (nfv (expr-free-expr-vars (%nb)))
                   (ctx (%ictx)))
        (:instance walker-of-kept-closure-env-at
                   (w (walker-pointwise-p-witness
                       (%kudenv) (%vmap) (%fvin) (expr-free-expr-vars (%nb))
                       (%ictx) dw genv))))
  :expand ((walker-pointwise-p (%kudenv) (%vmap) (%fvin)
                               (expr-free-expr-vars (%nb))
                               (%ictx) dw genv))
  :disable (ll-var-ok-p walker-pointwise-p-necc lambda-closure ll-lambda-parts))

; The other conjuncts of the environment relation, element by element.

(defruled kept-closure-names-bound-at
  (implies (and (names-bound-as-in-p (set::difference (%knfvx)
                                                      (ll-context->locals ctx))
                                     new-denv genv)
                (stringp n)
                (set::in n (expr-free-expr-vars (%nb)))
                (not (set::in n (ll-context->locals (%ictx))))
                (not (reserrp (expr-denv-lookup-expr n genv)))
                (consp (%ps))
                (not (reserrp (%ku))))
           (equal (expr-denv-lookup-expr n (%kudenv))
                  (expr-denv-lookup-expr n genv)))
  :use (kept-knfvx
        (:instance ll-lambda-parts-locals (params pa) (body ba) (type? ta))
        (:instance lookup-in-kept-closure-env)
        (:instance names-bound-as-in-p-when-in
                   (names (set::difference (%knfvx) (ll-context->locals ctx)))
                   (name n)))
  :disable (lambda-closure ll-lambda-parts
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled kept-closure-meets-type-at
  (implies (and (new-values-meet-types-p (set::intersect
                                          (%knfvx) (ll-context->locals ctx))
                                         new-denv (ll-context->tenv ctx))
                (stringp n)
                (set::in n (expr-free-expr-vars (%nb)))
                (set::in n (ll-context->locals (%ictx)))
                (not (member-equal n (var+type?-list->var (%ps))))
                (consp (%ps))
                (not (reserrp (%ku))))
           (and (not (reserrp (expr-denv-lookup-expr n (%kudenv))))
                (value-meets-required-type-p (expr-denv-lookup-expr n (%kudenv))
                                             n (ll-context->tenv (%ictx)))))
  :use (kept-knfvx
        (:instance ll-lambda-parts-locals (params pa) (body ba) (type? ta))
        (:instance lookup-in-kept-closure-env)
        (:instance new-values-meet-types-p-when-in
                   (names (set::intersect (%knfvx) (ll-context->locals ctx)))
                   (name n) (tenv (ll-context->tenv ctx)))
        (:instance ll-lambda-parts-context-at-other
                   (params pa) (body ba) (type? ta) (v n))
        (:instance value-type-conditions-when-same-type-option
                   (v n) (val (expr-denv-lookup-expr n new-denv))
                   (tenv1 (ll-context->tenv ctx))
                   (tenv2 (ll-context->tenv (%ictx)))))
  :disable (lambda-closure ll-lambda-parts value-meets-required-type-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled kept-closure-names-bound
  (implies (and (string-setp s)
                (set::subset s (set::difference (expr-free-expr-vars (%nb))
                                                (ll-context->locals (%ictx))))
                (names-bound-as-in-p (set::difference (%knfvx)
                                                      (ll-context->locals ctx))
                                     new-denv genv)
                (consp (%ps))
                (not (reserrp (%ku))))
           (names-bound-as-in-p s (%kudenv) genv))
  :induct (set-ind s)
  :enable (names-bound-as-in-p subset-of-tail-when-subset)
  :hints (("Subgoal *1/2"
           :use ((:instance set::subset-in (a (set::head s)) (x s)
                            (y (set::difference (expr-free-expr-vars (%nb))
                                                (ll-context->locals (%ictx)))))
                 (:instance kept-closure-names-bound-at (n (set::head s))))
           :in-theory (disable lambda-closure ll-lambda-parts))))

(defruled kept-closure-meets-types
  (implies (and (string-setp s)
                (set::subset s (set::difference
                                (set::intersect (expr-free-expr-vars (%nb))
                                                (ll-context->locals (%ictx)))
                                (set::mergesort (var+type?-list->var (%ps)))))
                (new-values-meet-types-p (set::intersect
                                          (%knfvx) (ll-context->locals ctx))
                                         new-denv (ll-context->tenv ctx))
                (consp (%ps))
                (not (reserrp (%ku))))
           (new-values-meet-types-p s (%kudenv) (ll-context->tenv (%ictx))))
  :induct (set-ind s)
  :enable (new-values-meet-types-p subset-of-tail-when-subset)
  :hints (("Subgoal *1/2"
           :use ((:instance set::subset-in (a (set::head s)) (x s)
                            (y (set::difference
                                (set::intersect (expr-free-expr-vars (%nb))
                                                (ll-context->locals (%ictx)))
                                (set::mergesort (var+type?-list->var (%ps))))))
                 (:instance kept-closure-meets-type-at (n (set::head s))))
           :in-theory (disable lambda-closure ll-lambda-parts
                               value-meets-required-type-p))))

(defruled kept-case-closedness
  (implies (and (%kept-atom-hyps)
                (lmap-closed-p (ll-context->lmap ctx)))
           (and (set::emptyp (var+type?-free-type-vars (car pa)))
                (set::emptyp (var+type?-free-ispace-vars (car pa)))
                (%closed-t/i type-option (%ity))
                (%closed-t/i type-option ta)
                (%closed-t/i expr (lambda-curried-body pa ba ta))
                (%closed-t/i expr (lambda-curried-body (%ps) (%nb) (%ity)))))
  :use ((:instance closed-parts-of-make-atom-lambda/lambdan
                   (params pa) (body ba) (type? ta))
        (:instance closed-parts-of-lambda-chain (body ba) (type? ta))
        (:instance ll-lambda-parts-is-lambda-chain
                   (params pa) (body ba) (type? ta))
        (:instance lmap-closed-p-of-ll-lambda-parts
                   (params pa) (body ba) (type? ta))
        (:instance free-type/ispace-vars-of-ll-expr
                   (x (mv-nth 1 (%lp)))
                   (tenv (ll-context->tenv (%ictx)))
                   (tlets (ll-context->tlets (%ictx)))
                   (locals (ll-context->locals (%ictx)))
                   (lmap (ll-context->lmap (%ictx)))
                   (used (ll-context->used (%ictx))))
        (:instance closed-lambda-curried-body
                   (params pa) (body ba) (type? ta))
        (:instance closed-lambda-curried-body
                   (params (%ps)) (body (%nb)) (type? (%ity))))
  :expand ((liftable-lambda-p (expr-atom->atom x) (ll-context->tenv ctx)
                              (ll-context->locals ctx) (ll-context->lmap ctx))
           (var+type?-list-free-type-vars pa)
           (var+type?-list-free-ispace-vars pa))
  :enable (ll-context-new-expr)
  :disable (ll-lambda-parts ll-expr lambda-chain lambda-curried-body))

(defmacro %kclosure-hyps ()
  '(and (%kept-env-hyps)
        (names-bound-as-in-p (set::difference (%knfvx) (ll-context->locals ctx))
                             new-denv genv)
        (new-values-meet-types-p (set::intersect (%knfvx)
                                                 (ll-context->locals ctx))
                                 new-denv (ll-context->tenv ctx))
        (equal fvv (atom-free-expr-vars (make-atom-lambda/lambdan pa ba ta)))
        (var+type?-listp pa)
        (consp pa)
        (exprp ba)
        (type-optionp ta)
        (not (reserrp (%v)))
        (set::emptyp (var+type?-free-type-vars (car pa)))
        (set::emptyp (var+type?-free-ispace-vars (car pa)))
        (set::emptyp (type-option-free-type-vars ta))
        (set::emptyp (type-option-free-ispace-vars ta))
        (set::emptyp (expr-free-ispace-vars (lambda-curried-body pa ba ta)))
        (set::emptyp (expr-free-type-vars (lambda-curried-body pa ba ta)))
        (set::emptyp (expr-free-ispace-vars
                      (lambda-curried-body (%ps) (%nb) (%ity))))
        (set::emptyp (expr-free-type-vars
                      (lambda-curried-body (%ps) (%nb) (%ity))))
        (no-duplicatesp-equal (var+type?-list->var (%ps)))))

(defruled kept-closure-env-related
  (implies (%kclosure-hyps)
           (expr-denv-ll-related-p (%kudenv)
                                   (expr-value-lambda->denv (%v))
                                   (mv-nth 1 (%lp))
                                   (%ictx)
                                   (var+type?-list->var (%ps))
                                   dw
                                   genv))
  :use (walker-of-kept-closure-env
        subsetp-of-params-in-ll-lambda-parts-locals
        (:instance expr-value-lambda->denv-of-lambda-closure
                   (params pa) (body ba) (type? ta))
        (:instance expr-value-lambda->denv-of-lambda-closure
                   (params (%ps)) (body (%nb)) (type? (%ity))
                   (denv new-denv))
        (:instance kept-closure-names-bound
                   (s (set::difference (expr-free-expr-vars (%nb))
                                       (ll-context->locals (%ictx)))))
        (:instance kept-closure-meets-types
                   (s (set::difference
                       (set::intersect (expr-free-expr-vars (%nb))
                                       (ll-context->locals (%ictx)))
                       (set::mergesort (var+type?-list->var (%ps)))))))
  :expand ((expr-denv-ll-related-p (%kudenv)
                                   (expr-value-lambda->denv (%v))
                                   (mv-nth 1 (%lp))
                                   (%ictx)
                                   (var+type?-list->var (%ps))
                                   dw
                                   genv))
  :enable (type-denv-restrict-of-empty expr-denv-restrict)
  :disable (walker-of-kept-closure-env lambda-closure ll-lambda-parts
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled kept-closure-ps
  (implies (%kclosure-hyps)
           (equal (%ps) (append pa (mv-nth 0 (lambda-chain ba ta)))))
  :use ((:instance ll-lambda-parts-is-lambda-chain
                   (params pa) (body ba) (type? ta))))

(defruled kept-closure-pnames
  (implies (%kclosure-hyps)
           (equal (%pn) (var+type?-list->var (%ps))))
  :use (kept-closure-ps
        (:instance lambda-closure-when-ok (params pa) (body ba) (type? ta)))
  :expand ((var+type?-list->var (append pa (mv-nth 0 (lambda-chain ba ta)))))
  :disable (lambda-closure ll-lambda-parts))

(defruled kept-closure-facts
  (implies (%kclosure-hyps)
           (and (equal (expr-value-kind (%ku)) :lambda)
                (equal (expr-value-kind (%v)) :lambda)
                (b* (((mv okp inner ity2)
                      (closure-body-parts (expr-value-lambda->body (%v))
                                          (expr-value-lambda->type? (%v))
                                          (cdr (%ps)) t)))
                  (and okp
                       (equal inner (mv-nth 1 (%lp)))
                       (equal (lifted-closure-body
                               (cdr (%ps)) (ll-context-new-expr inner (%ictx))
                               ity2)
                              (expr-value-lambda->body (%ku)))))
                (equal (expr-value-lambda->param (%ku))
                       (expr-value-lambda->param (%v)))
                (equal (expr-value-lambda->type? (%ku))
                       (expr-value-lambda->type? (%v)))))
  :use (kept-closure-ps
        (:instance expr-value-kind-of-lambda-closure
                   (params pa) (body ba) (type? ta))
        (:instance expr-value-kind-of-lambda-closure
                   (params (%ps)) (body (%nb)) (type? (%ity)) (denv new-denv))
        (:instance ll-lambda-parts-is-lambda-chain
                   (params pa) (body ba) (type? ta))
        (:instance closure-body-parts-of-lambda-curried-body
                   (params pa) (body ba) (type? ta)
                   (tyv (expr-value-lambda->type? (%v)))
                   (new-inner (%nb)))
        (:instance type?-of-lambda-closure-iff
                   (params pa) (body ba) (type? ta))
        (:instance lambda-closure-when-ok (params pa) (body ba) (type? ta))
        (:instance lambda-closure-when-ok
                   (params (%ps)) (body (%nb)) (type? (%ity)) (denv new-denv))
        (:instance lambda-closure-fields-of-chain
                   (params pa) (body ba) (type? ta)
                   (new-body (%nb)) (new-denv new-denv)))
  :disable (lambda-closure ll-lambda-parts closure-body-parts
            lifted-closure-body lambda-curried-body ll-context-new-expr))

(defruled kept-closure-context-facts
  (implies (%kclosure-hyps)
           (and (names-in-context-p (%pn) (%ictx))
                (param-type-consistent-p (expr-value-lambda->param (%v))
                                         (ll-context->tenv (%ictx)))
                (prest-tenv-consistent-p (cdr (%ps))
                                         (ll-context->tenv (%ictx)))))
  :use (kept-closure-pnames
        kept-closure-ps
        (:instance names-in-context-p-of-ll-lambda-parts
                   (params pa) (body ba) (type? ta)
                   (names (var+type?-list->var (%ps))))
        (:instance param-of-lambda-closure (params pa) (body ba) (type? ta))
        (:instance eval-var+type?-ok-when-lambda-closure-ok
                   (params pa) (body ba) (type? ta))
        (:instance param-type-consistent-p-of-ll-lambda-parts
                   (params pa) (body ba) (type? ta)
                   (tenv (expr-denv->tenv denv)))
        (:instance prest-tenv-consistent-p-of-ll-lambda-parts
                   (params pa) (body ba) (type? ta)
                   (l (cdr (%ps)))))
  :disable (lambda-closure ll-lambda-parts names-in-context-p
            param-type-consistent-p prest-tenv-consistent-p))

(local
 (defun map-ind2 (map)
   (declare (xargs :measure (acl2-count map)))
   (if (omap::emptyp map) nil (map-ind2 (omap::tail map)))))

(defrule string-expr-value-map-ll-related-p-of-ll-denv-witness-fix
  (implies (string-expr-value-mapp map)
           (equal (string-expr-value-map-ll-related-p
                   new-denv map fv nfv ctx (ll-denv-witness-fix dw) genv)
                  (string-expr-value-map-ll-related-p
                   new-denv map fv nfv ctx dw genv)))
  :induct (map-ind2 map)
  :expand ((:free (dw) (string-expr-value-map-ll-related-p
                        new-denv map fv nfv ctx dw genv))))

(defrule expr-denv-ll-related-p-of-ll-denv-witness-fix
  (equal (expr-denv-ll-related-p new-denv denv x ctx excl
                                 (ll-denv-witness-fix dw) genv)
         (expr-denv-ll-related-p new-denv denv x ctx excl dw genv))
  :expand ((:free (dw) (expr-denv-ll-related-p new-denv denv x ctx excl dw
                                               genv))))

(defruled expr-value-ll-related-p-of-kept-closure
  (implies (and (%kclosure-hyps)
                (ll-context-ok-p (mv-nth 1 (%lp)) (%ictx) genv))
           (expr-value-ll-related-p
            (%ku) (%v)
            (ll-value-witness-lambda (%ictx) (cdr (%ps)) t dw)
            genv))
  :use (kept-closure-facts
        kept-closure-context-facts
        kept-closure-pnames
        kept-closure-env-related
        (:instance ll-lambda-parts-replacements-ok
                   (params pa) (body ba) (type? ta))
        (:instance expr-value-ll-related-p-of-lambda-witness
                   (new-val (%ku)) (val (%v))
                   (ctx (%ictx)) (prest (cdr (%ps))) (flat t)
                   (dw (ll-denv-witness-fix dw))))
  :disable (lambda-closure ll-lambda-parts expr-value-ll-related-p
            expr-denv-ll-related-p closure-body-parts names-in-context-p
            param-type-consistent-p prest-tenv-consistent-p ll-context-ok-p
            lifted-closure-body))

(defmacro %kcase-hyps ()
  '(and (%kept-atom-hyps)
        (not (reserrp (eval-expr x denv limit)))
        (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
        (ll-context-ok-p x ctx genv)
        (expr-denv-wfp denv)
        (expr-denv-wfp new-denv)))

(defruled kept-inner-defs-bound
  (implies (%kcase-hyps)
           (ll-defs-bound-p (ll-context-lifted (mv-nth 1 (%lp)) (%ictx)) genv))
  :use (ll-context-ok-p-facts-nb kept-atom-transform-facts)
  :disable (ll-lambda-parts ll-expr ll-context-ok-p))

(defruled ll-context-ok-p-of-kept-inner
  (implies (%kcase-hyps)
           (ll-context-ok-p (mv-nth 1 (%lp)) (%ictx) genv))
  :use (lifted-inner-ctx-core
        kept-inner-defs-bound
        (:instance ll-context-ok-p-intro (x (mv-nth 1 (%lp))) (ctx (%ictx))))
  :in-theory nil)

(defruled lambda-chain-type-when-nothing-absorbed
  (implies (not (consp (mv-nth 0 (lambda-chain body type?))))
           (equal (mv-nth 2 (lambda-chain body type?))
                  (type-option-fix type?)))
  :use ((:instance nested-lambda-params-consp))
  :expand ((lambda-chain body type?)))

(defruled type-option-evaluable-p-when-single-lambda-closure-ok
  (implies (and (consp params)
                (not (consp (cdr params)))
                (type-optionp type?)
                (set::emptyp (type-option-free-type-vars type?))
                (set::emptyp (type-option-free-ispace-vars type?))
                (not (reserrp (lambda-closure params body type? denv))))
           (type-option-evaluable-p type?))
  :use (type?-of-lambda-closure-single)
  :enable (type-option-evaluable-p type-evaluable-p eval-type-when-closed)
  :expand ((type-option-free-type-vars type?)
           (type-option-free-ispace-vars type?))
  :disable (lambda-closure))

(defruled kept-closure-first-param-ok
  (implies (%kcase-hyps)
           (and (consp (%ps))
                (equal (car (%ps)) (car pa))
                (param-evaluable-p (car pa))))
  :use ((:instance ll-lambda-parts-is-lambda-chain
                   (params pa) (body ba) (type? ta)))
  :expand ((liftable-lambda-p (expr-atom->atom x) (ll-context->tenv ctx)
                              (ll-context->locals ctx) (ll-context->lmap ctx)))
  :enable (make-atom-lambda/lambdan)
  :disable (ll-lambda-parts ll-expr lambda-closure lambda-chain
            ll-context-ok-p))

(defruled kept-closure-single-type-ok
  (implies (and (%kcase-hyps)
                (not (consp (cdr (%ps)))))
           (type-option-evaluable-p (%ity)))
  :use (lifted-orig-eval
        ll-context-ok-p-facts-nb
        (:instance kept-case-closedness)
        (:instance lmap-closed-p-when-string-expr-map-closed-p
                   (m (ll-context->lmap ctx)))
        (:instance ll-lambda-parts-is-lambda-chain
                   (params pa) (body ba) (type? ta))
        (:instance lambda-chain-type-when-nothing-absorbed
                   (body ba) (type? ta))
        (:instance type-option-evaluable-p-when-single-lambda-closure-ok
                   (params pa) (body ba) (type? ta)))
  :disable (ll-lambda-parts ll-expr lambda-closure lambda-chain
            ll-context-ok-p))

(defruled kept-closure-ok
  (implies (%kcase-hyps)
           (not (reserrp (%ku))))
  :use (kept-closure-first-param-ok
        kept-closure-single-type-ok
        ll-context-ok-p-facts-nb
        (:instance kept-case-closedness)
        (:instance lmap-closed-p-when-string-expr-map-closed-p
                   (m (ll-context->lmap ctx)))
        (:instance lambda-closure-ok-when-evaluable
                   (params (%ps)) (body (%nb)) (type? (%ity)) (denv new-denv)))
  :in-theory (theory 'minimal-theory))

(defrule kept-closure-hyps-hold
  (implies (%kcase-hyps)
           (let ((fvx (expr-free-expr-vars x))
                 (fvv
                  (atom-free-expr-vars (make-atom-lambda/lambdan pa ba ta))))
             (%kclosure-hyps)))
  :rule-classes nil
  :use (ll-context-ok-p-facts
        kept-atom-transform-facts
        kept-closure-ok
        lifted-orig-eval
        lifted-inner-params-facts
        (:instance kept-case-closedness)
        (:instance lmap-closed-p-when-string-expr-map-closed-p
                   (m (ll-context->lmap ctx)))
        (:instance lmap-replacements-ok-p-when-fewer-pnames
                   (lmap (ll-context->lmap ctx))
                   (locals (ll-context->locals ctx))
                   (pnames (expr-binder-names x))
                   (pnames2 (var+type?-list->var (%ps)))))
  :expand ((expr-denv-ll-related-p new-denv denv x ctx nil dw genv))
  :enable (difference-of-nil-when-setp expr-free-expr-vars-when-atom-kind)
  :disable (ll-context-ok-p ll-lambda-parts ll-expr lambda-closure
            lambda-curried-body lmap-replacements-ok-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled eval-expr-when-atom-kind
  (implies (and (equal (expr-kind e) :atom)
                (not (zp limit)))
           (equal (eval-expr e denv limit)
                  (eval-atom (expr-atom->atom e) denv (1- limit))))
  :expand ((eval-expr e denv limit)))

(defruled kept-ref-eval
  (implies (%kcase-hyps)
           (equal (eval-expr (ll-context-new-expr x ctx) new-denv 2)
                  (%ku)))
  :use (kept-atom-transform-facts
        (:instance eval-atom-of-lambda/lambdan
                   (params (%ps)) (body (%nb)) (type? (%ity)) (denv new-denv)
                   (limit 1)))
  :enable (eval-expr-when-atom-kind)
  :disable (ll-lambda-parts ll-expr lambda-closure))

; The kept-lambda case: a liftable lambda whose definition is not emitted
; is rebuilt as a lambda, which evaluates to a related closure.

(defruled eval-expr-ll-reaches-p-when-kept-lambda
  (implies (%kcase-hyps)
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (kept-ref-eval
        lifted-orig-eval
        ll-context-ok-p-of-kept-inner
        kept-closure-hyps-hold
        (:instance expr-value-ll-related-p-of-kept-closure
                   (fvx (expr-free-expr-vars x))
                   (fvv (atom-free-expr-vars
                         (make-atom-lambda/lambdan pa ba ta))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (ll-context-new-expr x ctx))
                   (limit2 2)
                   (w (ll-value-witness-lambda (%ictx) (cdr (%ps)) t dw))
                   (val (eval-expr x denv limit))))
  :in-theory (disable ll-lambda-parts ll-expr lambda-closure apply-to-names
                      eval-expr expr-value-ll-related-p expr-denv-ll-related-p
                      ll-context-ok-p ll-context-new-expr
                      eval-expr-ll-reaches-p eval-expr-ll-reaches-p-suff
                      string-expr-value-map-ll-related-p
                      new-values-meet-types-p lmap-replacements-ok-p))

; Both together: the case of a lambda atom that LL-EXPR handles by
; LL-LAMBDA, whether its definition is emitted or not.

(defruled eval-expr-ll-reaches-p-when-liftable-lambda
  (implies (and (%lifted-atom-hyps-base)
                (liftable-lambda-p (expr-atom->atom x) (ll-context->tenv ctx)
                                   (ll-context->locals ctx)
                                   (ll-context->lmap ctx))
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :cases ((consp (mv-nth 1 (%emit))))
  :use (eval-expr-ll-reaches-p-when-lifted-lambda-ok
        eval-expr-ll-reaches-p-when-kept-lambda)
  :in-theory nil)


(defmacro %alp () '(ll-lambda-parts pa '(:var "") nil ctx))

(defmacro %aps () '(mv-nth 0 (%alp)))

(defmacro %actx () '(mv-nth 3 (%alp)))

(defmacro %anb () '(ll-context-new-expr ba (%actx)))

(defmacro %aity () 'ta)

(defmacro %aatom () '(make-atom-lambda/lambdan (%aps) (%anb) (%aity)))

(defmacro %au () '(lambda-closure (%aps) (%anb) (%aity) new-denv))

(defmacro %audenv () '(expr-value-lambda->denv (%au)))

(defmacro %anfvx () '(atom-free-expr-vars (%aatom)))

(defmacro %afvin ()
  '(set::difference (expr-free-expr-vars ba)
                    (set::mergesort (var+type?-list->var (%aps)))))

(defmacro %atom-env-hyps ()
  '(and (string-expr-value-map-ll-related-p
         new-denv (expr-denv->exprs denv) fvx (%anfvx) ctx dw genv)
        (set::subset (set::intersect (%afvin) (string-sfix fvv)) fvx)
        (lmap-replacements-ok-p (ll-context->lmap ctx)
                                (ll-context->locals ctx)
                                (var+type?-list->var (%aps))
                                genv)
        (consp (%aps))
        (not (reserrp (%au)))))

(defruled atomlam-knfvx
  (implies (consp (%aps))
           (equal (%anfvx)
                  (set::difference (expr-free-expr-vars (%anb))
                                   (set::mergesort
                                    (var+type?-list->var (%aps))))))
  :use ((:instance atom-free-expr-vars-of-make-atom-lambda/lambdan
                   (params (%aps)) (body (%anb)) (type? (%aity))))
  :disable (ll-lambda-parts))

(defruled lookup-in-atomlam-closure-env
  (implies (and (consp (%aps))
                (not (reserrp (%au)))
                (stringp n)
                (set::in n (expr-free-expr-vars (%anb)))
                (not (member-equal n (var+type?-list->var (%aps)))))
           (equal (expr-denv-lookup-expr n (%audenv))
                  (expr-denv-lookup-expr n new-denv)))
  :use ((:instance lookup-in-lambda-closure-denv
                   (params (%aps)) (body (%anb)) (type? (%aity)) (denv
                                                                  new-denv)))
  :disable (ll-lambda-parts lambda-closure))

(defruled ll-var-referred-ok-p-of-atomlam-closure-plain
  (implies (and (stringp v)
                (not (member-equal v (var+type?-list->var (%aps))))
                (not (omap::assoc v (ll-context->lmap ctx)))
                (ll-var-referred-ok-p v val new-denv (%anfvx) ctx dw genv)
                (consp (%aps))
                (not (reserrp (%au))))
           (ll-var-referred-ok-p v val (%audenv) (expr-free-expr-vars (%anb))
                                 (%actx) dw genv))
  :use ((:instance ll-lambda-parts-context-at-other
                   (params pa) (body (expr-var "")) (type? nil))
        atomlam-knfvx
        (:instance lookup-in-atomlam-closure-env (n v)))
  :enable (ll-var-referred-ok-p)
  :disable (ll-lambda-parts lambda-closure
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled lookups-agree-p-of-atomlam-closure-env
  (implies (and (string-listp hns)
                (set::subset (set::mergesort hns) (expr-free-expr-vars (%anb)))
                (not (intersectp-equal hns (var+type?-list->var (%aps))))
                (consp (%aps))
                (not (reserrp (%au))))
           (lookups-agree-p hns (%audenv) new-denv))
  :induct (len hns)
  :enable (lookups-agree-p len intersectp-equal set::subset-in)
  :expand ((set::mergesort hns))
  :hints (("Subgoal *1/1"
           :use ((:instance lookup-in-atomlam-closure-env (n (car hns)))))))

(defruled ll-var-referred-ok-p-of-atomlam-closure-hoisted
  (implies (and (stringp v)
                (not (member-equal v (var+type?-list->var (%aps))))
                (equal (cdr (omap::assoc v (ll-context->lmap ctx)))
                       (apply-to-names (expr-var h) hns))
                (omap::assoc v (ll-context->lmap ctx))
                (stringp h)
                (string-listp hns)
                (not (set::in h (ll-context->locals ctx)))
                (not (member-equal h (var+type?-list->var (%aps))))
                (not (reserrp (expr-denv-lookup-expr h genv)))
                (subsetp-equal hns (ll-context->locals ctx))
                (not (intersectp-equal hns (var+type?-list->var (%aps))))
                (ll-var-referred-ok-p v val new-denv (%anfvx) ctx dw genv)
                (consp (%aps))
                (not (reserrp (%au))))
           (ll-var-referred-ok-p v val (%audenv) (expr-free-expr-vars (%anb))
                                 (%actx) dw genv))
  :use ((:instance ll-lambda-parts-context-at-other
                   (params pa) (body (expr-var "")) (type? nil))
        atomlam-knfvx
        (:instance kept-replacement-sets
                   (pnames (var+type?-list->var (%aps)))
                   (locals (ll-context->locals ctx))
                   (nbfv (expr-free-expr-vars (%anb))))
        (:instance lookups-agree-p-of-atomlam-closure-env)
        (:instance lookups-agree-p-of-with-names-from-insert
                   (d1 (%audenv)) (d2 new-denv) (g genv))
        (:instance eval-expr-of-apply-to-names-when-agree
                   (names hns)
                   (d1 (expr-denv-with-names-from (set::insert h nil)
                                                  (%audenv) genv))
                   (d2 (expr-denv-with-names-from (set::insert h nil)
                                                  new-denv genv))
                   (l (ll-denv-witness->limit dw)))
        (:instance lookup-of-expr-denv-with-names-from
                   (n h) (names (set::insert h nil)) (d (%audenv)) (g genv))
        (:instance lookup-of-expr-denv-with-names-from
                   (n h) (names (set::insert h nil)) (d new-denv) (g genv))
        (:instance in-when-member-of-subsetp
                   (e h) (l hns) (s (ll-context->locals ctx))))
  :enable (ll-var-referred-ok-p ll-lambda-parts-locals)
  :expand ((:free (n) (expr-free-expr-vars (expr-var n))))
  :disable (lambda-closure ll-lambda-parts
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv
            apply-to-names))

(defruled ll-var-ok-p-of-atomlam-closure
  (implies (and (stringp v)
                (expr-valuep val)
                (not (member-equal v (var+type?-list->var (%aps))))
                (ll-var-ok-p v val new-denv (%anfvx) ctx dw genv)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        (var+type?-list->var (%aps))
                                        genv)
                (consp (%aps))
                (not (reserrp (%au))))
           (ll-var-ok-p v val (%audenv) (expr-free-expr-vars (%anb))
                        (%actx) dw genv))
  :use ((:instance ll-var-ok-p-split (var v) (nfv (%anfvx)))
        (:instance ll-var-ok-p-split
                   (var v) (new-denv (%audenv))
                   (nfv (expr-free-expr-vars (%anb))) (ctx (%actx)))
        (:instance ll-var-types-ok-p-of-ll-lambda-parts
                   (params pa) (body (expr-var "")) (type? nil))
        ll-var-referred-ok-p-of-atomlam-closure-plain
        (:instance ll-var-referred-ok-p-of-atomlam-closure-hoisted
                   (h (mv-nth 1 (replacement-parts
                                 (cdr (omap::assoc v (ll-context->lmap ctx))))))
                   (hns (mv-nth 2 (replacement-parts
                                   (cdr (omap::assoc v
                                                     (ll-context->lmap
                                                      ctx)))))))
        (:instance ll-replacement-ok-p-unpack
                   (repl (cdr (omap::assoc v (ll-context->lmap ctx))))
                   (locals (ll-context->locals ctx))
                   (pnames (var+type?-list->var (%aps))))
        (:instance ll-replacement-ok-p-when-lmap-replacements-ok-p
                   (lmap (ll-context->lmap ctx)) (k v)
                   (locals (ll-context->locals ctx))
                   (pnames (var+type?-list->var (%aps)))))
  :disable (ll-var-referred-ok-p ll-var-ok-p ll-var-types-ok-p
            ll-lambda-parts lambda-closure))

(defruled walker-of-atomlam-closure-env-at
  (implies (and (%atom-env-hyps)
                (omap::assoc w (%vmap))
                (set::in w (%afvin)))
           (ll-var-ok-p w (cdr (omap::assoc w (%vmap)))
                        (%audenv) (expr-free-expr-vars (%anb))
                        (%actx) dw genv))
  :use ((:instance walker-ll-var-ok-p-at
                   (map (expr-denv->exprs denv))
                   (fv fvx) (nfv (%anfvx)) (var w))
        (:instance ll-var-ok-p-of-atomlam-closure
                   (v w) (val (cdr (omap::assoc w (expr-denv->exprs denv)))))
        (:instance stringp-when-assoc-of-string-expr-value-mapp
                   (m (expr-denv->exprs denv)) (k w))
        (:instance set::subset-in
                   (a w) (x (set::intersect (%afvin) (string-sfix fvv)))
                   (y fvx))
        (:instance assoc-of-restrict-when-assoc
                   (s (string-sfix fvv)) (m (expr-denv->exprs denv))))
  :disable (ll-var-ok-p omap::assoc-of-restrict
            ll-var-ok-p-of-atomlam-closure lambda-closure ll-lambda-parts))

(defruled walker-of-atomlam-closure-env
  (implies (%atom-env-hyps)
           (string-expr-value-map-ll-related-p
            (%audenv) (%vmap) (%afvin) (expr-free-expr-vars (%anb))
            (%actx) dw genv))
  :use ((:instance string-expr-value-map-ll-related-p-when-pointwise
                   (new-denv (%audenv)) (map (%vmap)) (fv (%afvin))
                   (nfv (expr-free-expr-vars (%anb)))
                   (ctx (%actx)))
        (:instance walker-of-atomlam-closure-env-at
                   (w (walker-pointwise-p-witness
                       (%audenv) (%vmap) (%afvin) (expr-free-expr-vars (%anb))
                       (%actx) dw genv))))
  :expand ((walker-pointwise-p (%audenv) (%vmap) (%afvin)
                               (expr-free-expr-vars (%anb))
                               (%actx) dw genv))
  :disable (ll-var-ok-p walker-pointwise-p-necc lambda-closure ll-lambda-parts))

; The other conjuncts of the environment relation, element by element.

(defruled atomlam-closure-names-bound-at
  (implies (and (names-bound-as-in-p (set::difference (%anfvx)
                                                      (ll-context->locals ctx))
                                     new-denv genv)
                (stringp n)
                (set::in n (expr-free-expr-vars (%anb)))
                (not (set::in n (ll-context->locals (%actx))))
                (not (reserrp (expr-denv-lookup-expr n genv)))
                (consp (%aps))
                (not (reserrp (%au))))
           (equal (expr-denv-lookup-expr n (%audenv))
                  (expr-denv-lookup-expr n genv)))
  :use (atomlam-knfvx
        (:instance ll-lambda-parts-locals (params pa) (body (expr-var ""))
                   (type? nil))
        (:instance lookup-in-atomlam-closure-env)
        (:instance names-bound-as-in-p-when-in
                   (names (set::difference (%anfvx) (ll-context->locals ctx)))
                   (name n)))
  :disable (lambda-closure ll-lambda-parts
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled atomlam-closure-meets-type-at
  (implies (and (new-values-meet-types-p (set::intersect
                                          (%anfvx) (ll-context->locals ctx))
                                         new-denv (ll-context->tenv ctx))
                (stringp n)
                (set::in n (expr-free-expr-vars (%anb)))
                (set::in n (ll-context->locals (%actx)))
                (not (member-equal n (var+type?-list->var (%aps))))
                (consp (%aps))
                (not (reserrp (%au))))
           (and (not (reserrp (expr-denv-lookup-expr n (%audenv))))
                (value-meets-required-type-p (expr-denv-lookup-expr n (%audenv))
                                             n (ll-context->tenv (%actx)))))
  :use (atomlam-knfvx
        (:instance ll-lambda-parts-locals (params pa) (body (expr-var ""))
                   (type? nil))
        (:instance lookup-in-atomlam-closure-env)
        (:instance new-values-meet-types-p-when-in
                   (names (set::intersect (%anfvx) (ll-context->locals ctx)))
                   (name n) (tenv (ll-context->tenv ctx)))
        (:instance ll-lambda-parts-context-at-other
                   (params pa) (body (expr-var "")) (type? nil) (v n))
        (:instance value-type-conditions-when-same-type-option
                   (v n) (val (expr-denv-lookup-expr n new-denv))
                   (tenv1 (ll-context->tenv ctx))
                   (tenv2 (ll-context->tenv (%actx)))))
  :disable (lambda-closure ll-lambda-parts value-meets-required-type-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled atomlam-closure-names-bound
  (implies (and (string-setp s)
                (set::subset s (set::difference (expr-free-expr-vars (%anb))
                                                (ll-context->locals (%actx))))
                (names-bound-as-in-p (set::difference (%anfvx)
                                                      (ll-context->locals ctx))
                                     new-denv genv)
                (consp (%aps))
                (not (reserrp (%au))))
           (names-bound-as-in-p s (%audenv) genv))
  :induct (set-ind s)
  :enable (names-bound-as-in-p subset-of-tail-when-subset)
  :hints (("Subgoal *1/2"
           :use ((:instance set::subset-in (a (set::head s)) (x s)
                            (y (set::difference (expr-free-expr-vars (%anb))
                                                (ll-context->locals (%actx)))))
                 (:instance atomlam-closure-names-bound-at (n (set::head s))))
           :in-theory (disable lambda-closure ll-lambda-parts))))

(defruled atomlam-closure-meets-types
  (implies (and (string-setp s)
                (set::subset s (set::difference
                                (set::intersect (expr-free-expr-vars (%anb))
                                                (ll-context->locals (%actx)))
                                (set::mergesort (var+type?-list->var (%aps)))))
                (new-values-meet-types-p (set::intersect
                                          (%anfvx) (ll-context->locals ctx))
                                         new-denv (ll-context->tenv ctx))
                (consp (%aps))
                (not (reserrp (%au))))
           (new-values-meet-types-p s (%audenv) (ll-context->tenv (%actx))))
  :induct (set-ind s)
  :enable (new-values-meet-types-p subset-of-tail-when-subset)
  :hints (("Subgoal *1/2"
           :use ((:instance set::subset-in (a (set::head s)) (x s)
                            (y (set::difference
                                (set::intersect (expr-free-expr-vars (%anb))
                                                (ll-context->locals (%actx)))
                                (set::mergesort (var+type?-list->var (%aps))))))
                 (:instance atomlam-closure-meets-type-at (n (set::head s))))
           :in-theory (disable lambda-closure ll-lambda-parts
                               value-meets-required-type-p))))

; The free type and ispace variables of a curried body depend on the body
; only through its own.

(defruled curried-body-free-vars-congruence
  (implies (and (equal (expr-free-type-vars b1) (expr-free-type-vars b2))
                (equal (expr-free-ispace-vars b1) (expr-free-ispace-vars b2)))
           (and (equal (expr-free-type-vars (lambda-curried-body ps b1 ty))
                       (expr-free-type-vars (lambda-curried-body ps b2 ty)))
                (equal (expr-free-ispace-vars (lambda-curried-body ps b1 ty))
                       (expr-free-ispace-vars (lambda-curried-body ps b2 ty)))))
  :enable (lambda-curried-body make-atom-lambda/lambdan)
  :expand ((:free (a) (expr-free-type-vars (expr-atom a)))
           (:free (a) (expr-free-ispace-vars (expr-atom a)))
           (:free (p b ty) (atom-free-type-vars (atom-lambda p b ty)))
           (:free (p b ty) (atom-free-ispace-vars (atom-lambda p b ty)))
           (:free (p b ty) (atom-free-type-vars (atom-lambdan p b ty)))
           (:free (p b ty) (atom-free-ispace-vars (atom-lambdan p b ty)))))

(defruled atomlam-free-vars-of-new-body
  (implies (lmap-closed-p (ll-context->lmap ctx))
           (and (equal (expr-free-type-vars (%anb)) (expr-free-type-vars ba))
                (equal (expr-free-ispace-vars (%anb))
                       (expr-free-ispace-vars ba))))
  :use ((:instance lmap-closed-p-of-ll-lambda-parts
                   (params pa) (body (expr-var "")) (type? nil))
        (:instance free-type/ispace-vars-of-ll-expr
                   (x ba)
                   (tenv (ll-context->tenv (%actx)))
                   (tlets (ll-context->tlets (%actx)))
                   (locals (ll-context->locals (%actx)))
                   (lmap (ll-context->lmap (%actx)))
                   (used (ll-context->used (%actx)))))
  :enable (ll-context-new-expr)
  :disable (ll-lambda-parts ll-expr))

; Whether a lambda closure can be formed depends on the environment only
; through its type environment, and not on the body.

(defruled reserrp-of-lambda-closure-same-tenv
  (implies (equal (expr-denv->tenv d1) (expr-denv->tenv d2))
           (equal (reserrp (lambda-closure ps b1 ty d1))
                  (reserrp (lambda-closure ps b2 ty d2))))
  :enable (lambda-closure make-atom-lambda/lambdan
           not-reserrp-when-expr-valuep)
  :expand ((:free (a d l) (eval-atom a d l))))

(defruled lambda-closure-param-type?-same-tenv
  (implies (and (equal (expr-denv->tenv d1) (expr-denv->tenv d2))
                (consp ps)
                (not (reserrp (lambda-closure ps b1 ty d1)))
                (not (reserrp (lambda-closure ps b2 ty d2))))
           (and (equal (expr-value-lambda->param (lambda-closure ps b1 ty d1))
                       (expr-value-lambda->param (lambda-closure ps b2 ty d2)))
                (equal (expr-value-lambda->type? (lambda-closure ps b1 ty d1))
                       (expr-value-lambda->type?
                        (lambda-closure ps b2 ty d2)))))
  :enable (lambda-closure make-atom-lambda/lambdan)
  :cases ((consp (cdr ps)))
  :expand ((:free (a d l) (eval-atom a d l))))

(defruled closure-body-parts-of-lambda-curried-body-nonflat
  (implies (and (var+type?-listp params)
                (consp params)
                (exprp body)
                (type-optionp type?))
           (b* (((mv okp inner ity2)
                 (closure-body-parts (lambda-curried-body params body type?)
                                     tyv (cdr params) nil)))
             (and okp
                  (equal inner body)
                  (equal (lifted-closure-body (cdr params) new-inner ity2)
                         (lambda-curried-body params new-inner type?)))))
  :enable (closure-body-parts lambda-curried-body lifted-closure-body
           nested-lambda make-atom-lambda/lambdan
           consp-when-positive-len positive-len-when-consp)
  :cases ((consp (cdr params))))

(defruled param-type-consistent-p-of-ll-lambda-parts-general
  (b* (((mv ps & & ictx) (ll-lambda-parts params body type? ctx)))
    (implies (and (no-duplicatesp-equal (var+type?-list->var ps))
                  (consp ps)
                  (not (reserrp (eval-var+type? (car ps) tenv))))
             (param-type-consistent-p (eval-var+type? (car ps) tenv)
                                      (ll-context->tenv ictx))))
  :use ((:instance name-to-type-option-in-ll-lambda-parts-context
                   (p (car (mv-nth 0 (ll-lambda-parts params body type?
                                                      ctx))))))
  :enable (param-type-consistent-p var-required-type eval-var+type?
           var+type?->type-or-err eval-type-when-closed type-closed-p
           type-valuep-when-result-not-error))

(defruled atomlam-aps
  (implies (var+type?-listp pa)
           (equal (%aps) pa))
  :expand ((ll-lambda-parts pa '(:var "") nil ctx))
  :enable (nested-lambda))

(defruled atomlam-closure-env-related
  (b* ((fvv (atom-free-expr-vars (make-atom-lambda/lambdan pa ba ta))))
    (implies (and (%atom-env-hyps)
                  (equal (expr-denv->tenv new-denv) (expr-denv->tenv denv))
                  (names-bound-as-in-p (set::difference
                                        (%anfvx) (ll-context->locals ctx))
                                       new-denv genv)
                  (new-values-meet-types-p (set::intersect
                                            (%anfvx) (ll-context->locals ctx))
                                           new-denv (ll-context->tenv ctx))
                  (lmap-closed-p (ll-context->lmap ctx))
                  (var+type?-listp pa)
                  (consp pa)
                  (not (reserrp (%v))))
             (expr-denv-ll-related-p
              (expr-value-lambda->denv (lambda-closure pa (%anb) ta new-denv))
              (expr-value-lambda->denv (%v))
              ba (%actx)
              (var+type?-list->var pa)
              dw genv)))
  :use ((:instance walker-of-atomlam-closure-env
                   (fvv (atom-free-expr-vars
                         (make-atom-lambda/lambdan pa ba ta))))
        (:instance subsetp-of-params-in-ll-lambda-parts-locals
                   (ba (expr-var "")) (ta nil))
        (:instance expr-value-lambda->denv-of-lambda-closure
                   (params pa) (body ba) (type? ta))
        (:instance expr-value-lambda->denv-of-lambda-closure
                   (params pa) (body (%anb)) (type? ta) (denv new-denv))
        atomlam-free-vars-of-new-body
        (:instance curried-body-free-vars-congruence
                   (ps pa) (b1 (%anb)) (b2 ba) (ty ta))
        (:instance atomlam-closure-names-bound
                   (s (set::difference (expr-free-expr-vars (%anb))
                                       (ll-context->locals (%actx)))))
        (:instance atomlam-closure-meets-types
                   (s (set::difference
                       (set::intersect (expr-free-expr-vars (%anb))
                                       (ll-context->locals (%actx)))
                       (set::mergesort (var+type?-list->var pa))))))
  :expand ((expr-denv-ll-related-p
            (expr-value-lambda->denv (lambda-closure pa (%anb) ta new-denv))
            (expr-value-lambda->denv (%v))
            ba (%actx)
            (var+type?-list->var pa)
            dw genv))
  :enable (expr-denv-restrict atomlam-aps)
  :disable (walker-of-atomlam-closure-env lambda-closure ll-lambda-parts
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defmacro %atom-closure-hyps ()
  '(and (%atom-env-hyps)
        (equal (expr-denv->tenv new-denv) (expr-denv->tenv denv))
        (names-bound-as-in-p (set::difference (%anfvx) (ll-context->locals ctx))
                             new-denv genv)
        (new-values-meet-types-p (set::intersect (%anfvx)
                                                 (ll-context->locals ctx))
                                 new-denv (ll-context->tenv ctx))
        (lmap-closed-p (ll-context->lmap ctx))
        (equal fvv (atom-free-expr-vars (make-atom-lambda/lambdan pa ba ta)))
        (var+type?-listp pa)
        (consp pa)
        (exprp ba)
        (type-optionp ta)
        (not (reserrp (%v)))
        (no-duplicatesp-equal (var+type?-list->var pa))))

(defruled atomlam-closure-facts
  (implies (%atom-closure-hyps)
           (b* ((u (lambda-closure pa (%anb) ta new-denv)))
             (and (equal (expr-value-kind u) :lambda)
                  (equal (expr-value-kind (%v)) :lambda)
                  (b* (((mv okp inner ity2)
                        (closure-body-parts (expr-value-lambda->body (%v))
                                            (expr-value-lambda->type? (%v))
                                            (cdr pa) nil)))
                    (and okp
                         (equal inner ba)
                         (equal (lifted-closure-body
                                 (cdr pa) (ll-context-new-expr inner (%actx))
                                 ity2)
                                (expr-value-lambda->body u))))
                  (equal (expr-value-lambda->param u)
                         (expr-value-lambda->param (%v)))
                  (equal (expr-value-lambda->type? u)
                         (expr-value-lambda->type? (%v)))
                  (names-in-context-p
                   (cons (var+typevalue->var (expr-value-lambda->param (%v)))
                         (var+type?-list->var (cdr pa)))
                   (%actx))
                  (param-type-consistent-p (expr-value-lambda->param (%v))
                                           (ll-context->tenv (%actx)))
                  (prest-tenv-consistent-p (cdr pa)
                                           (ll-context->tenv (%actx))))))
  :use (atomlam-aps
        (:instance expr-value-kind-of-lambda-closure
                   (params pa) (body ba) (type? ta))
        (:instance expr-value-kind-of-lambda-closure
                   (params pa) (body (%anb)) (type? ta) (denv new-denv))
        (:instance closure-body-parts-of-lambda-curried-body-nonflat
                   (params pa) (body ba) (type? ta)
                   (tyv (expr-value-lambda->type? (%v)))
                   (new-inner (%anb)))
        (:instance lambda-closure-when-ok (params pa) (body ba) (type? ta))
        (:instance lambda-closure-when-ok
                   (params pa) (body (%anb)) (type? ta) (denv new-denv))
        (:instance lambda-closure-param-type?-same-tenv
                   (ps pa) (b1 (%anb)) (b2 ba) (ty ta)
                   (d1 new-denv) (d2 denv))
        (:instance names-in-context-p-of-ll-lambda-parts
                   (params pa) (body '(:var "")) (type? nil)
                   (names (var+type?-list->var pa)))
        (:instance param-of-lambda-closure (params pa) (body ba) (type? ta))
        (:instance eval-var+type?-ok-when-lambda-closure-ok
                   (params pa) (body ba) (type? ta))
        (:instance param-type-consistent-p-of-ll-lambda-parts-general
                   (params pa) (body '(:var "")) (type? nil)
                   (tenv (expr-denv->tenv denv)))
        (:instance prest-tenv-consistent-p-of-ll-lambda-parts
