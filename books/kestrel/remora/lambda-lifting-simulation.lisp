            eval-unbox-ll-reaches-p eval-unbox-ll-reaches-p-suff
            eval-unbox-of-expr-value-fix-target
            eval-unbox-expr-value-equiv-congruence-on-target
            ll-unbox-empty-witness))

; A vector: the elements are unboxed by EVAL-UNBOX-LIST.

(defmacro %ubl (tgs d l) `(eval-unbox-list ,tgs ispaces var body type ,d ,l))

(defruled posp-limit-when-eval-unbox-list-ok
  (implies (not (reserrp (eval-unbox-list targets ispaces var body type denv
                                          limit)))
           (posp limit))
  :expand ((eval-unbox-list targets ispaces var body type denv limit)))

(defruled eval-unbox-list-ll-reaches-p-elim
  (implies (eval-unbox-list-ll-reaches-p new-targets ispaces var new-body type
                                         new-denv vals genv)
           (b* (((mv l ws)
                 (eval-unbox-list-ll-reaches-p-witness new-targets ispaces var
                                                       new-body type new-denv
                                                       vals genv))
                (nvs (eval-unbox-list new-targets ispaces var new-body type
                                      new-denv l)))
             (and (not (reserrp nvs))
                  (expr-value-list-ll-related-p nvs vals ws genv))))
  :enable eval-unbox-list-ll-reaches-p)

(defruled eval-unbox-when-vector-local
  (implies (and (equal (expr-value-kind tg) :vector)
                (not (reserrp (eval-unbox tg ispaces var body type d l))))
           (b* ((vals (eval-unbox-list (expr-value-vector->elems tg) ispaces var
                                       body type d (1- l))))
             (and (posp l)
                  (not (reserrp vals))
                  (consp vals)
                  (list-repeatp (dims-of-expr-value-list vals))
                  (equal (eval-unbox tg ispaces var body type d l)
                         (expr-value-vector vals)))))
  :expand ((eval-unbox tg ispaces var body type d l)))

(defruled eval-unbox-ll-reaches-p-of-vector-generic
  (b* ((nvs (eval-unbox-list (expr-value-vector->elems nf) ispaces var nb type
                             nd l)))
    (implies (and (equal (expr-value-kind nf) :vector)
                  (natp l)
                  (not (reserrp nvs))
                  (expr-value-list-ll-related-p nvs vs ws genv)
                  (consp vs)
                  (list-repeatp (dims-of-expr-value-list vs))
                  (expr-value-list-wfp vs)
                  (expr-value-list-wfp nvs)
                  (equal val (expr-value-vector vs)))
             (eval-unbox-ll-reaches-p nf ispaces var nb type nd val genv)))
  :use ((:instance consp-when-expr-value-list-ll-related-p
                   (nvals (eval-unbox-list (expr-value-vector->elems nf)
                                           ispaces var nb type nd l))
                   (vals vs))
        (:instance dims-of-expr-value-list-when-ll-related
                   (new-vals (eval-unbox-list (expr-value-vector->elems nf)
                                              ispaces var nb type nd l))
                   (vals vs))
        (:instance expr-value-ll-related-p-of-vector-values
                   (a (eval-unbox-list (expr-value-vector->elems nf)
                                       ispaces var nb type nd l))
                   (b vs) (w (ll-value-witness-vector ws)))
        (:instance eval-unbox-ll-reaches-p-suff
                   (new-target nf) (new-body nb) (new-denv nd)
                   (limit2 (+ 1 l)) (w (ll-value-witness-vector ws))))
  :expand ((eval-unbox nf ispaces var nb type nd (+ 1 l)))
  :disable (eval-unbox-list expr-value-ll-related-p
            expr-value-list-ll-related-p eval-unbox-ll-reaches-p
            eval-unbox-ll-reaches-p-suff equal-of-expr-value-vector)
  :enable (not-reserrp-when-expr-valuep))

(defmacro %ubvw ()
  '(eval-unbox-list-ll-reaches-p-witness
    (expr-value-vector->elems new-target) ispaces var
    (ll-context-new-expr body ctx) type new-denv
    (%ubl (expr-value-vector->elems target) denv (1- limit)) genv))

(defruled eval-unbox-ll-reaches-p-when-vector
  (implies (and (%ubx-hyps)
                (equal (expr-value-kind target) :vector)
