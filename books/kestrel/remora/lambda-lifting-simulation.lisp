  :enable expr-free-expr-vars-when-atom-kind
  :disable (ll-lambda-parts ll-expr
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defrule lifted-closure-hyps-hold
  (implies (and (%case-hyps) (%side-hyps) (%side2-hyps))
           (let ((lam (%lam))
                 (fvx (expr-free-expr-vars x))
                 (fvv
                  (atom-free-expr-vars (make-atom-lambda/lambdan pa ba ta))))
             (%closure-hyps)))
  :use (ll-context-ok-p-facts-nb
        lifted-atom-transform-facts
        lifted-def-name-facts
        lifted-ref-apply-ok
        lifted-orig-eval
        lifted-closure-env-facts
        lifted-closure-fv-subset)
  :in-theory (theory 'minimal-theory)
  :rule-classes nil)

; The lifted-lambda case of the simulation: a lambda that lifting lifts out
; evaluates to a closure related to the one the reference to its definition
; evaluates to.

(defruled eval-expr-ll-reaches-p-when-lifted-lambda
  (implies (and (%case-hyps) (%side-hyps) (%side2-hyps))
