; Boxes: the array is evaluated as an expression, by the induction
; hypothesis, in the same context.

(defruled box-atom-facts
  (implies (and (atomp a)
                (equal (atom-kind a) :box))
           (b* ((ar (atom-box->array a))
                (na (ll-context-new-expr ar ctx))
                (a2 (ll-context-new-atom a ctx)))
             (and (equal a2 (atom-box (atom-box->ispace a) na
                                      (atom-box->type? a)))
                  (equal (mv-nth 1 (ll-atom a (ll-context->tenv ctx)
                                            (ll-context->tlets ctx)
                                            (ll-context->locals ctx)
                                            (ll-context->lmap ctx)
                                            (ll-context->used ctx)))
                         (ll-context-lifted ar ctx))
                  (equal (atom-free-expr-vars a) (expr-free-expr-vars ar))
                  (equal (atom-free-expr-vars a2) (expr-free-expr-vars na))
                  (equal (atom-binder-names a) (expr-binder-names ar)))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-atom a tenv tlets locals lmap used))
           (atom-free-expr-vars a)
           (:free (i b ty) (atom-free-expr-vars (atom-box i b ty)))
           (atom-binder-names a))
  :enable (ll-context-new-atom ll-context-new-expr ll-context-lifted))

(defruled eval-atom-of-box-with-new-array
  (implies (and (atomp a)
                (equal (atom-kind a) :box)
                (not (reserrp (eval-atom a denv limit)))
                (equal (expr-denv->tenv new-denv) (expr-denv->tenv denv))
                (natp l)
                (not (reserrp (eval-expr na new-denv l))))
           (and (equal (eval-atom (atom-box (atom-box->ispace a) na
                                            (atom-box->type? a))
                                  new-denv (+ 1 l))
                       (change-expr-value-box (eval-atom a denv limit)
                                              :array (eval-expr na new-denv l)))
))
  :expand ((eval-atom a denv limit)
           (:free (i b ty) (eval-atom (atom-box i b ty) new-denv (+ 1 l))))
  :enable (expr-valuep-when-result-not-error))

(defruled eval-atom-of-box-parts
  (implies (and (atomp a)
                (equal (atom-kind a) :box)
                (not (reserrp (eval-atom a denv limit))))
           (and (equal (expr-value-kind (eval-atom a denv limit)) :box)
                (equal (expr-value-box->array (eval-atom a denv limit))
                       (eval-expr (atom-box->array a) denv (1- limit)))
                (not (reserrp (eval-expr (atom-box->array a) denv
                                         (1- limit))))))
  :expand ((eval-atom a denv limit))
  :enable (expr-valuep-when-result-not-error))

(defrule expr-value-ll-related-p-of-fixes-local
  (and (equal (expr-value-ll-related-p (expr-value-fix nv) v w genv)
              (expr-value-ll-related-p nv v w genv))
       (equal (expr-value-ll-related-p nv v (ll-value-witness-fix w) genv)
              (expr-value-ll-related-p nv v w genv)))
  :expand ((:free (nv w) (expr-value-ll-related-p nv v w genv))))

(defrule expr-value-ll-related-p-of-val-fix-local
  (equal (expr-value-ll-related-p nv (expr-value-fix v) w genv)
         (expr-value-ll-related-p nv v w genv))
  :expand ((expr-value-ll-related-p nv (expr-value-fix v) w genv)
           (expr-value-ll-related-p nv v w genv)))

(defruled expr-value-ll-related-p-of-change-box-array
  (implies (and (equal (expr-value-kind v) :box)
                (expr-value-ll-related-p nv (expr-value-box->array v) w genv))
           (expr-value-ll-related-p (change-expr-value-box v :array nv) v
                                    (ll-value-witness-box w) genv))
  :expand ((:free (nv2) (expr-value-ll-related-p nv2 v
                                                 (ll-value-witness-box w)
                                                 genv))))

(defmacro %bw ()
  '(eval-expr-ll-reaches-p-witness
    (ll-context-new-expr (atom-box->array a) ctx)
    new-denv
    (eval-expr (atom-box->array a) denv (1- limit))
    genv))

(defruled eval-atom-ll-reaches-p-when-box
  (b* ((x (expr-array nil (list a))))
    (implies (and (atomp a)
                  (equal (atom-kind a) :box)
                  (not (reserrp (eval-atom a denv limit)))
                  (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                  (ll-context-ok-p x ctx genv)
                  (expr-denv-wfp denv)
                  (expr-denv-wfp new-denv)
                  (eval-expr-ll-ok (atom-box->array a) denv (1- limit)))
             (eval-atom-ll-reaches-p (ll-context-new-atom a ctx)
                                     new-denv
                                     (eval-atom a denv limit)
                                     genv)))
  :use (box-atom-facts
        (:instance ll-expr-of-singleton-array)
        (:instance free-and-binders-of-singleton-array (d nil))
        (:instance free-and-binders-of-singleton-array
                   (d nil) (a (ll-context-new-atom a ctx)))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (x (expr-array nil (list a))) (excl nil))
        (:instance ll-context-ok-p-of-binder-suffix
                   (x (expr-array nil (list a)))
                   (y (atom-box->array a))
                   (pre nil))
        (:instance expr-denv-ll-related-p-of-sub
                   (x (expr-array nil (list a)))
                   (y (atom-box->array a))
                   (ctx2 ctx) (excl nil) (excl2 nil))
        (:instance eval-expr-ll-ok-necc
                   (expr (atom-box->array a)) (limit (1- limit)))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (ll-context-new-expr (atom-box->array a) ctx))
                   (val (eval-expr (atom-box->array a) denv (1- limit))))
        eval-atom-of-box-parts
        (:instance posp-limit-when-eval-expr-ok
                   (expr (ll-context-new-expr (atom-box->array a) ctx))
                   (denv new-denv) (limit (mv-nth 0 (%bw))))
        (:instance eval-atom-of-box-with-new-array
                   (na (ll-context-new-expr (atom-box->array a) ctx))
                   (l (mv-nth 0 (%bw))))
        (:instance expr-value-ll-related-p-of-change-box-array
                   (v (eval-atom a denv limit))
                   (nv (eval-expr (ll-context-new-expr (atom-box->array a) ctx)
                                  new-denv (mv-nth 0 (%bw))))
                   (w (mv-nth 1 (%bw))))
        (:instance eval-atom-ll-reaches-p-suff
                   (new-atom (ll-context-new-atom a ctx))
                   (limit2 (+ 1 (mv-nth 0 (%bw))))
                   (w (ll-value-witness-box (mv-nth 1 (%bw))))
                   (val (eval-atom a denv limit))))
  :in-theory (e/d (ll-expr-of-singleton-array
                   free-and-binders-of-singleton-array box-atom-facts)
                      (ll-expr ll-atom eval-expr eval-atom
                      expr-denv-ll-related-p expr-value-ll-related-p
                      ll-context-ok-p ll-context-new-expr ll-context-lifted
                      ll-context-new-atom eval-expr-ll-ok eval-expr-ll-ok-necc
                      eval-atom-ll-reaches-p eval-atom-ll-reaches-p-suff
                      eval-expr-ll-reaches-p
                      equal-of-expr-array equal-of-atom-box
                      equal-of-expr-value-box))
  :enable (not-reserrp-when-expr-valuep))

; Nested boxes: the witness of a box nest is a nest of box witnesses.

(define ll-box-nest-witness ((ivals ispace-value-listp)
                             (w ll-value-witness-p))
  :returns (wit ll-value-witness-p)
  :short "The witness of the relation at a nest of boxes."
  (if (or (endp ivals) (endp (cdr ivals)))
      (ll-value-witness-box w)
    (ll-value-witness-box (ll-box-nest-witness (cdr ivals) w))))

(defruled expr-value-ll-related-p-of-box-nest
  (implies (and (expr-value-ll-related-p nv v w genv)
                (not (reserrp (box-nest ivals v tval))))
           (and (not (reserrp (box-nest ivals nv tval)))
                (expr-value-ll-related-p (box-nest ivals nv tval)
                                         (box-nest ivals v tval)
                                         (ll-box-nest-witness ivals w)
                                         genv)))
  :induct (box-nest ivals v tval)
  :expand ((box-nest ivals v tval)
           (box-nest ivals nv tval)
           (ll-box-nest-witness ivals w)
           (:free (nv2 v2 w2)
                  (expr-value-ll-related-p nv2 v2 (ll-value-witness-box w2)
                                           genv)))
  :enable (not-reserrp-when-expr-valuep (:induction box-nest)
           expr-valuep-when-result-not-error))

(defmacro %bivals ()
  '(eval-ispace-list (atom-boxn->ispaces a)
                     (type-denv->ienv (expr-denv->tenv denv))))

(defmacro %btval ()
  '(eval-type (type-option-some->val (atom-boxn->type? a))
              (expr-denv->tenv denv)))

(defruled boxn-atom-facts
  (implies (and (atomp a)
                (equal (atom-kind a) :boxn))
           (b* ((ar (atom-boxn->array a))
                (na (ll-context-new-expr ar ctx))
                (a2 (ll-context-new-atom a ctx)))
             (and (equal a2 (atom-boxn (atom-boxn->ispaces a) na
                                       (atom-boxn->type? a)))
                  (equal (mv-nth 1 (ll-atom a (ll-context->tenv ctx)
                                            (ll-context->tlets ctx)
                                            (ll-context->locals ctx)
                                            (ll-context->lmap ctx)
                                            (ll-context->used ctx)))
                         (ll-context-lifted ar ctx))
                  (equal (atom-free-expr-vars a) (expr-free-expr-vars ar))
                  (equal (atom-free-expr-vars a2) (expr-free-expr-vars na))
                  (equal (atom-binder-names a) (expr-binder-names ar)))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-atom a tenv tlets locals lmap used))
           (atom-free-expr-vars a)
           (:free (i b ty) (atom-free-expr-vars (atom-boxn i b ty)))
           (atom-binder-names a))
  :enable (ll-context-new-atom ll-context-new-expr ll-context-lifted))

(defruled eval-atom-of-boxn-parts
  (implies (and (atomp a)
                (equal (atom-kind a) :boxn)
                (not (reserrp (eval-atom a denv limit))))
           (and (not (reserrp (eval-expr (atom-boxn->array a) denv
                                         (1- limit))))
                (not (reserrp (%bivals)))
                (not (reserrp (%btval)))
                (atom-boxn->type? a)
                (equal (eval-atom a denv limit)
                       (box-nest (%bivals)
                                 (eval-expr (atom-boxn->array a) denv
                                            (1- limit))
                                 (%btval)))))
  :expand ((eval-atom a denv limit)))

(defruled eval-atom-of-boxn-with-new-array
  (implies (and (atomp a)
                (equal (atom-kind a) :boxn)
                (not (reserrp (eval-atom a denv limit)))
                (equal (expr-denv->tenv new-denv) (expr-denv->tenv denv))
                (natp l)
                (not (reserrp (eval-expr na new-denv l))))
           (equal (eval-atom (atom-boxn (atom-boxn->ispaces a) na
                                        (atom-boxn->type? a))
                             new-denv (+ 1 l))
                  (box-nest (%bivals) (eval-expr na new-denv l) (%btval))))
  :use eval-atom-of-boxn-parts
  :expand ((:free (i b ty) (eval-atom (atom-boxn i b ty) new-denv (+ 1 l)))))

(defmacro %bnw ()
  '(eval-expr-ll-reaches-p-witness
    (ll-context-new-expr (atom-boxn->array a) ctx)
    new-denv
    (eval-expr (atom-boxn->array a) denv (1- limit))
    genv))

(defruled eval-atom-ll-reaches-p-when-boxn
  (b* ((x (expr-array nil (list a))))
    (implies (and (atomp a)
                  (equal (atom-kind a) :boxn)
                  (not (reserrp (eval-atom a denv limit)))
                  (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                  (ll-context-ok-p x ctx genv)
                  (expr-denv-wfp denv)
                  (expr-denv-wfp new-denv)
                  (eval-expr-ll-ok (atom-boxn->array a) denv (1- limit)))
             (eval-atom-ll-reaches-p (ll-context-new-atom a ctx)
                                     new-denv
                                     (eval-atom a denv limit)
                                     genv)))
  :use (boxn-atom-facts
        eval-atom-of-boxn-parts
        (:instance ll-expr-of-singleton-array)
        (:instance free-and-binders-of-singleton-array (d nil))
        (:instance free-and-binders-of-singleton-array
                   (d nil) (a (ll-context-new-atom a ctx)))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (x (expr-array nil (list a))) (excl nil))
        (:instance ll-context-ok-p-of-binder-suffix
                   (x (expr-array nil (list a)))
                   (y (atom-boxn->array a))
                   (pre nil))
        (:instance expr-denv-ll-related-p-of-sub
                   (x (expr-array nil (list a)))
                   (y (atom-boxn->array a))
                   (ctx2 ctx) (excl nil) (excl2 nil))
        (:instance eval-expr-ll-ok-necc
                   (expr (atom-boxn->array a)) (limit (1- limit)))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (ll-context-new-expr (atom-boxn->array a) ctx))
                   (val (eval-expr (atom-boxn->array a) denv (1- limit))))
        (:instance posp-limit-when-eval-expr-ok
                   (expr (ll-context-new-expr (atom-boxn->array a) ctx))
                   (denv new-denv) (limit (mv-nth 0 (%bnw))))
        (:instance eval-atom-of-boxn-with-new-array
                   (na (ll-context-new-expr (atom-boxn->array a) ctx))
                   (l (mv-nth 0 (%bnw))))
        (:instance expr-value-ll-related-p-of-box-nest
                   (ivals (%bivals)) (tval (%btval))
                   (v (eval-expr (atom-boxn->array a) denv (1- limit)))
                   (nv (eval-expr (ll-context-new-expr (atom-boxn->array a) ctx)
                                  new-denv (mv-nth 0 (%bnw))))
                   (w (mv-nth 1 (%bnw))))
        (:instance eval-atom-ll-reaches-p-suff
                   (new-atom (ll-context-new-atom a ctx))
                   (limit2 (+ 1 (mv-nth 0 (%bnw))))
                   (w (ll-box-nest-witness (%bivals) (mv-nth 1 (%bnw))))
                   (val (eval-atom a denv limit))))
  :in-theory (e/d (ll-expr-of-singleton-array
                   free-and-binders-of-singleton-array boxn-atom-facts)
                      (ll-expr ll-atom eval-expr eval-atom box-nest
                      expr-denv-ll-related-p expr-value-ll-related-p
                      ll-context-ok-p ll-context-new-expr ll-context-lifted
                      ll-context-new-atom eval-expr-ll-ok eval-expr-ll-ok-necc
                      eval-atom-ll-reaches-p eval-atom-ll-reaches-p-suff
                      eval-expr-ll-reaches-p
                      equal-of-expr-array equal-of-atom-boxn)))

; Base literals evaluate to the same ground value in both programs.

(defruled eval-atom-ll-reaches-p-when-base
  (implies (and (atomp a)
                (equal (atom-kind a) :base)
                (not (reserrp (eval-atom a denv limit))))
           (eval-atom-ll-reaches-p (ll-context-new-atom a ctx)
                                   new-denv
                                   (eval-atom a denv limit)
                                   genv))
  :use ((:instance expr-value-ll-related-p-of-ground
                   (val (eval-atom a denv limit)))
        (:instance eval-atom-ll-reaches-p-suff
                   (new-atom (ll-context-new-atom a ctx))
                   (limit2 1)
                   (w (ll-value-witness-ground))
                   (val (eval-atom a denv limit))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-atom a tenv tlets locals lmap used))
           (:free (d l) (eval-atom a d l))
           (:free (b) (expr-value-groundp (expr-value-base b))))
  :enable (ll-context-new-atom)
  :disable (eval-atom-ll-reaches-p eval-atom-ll-reaches-p-suff))

; The lambda atoms, as made by MAKE-ATOM-LAMBDA/LAMBDAN.

(defruled lambda-atom-as-make-atom-lambda/lambdan
  (implies (atomp a)
           (and (implies (equal (atom-kind a) :lambda)
                         (equal (make-atom-lambda/lambdan
                                 (list (atom-lambda->param a))
                                 (atom-lambda->body a)
                                 (atom-lambda->type? a))
                                a))
                (implies (equal (atom-kind a) :lambdan)
                         (and (equal (make-atom-lambda/lambdan
                                      (atom-lambdan->params a)
                                      (atom-lambdan->body a)
                                      (atom-lambdan->type? a))
                                     a)
                              (consp (atom-lambdan->params a))))))
  :use ((:instance atom-lambdan-requirements (x a))
        (:instance consp-cdr-when-len-at-least-2
                   (l (atom-lambdan->params a))))
  :enable (make-atom-lambda/lambdan))

; Any atom, given the induction hypothesis for the array of a box.

(defruled eval-atom-ll-reaches-p-when-ok
  (b* ((x (expr-array nil (list a))))
    (implies (and (atomp a)
                  (not (reserrp (eval-atom a denv limit)))
                  (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                  (ll-context-ok-p x ctx genv)
                  (expr-denv-wfp denv)
                  (expr-denv-wfp new-denv)
                  (implies (equal (atom-kind a) :box)
                           (eval-expr-ll-ok (atom-box->array a) denv
                                            (1- limit)))
                  (implies (equal (atom-kind a) :boxn)
                           (eval-expr-ll-ok (atom-boxn->array a) denv
                                            (1- limit))))
             (eval-atom-ll-reaches-p (ll-context-new-atom a ctx)
                                     new-denv
                                     (eval-atom a denv limit)
                                     genv)))
  :cases ((equal (atom-kind a) :base)
          (equal (atom-kind a) :lambda)
          (equal (atom-kind a) :lambdan)
          (equal (atom-kind a) :tlambda)
          (equal (atom-kind a) :tlambdan)
          (equal (atom-kind a) :ilambda)
          (equal (atom-kind a) :ilambdan)
          (equal (atom-kind a) :box)
          (equal (atom-kind a) :boxn))
  :use (lambda-atom-as-make-atom-lambda/lambdan
        eval-atom-ll-reaches-p-when-base
        eval-atom-ll-reaches-p-when-tlambda
        eval-atom-ll-reaches-p-when-tlambdan
        eval-atom-ll-reaches-p-when-ilambda
        eval-atom-ll-reaches-p-when-ilambdan
        eval-atom-ll-reaches-p-when-box
        eval-atom-ll-reaches-p-when-boxn
        (:instance eval-atom-ll-reaches-p-when-lambda
                   (pa (list (atom-lambda->param a)))
                   (ba (atom-lambda->body a))
                   (ta (atom-lambda->type? a)))
        (:instance eval-atom-ll-reaches-p-when-lambda
                   (pa (atom-lambdan->params a))
                   (ba (atom-lambdan->body a))
                   (ta (atom-lambdan->type? a))))
  :in-theory (disable eval-atom-ll-reaches-p eval-atom expr-denv-ll-related-p
                      ll-context-ok-p ll-context-new-atom eval-expr-ll-ok
                      make-atom-lambda/lambdan))

(defruled eval-atom-ll-ok-when-ok
  (implies (and (atomp atom)
                (implies (equal (atom-kind atom) :box)
                         (eval-expr-ll-ok (atom-box->array atom) denv
                                          (1- limit)))
                (implies (equal (atom-kind atom) :boxn)
                         (eval-expr-ll-ok (atom-boxn->array atom) denv
                                          (1- limit))))
           (eval-atom-ll-ok atom denv limit))
  :expand ((eval-atom-ll-ok atom denv limit))
  :use ((:instance eval-atom-ll-reaches-p-when-ok
                   (a atom)
                   (ctx (mv-nth 0 (eval-atom-ll-ok-witness atom denv limit)))
                   (new-denv
                    (mv-nth 1 (eval-atom-ll-ok-witness atom denv limit)))
                   (dw (mv-nth 2 (eval-atom-ll-ok-witness atom denv limit)))
                   (genv (mv-nth 3 (eval-atom-ll-ok-witness atom denv limit)))))
  :in-theory (disable eval-atom-ll-reaches-p eval-atom expr-denv-ll-related-p
                      ll-context-ok-p ll-context-new-atom eval-expr-ll-ok))

; The expression atom case: a liftable lambda, or an atom that LL-ATOM
; rebuilds, by the induction hypothesis for its evaluation as an atom.

(defruled eval-atom-ll-reaches-p-elim
  (implies (eval-atom-ll-reaches-p new-atom new-denv val genv)
           (b* (((mv l w)
                 (eval-atom-ll-reaches-p-witness new-atom new-denv val genv))
                (nv (eval-atom new-atom new-denv l)))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv val w genv))))
  :enable eval-atom-ll-reaches-p)

(defruled posp-limit-when-eval-atom-ok
  (implies (not (reserrp (eval-atom atom denv limit)))
           (posp limit))
  :expand ((eval-atom atom denv limit)))

(defrule liftable-lambda-p-kinds
  (implies (liftable-lambda-p a tenv locals lmap)
           (or (equal (atom-kind a) :lambda)
               (equal (atom-kind a) :lambdan)))
  :rule-classes nil
  :enable liftable-lambda-p)

(defruled atom-shape-of-expr-atom
  (implies (equal (expr-kind x) :atom)
           (b* ((a (expr-atom->atom x))
                (xa (expr-array nil (list a))))
             (and (equal (expr-free-expr-vars xa) (expr-free-expr-vars x))
                  (equal (expr-binder-names xa) (expr-binder-names x)))))
  :use ((:instance free-and-binders-of-singleton-array
                   (d nil) (a (expr-atom->atom x)))
        (:instance expr-free-expr-vars-when-atom-kind (e x))
        (:instance expr-binder-names-when-atom-kind)))

(defmacro %xa () '(expr-array nil (list (expr-atom->atom x))))

(defmacro %aw ()
  '(eval-atom-ll-reaches-p-witness
    (ll-context-new-atom (expr-atom->atom x) ctx)
    new-denv
    (eval-atom (expr-atom->atom x) denv (1- limit))
    genv))

(defruled eval-expr-ll-reaches-p-when-unliftable-atom
  (implies (and (equal (expr-kind x) :atom)
                (not (liftable-lambda-p (expr-atom->atom x)
                                        (ll-context->tenv ctx)
                                        (ll-context->locals ctx)
                                        (ll-context->lmap ctx)))
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-atom-ll-ok (expr-atom->atom x) denv (1- limit)))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (ll-expr-of-unliftable-atom
        atom-shape-of-expr-atom
        (:instance posp-limit-when-eval-expr-ok (expr x))
        (:instance ll-expr-of-singleton-array (a (expr-atom->atom x)))
        (:instance free-and-binders-of-singleton-array
                   (d nil) (a (ll-context-new-atom (expr-atom->atom x) ctx)))
        (:instance expr-free-expr-vars-of-expr-atom
                   (atom (ll-context-new-atom (expr-atom->atom x) ctx)))
        (:instance eval-expr-when-atom-kind (e x))
        (:instance expr-denv-ll-related-p-of-sub
                   (y (%xa)) (ctx2 ctx) (excl nil) (excl2 nil))
        (:instance ll-context-ok-p-of-binder-suffix
                   (y (%xa)) (pre nil))
        (:instance eval-atom-ll-ok-necc
                   (atom (expr-atom->atom x)) (limit (1- limit)))
        (:instance eval-atom-ll-reaches-p-elim
                   (new-atom (ll-context-new-atom (expr-atom->atom x) ctx))
                   (val (eval-atom (expr-atom->atom x) denv (1- limit))))
        (:instance posp-limit-when-eval-atom-ok
                   (atom (ll-context-new-atom (expr-atom->atom x) ctx))
                   (denv new-denv) (limit (mv-nth 0 (%aw))))
        (:instance eval-expr-when-atom-kind
                   (e (expr-atom (ll-context-new-atom (expr-atom->atom x) ctx)))
                   (denv new-denv) (limit (+ 1 (mv-nth 0 (%aw)))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (ll-context-new-expr x ctx))
                   (limit2 (+ 1 (mv-nth 0 (%aw))))
                   (w (mv-nth 1 (%aw)))
                   (val (eval-expr x denv limit))))
  :in-theory (disable ll-expr ll-atom eval-expr eval-atom
                      expr-denv-ll-related-p expr-value-ll-related-p
                      ll-context-ok-p ll-context-new-expr ll-context-lifted
                      ll-context-new-atom eval-atom-ll-ok eval-atom-ll-ok-necc
                      eval-atom-ll-reaches-p eval-expr-ll-reaches-p-suff
                      eval-expr-ll-reaches-p liftable-lambda-p
                      equal-of-expr-array equal-of-expr-atom))

(defruled eval-expr-ll-reaches-p-when-atom
  (implies (and (equal (expr-kind x) :atom)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-atom-ll-ok (expr-atom->atom x) denv (1- limit)))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :cases ((not (liftable-lambda-p (expr-atom->atom x)
                                  (ll-context->tenv ctx)
                                  (ll-context->locals ctx)
                                  (ll-context->lmap ctx)))
          (equal (atom-kind (expr-atom->atom x)) :lambda)
          (equal (atom-kind (expr-atom->atom x)) :lambdan))
  :use (eval-expr-ll-reaches-p-when-unliftable-atom
        (:instance liftable-lambda-p-kinds
                   (a (expr-atom->atom x))
                   (tenv (ll-context->tenv ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx)))
        (:instance lambda-atom-as-make-atom-lambda/lambdan
                   (a (expr-atom->atom x)))
        (:instance eval-expr-ll-reaches-p-when-liftable-lambda
                   (pa (list (atom-lambda->param (expr-atom->atom x))))
                   (ba (atom-lambda->body (expr-atom->atom x)))
                   (ta (atom-lambda->type? (expr-atom->atom x))))
        (:instance eval-expr-ll-reaches-p-when-liftable-lambda
                   (pa (atom-lambdan->params (expr-atom->atom x)))
                   (ba (atom-lambdan->body (expr-atom->atom x)))
                   (ta (atom-lambdan->type? (expr-atom->atom x)))))
  :in-theory (disable ll-expr ll-atom eval-expr eval-atom
                      expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr eval-atom-ll-ok
                      eval-expr-ll-reaches-p liftable-lambda-p
                      make-atom-lambda/lambdan))


; The context invariant at an expression gives it at a part of it, whose
; binders are among the expression's, without duplicates if those are not,
; in a context with the same fields but possibly more names in use, if the
; definitions lifted out of the part are bound.

(defruled ll-context-ok-p-of-part
  (implies (and (ll-context-ok-p x ctx genv)
                (equal (ll-context->tenv ctx2) (ll-context->tenv ctx))
                (equal (ll-context->tlets ctx2) (ll-context->tlets ctx))
                (equal (ll-context->locals ctx2) (ll-context->locals ctx))
                (equal (ll-context->lmap ctx2) (ll-context->lmap ctx))
                (set::subset (ll-context->used ctx) (ll-context->used ctx2))
                (subsetp-equal (expr-binder-names y) (expr-binder-names x))
                (implies (no-duplicatesp-equal (expr-binder-names x))
                         (no-duplicatesp-equal (expr-binder-names y)))
                (ll-defs-bound-p (ll-context-lifted y ctx2) genv))
           (ll-context-ok-p y ctx2 genv))
  :use ((:instance not-intersectp-when-subsetp-local
                   (bx (expr-binder-names x)) (l (ll-context->locals ctx)) (bi
                                                                            (expr-binder-names y)))
        (:instance lmap-replacements-ok-p-when-fewer-pnames
                   (lmap (ll-context->lmap ctx))
                   (locals (ll-context->locals ctx))
                   (pnames (expr-binder-names x))
                   (pnames2 (expr-binder-names y)))
        (:instance subsetp-equal-when-subset-of-set
                   (l (expr-binder-names y))
                   (s1 (ll-context->used ctx))
                   (s2 (ll-context->used ctx2))))
  :enable (ll-context-ok-p set::subset-transitive)
  :disable (lmap-replacements-ok-p))

; Lists of expressions, related at their bracket.

(defmacro %lle ()
  '(ll-expr (car exprs) (ll-context->tenv ctx) (ll-context->tlets ctx)
            (ll-context->locals ctx) (ll-context->lmap ctx)
            (ll-context->used ctx)))

(defmacro %lctx1 () '(change-ll-context ctx :used (mv-nth 2 (%lle))))

(defruled ll-context-new-expr-of-bracket
  (implies (and (expr-listp exprs) (consp exprs))
           (and (equal (ll-context-new-expr (expr-bracket exprs) ctx)
                       (expr-bracket (ll-context-new-exprs exprs ctx)))
                (equal (ll-context-lifted (expr-bracket exprs) ctx)
                       (mv-nth 1 (ll-expr-list exprs (ll-context->tenv ctx)
                                               (ll-context->tlets ctx)
                                               (ll-context->locals ctx)
                                               (ll-context->lmap ctx)
                                               (ll-context->used ctx))))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-expr (expr-bracket exprs) tenv tlets locals lmap used)))
  :enable (ll-context-new-expr ll-context-new-exprs ll-context-lifted))

(defruled ll-expr-list-of-cons-parts
  (implies (and (expr-listp exprs) (consp exprs))
           (and (equal (ll-context-new-exprs exprs ctx)
                       (cons (ll-context-new-expr (car exprs) ctx)
                             (ll-context-new-exprs (cdr exprs) (%lctx1))))
                (equal (mv-nth 1 (ll-expr-list exprs (ll-context->tenv ctx)
                                               (ll-context->tlets ctx)
                                               (ll-context->locals ctx)
                                               (ll-context->lmap ctx)
                                               (ll-context->used ctx)))
                       (append (ll-context-lifted (car exprs) ctx)
                               (mv-nth 1 (ll-expr-list
                                          (cdr exprs)
                                          (ll-context->tenv ctx)
                                          (ll-context->tlets ctx)
                                          (ll-context->locals ctx)
                                          (ll-context->lmap ctx)
                                          (mv-nth 2 (%lle))))))
                (implies (not (consp (cdr exprs)))
                         (equal (mv-nth 1 (ll-expr-list
                                           (cdr exprs)
                                           (ll-context->tenv ctx)
                                           (ll-context->tlets ctx)
                                           (ll-context->locals ctx)
                                           (ll-context->lmap ctx)
                                           (mv-nth 2 (%lle))))
                                nil))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-expr-list exprs tenv tlets locals lmap used))
           (:free (tenv tlets locals lmap used)
                  (ll-expr-list (cdr exprs) tenv tlets locals lmap used))
           (:free (tenv tlets locals lmap used)
                  (ll-expr-list nil tenv tlets locals lmap used)))
  :enable (ll-context-new-expr ll-context-new-exprs ll-context-lifted))

(defruled free-and-binders-of-bracket-split
  (implies (consp es)
           (and (equal (expr-free-expr-vars (expr-bracket es))
                       (if (consp (cdr es))
                           (set::union (expr-free-expr-vars (car es))
                                       (expr-free-expr-vars
                                        (expr-bracket (cdr es))))
                         (expr-free-expr-vars (car es))))
                (equal (expr-binder-names (expr-bracket es))
                       (if (consp (cdr es))
                           (append (expr-binder-names (car es))
                                   (expr-binder-names (expr-bracket (cdr es))))
                         (expr-binder-names (car es))))))
  :expand ((:free (es) (expr-free-expr-vars (expr-bracket es)))
           (:free (es) (expr-binder-names (expr-bracket es)))
           (expr-list-free-expr-vars es)
           (expr-list-binder-names es)
           (expr-list-free-expr-vars (cdr es))
           (expr-list-binder-names (cdr es))))

(defrule ll-context-new-exprs-of-nil-local
  (equal (ll-context-new-exprs nil ctx) nil)
  :enable ll-context-new-exprs
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-expr-list nil tenv tlets locals lmap used))))

(defruled ll-defs-bound-p-when-ll-context-ok-p
  (implies (ll-context-ok-p x ctx genv)
           (ll-defs-bound-p (ll-context-lifted x ctx) genv))
  :enable ll-context-ok-p)

(defruled used-of-ll-context-step
  (set::subset (ll-context->used ctx) (ll-context->used (%lctx1)))
  :use ((:instance used-of-ll-expr
                   (x (car exprs))
                   (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx))
                   (used (ll-context->used ctx))))
  :disable (ll-expr))

(defrule true-listp-of-ll-context-lifted
  (true-listp (ll-context-lifted x ctx))
  :use ((:instance true-listp-when-bind-listp-compound-recognizer
                   (acl2::x (ll-context-lifted x ctx)))))

(defruled no-duplicate-binders-when-ll-context-ok-p
  (implies (ll-context-ok-p x ctx genv)
           (no-duplicatesp-equal (expr-binder-names x)))
  :enable ll-context-ok-p)

(defruled bracket-parts-ok-first
  (implies (and (expr-listp exprs)
                (consp exprs)
                (ll-context-ok-p (expr-bracket exprs) ctx genv))
           (ll-context-ok-p (car exprs) ctx genv))
  :use (ll-expr-list-of-cons-parts
        ll-context-new-expr-of-bracket
        (:instance ll-defs-bound-p-when-ll-context-ok-p
                   (x (expr-bracket exprs)))
        (:instance no-duplicate-binders-when-ll-context-ok-p
                   (x (expr-bracket exprs)))
        (:instance free-and-binders-of-bracket-split (es exprs))
        (:instance ll-context-ok-p-of-part
                   (x (expr-bracket exprs)) (y (car exprs)) (ctx2 ctx)))
  :disable
  (no-duplicatesp-equal
   no-duplicatesp-equal-when-no-duplicatesp-equal-of-type-var-list->name
   no-duplicatesp-equal-when-no-duplicatesp-equal-of-ispace-var-list->name
   member-equal no-duplicatesp-equal-when-not-duplicated-names
   duplicated-names-when-no-duplicatesp-equal
   acl2::consp-when-member-equal-of-cons-listp acl2::subsetp-car-member
   acl2::no-duplicatesp-equal-when-atom
   member-equal-of-type-var-list->name-when-member-equal
   member-equal-of-ispace-var-list->name-when-member-equal
   acl2::subsetp-when-atom-right ll-expr ll-expr-list ll-context-ok-p
   ll-context-new-expr ll-context-lifted ll-context-new-exprs
   equal-of-expr-bracket)
  :enable (ll-expr-list-of-cons-parts ll-context-new-expr-of-bracket
           free-and-binders-of-bracket-split)
  :restrict ((ll-expr-list-of-cons-parts ((exprs exprs) (ctx ctx)))
             (free-and-binders-of-bracket-split
              ((es exprs))
              ((es (ll-context-new-exprs exprs ctx)))
              ((es (cons (ll-context-new-expr (car exprs) ctx)
                         (ll-context-new-exprs (cdr exprs) (%lctx1))))))))

(defruled bracket-parts-ok-rest
  (implies (and (consp (cdr exprs))
                (expr-listp exprs)
                (consp exprs)
                (ll-context-ok-p (expr-bracket exprs) ctx genv))
           (ll-context-ok-p (expr-bracket (cdr exprs)) (%lctx1) genv))
  :use (ll-expr-list-of-cons-parts
        ll-context-new-expr-of-bracket
        used-of-ll-context-step
        (:instance ll-context-new-expr-of-bracket
                   (exprs (cdr exprs)) (ctx (%lctx1)))
        (:instance ll-defs-bound-p-when-ll-context-ok-p
                   (x (expr-bracket exprs)))
        (:instance no-duplicate-binders-when-ll-context-ok-p
                   (x (expr-bracket exprs)))
        (:instance free-and-binders-of-bracket-split (es exprs))
        (:instance ll-context-ok-p-of-part
                   (x (expr-bracket exprs)) (y (expr-bracket (cdr exprs)))
                   (ctx2 (%lctx1))))
  :disable
  (no-duplicatesp-equal
   no-duplicatesp-equal-when-no-duplicatesp-equal-of-type-var-list->name
   no-duplicatesp-equal-when-no-duplicatesp-equal-of-ispace-var-list->name
   member-equal no-duplicatesp-equal-when-not-duplicated-names
   duplicated-names-when-no-duplicatesp-equal
   acl2::consp-when-member-equal-of-cons-listp acl2::subsetp-car-member
   acl2::no-duplicatesp-equal-when-atom
   member-equal-of-type-var-list->name-when-member-equal
   member-equal-of-ispace-var-list->name-when-member-equal
   acl2::subsetp-when-atom-right ll-expr ll-expr-list ll-context-ok-p
   ll-context-new-expr ll-context-lifted ll-context-new-exprs
   equal-of-expr-bracket)
  :enable (ll-expr-list-of-cons-parts ll-context-new-expr-of-bracket
           free-and-binders-of-bracket-split)
  :restrict ((ll-expr-list-of-cons-parts ((exprs exprs) (ctx ctx)))
             (free-and-binders-of-bracket-split
              ((es exprs))
              ((es (ll-context-new-exprs exprs ctx)))
              ((es (cons (ll-context-new-expr (car exprs) ctx)
                         (ll-context-new-exprs (cdr exprs) (%lctx1))))))))

(defruled bracket-parts-ok
  (implies (and (expr-listp exprs)
                (consp exprs)
                (ll-context-ok-p (expr-bracket exprs) ctx genv))
           (and (ll-context-ok-p (car exprs) ctx genv)
                (implies (consp (cdr exprs))
                         (ll-context-ok-p (expr-bracket (cdr exprs))
                                          (%lctx1) genv))))
  :use (bracket-parts-ok-first bracket-parts-ok-rest)
  :in-theory nil)

(defruled len-of-ll-context-new-exprs-local
  (equal (len (ll-context-new-exprs exprs ctx)) (len exprs))
  :enable ll-context-new-exprs)

(defruled consp-of-ll-context-new-exprs-local
  (equal (consp (ll-context-new-exprs exprs ctx))
         (consp exprs))
  :use ((:instance len-of-ll-context-new-exprs-local))
  :expand ((len (ll-context-new-exprs exprs ctx)) (len exprs)))

(defruled bracket-parts-related-first
  (implies (and (expr-listp exprs)
                (consp exprs)
                (expr-denv-ll-related-p new-denv denv (expr-bracket exprs) ctx
                                        nil dw genv))
           (expr-denv-ll-related-p new-denv denv (car exprs) ctx nil dw genv))
  :use (ll-expr-list-of-cons-parts
        ll-context-new-expr-of-bracket
        (:instance free-and-binders-of-bracket-split (es exprs))
        (:instance free-and-binders-of-bracket-split
                   (es (ll-context-new-exprs exprs ctx)))
        (:instance expr-denv-ll-related-p-of-sub
                   (x (expr-bracket exprs)) (y (car exprs))
                   (ctx2 ctx) (excl nil) (excl2 nil)))
  :enable (ll-expr-list-of-cons-parts ll-context-new-expr-of-bracket
           free-and-binders-of-bracket-split
           consp-of-ll-context-new-exprs-local)
  :disable (ll-expr ll-expr-list expr-denv-ll-related-p ll-context-new-expr
            ll-context-lifted ll-context-new-exprs equal-of-expr-bracket)
  :restrict ((ll-expr-list-of-cons-parts ((exprs exprs) (ctx ctx)))
             (free-and-binders-of-bracket-split
              ((es exprs))
              ((es (ll-context-new-exprs exprs ctx)))
              ((es (cons (ll-context-new-expr (car exprs) ctx)
                         (ll-context-new-exprs (cdr exprs) (%lctx1))))))))

(defruled bracket-parts-related-rest
  (implies (and (consp (cdr exprs))
                (expr-listp exprs)
                (consp exprs)
                (expr-denv-ll-related-p new-denv denv (expr-bracket exprs) ctx
                                        nil dw genv))
           (expr-denv-ll-related-p new-denv denv (expr-bracket (cdr exprs))
                                   (%lctx1) nil dw genv))
  :use (ll-expr-list-of-cons-parts
        ll-context-new-expr-of-bracket
        (:instance ll-context-new-expr-of-bracket
                   (exprs (cdr exprs)) (ctx (%lctx1)))
        (:instance free-and-binders-of-bracket-split (es exprs))
        (:instance free-and-binders-of-bracket-split
                   (es (ll-context-new-exprs exprs ctx)))
        (:instance expr-denv-ll-related-p-of-sub
                   (x (expr-bracket exprs)) (y (expr-bracket (cdr exprs)))
                   (ctx2 (%lctx1)) (excl nil) (excl2 nil)))
  :enable (ll-expr-list-of-cons-parts ll-context-new-expr-of-bracket
           free-and-binders-of-bracket-split
           consp-of-ll-context-new-exprs-local)
  :disable (ll-expr ll-expr-list expr-denv-ll-related-p ll-context-new-expr
            ll-context-lifted ll-context-new-exprs equal-of-expr-bracket)
  :restrict ((ll-expr-list-of-cons-parts ((exprs exprs) (ctx ctx)))
             (free-and-binders-of-bracket-split
              ((es exprs))
              ((es (ll-context-new-exprs exprs ctx)))
              ((es (cons (ll-context-new-expr (car exprs) ctx)
                         (ll-context-new-exprs (cdr exprs) (%lctx1))))))))

(defruled bracket-parts-related
  (implies (and (expr-listp exprs)
                (consp exprs)
                (expr-denv-ll-related-p new-denv denv (expr-bracket exprs) ctx
                                        nil dw genv))
           (and (expr-denv-ll-related-p new-denv denv (car exprs) ctx
                                        nil dw genv)
                (implies (consp (cdr exprs))
                         (expr-denv-ll-related-p new-denv denv
                                                 (expr-bracket (cdr exprs))
                                                 (%lctx1) nil dw genv))))
  :use (bracket-parts-related-first bracket-parts-related-rest)
  :in-theory nil)

(defruled eval-expr-list-ll-reaches-p-elim
  (implies (eval-expr-list-ll-reaches-p new-exprs new-denv vals genv)
           (b* (((mv l ws)
                 (eval-expr-list-ll-reaches-p-witness new-exprs new-denv vals
                                                      genv))
                (nvs (eval-expr-list new-exprs new-denv l)))
             (and (not (reserrp nvs))
                  (expr-value-list-ll-related-p nvs vals ws genv))))
  :enable eval-expr-list-ll-reaches-p)

(defruled posp-limit-when-eval-expr-list-ok
  (implies (not (reserrp (eval-expr-list exprs denv limit)))
           (posp limit))
  :expand ((eval-expr-list exprs denv limit)))

(defruled eval-expr-list-ll-reaches-p-of-nil
  (eval-expr-list-ll-reaches-p nil new-denv nil genv)
  :use ((:instance eval-expr-list-ll-reaches-p-suff
                   (new-exprs nil) (limit2 1) (w nil) (val nil)))
  :expand ((eval-expr-list nil new-denv 1)
           (expr-value-list-ll-related-p nil nil nil genv)))

(defrule not-reserrp-of-cons-when-consp-local
  (implies (consp a)
           (not (reserrp (cons a b))))
  :enable (reserrp))

(defrule consp-of-eval-expr-local
  (consp (eval-expr e d l))
  :use ((:instance expr-valuep-when-result-not-error (x (eval-expr e d l)))
        (:instance consp-when-expr-valuep (x (eval-expr e d l))))
  :in-theory (disable eval-expr))

(defruled eval-expr-list-of-cons-at-sum-limit
  (implies (and (not (reserrp (eval-expr ne nd l1)))
                (not (reserrp (eval-expr-list nes nd l2))))
           (and (equal (eval-expr-list (cons ne nes) nd (+ 1 l1 l2))
                       (cons (eval-expr ne nd l1) (eval-expr-list nes nd l2)))
                (not (reserrp (eval-expr-list (cons ne nes) nd
                                              (+ 1 l1 l2))))))
  :use ((:instance posp-limit-when-eval-expr-ok (expr ne) (denv nd) (limit l1))
        (:instance posp-limit-when-eval-expr-list-ok
                   (exprs nes) (denv nd) (limit l2))
        (:instance eval-expr-at-larger-limit
                   (expr ne) (denv nd) (limit l1) (limit2 (+ l1 l2)))
        (:instance eval-expr-list-of-larger-limit
                   (exprs nes) (denv nd) (limit l2) (k l1))
        (:instance not-reserrp-of-cons-when-consp-local
                   (a (eval-expr ne nd l1)) (b (eval-expr-list nes nd l2)))
        (:instance consp-when-expr-valuep (x (eval-expr ne nd l1)))
        (:instance expr-valuep-when-result-not-error (x (eval-expr ne nd l1))))
  :enable (expr-valuep-when-result-not-error)
  :expand ((eval-expr-list (cons ne nes) nd (+ 1 l1 l2))))

(defruled eval-expr-list-when-cons
  (implies (and (consp exprs)
                (not (reserrp (eval-expr-list exprs denv limit))))
           (and (equal (eval-expr-list exprs denv limit)
                       (cons (eval-expr (car exprs) denv (1- limit))
                             (eval-expr-list (cdr exprs) denv (1- limit))))
                (not (reserrp (eval-expr (car exprs) denv (1- limit))))
                (not (reserrp (eval-expr-list (cdr exprs) denv (1- limit))))))
  :expand ((eval-expr-list exprs denv limit)))

(defmacro %ev1 () '(eval-expr (car exprs) denv (1- limit)))

(defmacro %evs () '(eval-expr-list (cdr exprs) denv (1- limit)))

(defmacro %ne1 () '(ll-context-new-expr (car exprs) ctx))

(defmacro %nes () '(ll-context-new-exprs (cdr exprs) (%lctx1)))

(defruled eval-expr-list-rest-reaches
  (implies (and (expr-listp exprs)
                (consp exprs)
                (not (reserrp (eval-expr-list exprs denv limit)))
                (expr-denv-ll-related-p new-denv denv (expr-bracket exprs) ctx
                                        nil dw genv)
                (ll-context-ok-p (expr-bracket exprs) ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-list-ll-ok (cdr exprs) denv (1- limit)))
           (eval-expr-list-ll-reaches-p (%nes) new-denv (%evs) genv))
  :cases ((consp (cdr exprs)))
  :use (bracket-parts-ok
        bracket-parts-related
        eval-expr-list-when-cons
        (:instance eval-expr-list-ll-ok-necc
                   (exprs (cdr exprs)) (limit (1- limit)) (ctx (%lctx1)))
        (:instance eval-expr-list-ll-reaches-p-of-nil))
  :expand ((eval-expr-list nil denv (1- limit)))
  :in-theory (disable ll-expr ll-expr-list ll-context-ok-p
                      expr-denv-ll-related-p eval-expr eval-expr-list
                      ll-context-new-exprs eval-expr-list-ll-reaches-p
                      eval-expr-list-ll-ok eval-expr-list-ll-ok-necc))

(defruled eval-expr-list-ll-reaches-p-of-cons-values
  (implies (and (eval-expr-ll-reaches-p ne nd v genv)
                (eval-expr-list-ll-reaches-p nes nd vs genv))
           (eval-expr-list-ll-reaches-p (cons ne nes) nd (cons v vs) genv))
  :use ((:instance eval-expr-ll-reaches-p-elim (new-expr ne) (new-denv nd)
                   (val v))
        (:instance eval-expr-list-ll-reaches-p-elim (new-exprs nes)
                   (new-denv nd) (vals vs))
        (:instance eval-expr-list-of-cons-at-sum-limit
                   (l1 (mv-nth 0 (eval-expr-ll-reaches-p-witness ne nd v genv)))
                   (l2 (mv-nth 0 (eval-expr-list-ll-reaches-p-witness
                                  nes nd vs genv))))
        (:instance eval-expr-list-ll-reaches-p-suff
                   (new-exprs (cons ne nes)) (new-denv nd)
                   (limit2 (+ 1 (mv-nth 0 (eval-expr-ll-reaches-p-witness
                                           ne nd v genv))
                              (mv-nth 0 (eval-expr-list-ll-reaches-p-witness
                                         nes nd vs genv))))
                   (w (cons (mv-nth 1 (eval-expr-ll-reaches-p-witness
                                       ne nd v genv))
                            (mv-nth 1 (eval-expr-list-ll-reaches-p-witness
                                       nes nd vs genv))))
                   (val (cons v vs))))
  :expand ((:free (a b c d e f)
                  (expr-value-list-ll-related-p (cons a b) (cons c d) e f)))
  :in-theory (disable eval-expr eval-expr-list eval-expr-list-ll-reaches-p
                      eval-expr-ll-reaches-p eval-expr-list-ll-reaches-p-suff
                      expr-value-ll-related-p))

(defruled eval-expr-list-ll-reaches-p-of-cons
  (implies (and (expr-listp exprs)
                (consp exprs)
                (not (reserrp (eval-expr-list exprs denv limit)))
                (expr-denv-ll-related-p new-denv denv (expr-bracket exprs) ctx
                                        nil dw genv)
                (ll-context-ok-p (expr-bracket exprs) ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok (car exprs) denv (1- limit))
                (eval-expr-list-ll-ok (cdr exprs) denv (1- limit)))
           (eval-expr-list-ll-reaches-p (ll-context-new-exprs exprs ctx)
                                        new-denv
                                        (eval-expr-list exprs denv limit)
                                        genv))
  :use (bracket-parts-ok
        bracket-parts-related
        eval-expr-list-rest-reaches
        (:instance eval-expr-list-when-cons)
        (:instance eval-expr-ll-ok-necc
                   (expr (car exprs)) (limit (1- limit)))
        (:instance eval-expr-list-ll-reaches-p-of-cons-values
                   (ne (%ne1)) (nes (%nes)) (nd new-denv)
                   (v (%ev1)) (vs (%evs))))
  :enable (eval-expr-list-when-cons ll-expr-list-of-cons-parts)
  :in-theory (disable ll-expr ll-expr-list ll-context-ok-p
                      expr-denv-ll-related-p eval-expr eval-expr-list
                      ll-context-new-exprs ll-context-new-expr
                      eval-expr-list-ll-reaches-p eval-expr-ll-reaches-p
                      eval-expr-list-ll-ok eval-expr-list-ll-ok-necc
                      eval-expr-ll-ok eval-expr-ll-ok-necc))

(defruled eval-expr-list-ll-ok-when-ok
  (implies (and (expr-listp exprs)
                (implies (consp exprs)
                         (and (eval-expr-ll-ok (car exprs) denv (1- limit))
                              (eval-expr-list-ll-ok (cdr exprs) denv
                                                    (1- limit)))))
           (eval-expr-list-ll-ok exprs denv limit))
  :expand ((:free (exprs) (eval-expr-list-ll-ok exprs denv limit))
           (eval-expr-list nil denv limit))
  :use ((:instance eval-expr-list-ll-reaches-p-of-cons
                   (ctx
                    (mv-nth 0 (eval-expr-list-ll-ok-witness exprs denv limit)))
                   (new-denv (mv-nth 1 (eval-expr-list-ll-ok-witness
                                        exprs denv limit)))
                   (dw
                    (mv-nth 2 (eval-expr-list-ll-ok-witness exprs denv limit)))
                   (genv (mv-nth 3 (eval-expr-list-ll-ok-witness
                                    exprs denv limit))))
        (:instance eval-expr-list-ll-reaches-p-of-nil
                   (new-denv (mv-nth 1 (eval-expr-list-ll-ok-witness
                                        exprs denv limit)))
                   (genv (mv-nth 3 (eval-expr-list-ll-ok-witness
                                    exprs denv limit)))))
  :in-theory (disable eval-expr-list-ll-reaches-p eval-expr-list
                      expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-exprs eval-expr-ll-ok eval-expr-list-ll-ok))

; Lists of atoms, related at their array.

(defmacro %lla ()
  '(ll-atom (car atoms) (ll-context->tenv ctx) (ll-context->tlets ctx)
            (ll-context->locals ctx) (ll-context->lmap ctx)
            (ll-context->used ctx)))

(defmacro %actx1 () '(change-ll-context ctx :used (mv-nth 2 (%lla))))

(defruled ll-context-new-expr-of-array
  (implies (and (atom-listp atoms) (consp atoms))
           (and (equal (ll-context-new-expr (expr-array d atoms) ctx)
                       (expr-array d (ll-context-new-atoms atoms ctx)))
                (equal (ll-context-lifted (expr-array d atoms) ctx)
                       (mv-nth 1 (ll-atom-list atoms (ll-context->tenv ctx)
                                               (ll-context->tlets ctx)
                                               (ll-context->locals ctx)
                                               (ll-context->lmap ctx)
                                               (ll-context->used ctx))))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-expr (expr-array d atoms) tenv tlets locals lmap used)))
  :enable (ll-context-new-expr ll-context-new-atoms ll-context-lifted))

(defruled ll-atom-list-of-cons-parts
  (implies (and (atom-listp atoms) (consp atoms))
           (and (equal (ll-context-new-atoms atoms ctx)
                       (cons (ll-context-new-atom (car atoms) ctx)
                             (ll-context-new-atoms (cdr atoms) (%actx1))))
                (equal (mv-nth 1 (ll-atom-list atoms (ll-context->tenv ctx)
                                               (ll-context->tlets ctx)
                                               (ll-context->locals ctx)
                                               (ll-context->lmap ctx)
                                               (ll-context->used ctx)))
                       (append (mv-nth 1 (%lla))
                               (mv-nth 1 (ll-atom-list
                                          (cdr atoms)
                                          (ll-context->tenv ctx)
                                          (ll-context->tlets ctx)
                                          (ll-context->locals ctx)
                                          (ll-context->lmap ctx)
                                          (mv-nth 2 (%lla))))))
                (implies (not (consp (cdr atoms)))
                         (equal (mv-nth 1 (ll-atom-list
                                           (cdr atoms)
                                           (ll-context->tenv ctx)
                                           (ll-context->tlets ctx)
                                           (ll-context->locals ctx)
                                           (ll-context->lmap ctx)
                                           (mv-nth 2 (%lla))))
                                nil))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-atom-list atoms tenv tlets locals lmap used))
           (:free (tenv tlets locals lmap used)
                  (ll-atom-list (cdr atoms) tenv tlets locals lmap used))
           (:free (tenv tlets locals lmap used)
                  (ll-atom-list nil tenv tlets locals lmap used)))
  :enable (ll-context-new-atom ll-context-new-atoms))

(defruled free-and-binders-of-array-split
  (implies (consp as)
           (and (equal (expr-free-expr-vars (expr-array d as))
                       (if (consp (cdr as))
                           (set::union (atom-free-expr-vars (car as))
                                       (expr-free-expr-vars
                                        (expr-array d (cdr as))))
                         (atom-free-expr-vars (car as))))
                (equal (expr-binder-names (expr-array d as))
                       (if (consp (cdr as))
                           (append (atom-binder-names (car as))
                                   (expr-binder-names (expr-array d (cdr as))))
                         (atom-binder-names (car as))))))
  :expand ((:free (as) (expr-free-expr-vars (expr-array d as)))
           (:free (as) (expr-binder-names (expr-array d as)))
           (atom-list-free-expr-vars as)
           (atom-list-binder-names as)
           (atom-list-free-expr-vars (cdr as))
           (atom-list-binder-names (cdr as))))

(defrule ll-context-new-atoms-of-nil-local
  (equal (ll-context-new-atoms nil ctx) nil)
  :enable ll-context-new-atoms
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-atom-list nil tenv tlets locals lmap used))))

(defruled len-of-ll-context-new-atoms-local
  (equal (len (ll-context-new-atoms atoms ctx)) (len atoms))
  :enable ll-context-new-atoms)

(defruled consp-of-ll-context-new-atoms-local
  (equal (consp (ll-context-new-atoms atoms ctx))
         (consp atoms))
  :use ((:instance len-of-ll-context-new-atoms-local))
  :expand ((len (ll-context-new-atoms atoms ctx)) (len atoms)))

(defruled used-of-ll-context-atom-step
  (set::subset (ll-context->used ctx) (ll-context->used (%actx1)))
  :use ((:instance used-of-ll-atom
                   (x (car atoms))
                   (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx))
                   (used (ll-context->used ctx))))
  :disable (ll-atom))

(defmacro %xa1 () '(expr-array nil (list (car atoms))))

(defruled array-parts-ok-first
  (implies (and (atom-listp atoms)
                (consp atoms)
                (ll-context-ok-p (expr-array nil atoms) ctx genv))
           (ll-context-ok-p (%xa1) ctx genv))
  :use (ll-atom-list-of-cons-parts
        ll-context-new-expr-of-array
        (:instance ll-context-new-expr-of-array (d nil))
        (:instance ll-expr-of-singleton-array (a (car atoms)))
        (:instance ll-defs-bound-p-when-ll-context-ok-p
                   (x (expr-array nil atoms)))
        (:instance no-duplicate-binders-when-ll-context-ok-p
                   (x (expr-array nil atoms)))
        (:instance free-and-binders-of-array-split (as atoms) (d nil))
        (:instance free-and-binders-of-singleton-array (a (car atoms)) (d nil))
        (:instance ll-context-ok-p-of-part
                   (x (expr-array nil atoms)) (y (%xa1)) (ctx2 ctx)))
  :disable (no-duplicatesp-equal member-equal
            no-duplicatesp-equal-when-not-duplicated-names
            ll-expr ll-atom ll-atom-list ll-context-ok-p ll-context-new-expr
            ll-context-lifted ll-context-new-atoms equal-of-expr-array)
  :enable (ll-atom-list-of-cons-parts ll-context-new-expr-of-array
           ll-expr-of-singleton-array free-and-binders-of-array-split
           free-and-binders-of-singleton-array)
  :restrict ((ll-atom-list-of-cons-parts ((atoms atoms) (ctx ctx)))
             (free-and-binders-of-array-split ((as atoms) (d 'nil)))))

(defruled array-parts-ok-rest
  (implies (and (atom-listp atoms)
                (consp atoms)
                (consp (cdr atoms))
                (ll-context-ok-p (expr-array nil atoms) ctx genv))
           (ll-context-ok-p (expr-array nil (cdr atoms)) (%actx1) genv))
  :use (ll-atom-list-of-cons-parts
        ll-context-new-expr-of-array
        used-of-ll-context-atom-step
        (:instance ll-context-new-expr-of-array
                   (atoms (cdr atoms)) (ctx (%actx1)) (d nil))
        (:instance ll-context-new-expr-of-array (d nil))
        (:instance ll-defs-bound-p-when-ll-context-ok-p
                   (x (expr-array nil atoms)))
        (:instance no-duplicate-binders-when-ll-context-ok-p
                   (x (expr-array nil atoms)))
        (:instance free-and-binders-of-array-split (as atoms) (d nil))
        (:instance ll-context-ok-p-of-part
                   (x (expr-array nil atoms)) (y (expr-array nil (cdr atoms)))
                   (ctx2 (%actx1))))
  :disable (no-duplicatesp-equal member-equal
            no-duplicatesp-equal-when-not-duplicated-names
            ll-expr ll-atom ll-atom-list ll-context-ok-p ll-context-new-expr
            ll-context-lifted ll-context-new-atoms equal-of-expr-array)
  :enable (ll-atom-list-of-cons-parts ll-context-new-expr-of-array
           free-and-binders-of-array-split)
  :restrict ((ll-atom-list-of-cons-parts ((atoms atoms) (ctx ctx)))
             (free-and-binders-of-array-split
              ((as atoms) (d 'nil))
              ((as (ll-context-new-atoms atoms ctx)) (d 'nil))
              ((as (cons (ll-context-new-atom (car atoms) ctx)
                         (ll-context-new-atoms (cdr atoms) (%actx1))))
               (d 'nil)))))

(defruled array-parts-ok
  (implies (and (atom-listp atoms)
                (consp atoms)
                (ll-context-ok-p (expr-array nil atoms) ctx genv))
           (and (ll-context-ok-p (%xa1) ctx genv)
                (implies (consp (cdr atoms))
                         (ll-context-ok-p (expr-array nil (cdr atoms))
                                          (%actx1) genv))))
  :use (array-parts-ok-first array-parts-ok-rest)
  :in-theory nil)

(defruled array-parts-related-first
  (implies (and (atom-listp atoms)
                (consp atoms)
                (expr-denv-ll-related-p new-denv denv (expr-array nil atoms) ctx
                                        nil dw genv))
           (expr-denv-ll-related-p new-denv denv (%xa1) ctx nil dw genv))
  :use (ll-atom-list-of-cons-parts
        (:instance ll-context-new-expr-of-array (d nil))
        (:instance ll-expr-of-singleton-array (a (car atoms)))
        (:instance free-and-binders-of-array-split (as atoms) (d nil))
        (:instance free-and-binders-of-array-split
                   (as (ll-context-new-atoms atoms ctx)) (d nil))
        (:instance free-and-binders-of-singleton-array (a (car atoms)) (d nil))
        (:instance free-and-binders-of-singleton-array
                   (a (ll-context-new-atom (car atoms) ctx)) (d nil))
        (:instance expr-denv-ll-related-p-of-sub
                   (x (expr-array nil atoms)) (y (%xa1))
                   (ctx2 ctx) (excl nil) (excl2 nil)))
  :disable (ll-expr ll-atom ll-atom-list expr-denv-ll-related-p
            ll-context-new-expr ll-context-lifted ll-context-new-atoms
            equal-of-expr-array)
  :enable (consp-of-ll-context-new-atoms-local
           ll-atom-list-of-cons-parts ll-context-new-expr-of-array
           ll-expr-of-singleton-array free-and-binders-of-array-split
           free-and-binders-of-singleton-array)
  :restrict ((ll-atom-list-of-cons-parts ((atoms atoms) (ctx ctx)))
             (free-and-binders-of-array-split
              ((as atoms) (d 'nil))
              ((as (ll-context-new-atoms atoms ctx)) (d 'nil))
              ((as (cons (ll-context-new-atom (car atoms) ctx)
                         (ll-context-new-atoms (cdr atoms) (%actx1))))
               (d 'nil)))))

(defruled array-parts-related-rest
  (implies (and (atom-listp atoms)
                (consp atoms)
                (consp (cdr atoms))
                (expr-denv-ll-related-p new-denv denv (expr-array nil atoms) ctx
                                        nil dw genv))
           (expr-denv-ll-related-p new-denv denv (expr-array nil (cdr atoms))
                                   (%actx1) nil dw genv))
  :use (ll-atom-list-of-cons-parts
        (:instance ll-context-new-expr-of-array (d nil))
        (:instance ll-context-new-expr-of-array
                   (atoms (cdr atoms)) (ctx (%actx1)) (d nil))
        (:instance free-and-binders-of-array-split (as atoms) (d nil))
        (:instance free-and-binders-of-array-split
                   (as (ll-context-new-atoms atoms ctx)) (d nil))
        (:instance expr-denv-ll-related-p-of-sub
                   (x (expr-array nil atoms)) (y (expr-array nil (cdr atoms)))
                   (ctx2 (%actx1)) (excl nil) (excl2 nil)))
  :enable (ll-atom-list-of-cons-parts ll-context-new-expr-of-array
           free-and-binders-of-array-split
           consp-of-ll-context-new-atoms-local)
  :disable (ll-expr ll-atom ll-atom-list expr-denv-ll-related-p
            ll-context-new-expr ll-context-lifted ll-context-new-atoms
            equal-of-expr-array)
  :restrict ((ll-atom-list-of-cons-parts ((atoms atoms) (ctx ctx)))
             (free-and-binders-of-array-split
              ((as atoms) (d 'nil))
              ((as (ll-context-new-atoms atoms ctx)) (d 'nil))
              ((as (cons (ll-context-new-atom (car atoms) ctx)
                         (ll-context-new-atoms (cdr atoms) (%actx1))))
               (d 'nil)))))

(defruled array-parts-related
  (implies (and (atom-listp atoms)
                (consp atoms)
                (expr-denv-ll-related-p new-denv denv (expr-array nil atoms) ctx
                                        nil dw genv))
           (and (expr-denv-ll-related-p new-denv denv (%xa1) ctx nil dw genv)
                (implies (consp (cdr atoms))
                         (expr-denv-ll-related-p new-denv denv
                                                 (expr-array nil (cdr atoms))
                                                 (%actx1) nil dw genv))))
  :use (array-parts-related-first array-parts-related-rest)
  :in-theory nil)

(defruled eval-atom-list-ll-reaches-p-elim
  (implies (eval-atom-list-ll-reaches-p new-atoms new-denv vals genv)
           (b* (((mv l ws)
                 (eval-atom-list-ll-reaches-p-witness new-atoms new-denv vals
                                                      genv))
                (nvs (eval-atom-list new-atoms new-denv l)))
             (and (not (reserrp nvs))
                  (expr-value-list-ll-related-p nvs vals ws genv))))
  :enable eval-atom-list-ll-reaches-p)

(defruled posp-limit-when-eval-atom-list-ok
  (implies (not (reserrp (eval-atom-list atoms denv limit)))
           (posp limit))
  :expand ((eval-atom-list atoms denv limit)))

(defruled eval-atom-list-ll-reaches-p-of-nil
  (eval-atom-list-ll-reaches-p nil new-denv nil genv)
  :use ((:instance eval-atom-list-ll-reaches-p-suff
                   (new-atoms nil) (limit2 1) (w nil) (val nil)))
  :expand ((eval-atom-list nil new-denv 1)
           (expr-value-list-ll-related-p nil nil nil genv)))

(defrule consp-of-eval-atom-local
  (consp (eval-atom a d l))
  :use ((:instance expr-valuep-when-result-not-error (x (eval-atom a d l)))
        (:instance consp-when-expr-valuep (x (eval-atom a d l))))
  :in-theory (disable eval-atom))

(defruled eval-atom-at-larger-limit
  (implies (and (not (reserrp (eval-atom atom denv limit)))
                (integerp limit2)
                (<= limit limit2))
           (equal (eval-atom atom denv limit2)
                  (eval-atom atom denv limit)))
  :use (posp-limit-when-eval-atom-ok
        (:instance eval-atom-of-larger-limit (k (- limit2 limit)))))

(defruled eval-atom-list-of-cons-at-sum-limit
  (implies (and (not (reserrp (eval-atom na nd l1)))
                (not (reserrp (eval-atom-list nas nd l2))))
           (and (equal (eval-atom-list (cons na nas) nd (+ 1 l1 l2))
                       (cons (eval-atom na nd l1) (eval-atom-list nas nd l2)))
                (not (reserrp (eval-atom-list (cons na nas) nd
                                              (+ 1 l1 l2))))))
  :use ((:instance posp-limit-when-eval-atom-ok (atom na) (denv nd) (limit l1))
        (:instance posp-limit-when-eval-atom-list-ok
                   (atoms nas) (denv nd) (limit l2))
        (:instance eval-atom-at-larger-limit
                   (atom na) (denv nd) (limit l1) (limit2 (+ l1 l2)))
        (:instance eval-atom-list-of-larger-limit
                   (atoms nas) (denv nd) (limit l2) (k l1))
        (:instance not-reserrp-of-cons-when-consp-local
                   (a (eval-atom na nd l1)) (b (eval-atom-list nas nd l2))))
  :expand ((eval-atom-list (cons na nas) nd (+ 1 l1 l2))))

(defruled eval-atom-list-when-cons
  (implies (and (consp atoms)
                (not (reserrp (eval-atom-list atoms denv limit))))
           (and (equal (eval-atom-list atoms denv limit)
                       (cons (eval-atom (car atoms) denv (1- limit))
                             (eval-atom-list (cdr atoms) denv (1- limit))))
                (not (reserrp (eval-atom (car atoms) denv (1- limit))))
                (not (reserrp (eval-atom-list (cdr atoms) denv (1- limit))))))
  :expand ((eval-atom-list atoms denv limit)))

(defmacro %nas () '(ll-context-new-atoms (cdr atoms) (%actx1)))

(defruled eval-atom-list-rest-reaches
  (implies (and (atom-listp atoms)
                (consp atoms)
                (not (reserrp (eval-atom-list atoms denv limit)))
                (expr-denv-ll-related-p new-denv denv (expr-array nil atoms) ctx
                                        nil dw genv)
                (ll-context-ok-p (expr-array nil atoms) ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-atom-list-ll-ok (cdr atoms) denv (1- limit)))
           (eval-atom-list-ll-reaches-p
            (%nas) new-denv (eval-atom-list (cdr atoms) denv (1- limit)) genv))
  :cases ((consp (cdr atoms)))
  :use (array-parts-ok
        array-parts-related
        eval-atom-list-when-cons
        (:instance eval-atom-list-ll-ok-necc
                   (atoms (cdr atoms)) (limit (1- limit)) (ctx (%actx1)))
        (:instance eval-atom-list-ll-reaches-p-of-nil))
  :expand ((eval-atom-list nil denv (1- limit)))
  :in-theory (disable ll-atom ll-atom-list ll-context-ok-p
                      expr-denv-ll-related-p eval-atom eval-atom-list
                      ll-context-new-atoms eval-atom-list-ll-reaches-p
                      eval-atom-list-ll-ok eval-atom-list-ll-ok-necc))

(defruled eval-atom-list-ll-reaches-p-of-cons-values
  (implies (and (eval-atom-ll-reaches-p na nd v genv)
                (eval-atom-list-ll-reaches-p nas nd vs genv))
           (eval-atom-list-ll-reaches-p (cons na nas) nd (cons v vs) genv))
  :use ((:instance eval-atom-ll-reaches-p-elim (new-atom na) (new-denv nd)
                   (val v))
        (:instance eval-atom-list-ll-reaches-p-elim (new-atoms nas)
                   (new-denv nd) (vals vs))
        (:instance eval-atom-list-of-cons-at-sum-limit
                   (l1 (mv-nth 0 (eval-atom-ll-reaches-p-witness na nd v genv)))
                   (l2 (mv-nth 0 (eval-atom-list-ll-reaches-p-witness
                                  nas nd vs genv))))
        (:instance eval-atom-list-ll-reaches-p-suff
                   (new-atoms (cons na nas)) (new-denv nd)
                   (limit2 (+ 1 (mv-nth 0 (eval-atom-ll-reaches-p-witness
                                           na nd v genv))
                              (mv-nth 0 (eval-atom-list-ll-reaches-p-witness
                                         nas nd vs genv))))
                   (w (cons (mv-nth 1 (eval-atom-ll-reaches-p-witness
                                       na nd v genv))
                            (mv-nth 1 (eval-atom-list-ll-reaches-p-witness
                                       nas nd vs genv))))
                   (val (cons v vs))))
  :expand ((:free (a b c d e f)
                  (expr-value-list-ll-related-p (cons a b) (cons c d) e f)))
  :in-theory (disable eval-atom eval-atom-list eval-atom-list-ll-reaches-p
                      eval-atom-ll-reaches-p eval-atom-list-ll-reaches-p-suff
                      expr-value-ll-related-p))

(defruled eval-atom-list-ll-reaches-p-of-cons
  (implies (and (atom-listp atoms)
                (consp atoms)
                (not (reserrp (eval-atom-list atoms denv limit)))
                (expr-denv-ll-related-p new-denv denv (expr-array nil atoms) ctx
                                        nil dw genv)
                (ll-context-ok-p (expr-array nil atoms) ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-atom-ll-ok (car atoms) denv (1- limit))
                (eval-atom-list-ll-ok (cdr atoms) denv (1- limit)))
           (eval-atom-list-ll-reaches-p (ll-context-new-atoms atoms ctx)
                                        new-denv
                                        (eval-atom-list atoms denv limit)
                                        genv))
  :use (array-parts-ok
        array-parts-related
        eval-atom-list-rest-reaches
        (:instance eval-atom-list-when-cons)
        (:instance eval-atom-ll-ok-necc
                   (atom (car atoms)) (limit (1- limit)))
        (:instance eval-atom-list-ll-reaches-p-of-cons-values
                   (na (ll-context-new-atom (car atoms) ctx)) (nas (%nas))
                   (nd new-denv)
                   (v (eval-atom (car atoms) denv (1- limit)))
                   (vs (eval-atom-list (cdr atoms) denv (1- limit)))))
  :enable (eval-atom-list-when-cons ll-atom-list-of-cons-parts)
  :in-theory (disable ll-atom ll-atom-list ll-context-ok-p
                      expr-denv-ll-related-p eval-atom eval-atom-list
                      ll-context-new-atoms ll-context-new-atom
                      eval-atom-list-ll-reaches-p eval-atom-ll-reaches-p
                      eval-atom-list-ll-ok eval-atom-list-ll-ok-necc
                      eval-atom-ll-ok eval-atom-ll-ok-necc))

(defruled eval-atom-list-ll-ok-when-ok
  (implies (and (atom-listp atoms)
                (implies (consp atoms)
                         (and (eval-atom-ll-ok (car atoms) denv (1- limit))
                              (eval-atom-list-ll-ok (cdr atoms) denv
                                                    (1- limit)))))
           (eval-atom-list-ll-ok atoms denv limit))
  :expand ((:free (atoms) (eval-atom-list-ll-ok atoms denv limit))
           (eval-atom-list nil denv limit))
  :use ((:instance eval-atom-list-ll-reaches-p-of-cons
                   (ctx
                    (mv-nth 0 (eval-atom-list-ll-ok-witness atoms denv limit)))
                   (new-denv (mv-nth 1 (eval-atom-list-ll-ok-witness
                                        atoms denv limit)))
                   (dw
                    (mv-nth 2 (eval-atom-list-ll-ok-witness atoms denv limit)))
                   (genv (mv-nth 3 (eval-atom-list-ll-ok-witness
                                    atoms denv limit))))
        (:instance eval-atom-list-ll-reaches-p-of-nil
                   (new-denv (mv-nth 1 (eval-atom-list-ll-ok-witness
                                        atoms denv limit)))
                   (genv (mv-nth 3 (eval-atom-list-ll-ok-witness
                                    atoms denv limit)))))
  :in-theory (disable eval-atom-list-ll-reaches-p eval-atom-list
                      expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-atoms eval-atom-ll-ok eval-atom-list-ll-ok))


; Related values have the same dimensions, when both are well formed.

(defun cdr-cdr-cdr-ind (a b c)
  (if (or (endp a) (endp b)) (list a b c)
    (cdr-cdr-cdr-ind (cdr a) (cdr b) (cdr c))))

(defruled len-when-expr-value-list-ll-related-p
  (implies (expr-value-list-ll-related-p new-vals vals ws genv)
           (equal (len new-vals) (len vals)))
  :induct (cdr-cdr-cdr-ind new-vals vals ws)
  :enable (expr-value-list-ll-related-p len))

(defret-mutual check-dims-when-ll-related
  (defret check-dims-of-expr-value-when-ll-related
    (implies (and yes/no
                  (not (reserrp (check-dims-of-expr-value new-val)))
                  (not (reserrp (check-dims-of-expr-value val))))
             (equal (check-dims-of-expr-value new-val)
                    (check-dims-of-expr-value val)))
    :fn expr-value-ll-related-p)
  (defret check-dims-of-expr-value-list-when-ll-related
    (implies (and yes/no
                  (not (reserrp (check-dims-of-expr-value-list new-vals)))
                  (not (reserrp (check-dims-of-expr-value-list vals))))
             (equal (check-dims-of-expr-value-list new-vals)
                    (check-dims-of-expr-value-list vals)))
    :fn expr-value-list-ll-related-p)
  :mutual-recursion expr-value-ll-related-p
  :skip-others t
  :hints (("Goal"
           :expand ((expr-value-ll-related-p new-val val w genv)
                    (expr-value-list-ll-related-p new-vals vals ws genv)
                    (check-dims-of-expr-value new-val)
                    (check-dims-of-expr-value val)
                    (check-dims-of-expr-value-list new-vals)
                    (check-dims-of-expr-value-list vals))
           :in-theory (enable len-when-expr-value-list-ll-related-p))))

(defruled dims-of-expr-value-when-ll-related
  (implies (and (expr-value-ll-related-p new-val val w genv)
                (expr-value-wfp new-val)
                (expr-value-wfp val))
           (equal (dims-of-expr-value new-val) (dims-of-expr-value val)))
  :use check-dims-of-expr-value-when-ll-related
  :enable (dims-of-expr-value expr-value-wfp))

(defruled dims-of-expr-value-list-when-ll-related
  (implies (and (expr-value-list-ll-related-p new-vals vals ws genv)
                (expr-value-list-wfp new-vals)
                (expr-value-list-wfp vals))
           (equal (dims-of-expr-value-list new-vals)
                  (dims-of-expr-value-list vals)))
  :induct (cdr-cdr-cdr-ind new-vals vals ws)
  :enable (expr-value-list-ll-related-p expr-value-list-wfp
           dims-of-expr-value-list)
  :hints (("Subgoal *1/2"
           :use ((:instance dims-of-expr-value-when-ll-related
                            (new-val (car new-vals)) (val (car vals))
                            (w (car ws)))))))

; Brackets: the vector of the values of the expressions.

(defruled expr-bracket-of-exprs-when-bracket
  (implies (and (exprp x) (equal (expr-kind x) :bracket))
           (and (equal (expr-bracket (expr-bracket->exprs x)) x)
                (consp (expr-bracket->exprs x)))))

(defmacro %bes () '(expr-bracket->exprs x))

(defmacro %bws ()
  '(eval-expr-list-ll-reaches-p-witness
    (ll-context-new-exprs (%bes) ctx) new-denv
    (eval-expr-list (%bes) denv (1- limit)) genv))

(defmacro %bnvs ()
  '(eval-expr-list (ll-context-new-exprs (%bes) ctx) new-denv
                   (mv-nth 0 (%bws))))

(defruled eval-expr-when-bracket-ok-local
  (implies (and (equal (expr-kind x) :bracket)
                (not (reserrp (eval-expr x denv limit))))
           (and (not (zp limit))
                (not (reserrp (eval-expr-list (%bes) denv (1- limit))))
                (consp (eval-expr-list (%bes) denv (1- limit)))
                (list-repeatp (dims-of-expr-value-list
                               (eval-expr-list (%bes) denv (1- limit))))
                (equal (eval-expr x denv limit)
                       (expr-value-vector
                        (eval-expr-list (%bes) denv (1- limit))))))
  :expand ((eval-expr x denv limit)))

(defruled eval-expr-of-bracket-at
  (implies (and (consp nvs)
                (expr-listp nes)
                (consp nes)
                (equal nvs (eval-expr-list nes nd l))
                (list-repeatp (dims-of-expr-value-list nvs))
                (not (reserrp nvs)))
           (equal (eval-expr (expr-bracket nes) nd (+ 1 l))
                  (expr-value-vector nvs)))
  :use ((:instance posp-limit-when-eval-expr-list-ok
                   (exprs nes) (denv nd) (limit l)))
  :expand ((eval-expr (expr-bracket nes) nd (+ 1 l))))

(defruled consp-when-len-equal-local
  (implies (equal (len x) (len y))
           (equal (consp x) (consp y)))
  :expand ((len x) (len y)))

(defrule expr-value-list-ll-related-p-of-list-fixes-local
  (equal (expr-value-list-ll-related-p (expr-value-list-fix a)
                                       (expr-value-list-fix b) ws genv)
         (expr-value-list-ll-related-p a b ws genv))
  :induct (cdr-cdr-cdr-ind a b ws)
  :expand ((expr-value-list-ll-related-p (expr-value-list-fix a)
                                         (expr-value-list-fix b) ws genv)
           (expr-value-list-ll-related-p a b ws genv)))

(defrule expr-value-list-ll-related-p-of-witness-list-fix-local
  (equal (expr-value-list-ll-related-p a b (ll-value-witness-list-fix ws) genv)
         (expr-value-list-ll-related-p a b ws genv))
  :induct (cdr-cdr-cdr-ind a b ws)
  :expand ((expr-value-list-ll-related-p a b (ll-value-witness-list-fix ws)
                                         genv)
           (expr-value-list-ll-related-p a b ws genv)))

(defruled expr-value-ll-related-p-of-vectors
  (implies (and (equal nv (expr-value-vector nvs))
                (equal v (expr-value-vector vs))
                (expr-value-list-ll-related-p nvs vs ws genv))
           (expr-value-ll-related-p nv v (ll-value-witness-vector ws) genv))
  :expand ((:free (nvs vs) (expr-value-ll-related-p
                            (expr-value-vector nvs)
                            (expr-value-vector vs)
                            (ll-value-witness-vector ws)
                            genv)))
  :in-theory (disable equal-of-expr-value-vector))

(defruled eval-expr-ll-reaches-p-when-bracket
  (implies (and (exprp x)
                (equal (expr-kind x) :bracket)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-list-ll-ok (%bes) denv (1- limit)))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (expr-bracket-of-exprs-when-bracket
        eval-expr-when-bracket-ok-local
        (:instance ll-context-new-expr-of-bracket (exprs (%bes)))
        (:instance eval-expr-list-ll-ok-necc
                   (exprs (%bes)) (limit (1- limit)))
        (:instance eval-expr-list-ll-reaches-p-elim
                   (new-exprs (ll-context-new-exprs (%bes) ctx))
                   (vals (eval-expr-list (%bes) denv (1- limit))))
        (:instance len-when-expr-value-list-ll-related-p
                   (new-vals (%bnvs))
                   (vals (eval-expr-list (%bes) denv (1- limit)))
                   (ws (mv-nth 1 (%bws))))
        (:instance dims-of-expr-value-list-when-ll-related
                   (new-vals (%bnvs))
                   (vals (eval-expr-list (%bes) denv (1- limit)))
                   (ws (mv-nth 1 (%bws))))
        (:instance expr-value-list-wfp-of-eval-expr-list
                   (exprs (ll-context-new-exprs (%bes) ctx)) (denv new-denv)
                   (limit (mv-nth 0 (%bws))))
        (:instance expr-value-list-wfp-of-eval-expr-list
                   (exprs (%bes)) (limit (1- limit)))
        (:instance consp-when-len-equal-local
                   (x (%bnvs)) (y (eval-expr-list (%bes) denv (1- limit))))
        (:instance eval-expr-of-bracket-at
                   (nes (ll-context-new-exprs (%bes) ctx)) (nd new-denv)
                   (nvs (%bnvs)) (l (mv-nth 0 (%bws))))
        (:instance expr-value-ll-related-p-of-vectors
                   (nv (eval-expr (ll-context-new-expr x ctx) new-denv
                                  (+ 1 (mv-nth 0 (%bws)))))
                   (v (eval-expr x denv limit))
                   (nvs (%bnvs))
                   (vs (eval-expr-list (%bes) denv (1- limit)))
                   (ws (mv-nth 1 (%bws))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (ll-context-new-expr x ctx))
                   (limit2 (+ 1 (mv-nth 0 (%bws))))
                   (w (ll-value-witness-vector (mv-nth 1 (%bws))))
                   (val (eval-expr x denv limit))))
  :expand ((:free (nv v ws)
                  (expr-value-ll-related-p (expr-value-vector nv)
                                           (expr-value-vector v)
                                           (ll-value-witness-vector ws)
                                           genv)))
  :in-theory (disable ll-expr ll-expr-list eval-expr eval-expr-list
                      expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-new-exprs
                      eval-expr-list-ll-ok eval-expr-list-ll-ok-necc
                      eval-expr-list-ll-reaches-p eval-expr-ll-reaches-p
                      eval-expr-ll-reaches-p-suff equal-of-expr-bracket
                      equal-of-expr-value-vector)
  :enable (not-reserrp-when-expr-valuep))

; Arrays and frames: related lists of element values make related values
; of nonempty dimensions, via a witness built the same way.

(defrule expr-value-ll-related-p-of-nils-local
  (expr-value-ll-related-p nil nil nil genv)
  :expand ((expr-value-ll-related-p nil nil nil genv)))

(defun take-ind3 (n a b c)
  (if (zp n) (list a b c)
    (take-ind3 (1- n) (cdr a) (cdr b) (cdr c))))

(defrule expr-value-list-ll-related-p-of-nils-local
  (expr-value-list-ll-related-p nil nil ws genv)
  :expand ((expr-value-list-ll-related-p nil nil ws genv)))

(defrule expr-value-list-ll-related-p-of-repeat-nil-local
  (expr-value-list-ll-related-p (repeat n nil) (repeat n nil) (repeat n nil)
                                genv)
  :induct (repeat n nil)
  :enable (repeat)
  :expand ((:free (b c) (expr-value-list-ll-related-p (cons nil b) (cons nil c)
                                                     (cons nil c) genv))))

(defruled expr-value-list-ll-related-p-of-take
  (implies (and (expr-value-list-ll-related-p nvals vals ws genv)
                (equal (len ws) (len vals)))
           (expr-value-list-ll-related-p (take n nvals) (take n vals)
                                         (take n ws) genv))
  :induct (take-ind3 n nvals vals ws)
  :expand ((expr-value-list-ll-related-p nvals vals ws genv)
           (:free (a b c d e f)
                  (expr-value-list-ll-related-p (cons a b) (cons c d)
                                                (cons e f) genv))
           (take n nvals) (take n vals) (take n ws)))

(defruled expr-value-list-ll-related-p-of-nthcdr
  (implies (and (expr-value-list-ll-related-p nvals vals ws genv)
                (equal (len ws) (len vals)))
           (expr-value-list-ll-related-p (nthcdr n nvals) (nthcdr n vals)
                                         (nthcdr n ws) genv))
  :induct (take-ind3 n nvals vals ws)
  :expand ((expr-value-list-ll-related-p nvals vals ws genv)
           (nthcdr n nvals) (nthcdr n vals) (nthcdr n ws)))

(defun ll-list-list-related-p (nvalss valss wss genv)
  (if (endp valss)
      (endp nvalss)
    (and (consp nvalss)
         (consp wss)
         (expr-value-list-ll-related-p (car nvalss) (car valss) (car wss) genv)
         (equal (len (car wss)) (len (car valss)))
         (ll-list-list-related-p (cdr nvalss) (cdr valss) (cdr wss) genv))))

(defun split-ind3 (nvals vals ws k)
  (declare (xargs :measure (len vals)
                  :hints (("Goal" :in-theory (enable nfix)))))
  (if (or (endp vals) (zp k))
      (list nvals ws)
    (split-ind3 (nthcdr k nvals) (nthcdr k vals) (nthcdr k ws) k)))

(defruled consp-when-expr-value-list-ll-related-p
  (implies (expr-value-list-ll-related-p nvals vals ws genv)
           (equal (consp nvals) (consp vals)))
  :expand ((expr-value-list-ll-related-p nvals vals ws genv)))

(defruled consp-of-ws-when-len-local
  (implies (and (equal (len ws) (len vals))
                (not (consp vals)))
           (not (consp ws)))
  :expand ((len ws) (len vals)))

(defruled ll-list-list-related-p-of-list-split
  (implies (and (expr-value-list-ll-related-p nvals vals ws genv)
                (equal (len ws) (len vals))
                (equal (len nvals) (len vals))
                (posp k))
           (ll-list-list-related-p (list-split nvals k) (list-split vals k)
                                   (list-split ws k) genv))
  :induct (split-ind3 nvals vals ws k)
  :expand ((list-split nvals k) (list-split vals k) (list-split ws k))
  :enable (expr-value-list-ll-related-p-of-take
           expr-value-list-ll-related-p-of-nthcdr
           consp-when-expr-value-list-ll-related-p
           consp-of-ws-when-len-local))

(defruled list-split-of-pos-fix-local
  (equal (list-split l (pos-fix k))
         (list-split l k))
  :expand ((list-split l (pos-fix k)) (list-split l k)))

(defun ll-nd-witness (flag dims ws)
  (declare (xargs :measure (if (equal flag 'one)
                               (acl2::nat-list-measure (list (len dims) 0 0))
                             (acl2::nat-list-measure
                              (list (len dims) 1 (len ws))))))
  (if (equal flag 'one)
      (if (endp dims)
          (car ws)
        (ll-value-witness-vector
         (ll-nd-witness 'list (cdr dims)
                        (list-split ws (/ (len ws) (nfix (car dims)))))))
    (if (endp ws)
        nil
      (cons (ll-nd-witness 'one dims (car ws))
            (ll-nd-witness 'list dims (cdr ws))))))

(defun nd-ind (flag dims nvals vals ws)
  (declare (xargs :measure (if (equal flag 'one)
                               (acl2::nat-list-measure (list (len dims) 0 0))
                             (acl2::nat-list-measure
                              (list (len dims) 1 (len vals))))))
  (if (equal flag 'one)
      (if (endp dims)
          nil
        (let ((k (/ (len vals) (nfix (car dims)))))
          (nd-ind 'list (cdr dims)
                  (list-split (expr-value-list-fix nvals) k)
                  (list-split (expr-value-list-fix vals) k)
                  (list-split ws k))))
    (if (endp vals)
        (list nvals ws)
      (list (nd-ind 'one dims (car nvals) (car vals) (car ws))
            (nd-ind 'list dims (cdr nvals) (cdr vals) (cdr ws))))))

(defruled expr-value-ll-related-p-of-vector-values
  (implies (equal (ll-value-witness-kind w) :vector)
           (equal (expr-value-ll-related-p (expr-value-vector a)
                                           (expr-value-vector b) w genv)
                  (expr-value-list-ll-related-p
                   a b (ll-value-witness-vector->elems w) genv)))
  :expand ((expr-value-ll-related-p (expr-value-vector a)
                                    (expr-value-vector b) w genv)))

(defthm expr-value-ll-related-p-of-nonempty-dims-flag
  (if (equal flag 'one)
      (implies (and (expr-value-list-ll-related-p nvals vals ws genv)
                    (equal (len ws) (len vals)))
               (expr-value-ll-related-p
                (expr-value-with-nonempty-dims dims nvals)
                (expr-value-with-nonempty-dims dims vals)
                (ll-nd-witness 'one dims ws)
                genv))
    (implies (ll-list-list-related-p nvals vals ws genv)
             (expr-value-list-ll-related-p
              (expr-value-list-with-nonempty-dims dims nvals)
              (expr-value-list-with-nonempty-dims dims vals)
              (ll-nd-witness 'list dims ws)
              genv)))
  :rule-classes nil
  :hints (("Goal"
           :induct (nd-ind flag dims nvals vals ws)
           :expand ((expr-value-with-nonempty-dims dims nvals)
                    (expr-value-with-nonempty-dims dims vals)
                    (expr-value-list-with-nonempty-dims dims nvals)
                    (expr-value-list-with-nonempty-dims dims vals)
                    (ll-nd-witness 'one dims ws)
                    (ll-nd-witness 'list dims ws)
                    (ll-list-list-related-p nvals vals ws genv)
                    (expr-value-list-ll-related-p nvals vals ws genv)
                    (:free (a b c d e f)
                           (expr-value-list-ll-related-p (cons a b) (cons c d)
                                                         (cons e f) genv))
                    (:free (a b) (expr-value-list-ll-related-p nil nil a b)))
           :in-theory (enable len-when-expr-value-list-ll-related-p
                              consp-when-expr-value-list-ll-related-p
                              consp-of-ws-when-len-local
                              expr-value-ll-related-p-of-vector-values))
          (and stable-under-simplificationp
               '(:use ((:instance ll-list-list-related-p-of-list-split
                                  (nvals (expr-value-list-fix nvals))
                                  (vals (expr-value-list-fix vals))
                                  (k (pos-fix (/ (len vals)
                                                 (nfix (car dims))))))
                       (:instance len-when-expr-value-list-ll-related-p
                                  (new-vals nvals)))
                 :in-theory (enable list-split-of-pos-fix-local
                                    len-when-expr-value-list-ll-related-p
                                    consp-when-expr-value-list-ll-related-p
                                    consp-of-ws-when-len-local
                                    expr-value-ll-related-p-of-vector-values)))))

(defruled expr-value-list-ll-related-p-of-take-witnesses
  (implies (expr-value-list-ll-related-p nvals vals ws genv)
           (expr-value-list-ll-related-p nvals vals (take (len vals) ws) genv))
  :induct (cdr-cdr-cdr-ind nvals vals ws)
  :expand ((expr-value-list-ll-related-p nvals vals ws genv)
           (:free (w) (expr-value-list-ll-related-p nvals vals w genv))
           (take (len vals) ws)
           (len vals)))

(defruled expr-value-ll-related-p-of-nonempty-dims
  (implies (expr-value-list-ll-related-p nvals vals ws genv)
           (expr-value-ll-related-p
            (expr-value-with-nonempty-dims dims nvals)
            (expr-value-with-nonempty-dims dims vals)
            (ll-nd-witness 'one dims (take (len vals) ws))
            genv))
  :use (expr-value-list-ll-related-p-of-take-witnesses
        (:instance expr-value-ll-related-p-of-nonempty-dims-flag
                   (flag 'one) (ws (take (len vals) ws)))))

; Frames: as brackets, whose values are arranged by the dimensions.

(defruled free-and-binders-of-frame
  (implies (consp es)
           (and (equal (expr-free-expr-vars (expr-frame d es))
                       (expr-free-expr-vars (expr-bracket es)))
                (equal (expr-binder-names (expr-frame d es))
                       (expr-binder-names (expr-bracket es)))))
  :expand ((expr-free-expr-vars (expr-frame d es))
           (expr-free-expr-vars (expr-bracket es))
           (expr-binder-names (expr-frame d es))
           (expr-binder-names (expr-bracket es))))

(defmacro %fes () '(expr-frame->exprs x))

(defmacro %fds () '(expr-frame->dims x))

(defruled frame-shape
  (implies (and (exprp x) (equal (expr-kind x) :frame))
           (and (equal (expr-frame (%fds) (%fes)) x)
                (consp (%fes))
                (equal (ll-context-new-expr x ctx)
                       (expr-frame (%fds) (ll-context-new-exprs (%fes) ctx)))
                (equal (ll-context-lifted x ctx)
                       (ll-context-lifted (expr-bracket (%fes)) ctx))))
  :use ((:instance ll-context-new-expr-of-bracket (exprs (%fes))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-expr x tenv tlets locals lmap used)))
  :enable (ll-context-new-expr ll-context-new-exprs ll-context-lifted))

(defruled frame-parts
  (implies (and (exprp x)
                (equal (expr-kind x) :frame)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (and (expr-denv-ll-related-p new-denv denv (expr-bracket (%fes)) ctx
                                        nil dw genv)
                (ll-context-ok-p (expr-bracket (%fes)) ctx genv)))
  :use (frame-shape
        (:instance ll-context-new-expr-of-bracket (exprs (%fes)))
        (:instance free-and-binders-of-frame (d (%fds)) (es (%fes)))
        (:instance free-and-binders-of-frame
                   (d (%fds)) (es (ll-context-new-exprs (%fes) ctx)))
        (:instance consp-of-ll-context-new-exprs-local (exprs (%fes)))
        (:instance expr-denv-ll-related-p-of-sub
                   (y (expr-bracket (%fes))) (ctx2 ctx) (excl nil) (excl2 nil))
        (:instance ll-context-ok-p-of-binder-suffix
                   (y (expr-bracket (%fes))) (pre nil)))
  :in-theory (disable ll-expr ll-expr-list expr-denv-ll-related-p
                      ll-context-ok-p ll-context-new-expr ll-context-lifted
                      ll-context-new-exprs equal-of-expr-frame
                      equal-of-expr-bracket))

(defruled eval-expr-when-frame-ok-local
  (implies (and (equal (expr-kind x) :frame)
                (not (reserrp (eval-expr x denv limit))))
           (b* ((vals (eval-expr-list (%fes) denv (1- limit))))
             (and (not (zp limit))
                  (not (member-equal 0 (%fds)))
                  (not (reserrp vals))
                  (equal (len vals) (nat-list-product (%fds)))
                  (list-repeatp (dims-of-expr-value-list vals))
                  (equal (eval-expr x denv limit)
                         (expr-value-with-nonempty-dims (%fds) vals)))))
  :expand ((eval-expr x denv limit)))

(defruled eval-expr-of-frame-at
  (implies (and (not (member-equal 0 d))
                (nat-listp d)
                (expr-listp nes)
                (consp nes)
                (equal nvs (eval-expr-list nes nd l))
                (not (reserrp nvs))
                (equal (len nvs) (nat-list-product d))
                (list-repeatp (dims-of-expr-value-list nvs)))
           (equal (eval-expr (expr-frame d nes) nd (+ 1 l))
                  (expr-value-with-nonempty-dims d nvs)))
  :use ((:instance posp-limit-when-eval-expr-list-ok
                   (exprs nes) (denv nd) (limit l)))
  :expand ((eval-expr (expr-frame d nes) nd (+ 1 l))))

(defruled expr-value-ll-related-p-of-nonempty-dims-values
  (implies (and (equal nv (expr-value-with-nonempty-dims dims nvals))
                (equal v (expr-value-with-nonempty-dims dims vals))
                (expr-value-list-ll-related-p nvals vals ws genv))
           (expr-value-ll-related-p
            nv v (ll-nd-witness 'one dims (take (len vals) ws)) genv))
  :use expr-value-ll-related-p-of-nonempty-dims)

(defmacro %fws ()
  '(eval-expr-list-ll-reaches-p-witness
    (ll-context-new-exprs (%fes) ctx) new-denv
    (eval-expr-list (%fes) denv (1- limit)) genv))

(defmacro %fnvs ()
  '(eval-expr-list (ll-context-new-exprs (%fes) ctx) new-denv
                   (mv-nth 0 (%fws))))

(defruled eval-expr-ll-reaches-p-when-frame
  (implies (and (exprp x)
                (equal (expr-kind x) :frame)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-list-ll-ok (%fes) denv (1- limit)))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (frame-shape
        frame-parts
        eval-expr-when-frame-ok-local
        (:instance eval-expr-list-ll-ok-necc
                   (exprs (%fes)) (limit (1- limit)))
        (:instance eval-expr-list-ll-reaches-p-elim
                   (new-exprs (ll-context-new-exprs (%fes) ctx))
                   (vals (eval-expr-list (%fes) denv (1- limit))))
        (:instance len-when-expr-value-list-ll-related-p
                   (new-vals (%fnvs))
                   (vals (eval-expr-list (%fes) denv (1- limit)))
                   (ws (mv-nth 1 (%fws))))
        (:instance dims-of-expr-value-list-when-ll-related
                   (new-vals (%fnvs))
                   (vals (eval-expr-list (%fes) denv (1- limit)))
                   (ws (mv-nth 1 (%fws))))
        (:instance expr-value-list-wfp-of-eval-expr-list
                   (exprs (ll-context-new-exprs (%fes) ctx)) (denv new-denv)
                   (limit (mv-nth 0 (%fws))))
        (:instance expr-value-list-wfp-of-eval-expr-list
                   (exprs (%fes)) (limit (1- limit)))
        (:instance consp-of-ll-context-new-exprs-local (exprs (%fes)))
        (:instance eval-expr-of-frame-at
                   (d (%fds)) (nes (ll-context-new-exprs (%fes) ctx))
                   (nd new-denv) (nvs (%fnvs)) (l (mv-nth 0 (%fws))))
        (:instance expr-value-ll-related-p-of-nonempty-dims-values
                   (nv (eval-expr (ll-context-new-expr x ctx) new-denv
                                  (+ 1 (mv-nth 0 (%fws)))))
                   (v (eval-expr x denv limit))
                   (dims (%fds))
                   (nvals (%fnvs))
                   (vals (eval-expr-list (%fes) denv (1- limit)))
                   (ws (mv-nth 1 (%fws))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (ll-context-new-expr x ctx))
                   (limit2 (+ 1 (mv-nth 0 (%fws))))
                   (w (ll-nd-witness 'one (%fds)
                                     (take (len (eval-expr-list (%fes) denv
                                                                (1- limit)))
                                           (mv-nth 1 (%fws)))))
                   (val (eval-expr x denv limit))))
  :in-theory (disable ll-expr ll-expr-list eval-expr eval-expr-list
                      expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-new-exprs
                      eval-expr-list-ll-ok eval-expr-list-ll-ok-necc
                      eval-expr-list-ll-reaches-p eval-expr-ll-reaches-p
                      eval-expr-ll-reaches-p-suff equal-of-expr-frame
                      expr-value-with-nonempty-dims ll-nd-witness)
  :enable (not-reserrp-when-expr-valuep))

; Arrays: as the array of the atoms without dimensions.

(defruled free-and-binders-of-array-any-dims
  (and (equal (expr-free-expr-vars (expr-array d as))
              (expr-free-expr-vars (expr-array nil as)))
       (equal (expr-binder-names (expr-array d as))
              (expr-binder-names (expr-array nil as))))
  :expand ((expr-free-expr-vars (expr-array d as))
           (expr-free-expr-vars (expr-array nil as))
           (expr-binder-names (expr-array d as))
           (expr-binder-names (expr-array nil as))))

(defmacro %aas () '(expr-array->atoms x))

(defmacro %ads () '(expr-array->dims x))

(defruled array-shape
  (implies (and (exprp x) (equal (expr-kind x) :array))
           (and (equal (expr-array (%ads) (%aas)) x)
                (consp (%aas))
                (equal (ll-context-new-expr x ctx)
                       (expr-array (%ads) (ll-context-new-atoms (%aas) ctx)))
                (equal (ll-context-lifted x ctx)
                       (ll-context-lifted (expr-array nil (%aas)) ctx))))
  :use ((:instance ll-context-new-expr-of-array (atoms (%aas)) (d nil))
        (:instance ll-context-new-expr-of-array (atoms (%aas)) (d (%ads))))
  :in-theory (disable ll-atom-list equal-of-expr-array))

(defruled array-parts
  (implies (and (exprp x)
                (equal (expr-kind x) :array)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (and (expr-denv-ll-related-p new-denv denv (expr-array nil (%aas))
                                        ctx nil dw genv)
                (ll-context-ok-p (expr-array nil (%aas)) ctx genv)))
  :use (array-shape
        (:instance ll-context-new-expr-of-array (atoms (%aas)) (d nil))
        (:instance free-and-binders-of-array-any-dims
                   (d (%ads)) (as (%aas)))
        (:instance free-and-binders-of-array-any-dims
                   (d (%ads)) (as (ll-context-new-atoms (%aas) ctx)))
        (:instance expr-denv-ll-related-p-of-sub
                   (y (expr-array nil (%aas))) (ctx2 ctx) (excl nil)
                   (excl2 nil))
        (:instance ll-context-ok-p-of-binder-suffix
                   (y (expr-array nil (%aas))) (pre nil)))
  :in-theory (disable ll-expr ll-atom-list expr-denv-ll-related-p
                      ll-context-ok-p ll-context-new-expr ll-context-lifted
                      ll-context-new-atoms equal-of-expr-array))

(defruled eval-expr-when-array-ok-local
  (implies (and (equal (expr-kind x) :array)
                (not (reserrp (eval-expr x denv limit))))
           (b* ((vals (eval-atom-list (%aas) denv (1- limit))))
             (and (not (zp limit))
                  (not (member-equal 0 (%ads)))
                  (not (reserrp vals))
                  (equal (len vals) (nat-list-product (%ads)))
                  (list-repeatp (dims-of-expr-value-list vals))
                  (equal (eval-expr x denv limit)
                         (expr-value-with-nonempty-dims (%ads) vals)))))
  :expand ((eval-expr x denv limit)))

(defruled eval-expr-of-array-at
  (implies (and (not (member-equal 0 d))
                (nat-listp d)
                (atom-listp nas)
                (consp nas)
                (equal nvs (eval-atom-list nas nd l))
                (not (reserrp nvs))
                (equal (len nvs) (nat-list-product d))
                (list-repeatp (dims-of-expr-value-list nvs)))
           (equal (eval-expr (expr-array d nas) nd (+ 1 l))
                  (expr-value-with-nonempty-dims d nvs)))
  :use ((:instance posp-limit-when-eval-atom-list-ok
                   (atoms nas) (denv nd) (limit l)))
  :expand ((eval-expr (expr-array d nas) nd (+ 1 l))))

(defmacro %aws ()
  '(eval-atom-list-ll-reaches-p-witness
    (ll-context-new-atoms (%aas) ctx) new-denv
    (eval-atom-list (%aas) denv (1- limit)) genv))

(defmacro %anvs ()
  '(eval-atom-list (ll-context-new-atoms (%aas) ctx) new-denv
                   (mv-nth 0 (%aws))))

(defruled eval-expr-ll-reaches-p-when-array
  (implies (and (exprp x)
                (equal (expr-kind x) :array)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-atom-list-ll-ok (%aas) denv (1- limit)))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (array-shape
        array-parts
        eval-expr-when-array-ok-local
        (:instance eval-atom-list-ll-ok-necc
                   (atoms (%aas)) (limit (1- limit)))
        (:instance eval-atom-list-ll-reaches-p-elim
                   (new-atoms (ll-context-new-atoms (%aas) ctx))
                   (vals (eval-atom-list (%aas) denv (1- limit))))
        (:instance len-when-expr-value-list-ll-related-p
                   (new-vals (%anvs))
                   (vals (eval-atom-list (%aas) denv (1- limit)))
                   (ws (mv-nth 1 (%aws))))
        (:instance dims-of-expr-value-list-when-ll-related
                   (new-vals (%anvs))
                   (vals (eval-atom-list (%aas) denv (1- limit)))
                   (ws (mv-nth 1 (%aws))))
        (:instance expr-value-list-wfp-of-eval-atom-list
                   (atoms (ll-context-new-atoms (%aas) ctx)) (denv new-denv)
                   (limit (mv-nth 0 (%aws))))
        (:instance expr-value-list-wfp-of-eval-atom-list
                   (atoms (%aas)) (limit (1- limit)))
        (:instance consp-of-ll-context-new-atoms-local (atoms (%aas)))
        (:instance eval-expr-of-array-at
                   (d (%ads)) (nas (ll-context-new-atoms (%aas) ctx))
                   (nd new-denv) (nvs (%anvs)) (l (mv-nth 0 (%aws))))
        (:instance expr-value-ll-related-p-of-nonempty-dims-values
                   (nv (eval-expr (ll-context-new-expr x ctx) new-denv
                                  (+ 1 (mv-nth 0 (%aws)))))
                   (v (eval-expr x denv limit))
                   (dims (%ads))
                   (nvals (%anvs))
                   (vals (eval-atom-list (%aas) denv (1- limit)))
                   (ws (mv-nth 1 (%aws))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (ll-context-new-expr x ctx))
                   (limit2 (+ 1 (mv-nth 0 (%aws))))
                   (w (ll-nd-witness 'one (%ads)
                                     (take (len (eval-atom-list (%aas) denv
                                                                (1- limit)))
                                           (mv-nth 1 (%aws)))))
                   (val (eval-expr x denv limit))))
  :in-theory (disable ll-expr ll-atom-list eval-expr eval-atom-list
                      expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-new-atoms
                      eval-atom-list-ll-ok eval-atom-list-ll-ok-necc
                      eval-atom-list-ll-reaches-p eval-expr-ll-reaches-p
                      eval-expr-ll-reaches-p-suff equal-of-expr-array
                      expr-value-with-nonempty-dims ll-nd-witness)
  :enable (not-reserrp-when-expr-valuep))


; Expressions whose values depend on the environment only through its type
; environment, and which lifting leaves alone.

(defun ll-empty-dim-witness (dims)
  (if (or (endp dims) (zp (car dims)))
      (ll-value-witness-vector nil)
    (ll-value-witness-vector
     (repeat (car dims) (ll-empty-dim-witness (cdr dims))))))

(defrule ll-value-witness-p-of-ll-empty-dim-witness
  (ll-value-witness-p (ll-empty-dim-witness dims)))

(defruled expr-value-list-ll-related-p-of-repeat
  (implies (expr-value-ll-related-p v v w genv)
           (expr-value-list-ll-related-p (repeat n v) (repeat n v)
                                         (repeat n w) genv))
  :induct (repeat n v)
  :enable (repeat)
  :expand ((:free (a b c) (expr-value-list-ll-related-p (cons v a) (cons v b)
                                                       (cons w c) genv))
           (expr-value-list-ll-related-p nil nil nil genv)))

(defruled expr-value-ll-related-p-of-vector-empty
  (implies (equal (ll-value-witness-kind w) :vector)
           (expr-value-ll-related-p (expr-value-vector-empty d e)
                                    (expr-value-vector-empty d e) w genv))
  :expand ((expr-value-ll-related-p (expr-value-vector-empty d e)
                                    (expr-value-vector-empty d e) w genv)))

(defruled expr-value-ll-related-p-of-empty-dim
  (expr-value-ll-related-p (expr-value-with-empty-dim dims elem)
                           (expr-value-with-empty-dim dims elem)
                           (ll-empty-dim-witness dims)
                           genv)
  :induct (ll-empty-dim-witness dims)
  :expand ((expr-value-with-empty-dim dims elem))
  :enable (expr-value-ll-related-p-of-vector-values
           expr-value-ll-related-p-of-vector-empty
           expr-value-list-ll-related-p-of-repeat)
  :hints (("Subgoal *1/1"
           :use ((:instance expr-value-list-ll-related-p-of-repeat
                            (n (car dims))
                            (v (expr-value-with-empty-dim (cdr dims) elem))
                            (w (ll-empty-dim-witness (cdr dims))))))))

(defruled ll-context-new-expr-when-constant-kind
  (implies (member-equal (expr-kind x) '(:array-empty :frame-empty :string))
           (equal (ll-context-new-expr x ctx) (expr-fix x)))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-expr x tenv tlets locals lmap used)))
  :enable (ll-context-new-expr))

(defun ll-constant-witness (x denv limit)
  (declare (ignore limit))
  (b* ()
    (case (expr-kind x)
      (:array-empty (ll-empty-dim-witness (expr-array-empty->dims x)))
      (:frame-empty
       (b* ((tval (eval-type (expr-frame-empty->type x)
                             (expr-denv->tenv denv))))
         (ll-empty-dim-witness
          (append (expr-frame-empty->dims x)
                  (and (type-value-case tval :array)
                       (type-value-array->dims tval))))))
      (t (ll-value-witness-ground)))))

(defruled eval-expr-of-constant-kind-same-tenv
  (implies
   (and (member-equal (expr-kind x) '(:array-empty :frame-empty :string))
                (equal (expr-denv->tenv new-denv) (expr-denv->tenv denv)))
           (equal (eval-expr x new-denv limit) (eval-expr x denv limit)))
  :expand ((eval-expr x denv limit)
           (eval-expr x new-denv limit)))

(defruled expr-value-ll-related-p-of-constant-kind
  (implies
   (and (member-equal (expr-kind x) '(:array-empty :frame-empty :string))
                (not (reserrp (eval-expr x denv limit))))
           (expr-value-ll-related-p (eval-expr x denv limit)
                                    (eval-expr x denv limit)
                                    (ll-constant-witness x denv limit)
                                    genv))
  :cases ((equal (expr-kind x) :array-empty)
          (equal (expr-kind x) :frame-empty))
  :hints (("Subgoal 3"
           :use ((:instance expr-value-list-groundp-of-expr-value-base-list
                            (vals (base-value-int-list
                                 (eval-char-lit-list (expr-string->chars x)))))
                 (:instance expr-value-ll-related-p-of-ground
                            (val (eval-expr x denv limit))))
           :expand ((eval-expr x denv limit)
                    (:free (vs) (expr-value-groundp (expr-value-vector vs))))
           :in-theory (enable expr-value-ll-related-p-of-vector-empty))
          ("Subgoal 2"
           :expand ((eval-expr x denv limit))
           :in-theory (enable expr-value-ll-related-p-of-empty-dim))
          ("Subgoal 1"
           :expand ((eval-expr x denv limit))
           :in-theory (enable expr-value-ll-related-p-of-empty-dim)))
  :disable (expr-value-with-empty-dim eval-type))

(defruled eval-expr-ll-reaches-p-when-constant
  (implies
   (and (member-equal (expr-kind x) '(:array-empty :frame-empty :string))
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (ll-context-new-expr-when-constant-kind
        expr-value-ll-related-p-of-constant-kind
        (:instance tenv-equal-when-expr-denv-ll-related-p (excl nil))
        (:instance eval-expr-of-constant-kind-same-tenv (x (expr-fix x)))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (ll-context-new-expr x ctx))
                   (limit2 limit)
                   (w (ll-constant-witness x denv limit))
                   (val (eval-expr x denv limit))))
  :in-theory (disable eval-expr eval-expr-ll-reaches-p
                      eval-expr-ll-reaches-p-suff
                      expr-denv-ll-related-p ll-context-new-expr
                      expr-value-ll-related-p ll-constant-witness))

; tapp: the function is lifted in the same context.

(defruled tapp-shape
  (implies (equal (expr-kind x) :tapp)
           (and (equal (expr-free-expr-vars x)
                       (expr-free-expr-vars (expr-tapp->fun x)))
                (equal (expr-binder-names x)
                       (expr-binder-names (expr-tapp->fun x)))
                (equal (ll-context-lifted x ctx)
                       (ll-context-lifted (expr-tapp->fun x) ctx))
                (equal (ll-context-new-expr x ctx)
                       (expr-tapp (ll-context-new-expr (expr-tapp->fun x) ctx)
                                  (expr-tapp->arg x)))
                (equal (expr-free-expr-vars
                        (expr-tapp (ll-context-new-expr (expr-tapp->fun x) ctx)
                                   (expr-tapp->arg x)))
                       (expr-free-expr-vars
                        (ll-context-new-expr (expr-tapp->fun x) ctx)))))
  :expand ((expr-free-expr-vars x)
           (expr-binder-names x)
           (:free (f a) (expr-free-expr-vars (expr-tapp f a)))
           (:free (tenv tlets locals lmap used)
                  (ll-expr x tenv tlets locals lmap used)))
  :enable (ll-context-new-expr ll-context-lifted))

(defruled tapp-parts
  (implies (and (equal (expr-kind x) :tapp)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (and (expr-denv-ll-related-p new-denv denv (expr-tapp->fun x) ctx
                                        nil dw genv)
                (ll-context-ok-p (expr-tapp->fun x) ctx genv)))
  :use (tapp-shape
        (:instance expr-denv-ll-related-p-of-sub
                   (y (expr-tapp->fun x)) (ctx2 ctx) (excl nil) (excl2 nil))
        (:instance ll-context-ok-p-of-binder-suffix
                   (y (expr-tapp->fun x)) (pre nil)))
  :in-theory (disable ll-expr expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-lifted equal-of-expr-tapp))

(defruled posp-limit-when-eval-tapp-ok
  (implies (not (reserrp (eval-tapp funval tval limit)))
           (posp limit))
  :expand ((eval-tapp funval tval limit)))

(defruled eval-tapp-at-larger-limit
  (implies (and (not (reserrp (eval-tapp funval tval limit)))
                (integerp limit2)
                (<= limit limit2))
           (equal (eval-tapp funval tval limit2)
                  (eval-tapp funval tval limit)))
  :use (posp-limit-when-eval-tapp-ok
        (:instance eval-tapp-of-larger-limit (k (- limit2 limit)))))

(defruled eval-tapp-ll-reaches-p-elim
  (implies (eval-tapp-ll-reaches-p new-funval tval val genv)
           (b* (((mv l w)
                 (eval-tapp-ll-reaches-p-witness new-funval tval val genv))
                (nv (eval-tapp new-funval tval l)))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv val w genv))))
  :enable eval-tapp-ll-reaches-p)

(defruled eval-expr-when-tapp-ok-local
  (implies (and (equal (expr-kind x) :tapp)
                (not (reserrp (eval-expr x denv limit))))
           (and (not (zp limit))
                (not (reserrp (eval-expr (expr-tapp->fun x) denv (1- limit))))
                (not
                 (reserrp
                  (eval-type (expr-tapp->arg x) (expr-denv->tenv denv))))
                (equal (eval-expr x denv limit)
                       (eval-tapp (eval-expr (expr-tapp->fun x) denv (1- limit))
                                  (eval-type (expr-tapp->arg x)
                                             (expr-denv->tenv denv)) (1-
                                                                      limit)))))
  :expand ((eval-expr x denv limit)))

(defruled eval-expr-of-tapp-at-sum-limit
  (implies (and (not (reserrp (eval-expr nf nd l1)))
                (not (reserrp (eval-type a (expr-denv->tenv nd))))
                (not
                 (reserrp
                  (eval-tapp (eval-expr nf nd l1)
                             (eval-type a (expr-denv->tenv nd)) l2))))
           (equal (eval-expr (expr-tapp nf a) nd (+ 1 l1 l2))
                  (eval-tapp (eval-expr nf nd l1)
                             (eval-type a (expr-denv->tenv nd)) l2)))
  :use ((:instance posp-limit-when-eval-expr-ok (expr nf) (denv nd) (limit l1))
        (:instance posp-limit-when-eval-tapp-ok
                   (funval (eval-expr nf nd l1)) (limit l2) (tval
                                                             (eval-type a
                                                                        (expr-denv->tenv nd))))
        (:instance eval-expr-at-larger-limit
                   (expr nf) (denv nd) (limit l1) (limit2 (+ l1 l2)))
        (:instance eval-tapp-at-larger-limit
                   (funval (eval-expr nf nd l1)) (tval
                                                  (eval-type a
                                                             (expr-denv->tenv
                                                              nd)))
                   (limit l2) (limit2 (+ l1 l2))))
  :expand ((eval-expr (expr-tapp nf a) nd (+ 1 l1 l2))))

(defmacro %tapp-f () '(expr-tapp->fun x))

(defmacro %tapp-fv () '(eval-expr (expr-tapp->fun x) denv (1- limit)))

(defmacro %tapp-nf () '(ll-context-new-expr (expr-tapp->fun x) ctx))

(defmacro %tapp-wf ()
  '(eval-expr-ll-reaches-p-witness (%tapp-nf) new-denv (%tapp-fv) genv))

(defmacro %tapp-nfv () '(eval-expr (%tapp-nf) new-denv (mv-nth 0 (%tapp-wf))))

(defmacro %tapp-wt ()
  '(eval-tapp-ll-reaches-p-witness (%tapp-nfv)
                                   (eval-type (expr-tapp->arg x)
                                              (expr-denv->tenv denv))
                                   (eval-tapp (%tapp-fv)
                                              (eval-type (expr-tapp->arg x)
                                                         (expr-denv->tenv
                                                          denv)) (1- limit))
                                   genv))

(defruled eval-expr-ll-reaches-p-when-tapp
  (implies (and (equal (expr-kind x) :tapp)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok (%tapp-f) denv (1- limit))
                (eval-tapp-ll-ok (%tapp-fv)
                                 (eval-type (expr-tapp->arg x)
                                            (expr-denv->tenv denv)) (1- limit)))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (tapp-shape
        tapp-parts
        eval-expr-when-tapp-ok-local
        (:instance tenv-equal-when-expr-denv-ll-related-p (excl nil))
        (:instance eval-expr-ll-ok-necc (expr (%tapp-f)) (limit (1- limit)))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (%tapp-nf)) (val (%tapp-fv)))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (%tapp-f)) (limit (1- limit)))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (%tapp-nf)) (denv new-denv)
                   (limit (mv-nth 0 (%tapp-wf))))
        (:instance eval-tapp-ll-ok-necc
                   (funval (%tapp-fv)) (tval
                                        (eval-type (expr-tapp->arg x)
                                                   (expr-denv->tenv
                                                    denv))) (limit (1- limit))
                   (new-funval (%tapp-nfv)) (w (mv-nth 1 (%tapp-wf)))
                   )
        (:instance eval-tapp-ll-reaches-p-elim
                   (new-funval (%tapp-nfv)) (tval
                                             (eval-type (expr-tapp->arg x)
                                                        (expr-denv->tenv denv)))
                   (val
                    (eval-tapp (%tapp-fv)
                               (eval-type (expr-tapp->arg x)
                                          (expr-denv->tenv denv)) (1- limit))))
        (:instance eval-expr-of-tapp-at-sum-limit
                   (nf (%tapp-nf)) (nd new-denv) (a (expr-tapp->arg x))
                   (l1 (mv-nth 0 (%tapp-wf))) (l2 (mv-nth 0 (%tapp-wt))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (ll-context-new-expr x ctx))
                   (limit2 (+ 1 (mv-nth 0 (%tapp-wf)) (mv-nth 0 (%tapp-wt))))
                   (w (mv-nth 1 (%tapp-wt)))
                   (val (eval-expr x denv limit))))
  :in-theory (disable ll-expr eval-expr eval-tapp expr-denv-ll-related-p
                      ll-context-ok-p ll-context-new-expr ll-context-lifted
                      eval-expr-ll-ok eval-expr-ll-ok-necc eval-tapp-ll-ok
                      eval-tapp-ll-ok-necc eval-expr-ll-reaches-p
                      eval-expr-ll-reaches-p-suff eval-tapp-ll-reaches-p
                      expr-value-ll-related-p))

; iapp: the function is lifted in the same context.

(defruled iapp-shape
  (implies (equal (expr-kind x) :iapp)
           (and (equal (expr-free-expr-vars x)
                       (expr-free-expr-vars (expr-iapp->fun x)))
                (equal (expr-binder-names x)
                       (expr-binder-names (expr-iapp->fun x)))
                (equal (ll-context-lifted x ctx)
                       (ll-context-lifted (expr-iapp->fun x) ctx))
                (equal (ll-context-new-expr x ctx)
                       (expr-iapp (ll-context-new-expr (expr-iapp->fun x) ctx)
                                  (expr-iapp->arg x)))
                (equal (expr-free-expr-vars
                        (expr-iapp (ll-context-new-expr (expr-iapp->fun x) ctx)
                                   (expr-iapp->arg x)))
                       (expr-free-expr-vars
                        (ll-context-new-expr (expr-iapp->fun x) ctx)))))
  :expand ((expr-free-expr-vars x)
           (expr-binder-names x)
           (:free (f a) (expr-free-expr-vars (expr-iapp f a)))
           (:free (tenv tlets locals lmap used)
                  (ll-expr x tenv tlets locals lmap used)))
  :enable (ll-context-new-expr ll-context-lifted))

(defruled iapp-parts
  (implies (and (equal (expr-kind x) :iapp)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (and (expr-denv-ll-related-p new-denv denv (expr-iapp->fun x) ctx
                                        nil dw genv)
                (ll-context-ok-p (expr-iapp->fun x) ctx genv)))
  :use (iapp-shape
        (:instance expr-denv-ll-related-p-of-sub
                   (y (expr-iapp->fun x)) (ctx2 ctx) (excl nil) (excl2 nil))
        (:instance ll-context-ok-p-of-binder-suffix
                   (y (expr-iapp->fun x)) (pre nil)))
  :in-theory (disable ll-expr expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-lifted equal-of-expr-iapp))

(defruled posp-limit-when-eval-iapp-ok
  (implies (not (reserrp (eval-iapp funval ival limit)))
           (posp limit))
  :expand ((eval-iapp funval ival limit)))

(defruled eval-iapp-at-larger-limit
  (implies (and (not (reserrp (eval-iapp funval ival limit)))
                (integerp limit2)
                (<= limit limit2))
           (equal (eval-iapp funval ival limit2)
                  (eval-iapp funval ival limit)))
  :use (posp-limit-when-eval-iapp-ok
        (:instance eval-iapp-of-larger-limit (k (- limit2 limit)))))

(defruled eval-iapp-ll-reaches-p-elim
  (implies (eval-iapp-ll-reaches-p new-funval ival val genv)
           (b* (((mv l w)
                 (eval-iapp-ll-reaches-p-witness new-funval ival val genv))
                (nv (eval-iapp new-funval ival l)))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv val w genv))))
  :enable eval-iapp-ll-reaches-p)

(defruled eval-expr-when-iapp-ok-local
  (implies (and (equal (expr-kind x) :iapp)
                (not (reserrp (eval-expr x denv limit))))
           (and (not (zp limit))
                (not (reserrp (eval-expr (expr-iapp->fun x) denv (1- limit))))
                (not
                 (reserrp
                  (eval-ispace (expr-iapp->arg x)
                               (type-denv->ienv (expr-denv->tenv denv)))))
                (equal (eval-expr x denv limit)
                       (eval-iapp (eval-expr (expr-iapp->fun x) denv (1- limit))
                                  (eval-ispace (expr-iapp->arg x)
                                               (type-denv->ienv
                                                (expr-denv->tenv denv))) (1-
                                                                          limit)))))
  :expand ((eval-expr x denv limit)))

(defruled eval-expr-of-iapp-at-sum-limit
  (implies (and (not (reserrp (eval-expr nf nd l1)))
                (not
                 (reserrp
                  (eval-ispace a (type-denv->ienv (expr-denv->tenv nd)))))
                (not
                 (reserrp
                  (eval-iapp (eval-expr nf nd l1)
                             (eval-ispace a
                                          (type-denv->ienv
                                           (expr-denv->tenv nd))) l2))))
           (equal (eval-expr (expr-iapp nf a) nd (+ 1 l1 l2))
                  (eval-iapp (eval-expr nf nd l1)
                             (eval-ispace a
                                          (type-denv->ienv
                                           (expr-denv->tenv nd))) l2)))
  :use ((:instance posp-limit-when-eval-expr-ok (expr nf) (denv nd) (limit l1))
        (:instance posp-limit-when-eval-iapp-ok
                   (funval (eval-expr nf nd l1)) (limit l2) (ival
                                                             (eval-ispace a
                                                                          (type-denv->ienv (expr-denv->tenv nd)))))
        (:instance eval-expr-at-larger-limit
                   (expr nf) (denv nd) (limit l1) (limit2 (+ l1 l2)))
        (:instance eval-iapp-at-larger-limit
                   (funval (eval-expr nf nd l1)) (ival
                                                  (eval-ispace a
                                                               (type-denv->ienv
                                                                (expr-denv->tenv
                                                                 nd))))
                   (limit l2) (limit2 (+ l1 l2))))
  :expand ((eval-expr (expr-iapp nf a) nd (+ 1 l1 l2))))

(defmacro %iapp-f () '(expr-iapp->fun x))

(defmacro %iapp-fv () '(eval-expr (expr-iapp->fun x) denv (1- limit)))

(defmacro %iapp-nf () '(ll-context-new-expr (expr-iapp->fun x) ctx))

(defmacro %iapp-wf ()
  '(eval-expr-ll-reaches-p-witness (%iapp-nf) new-denv (%iapp-fv) genv))

(defmacro %iapp-nfv () '(eval-expr (%iapp-nf) new-denv (mv-nth 0 (%iapp-wf))))

(defmacro %iapp-wt ()
  '(eval-iapp-ll-reaches-p-witness (%iapp-nfv)
                                   (eval-ispace (expr-iapp->arg x)
                                                (type-denv->ienv
                                                 (expr-denv->tenv denv)))
                                   (eval-iapp (%iapp-fv)
                                              (eval-ispace (expr-iapp->arg x)
                                                           (type-denv->ienv
                                                            (expr-denv->tenv
                                                             denv))) (1- limit))
                                   genv))

(defruled eval-expr-ll-reaches-p-when-iapp
  (implies (and (equal (expr-kind x) :iapp)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok (%iapp-f) denv (1- limit))
                (eval-iapp-ll-ok (%iapp-fv)
