;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The environment relation: its dependence on the sets of variables, its
; condition at one variable, and its restriction to sub-expressions.

(local
 (defun ll-map-ind (map)
   (declare (xargs :measure (acl2-count map)))
   (if (omap::emptyp map)
       nil
     (ll-map-ind (omap::tail map)))))

; The walker is monotone in the sets of variables.

(defrule string-expr-value-map-ll-related-p-when-subsets
  (implies (and (string-expr-value-map-ll-related-p
                 new-denv map fv nfv ctx dw genv)
                (string-expr-value-mapp map)
                (set::subset fv2 fv)
                (set::subset nfv2 nfv))
           (string-expr-value-map-ll-related-p
            new-denv map fv2 nfv2 ctx dw genv))
  :induct (ll-map-ind map)
  :expand ((:free (fv nfv)
                   (string-expr-value-map-ll-related-p
                    new-denv map fv nfv ctx dw genv)))
  :enable (set::subset-in set::subset-transitive))

; NAMES-BOUND-AS-IN-P is monotone.

(defrule names-bound-as-in-p-when-in
  (implies (and (names-bound-as-in-p names new-denv genv)
                (set::in name names)
                (not (reserrp (expr-denv-lookup-expr name genv))))
           (equal (expr-denv-lookup-expr name new-denv)
                  (expr-denv-lookup-expr name genv)))
  :induct (names-bound-as-in-p names new-denv genv)
  :enable names-bound-as-in-p)

(defruled names-bound-as-in-p-when-in-subset
  (implies (and (names-bound-as-in-p names new-denv genv)
                (set::subset s names)
                (set::in name s)
                (not (reserrp (expr-denv-lookup-expr name genv))))
           (equal (expr-denv-lookup-expr name new-denv)
                  (expr-denv-lookup-expr name genv)))
  :use ((:instance names-bound-as-in-p-when-in)
        (:instance set::subset-in (a name) (x s) (y names))))

(defrule names-bound-as-in-p-when-subset
  (implies (and (names-bound-as-in-p names new-denv genv)
                (set::subset names2 names))
           (names-bound-as-in-p names2 new-denv genv))
  :induct (names-bound-as-in-p names2 new-denv genv)
  :enable (names-bound-as-in-p names-bound-as-in-p-when-in-subset
           subset-of-tail-when-subset))

;; NEW-VALUES-MEET-TYPES-P is monotone too.

(defruled new-values-meet-types-p-when-in
  (implies (and (new-values-meet-types-p names new-denv tenv)
                (set::in name names))
           (and (not (reserrp (expr-denv-lookup-expr name new-denv)))
                (value-meets-required-type-p
                 (expr-denv-lookup-expr name new-denv) name tenv)))
  :induct (new-values-meet-types-p names new-denv tenv)
  :enable new-values-meet-types-p)

(defruled new-values-meet-types-p-when-in-subset
  (implies (and (new-values-meet-types-p names new-denv tenv)
                (set::subset s names)
                (set::in name s))
           (and (not (reserrp (expr-denv-lookup-expr name new-denv)))
                (value-meets-required-type-p
                 (expr-denv-lookup-expr name new-denv) name tenv)))
  :use ((:instance new-values-meet-types-p-when-in)
        (:instance set::subset-in (a name) (x s) (y names))))

(defrule new-values-meet-types-p-when-subset
  (implies (and (new-values-meet-types-p names new-denv tenv)
                (set::subset names2 names))
           (new-values-meet-types-p names2 new-denv tenv))
  :induct (new-values-meet-types-p names2 new-denv tenv)
  :enable (new-values-meet-types-p subset-of-tail-when-subset
           new-values-meet-types-p-when-in-subset))

(defruled subset-of-intersect-when-subset
  (implies (set::subset a b)
           (set::subset (set::intersect a c) (set::intersect b c)))
  :enable (set::subset-in set::pick-a-point-subset-strategy))

; Adding a variable at the value it already has changes nothing.

(defrule expr-denv-add-expr-of-lookup
  (implies (and (equal val (expr-denv-lookup-expr name denv))
                (not (reserrp val)))
           (equal (expr-denv-add-expr name val denv)
                  (expr-denv-fix denv)))
  :enable (expr-denv-add-expr expr-denv-lookup-expr))

(defrule expr-denv-with-names-from-of-expr-denv-fix
  (equal (expr-denv-with-names-from names (expr-denv-fix denv) genv)
         (expr-denv-with-names-from names denv genv))
  :induct (expr-denv-with-names-from names denv genv)
  :enable expr-denv-with-names-from)

(defrule expr-denv-with-names-from-when-names-bound
  (implies (names-bound-as-in-p names denv genv)
           (equal (expr-denv-with-names-from names denv genv)
                  (expr-denv-fix denv)))
  :induct (names-bound-as-in-p names denv genv)
  :expand ((expr-denv-with-names-from names denv genv))
  :enable (names-bound-as-in-p))

; The condition of the walker at one variable, as a function.

(define ll-var-ok-p ((var stringp)
                     (val expr-valuep)
                     (new-denv expr-denvp)
                     (nfv string-setp)
                     (ctx ll-context-p)
                     (dw ll-denv-witness-p)
                     (genv expr-denvp))
  :returns (yes/no booleanp)
  :verify-guards nil
  (b* (((ll-context c) ctx)
       ((ll-denv-witness d) dw)
       (wpair (omap::assoc var d.vals))
       (w (if wpair (cdr wpair) (ll-value-witness-ground)))
       (lpair (omap::assoc var c.lmap))
       (rvars (and lpair (expr-free-expr-vars (cdr lpair))))
       (referredp (if lpair
                      (set::subset (set::intersect rvars c.locals) nfv)
                    (set::in var nfv)))
       (new-val (if lpair
                    (eval-expr (cdr lpair)
                               (expr-denv-with-names-from
                                (set::difference rvars c.locals)
                                new-denv
                                genv)
                               d.limit)
                  (expr-denv-lookup-expr var new-denv))))
    (and (or (not referredp)
             (and (not (reserrp new-val))
                  (expr-value-ll-related-p new-val val w genv)))
         (value-meets-required-type-p val var c.tenv)
         (or (not (set::in var c.tlets))
             (value-has-inferred-type-p val var c.tenv))
         (or (set::in var c.locals)
             (equal val (expr-denv-lookup-expr var (init-expr-denv)))))))

; The walker at the first variable of the map, and at the rest.

(defruled walker-head-and-tail
  (implies (and (string-expr-value-map-ll-related-p
                 new-denv map fv nfv ctx dw genv)
                (string-expr-value-mapp map)
                (not (omap::emptyp map)))
           (and (implies (set::in (mv-nth 0 (omap::head map)) fv)
                         (ll-var-ok-p (mv-nth 0 (omap::head map))
                                      (mv-nth 1 (omap::head map))
                                      new-denv nfv ctx dw genv))
                (string-expr-value-map-ll-related-p
                 new-denv (omap::tail map) fv nfv ctx dw genv)))
  :expand ((string-expr-value-map-ll-related-p
            new-denv map fv nfv ctx dw genv))
  :enable (ll-var-ok-p))

; The condition of the walker at one variable.

(defruled walker-ll-var-ok-p-at
  (implies (and (string-expr-value-map-ll-related-p
                 new-denv map fv nfv ctx dw genv)
                (string-expr-value-mapp map)
                (omap::assoc var map)
                (set::in var fv))
           (ll-var-ok-p var (cdr (omap::assoc var map)) new-denv nfv ctx dw
                        genv))
  :induct (ll-map-ind map)
  :enable (omap::assoc walker-head-and-tail))

(defruled string-expr-value-map-ll-related-p-at-var
  (implies (and (string-expr-value-map-ll-related-p
                 new-denv map fv nfv ctx dw genv)
                (string-expr-value-mapp map)
                (omap::assoc var map)
                (set::in var fv))
           (b* ((val (cdr (omap::assoc var map)))
                ((ll-context c) ctx)
                ((ll-denv-witness d) dw)
                (wpair (omap::assoc var d.vals))
                (w (if wpair (cdr wpair) (ll-value-witness-ground)))
                (lpair (omap::assoc var c.lmap))
                (rvars (and lpair (expr-free-expr-vars (cdr lpair))))
                (referredp (if lpair
                               (set::subset (set::intersect rvars c.locals) nfv)
                             (set::in var nfv)))
                (new-val (if lpair
                             (eval-expr (cdr lpair)
                                        (expr-denv-with-names-from
                                         (set::difference rvars c.locals)
                                         new-denv
                                         genv)
                                        d.limit)
                           (expr-denv-lookup-expr var new-denv))))
             (and (or (not referredp)
                      (and (not (reserrp new-val))
                           (expr-value-ll-related-p new-val val w genv)))
                  (value-meets-required-type-p val var c.tenv)
                  (or (not (set::in var c.tlets))
                      (value-has-inferred-type-p val var c.tenv))
                  (or (set::in var c.locals)
                      (equal val (expr-denv-lookup-expr var
                                                        (init-expr-denv)))))))
  :use walker-ll-var-ok-p-at
  :enable (ll-var-ok-p))

(defruled eval-expr-ll-reaches-p-when-var
  (implies (and (equal (expr-kind x) :var)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use ((:instance string-expr-value-map-ll-related-p-at-var
                   (map (expr-denv->exprs denv))
                   (var (expr-var->name x))
                   (fv (set::difference (expr-free-expr-vars x)
                                        (set::mergesort nil)))
                   (nfv (expr-free-expr-vars (ll-context-new-expr x ctx))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (ll-context-new-expr x ctx))
                   (val (eval-expr x denv limit))
                   (limit2 (if (omap::assoc (expr-var->name x)
                                            (ll-context->lmap ctx))
                               (ll-denv-witness->limit dw)
                             1))
                   (w (if (omap::assoc (expr-var->name x)
                                       (ll-denv-witness->vals dw))
                          (cdr (omap::assoc (expr-var->name x)
                                            (ll-denv-witness->vals dw)))
                        (ll-value-witness-ground))))
        (:instance names-bound-as-in-p-when-subset
                   (names (set::difference
                           (expr-free-expr-vars (ll-context-new-expr x ctx))
                           (ll-context->locals ctx)))
                   (names2 (set::difference
                            (expr-free-expr-vars
                             (cdr (omap::assoc (expr-var->name x)
                                               (ll-context->lmap ctx))))
                            (ll-context->locals ctx)))
                   (new-denv new-denv)))
  :expand ((eval-expr x denv limit)
           (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
           (:free (lim) (eval-expr x new-denv lim))
           (expr-free-expr-vars x)
           (ll-expr x (ll-context->tenv ctx) (ll-context->tlets ctx)
                    (ll-context->locals ctx) (ll-context->lmap ctx)
                    (ll-context->used ctx)))
  :enable (ll-context-new-expr expr-denv-lookup-expr))

(defruled string-expr-value-map-ll-related-p-of-same-fields
  (implies (and (string-expr-value-mapp map)
                (equal (ll-context->tenv ctx2) (ll-context->tenv ctx))
                (equal (ll-context->tlets ctx2) (ll-context->tlets ctx))
                (equal (ll-context->locals ctx2) (ll-context->locals ctx))
                (equal (ll-context->lmap ctx2) (ll-context->lmap ctx)))
           (equal (string-expr-value-map-ll-related-p
                   new-denv map fv nfv ctx2 dw genv)
                  (string-expr-value-map-ll-related-p
                   new-denv map fv nfv ctx dw genv)))
  :induct (ll-map-ind map)
  :expand ((:free (ctx)
                  (string-expr-value-map-ll-related-p
                   new-denv map fv nfv ctx dw genv))))

; The environment relation at an expression gives it at any expression
; with fewer free variables, whose lifted form has fewer free variables, in
; a context that differs at most in the names in use.

(defruled expr-denv-ll-related-p-of-sub
  (implies (and (expr-denv-ll-related-p new-denv denv x ctx excl dw genv)
                (set::subset (set::difference
                              (expr-free-expr-vars y)
                              (set::mergesort (str::string-list-fix excl2)))
                             (set::difference
                              (expr-free-expr-vars x)
                              (set::mergesort (str::string-list-fix excl))))
                (set::subset (expr-free-expr-vars (ll-context-new-expr y ctx2))
                             (expr-free-expr-vars (ll-context-new-expr x ctx)))
                (equal (ll-context->tenv ctx2) (ll-context->tenv ctx))
                (equal (ll-context->tlets ctx2) (ll-context->tlets ctx))
                (equal (ll-context->locals ctx2) (ll-context->locals ctx))
                (equal (ll-context->lmap ctx2) (ll-context->lmap ctx))
                (set::subset (set::mergesort (str::string-list-fix excl))
                             (set::mergesort (str::string-list-fix excl2))))
           (expr-denv-ll-related-p new-denv denv y ctx2 excl2 dw genv))
  :expand ((expr-denv-ll-related-p new-denv denv x ctx excl dw genv)
           (expr-denv-ll-related-p new-denv denv y ctx2 excl2 dw genv))
  :use ((:instance string-expr-value-map-ll-related-p-of-same-fields
                   (map (expr-denv->exprs denv))
                   (fv (set::difference
                        (expr-free-expr-vars y)
                        (set::mergesort (str::string-list-fix excl2))))
                   (nfv (expr-free-expr-vars (ll-context-new-expr y ctx2))))
        (:instance string-expr-value-map-ll-related-p-when-subsets
                   (map (expr-denv->exprs denv))
                   (fv (set::difference
                        (expr-free-expr-vars x)
                        (set::mergesort (str::string-list-fix excl))))
                   (nfv (expr-free-expr-vars (ll-context-new-expr x ctx)))
                   (fv2 (set::difference
                         (expr-free-expr-vars y)
                         (set::mergesort (str::string-list-fix excl2))))
                   (nfv2 (expr-free-expr-vars (ll-context-new-expr y ctx2))))
        (:instance names-bound-as-in-p-when-subset
                   (names (set::difference
                           (expr-free-expr-vars (ll-context-new-expr x ctx))
                           (ll-context->locals ctx)))
                   (names2 (set::difference
                            (expr-free-expr-vars (ll-context-new-expr y ctx2))
                            (ll-context->locals ctx))))
        (:instance subset-of-difference-when-subset
                   (a (expr-free-expr-vars (ll-context-new-expr y ctx2)))
                   (b (expr-free-expr-vars (ll-context-new-expr x ctx)))
                   (c (ll-context->locals ctx)))
        (:instance new-values-meet-types-p-when-subset
                   (names (set::difference
                           (set::intersect
                            (expr-free-expr-vars (ll-context-new-expr x ctx))
                            (ll-context->locals ctx))
                           (set::mergesort (str::string-list-fix excl))))
                   (names2 (set::difference
                            (set::intersect
                             (expr-free-expr-vars (ll-context-new-expr y ctx2))
                             (ll-context->locals ctx))
                            (set::mergesort (str::string-list-fix excl2))))
                   (tenv (ll-context->tenv ctx)))
        (:instance subset-of-difference-of-difference
                   (a (set::intersect
                       (expr-free-expr-vars (ll-context-new-expr y ctx2))
                       (ll-context->locals ctx)))
                   (b (set::intersect
                       (expr-free-expr-vars (ll-context-new-expr x ctx))
                       (ll-context->locals ctx)))
                   (c (set::mergesort (str::string-list-fix excl)))
                   (d (set::mergesort (str::string-list-fix excl2))))
        (:instance subset-of-intersect-when-subset
                   (a (expr-free-expr-vars (ll-context-new-expr y ctx2)))
                   (b (expr-free-expr-vars (ll-context-new-expr x ctx)))
                   (c (ll-context->locals ctx)))))

(defrule ll-defs-bound-p-of-append
  (equal (ll-defs-bound-p (append defs1 defs2) genv)
         (and (ll-defs-bound-p defs1 genv)
              (ll-defs-bound-p defs2 genv)))
  :induct (len defs1)
  :enable (ll-defs-bound-p append len))

; Limits.

(defruled posp-limit-when-eval-expr-ok
  (implies (not (reserrp (eval-expr expr denv limit)))
           (posp limit))
  :expand ((eval-expr expr denv limit)))

(defruled posp-limit-when-eval-app-ok
  (implies (not (reserrp (eval-app funval argvals limit)))
           (posp limit))
  :expand ((eval-app funval argvals limit)))

(defruled eval-expr-at-larger-limit
  (implies (and (not (reserrp (eval-expr expr denv limit)))
                (integerp limit2)
                (<= limit limit2))
           (equal (eval-expr expr denv limit2)
                  (eval-expr expr denv limit)))
  :use (posp-limit-when-eval-expr-ok
        (:instance eval-expr-of-larger-limit (k (- limit2 limit)))))

(defruled eval-app-at-larger-limit
  (implies (and (not (reserrp (eval-app funval argvals limit)))
                (integerp limit2)
                (<= limit limit2))
           (equal (eval-app funval argvals limit2)
                  (eval-app funval argvals limit)))
  :use (posp-limit-when-eval-app-ok
        (:instance eval-app-of-larger-limit (k (- limit2 limit)))))

(defruled eval-expr-ll-reaches-p-elim
  (implies (eval-expr-ll-reaches-p new-expr new-denv val genv)
           (b* (((mv l w)
                 (eval-expr-ll-reaches-p-witness new-expr new-denv val genv))
                (nv (eval-expr new-expr new-denv l)))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv val w genv))))
  :enable eval-expr-ll-reaches-p)

(defruled eval-app-ll-reaches-p-elim
  (implies (eval-app-ll-reaches-p new-funval new-argvals val genv)
           (b* (((mv l w)
                 (eval-app-ll-reaches-p-witness new-funval new-argvals val
                                                genv))
                (nv (eval-app new-funval new-argvals l)))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv val w genv))))
  :enable eval-app-ll-reaches-p)

; Abbreviations for the :APP case.

(defmacro %f () '(expr-app->fun x))
(defmacro %a () '(expr-app->arg x))
(defmacro %llf () '(ll-expr (expr-app->fun x)
            (ll-context->tenv ctx) (ll-context->tlets ctx)
            (ll-context->locals ctx) (ll-context->lmap ctx)
            (ll-context->used ctx)))
(defmacro %ctx1 () '(change-ll-context ctx :used (mv-nth 2 (%llf))))
(defmacro %nf () '(ll-context-new-expr (%f) ctx))
(defmacro %na () '(ll-context-new-expr (%a) (%ctx1)))
(defmacro %fval () '(eval-expr (%f) denv (1- limit)))
(defmacro %aval () '(eval-expr (%a) denv (1- limit)))
(defmacro %wf () '(eval-expr-ll-reaches-p-witness (%nf) new-denv (%fval) genv))
(defmacro %wa () '(eval-expr-ll-reaches-p-witness (%na) new-denv (%aval) genv))

(defruled ll-context-new-expr-when-app
  (implies (equal (expr-kind x) :app)
           (equal (ll-context-new-expr x ctx)
                  (expr-app (%nf) (%na))))
  :enable (ll-context-new-expr)
  :expand ((ll-expr x (ll-context->tenv ctx) (ll-context->tlets ctx)
                    (ll-context->locals ctx) (ll-context->lmap ctx)
                    (ll-context->used ctx))))

(defruled ll-context-lifted-when-app
  (implies (equal (expr-kind x) :app)
           (equal (ll-context-lifted x ctx)
                  (append (ll-context-lifted (%f) ctx)
                          (ll-context-lifted (%a) (%ctx1)))))
  :enable (ll-context-lifted)
  :expand ((ll-expr x (ll-context->tenv ctx) (ll-context->tlets ctx)
                    (ll-context->locals ctx) (ll-context->lmap ctx)
                    (ll-context->used ctx))))

;; Facts about the new invariants of LL-CONTEXT-OK-P.

(in-theory (enable string-listp-of-append-simple))

(defruled no-duplicatesp-when-not-duplicated-names
  (implies (not (duplicated-names names))
           (no-duplicatesp-equal names))
  :induct (len names)
  :enable (duplicated-names len))

(defruled not-duplicated-names-when-no-duplicatesp
  (implies (no-duplicatesp-equal names)
           (not (duplicated-names names)))
  :induct (len names)
  :enable (duplicated-names len))

(defrule expr-duplicate-names-iff-no-duplicates
  (iff (expr-duplicate-names x)
       (not (no-duplicatesp-equal (expr-binder-names x))))
  :enable (expr-duplicate-names)
  :use ((:instance no-duplicatesp-when-not-duplicated-names
                   (names (expr-binder-names x)))
        (:instance not-duplicated-names-when-no-duplicatesp
                   (names (expr-binder-names x)))))


(defrule ll-context-ok-p-facts
  (implies (ll-context-ok-p x ctx genv)
           (b* (((ll-context c) ctx))
             (and (set::subset c.locals c.used)
                  (ll-defs-bound-p (ll-context-lifted x ctx) genv)
                  (genv-agrees-with-init-p genv)
                  (expr-denv-wfp genv)
                  (string-expr-map-closed-p c.lmap)
                  (set::subset (omap::keys c.lmap) c.locals)
                  (lmap-replacements-ok-p c.lmap c.locals (expr-binder-names x)
                                          genv)
                  (no-duplicatesp-equal (expr-binder-names x))
                  (subsetp-equal (expr-binder-names x) c.used)
                  (not (intersectp-equal (expr-binder-names x) c.locals))
                  (set::subset (omap::keys c.tenv) c.locals))))
  :rule-classes nil
  :enable (ll-context-ok-p))

; The same without the facts about the binders, which are costly to reason
; about where they are not needed.

(defrule ll-context-ok-p-facts-nb
  (implies (ll-context-ok-p x ctx genv)
           (b* (((ll-context c) ctx))
             (and (set::subset c.locals c.used)
                  (ll-defs-bound-p (ll-context-lifted x ctx) genv)
                  (genv-agrees-with-init-p genv)
                  (expr-denv-wfp genv)
                  (string-expr-map-closed-p c.lmap)
                  (set::subset (omap::keys c.lmap) c.locals)
                  (lmap-replacements-ok-p c.lmap c.locals (expr-binder-names x)
                                          genv)
                  (set::subset (omap::keys c.tenv) c.locals))))
  :rule-classes nil
  :enable (ll-context-ok-p))

(in-theory (enable no-duplicatesp-equal-of-append-parts))

(defruled ll-replacement-ok-p-when-fewer-pnames
  (implies (and (ll-replacement-ok-p repl locals pnames genv)
                (subsetp-equal (str::string-list-fix pnames2)
                               (str::string-list-fix pnames)))
           (ll-replacement-ok-p repl locals pnames2 genv))
  :enable (ll-replacement-ok-p acl2::subsetp-member
           not-intersectp-when-subsetp-right))

(defruled lmap-replacements-ok-p-when-fewer-pnames
  (implies (and (lmap-replacements-ok-p lmap locals pnames genv)
                (subsetp-equal (str::string-list-fix pnames2)
                               (str::string-list-fix pnames)))
           (lmap-replacements-ok-p lmap locals pnames2 genv))
  :induct (lmap-replacements-ok-p lmap locals pnames genv)
  :enable (lmap-replacements-ok-p ll-replacement-ok-p-when-fewer-pnames))

(in-theory (enable subsetp-equal-of-append-parts))

(defruled expr-binder-names-when-app
  (implies (equal (expr-kind x) :app)
           (equal (expr-binder-names x)
                  (append (expr-binder-names (expr-app->fun x))
                          (expr-binder-names (expr-app->arg x)))))
  :expand ((expr-binder-names x)))

(defruled ll-context-ok-p-of-app-parts
  (implies (and (equal (expr-kind x) :app)
                (ll-context-ok-p x ctx genv))
           (and (ll-context-ok-p (%f) ctx genv)
                (ll-context-ok-p (%a) (%ctx1) genv)))
  :enable (ll-context-ok-p ll-context-lifted-when-app set::subset-transitive
           expr-binder-names-when-app)
  :use ((:instance not-intersectp-when-subsetp-local
                   (bx (expr-binder-names x)) (l (ll-context->locals ctx)) (bi
                                                                            (expr-binder-names (%f))))
        (:instance not-intersectp-when-subsetp-local
                   (bx (expr-binder-names x)) (l (ll-context->locals ctx)) (bi
                                                                            (expr-binder-names (%a))))
        (:instance lmap-replacements-ok-p-when-fewer-pnames
                   (lmap (ll-context->lmap ctx))
                   (locals (ll-context->locals ctx))
                   (pnames (append (expr-binder-names (%f))
                                   (expr-binder-names (%a))))
                   (pnames2 (expr-binder-names (%f))))
        (:instance lmap-replacements-ok-p-when-fewer-pnames
                   (lmap (ll-context->lmap ctx))
                   (locals (ll-context->locals ctx))
                   (pnames (append (expr-binder-names (%f))
                                   (expr-binder-names (%a))))
                   (pnames2 (expr-binder-names (%a))))
        (:instance subsetp-equal-when-subset-of-set
                   (l (expr-binder-names (%a)))
                   (s1 (ll-context->used ctx))
                   (s2 (mv-nth 2 (%llf))))
        (:instance used-of-ll-expr
                   (x (%f))
                   (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx))
                   (used (ll-context->used ctx)))))

(defruled expr-denv-ll-related-p-of-app-parts
  (implies (and (equal (expr-kind x) :app)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv))
           (and (expr-denv-ll-related-p new-denv denv (%f) ctx nil dw genv)
                (expr-denv-ll-related-p new-denv denv (%a) (%ctx1) nil dw
                                        genv)))
  :use ((:instance expr-denv-ll-related-p-of-sub
                   (y (%f)) (ctx2 ctx) (excl nil) (excl2 nil))
        (:instance expr-denv-ll-related-p-of-sub
                   (y (%a)) (ctx2 (%ctx1)) (excl nil) (excl2 nil)))
  :enable (ll-context-new-expr-when-app)
  :expand ((expr-free-expr-vars x)
           (:free (f a) (expr-free-expr-vars (expr-app f a)))))


(defruled eval-expr-of-app-at-sum-limit
  (implies (and (not (reserrp (eval-expr nf nd l1)))
                (not (reserrp (eval-expr na nd l2)))
                (not (reserrp (eval-app (eval-expr nf nd l1)
                                        (list (eval-expr na nd l2))
                                        l3))))
           (equal (eval-expr (expr-app nf na) nd (+ 1 l1 l2 l3))
                  (eval-app (eval-expr nf nd l1)
                            (list (eval-expr na nd l2))
                            l3)))
  :use ((:instance posp-limit-when-eval-expr-ok (expr nf) (denv nd) (limit l1))
        (:instance posp-limit-when-eval-expr-ok (expr na) (denv nd) (limit l2))
        (:instance posp-limit-when-eval-app-ok
                   (funval (eval-expr nf nd l1))
                   (argvals (list (eval-expr na nd l2)))
                   (limit l3))
        (:instance eval-expr-at-larger-limit
                   (expr nf) (denv nd) (limit l1) (limit2 (+ l1 l2 l3)))
        (:instance eval-expr-at-larger-limit
                   (expr na) (denv nd) (limit l2) (limit2 (+ l1 l2 l3)))
        (:instance eval-app-at-larger-limit
                   (funval (eval-expr nf nd l1))
                   (argvals (list (eval-expr na nd l2)))
                   (limit l3) (limit2 (+ l1 l2 l3))))
  :expand ((eval-expr (expr-app nf na) nd (+ 1 l1 l2 l3))))

;; One subexpression: the lifted one reaches a related value.

(defmacro %erw ()
  '(eval-expr-ll-reaches-p-witness (ll-context-new-expr e c) nd
                                   (eval-expr e denv l) g))

(defruled eval-expr-ll-ok-reach
  (implies (and (eval-expr-ll-ok e denv l)
                (not (reserrp (eval-expr e denv l)))
                (expr-denv-ll-related-p nd denv e c nil dw g)
                (ll-context-ok-p e c g)
                (expr-denv-wfp denv)
                (expr-denv-wfp nd))
           (b* ((nv (eval-expr (ll-context-new-expr e c) nd
                               (mv-nth 0 (%erw)))))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv (eval-expr e denv l)
                                           (mv-nth 1 (%erw)) g)
                  (expr-value-wfp nv)
                  (expr-value-wfp (eval-expr e denv l)))))
  :use ((:instance eval-expr-ll-ok-necc
                   (expr e) (limit l) (ctx c) (new-denv nd) (genv g))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (ll-context-new-expr e c)) (new-denv nd)
                   (val (eval-expr e denv l)) (genv g))
        (:instance expr-value-wfp-of-eval-expr (expr e) (limit l))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (ll-context-new-expr e c)) (denv nd)
                   (limit (mv-nth 0 (%erw)))))
  :in-theory (theory 'minimal-theory))

;; The application, over arbitrary new values for the function and argument.

(defmacro %eaw ()
  '(eval-app-ll-reaches-p-witness (eval-expr nf nd l1)
                                  (list (eval-expr na nd l2))
                                  (eval-app fv (list av) l) g))

(defruled eval-expr-ll-reaches-p-of-app-combine
  (implies (and (eval-app-ll-ok fv (list av) l)
                (not (reserrp (eval-app fv (list av) l)))
                (not (reserrp (eval-expr nf nd l1)))
                (not (reserrp (eval-expr na nd l2)))
                (expr-value-ll-related-p (eval-expr nf nd l1) fv wf g)
                (expr-value-ll-related-p (eval-expr na nd l2) av wa g)
                (expr-value-wfp (eval-expr nf nd l1))
                (expr-value-wfp fv)
                (expr-value-wfp (eval-expr na nd l2))
                (expr-value-wfp av))
           (eval-expr-ll-reaches-p (expr-app nf na) nd
                                   (eval-app fv (list av) l) g))
  :use ((:instance eval-app-ll-ok-necc
                   (funval fv) (argvals (list av)) (limit l)
                   (new-funval (eval-expr nf nd l1))
                   (new-argvals (list (eval-expr na nd l2)))
                   (w wf) (ws (list wa)) (genv g))
        (:instance eval-app-ll-reaches-p-elim
                   (new-funval (eval-expr nf nd l1))
                   (new-argvals (list (eval-expr na nd l2)))
                   (val (eval-app fv (list av) l)) (genv g))
        (:instance eval-expr-of-app-at-sum-limit (l3 (mv-nth 0 (%eaw))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (expr-app nf na)) (new-denv nd)
                   (limit2 (+ 1 l1 l2 (mv-nth 0 (%eaw))))
                   (w (mv-nth 1 (%eaw)))
                   (val (eval-app fv (list av) l)) (genv g)))
  :expand ((expr-value-list-ll-related-p (list (eval-expr na nd l2)) (list av)
                                         (list wa) g)
           (expr-value-list-ll-related-p nil nil nil g)
           (expr-value-list-wfp (list (eval-expr na nd l2)))
           (expr-value-list-wfp (list av)))
  :in-theory (union-theories (theory 'minimal-theory)
                             '((expr-value-list-wfp) car-cons cdr-cons)))

(defruled eval-expr-ll-reaches-p-when-app
  (implies (and (equal (expr-kind x) :app)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok (%f) denv (1- limit))
                (eval-expr-ll-ok (%a) denv (1- limit))
                (eval-app-ll-ok (%fval) (list (%aval)) (1- limit)))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (ll-context-ok-p-of-app-parts
        expr-denv-ll-related-p-of-app-parts
        (:instance eval-expr-ll-ok-reach
                   (e (%f)) (l (1- limit)) (nd new-denv) (c ctx) (g genv))
        (:instance eval-expr-ll-ok-reach
                   (e (%a)) (l (1- limit)) (nd new-denv) (c (%ctx1)) (g genv))
        (:instance eval-expr-ll-reaches-p-of-app-combine
                   (fv (%fval)) (av (%aval)) (l (1- limit))
                   (nf (%nf)) (na (%na)) (nd new-denv)
                   (l1 (mv-nth 0 (%wf))) (l2 (mv-nth 0 (%wa)))
                   (wf (mv-nth 1 (%wf))) (wa (mv-nth 1 (%wa))) (g genv)))
  :enable (ll-context-new-expr-when-app)
  :disable (eval-app-ll-ok eval-expr-ll-ok eval-app eval-expr-of-larger-limit
            ll-context-ok-p expr-denv-ll-related-p eval-expr-ll-reaches-p
            eval-app-ll-reaches-p eval-expr-ll-reaches-p-suff
            expr-value-ll-related-p)
  :expand ((eval-expr x denv limit)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Lambda closures and their application.  A lifted definition is bound to
; the closure of the lambda over all its parameters (the captured variables
; followed by the lambda's own); the reference that replaces the lambda
; applies it to the values of the captured variables, one at a time, each
; of the shape of its parameter, which yields the closure over the lambda's
; own parameters, in the environment extended with the captured values.

(define lambda-closure ((params var+type?-listp)
                        (body exprp)
                        (type? type-optionp)
                        (denv expr-denvp))
  :guard (consp params)
  :returns (val expr-value-resultp)
  :verify-guards nil
  (eval-atom (make-atom-lambda/lambdan params body type?) denv 1))

(defruled eval-bind-when-fun-with-params
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (reserrp (eval-bind bind denv limit))))
           (equal (eval-bind bind denv limit)
                  (expr-denv-add-expr (bind-fun->var bind)
                                      (lambda-closure (bind-fun->params bind)
                                                      (bind-fun->expr bind)
                                                      (bind-fun->type? bind)
                                                      denv)
                                      denv)))
  :enable (lambda-closure make-atom-lambda/lambdan lambda-curried-body
           difference-of-singleton-mergesort)
  :expand ((eval-bind bind denv limit)
           (:free (a) (eval-atom a denv 1))
           (:free (p b ty) (atom-free-expr-vars (atom-lambda p b ty)))
           (:free (p b ty) (atom-free-expr-vars (atom-lambdan p b ty)))
           (var+type?-list->var (bind-fun->params bind))
           (var+type?-list->var (cdr (bind-fun->params bind)))))

(defruled eval-atom-of-lambda/lambdan
  (implies (and (consp params)
                (not (zp limit)))
           (equal (eval-atom (make-atom-lambda/lambdan params body type?)
                             denv limit)
                  (lambda-closure params body type? denv)))
  :enable (lambda-closure make-atom-lambda/lambdan)
  :expand ((:free (a l) (eval-atom a denv l))))

(defruled lambda-closure-when-ok
  (implies (and (consp params)
                (not (reserrp (lambda-closure params body type? denv))))
           (and (equal (expr-value-kind (lambda-closure params body type? denv))
                       :lambda)
                (equal (expr-value-lambda->body
                        (lambda-closure params body type? denv))
                       (lambda-curried-body params body type?))
                (equal (var+typevalue->var
                        (expr-value-lambda->param
                         (lambda-closure params body type? denv)))
                       (var+type?->var (car params)))))
  :enable (lambda-closure make-atom-lambda/lambdan lambda-curried-body
           eval-var+type?)
  :cases ((consp (cdr params)))
  :expand ((:free (a l) (eval-atom a denv l))))

; Applying a lambda closure over two or more parameters to an argument of
; the shape of the first one gives the closure over the rest.

(defruled eval-app-cell-of-lambda-closure-more
  (b* ((c (lambda-closure params body type? denv)))
    (implies (and (consp params)
                  (consp (cdr params))
                  (not (reserrp c))
                  (expr-values-match-type-values-p
                   (list v)
                   (list (var+typevalue->type (expr-value-lambda->param c))))
                  (integerp limit)
                  (<= 3 limit))
             (equal (eval-app-cell c v limit)
                    (lambda-closure (cdr params) body type?
                                    (expr-denv-add-expr
                                     (var+type?->var (car params))
                                     v
                                     (expr-value-lambda->denv c))))))
  :use (lambda-closure-when-ok
        (:instance eval-atom-of-lambda/lambdan
                   (params (cdr params))
                   (denv (expr-denv-add-expr
                          (var+type?->var (car params))
                          v
                          (expr-value-lambda->denv
                           (lambda-closure params body type? denv))))
                   (limit (- limit 2))))
  :expand ((eval-app-cell (lambda-closure params body type? denv) v limit)
           (eval-expr (expr-value-lambda->body
                       (lambda-closure params body type? denv))
                      (expr-denv-add-expr
                       (var+type?->var (car params))
                       v
                       (expr-value-lambda->denv
                        (lambda-closure params body type? denv)))
                      (1- limit)))
  :enable (lambda-curried-body))

; One step of a term application of a scalar lambda value to an argument of
; the shape of its parameter: no frame lifting.

(defrule dims-of-expr-value-when-lambda
  (implies (equal (expr-value-kind f) :lambda)
           (equal (dims-of-expr-value f) nil))
  :enable (dims-of-expr-value expr-value-wfp)
  :expand ((check-dims-of-expr-value f)))

(defrule not-reserrp-of-list
  (not (reserrp (list x)))
  :enable fty::reserrp)

(defruled eval-app-of-lambda-exact
  (implies (and (equal (expr-value-kind f) :lambda)
                (expr-value-wfp v)
                (expr-values-match-type-values-p
                 (list v)
                 (list (var+typevalue->type (expr-value-lambda->param f))))
                (not (reserrp (eval-app-cell f v (- limit 2))))
                (expr-value-wfp (eval-app-cell f v (- limit 2)))
                (integerp limit)
                (<= 3 limit))
           (equal (eval-app f (cons v rest) limit)
                  (eval-app (eval-app-cell f v (- limit 2)) rest (1- limit))))
  :enable (fun-value-param-dims expr-value-first-fun
           expr-values-match-type-values-p dims-of-type-value
           check-list-suffix list-prefix-join
           lift-expr-value-to-frame-nil-nil
           not-reserrp-when-expr-valuep
           expr-value-with-nonempty-dims list-repeatp
           dims-of-expr-value-list)
  :disable (eval-app-list-when-consp eval-app-list-when-atom)
  :expand ((eval-app f (cons v rest) limit)
           (eval-app-list (list f) (list v) (1- limit))
           (eval-app-list nil nil (- limit 2))))

; Applying a lambda closure to the values of its leading parameters, one at
; a time: the environment it reaches, and the conditions for each step.

(define apply-leading-env ((cps var+type?-listp)
                           (ps var+type?-listp)
                           (body exprp)
                           (type? type-optionp)
                           (denv expr-denvp)
                           (vs expr-value-listp))
  :returns (new-denv expr-denvp)
  :verify-guards nil
  (if (endp cps)
      (expr-denv-fix denv)
    (apply-leading-env
     (cdr cps) ps body type?
     (expr-denv-add-expr (var+type?->var (car cps))
                         (car vs)
                         (expr-value-lambda->denv
                          (lambda-closure (append cps ps) body type? denv)))
     (cdr vs))))

(define apply-leading-ok-p ((cps var+type?-listp)
                            (ps var+type?-listp)
                            (body exprp)
                            (type? type-optionp)
                            (denv expr-denvp)
                            (vs expr-value-listp))
  :returns (yes/no booleanp)
  :verify-guards nil
  (if (endp cps)
      (and (endp vs)
           (not (reserrp (lambda-closure ps body type? denv))))
    (b* ((c (lambda-closure (append cps ps) body type? denv)))
      (and (not (reserrp c))
           (consp vs)
           (expr-value-wfp (car vs))
           (expr-values-match-type-values-p
            (list (car vs))
            (list (var+typevalue->type (expr-value-lambda->param c))))
           (apply-leading-ok-p
            (cdr cps) ps body type?
            (expr-denv-add-expr (var+type?->var (car cps))
                                (car vs)
                                (expr-value-lambda->denv c))
            (cdr vs))))))

(defrule expr-value-wfp-of-lambda-closure
  (implies (and (expr-denv-wfp denv)
                (not (reserrp (lambda-closure params body type? denv))))
           (expr-value-wfp (lambda-closure params body type? denv)))
  :enable lambda-closure)

(defrule expr-value-kind-of-lambda-closure
  (implies (and (consp params)
                (not (reserrp (lambda-closure params body type? denv))))
           (equal (expr-value-kind (lambda-closure params body type? denv))
                  :lambda))
  :use lambda-closure-when-ok)

(defruled eval-app-when-endp-args
  (implies (and (not (consp vs))
                (not (zp limit)))
           (equal (eval-app f vs limit)
                  (expr-value-fix f)))
  :expand ((eval-app f vs limit)))

(defruled eval-app-of-lambda-exact-consp
  (implies (and (consp vs)
                (equal (expr-value-kind f) :lambda)
                (expr-value-wfp (car vs))
                (expr-values-match-type-values-p
                 (list (car vs))
                 (list (var+typevalue->type (expr-value-lambda->param f))))
                (not (reserrp (eval-app-cell f (car vs) (- limit 2))))
                (expr-value-wfp (eval-app-cell f (car vs) (- limit 2)))
                (integerp limit)
                (<= 3 limit))
           (equal (eval-app f vs limit)
                  (eval-app (eval-app-cell f (car vs) (- limit 2))
                            (cdr vs)
                            (1- limit))))
  :use (:instance eval-app-of-lambda-exact (v (car vs)) (rest (cdr vs))))

(defrule lambda-closure-ok-when-apply-leading-ok-p
  (implies (apply-leading-ok-p cps ps body type? denv vs)
           (not (reserrp (lambda-closure (append cps ps) body type? denv))))
  :expand ((apply-leading-ok-p cps ps body type? denv vs)))

(defrule lambda-closure-of-expr-denv-fix
  (equal (lambda-closure params body type? (expr-denv-fix denv))
         (lambda-closure params body type? denv))
  :enable lambda-closure)

(local
 (defun apply-leading-ind (cps ps body type? denv vs limit)
   (if (endp cps)
       (list ps body type? denv vs limit)
     (apply-leading-ind
      (cdr cps) ps body type?
      (expr-denv-add-expr (var+type?->var (car cps))
                          (car vs)
                          (expr-value-lambda->denv
                           (lambda-closure (append cps ps) body type? denv)))
      (cdr vs)
      (1- limit)))))

(defruled eval-app-of-lambda-closure-leading
  (implies (and (consp ps)
                (apply-leading-ok-p cps ps body type? denv vs)
                (expr-denv-wfp denv)
                (integerp limit)
                (<= (+ 5 (len cps)) limit))
           (equal (eval-app (lambda-closure (append cps ps) body type? denv)
                            vs
                            limit)
                  (lambda-closure ps body type?
                                  (apply-leading-env cps ps body type?
                                                     denv vs))))
  :induct (apply-leading-ind cps ps body type? denv vs limit)
  :enable (apply-leading-ok-p apply-leading-env len
           eval-app-when-endp-args expr-valuep-when-result-not-error)
  :hints (("Subgoal *1/2"
           :use ((:instance eval-app-of-lambda-exact-consp
                            (f (lambda-closure (append cps ps) body type?
                                               denv)))
                 (:instance eval-app-cell-of-lambda-closure-more
                            (params (append cps ps))
                            (v (car vs))
                            (limit (- limit 2)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; LL-LAMBDA in parts: the parameters it collects from a chain of
; unannotated lambdas, the innermost body and its result type, and the
; context of the traversal there; lifting that body, and then emitting the
; definition.

(define ll-lambda-parts ((params var+type?-listp)
                         (body exprp)
                         (type? type-optionp)
                         (ctx ll-context-p))
  :returns (mv (all-params var+type?-listp)
               inner
               inner-type?
               (inner-ctx ll-context-p))
  :measure (expr-count body)
  :verify-guards nil
  (b* (((ll-context c) ctx)
       (params (var+type?-list-fix params))
       (ctx2 (make-ll-context
              :tenv (extend-tenv-with-params params c.tenv)
              :tlets (tlets-without (var+type?-list->var params) c.tlets)
              :locals (locals-with-params params c.locals)
              :lmap (string-expr-map-remove-keys (var+type?-list->var params)
                                                 c.lmap)
              :used c.used))
       ((mv nestedp more inner inner-type?) (nested-lambda body))
       ((when (and nestedp (type-option-case type? :none)))
        (ll-lambda-parts (append params more) inner inner-type? ctx2)))
    (mv params body type? ctx2)))

(defruled ll-lambda-decomposition
  (equal (ll-lambda params body type?
                    (ll-context->tenv ctx) (ll-context->tlets ctx)
                    (ll-context->locals ctx) (ll-context->lmap ctx)
                    (ll-context->used ctx))
         (b* (((mv ps inner ity ictx)
               (ll-lambda-parts params body type? ctx))
              ((ll-context ic) ictx)
              ((mv new-body lifted used2)
               (ll-expr inner ic.tenv ic.tlets ic.locals ic.lmap ic.used))
              ((mv e more used3)
               (emit-lifted-lambda ps new-body ity ic.tenv ic.locals used2)))
           (mv e (append lifted more) used3)))
  :induct (ll-lambda-parts params body type? ctx)
  :expand ((:free (type?)
                  (ll-lambda params body type?
                             (ll-context->tenv ctx) (ll-context->tlets ctx)
                             (ll-context->locals ctx) (ll-context->lmap ctx)
                             (ll-context->used ctx)))
           (:free (type?) (ll-lambda-parts params body type? ctx)))
  :enable ((:induction ll-lambda-parts)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The walker of the environment relation holds if its condition holds at
; each variable; and the lookups in the environment that the application of
; a lifted definition to the captured values reaches.

(acl2::defun-sk walker-pointwise-p (new-denv map fv nfv ctx dw genv)
  (forall var
          (implies (and (omap::assoc var map)
                        (set::in var fv))
                   (ll-var-ok-p var (cdr (omap::assoc var map))
                                new-denv nfv ctx dw genv))))

(defruled walker-pointwise-p-of-tail
  (implies (walker-pointwise-p new-denv map fv nfv ctx dw genv)
           (walker-pointwise-p new-denv (omap::tail map) fv nfv ctx dw genv))
  :expand ((walker-pointwise-p new-denv (omap::tail map) fv nfv ctx dw genv))
  :use ((:instance walker-pointwise-p-necc
                   (var (walker-pointwise-p-witness
                         new-denv (omap::tail map) fv nfv ctx dw genv)))
        (:instance assoc-when-assoc-of-tail
                   (k (walker-pointwise-p-witness
                       new-denv (omap::tail map) fv nfv ctx dw genv))
                   (m map))))

(defruled string-expr-value-map-ll-related-p-unfold
  (implies (and (string-expr-value-mapp map)
                (not (omap::emptyp map)))
           (equal (string-expr-value-map-ll-related-p nd map fv nfv ctx dw genv)
                  (and (or (not (set::in (mv-nth 0 (omap::head map)) fv))
                           (ll-var-ok-p (mv-nth 0 (omap::head map))
                                        (mv-nth 1 (omap::head map))
                                        nd nfv ctx dw genv))
                       (string-expr-value-map-ll-related-p
                        nd (omap::tail map) fv nfv ctx dw genv))))
  :expand ((string-expr-value-map-ll-related-p nd map fv nfv ctx dw genv))
  :enable (ll-var-ok-p)
  :disable (expr-value-ll-related-p value-meets-required-type-p
            value-has-inferred-type-p eval-expr))

(defruled string-expr-value-map-ll-related-p-when-pointwise
  (implies (and (string-expr-value-mapp map)
                (walker-pointwise-p new-denv map fv nfv ctx dw genv))
           (string-expr-value-map-ll-related-p new-denv map fv nfv ctx dw
                                               genv))
  :induct (ll-map-ind map)
  :enable (walker-pointwise-p-of-tail)
  :disable (ll-var-ok-p string-expr-value-map-ll-related-p)
  :hints (("Subgoal *1/2"
           :use ((:instance string-expr-value-map-ll-related-p-unfold
                            (nd new-denv))
                 (:instance walker-pointwise-p-necc
                            (var (mv-nth 0 (omap::head map))))))
          ("Subgoal *1/1"
           :expand ((string-expr-value-map-ll-related-p new-denv map fv nfv
                                                        ctx dw genv)))))

(defruled expr-denv-lookup-expr-of-expr-denv-add-expr
  (equal (expr-denv-lookup-expr n (expr-denv-add-expr m v d))
         (if (equal (str-fix n) (str-fix m))
             (expr-value-fix v)
           (expr-denv-lookup-expr n d)))
  :enable (expr-denv-lookup-expr expr-denv-add-expr))

(defruled expr-denv-lookup-expr-of-expr-denv-restrict
  (equal (expr-denv-lookup-expr n (expr-denv-restrict ivars tvars evars d))
         (if (set::in (str-fix n) (string-sfix evars))
             (expr-denv-lookup-expr n d)
           (reserr nil)))
  :enable (expr-denv-lookup-expr expr-denv-restrict omap::assoc-of-restrict))

(defruled atom-free-expr-vars-of-make-atom-lambda/lambdan
  (implies (consp params)
           (equal (atom-free-expr-vars
                   (make-atom-lambda/lambdan params body type?))
                  (set::difference (expr-free-expr-vars body)
                                   (set::mergesort
                                    (var+type?-list->var params)))))
  :enable (make-atom-lambda/lambdan difference-of-singleton-mergesort)
  :expand ((:free (p b ty) (atom-free-expr-vars (atom-lambda p b ty)))
           (:free (p b ty) (atom-free-expr-vars (atom-lambdan p b ty)))
           (var+type?-list->var params)
           (var+type?-list->var (cdr params))))

(defruled expr-value-lambda->denv-of-lambda-closure
  (implies (and (consp params)
                (not (reserrp (lambda-closure params body type? denv))))
           (equal (expr-value-lambda->denv
                   (lambda-closure params body type? denv))
                  (expr-denv-restrict
                   (expr-free-ispace-vars
                    (lambda-curried-body params body type?))
                   (expr-free-type-vars (lambda-curried-body params body type?))
                   (atom-free-expr-vars
                    (make-atom-lambda/lambdan params body type?))
                   denv)))
  :enable (lambda-closure make-atom-lambda/lambdan lambda-curried-body)
  :cases ((consp (cdr params)))
  :expand ((:free (a l) (eval-atom a denv l))))

(defruled lookup-in-lambda-closure-denv
  (implies (and (consp params)
                (not (reserrp (lambda-closure params body type? denv)))
                (stringp n)
                (set::in n (expr-free-expr-vars body))
                (not (member-equal n (var+type?-list->var params))))
           (equal (expr-denv-lookup-expr
                   n (expr-value-lambda->denv
                      (lambda-closure params body type? denv)))
                  (expr-denv-lookup-expr n denv)))
  :enable (expr-value-lambda->denv-of-lambda-closure
           expr-denv-lookup-expr-of-expr-denv-restrict
           atom-free-expr-vars-of-make-atom-lambda/lambdan))

; Other names keep their values through the application of the leading
; parameters.

(defruled lookup-of-apply-leading-env-other
  (implies (and (apply-leading-ok-p cps ps body type? denv vs)
                (consp ps)
                (stringp n)
                (set::in n (expr-free-expr-vars body))
                (not (member-equal n (var+type?-list->var cps)))
                (not (member-equal n (var+type?-list->var ps))))
           (equal (expr-denv-lookup-expr
                   n (apply-leading-env cps ps body type? denv vs))
                  (expr-denv-lookup-expr n denv)))
  :induct (apply-leading-env cps ps body type? denv vs)
  :enable (apply-leading-env apply-leading-ok-p
           expr-denv-lookup-expr-of-expr-denv-add-expr
           lookup-in-lambda-closure-denv))

; The captured names have the values they were looked up to.

(defruled lookup-of-apply-leading-env-captured
  (implies (and (equal vs (expr-denv-lookup-exprs (var+type?-list->var cps)
                                                  src))
                (not (reserrp vs))
                (apply-leading-ok-p cps ps body type? denv vs)
                (consp ps)
                (no-duplicatesp-equal (var+type?-list->var cps))
                (member-equal n (var+type?-list->var cps))
                (set::in n (expr-free-expr-vars body))
                (not (member-equal n (var+type?-list->var ps))))
           (equal (expr-denv-lookup-expr
                   n (apply-leading-env cps ps body type? denv vs))
                  (expr-denv-lookup-expr n src)))
  :induct (apply-leading-env cps ps body type? denv vs)
  :enable (apply-leading-env apply-leading-ok-p
           var+type?-list->var expr-denv-lookup-exprs
           expr-denv-lookup-expr-of-expr-denv-add-expr
           expr-valuep-when-result-not-error)
  :hints (("Subgoal *1/2"
           :use ((:instance lookup-of-apply-leading-env-other
                            (cps (cdr cps))
                            (denv (expr-denv-add-expr
                                   (var+type?->var (car cps))
                                   (car vs)
                                   (expr-value-lambda->denv
                                    (lambda-closure (append cps ps) body type?
                                                    denv))))
                            (vs (cdr vs)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The parameters and context that LL-LAMBDA collects, against the original
; closure: the parameters are those of the chain of unannotated lambdas
; (see LAMBDA-CHAIN); the context adds them as locals, without hoisted
; functions or inferred types, typed by their own annotations; and the
; lifted closure has the original's parameter, stored result type, and the
; body the relation expects.

(defruled ll-lambda-parts-is-lambda-chain
  (implies (and (exprp body) (type-optionp type?))
           (b* (((mv ps inner ity &) (ll-lambda-parts params body type? ctx))
                ((mv more cinner city) (lambda-chain body type?)))
             (and (equal ps (append (var+type?-list-fix params) more))
                  (equal inner cinner)
                  (equal ity city))))
  :induct (ll-lambda-parts params body type? ctx)
  :enable ((:induction ll-lambda-parts))
  :expand ((:free (type?) (ll-lambda-parts params body type? ctx))
           (:free (type?) (lambda-chain body type?))))

(defruled member-of-ll-lambda-parts-params
  (implies (member-equal k (var+type?-list->var params))
           (member-equal k (var+type?-list->var
                            (mv-nth 0 (ll-lambda-parts params body type?
                                                       ctx)))))
  :induct (ll-lambda-parts params body type? ctx)
  :enable ((:induction ll-lambda-parts))
  :expand ((:free (type?) (ll-lambda-parts params body type? ctx))))

(defrule assoc-of-extend-tenv-with-params-other
  (implies (not (member-equal k (var+type?-list->var params)))
           (equal (omap::assoc k (extend-tenv-with-params params tenv))
                  (omap::assoc k (string-type-map-fix tenv))))
  :induct (extend-tenv-with-params params tenv)
  :enable (extend-tenv-with-params extend-tenv-with-var var+type?-list->var))

(defruled ll-lambda-parts-context
  (b* (((mv ps & & ictx) (ll-lambda-parts params body type? ctx))
       (vars (var+type?-list->var ps)))
    (and (equal (ll-context->used ictx) (ll-context->used ctx))
         (equal (set::in k (ll-context->locals ictx))
                (or (and (member-equal k vars) t)
                    (set::in k (ll-context->locals ctx))))
         (equal (set::in k (ll-context->tlets ictx))
                (and (set::in k (ll-context->tlets ctx))
                     (not (member-equal k vars))))
         (equal (omap::assoc k (ll-context->lmap ictx))
                (if (member-equal k vars)
                    nil
                  (omap::assoc k (ll-context->lmap ctx))))
         (implies (not (member-equal k vars))
                  (equal (omap::assoc k (ll-context->tenv ictx))
                         (omap::assoc k (ll-context->tenv ctx))))))
  :induct (ll-lambda-parts params body type? ctx)
  :enable ((:induction ll-lambda-parts) locals-with-params tlets-without
           member-of-ll-lambda-parts-params)
  :expand ((:free (type?) (ll-lambda-parts params body type? ctx))))

(defruled ll-lambda-parts-used
  (equal (ll-context->used (mv-nth 3 (ll-lambda-parts params body type? ctx)))
         (ll-context->used ctx))
  :use (:instance ll-lambda-parts-context (k nil)))

; The original closure's body splits, as the relation does it, into the
; innermost body and result type that LL-LAMBDA collects.

(defruled closure-body-parts-of-lambda-curried-body
  (b* (((mv more inner ity) (lambda-chain body type?))
       (ps (append params more))
       ((mv okp cinner city)
        (closure-body-parts (lambda-curried-body params body type?)
                            tyv (cdr ps) t)))
    (implies (and (var+type?-listp params)
                  (consp params)
                  (exprp body)
                  (type-optionp type?)
                  (iff tyv (and (endp (cdr params))
                                (type-option-case type? :some))))
             (and okp
                  (equal cinner inner)
                  (equal (lifted-closure-body (cdr ps) new-inner city)
                         (lambda-curried-body ps new-inner ity)))))
  :enable (closure-body-parts lambda-curried-body lifted-closure-body
           nested-lambda make-atom-lambda/lambdan
           consp-when-positive-len positive-len-when-consp)
  :expand ((lambda-chain body type?)
           (:free (b) (lambda-chain (expr-atom b) (type-option-none)))
           (lambda-chain body (type-option-none))
           (lambda-chain body nil)
           (:free (b) (lambda-chain (expr-atom b) nil)))
  :cases ((consp (cdr params))))

; The lifted closure has the parameter and stored result type of the
; original one, when the lambda is closed in type and ispace variables.

(defruled lambda-closure-fields-of-chain
  (b* (((mv more & ity) (lambda-chain body type?))
       (u (lambda-closure (append params more) new-body ity new-denv))
       (v (lambda-closure params body type? denv)))
    (implies (and (var+type?-listp params)
                  (consp params)
                  (exprp body)
                  (type-optionp type?)
                  (set::emptyp (var+type?-free-type-vars (car params)))
                  (set::emptyp (var+type?-free-ispace-vars (car params)))
                  (set::emptyp (type-option-free-type-vars type?))
                  (set::emptyp (type-option-free-ispace-vars type?))
                  (implies (mv-nth 0 (nested-lambda body))
                           (consp (mv-nth 1 (nested-lambda body))))
                  (not (reserrp u))
                  (not (reserrp v)))
             (and (equal (expr-value-lambda->param u)
                         (expr-value-lambda->param v))
                  (equal (expr-value-lambda->type? u)
                         (expr-value-lambda->type? v)))))
  :enable (lambda-closure make-atom-lambda/lambdan eval-var+type?
           var+type?->type-or-err eval-type-when-closed
           consp-when-positive-len positive-len-when-consp)
  :expand ((lambda-chain body type?)
           (:free (a l d) (eval-atom a d l))
           (var+type?-free-type-vars (car params))
           (var+type?-free-ispace-vars (car params))
           (:free (ty) (type-option-free-type-vars ty))
           (:free (ty) (type-option-free-ispace-vars ty)))
  :cases ((consp (cdr params))))

; The parameters are local, and neither hoisted nor with inferred types, in
; the inner context.

(defruled names-in-context-p-of-ll-lambda-parts
  (b* (((mv ps & & ictx) (ll-lambda-parts params body type? ctx)))
    (implies (and (string-listp names)
                  (subsetp-equal names (var+type?-list->var ps)))
             (names-in-context-p names ictx)))
  :induct (len names)
  :enable (names-in-context-p len subsetp-equal ll-lambda-parts-context))

(defruled name-to-type-option-of-extend-tenv-with-params-member
  (implies (and (no-duplicatesp-equal (var+type?-list->var ps))
                (member-equal p (var+type?-list-fix ps))
                (type-option-case (var+type?->type? p) :some))
           (equal (name-to-type-option (var+type?->var p)
                                       (extend-tenv-with-params ps tenv))
                  (var+type?->type? p)))
  :induct (extend-tenv-with-params ps tenv)
  :enable (extend-tenv-with-params extend-tenv-with-var name-to-type-option
           var+type?-list->var var+type?-list-fix))

(defruled name-to-type-option-in-ll-lambda-parts-context
  (b* (((mv ps & & ictx) (ll-lambda-parts params body type? ctx)))
    (implies (and (no-duplicatesp-equal (var+type?-list->var ps))
                  (member-equal p ps)
                  (type-option-case (var+type?->type? p) :some))
             (equal (name-to-type-option (var+type?->var p)
                                         (ll-context->tenv ictx))
                    (var+type?->type? p))))
  :induct (ll-lambda-parts params body type? ctx)
  :enable ((:induction ll-lambda-parts)
           name-to-type-option-of-extend-tenv-with-params-member)
  :expand ((:free (type?) (ll-lambda-parts params body type? ctx))))

(defruled prest-tenv-consistent-p-of-ll-lambda-parts
  (b* (((mv ps & & ictx) (ll-lambda-parts params body type? ctx)))
    (implies (and (no-duplicatesp-equal (var+type?-list->var ps))
                  (subsetp-equal l ps))
             (prest-tenv-consistent-p l (ll-context->tenv ictx))))
  :induct (len l)
  :enable (prest-tenv-consistent-p subsetp-equal len
           name-to-type-option-in-ll-lambda-parts-context))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The environment of the lifted closure, variable by variable: a captured
; local variable has the value it has where the lambda was; a primitive
; operation has its initial value, which is ground; and a hoisted function's
; replacement evaluates as it does where the lambda was, since its
; function is bound at the top and its variables are captured.

; The values of the initial environment are ground.

(define all-values-groundp ((map string-expr-value-mapp))
  :verify-guards nil
  (b* ((map (string-expr-value-map-fix map))
       ((when (omap::emptyp map)) t))
    (and (expr-value-groundp (omap::head-val map))
         (all-values-groundp (omap::tail map))))
  :measure (acl2-count (string-expr-value-map-fix map)))

(defruled expr-value-groundp-when-all-values-groundp
  (implies (and (all-values-groundp map)
                (string-expr-value-mapp map)
                (omap::assoc v map))
           (expr-value-groundp (cdr (omap::assoc v map))))
  :induct (all-values-groundp map)
  :enable (all-values-groundp omap::assoc))

(defrule expr-value-groundp-of-init-lookup
  (implies (not (reserrp (expr-denv-lookup-expr v (init-expr-denv))))
           (expr-value-groundp (expr-denv-lookup-expr v (init-expr-denv))))
  :use (:instance expr-value-groundp-when-all-values-groundp
                  (map (primop-values)) (v (str-fix v)))
  :enable (expr-denv-lookup-expr init-expr-denv))

; Lookups in an environment with some names bound as in another.

(defruled lookup-of-expr-denv-with-names-from
  (implies (string-setp names)
           (equal
            (expr-denv-lookup-expr n (expr-denv-with-names-from names d g))
                  (if (and (set::in (str-fix n) names)
                           (not (reserrp (expr-denv-lookup-expr n g))))
                      (expr-denv-lookup-expr n g)
                    (expr-denv-lookup-expr n d))))
  :induct (expr-denv-with-names-from names d g)
  :enable (omap::assoc-when-assoc-tail omap::assoc-when-emptyp
           (:t omap::tail-when-emptyp) set::in-tail set::tail-when-emptyp
           set::emptyp-subset-2
           expr-denv-with-names-from
           expr-denv-lookup-expr-of-expr-denv-add-expr
           expr-valuep-when-result-not-error))

; The replacement of a hoisted function evaluates alike in environments
; that agree on its function and on the variables it is applied to.

(define lookups-agree-p ((names string-listp) (d1 expr-denvp) (d2 expr-denvp))
  :returns (yes/no booleanp)
  :verify-guards nil
  (or (endp names)
      (and (equal (expr-denv-lookup-expr (car names) d1)
                  (expr-denv-lookup-expr (car names) d2))
           (lookups-agree-p (cdr names) d1 d2))))

(defruled eval-expr-list-of-names-to-exprs-when-agree
  (implies (lookups-agree-p names d1 d2)
           (equal (eval-expr-list (names-to-exprs names) d1 l)
                  (eval-expr-list (names-to-exprs names) d2 l)))
  :induct (acl2::cdr-dec-induct names l)
  :enable (lookups-agree-p names-to-exprs)
  :expand ((:free (d) (eval-expr-list (names-to-exprs names) d l))
           (:free (a b d) (eval-expr-list (cons a b) d l))
           (:free (d) (eval-expr-list nil d l))))

(defruled eval-expr-of-apply-to-names-when-agree-more
  (implies (and (consp (cdr names))
                (lookups-agree-p names d1 d2)
                (equal (expr-denv-lookup-expr h d1)
                       (expr-denv-lookup-expr h d2)))
           (equal (eval-expr (apply-to-names (expr-var h) names) d1 l)
                  (eval-expr (apply-to-names (expr-var h) names) d2 l)))
  :do-not-induct t
  :use ((:instance eval-expr-list-of-names-to-exprs-when-agree (l (1- l))))
  :enable (apply-to-names)
  :disable (eval-expr-list-of-names-to-exprs len)
  :expand ((len names)
           (len (cdr names))
           (:free (f as d) (eval-expr (expr-appn f as) d l))))

(defruled eval-expr-of-apply-to-names-when-agree-one
  (implies (and (consp names)
                (not (consp (cdr names)))
                (equal (expr-denv-lookup-expr (car names) d1)
                       (expr-denv-lookup-expr (car names) d2))
                (equal (expr-denv-lookup-expr h d1)
                       (expr-denv-lookup-expr h d2)))
           (equal (eval-expr (apply-to-names (expr-var h) names) d1 l)
                  (eval-expr (apply-to-names (expr-var h) names) d2 l)))
  :do-not-induct t
  :enable (apply-to-names)
  :expand ((:free (f a d) (eval-expr (expr-app f a) d l))))

(defruled eval-expr-of-apply-to-names-when-agree
  (implies (and (equal (expr-denv-lookup-expr h d1)
                       (expr-denv-lookup-expr h d2))
                (lookups-agree-p names d1 d2))
           (equal (eval-expr (apply-to-names (expr-var h) names) d1 l)
                  (eval-expr (apply-to-names (expr-var h) names) d2 l)))
  :do-not-induct t
  :cases ((not (consp names)) (not (consp (cdr names))))
  :use (eval-expr-of-apply-to-names-when-agree-more
        eval-expr-of-apply-to-names-when-agree-one)
  :expand ((lookups-agree-p names d1 d2))
  :disable apply-to-names)

(defrule string-list-fix-when-string-setp
  (implies (string-setp x)
           (equal (str::string-list-fix x) x))
  :enable acl2::string-listp-when-string-setp)

; The environment of the lifted closure, after the captured values are
; passed: the captured variables have their values in the environment of
; the reference, and the other variables of the body their values at the
; top.

(defruled lookup-in-lifted-closure-env-captured
  (b* ((cps (names-to-params fv tenv))
       (vs (expr-denv-lookup-exprs fv nd))
       (u (lambda-closure ps nb ity
                          (apply-leading-env cps ps nb ity genv vs))))
    (implies (and (string-setp fv)
                  (stringp n)
                  (set::in n fv)
                  (set::subset fv (expr-free-expr-vars nb))
                  (not (member-equal n (var+type?-list->var ps)))
                  (consp ps)
                  (not (reserrp vs))
                  (apply-leading-ok-p cps ps nb ity genv vs)
                  (not (reserrp u)))
             (equal (expr-denv-lookup-expr n (expr-value-lambda->denv u))
                    (expr-denv-lookup-expr n nd))))
  :use ((:instance lookup-in-lambda-closure-denv
                   (params ps) (body nb) (type? ity)
                   (denv (apply-leading-env (names-to-params fv tenv) ps nb ity
                                            genv
                                            (expr-denv-lookup-exprs fv nd))))
        (:instance lookup-of-apply-leading-env-captured
                   (cps (names-to-params fv tenv))
                   (body nb) (type? ity) (denv genv)
                   (vs (expr-denv-lookup-exprs fv nd))
                   (src nd))
        (:instance no-duplicatesp-equal-when-setp (x fv))
        (:instance set::in-to-member (a n) (x fv))
        (:instance set::subset-in (a n) (x fv)
                   (y (expr-free-expr-vars nb))))
  :disable (set::in-to-member))

(defruled lookup-in-lifted-closure-env-other
  (b* ((cps (names-to-params fv tenv))
       (vs (expr-denv-lookup-exprs fv nd))
       (u (lambda-closure ps nb ity
                          (apply-leading-env cps ps nb ity genv vs))))
    (implies (and (string-setp fv)
                  (stringp n)
                  (not (set::in n fv))
                  (set::in n (expr-free-expr-vars nb))
                  (not (member-equal n (var+type?-list->var ps)))
                  (consp ps)
                  (apply-leading-ok-p cps ps nb ity genv vs)
                  (not (reserrp u)))
             (equal (expr-denv-lookup-expr n (expr-value-lambda->denv u))
                    (expr-denv-lookup-expr n genv))))
  :use ((:instance lookup-in-lambda-closure-denv
                   (params ps) (body nb) (type? ity)
                   (denv (apply-leading-env (names-to-params fv tenv) ps nb ity
                                            genv
                                            (expr-denv-lookup-exprs fv nd))))
        (:instance lookup-of-apply-leading-env-other
                   (cps (names-to-params fv tenv))
                   (body nb) (type? ity) (denv genv)
                   (vs (expr-denv-lookup-exprs fv nd))))
  :enable (set::in-to-member))

; A variable that is not a parameter is seen alike in the inner context.

(defruled ll-lambda-parts-context-at-other
  (b* (((mv ps & & ictx) (ll-lambda-parts params body type? ctx)))
    (implies (not (member-equal v (var+type?-list->var ps)))
             (and (equal (set::in v (ll-context->locals ictx))
                         (set::in v (ll-context->locals ctx)))
                  (equal (set::in v (ll-context->tlets ictx))
                         (set::in v (ll-context->tlets ctx)))
                  (equal (omap::assoc v (ll-context->lmap ictx))
                         (omap::assoc v (ll-context->lmap ctx)))
                  (implies (stringp v)
                           (equal
                            (name-to-type-option v (ll-context->tenv ictx))
                                  (name-to-type-option v
                                                       (ll-context->tenv
                                                        ctx)))))))
  :use ((:instance ll-lambda-parts-context (k v)))
  :enable name-to-type-option)

(defruled value-type-conditions-when-same-type-option
  (implies (equal (name-to-type-option v tenv2)
                  (name-to-type-option v tenv1))
           (and (equal (value-meets-required-type-p val v tenv2)
                       (value-meets-required-type-p val v tenv1))
                (equal (value-has-inferred-type-p val v tenv2)
                       (value-has-inferred-type-p val v tenv1))))
  :enable (value-meets-required-type-p value-has-inferred-type-p
           var-required-type))

; The shape of the replacement of a hoisted function: its definition's
; name, bound at the top and not local, applied to local variables that are
; not parameters of the lambda at hand.



(defruled ll-lambda-parts-locals
  (b* (((mv ps & & ictx) (ll-lambda-parts params body type? ctx)))
    (equal (ll-context->locals ictx)
           (set::union (set::mergesort (var+type?-list->var ps))
                       (ll-context->locals ctx))))
  :use ((:instance set::double-containment
                   (x (ll-context->locals
                       (mv-nth 3 (ll-lambda-parts params body type? ctx))))
                   (y (set::union (set::mergesort
                                   (var+type?-list->var
                                    (mv-nth 0 (ll-lambda-parts params body
                                                               type? ctx))))
                                  (ll-context->locals ctx)))))
  :enable (set::pick-a-point-subset-strategy ll-lambda-parts-context)
  :disable (set::double-containment))

(defruled ll-lambda-parts-locals-subset-used
  (b* (((mv ps & & ictx) (ll-lambda-parts params body type? ctx)))
    (implies (and (set::subset (ll-context->locals ctx) (ll-context->used ctx))
                  (subsetp-equal (var+type?-list->var ps)
                                 (ll-context->used ctx)))
             (set::subset (ll-context->locals ictx) (ll-context->used ictx))))
  :use (ll-lambda-parts-locals ll-lambda-parts-used)
  :enable (set::pick-a-point-subset-strategy in-when-member-of-subsetp
           set::subset-in)
  :disable (ll-lambda-parts))

; The sets of a hoisted function's replacement, in the lifted lambda.

(defruled hoisted-replacement-sets
  (b* ((ic-locals (set::union (set::mergesort pnames) locals))
       (fve (set::intersect (set::difference nbfv (set::mergesort pnames))
                            ic-locals))
       (rvars (set::union (set::insert h nil) (set::mergesort hns))))
    (implies (and (stringp h)
                  (string-listp hns)
                  (string-listp pnames)
                  (string-setp locals)
                  (string-setp nbfv)
                  (not (set::in h locals))
                  (not (member-equal h pnames))
                  (subsetp-equal hns locals)
                  (not (intersectp-equal hns pnames))
                  (set::subset (set::intersect rvars ic-locals) nbfv))
             (and (set::subset (set::intersect rvars locals)
                               (set::union (set::insert lam nil) fve))
                  (equal (set::difference rvars ic-locals) (set::insert h nil))
                  (equal (set::difference rvars locals) (set::insert h nil))
                  (set::subset (set::mergesort hns) fve))))
  :enable (set::pick-a-point-subset-strategy set::double-containment
           set::subset-in in-when-member-of-subsetp
           not-member-when-not-intersectp)
  :disable (set::union-under-set-equiv set::intersect-under-set-equiv
            set::difference-under-set-equiv set::mergesort-under-set-equiv))

(defruled lookups-agree-p-of-lifted-closure-env
  (b* ((cps (names-to-params fv tenv))
       (vs (expr-denv-lookup-exprs fv nd))
       (u (lambda-closure ps nb ity
                          (apply-leading-env cps ps nb ity genv vs))))
    (implies (and (string-listp hns)
                  (set::subset (set::mergesort hns) fv)
                  (not (intersectp-equal hns (var+type?-list->var ps)))
                  (string-setp fv)
                  (set::subset fv (expr-free-expr-vars nb))
                  (consp ps)
                  (not (reserrp vs))
                  (apply-leading-ok-p cps ps nb ity genv vs)
                  (not (reserrp u)))
             (lookups-agree-p hns (expr-value-lambda->denv u) nd)))
  :induct (len hns)
  :enable (lookups-agree-p len lookup-in-lifted-closure-env-captured
           intersectp-equal)
  :expand ((set::mergesort hns)))

(defruled lookups-agree-p-of-with-names-from-insert
  (implies (and (lookups-agree-p hns d1 d2)
                (string-listp hns)
                (stringp h)
                (not (member-equal h hns)))
           (lookups-agree-p hns
                            (expr-denv-with-names-from (set::insert h nil) d1 g)
                            (expr-denv-with-names-from (set::insert h nil) d2
                                                       g)))
  :induct (len hns)
  :enable (lookups-agree-p len lookup-of-expr-denv-with-names-from))

(define ll-var-referred-ok-p ((var stringp)
                              (val expr-valuep)
                              (new-denv expr-denvp)
                              (nfv string-setp)
                              (ctx ll-context-p)
                              (dw ll-denv-witness-p)
                              (genv expr-denvp))
  :returns (yes/no booleanp)
  :verify-guards nil
  (b* (((ll-context c) ctx)
       ((ll-denv-witness d) dw)
       (wpair (omap::assoc var d.vals))
       (w (if wpair (cdr wpair) (ll-value-witness-ground)))
       (lpair (omap::assoc var c.lmap))
       (rvars (and lpair (expr-free-expr-vars (cdr lpair))))
       (referredp (if lpair
                      (set::subset (set::intersect rvars c.locals) nfv)
                    (set::in var nfv)))
       (new-val (if lpair
                    (eval-expr (cdr lpair)
                               (expr-denv-with-names-from
                                (set::difference rvars c.locals)
                                new-denv
                                genv)
                               d.limit)
                  (expr-denv-lookup-expr var new-denv))))
    (or (not referredp)
        (and (not (reserrp new-val))
             (expr-value-ll-related-p new-val val w genv)))))

(define ll-var-types-ok-p ((var stringp)
                           (val expr-valuep)
                           (ctx ll-context-p))
  :returns (yes/no booleanp)
  :verify-guards nil
  (b* (((ll-context c) ctx))
    (and (value-meets-required-type-p val var c.tenv)
         (or (not (set::in var c.tlets))
             (value-has-inferred-type-p val var c.tenv))
         (or (set::in var c.locals)
             (equal val (expr-denv-lookup-expr var (init-expr-denv)))))))

(defruled ll-var-ok-p-split
  (equal (ll-var-ok-p var val new-denv nfv ctx dw genv)
         (and (ll-var-referred-ok-p var val new-denv nfv ctx dw genv)
              (ll-var-types-ok-p var val ctx)))
  :enable (ll-var-ok-p ll-var-referred-ok-p ll-var-types-ok-p))

; The types part carries over to the inner context of a lambda.

(defruled ll-var-types-ok-p-of-ll-lambda-parts
  (b* (((mv ps & & ictx) (ll-lambda-parts params body type? ctx)))
    (implies (and (stringp v)
                  (not (member-equal v (var+type?-list->var ps)))
                  (ll-var-types-ok-p v val ctx))
             (ll-var-types-ok-p v val ictx)))
  :enable ll-var-types-ok-p
  :use ((:instance ll-lambda-parts-context-at-other)
        (:instance value-type-conditions-when-same-type-option
                   (tenv1 (ll-context->tenv ctx))
                   (tenv2 (ll-context->tenv
                           (mv-nth 3 (ll-lambda-parts params body type?
                                                      ctx)))))))

(defmacro %lp () '(ll-lambda-parts pa ba ta ctx))
(defmacro %ps () '(mv-nth 0 (%lp)))
(defmacro %ity () '(mv-nth 2 (%lp)))
(defmacro %ictx () '(mv-nth 3 (%lp)))
(defmacro %nb () '(ll-context-new-expr (mv-nth 1 (%lp)) (%ictx)))
(defmacro %fve ()
  '(set::intersect (set::difference (expr-free-expr-vars (%nb))
                                    (set::mergesort
                                     (var+type?-list->var (%ps))))
                   (ll-context->locals (%ictx))))
(defmacro %vs () '(expr-denv-lookup-exprs (%fve) new-denv))
(defmacro %cps () '(names-to-params (%fve) (ll-context->tenv (%ictx))))
(defmacro %u ()
  '(lambda-closure (%ps) (%nb) (%ity)
                   (apply-leading-env (%cps) (%ps) (%nb) (%ity) genv (%vs))))
(defmacro %udenv () '(expr-value-lambda->denv (%u)))
(defmacro %nfvx ()
          '(expr-free-expr-vars (apply-to-names (expr-var lam) (%fve))))
(defmacro %dw2 ()
  '(change-ll-denv-witness dw :vals (omap::restrict (ll-context->locals ctx)
                                                    (ll-denv-witness->vals
                                                     dw))))

(defruled fve-facts
  (implies (and (string-setp a) (string-setp c))
           (and (string-setp (set::intersect (set::difference a b) c))
                (set::subset (set::intersect (set::difference a b) c) a)))
  :enable (set::pick-a-point-subset-strategy))

(defrule string-ll-value-witness-mapp-of-restrict
  (implies (string-ll-value-witness-mapp m)
           (string-ll-value-witness-mapp (omap::restrict keys m)))
  :induct (omap::restrict keys m)
  :enable (omap::restrict))

(defruled ll-var-referred-ok-p-of-lifted-closure-local
  (implies (and (stringp v)
                (not (member-equal v (var+type?-list->var (%ps))))
                (not (omap::assoc v (ll-context->lmap ctx)))
                (set::in v (ll-context->locals ctx))
                (ll-var-referred-ok-p v val new-denv (%nfvx) ctx dw genv)
                (consp (%ps))
                (not (reserrp (%vs)))
                (apply-leading-ok-p (%cps) (%ps) (%nb) (%ity) genv (%vs))
                (not (reserrp (%u))))
           (ll-var-referred-ok-p v val (%udenv) (expr-free-expr-vars (%nb))
                                 (%ictx) (%dw2) genv))
  :use ((:instance ll-lambda-parts-context-at-other
                   (params pa) (body ba) (type? ta))
        (:instance lookup-in-lifted-closure-env-captured
                   (n v) (fv (%fve)) (tenv (ll-context->tenv (%ictx)))
                   (nd new-denv) (ps (%ps)) (nb (%nb)) (ity (%ity)))
        (:instance fve-facts
                   (a (expr-free-expr-vars (%nb)))
                   (b (set::mergesort (var+type?-list->var (%ps))))
                   (c (ll-context->locals (%ictx)))))
  :enable (ll-var-referred-ok-p omap::assoc-of-restrict
           ll-lambda-parts-locals)
  :disable (set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled lookup-in-genv-when-agrees-with-init
  (implies (and (genv-agrees-with-init-p genv)
                (not (reserrp (expr-denv-lookup-expr v (init-expr-denv)))))
           (equal (expr-denv-lookup-expr v genv)
                  (expr-denv-lookup-expr v (init-expr-denv))))
  :use ((:instance names-bound-as-in-p-when-in
                   (names (omap::keys (expr-denv->exprs (init-expr-denv))))
                   (new-denv genv)
                   (genv (init-expr-denv))
                   (name (str-fix v)))
        (:instance omap::in-of-keys-to-assoc
                   (omap::key (str-fix v))
                   (omap::map (expr-denv->exprs (init-expr-denv)))))
  :enable (genv-agrees-with-init-p expr-denv-lookup-expr)
  :disable ((:e init-expr-denv)))

(defruled ll-var-referred-ok-p-of-lifted-closure-nonlocal
  (implies (and (stringp v)
                (expr-valuep val)
                (not (member-equal v (var+type?-list->var (%ps))))
                (not (omap::assoc v (ll-context->lmap ctx)))
                (not (set::in v (ll-context->locals ctx)))
                (ll-var-types-ok-p v val ctx)
                (genv-agrees-with-init-p genv)
                (consp (%ps))
                (apply-leading-ok-p (%cps) (%ps) (%nb) (%ity) genv (%vs))
                (not (reserrp (%u))))
           (ll-var-referred-ok-p v val (%udenv) (expr-free-expr-vars (%nb))
                                 (%ictx) (%dw2) genv))
  :use ((:instance ll-lambda-parts-context-at-other
                   (params pa) (body ba) (type? ta))
        (:instance lookup-in-lifted-closure-env-other
                   (n v) (fv (%fve)) (tenv (ll-context->tenv (%ictx)))
                   (nd new-denv) (ps (%ps)) (nb (%nb)) (ity (%ity)))
        (:instance fve-facts
                   (a (expr-free-expr-vars (%nb)))
                   (b (set::mergesort (var+type?-list->var (%ps))))
                   (c (ll-context->locals (%ictx))))
        (:instance lookup-in-genv-when-agrees-with-init)
        (:instance expr-value-ll-related-p-of-ground))
  :enable (ll-var-referred-ok-p ll-var-types-ok-p omap::assoc-of-restrict
           ll-lambda-parts-locals not-reserrp-when-expr-valuep)
  :disable ((:e init-expr-denv)
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled ll-var-referred-ok-p-of-lifted-closure-hoisted
  (implies (and (stringp v)
                (not (member-equal v (var+type?-list->var (%ps))))
                (equal (cdr (omap::assoc v (ll-context->lmap ctx)))
                       (apply-to-names (expr-var h) hns))
                (omap::assoc v (ll-context->lmap ctx))
                (set::in v (ll-context->locals ctx))
                (stringp h)
                (stringp lam)
                (string-listp hns)
                (not (set::in h (ll-context->locals ctx)))
                (not (member-equal h (var+type?-list->var (%ps))))
                (not (reserrp (expr-denv-lookup-expr h genv)))
                (subsetp-equal hns (ll-context->locals ctx))
                (not (intersectp-equal hns (var+type?-list->var (%ps))))
                (ll-var-referred-ok-p v val new-denv (%nfvx) ctx dw genv)
                (consp (%ps))
                (not (reserrp (%vs)))
                (apply-leading-ok-p (%cps) (%ps) (%nb) (%ity) genv (%vs))
                (not (reserrp (%u))))
           (ll-var-referred-ok-p v val (%udenv) (expr-free-expr-vars (%nb))
                                 (%ictx) (%dw2) genv))
  :use ((:instance ll-lambda-parts-context-at-other
                   (params pa) (body ba) (type? ta))
        (:instance fve-facts
                   (a (expr-free-expr-vars (%nb)))
                   (b (set::mergesort (var+type?-list->var (%ps))))
                   (c (ll-context->locals (%ictx))))
        (:instance hoisted-replacement-sets
                   (pnames (var+type?-list->var (%ps)))
                   (locals (ll-context->locals ctx))
                   (nbfv (expr-free-expr-vars (%nb))))
        (:instance lookups-agree-p-of-lifted-closure-env
                   (fv (%fve)) (tenv (ll-context->tenv (%ictx)))
                   (nd new-denv) (ps (%ps)) (nb (%nb)) (ity (%ity)))
        (:instance lookups-agree-p-of-with-names-from-insert
                   (d1 (%udenv)) (d2 new-denv) (g genv))
        (:instance eval-expr-of-apply-to-names-when-agree
                   (names hns)
                   (d1 (expr-denv-with-names-from (set::insert h nil)
                                                  (%udenv) genv))
                   (d2 (expr-denv-with-names-from (set::insert h nil)
                                                  new-denv genv))
                   (l (ll-denv-witness->limit dw)))
        (:instance lookup-of-expr-denv-with-names-from
                   (n h) (names (set::insert h nil))
                   (d (%udenv)) (g genv))
        (:instance lookup-of-expr-denv-with-names-from
                   (n h) (names (set::insert h nil))
                   (d new-denv) (g genv))
        (:instance in-when-member-of-subsetp
                   (e h) (l hns) (s (ll-context->locals ctx))))
  :enable (ll-var-referred-ok-p omap::assoc-of-restrict
           ll-lambda-parts-locals)
  :expand ((:free (n) (expr-free-expr-vars (expr-var n))))
  :disable (set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv
            apply-to-names))



(defruled ll-replacement-ok-p-when-lmap-replacements-ok-p
  (implies (and (lmap-replacements-ok-p lmap locals pnames genv)
                (string-expr-mapp lmap)
                (omap::assoc k lmap))
           (ll-replacement-ok-p (cdr (omap::assoc k lmap)) locals pnames genv))
  :induct (lmap-replacements-ok-p lmap locals pnames genv)
  :enable (lmap-replacements-ok-p omap::assoc))

;; The replacement of a hoisted function is its definition's name applied to
;; its arguments, as REPLACEMENT-PARTS reads them off.

(defruled var-expr-names-correct
  (b* (((mv okp names) (var-expr-names es)))
    (implies okp
             (equal (names-to-exprs names) (expr-list-fix es))))
  :induct (len es)
  :enable (var-expr-names names-to-exprs len))

(defruled replacement-parts-correct
  (b* (((mv okp h hns) (replacement-parts repl)))
    (implies okp
             (equal (apply-to-names (expr-var h) hns)
                    (expr-fix repl))))
  :use ((:instance var-expr-names-correct (es (expr-appn->args repl))))
  :enable (replacement-parts apply-to-names var-expr-names)
  :expand ((var-expr-names (expr-appn->args repl))
           (var-expr-names (cdr (expr-appn->args repl)))))

(defrule ll-replacement-ok-p-unpack
  (implies (and (ll-replacement-ok-p repl locals pnames genv)
                (string-setp locals)
                (string-listp pnames)
                (exprp repl))
           (b* (((mv & h hns) (replacement-parts repl)))
             (and (stringp h)
                  (string-listp hns)
                  (equal repl (apply-to-names (expr-var h) hns))
                  (not (set::in h locals))
                  (not (member-equal h pnames))
                  (not (reserrp (expr-denv-lookup-expr h genv)))
                  (subsetp-equal hns locals)
                  (not (intersectp-equal hns pnames)))))
  :use replacement-parts-correct
  :enable ll-replacement-ok-p
  :rule-classes nil)

(defruled ll-var-ok-p-of-lifted-closure-combine
  (implies (and (ll-var-ok-p v val nd nfv ctx dw genv)
                (implies (and (not (omap::assoc v (ll-context->lmap ctx)))
                              (set::in v (ll-context->locals ctx))
                              (ll-var-referred-ok-p v val nd nfv ctx dw genv))
                         (ll-var-referred-ok-p v val nd2 nfv2 ctx2 dw2 genv))
                (implies (and (not (omap::assoc v (ll-context->lmap ctx)))
                              (not (set::in v (ll-context->locals ctx)))
                              (ll-var-types-ok-p v val ctx))
                         (ll-var-referred-ok-p v val nd2 nfv2 ctx2 dw2 genv))
                (implies (and (omap::assoc v (ll-context->lmap ctx))
                              (ll-var-referred-ok-p v val nd nfv ctx dw genv))
                         (ll-var-referred-ok-p v val nd2 nfv2 ctx2 dw2 genv))
                (implies (ll-var-types-ok-p v val ctx)
                         (ll-var-types-ok-p v val ctx2)))
           (ll-var-ok-p v val nd2 nfv2 ctx2 dw2 genv))
  :enable ll-var-ok-p-split
  :disable (ll-var-referred-ok-p ll-var-types-ok-p))

(defruled ll-var-referred-ok-p-of-lifted-closure-hoisted-lmap
  (implies (and (stringp v)
                (stringp lam)
                (not (member-equal v (var+type?-list->var (%ps))))
                (omap::assoc v (ll-context->lmap ctx))
                (ll-var-referred-ok-p v val new-denv (%nfvx) ctx dw genv)
                (set::subset (omap::keys (ll-context->lmap ctx))
                             (ll-context->locals ctx))
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        (var+type?-list->var (%ps))
                                        genv)
                (consp (%ps))
                (not (reserrp (%vs)))
                (apply-leading-ok-p (%cps) (%ps) (%nb) (%ity) genv (%vs))
                (not (reserrp (%u))))
           (ll-var-referred-ok-p v val (%udenv) (expr-free-expr-vars (%nb))
                                 (%ictx) (%dw2) genv))
  :use ((:instance ll-var-referred-ok-p-of-lifted-closure-hoisted
                   (h (mv-nth 1 (replacement-parts
                                 (cdr (omap::assoc v (ll-context->lmap ctx))))))
                   (hns (mv-nth 2 (replacement-parts
                                   (cdr (omap::assoc v
                                                     (ll-context->lmap
                                                      ctx)))))))
        (:instance ll-replacement-ok-p-unpack
                   (repl (cdr (omap::assoc v (ll-context->lmap ctx))))
                   (locals (ll-context->locals ctx))
                   (pnames (var+type?-list->var (%ps))))
        (:instance ll-replacement-ok-p-when-lmap-replacements-ok-p
                   (lmap (ll-context->lmap ctx)) (k v)
                   (locals (ll-context->locals ctx))
                   (pnames (var+type?-list->var (%ps))))
        (:instance omap::in-of-keys-to-assoc
                   (omap::key v) (omap::map (ll-context->lmap ctx)))
        (:instance set::subset-in
                   (a v) (x (omap::keys (ll-context->lmap ctx)))
                   (y (ll-context->locals ctx))))
  :disable (ll-var-referred-ok-p ll-var-ok-p))

(defruled ll-var-ok-p-of-lifted-closure
  (implies (and (stringp v)
                (stringp lam)
                (expr-valuep val)
                (not (member-equal v (var+type?-list->var (%ps))))
                (ll-var-ok-p v val new-denv (%nfvx) ctx dw genv)
                (genv-agrees-with-init-p genv)
                (set::subset (omap::keys (ll-context->lmap ctx))
                             (ll-context->locals ctx))
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        (var+type?-list->var (%ps))
                                        genv)
                (consp (%ps))
                (not (reserrp (%vs)))
                (apply-leading-ok-p (%cps) (%ps) (%nb) (%ity) genv (%vs))
                (not (reserrp (%u))))
           (ll-var-ok-p v val (%udenv) (expr-free-expr-vars (%nb))
                        (%ictx) (%dw2) genv))
  :use ((:instance ll-var-ok-p-of-lifted-closure-combine
                   (nd new-denv) (nfv (%nfvx))
                   (nd2 (%udenv)) (nfv2 (expr-free-expr-vars (%nb)))
                   (ctx2 (%ictx)) (dw2 (%dw2)))
        (:instance ll-var-types-ok-p-of-ll-lambda-parts
                   (params pa) (body ba) (type? ta))
        ll-var-referred-ok-p-of-lifted-closure-local
        ll-var-referred-ok-p-of-lifted-closure-nonlocal
        ll-var-referred-ok-p-of-lifted-closure-hoisted-lmap)
  :in-theory (theory 'minimal-theory))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The environments of the original closure and of the lifted one are
; related at the innermost body: the type environments are both empty, the
; lambda being closed; the variables are related one by one; and the
; definitions and primitive operations are bound as at the top.

(defruled type-denv-restrict-of-empty
  (implies (and (set::emptyp ivars) (set::emptyp tvars))
           (equal (type-denv-restrict ivars tvars d)
                  (type-denv (ispace-denv nil) nil)))
  :enable (type-denv-restrict ispace-denv-restrict
           ispace-var-set-fix type-var-set-fix))

(local
 (defun set-ind (s)
   (if (set::emptyp s) nil (set-ind (set::tail s)))))

(defruled names-bound-as-in-p-of-lifted-closure-env
  (b* ((cps (names-to-params fv tenv))
       (vs (expr-denv-lookup-exprs fv nd))
       (u (lambda-closure ps nb ity
                          (apply-leading-env cps ps nb ity genv vs))))
    (implies (and (string-setp s)
                  (set::subset s (set::difference (expr-free-expr-vars nb) l))
                  (set::setp l)
                  (set::subset fv l)
                  (subsetp-equal (var+type?-list->var ps) l)
                  (string-setp fv)
                  (consp ps)
                  (apply-leading-ok-p cps ps nb ity genv vs)
                  (not (reserrp u)))
             (names-bound-as-in-p s (expr-value-lambda->denv u) genv)))
  :induct (set-ind s)
  :enable (names-bound-as-in-p subset-of-tail-when-subset)
  :hints (("Subgoal *1/2"
           :use ((:instance lookup-in-lifted-closure-env-other
                            (n (set::head s)))
                 (:instance set::subset-in (a (set::head s)) (x s)
                            (y (set::difference (expr-free-expr-vars nb) l)))
                 (:instance set::subset-in (a (set::head s)) (x fv) (y l))
                 (:instance in-when-member-of-subsetp
                            (e (set::head s))
                            (l (var+type?-list->var ps)) (s l))))))

(defruled stringp-when-assoc-of-string-expr-value-mapp
  (implies (and (string-expr-value-mapp m)
                (omap::assoc k m))
           (stringp k))
  :induct (ll-map-ind m)
  :enable (omap::assoc))

(defmacro %lifted-env-hyps ()
  '(and (string-expr-value-map-ll-related-p
         new-denv (expr-denv->exprs denv) fvx (%nfvx) ctx dw genv)
        (new-values-meet-types-p (set::intersect (%nfvx)
                                                 (ll-context->locals ctx))
                                 new-denv (ll-context->tenv ctx))
        (set::subset (set::intersect
                      (set::difference (expr-free-expr-vars (mv-nth 1 (%lp)))
                                       (set::mergesort
                                        (var+type?-list->var (%ps))))
                      (string-sfix fvv))
                     fvx)
        (stringp lam)
        (genv-agrees-with-init-p genv)
        (set::subset (omap::keys (ll-context->lmap ctx))
                     (ll-context->locals ctx))
        (lmap-replacements-ok-p (ll-context->lmap ctx)
                                (ll-context->locals ctx)
                                (var+type?-list->var (%ps))
                                genv)
        (consp (%ps))
        (not (reserrp (%vs)))
        (apply-leading-ok-p (%cps) (%ps) (%nb) (%ity) genv (%vs))
        (not (reserrp (%u)))))

(defmacro %fvin ()
  '(set::difference (expr-free-expr-vars (mv-nth 1 (%lp)))
                    (set::mergesort (var+type?-list->var (%ps)))))

(defmacro %vmap () '(omap::restrict (string-sfix fvv) (expr-denv->exprs denv)))

(defruled walker-of-lifted-closure-env-at
  (implies (and (%lifted-env-hyps)
                (omap::assoc w (%vmap))
                (set::in w (%fvin)))
           (ll-var-ok-p w (cdr (omap::assoc w (%vmap)))
                        (%udenv) (expr-free-expr-vars (%nb))
                        (%ictx) (%dw2) genv))
  :use ((:instance walker-ll-var-ok-p-at
                   (map (expr-denv->exprs denv))
                   (fv fvx) (nfv (%nfvx)) (var w))
        (:instance ll-var-ok-p-of-lifted-closure
                   (v w) (val (cdr (omap::assoc w (expr-denv->exprs denv)))))
        (:instance stringp-when-assoc-of-string-expr-value-mapp
                   (m (expr-denv->exprs denv)) (k w))
        (:instance set::subset-in
                   (a w) (x (set::intersect (%fvin) (string-sfix fvv)))
                   (y fvx))
        (:instance assoc-of-restrict-when-assoc
                   (s (string-sfix fvv)) (m (expr-denv->exprs denv))))
  :disable (ll-var-ok-p-of-lifted-closure ll-var-ok-p omap::assoc-of-restrict))

(defruled walker-of-lifted-closure-env
  (implies (%lifted-env-hyps)
           (string-expr-value-map-ll-related-p
            (%udenv) (%vmap) (%fvin) (expr-free-expr-vars (%nb))
            (%ictx) (%dw2) genv))
  :use ((:instance string-expr-value-map-ll-related-p-when-pointwise
                   (new-denv (%udenv)) (map (%vmap)) (fv (%fvin))
                   (nfv (expr-free-expr-vars (%nb)))
                   (ctx (%ictx)) (dw (%dw2)))
        (:instance walker-of-lifted-closure-env-at
                   (w (walker-pointwise-p-witness
                       (%udenv) (%vmap) (%fvin) (expr-free-expr-vars (%nb))
                       (%ictx) (%dw2) genv))))
  :expand ((walker-pointwise-p (%udenv) (%vmap) (%fvin)
                               (expr-free-expr-vars (%nb))
                               (%ictx) (%dw2) genv))
  :disable (ll-var-ok-p walker-pointwise-p-necc))

; The captured variables have the values they have where the lambda was,
; which meet the requirements of their types; the parameters are not bound.

(defruled meets-type-in-lifted-closure-env-at
  (implies (and (stringp n)
                (set::in n (expr-free-expr-vars (%nb)))
                (set::in n (ll-context->locals (%ictx)))
                (not (member-equal n (var+type?-list->var (%ps))))
                (new-values-meet-types-p (set::intersect
                                          (%nfvx) (ll-context->locals ctx))
                                         new-denv (ll-context->tenv ctx))
                (stringp lam)
                (consp (%ps))
                (not (reserrp (%vs)))
                (apply-leading-ok-p (%cps) (%ps) (%nb) (%ity) genv (%vs))
                (not (reserrp (%u))))
           (and (not (reserrp (expr-denv-lookup-expr n (%udenv))))
                (value-meets-required-type-p (expr-denv-lookup-expr n (%udenv))
                                             n (ll-context->tenv (%ictx)))))
  :use ((:instance lookup-in-lifted-closure-env-captured
                   (fv (%fve)) (tenv (ll-context->tenv (%ictx)))
                   (nd new-denv) (ps (%ps)) (nb (%nb)) (ity (%ity)))
        (:instance fve-facts
                   (a (expr-free-expr-vars (%nb)))
                   (b (set::mergesort (var+type?-list->var (%ps))))
                   (c (ll-context->locals (%ictx))))
        (:instance new-values-meet-types-p-when-in
                   (names (set::intersect (%nfvx) (ll-context->locals ctx)))
                   (name n) (tenv (ll-context->tenv ctx)))
        (:instance ll-lambda-parts-context-at-other
                   (params pa) (body ba) (type? ta) (v n))
        (:instance value-type-conditions-when-same-type-option
                   (v n)
                   (val (expr-denv-lookup-expr n new-denv))
                   (tenv1 (ll-context->tenv ctx))
                   (tenv2 (ll-context->tenv (%ictx))))
        (:instance ll-lambda-parts-locals (params pa) (body ba) (type? ta)))
  :disable (lambda-closure ll-lambda-parts
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled new-values-meet-types-p-of-lifted-closure-env
  (implies (and (string-setp s)
                (set::subset s (set::difference
                                (set::intersect (expr-free-expr-vars (%nb))
                                                (ll-context->locals (%ictx)))
                                (set::mergesort (var+type?-list->var (%ps)))))
                (new-values-meet-types-p (set::intersect
                                          (%nfvx) (ll-context->locals ctx))
                                         new-denv (ll-context->tenv ctx))
                (stringp lam)
                (consp (%ps))
                (not (reserrp (%vs)))
                (apply-leading-ok-p (%cps) (%ps) (%nb) (%ity) genv (%vs))
                (not (reserrp (%u))))
           (new-values-meet-types-p s (%udenv) (ll-context->tenv (%ictx))))
  :induct (set-ind s)
  :enable (new-values-meet-types-p subset-of-tail-when-subset)
  :hints (("Subgoal *1/2"
           :use ((:instance set::subset-in (a (set::head s)) (x s)
                            (y (set::difference
                                (set::intersect (expr-free-expr-vars (%nb))
                                                (ll-context->locals (%ictx)))
                                (set::mergesort (var+type?-list->var (%ps))))))
                 (:instance meets-type-in-lifted-closure-env-at
                            (n (set::head s))))
           :in-theory (disable lambda-closure ll-lambda-parts
                               value-meets-required-type-p))))

(defruled subsetp-of-params-in-ll-lambda-parts-locals
  (subsetp-equal (var+type?-list->var (%ps))
                 (ll-context->locals (%ictx)))
  :enable ll-lambda-parts-locals
  :use ((:instance set::in-to-member
                   (a (acl2::subsetp-witness
                       (var+type?-list->var (%ps))
                       (ll-context->locals (%ictx))))
                   (x (ll-context->locals (%ictx))))))

(defruled closure-env-related-of-lifted
  (b* ((fvv (atom-free-expr-vars (make-atom-lambda/lambdan pa ba ta))))
    (implies (and (%lifted-env-hyps)
                  (consp pa)
                  (not (reserrp (lambda-closure pa ba ta denv)))
                  (set::emptyp (expr-free-ispace-vars
                                (lambda-curried-body pa ba ta)))
                  (set::emptyp (expr-free-type-vars
                                (lambda-curried-body pa ba ta)))
                  (set::emptyp (expr-free-ispace-vars
                                (lambda-curried-body (%ps) (%nb) (%ity))))
                  (set::emptyp (expr-free-type-vars
                                (lambda-curried-body (%ps) (%nb) (%ity)))))
             (expr-denv-ll-related-p (%udenv)
                                     (expr-value-lambda->denv
                                      (lambda-closure pa ba ta denv))
                                     (mv-nth 1 (%lp))
                                     (%ictx)
                                     (var+type?-list->var (%ps))
                                     (%dw2)
                                     genv)))
  :use ((:instance walker-of-lifted-closure-env
                   (fvv (atom-free-expr-vars
                         (make-atom-lambda/lambdan pa ba ta))))
        subsetp-of-params-in-ll-lambda-parts-locals
        (:instance expr-value-lambda->denv-of-lambda-closure
                   (params pa) (body ba) (type? ta))
        (:instance expr-value-lambda->denv-of-lambda-closure
                   (params (%ps)) (body (%nb)) (type? (%ity))
                   (denv (apply-leading-env (%cps) (%ps) (%nb) (%ity) genv
                                            (%vs))))
        (:instance names-bound-as-in-p-of-lifted-closure-env
                   (s (set::difference (expr-free-expr-vars (%nb))
                                       (ll-context->locals (%ictx))))
                   (l (ll-context->locals (%ictx)))
                   (fv (%fve)) (tenv (ll-context->tenv (%ictx)))
                   (nd new-denv) (ps (%ps)) (nb (%nb)) (ity (%ity)))
        (:instance fve-facts
                   (a (expr-free-expr-vars (%nb)))
                   (b (set::mergesort (var+type?-list->var (%ps))))
                   (c (ll-context->locals (%ictx))))
        (:instance new-values-meet-types-p-of-lifted-closure-env
                   (s (set::difference
                       (set::intersect (expr-free-expr-vars (%nb))
                                       (ll-context->locals (%ictx)))
                       (set::mergesort (var+type?-list->var (%ps)))))))
  :expand ((:free (dw2)
                  (expr-denv-ll-related-p (%udenv)
                                          (expr-value-lambda->denv
                                           (lambda-closure pa ba ta denv))
                                          (mv-nth 1 (%lp))
                                          (%ictx)
                                          (var+type?-list->var (%ps))
                                          dw2
                                          genv)))
  :enable (type-denv-restrict-of-empty expr-denv-restrict)
  :disable (walker-of-lifted-closure-env
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The closure that the reference to a lifted definition evaluates to is
; related to the original closure, via the context at the innermost body.

(defruled param-type-consistent-p-of-ll-lambda-parts
  (b* (((mv ps & & ictx) (ll-lambda-parts params body type? ctx)))
    (implies (and (no-duplicatesp-equal (var+type?-list->var ps))
                  (consp ps)
                  (set::emptyp (var+type?-free-type-vars (car ps)))
                  (set::emptyp (var+type?-free-ispace-vars (car ps)))
                  (not (reserrp (eval-var+type? (car ps) tenv))))
             (param-type-consistent-p (eval-var+type? (car ps) tenv)
                                      (ll-context->tenv ictx))))
  :use ((:instance name-to-type-option-in-ll-lambda-parts-context
                   (p (car (mv-nth 0 (ll-lambda-parts params body type?
                                                      ctx))))))
  :enable (param-type-consistent-p var-required-type eval-var+type?
           var+type?->type-or-err eval-type-when-closed type-closed-p
           type-valuep-when-result-not-error)
  :expand ((var+type?-free-type-vars
            (car (mv-nth 0 (ll-lambda-parts params body type? ctx))))
           (var+type?-free-ispace-vars
            (car (mv-nth 0 (ll-lambda-parts params body type? ctx))))
           (:free (ty) (type-option-free-type-vars ty))
           (:free (ty) (type-option-free-ispace-vars ty))))

(defrule eval-type-non-nil-when-ok
  (implies (not (reserrp (eval-type ty d)))
           (eval-type ty d))
  :use (:instance type-valuep-when-result-not-error (x (eval-type ty d)))
  :disable type-valuep-when-result-not-error)

(defruled type?-of-lambda-closure-single
  (implies (and (consp params)
                (not (consp (cdr params)))
                (type-optionp type?)
                (not (reserrp (lambda-closure params body type? denv))))
           (and (equal (expr-value-lambda->type?
                        (lambda-closure params body type? denv))
                       (if (type-option-case type? :some)
                           (eval-type (type-option-some->val type?)
                                      (expr-denv->tenv denv))
                         nil))
                (implies (type-option-case type? :some)
                         (not (reserrp (eval-type (type-option-some->val type?)
                                                  (expr-denv->tenv denv)))))))
  :enable (lambda-closure make-atom-lambda/lambdan
           type-valuep-when-result-not-error)
  :expand ((:free (a l) (eval-atom a denv l))))

(defruled type?-of-lambda-closure-multi
  (implies (and (consp params)
                (consp (cdr params))
                (not (reserrp (lambda-closure params body type? denv))))
           (equal (expr-value-lambda->type?
                   (lambda-closure params body type? denv))
                  nil))
  :enable (lambda-closure make-atom-lambda/lambdan)
  :expand ((:free (a l) (eval-atom a denv l))))

(defruled type?-of-lambda-closure-iff
  (implies (and (consp params)
                (type-optionp type?)
                (not (reserrp (lambda-closure params body type? denv))))
           (iff
            (expr-value-lambda->type? (lambda-closure params body type? denv))
                (and (endp (cdr params))
                     (type-option-case type? :some))))
  :use (type?-of-lambda-closure-single type?-of-lambda-closure-multi
        (:instance eval-type-non-nil-when-ok
                   (ty (type-option-some->val type?))
                   (d (expr-denv->tenv denv))))
  :disable (lambda-closure))


(defruled param-of-lambda-closure
  (implies (and (consp params)
                (not (reserrp (lambda-closure params body type? denv))))
           (equal (expr-value-lambda->param
                   (lambda-closure params body type? denv))
                  (var+typevalue-fix
                   (eval-var+type? (car params) (expr-denv->tenv denv)))))
  :enable (lambda-closure make-atom-lambda/lambdan
           consp-when-positive-len positive-len-when-consp)
  :cases ((consp (cdr params)))
  :expand ((:free (a l) (eval-atom a denv l))))

; Opening the relation at a lambda witness, as a conjunction.

(defruled expr-value-ll-related-p-of-lambda-witness
  (implies (and (equal (expr-value-kind val) :lambda)
                (equal (expr-value-kind new-val) :lambda)
                (var+type?-listp prest)
                (booleanp flat)
                (ll-context-p ctx)
                (ll-denv-witness-p dw))
           (equal (expr-value-ll-related-p
                   new-val val (ll-value-witness-lambda ctx prest flat dw) genv)
                  (b* (((mv okp inner inner-type?)
                        (closure-body-parts (expr-value-lambda->body val)
                                            (expr-value-lambda->type? val)
                                            prest flat))
                       (pnames (cons (var+typevalue->var
                                      (expr-value-lambda->param val))
                                     (var+type?-list->var prest))))
                    (and okp
                         (equal (expr-value-lambda->param new-val)
                                (expr-value-lambda->param val))
                         (equal (expr-value-lambda->type? new-val)
                                (expr-value-lambda->type? val))
                         (equal (expr-value-lambda->body new-val)
                                (lifted-closure-body
                                 prest
                                 (ll-context-new-expr inner ctx)
                                 inner-type?))
                         (no-duplicatesp-equal pnames)
                         (names-in-context-p pnames ctx)
                         (lmap-replacements-ok-p (ll-context->lmap ctx)
                                                 (ll-context->locals ctx)
                                                 pnames genv)
                         (param-type-consistent-p
                          (expr-value-lambda->param val)
                          (ll-context->tenv ctx))
                         (prest-tenv-consistent-p prest (ll-context->tenv ctx))
                         (ll-context-ok-p inner ctx genv)
                         (expr-denv-ll-related-p
                          (expr-value-lambda->denv new-val)
                          (expr-value-lambda->denv val)
                          inner ctx pnames dw genv)))))
  :expand ((expr-value-ll-related-p
            new-val val (ll-value-witness-lambda ctx prest flat dw) genv)))

(defmacro %v () '(lambda-closure pa ba ta denv))
(defmacro %pn () '(cons (var+typevalue->var (expr-value-lambda->param (%v)))
                        (var+type?-list->var (cdr (%ps)))))

(defmacro %closure-hyps ()
  '(and (%lifted-env-hyps)
        (equal fvv (atom-free-expr-vars (make-atom-lambda/lambdan pa ba ta)))
        (var+type?-listp pa)
        (consp pa)
        (exprp ba)
        (type-optionp ta)
        (not (reserrp (%v)))
        (set::emptyp (var+type?-free-type-vars (car pa)))
        (set::emptyp (var+type?-free-ispace-vars (car pa)))
        (set::emptyp (type-option-free-type-vars ta))
        (set::emptyp (type-option-free-ispace-vars ta))
        (implies (mv-nth 0 (nested-lambda ba))
                 (consp (mv-nth 1 (nested-lambda ba))))
        (set::emptyp (expr-free-ispace-vars (lambda-curried-body pa ba ta)))
        (set::emptyp (expr-free-type-vars (lambda-curried-body pa ba ta)))
        (set::emptyp (expr-free-ispace-vars
                      (lambda-curried-body (%ps) (%nb) (%ity))))
        (set::emptyp (expr-free-type-vars
                      (lambda-curried-body (%ps) (%nb) (%ity))))
        (no-duplicatesp-equal (var+type?-list->var (%ps)))))

(defruled lifted-closure-ps
  (implies (%closure-hyps)
           (equal (%ps)
                  (append pa (mv-nth 0 (lambda-chain ba ta)))))
  :use ((:instance ll-lambda-parts-is-lambda-chain
                   (params pa) (body ba) (type? ta))))

(defruled lifted-closure-pnames
  (implies (%closure-hyps)
           (equal (%pn) (var+type?-list->var (%ps))))
  :use (lifted-closure-ps
        (:instance lambda-closure-when-ok (params pa) (body ba) (type? ta)))
  :expand ((var+type?-list->var (append pa (mv-nth 0 (lambda-chain ba ta)))))
  :disable (lambda-closure ll-lambda-parts))

(defruled lifted-closure-fact-kinds
  (implies (%closure-hyps)
           (and (equal (expr-value-kind (%u)) :lambda)
                (equal (expr-value-kind (%v)) :lambda)))
  :use ((:instance expr-value-kind-of-lambda-closure
                   (params pa) (body ba) (type? ta))
        (:instance expr-value-kind-of-lambda-closure
                   (params (%ps)) (body (%nb)) (type? (%ity))
                   (denv (apply-leading-env (%cps) (%ps) (%nb) (%ity) genv
                                            (%vs)))))
  :disable (lambda-closure ll-lambda-parts))

(defruled lifted-closure-fact-body
  (implies (%closure-hyps)
           (b* (((mv okp inner ity2)
                 (closure-body-parts (expr-value-lambda->body (%v))
                                     (expr-value-lambda->type? (%v))
                                     (cdr (%ps)) t)))
             (and okp
                  (equal inner (mv-nth 1 (%lp)))
                  (equal (lifted-closure-body (cdr (%ps))
                                              (ll-context-new-expr inner
                                                                   (%ictx))
                                              ity2)
                         (expr-value-lambda->body (%u))))))
  :use (lifted-closure-ps
        (:instance ll-lambda-parts-is-lambda-chain
                   (params pa) (body ba) (type? ta))
        (:instance closure-body-parts-of-lambda-curried-body
                   (params pa) (body ba) (type? ta)
                   (tyv (expr-value-lambda->type? (%v)))
                   (new-inner (%nb)))
        (:instance type?-of-lambda-closure-iff
                   (params pa) (body ba) (type? ta))
        (:instance lambda-closure-when-ok (params pa) (body ba) (type? ta))
        (:instance lambda-closure-when-ok
                   (params (%ps)) (body (%nb)) (type? (%ity))
                   (denv (apply-leading-env (%cps) (%ps) (%nb) (%ity) genv
                                            (%vs)))))
  :disable (lambda-closure ll-lambda-parts closure-body-parts
            lifted-closure-body lambda-curried-body ll-context-new-expr))

(defruled lifted-closure-fact-fields
  (implies (%closure-hyps)
           (and (equal (expr-value-lambda->param (%u))
                       (expr-value-lambda->param (%v)))
                (equal (expr-value-lambda->type? (%u))
                       (expr-value-lambda->type? (%v)))))
  :use (lifted-closure-ps
        (:instance ll-lambda-parts-is-lambda-chain
                   (params pa) (body ba) (type? ta))
        (:instance lambda-closure-fields-of-chain
                   (params pa) (body ba) (type? ta)
                   (new-body (%nb))
                   (new-denv (apply-leading-env (%cps) (%ps) (%nb) (%ity)
                                                genv (%vs)))))
  :disable (lambda-closure ll-lambda-parts))


(defrule param-type-consistent-p-of-var+typevalue-fix
  (equal (param-type-consistent-p (var+typevalue-fix p) tenv)
         (param-type-consistent-p p tenv))
  :enable param-type-consistent-p)

(defruled eval-var+type?-ok-when-lambda-closure-ok
  (implies (and (consp params)
                (not (reserrp (lambda-closure params body type? denv))))
           (not (reserrp (eval-var+type? (car params) (expr-denv->tenv denv)))))
  :enable (lambda-closure make-atom-lambda/lambdan
           consp-when-positive-len positive-len-when-consp)
  :cases ((consp (cdr params)))
  :expand ((:free (a l) (eval-atom a denv l))))

(defruled lifted-closure-fact-context
  (implies (%closure-hyps)
           (and (names-in-context-p (%pn) (%ictx))
                (param-type-consistent-p (expr-value-lambda->param (%v))
                                         (ll-context->tenv (%ictx)))
                (prest-tenv-consistent-p (cdr (%ps))
                                         (ll-context->tenv (%ictx)))))
  :use (lifted-closure-pnames
        lifted-closure-ps
        (:instance names-in-context-p-of-ll-lambda-parts
                   (params pa) (body ba) (type? ta)
                   (names (var+type?-list->var (%ps))))
        (:instance param-of-lambda-closure (params pa) (body ba) (type? ta))
        (:instance eval-var+type?-ok-when-lambda-closure-ok
                   (params pa) (body ba) (type? ta))
        (:instance param-type-consistent-p-of-ll-lambda-parts
                   (params pa) (body ba) (type? ta)
                   (tenv (expr-denv->tenv denv)))
        (:instance prest-tenv-consistent-p-of-ll-lambda-parts
                   (params pa) (body ba) (type? ta)
                   (l (cdr (%ps)))))
  :disable (lambda-closure ll-lambda-parts names-in-context-p
            param-type-consistent-p prest-tenv-consistent-p))

(defruled lifted-closure-fact-env
  (implies (%closure-hyps)
           (expr-denv-ll-related-p (expr-value-lambda->denv (%u))
                                   (expr-value-lambda->denv (%v))
                                   (mv-nth 1 (%lp)) (%ictx) (%pn) (%dw2) genv))
  :use (lifted-closure-pnames closure-env-related-of-lifted)
  :disable (lambda-closure ll-lambda-parts expr-denv-ll-related-p))

(defruled expr-value-ll-related-p-of-flat-witness-intro
  (implies (and (equal (expr-value-kind val) :lambda)
                (equal (expr-value-kind new-val) :lambda)
                (var+type?-listp prest)
                (ll-context-p ctx)
                (ll-denv-witness-p dw)
                (mv-nth 0 (closure-body-parts (expr-value-lambda->body val)
                                              (expr-value-lambda->type? val)
                                              prest t))
                (equal (mv-nth 1 (closure-body-parts
                                  (expr-value-lambda->body val)
                                  (expr-value-lambda->type? val)
                                  prest t))
                       inner)
                (equal (expr-value-lambda->body new-val)
                       (lifted-closure-body
                        prest
                        (ll-context-new-expr inner ctx)
                        (mv-nth 2 (closure-body-parts
                                   (expr-value-lambda->body val)
                                   (expr-value-lambda->type? val)
                                   prest t))))
                (equal (expr-value-lambda->param new-val)
                       (expr-value-lambda->param val))
                (equal (expr-value-lambda->type? new-val)
                       (expr-value-lambda->type? val))
                (equal (cons (var+typevalue->var
                              (expr-value-lambda->param val))
                             (var+type?-list->var prest))
                       pnames)
                (no-duplicatesp-equal pnames)
                (names-in-context-p pnames ctx)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        pnames genv)
                (param-type-consistent-p (expr-value-lambda->param val)
                                         (ll-context->tenv ctx))
                (prest-tenv-consistent-p prest (ll-context->tenv ctx))
                (ll-context-ok-p inner ctx genv)
                (expr-denv-ll-related-p (expr-value-lambda->denv new-val)
                                        (expr-value-lambda->denv val)
                                        inner ctx pnames dw genv))
           (expr-value-ll-related-p
            new-val val (ll-value-witness-lambda ctx prest t dw) genv))
  :use (:instance expr-value-ll-related-p-of-lambda-witness (flat t))
  :disable (ll-context-ok-p expr-denv-ll-related-p closure-body-parts
            names-in-context-p lmap-replacements-ok-p param-type-consistent-p
            prest-tenv-consistent-p lifted-closure-body expr-value-ll-related-p
            ll-context-new-expr))

(defruled expr-value-ll-related-p-of-lifted-closure
  (implies (and (%closure-hyps)
                (ll-context-ok-p (mv-nth 1 (%lp)) (%ictx) genv)
                (lmap-replacements-ok-p (ll-context->lmap (%ictx))
                                        (ll-context->locals (%ictx))
                                        (var+type?-list->var (%ps))
                                        genv))
           (expr-value-ll-related-p
            (%u) (%v)
            (ll-value-witness-lambda (%ictx) (cdr (%ps)) t (%dw2))
            genv))
  :use (lifted-closure-fact-kinds
        lifted-closure-fact-body
        lifted-closure-fact-fields
        lifted-closure-fact-context
        lifted-closure-fact-env
        lifted-closure-pnames
        (:instance expr-value-ll-related-p-of-flat-witness-intro
                   (new-val (%u)) (val (%v)) (ctx (%ictx))
                   (prest (cdr (%ps))) (dw (%dw2)) (inner (mv-nth 1 (%lp)))
                   (pnames (var+type?-list->var (%ps)))))
  :in-theory (union-theories
              (theory 'minimal-theory)
              '(ll-context-p-of-ll-lambda-parts.inner-ctx
                ll-denv-witness-p-of-ll-denv-witness
                var+type?-listp-of-cdr-when-var+type?-listp
                var+type?-listp-of-ll-lambda-parts.all-params)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Each step of the application of a lifted definition to the captured values
; succeeds: the parameter types are closed and evaluate, as the transform
; checked, and the captured values, bound where the lambda was, have the
; shapes of their types.

(defmacro %empty-tenv () '(type-denv (ispace-denv nil) nil))

(defruled lambda-closure-ok-when-evaluable
  (implies (and (consp params)
                (param-evaluable-p (car params))
                (set::emptyp (var+type?-free-type-vars (car params)))
                (set::emptyp (var+type?-free-ispace-vars (car params)))
                (implies (endp (cdr params))
                         (and (type-option-evaluable-p type?)
                              (set::emptyp (type-option-free-type-vars type?))
                              (set::emptyp
                               (type-option-free-ispace-vars type?)))))
           (not (reserrp (lambda-closure params body type? denv))))
  :enable (lambda-closure make-atom-lambda/lambdan eval-var+type?
           var+type?->type-or-err param-evaluable-p type-evaluable-p
           type-option-evaluable-p eval-type-when-closed not-reserrp-when-typep
           not-reserrp-when-var+typevalue-p not-reserrp-when-expr-valuep
           consp-when-positive-len positive-len-when-consp)
  :cases ((consp (cdr params)))
  :expand ((:free (a l) (eval-atom a denv l))
           (var+type?-free-type-vars (car params))
           (var+type?-free-ispace-vars (car params))
           (:free (ty) (type-option-free-type-vars ty))
           (:free (ty) (type-option-free-ispace-vars ty))))

(defruled param-type-of-lambda-closure-when-closed
  (implies (and (consp params)
                (not (reserrp (lambda-closure params body type? denv)))
                (set::emptyp (var+type?-free-type-vars (car params)))
                (set::emptyp (var+type?-free-ispace-vars (car params))))
           (equal (var+typevalue->type
                   (expr-value-lambda->param
                    (lambda-closure params body type? denv)))
                  (eval-type (type-option-some->val
                              (var+type?->type? (car params)))
                             (%empty-tenv))))
  :use (param-of-lambda-closure eval-var+type?-ok-when-lambda-closure-ok)
  :enable (eval-var+type? var+type?->type-or-err eval-type-when-closed
           type-valuep-when-result-not-error)
  :expand ((var+type?-free-type-vars (car params))
           (var+type?-free-ispace-vars (car params))
           (:free (ty) (type-option-free-type-vars ty))
           (:free (ty) (type-option-free-ispace-vars ty)))
  :disable lambda-closure)

(define captured-values-ok-p ((fv string-listp)
                              (tenv string-type-mapp)
                              (nd expr-denvp))
  :returns (yes/no booleanp)
  :verify-guards nil
  (or (endp fv)
      (b* ((c (car fv))
           (ty? (name-to-type-option c tenv))
           (v (expr-denv-lookup-expr c nd)))
        (and (type-option-case ty? :some)
             (type-evaluable-p (type-option-some->val ty?))
             (set::emptyp (type-free-type-vars (type-option-some->val ty?)))
             (set::emptyp (type-free-ispace-vars (type-option-some->val ty?)))
             (not (reserrp v))
             (expr-value-wfp v)
             (expr-values-match-type-values-p
              (list v)
              (list (eval-type (type-option-some->val ty?) (%empty-tenv))))
             (captured-values-ok-p (cdr fv) tenv nd)))))

(defruled lookup-exprs-ok-when-captured-values-ok-p
  (implies (captured-values-ok-p fv tenv nd)
           (not (reserrp (expr-denv-lookup-exprs fv nd))))
  :induct (len fv)
  :enable (captured-values-ok-p expr-denv-lookup-exprs len
           expr-valuep-when-result-not-error
           expr-value-listp-when-result-not-error
           not-reserrp-when-expr-value-listp))

(local
 (defun alo-ind (fv tenv ps nb ity e nd)
  (if (endp fv)
      (list tenv ps nb ity e nd)
    (alo-ind (cdr fv) tenv ps nb ity
             (expr-denv-add-expr
              (str-fix (car fv))
              (expr-denv-lookup-expr (car fv) nd)
              (expr-value-lambda->denv
               (lambda-closure (append (names-to-params fv tenv) ps) nb ity e)))
             nd))))

(defruled apply-leading-ok-p-of-captured
  (implies (and (captured-values-ok-p fv tenv nd)
                (string-listp fv)
                (consp ps)
                (param-evaluable-p (car ps))
                (set::emptyp (var+type?-free-type-vars (car ps)))
                (set::emptyp (var+type?-free-ispace-vars (car ps)))
                (implies (endp (cdr ps))
                         (and (type-option-evaluable-p ity)
                              (set::emptyp (type-option-free-type-vars ity))
                              (set::emptyp
                               (type-option-free-ispace-vars ity)))))
           (apply-leading-ok-p (names-to-params fv tenv) ps nb ity e
                               (expr-denv-lookup-exprs fv nd)))
  :induct (alo-ind fv tenv ps nb ity e nd)
  :enable (captured-values-ok-p apply-leading-ok-p names-to-params
           expr-denv-lookup-exprs)
  :hints (("Subgoal *1/2"
           :use ((:instance lambda-closure-ok-when-evaluable
                            (params (append (names-to-params fv tenv) ps))
                            (body nb) (type? ity) (denv e))
                 (:instance param-type-of-lambda-closure-when-closed
                            (params (append (names-to-params fv tenv) ps))
                            (body nb) (type? ity) (denv e)))
           :in-theory (e/d (captured-values-ok-p apply-leading-ok-p
                            names-to-params expr-denv-lookup-exprs
                            param-evaluable-p
                            var+type?-free-type-vars var+type?-free-ispace-vars
                            type-option-free-type-vars
                            type-option-free-ispace-vars
                            expr-valuep-when-result-not-error
                            lookup-exprs-ok-when-captured-values-ok-p)
                           (lambda-closure)))
          ("Subgoal *1/1"
           :use ((:instance lambda-closure-ok-when-evaluable
                            (params ps) (body nb) (type? ity) (denv e))))))

(define tenvs-agree-on-p ((names string-listp)
                          (tenv1 string-type-mapp)
                          (tenv2 string-type-mapp))
  :returns (yes/no booleanp)
  :verify-guards nil
  (or (endp names)
      (and (equal (name-to-type-option (car names) tenv1)
                  (name-to-type-option (car names) tenv2))
           (tenvs-agree-on-p (cdr names) tenv1 tenv2))))

(defruled string-setp-of-cdr-when-string-setp
  (implies (string-setp x)
           (string-setp (cdr x)))
  :use ((:instance car-cdr-of-nonempty-setp)
        (:instance acl2::string-setp-of-tail-when-string-setp (acl2::x x)))
  :cases ((set::emptyp x))
  :enable (set::emptyp))

(defrule consp-of-eval-type
  (consp (eval-type ty d))
  :rule-classes :type-prescription
  :use (:instance type-valuep-when-result-not-error (x (eval-type ty d)))
  :enable (fty::reserrp))

(defruled captured-values-ok-p-when-checked
  (implies (and (string-setp fv)
                (captured-params-typed-p fv tenv2)
                (new-values-meet-types-p names nd tenv)
                (set::subset fv names)
                (tenvs-agree-on-p fv tenv tenv2)
                (expr-denv-wfp nd))
           (captured-values-ok-p fv tenv2 nd))
  :induct (len fv)
  :enable (captured-values-ok-p tenvs-agree-on-p len)
  :hints (("Subgoal *1/1"
           :use ((:instance car-cdr-of-nonempty-setp (x fv))
                 (:instance string-setp-of-cdr-when-string-setp (x fv))
                 (:instance new-values-meet-types-p-when-in-subset
                            (s fv) (name (car fv)) (new-denv nd))
                 (:instance set::in-head (x fv)))
           :expand ((captured-params-typed-p fv tenv2))
           :in-theory (e/d (captured-values-ok-p tenvs-agree-on-p
                            expr-denv-lookup-exprs subset-of-tail-when-subset
                            value-meets-required-type-p var-required-type
                            type-closed-p type-evaluable-p
                            expr-valuep-when-result-not-error
                            not-emptyp-when-consp-setp
                            subset-of-cdr-when-subset-setp)
                           (set::in-head)))))

(defruled tenvs-agree-on-p-of-ll-lambda-parts
  (b* (((mv ps & & ictx) (ll-lambda-parts params body type? ctx)))
    (implies (and (string-listp names)
                  (not (intersectp-equal names (var+type?-list->var ps))))
             (tenvs-agree-on-p names (ll-context->tenv ctx)
                               (ll-context->tenv ictx))))
  :induct (len names)
  :enable (tenvs-agree-on-p len intersectp-equal)
  :hints (("Subgoal *1/1"
           :use ((:instance ll-lambda-parts-context-at-other
                            (v (car names)))))))

(defruled not-intersectp-of-difference-mergesort
  (implies (and (set::setp s) (true-listp l))
           (not
            (intersectp-equal
             (set::intersect (set::difference s (set::mergesort l)) c)
                                  l)))
  :enable (acl2::intersectp-witness-rw set::in-to-member)
  :use ((:instance set::in-to-member
                   (a (acl2::intersectp-witness
                       (set::intersect (set::difference s (set::mergesort l))
                                       c) l))
                   (x
                    (set::intersect (set::difference s (set::mergesort l))
                                    c)))))

(defruled fve-subset-of-outer-names
  (implies (stringp lam)
           (set::subset (%fve)
                        (set::intersect (%nfvx) (ll-context->locals ctx))))
  :use ((:instance ll-lambda-parts-locals (params pa) (body ba) (type? ta))
        (:instance fve-facts
                   (a (expr-free-expr-vars (%nb)))
                   (b (set::mergesort (var+type?-list->var (%ps))))
                   (c (ll-context->locals (%ictx)))))
  :enable (set::pick-a-point-subset-strategy)
  :disable (ll-lambda-parts
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled apply-leading-ok-p-of-lifted
  (implies (and (captured-params-typed-p (%fve) (ll-context->tenv (%ictx)))
                (new-values-meet-types-p names new-denv (ll-context->tenv ctx))
                (set::subset (%fve) names)
                (expr-denv-wfp new-denv)
                (consp (%ps))
                (param-evaluable-p (car (%ps)))
                (set::emptyp (var+type?-free-type-vars (car (%ps))))
                (set::emptyp (var+type?-free-ispace-vars (car (%ps))))
                (implies (endp (cdr (%ps)))
                         (and (type-option-evaluable-p (%ity))
                              (set::emptyp (type-option-free-type-vars (%ity)))
                              (set::emptyp (type-option-free-ispace-vars
                                            (%ity))))))
           (and (apply-leading-ok-p (%cps) (%ps) (%nb) (%ity) genv (%vs))
                (not (reserrp (%vs)))))
  :use ((:instance fve-facts
                   (a (expr-free-expr-vars (%nb)))
                   (b (set::mergesort (var+type?-list->var (%ps))))
                   (c (ll-context->locals (%ictx))))
        (:instance captured-values-ok-p-when-checked
                   (fv (%fve)) (tenv2 (ll-context->tenv (%ictx)))
                   (nd new-denv) (tenv (ll-context->tenv ctx)))
        (:instance tenvs-agree-on-p-of-ll-lambda-parts
                   (params pa) (body ba) (type? ta) (names (%fve)))
        (:instance not-intersectp-of-difference-mergesort
                   (s (expr-free-expr-vars (%nb)))
                   (l (var+type?-list->var (%ps)))
                   (c (ll-context->locals (%ictx))))
        (:instance apply-leading-ok-p-of-captured
                   (fv (%fve)) (tenv (ll-context->tenv (%ictx)))
                   (nd new-denv) (ps (%ps)) (nb (%nb)) (ity (%ity)) (e genv))
        (:instance lookup-exprs-ok-when-captured-values-ok-p
                   (fv (%fve)) (tenv (ll-context->tenv (%ictx))) (nd new-denv))
        (:instance acl2::string-listp-when-string-setp (acl2::x (%fve))))
  :disable (ll-lambda-parts lambda-closure
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The lifted-lambda case: a lambda atom that LL-EXPR lifts, and whose
; definition is emitted, evaluates to a closure related to the value of the
; reference that replaces it.  The side conditions (%SIDE-HYPS and
; %SIDE2-HYPS) are to be discharged from the invariants of the traversal.

(defruled ll-expr-of-liftable-atom
  (implies (and (equal (expr-kind x) :atom)
                (equal (expr-atom->atom x)
                       (make-atom-lambda/lambdan pa ba ta))
                (var+type?-listp pa)
                (consp pa)
                (exprp ba)
                (type-optionp ta)
                (liftable-lambda-p (expr-atom->atom x) tenv locals lmap))
           (equal (ll-expr x tenv tlets locals lmap used)
                  (ll-lambda pa ba ta tenv tlets locals lmap used)))
  :expand ((ll-expr x tenv tlets locals lmap used))
  :enable (make-atom-lambda/lambdan
           positive-len-when-consp)
  :cases ((consp (cdr pa)))
  :hints (("Subgoal 2" :use ((:instance list-car-when-singleton (l pa))))))

; The definition of a lifted lambda is bound at the top to its closure.

(defruled lambda-closure-ok-when-eval-bind-ok
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (reserrp (eval-bind bind denv limit))))
           (not (reserrp (lambda-closure (bind-fun->params bind)
                                         (bind-fun->expr bind)
                                         (bind-fun->type? bind)
                                         denv))))
  :expand ((eval-bind bind denv limit)
           (:free (a) (eval-atom a denv 1)))
  :enable (lambda-closure make-atom-lambda/lambdan lambda-curried-body
           consp-when-positive-len positive-len-when-consp
           not-reserrp-when-expr-valuep))

(defruled lookup-of-lifted-def-in-genv
  (implies (and (ll-defs-bound-p defs genv)
                (member-equal def defs)
                (consp (bind-fun->params def)))
           (equal (expr-denv-lookup-expr (bind-fun->var def) genv)
                  (lambda-closure (bind-fun->params def)
                                  (bind-fun->expr def)
                                  (bind-fun->type? def)
                                  genv)))
  :induct (len defs)
  :enable (ll-defs-bound-p len)
  :hints (("Subgoal *1/1"
           :use ((:instance eval-bind-when-fun-with-params
                            (bind def) (denv genv) (limit 1))
                 (:instance lambda-closure-ok-when-eval-bind-ok
                            (bind def) (denv genv) (limit 1)))
           :in-theory (enable ll-defs-bound-p expr-valuep-when-result-not-error
                              expr-denv-lookup-expr-of-expr-denv-add-expr
                              expr-valuep-when-result-not-error))))

(defmacro %ll-inner ()
  '(ll-expr (mv-nth 1 (%lp))
            (ll-context->tenv (%ictx)) (ll-context->tlets (%ictx))
            (ll-context->locals (%ictx)) (ll-context->lmap (%ictx))
            (ll-context->used (%ictx))))
(defmacro %used2 () '(mv-nth 2 (%ll-inner)))
(defmacro %emit ()
  '(emit-lifted-lambda (%ps) (%nb) (%ity) (ll-context->tenv (%ictx))
                       (ll-context->locals (%ictx)) (%used2)))
(defmacro %lam () '(fresh-expr-var "lam_" (%used2)))
(defmacro %def ()
  '(make-bind-fun :var (%lam) :params (append (%cps) (%ps)) :type? (%ity)
                  :expr (%nb)))

(defmacro %lifted-atom-hyps ()
  '(and (equal (expr-kind x) :atom)
        (equal (expr-atom->atom x) (make-atom-lambda/lambdan pa ba ta))
        (var+type?-listp pa)
        (consp pa)
        (exprp ba)
        (type-optionp ta)
        (liftable-lambda-p (expr-atom->atom x) (ll-context->tenv ctx)
                           (ll-context->locals ctx) (ll-context->lmap ctx))
        (consp (mv-nth 1 (%emit)))))

(defruled lifted-atom-transform-facts
  (implies (%lifted-atom-hyps)
           (and (equal (ll-context-new-expr x ctx)
                       (apply-to-names (expr-var (%lam)) (%fve)))
                (equal (ll-context-lifted x ctx)
                       (append (ll-context-lifted (mv-nth 1 (%lp)) (%ictx))
                               (list (%def))))
                (captured-params-typed-p (%fve) (ll-context->tenv (%ictx)))
                (param-evaluable-p (car (append (%cps) (%ps))))
                (type-option-evaluable-p (%ity))
                (consp (%ps))))
  :use ((:instance ll-expr-of-liftable-atom
                   (tenv (ll-context->tenv ctx)) (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx)) (lmap
                                                      (ll-context->lmap ctx))
                   (used (ll-context->used ctx)))
        (:instance ll-lambda-decomposition (params pa) (body ba) (type? ta)))
  :enable (ll-expr-of-liftable-atom ll-lambda-decomposition ll-context-new-expr
           ll-context-lifted emit-lifted-lambda)
  :disable
  (ll-lambda-parts ll-expr ll-lambda set::intersect-under-set-equiv
   set::difference-under-set-equiv set::mergesort-under-set-equiv
   acl2::set-equiv-implies-equal-consp-1))

(defrule ll-lambda-parts-types
  (implies (and (exprp body) (type-optionp type?))
           (and (exprp (mv-nth 1 (ll-lambda-parts params body type? ctx)))
                (type-optionp (mv-nth 2 (ll-lambda-parts params body type?
                                                         ctx)))))
  :use ll-lambda-parts-is-lambda-chain
  :disable ll-lambda-parts)

(defruled ll-defs-bound-p-member-eval-bind-ok
  (implies (and (ll-defs-bound-p defs genv)
                (member-equal def defs))
           (not (reserrp (eval-bind def genv 1))))
  :induct (len defs)
  :enable (ll-defs-bound-p len))

(defruled expr-free-expr-vars-when-var-kind
  (implies (equal (expr-kind e) :var)
           (equal (expr-free-expr-vars e)
                  (set::insert (expr-var->name e) nil)))
  :expand ((expr-free-expr-vars e)))

(defmacro %case-hyps ()
  '(and (%lifted-atom-hyps)
        (not (reserrp (eval-expr x denv limit)))
        (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
        (ll-context-ok-p x ctx genv)
        (expr-denv-wfp denv)
        (expr-denv-wfp new-denv)))

; The name of the definition.

(defruled lifted-def-name-fresh
  (implies (%case-hyps)
           (and (stringp (%lam))
                (not (set::in (%lam) (ll-context->locals ctx)))))
  :use ((:instance ll-context-ok-p-facts)
        (:instance fresh-expr-var-is-fresh (prefix "lam_") (used (%used2)))
        (:instance used-of-ll-expr
                   (x (mv-nth 1 (%lp)))
                   (tenv (ll-context->tenv (%ictx)))
                   (tlets (ll-context->tlets (%ictx)))
                   (locals (ll-context->locals (%ictx)))
                   (lmap (ll-context->lmap (%ictx)))
                   (used (ll-context->used (%ictx))))
        (:instance ll-lambda-parts-context (params pa) (body ba) (type? ta)
                   (k (%lam)))
        (:instance set::subset-in (a (%lam)) (x (ll-context->locals ctx))
                   (y (ll-context->used ctx)))
        (:instance set::subset-in (a (%lam)) (x (ll-context->used ctx))
                   (y (%used2))))
  :disable (ll-lambda-parts lambda-closure ll-expr ll-context-ok-p
            set::subset-in fresh-expr-var
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::mergesort-under-set-equiv))

(defruled lifted-def-name-genv
  (implies (%case-hyps)
           (and (equal (expr-denv-lookup-expr (%lam) genv)
                       (lambda-closure (append (%cps) (%ps)) (%nb) (%ity) genv))
                (not (reserrp (lambda-closure (append (%cps) (%ps)) (%nb)
                                              (%ity) genv)))))
  :use (lifted-atom-transform-facts
        (:instance ll-context-ok-p-facts-nb)
        (:instance lookup-of-lifted-def-in-genv
                   (defs (ll-context-lifted x ctx)) (def (%def)))
        (:instance lambda-closure-ok-when-eval-bind-ok
                   (bind (%def)) (denv genv) (limit 1))
        (:instance ll-defs-bound-p-member-eval-bind-ok
                   (defs (ll-context-lifted x ctx)) (def (%def))))
  :disable (ll-lambda-parts lambda-closure ll-expr ll-context-ok-p
            ll-defs-bound-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::mergesort-under-set-equiv))

(defruled lifted-def-name-facts
  (implies (%case-hyps)
           (and (stringp (%lam))
                (not (set::in (%lam) (ll-context->locals ctx)))
                (equal (expr-denv-lookup-expr (%lam) genv)
                       (lambda-closure (append (%cps) (%ps)) (%nb) (%ity) genv))
                (not (reserrp (lambda-closure (append (%cps) (%ps)) (%nb)
                                              (%ity) genv)))
                (equal (expr-denv-lookup-expr (%lam) new-denv)
                       (lambda-closure (append (%cps) (%ps)) (%nb) (%ity)
                                       genv))))
  :use (lifted-atom-transform-facts lifted-def-name-fresh lifted-def-name-genv
        (:instance names-bound-as-in-p-when-in
                   (names (set::difference
                           (expr-free-expr-vars (ll-context-new-expr x ctx))
                           (ll-context->locals ctx)))
                   (name (%lam))))
  :expand ((expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
           (:free (n) (expr-free-expr-vars (expr-var n))))
  :enable expr-free-expr-vars-when-var-kind
  :disable (ll-lambda-parts lambda-closure ll-expr ll-context-ok-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::mergesort-under-set-equiv))

(defmacro %side-hyps ()
  '(and (expr-denv-wfp genv)
        (set::emptyp (var+type?-free-type-vars (car pa)))
        (set::emptyp (var+type?-free-ispace-vars (car pa)))
        (implies (endp (cdr (%ps)))
                 (and (set::emptyp (type-option-free-type-vars (%ity)))
                      (set::emptyp (type-option-free-ispace-vars (%ity)))))))

(defruled lifted-first-param-facts
  (implies (%case-hyps)
           (and (equal (car (%ps)) (car pa))
                (param-evaluable-p (car pa))))
  :use ((:instance ll-lambda-parts-is-lambda-chain
                   (params pa) (body ba) (type? ta)))
  :expand ((liftable-lambda-p (expr-atom->atom x) (ll-context->tenv ctx)
                              (ll-context->locals ctx) (ll-context->lmap ctx)))
  :enable (make-atom-lambda/lambdan)
  :disable (ll-lambda-parts))

(defruled lifted-ref-names-facts
  (implies (%case-hyps)
           (b* ((names (set::intersect
                        (expr-free-expr-vars
                         (apply-to-names (expr-var (%lam)) (%fve)))
                        (ll-context->locals ctx))))
             (and (new-values-meet-types-p names new-denv
                                           (ll-context->tenv ctx))
                  (set::subset (%fve) names))))
  :use (lifted-atom-transform-facts
        (:instance fve-subset-of-outer-names (lam (%lam))))
  :expand ((expr-denv-ll-related-p new-denv denv x ctx nil dw genv))
  :enable (lifted-atom-transform-facts)
  :disable (ll-lambda-parts lambda-closure ll-expr apply-to-names
            expr-free-expr-vars-of-apply-to-names
            ll-context-ok-p string-expr-value-map-ll-related-p
            names-bound-as-in-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::mergesort-under-set-equiv))

(defruled lifted-ref-apply-ok
  (implies (and (%case-hyps) (%side-hyps))
           (and (apply-leading-ok-p (%cps) (%ps) (%nb) (%ity) genv (%vs))
                (not (reserrp (%vs)))
                (not (reserrp (%u)))))
  :use (lifted-atom-transform-facts
        lifted-first-param-facts
        lifted-ref-names-facts
        (:instance apply-leading-ok-p-of-lifted
                   (names (set::intersect
                           (expr-free-expr-vars
                            (apply-to-names (expr-var (%lam)) (%fve)))
                           (ll-context->locals ctx))))
        (:instance lambda-closure-ok-when-evaluable
                   (params (%ps)) (body (%nb)) (type? (%ity))
                   (denv (apply-leading-env (%cps) (%ps) (%nb) (%ity) genv
                                            (%vs)))))
  :in-theory (union-theories (theory 'minimal-theory)
                             '(lifted-first-param-facts)))


(defruled eval-expr-when-var-kind
  (implies (and (equal (expr-kind e) :var)
                (not (zp limit)))
           (equal (eval-expr e denv limit)
                  (expr-denv-lookup-expr (expr-var->name e) denv)))
  :expand ((eval-expr e denv limit)))

(defruled lifted-ref-eval
  (implies (and (%case-hyps) (%side-hyps))
           (equal (eval-expr (ll-context-new-expr x ctx) new-denv
                             (+ 7 (len (%fve))))
                  (%u)))
  :cases ((consp (%fve)))
  :use (lifted-atom-transform-facts
        lifted-def-name-facts
        lifted-ref-apply-ok
        (:instance eval-app-of-lambda-closure-leading
                   (cps (%cps)) (ps (%ps)) (body (%nb)) (type? (%ity))
                   (denv genv) (vs (%vs)) (limit (+ 6 (len (%fve))))))
  :enable (lifted-atom-transform-facts lifted-def-name-facts lifted-ref-apply-ok
           apply-leading-env names-to-params
           expr-denv-lookup-exprs eval-expr-when-var-kind)
  :disable
  (ll-lambda-parts lambda-closure ll-expr set::intersect-under-set-equiv
   set::difference-under-set-equiv set::mergesort-under-set-equiv
   acl2::set-equiv-implies-equal-consp-1))

(defruled lifted-orig-eval
  (implies (and (equal (expr-kind x) :atom)
                (equal (expr-atom->atom x) (make-atom-lambda/lambdan pa ba ta))
                (consp pa)
                (not (reserrp (eval-expr x denv limit))))
           (equal (eval-expr x denv limit)
                  (lambda-closure pa ba ta denv)))
  :use ((:instance eval-atom-of-lambda/lambdan
                   (params pa) (body ba) (type? ta) (limit (1- limit))))
  :expand ((eval-expr x denv limit)
           (:free (a) (eval-atom a denv 0))))

(defmacro %side2-hyps ()
  '(and
    (set::subset (omap::keys (ll-context->lmap ctx)) (ll-context->locals ctx))
        (lmap-replacements-ok-p (ll-context->lmap ctx) (ll-context->locals ctx)
                                (var+type?-list->var (%ps)) genv)
        (set::emptyp (type-option-free-type-vars ta))
        (set::emptyp (type-option-free-ispace-vars ta))
        (implies (mv-nth 0 (nested-lambda ba))
                 (consp (mv-nth 1 (nested-lambda ba))))
        (set::emptyp (expr-free-ispace-vars (lambda-curried-body pa ba ta)))
        (set::emptyp (expr-free-type-vars (lambda-curried-body pa ba ta)))
        (set::emptyp (expr-free-ispace-vars
                      (lambda-curried-body (%ps) (%nb) (%ity))))
        (set::emptyp (expr-free-type-vars
                      (lambda-curried-body (%ps) (%nb) (%ity))))
        (no-duplicatesp-equal (var+type?-list->var (%ps)))
        (subsetp-equal (var+type?-list->var (%ps)) (ll-context->used ctx))))

;; The binders of a lifted lambda are the parameters it collects, followed
;; by those of its innermost body.

(defruled expr-binder-names-of-lambda-chain
  (b* (((mv more inner &) (lambda-chain body type?)))
    (equal (expr-binder-names body)
           (append (var+type?-list->var more) (expr-binder-names inner))))
  :induct (lambda-chain body type?)
  :enable (lambda-chain nested-lambda var+type?-list->var)
  :expand ((expr-binder-names body)
           (atom-binder-names (expr-atom->atom body))))

(defruled atom-binder-names-of-make-atom-lambda/lambdan
  (implies (consp params)
           (equal
            (atom-binder-names (make-atom-lambda/lambdan params body type?))
                  (append (var+type?-list->var params)
                          (expr-binder-names body))))
  :enable (make-atom-lambda/lambdan var+type?-list->var
           consp-when-positive-len positive-len-when-consp)
  :cases ((consp (cdr params)))
  :expand ((:free (p b ty) (atom-binder-names (atom-lambda p b ty)))
           (:free (p b ty) (atom-binder-names (atom-lambdan p b ty)))))

(defruled expr-binder-names-when-atom-kind
  (implies (equal (expr-kind x) :atom)
           (equal (expr-binder-names x)
                  (atom-binder-names (expr-atom->atom x))))
  :expand ((expr-binder-names x)))

(defruled expr-binder-names-of-lifted-atom
  (implies (and (equal (expr-kind x) :atom)
                (equal (expr-atom->atom x) (make-atom-lambda/lambdan pa ba ta))
                (var+type?-listp pa)
                (consp pa)
                (exprp ba)
                (type-optionp ta))
           (equal (expr-binder-names x)
                  (append (var+type?-list->var (%ps))
                          (expr-binder-names (mv-nth 1 (%lp))))))
  :use ((:instance ll-lambda-parts-is-lambda-chain
                   (params pa) (body ba) (type? ta))
        (:instance expr-binder-names-of-lambda-chain (body ba) (type? ta))
        (:instance atom-binder-names-of-make-atom-lambda/lambdan
                   (params pa) (body ba) (type? ta))
        expr-binder-names-when-atom-kind)
  :in-theory (e/d (var+type?-list->var-of-append)
                  (ll-lambda-parts lambda-chain make-atom-lambda/lambdan
                   expr-binder-names atom-binder-names)))

(local
 (defun smap-ind (m)
   (declare (xargs :measure (acl2-count (string-expr-map-fix m))))
   (b* ((m (string-expr-map-fix m)))
     (if (omap::emptyp m) nil (smap-ind (omap::tail m))))))

(defruled string-expr-map-closed-p-at
  (implies (and (string-expr-map-closed-p m)
                (omap::assoc k (string-expr-map-fix m)))
           (and (equal (expr-free-type-vars
                        (cdr (omap::assoc k (string-expr-map-fix m))))
                       nil)
                (equal (expr-free-ispace-vars
                        (cdr (omap::assoc k (string-expr-map-fix m))))
                       nil)))
  :induct (smap-ind m)
  :enable (string-expr-map-closed-p omap::assoc))

(defruled lmap-closed-p-when-string-expr-map-closed-p
  (implies (string-expr-map-closed-p m)
           (lmap-closed-p m))
  :expand ((lmap-closed-p m))
  :use ((:instance string-expr-map-closed-p-at
                   (k (lmap-closed-p-witness m)))))

(defruled lmap-closed-p-of-tail
  (implies (lmap-closed-p m)
           (lmap-closed-p (omap::tail (string-expr-map-fix m))))
  :expand ((lmap-closed-p (omap::tail (string-expr-map-fix m))))
  :use ((:instance lmap-closed-p-necc
                   (lmap m)
                   (name (lmap-closed-p-witness
                          (omap::tail (string-expr-map-fix m)))))
        (:instance assoc-when-assoc-of-tail
                   (k (lmap-closed-p-witness
                       (omap::tail (string-expr-map-fix m))))
                   (m (string-expr-map-fix m)))))

(defruled string-expr-map-closed-p-when-lmap-closed-p
  (implies (lmap-closed-p m)
           (string-expr-map-closed-p m))
  :induct (smap-ind m)
  :enable (string-expr-map-closed-p)
  :hints (("Subgoal *1/2"
           :use ((:instance lmap-closed-p-necc
                            (lmap m)
                            (name
                             (mv-nth 0 (omap::head (string-expr-map-fix m)))))
                 (:instance lmap-closed-p-of-tail)))))

(acl2::defun-sk lmap-replacements-pointwise-p (lmap locals pnames genv)
  (forall k
          (implies (omap::assoc k (string-expr-map-fix lmap))
                   (ll-replacement-ok-p
                    (cdr (omap::assoc k (string-expr-map-fix lmap)))
                    locals pnames genv))))

(local (in-theory (disable lmap-replacements-pointwise-p)))

(defruled lmap-replacements-pointwise-p-of-tail
  (implies (lmap-replacements-pointwise-p lmap locals pnames genv)
           (lmap-replacements-pointwise-p
            (omap::tail (string-expr-map-fix lmap))
                                          locals pnames genv))
  :expand ((lmap-replacements-pointwise-p
            (omap::tail (string-expr-map-fix lmap)) locals pnames genv))
  :use ((:instance lmap-replacements-pointwise-p-necc
                   (k (lmap-replacements-pointwise-p-witness
                       (omap::tail (string-expr-map-fix lmap))
                       locals pnames genv)))
        (:instance assoc-when-assoc-of-tail
                   (k (lmap-replacements-pointwise-p-witness
                       (omap::tail (string-expr-map-fix lmap))
                       locals pnames genv))
                   (m (string-expr-map-fix lmap)))))

(defruled lmap-replacements-pointwise-p-of-tail-mapp
  (implies (and (string-expr-mapp lmap)
                (lmap-replacements-pointwise-p lmap locals pnames genv))
           (lmap-replacements-pointwise-p (omap::tail lmap) locals pnames genv))
  :use lmap-replacements-pointwise-p-of-tail)

(defruled lmap-replacements-ok-p-when-pointwise
  (implies (lmap-replacements-pointwise-p lmap locals pnames genv)
           (lmap-replacements-ok-p lmap locals pnames genv))
  :induct (smap-ind lmap)
  :enable (lmap-replacements-ok-p lmap-replacements-pointwise-p-of-tail-mapp)
  :disable (lmap-replacements-pointwise-p)
  :hints (("Subgoal *1/2"
           :use ((:instance lmap-replacements-pointwise-p-necc
                            (k (mv-nth 0 (omap::head
                                          (string-expr-map-fix lmap)))))))))

(defruled ll-replacement-ok-p-of-more-locals
  (implies (and (ll-replacement-ok-p repl locals pnames genv)
                (string-setp locals)
                (string-listp pnames)
                (string-listp more)
                (subsetp-equal more pnames)
                (string-listp pnames2)
                (subsetp-equal pnames2 pnames))
           (ll-replacement-ok-p repl
                                (set::union (set::mergesort more) locals)
                                pnames2 genv))
  :enable (ll-replacement-ok-p)
  :use ((:instance not-member-when-subsetp-and-not-member
                   (h (mv-nth 1 (replacement-parts repl))) (p pnames))
        (:instance not-member-when-subsetp-and-not-member
                   (h (mv-nth 1 (replacement-parts repl))) (more pnames2)
                   (p pnames))
        (:instance subsetp-of-union-mergesort-right
                   (l (mv-nth 2 (replacement-parts repl))) (s locals))
        (:instance not-intersectp-when-subsetp-right
                   (a (mv-nth 2 (replacement-parts repl)))
                   (p pnames) (p2 pnames2))))

; The replacements of the hoisted functions in the context of the body of a
; lambda do not refer to its parameters, if those around it do not.

(defmacro %llp-pn ()
  '(var+type?-list->var (mv-nth 0 (ll-lambda-parts params body type? ctx))))
(defmacro %llp-ictx () '(mv-nth 3 (ll-lambda-parts params body type? ctx)))

(defruled ll-lambda-parts-replacement-ok-at
  (implies (and (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        (%llp-pn) genv)
                (omap::assoc k (ll-context->lmap (%llp-ictx))))
           (ll-replacement-ok-p (cdr (omap::assoc k (ll-context->lmap
                                                     (%llp-ictx))))
                                (ll-context->locals (%llp-ictx))
                                (%llp-pn) genv))
  :use (ll-lambda-parts-context
        ll-lambda-parts-locals
        (:instance ll-replacement-ok-p-when-lmap-replacements-ok-p
                   (lmap (ll-context->lmap ctx))
                   (locals (ll-context->locals ctx))
                   (pnames (%llp-pn)))
        (:instance ll-replacement-ok-p-of-more-locals
                   (repl (cdr (omap::assoc k (ll-context->lmap ctx))))
                   (locals (ll-context->locals ctx))
                   (pnames (%llp-pn)) (more (%llp-pn)) (pnames2 (%llp-pn))))
  :disable (ll-lambda-parts ll-replacement-ok-p))

(defruled ll-lambda-parts-replacements-ok
  (implies (lmap-replacements-ok-p (ll-context->lmap ctx)
                                   (ll-context->locals ctx)
                                   (%llp-pn) genv)
           (lmap-replacements-ok-p (ll-context->lmap (%llp-ictx))
                                   (ll-context->locals (%llp-ictx))
                                   (%llp-pn) genv))
  :use ((:instance lmap-replacements-ok-p-when-pointwise
                   (lmap (ll-context->lmap (%llp-ictx)))
                   (locals (ll-context->locals (%llp-ictx)))
                   (pnames (%llp-pn)))
        (:instance ll-lambda-parts-replacement-ok-at
                   (k (lmap-replacements-pointwise-p-witness
                       (ll-context->lmap (%llp-ictx))
                       (ll-context->locals (%llp-ictx))
                       (%llp-pn) genv))))
  :expand ((lmap-replacements-pointwise-p
            (ll-context->lmap (%llp-ictx)) (ll-context->locals (%llp-ictx))
            (%llp-pn) genv))
  :disable (ll-lambda-parts ll-replacement-ok-p lmap-replacements-ok-p))

;; Closedness: the types of a lifted lambda, and of the chain it collects,
;; are closed when the lambda is.

(defrule nested-lambda-params-consp
  (implies (mv-nth 0 (nested-lambda body))
           (consp (mv-nth 1 (nested-lambda body))))
  :enable nested-lambda
  :use ((:instance atom-lambdan-requirements
                   (x (expr-atom->atom (expr-fix body))))))

(defmacro %closed-t/i (fn x)
  `(and (set::emptyp (,(intern-in-package-of-symbol
                        (concatenate 'string (symbol-name fn) "-FREE-TYPE-VARS")
                        'remora::expr) ,x))
        (set::emptyp (,(intern-in-package-of-symbol
                        (concatenate 'string (symbol-name fn)
                                     "-FREE-ISPACE-VARS")
                        'remora::expr) ,x))))

(defruled closed-parts-of-make-atom-lambda/lambdan
  (implies (and (consp params)
                (%closed-t/i atom (make-atom-lambda/lambdan params body type?)))
           (and (%closed-t/i var+type?-list params)
                (%closed-t/i expr body)
                (%closed-t/i type-option type?)))
  :enable (make-atom-lambda/lambdan
           positive-len-when-consp)
  :cases ((consp (cdr params)))
  :expand ((:free (p b ty) (atom-free-type-vars (atom-lambda p b ty)))
           (:free (p b ty) (atom-free-ispace-vars (atom-lambda p b ty)))
           (:free (p b ty) (atom-free-type-vars (atom-lambdan p b ty)))
           (:free (p b ty) (atom-free-ispace-vars (atom-lambdan p b ty)))
           (var+type?-list-free-type-vars params)
           (var+type?-list-free-ispace-vars params)
           (var+type?-list-free-type-vars (cdr params))
           (var+type?-list-free-ispace-vars (cdr params))))

(defruled closed-parts-of-lambda-chain
  (implies (and (%closed-t/i expr body)
                (%closed-t/i type-option type?))
           (b* (((mv more inner ity) (lambda-chain body type?)))
             (and (%closed-t/i var+type?-list more)
                  (%closed-t/i expr inner)
                  (%closed-t/i type-option ity))))
  :induct (lambda-chain body type?)
  :enable (lambda-chain nested-lambda)
  :expand ((atom-free-type-vars (expr-atom->atom body))
           (atom-free-ispace-vars (expr-atom->atom body))
           (:free (a) (expr-free-type-vars (expr-atom a)))
           (:free (a) (expr-free-ispace-vars (expr-atom a)))
           (expr-free-type-vars body)
           (expr-free-ispace-vars body)
           (:free (p b ty) (atom-free-type-vars (atom-lambda p b ty)))
           (:free (p b ty) (atom-free-ispace-vars (atom-lambda p b ty)))
           (:free (p b ty) (atom-free-type-vars (atom-lambdan p b ty)))
           (:free (p b ty) (atom-free-ispace-vars (atom-lambdan p b ty)))
           (:free (p q) (var+type?-list-free-type-vars (cons p q)))
           (:free (p q) (var+type?-list-free-ispace-vars (cons p q)))))

(defruled closed-lambda-curried-body
  (implies (and (consp params)
                (%closed-t/i var+type?-list params)
                (%closed-t/i expr body)
                (%closed-t/i type-option type?))
           (%closed-t/i expr (lambda-curried-body params body type?)))
  :enable (lambda-curried-body make-atom-lambda/lambdan
           consp-when-positive-len)
  :cases ((consp (cddr params)))
  :expand ((:free (a) (expr-free-type-vars (expr-atom a)))
           (:free (a) (expr-free-ispace-vars (expr-atom a)))
           (:free (p b ty) (atom-free-type-vars (atom-lambda p b ty)))
           (:free (p b ty) (atom-free-ispace-vars (atom-lambda p b ty)))
           (:free (p b ty) (atom-free-type-vars (atom-lambdan p b ty)))
           (:free (p b ty) (atom-free-ispace-vars (atom-lambdan p b ty)))
           (var+type?-list-free-type-vars params)
           (var+type?-list-free-ispace-vars params)
           (var+type?-list-free-type-vars (cdr params))
           (var+type?-list-free-ispace-vars (cdr params))))

(defruled lmap-closed-p-of-ll-lambda-parts
  (implies (lmap-closed-p (ll-context->lmap ctx))
           (lmap-closed-p (ll-context->lmap
                           (mv-nth 3 (ll-lambda-parts params body type? ctx)))))
  :induct (ll-lambda-parts params body type? ctx)
  :enable ((:induction ll-lambda-parts))
  :expand ((:free (type?) (ll-lambda-parts params body type? ctx))))

(defruled lifted-case-closedness
  (implies (and (%lifted-atom-hyps)
                (lmap-closed-p (ll-context->lmap ctx)))
           (and (set::emptyp (var+type?-free-type-vars (car pa)))
                (set::emptyp (var+type?-free-ispace-vars (car pa)))
                (%closed-t/i type-option (%ity))
                (%closed-t/i type-option ta)
                (%closed-t/i expr (lambda-curried-body pa ba ta))
                (%closed-t/i expr (lambda-curried-body (%ps) (%nb) (%ity)))))
  :use ((:instance closed-parts-of-make-atom-lambda/lambdan
                   (params pa) (body ba) (type? ta))
        (:instance closed-parts-of-lambda-chain (body ba) (type? ta))
        (:instance ll-lambda-parts-is-lambda-chain
                   (params pa) (body ba) (type? ta))
        (:instance lmap-closed-p-of-ll-lambda-parts
                   (params pa) (body ba) (type? ta))
        (:instance free-type/ispace-vars-of-ll-expr
                   (x (mv-nth 1 (%lp)))
                   (tenv (ll-context->tenv (%ictx)))
                   (tlets (ll-context->tlets (%ictx)))
                   (locals (ll-context->locals (%ictx)))
                   (lmap (ll-context->lmap (%ictx)))
                   (used (ll-context->used (%ictx))))
        (:instance closed-lambda-curried-body
                   (params pa) (body ba) (type? ta))
        (:instance closed-lambda-curried-body
                   (params (%ps)) (body (%nb)) (type? (%ity))))
  :expand ((liftable-lambda-p (expr-atom->atom x) (ll-context->tenv ctx)
                              (ll-context->locals ctx) (ll-context->lmap ctx))
           (var+type?-list-free-type-vars pa)
           (var+type?-list-free-ispace-vars pa))
  :enable (ll-context-new-expr)
  :disable (ll-lambda-parts ll-expr lambda-chain lambda-curried-body))

;; The invariants hold at the innermost body of a lifted lambda.

(defmacro %lifted-atom-hyps-base ()
  '(and (equal (expr-kind x) :atom)
        (equal (expr-atom->atom x) (make-atom-lambda/lambdan pa ba ta))
        (var+type?-listp pa)
        (consp pa)
        (exprp ba)
        (type-optionp ta)))

(defruled lifted-inner-params-facts
  (implies (%lifted-atom-hyps-base)
           (and (subsetp-equal (var+type?-list->var (%ps))
                               (expr-binder-names x))
                (subsetp-equal (expr-binder-names (mv-nth 1 (%lp)))
                               (expr-binder-names x))
                (implies (no-duplicatesp-equal (expr-binder-names x))
                         (and (no-duplicatesp-equal
                               (var+type?-list->var (%ps)))
                              (no-duplicatesp-equal
                               (expr-binder-names (mv-nth 1 (%lp))))))))
  :use expr-binder-names-of-lifted-atom
  :disable (ll-lambda-parts))

(defruled lifted-inner-key-in-locals
  (implies (and (set::subset (omap::keys (ll-context->lmap ctx))
                             (ll-context->locals ctx))
                (set::in k (omap::keys (ll-context->lmap (%ictx)))))
           (set::in k (ll-context->locals (%ictx))))
  :use ((:instance ll-lambda-parts-context (params pa) (body ba) (type? ta))
        (:instance omap::in-of-keys-to-assoc
                   (omap::key k) (omap::map (ll-context->lmap (%ictx))))
        (:instance omap::in-of-keys-to-assoc
                   (omap::key k) (omap::map (ll-context->lmap ctx)))
        (:instance set::subset-in (a k) (x (omap::keys (ll-context->lmap ctx)))
                   (y (ll-context->locals ctx))))
  :disable (ll-lambda-parts))

(defruled lifted-inner-lmap-keys
  (implies (set::subset (omap::keys (ll-context->lmap ctx))
                        (ll-context->locals ctx))
           (set::subset (omap::keys (ll-context->lmap (%ictx)))
                        (ll-context->locals (%ictx))))
  :enable (set::pick-a-point-subset-strategy lifted-inner-key-in-locals)
  :disable (ll-lambda-parts))

(defruled lifted-inner-replacement-at
  (implies (and (%lifted-atom-hyps-base)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        (expr-binder-names x) genv)
                (omap::assoc k (ll-context->lmap (%ictx))))
           (ll-replacement-ok-p (cdr (omap::assoc k (ll-context->lmap (%ictx))))
                                (ll-context->locals (%ictx))
                                (expr-binder-names (mv-nth 1 (%lp)))
                                genv))
  :use (lifted-inner-params-facts
        (:instance ll-lambda-parts-context (params pa) (body ba) (type? ta))
        (:instance ll-lambda-parts-locals (params pa) (body ba) (type? ta))
        (:instance ll-replacement-ok-p-when-lmap-replacements-ok-p
                   (lmap (ll-context->lmap ctx))
                   (locals (ll-context->locals ctx))
                   (pnames (expr-binder-names x)))
        (:instance ll-replacement-ok-p-of-more-locals
                   (repl (cdr (omap::assoc k (ll-context->lmap ctx))))
                   (locals (ll-context->locals ctx))
                   (pnames (expr-binder-names x))
                   (more (var+type?-list->var (%ps)))
                   (pnames2 (expr-binder-names (mv-nth 1 (%lp))))))
  :disable (ll-lambda-parts ll-replacement-ok-p))

(defruled lifted-inner-replacements
  (implies (and (%lifted-atom-hyps-base)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        (expr-binder-names x) genv))
           (lmap-replacements-ok-p (ll-context->lmap (%ictx))
                                   (ll-context->locals (%ictx))
                                   (expr-binder-names (mv-nth 1 (%lp)))
                                   genv))
  :use ((:instance lmap-replacements-ok-p-when-pointwise
                   (lmap (ll-context->lmap (%ictx)))
                   (locals (ll-context->locals (%ictx)))
                   (pnames (expr-binder-names (mv-nth 1 (%lp)))))
        (:instance lifted-inner-replacement-at
                   (k (lmap-replacements-pointwise-p-witness
                       (ll-context->lmap (%ictx))
                       (ll-context->locals (%ictx))
                       (expr-binder-names (mv-nth 1 (%lp)))
                       genv))))
  :expand ((lmap-replacements-pointwise-p
            (ll-context->lmap (%ictx)) (ll-context->locals (%ictx))
            (expr-binder-names (mv-nth 1 (%lp))) genv))
  :disable (ll-lambda-parts ll-replacement-ok-p lmap-replacements-ok-p))

(defruled keys-of-ll-lambda-parts-tenv-at
  (b* (((mv & & & ictx) (ll-lambda-parts params body type? ctx)))
    (implies (and (set::subset (omap::keys (ll-context->tenv ctx))
                               (ll-context->locals ctx))
                  (set::in k (omap::keys (ll-context->tenv ictx))))
             (set::in k (ll-context->locals ictx))))
  :use (ll-lambda-parts-context
        (:instance omap::in-of-keys-to-assoc
                   (omap::key k)
                   (omap::map (ll-context->tenv
                               (mv-nth 3 (ll-lambda-parts params body
                                                          type? ctx)))))
        (:instance omap::in-of-keys-to-assoc
                   (omap::key k)
                   (omap::map (ll-context->tenv ctx)))
        (:instance set::subset-in (a k)
                   (x (omap::keys (ll-context->tenv ctx)))
                   (y (ll-context->locals ctx))))
  :disable (ll-lambda-parts))

(defruled keys-of-ll-lambda-parts-tenv
  (b* (((mv & & & ictx) (ll-lambda-parts params body type? ctx)))
    (implies (set::subset (omap::keys (ll-context->tenv ctx))
                          (ll-context->locals ctx))
             (set::subset (omap::keys (ll-context->tenv ictx))
                          (ll-context->locals ictx))))
  :enable (set::pick-a-point-subset-strategy keys-of-ll-lambda-parts-tenv-at)
  :disable (ll-lambda-parts))

(defruled ll-context-ok-p-intro
  (implies (b* (((ll-context c) ctx))
             (and (set::subset c.locals c.used)
                  (ll-defs-bound-p (ll-context-lifted x ctx) genv)
                  (genv-agrees-with-init-p genv)
                  (expr-denv-wfp genv)
                  (string-expr-map-closed-p c.lmap)
                  (set::subset (omap::keys c.lmap) c.locals)
                  (lmap-replacements-ok-p c.lmap c.locals (expr-binder-names x)
                                          genv)
                  (not (expr-duplicate-names x))
                  (subsetp-equal (expr-binder-names x) c.used)
                  (not (intersectp-equal (expr-binder-names x) c.locals))
                  (set::subset (omap::keys c.tenv) c.locals)))
           (ll-context-ok-p x ctx genv))
  :enable (ll-context-ok-p))

(defruled lifted-inner-ctx-core
  (implies (and (%lifted-atom-hyps-base)
                (ll-context-ok-p x ctx genv))
           (and (set::subset (ll-context->locals (%ictx))
                             (ll-context->used (%ictx)))
                (genv-agrees-with-init-p genv)
                (expr-denv-wfp genv)
                (string-expr-map-closed-p (ll-context->lmap (%ictx)))
                (set::subset (omap::keys (ll-context->lmap (%ictx)))
                             (ll-context->locals (%ictx)))
                (lmap-replacements-ok-p (ll-context->lmap (%ictx))
                                        (ll-context->locals (%ictx))
                                        (expr-binder-names
                                         (mv-nth 1 (%lp))) genv)
                (not (expr-duplicate-names (mv-nth 1 (%lp))))
                (subsetp-equal (expr-binder-names (mv-nth 1 (%lp)))
                               (ll-context->used (%ictx)))
                (not (intersectp-equal (expr-binder-names (mv-nth 1 (%lp)))
                                       (ll-context->locals (%ictx))))
                (set::subset (omap::keys (ll-context->tenv (%ictx)))
                             (ll-context->locals (%ictx)))))
  :use (ll-context-ok-p-facts
        (:instance keys-of-ll-lambda-parts-tenv (params pa) (body ba)
                   (type? ta))
        (:instance not-intersectp-binders-of-inner
                   (bx (expr-binder-names x)) (locals (ll-context->locals ctx))
                   (pre (var+type?-list->var (%ps)))
                   (bi (expr-binder-names (mv-nth 1 (%lp)))))
        expr-binder-names-of-lifted-atom
        lifted-inner-params-facts
        lifted-inner-lmap-keys
        lifted-inner-replacements
