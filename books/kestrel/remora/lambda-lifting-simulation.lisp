                                     (var+type?-list->var (%hxps))
                                     (%hxdw2)
                                     genv)))
  :use ((:instance walker-of-lifted-closure-env-hx
                   (fvv (atom-free-expr-vars
                         (make-atom-lambda/lambdan pa ba ta))))
        subsetp-of-params-in-ll-lambda-parts-locals-hx
        (:instance expr-value-lambda->denv-of-lambda-closure
                   (params pa) (body ba) (type? ta))
        (:instance expr-value-lambda->denv-of-lambda-closure
                   (params (%hxps)) (body (%hxnb)) (type? (%hxity))
                   (denv
                    (apply-leading-env (%hxcps) (%hxps) (%hxnb) (%hxity) genv
                                            (%hxvs))))
        (:instance names-bound-as-in-p-of-lifted-closure-env
                   (s (set::difference (expr-free-expr-vars (%hxnb))
                                       (ll-context->locals (%hxictx))))
                   (l (ll-context->locals (%hxictx)))
                   (fv (%hxfve)) (tenv (ll-context->tenv (%hxictx)))
                   (nd new-denv) (ps (%hxps)) (nb (%hxnb)) (ity (%hxity)))
        (:instance fve-facts
                   (a (expr-free-expr-vars (%hxnb)))
                   (b (set::mergesort (var+type?-list->var (%hxps))))
                   (c (ll-context->locals (%hxictx))))
        (:instance new-values-meet-types-p-of-lifted-closure-env-hx
                   (s (set::difference
                       (set::intersect (expr-free-expr-vars (%hxnb))
                                       (ll-context->locals (%hxictx)))
                       (set::mergesort (var+type?-list->var (%hxps)))))))
  :expand ((:free (dw2)
                  (expr-denv-ll-related-p (%hxudenv)
                                          (expr-value-lambda->denv
                                           (lambda-closure pa ba ta denv))
                                          ba
                                          (%hxictx)
                                          (var+type?-list->var (%hxps))
                                          dw2
                                          genv)))
  :enable (type-denv-restrict-of-empty expr-denv-restrict)
  :disable (walker-of-lifted-closure-env-hx
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

; The closure that the replacement of a hoisted function evaluates to is
; related to the original closure, without flattening, via the context at
; the function's body.

(defruled lambda-closure-fields-when-closed
  (b* ((u (lambda-closure params b1 type? d1))
       (v (lambda-closure params b2 type? d2)))
    (implies (and (consp params)
                  (set::emptyp (var+type?-free-type-vars (car params)))
                  (set::emptyp (var+type?-free-ispace-vars (car params)))
                  (set::emptyp (type-option-free-type-vars type?))
                  (set::emptyp (type-option-free-ispace-vars type?))
                  (not (reserrp u))
                  (not (reserrp v)))
             (and (equal (expr-value-lambda->param u)
                         (expr-value-lambda->param v))
                  (equal (expr-value-lambda->type? u)
                         (expr-value-lambda->type? v)))))
  :enable (lambda-closure make-atom-lambda/lambdan eval-var+type?
           var+type?->type-or-err eval-type-when-closed
           consp-when-positive-len positive-len-when-consp)
  :expand ((:free (a l d) (eval-atom a d l))
           (var+type?-free-type-vars (car params))
           (var+type?-free-ispace-vars (car params))
           (:free (ty) (type-option-free-type-vars ty))
           (:free (ty) (type-option-free-ispace-vars ty)))
  :cases ((consp (cdr params))))

(defmacro %hxclosure-hyps ()
  '(and (%hxlifted-env-hyps)
        (equal fvv (atom-free-expr-vars (make-atom-lambda/lambdan pa ba ta)))
        (var+type?-listp pa)
        (consp pa)
        (exprp ba)
        (type-optionp ta)
        (not (reserrp (%v)))
        (set::emptyp (var+type?-free-type-vars (car pa)))
        (set::emptyp (var+type?-free-ispace-vars (car pa)))
        (set::emptyp (type-option-free-type-vars ta))
        (set::emptyp (type-option-free-ispace-vars ta))
        (set::emptyp (expr-free-ispace-vars (lambda-curried-body pa ba ta)))
        (set::emptyp (expr-free-type-vars (lambda-curried-body pa ba ta)))
        (set::emptyp (expr-free-ispace-vars
                      (lambda-curried-body pa (%hxnb) ta)))
        (set::emptyp (expr-free-type-vars
                      (lambda-curried-body pa (%hxnb) ta)))
        (no-duplicatesp-equal (var+type?-list->var pa))))

(defruled hoisted-closure-facts
  (implies (%hxclosure-hyps)
           (b* ((u (%hxu)))
             (and (equal (expr-value-kind u) :lambda)
                  (equal (expr-value-kind (%v)) :lambda)
                  (b* (((mv okp inner ity2)
                        (closure-body-parts (expr-value-lambda->body (%v))
                                            (expr-value-lambda->type? (%v))
                                            (cdr pa) nil)))
                    (and okp
                         (equal inner ba)
                         (equal (lifted-closure-body
                                 (cdr pa) (ll-context-new-expr inner (%hxictx))
                                 ity2)
                                (expr-value-lambda->body u))))
                  (equal (expr-value-lambda->param u)
                         (expr-value-lambda->param (%v)))
                  (equal (expr-value-lambda->type? u)
                         (expr-value-lambda->type? (%v)))
                  (names-in-context-p
                   (cons (var+typevalue->var (expr-value-lambda->param (%v)))
                         (var+type?-list->var (cdr pa)))
                   (%hxictx))
                  (param-type-consistent-p (expr-value-lambda->param (%v))
                                           (ll-context->tenv (%hxictx)))
                  (prest-tenv-consistent-p (cdr pa)
                                           (ll-context->tenv (%hxictx))))))
  :use ((:instance expr-value-kind-of-lambda-closure
                   (params pa) (body ba) (type? ta))
        (:instance expr-value-kind-of-lambda-closure
                   (params pa) (body (%hxnb)) (type? ta)
                   (denv (apply-leading-env (%hxcps) pa (%hxnb) ta genv
                                            (%hxvs))))
        (:instance closure-body-parts-of-lambda-curried-body-nonflat
                   (params pa) (body ba) (type? ta)
                   (tyv (expr-value-lambda->type? (%v)))
                   (new-inner (%hxnb)))
        (:instance lambda-closure-when-ok (params pa) (body ba) (type? ta))
        (:instance lambda-closure-when-ok
                   (params pa) (body (%hxnb)) (type? ta)
                   (denv (apply-leading-env (%hxcps) pa (%hxnb) ta genv
                                            (%hxvs))))
        (:instance lambda-closure-fields-when-closed
                   (params pa) (b1 (%hxnb)) (b2 ba) (type? ta)
                   (d1 (apply-leading-env (%hxcps) pa (%hxnb) ta genv (%hxvs)))
                   (d2 denv))
        (:instance names-in-context-p-of-ll-lambda-parts
                   (params pa) (body '(:var "")) (type? nil)
                   (names (var+type?-list->var pa)))
        (:instance param-of-lambda-closure (params pa) (body ba) (type? ta))
        (:instance eval-var+type?-ok-when-lambda-closure-ok
                   (params pa) (body ba) (type? ta))
        (:instance param-type-consistent-p-of-ll-lambda-parts-general
                   (params pa) (body '(:var "")) (type? nil)
                   (tenv (expr-denv->tenv denv)))
        (:instance prest-tenv-consistent-p-of-ll-lambda-parts
                   (params pa) (body '(:var "")) (type? nil)
                   (l (cdr pa))))
  :enable (atomlam-aps)
  :expand ((var+type?-list->var pa))
  :disable (lambda-closure ll-lambda-parts closure-body-parts
            lifted-closure-body lambda-curried-body ll-context-new-expr
            names-in-context-p param-type-consistent-p
            prest-tenv-consistent-p))

(defruled expr-value-ll-related-p-of-nonflat-witness-intro
  (implies (and (equal (expr-value-kind val) :lambda)
                (equal (expr-value-kind new-val) :lambda)
                (var+type?-listp prest)
                (ll-context-p ctx)
                (ll-denv-witness-p dw)
                (mv-nth 0 (closure-body-parts (expr-value-lambda->body val)
                                              (expr-value-lambda->type? val)
                                              prest nil))
                (equal (mv-nth 1 (closure-body-parts
                                  (expr-value-lambda->body val)
                                  (expr-value-lambda->type? val)
                                  prest nil))
                       inner)
                (equal (expr-value-lambda->body new-val)
                       (lifted-closure-body
                        prest
                        (ll-context-new-expr inner ctx)
                        (mv-nth 2 (closure-body-parts
                                   (expr-value-lambda->body val)
                                   (expr-value-lambda->type? val)
                                   prest nil))))
                (equal (expr-value-lambda->param new-val)
                       (expr-value-lambda->param val))
                (equal (expr-value-lambda->type? new-val)
                       (expr-value-lambda->type? val))
                (equal (cons (var+typevalue->var
                              (expr-value-lambda->param val))
                             (var+type?-list->var prest))
                       pnames)
                (no-duplicatesp-equal pnames)
                (names-in-context-p pnames ctx)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        pnames genv)
                (param-type-consistent-p (expr-value-lambda->param val)
                                         (ll-context->tenv ctx))
                (prest-tenv-consistent-p prest (ll-context->tenv ctx))
                (ll-context-ok-p inner ctx genv)
                (expr-denv-ll-related-p (expr-value-lambda->denv new-val)
                                        (expr-value-lambda->denv val)
                                        inner ctx pnames dw genv))
           (expr-value-ll-related-p
            new-val val (ll-value-witness-lambda ctx prest nil dw) genv))
  :use (:instance expr-value-ll-related-p-of-lambda-witness (flat nil))
  :disable (ll-context-ok-p expr-denv-ll-related-p closure-body-parts
            names-in-context-p lmap-replacements-ok-p param-type-consistent-p
            prest-tenv-consistent-p lifted-closure-body expr-value-ll-related-p
            ll-context-new-expr))


(defruled expr-value-ll-related-p-of-hoisted-closure
  (implies (and (%hxclosure-hyps)
                (ll-context-ok-p ba (%hxictx) genv))
           (expr-value-ll-related-p
            (%hxu) (%v)
            (ll-value-witness-lambda (%hxictx) (cdr pa) nil (%hxdw2))
            genv))
  :use (hoisted-closure-facts
        closure-env-related-of-lifted-hx
        atomlam-closure-pnames
        (:instance ll-lambda-parts-replacements-ok
                   (params pa) (body '(:var "")) (type? nil))
        (:instance expr-value-ll-related-p-of-nonflat-witness-intro
                   (new-val (%hxu)) (val (%v)) (ctx (%hxictx))
                   (prest (cdr pa)) (dw (%hxdw2)) (inner ba)
                   (pnames (var+type?-list->var pa))))
  :in-theory (union-theories
              (theory 'minimal-theory)
              '(atomlam-aps
                ll-context-p-of-ll-lambda-parts.inner-ctx
                ll-denv-witness-p-of-ll-denv-witness
                var+type?-listp-of-cdr-when-var+type?-listp)))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; A hoisted binding: the facts of the transform.

(defruled hoist-local-fun-checks
  (b* (((mv hoistedp & def repl new-used)
        (hoist-local-fun b rebound tenv locals used))
       (fv (set::intersect (bind-free-expr-vars b) locals))
       (name (fresh-expr-var (bind-fun->var b) (string-sfix used))))
    (implies hoistedp
             (and (equal (bind-kind b) :fun)
                  (consp (bind-fun->params b))
                  (param-evaluable-p (car (bind-fun->params b)))
                  (type-option-evaluable-p (bind-fun->type? b))
                  (set::emptyp (bind-free-type-vars b))
                  (set::emptyp (bind-free-ispace-vars b))
                  (captured-params-typed-p fv tenv)
                  (equal def (bind-fun name
                                       (append (names-to-params fv tenv)
                                               (bind-fun->params b))
                                       (bind-fun->type? b)
                                       (bind-fun->expr b)))
                  (equal repl (apply-to-names (expr-var name) fv))
                  (equal new-used (set::insert name (string-sfix used))))))
  :enable (hoist-local-fun))

(defruled intersect-of-difference-and-union-local
  (equal (set::intersect (set::difference a p) (set::union p l))
         (set::intersect (set::difference a p) l))
  :enable (set::double-containment set::pick-a-point-subset-strategy))

(defrule tenvs-agree-on-p-of-same
  (tenvs-agree-on-p names tenv tenv)
  :induct (len names)
  :enable (tenvs-agree-on-p len))

(defruled names-to-params-when-tenvs-agree
  (implies (tenvs-agree-on-p names tenv1 tenv2)
           (equal (names-to-params names tenv1)
                  (names-to-params names tenv2)))
  :induct (len names)
  :enable (tenvs-agree-on-p names-to-params len name-to-type-option))

; The pieces of the hoisted binding, in the terms of the closure lemma for
; hoisted functions, with PA, BA, TA the parameters, body, and result type.

(defmacro %hpieces ()
  '(and (equal pa (bind-fun->params b))
        (equal ba (bind-fun->expr b))
        (equal ta (bind-fun->type? b))))

(defruled let-step-hoisted-hoist
  (implies (and (bindp b) (mv-nth 0 (%step)))
           (mv-nth 0 (%hoist)))
  :use ll-let-step-fields
  :disable (ll-bind hoist-local-fun ll-let-step))

(defruled let-step-hoisted-params
  (implies (and (bindp b) (mv-nth 0 (%step)))
           (and (equal (bind-kind b) :fun)
                (consp (bind-fun->params b))))
  :use (let-step-hoisted-facts
        (:instance hoist-local-fun-checks
                   (b (mv-nth 0 (%llb0)))
                   (rebound (append (bind-list-expr-var-binders rest)
                                    (expr-expr-var-binders body)))
                   (tenv (ll-context->tenv ctx))
                   (locals (ll-context->locals ctx))
                   (used (mv-nth 2 (%llb0))))
        (:instance ll-bind-var-when-fun
                   (tenv (ll-context->tenv ctx)) (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx)) (lmap
                                                      (ll-context->lmap ctx))
                   (used (ll-context->used ctx))))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var))

(defruled let-step-hoisted-shape
  (implies (and (%step-hyps) (mv-nth 0 (%step)) (%hpieces))
             (and (equal (bind-kind b) :fun)
                  (consp pa)
                  (var+type?-listp pa)
                  (equal (mv-nth 0 (%llb0)) (bind-fun (bind-fun->var b) pa ta
                                                      (%hxnb)))
                  (equal (%hfv) (%hxfve))
                  (string-setp (%hfv))
                  (equal (mv-nth 2 (%hoist))
                         (bind-fun (%name) (append (%hxcps) pa) ta (%hxnb)))
                  (equal (mv-nth 3 (%hoist))
                         (apply-to-names (expr-var (%name)) (%hxfve)))
                  (captured-params-typed-p (%hxfve) (ll-context->tenv ctx))
                  (param-evaluable-p (car pa))
                  (type-option-evaluable-p ta)
                  (set::emptyp (bind-free-type-vars
                                (bind-fun (bind-fun->var b) pa ta (%hxnb))))
                  (set::emptyp (bind-free-ispace-vars
                                (bind-fun (bind-fun->var b) pa ta (%hxnb))))
                  (not (intersectp-equal (%hxfve) (var+type?-list->var pa)))))
  :use (let-step-hoisted-hoist
        let-step-hoisted-params
        (:instance hoist-local-fun-checks
                   (b (bind-fun (bind-fun->var b) pa ta (%hxnb)))
                   (rebound (append (bind-list-expr-var-binders rest)
                                    (expr-expr-var-binders body)))
                   (tenv (ll-context->tenv ctx))
                   (locals (ll-context->locals ctx))
                   (used (mv-nth 2 (%llb0))))
        (:instance fun-body-context (pa pa))
        atomlam-aps
        (:instance intersect-of-difference-and-union-local
                   (a (expr-free-expr-vars (%hxnb)))
                   (p (set::mergesort (var+type?-list->var pa)))
                   (l (ll-context->locals ctx)))
        (:instance tenvs-agree-on-p-of-ll-lambda-parts
                   (params pa) (body '(:var "")) (type? nil)
                   (names (%hxfve)))
        (:instance names-to-params-when-tenvs-agree
                   (names (%hxfve)) (tenv1 (ll-context->tenv ctx))
                   (tenv2 (ll-context->tenv (%hxictx))))
        (:instance not-intersectp-of-difference-mergesort
                   (s (expr-free-expr-vars (%hxnb)))
                   (l (var+type?-list->var pa))
                   (c (ll-context->locals ctx)))
        (:instance acl2::string-listp-when-string-setp (acl2::x (%hxfve))))
  :expand ((:free (v ps ty e) (bind-free-expr-vars (bind-fun v ps ty e))))
  :enable (locals-with-params bind-name ll-bind-when-fun-params)
  :disable (ll-bind hoist-local-fun ll-let-step ll-lambda-parts
            ll-context-new-expr fresh-expr-var
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

; The replacement of a hoisted function, evaluated with its definition's
; name bound as at the top, is the definition's closure applied to the
; captured values.

(defruled lookup-exprs-when-lookups-agree
  (implies (lookups-agree-p names d1 d2)
           (equal (expr-denv-lookup-exprs names d1)
                  (expr-denv-lookup-exprs names d2)))
  :induct (len names)
  :enable (lookups-agree-p expr-denv-lookup-exprs len))

(defruled lookups-agree-p-of-with-names-from-other
  (implies (and (string-listp names)
                (stringp h)
                (not (member-equal h names)))
           (lookups-agree-p names
                            (expr-denv-with-names-from (set::insert h nil) nd g)
                            nd))
  :induct (len names)
  :enable (lookups-agree-p len lookup-of-expr-denv-with-names-from))

(defruled eval-hoisted-replacement
  (b* ((cps (names-to-params fv tenv))
       (vs (expr-denv-lookup-exprs fv nd)))
    (implies (and (string-setp fv)
                  (stringp name)
                  (not (set::in name fv))
                  (equal (expr-denv-lookup-expr name genv)
                         (lambda-closure (append cps ps) nb ity genv))
                  (not (reserrp (expr-denv-lookup-expr name genv)))
                  (consp ps)
                  (apply-leading-ok-p cps ps nb ity genv vs)
                  (not (reserrp vs))
                  (expr-denv-wfp genv)
                  (integerp l)
                  (<= (+ 7 (len fv)) l))
             (equal (eval-expr (apply-to-names (expr-var name) fv)
                               (expr-denv-with-names-from (set::insert name nil)
                                                          nd genv)
                               l)
                    (lambda-closure ps nb ity
                                    (apply-leading-env cps ps nb ity genv
                                                       vs)))))
  :cases ((consp fv))
  :use ((:instance eval-app-of-lambda-closure-leading
                   (cps (names-to-params fv tenv)) (body nb) (type? ity)
                   (denv genv) (vs (expr-denv-lookup-exprs fv nd))
                   (limit (1- l)))
        (:instance lookups-agree-p-of-with-names-from-other
                   (names fv) (h name) (g genv))
        (:instance lookup-exprs-when-lookups-agree
                   (names fv)
                   (d1
                    (expr-denv-with-names-from (set::insert name nil) nd genv))
                   (d2 nd))
        (:instance lookup-of-expr-denv-with-names-from
                   (n name) (names (set::insert name nil)) (d nd) (g genv))
        (:instance acl2::string-listp-when-string-setp (acl2::x fv))
        (:instance set::in-to-member (a name) (x fv)))
  :enable (apply-leading-env names-to-params
           expr-denv-lookup-exprs eval-expr-when-var-kind
           len-of-names-to-params-local)
  :disable
  (lambda-closure apply-to-names set::in-to-member
   set::intersect-under-set-equiv set::difference-under-set-equiv
   set::mergesort-under-set-equiv acl2::set-equiv-implies-equal-consp-1)
  :prep-lemmas
  ((defrule len-of-names-to-params-local
     (equal (len (names-to-params names tenv)) (len names))
     :induct (len names)
     :enable (names-to-params len))))

(defruled closed-parts-of-bind-fun
  (implies (and (set::emptyp (bind-free-type-vars (bind-fun v ps ty e)))
                (set::emptyp (bind-free-ispace-vars (bind-fun v ps ty e))))
           (and (%closed-t/i var+type?-list ps)
                (%closed-t/i expr e)
                (%closed-t/i type-option ty)))
  :expand ((bind-free-type-vars (bind-fun v ps ty e))
           (bind-free-ispace-vars (bind-fun v ps ty e))))

(defruled closed-first-param-local
  (implies (and (consp ps) (%closed-t/i var+type?-list ps))
           (%closed-t/i var+type? (car ps)))
  :expand ((var+type?-list-free-type-vars ps)
           (var+type?-list-free-ispace-vars ps)))

; The values of the initial environment are primitive operations.

(define map-all-primop-values-p ((m string-expr-value-mapp))
  :returns (yes/no booleanp)
  :verify-guards nil
  (b* ((m (string-expr-value-map-fix m))
       ((when (omap::emptyp m)) t))
    (and (expr-value-case (omap::head-val m) :primop)
         (map-all-primop-values-p (omap::tail m))))
  :measure (acl2-count (string-expr-value-map-fix m)))

(defruled primop-when-assoc-in-all-primop-map
  (implies (and (map-all-primop-values-p m)
                (string-expr-value-mapp m)
                (omap::assoc k m))
           (equal (expr-value-kind (cdr (omap::assoc k m))) :primop))
  :induct (map-all-primop-values-p m)
  :enable (map-all-primop-values-p omap::assoc))

(defruled init-expr-denv-all-primop
  (map-all-primop-values-p (expr-denv->exprs (init-expr-denv)))
  :enable ((:e map-all-primop-values-p) (:e init-expr-denv)
           (:e expr-denv->exprs)))

(defruled lookup-in-init-is-primop
  (implies (not (reserrp (expr-denv-lookup-expr n (init-expr-denv))))
           (equal (expr-value-kind (expr-denv-lookup-expr n (init-expr-denv)))
                  :primop))
  :use (init-expr-denv-all-primop
        (:instance primop-when-assoc-in-all-primop-map
                   (m (expr-denv->exprs (init-expr-denv))) (k (str-fix n))))
  :enable (expr-denv-lookup-expr)
  :disable ((:e init-expr-denv)))

; The name of a hoisted definition is not bound by the original environment
; to a variable free in the expression: it is not local, so the value there
; would be the primitive operation of that name, but GENV binds primitive
; operations as the initial environment does and the name to a closure.

(defruled expr-valuep-of-assoc-in-value-map-local
  (implies (and (string-expr-value-mapp m) (omap::assoc k m))
           (and (expr-valuep (cdr (omap::assoc k m)))
                (not (reserrp (cdr (omap::assoc k m))))))
  :induct (ll-map-ind m)
  :enable (omap::assoc not-reserrp-when-expr-valuep))

(defruled walker-nonlocal-entry-is-init
  (implies (and (string-expr-value-map-ll-related-p nd map fvx nfv ctx dw genv)
                (string-expr-value-mapp map)
                (set::in lam fvx)
                (omap::assoc lam map)
                (not (set::in lam (ll-context->locals ctx))))
           (equal (expr-denv-lookup-expr lam (init-expr-denv))
                  (cdr (omap::assoc lam map))))
  :use ((:instance walker-ll-var-ok-p-at (new-denv nd) (var lam) (fv fvx)))
  :enable (ll-var-ok-p)
  :disable (expr-value-ll-related-p value-meets-required-type-p
            value-has-inferred-type-p eval-expr (:e init-expr-denv)))

(defrule hoisted-name-not-entry
  (implies (and (string-expr-value-map-ll-related-p nd map fvx nfv ctx dw genv)
                (string-expr-value-mapp map)
                (set::in lam fvx)
                (omap::assoc lam map)
                (not (set::in lam (ll-context->locals ctx)))
                (genv-agrees-with-init-p genv)
                (equal (expr-value-kind (expr-denv-lookup-expr lam genv))
                       :lambda))
           nil)
  :rule-classes nil
  :use (walker-nonlocal-entry-is-init
        (:instance expr-valuep-of-assoc-in-value-map-local (m map) (k lam))
        (:instance lookup-in-genv-when-agrees-with-init (v lam))
        (:instance lookup-in-init-is-primop (n lam)))
  :disable (walker-nonlocal-entry-is-init (:e init-expr-denv)
            string-expr-value-map-ll-related-p))

(defruled in-nfv-when-subset-of-insert-local
  (implies (and (set::subset a (set::insert lam fve))
                (set::subset fve nfv)
                (not (set::in lam a))
                (set::in e a))
           (set::in e nfv))
  :use ((:instance set::subset-in (a e) (x a) (y (set::insert lam fve)))
        (:instance set::subset-in (a e) (x fve) (y nfv))))

(defruled subset-of-nfv-when-subset-of-insert-local
  (implies (and (set::subset a (set::insert lam fve))
                (set::subset fve nfv)
                (not (set::in lam a)))
           (set::subset a nfv))
  :enable (set::pick-a-point-subset-strategy
           in-nfv-when-subset-of-insert-local))

(defruled ll-var-ok-p-of-fewer-referred
  (implies (and (ll-var-ok-p w val nd nfv ctx dw genv)
                (not (equal w lam))
                (set::subset fve nfv)
                (not (set::in lam (ll-context->locals ctx))))
           (ll-var-ok-p w val nd (set::insert lam fve) ctx dw genv))
  :use ((:instance subset-of-nfv-when-subset-of-insert-local
                   (a (set::intersect
                       (expr-free-expr-vars
                        (cdr (omap::assoc w (ll-context->lmap ctx))))
                       (ll-context->locals ctx))))
        (:instance set::subset-in (a w) (x fve) (y nfv)))
  :enable (ll-var-ok-p)
  :disable (expr-value-ll-related-p value-meets-required-type-p
            value-has-inferred-type-p eval-expr
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled walker-for-hoisted-closure
  (implies (and (string-expr-value-map-ll-related-p nd map fvx nfv ctx dw genv)
                (string-expr-value-mapp map)
                (set::subset fve nfv)
                (not (set::in lam (ll-context->locals ctx)))
                (implies (set::in lam fvx) (not (omap::assoc lam map))))
           (string-expr-value-map-ll-related-p nd map fvx (set::insert lam fve)
                                               ctx dw genv))
  :use ((:instance string-expr-value-map-ll-related-p-when-pointwise
                   (new-denv nd) (nfv (set::insert lam fve)) (fv fvx))
        (:instance walker-ll-var-ok-p-at
                   (new-denv nd) (fv fvx)
                   (var (walker-pointwise-p-witness nd map fvx
                                                    (set::insert lam fve)
                                                    ctx dw genv)))
        (:instance ll-var-ok-p-of-fewer-referred
                   (w (walker-pointwise-p-witness nd map fvx
                                                  (set::insert lam fve)
                                                  ctx dw genv))
                   (val (cdr (omap::assoc (walker-pointwise-p-witness
                                           nd map fvx (set::insert lam fve)
                                           ctx dw genv)
                                          map)))))
  :expand ((walker-pointwise-p nd map fvx (set::insert lam fve) ctx dw genv))
  :disable (ll-var-ok-p walker-pointwise-p-necc))

; The other variables, in the context after a hoisted binding: the map
; binds the hoisted variable to its replacement, and the limit of the
; witness is larger.

(defruled eval-replacement-at-larger-limit-local
  (implies (and (not (reserrp (eval-expr e d l)))
                (natp l2)
                (<= l l2))
           (equal (eval-expr e d l2) (eval-expr e d l)))
  :use ((:instance eval-expr-at-larger-limit (expr e) (denv d) (limit l)
                   (limit2 l2))))

(defruled ll-var-types-ok-p-of-hctx
  (implies (and (ll-var-types-ok-p v val ctx)
                (stringp v)
                (not (equal v v0))
                (tenv-agrees-off-p (ll-context->tenv ctx2)
                                   (ll-context->tenv ctx)
                                   v0)
                (equal (set::delete v0 (ll-context->tlets ctx2))
                       (set::delete v0 (ll-context->tlets ctx)))
                (equal (ll-context->locals ctx2)
                       (set::insert v0 (ll-context->locals ctx))))
           (ll-var-types-ok-p v val ctx2))
  :use ((:instance tenv-agrees-off-p-necc
                   (tenv2 (ll-context->tenv ctx2)) (tenv (ll-context->tenv ctx))
                   (n v))
        (:instance set::delete-in (a v) (b v0) (x (ll-context->tlets ctx2)))
        (:instance set::delete-in (a v) (b v0) (x (ll-context->tlets ctx)))
        (:instance value-meets-required-type-p-when-same-type-option
                   (tenv2 (ll-context->tenv ctx2)) (tenv
                                                    (ll-context->tenv ctx)))
        (:instance value-has-inferred-type-p-when-same-type-option
                   (tenv2 (ll-context->tenv ctx2)) (tenv
                                                    (ll-context->tenv ctx))))
  :enable (ll-var-types-ok-p)
  :disable (set::delete-in tenv-agrees-off-p tenv-agrees-off-p-necc
            value-meets-required-type-p value-has-inferred-type-p))

(defruled ll-var-referred-ok-p-of-hctx
  (implies (and (ll-var-referred-ok-p v val nd nfv ctx dw genv)
                (stringp v)
                (not (equal v v0))
                (tenv-agrees-off-p (ll-context->tenv ctx2)
                                   (ll-context->tenv ctx)
                                   v0)
                (equal (set::delete v0 (ll-context->tlets ctx2))
                       (set::delete v0 (ll-context->tlets ctx)))
                (equal (ll-context->locals ctx2)
                       (set::insert v0 (ll-context->locals ctx)))
                (equal (omap::assoc v (ll-context->lmap ctx2))
                       (omap::assoc v (ll-context->lmap ctx)))
                (implies (omap::assoc v (ll-context->lmap ctx))
                         (not (set::in v0 (expr-free-expr-vars
                                           (cdr (omap::assoc
                                                 v (ll-context->lmap ctx)))))))
                (stringp v0)
                (natp l2)
                (<= (ll-denv-witness->limit dw) l2))
           (ll-var-referred-ok-p v val nd nfv ctx2
                                 (ll-denv-witness-add
                         v0 w (change-ll-denv-witness dw :limit l2))
                                 genv))
  :use ((:instance tenv-agrees-off-p-necc
                   (tenv2 (ll-context->tenv ctx2)) (tenv (ll-context->tenv ctx))
                   (n v))
        (:instance set::delete-in (a v) (b v0) (x (ll-context->tlets ctx2)))
        (:instance set::delete-in (a v) (b v0) (x (ll-context->tlets ctx)))
        (:instance value-meets-required-type-p-when-same-type-option
                   (tenv2 (ll-context->tenv ctx2)) (tenv
                                                    (ll-context->tenv ctx)))
        (:instance value-has-inferred-type-p-when-same-type-option
                   (tenv2 (ll-context->tenv ctx2)) (tenv
                                                    (ll-context->tenv ctx)))
        (:instance intersect-of-insert-when-not-in-local
                   (s (expr-free-expr-vars
                       (cdr (omap::assoc v (ll-context->lmap ctx)))))
                   (l (ll-context->locals ctx)))
        (:instance difference-of-insert-when-not-in-local
                   (s (expr-free-expr-vars
                       (cdr (omap::assoc v (ll-context->lmap ctx)))))
                   (l (ll-context->locals ctx)))
        (:instance eval-replacement-at-larger-limit-local
                   (e (cdr (omap::assoc v (ll-context->lmap ctx))))
                   (d (expr-denv-with-names-from
                       (set::difference
                        (expr-free-expr-vars
                         (cdr (omap::assoc v (ll-context->lmap ctx))))
                        (ll-context->locals ctx))
                       nd genv))
                   (l (ll-denv-witness->limit dw))))
  :enable (ll-var-referred-ok-p)
  :disable (set::delete-in tenv-agrees-off-p tenv-agrees-off-p-necc
            value-meets-required-type-p value-has-inferred-type-p
            expr-value-ll-related-p eval-expr
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled ll-var-ok-p-of-hctx
  (implies (and (ll-var-ok-p v val nd nfv ctx dw genv)
                (stringp v)
                (not (equal v v0))
                (tenv-agrees-off-p (ll-context->tenv ctx2)
                                   (ll-context->tenv ctx)
                                   v0)
                (equal (set::delete v0 (ll-context->tlets ctx2))
                       (set::delete v0 (ll-context->tlets ctx)))
                (equal (ll-context->locals ctx2)
                       (set::insert v0 (ll-context->locals ctx)))
                (equal (omap::assoc v (ll-context->lmap ctx2))
                       (omap::assoc v (ll-context->lmap ctx)))
                (implies (omap::assoc v (ll-context->lmap ctx))
                         (not (set::in v0 (expr-free-expr-vars
                                           (cdr (omap::assoc
                                                 v (ll-context->lmap ctx)))))))
                (stringp v0)
                (natp l2)
                (<= (ll-denv-witness->limit dw) l2))
           (ll-var-ok-p v val nd nfv ctx2
                        (ll-denv-witness-add
                         v0 w (change-ll-denv-witness dw :limit l2))
                        genv))
  :use (ll-var-referred-ok-p-of-hctx
        ll-var-types-ok-p-of-hctx
        (:instance ll-var-ok-p-split
                   (var v) (new-denv nd) (ctx ctx2)
                   (dw (ll-denv-witness-add
                         v0 w (change-ll-denv-witness dw :limit l2))))
        (:instance ll-var-ok-p-split (var v) (new-denv nd)))
  :in-theory (theory 'minimal-theory))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; A hoisted binding: its replacement evaluates to a closure related to the
; original one.

(defmacro %hstep-hyps ()
  '(and (%step-hyps)
        (mv-nth 0 (%step))
        (%hpieces)
        (equal lam (%name))))

(defmacro %hnfvx ()
  '(expr-free-expr-vars
    (ll-context-new-expr (expr-let (cons b rest) body) ctx)))

(defruled hoisted-closed-new-parts
  (implies (%hstep-hyps)
           (and (%closed-t/i var+type?-list pa)
                (%closed-t/i type-option ta)
                (%closed-t/i expr (%hxnb))))
  :use (let-step-hoisted-shape
        (:instance closed-parts-of-bind-fun
                   (v (bind-fun->var b)) (ps pa) (ty ta) (e (%hxnb))))
  :disable (ll-bind hoist-local-fun ll-let-step ll-lambda-parts
            ll-context-new-expr ll-context-ok-p))

(defruled hoisted-closed-ba
  (implies (%hstep-hyps)
           (%closed-t/i expr ba))
  :use (let-step-hoisted-shape
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance lmap-closed-p-when-string-expr-map-closed-p
                   (m (ll-context->lmap ctx)))
        (:instance free-type/ispace-vars-of-ll-bind
                   (x b) (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx)) (used (ll-context->used ctx))))
  :expand ((bind-free-type-vars b) (bind-free-ispace-vars b))
  :disable
  (ll-bind hoist-local-fun ll-let-step ll-lambda-parts ll-context-new-expr
   ll-context-ok-p free-type/ispace-vars-of-ll-bind)
  :enable (ll-bind-when-fun-params let-step-hoisted-params))

(defruled hoisted-closedness
  (implies (%hstep-hyps)
           (and (%closed-t/i var+type?-list pa)
                (%closed-t/i var+type? (car pa))
                (%closed-t/i type-option ta)
                (%closed-t/i expr (%hxnb))
                (%closed-t/i expr ba)
                (%closed-t/i expr (lambda-curried-body pa ba ta))
                (%closed-t/i expr (lambda-curried-body pa (%hxnb) ta))))
  :use (hoisted-closed-new-parts hoisted-closed-ba let-step-hoisted-params
        (:instance closed-first-param-local (ps pa))
        (:instance closed-lambda-curried-body (params pa) (body ba) (type? ta))
        (:instance closed-lambda-curried-body
                   (params pa) (body (%hxnb)) (type? ta)))
  :disable (ll-bind hoist-local-fun ll-let-step ll-lambda-parts
            ll-context-new-expr ll-context-ok-p lambda-curried-body))

(defruled lifted-def-lookup-of-fun
  (implies (and (ll-defs-bound-p defs genv)
                (member-equal def defs)
                (equal def (bind-fun nm ps ty bd))
                (consp ps)
                (stringp nm)
                (var+type?-listp ps)
                (type-optionp ty)
                (exprp bd))
           (and (equal (expr-denv-lookup-expr nm genv)
                       (lambda-closure ps bd ty genv))
                (not (reserrp (lambda-closure ps bd ty genv)))
                (equal (expr-value-kind (expr-denv-lookup-expr nm genv))
                       :lambda)))
  :use ((:instance lookup-of-lifted-def-in-genv (def (bind-fun nm ps ty bd)))
        (:instance lambda-closure-ok-when-eval-bind-ok
                   (bind (bind-fun nm ps ty bd)) (denv genv) (limit 1))
        (:instance ll-defs-bound-p-member-eval-bind-ok
                   (def (bind-fun nm ps ty bd)))
        (:instance expr-value-kind-of-lambda-closure
                   (params ps) (body bd) (type? ty) (denv genv)))
  :disable (lambda-closure ll-defs-bound-p eval-bind))

(defruled hoisted-def-member-of-lifted
  (implies (and (bindp b) (bind-listp rest) (exprp body)
                (mv-nth 0 (%hoist)))
           (member-equal (mv-nth 2 (%hoist))
                         (ll-context-lifted (expr-let (cons b rest) body) ctx)))
  :use let-step-lifted
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-lifted))

(defruled hoisted-def-closure
  (implies (%hstep-hyps)
           (and (stringp lam)
                (not (set::in lam (ll-context->locals ctx)))
                (equal (expr-denv-lookup-expr lam genv)
                       (lambda-closure (append (%hxcps) pa) (%hxnb) ta genv))
                (not (reserrp (lambda-closure (append (%hxcps) pa) (%hxnb) ta
                                              genv)))
                (equal (expr-value-kind (expr-denv-lookup-expr lam genv))
                       :lambda)))
  :use (let-step-hoisted-shape let-step-name-fresh let-step-hoisted-hoist
        hoisted-def-member-of-lifted
        (:instance ll-context-ok-p-facts-nb (x (expr-let (cons b rest) body)))
        (:instance lifted-def-lookup-of-fun
                   (defs (ll-context-lifted (expr-let (cons b rest) body) ctx))
                   (def (mv-nth 2 (%hoist))) (nm (%name)) (ps
                                                           (append (%hxcps)
                                                                   pa)) (ty ta)
                   (bd (%hxnb))))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var lambda-closure
            ll-defs-bound-p ll-lambda-parts ll-context-new-expr
            ll-context-ok-p ll-context-lifted no-duplicatesp-equal
            member-equal))

(defruled hoisted-fve-local
  (implies (%hstep-hyps)
           (set::subset (%hxfve) (ll-context->locals ctx)))
  :use (let-step-hoisted-shape
        (:instance subset-of-intersect-right-local-set
                   (a (bind-free-expr-vars (mv-nth 0 (%llb0))))
                   (b (ll-context->locals ctx))))
  :disable (ll-bind hoist-local-fun ll-let-step ll-lambda-parts
            ll-context-new-expr ll-context-ok-p ll-bind-when-fun-params)
  :prep-lemmas
  ((defrule subset-of-intersect-right-local-set
     (set::subset (set::intersect a b) b)
     :enable (set::pick-a-point-subset-strategy))))

(defruled subset-of-intersect-of-both-local
  (implies (and (set::subset a b) (set::subset a c))
           (set::subset a (set::intersect b c)))
  :enable (set::pick-a-point-subset-strategy set::subset-in))

(defruled hoisted-apply-ok
  (implies (and (%hstep-hyps)
                (set::subset (%hxfve) (%hnfvx))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (expr-denv-wfp new-denv))
           (and (apply-leading-ok-p (%hxcps) pa (%hxnb) ta genv (%hxvs))
                (not (reserrp (%hxvs)))
                (not (reserrp (%hxu)))))
  :use (let-step-hoisted-shape hoisted-closedness atomlam-aps hoisted-fve-local
        (:instance subset-of-intersect-of-both-local
                   (a (%hxfve)) (b (%hnfvx)) (c (ll-context->locals ctx)))
        (:instance tenvs-agree-on-p-of-ll-lambda-parts
                   (params pa) (body '(:var "")) (type? nil)
                   (names (%hxfve)))
        (:instance names-to-params-when-tenvs-agree
                   (names (%hxfve)) (tenv1 (ll-context->tenv ctx))
                   (tenv2 (ll-context->tenv (%hxictx))))
        (:instance captured-values-ok-p-when-checked
                   (fv (%hxfve)) (tenv2 (ll-context->tenv ctx))
                   (nd new-denv) (tenv (ll-context->tenv ctx))
                   (names (set::intersect (%hnfvx) (ll-context->locals ctx))))
        (:instance apply-leading-ok-p-of-captured
                   (fv (%hxfve)) (tenv (ll-context->tenv ctx)) (nd new-denv)
                   (ps pa) (nb (%hxnb)) (ity ta) (e genv))
        (:instance lookup-exprs-ok-when-captured-values-ok-p
                   (fv (%hxfve)) (tenv (ll-context->tenv ctx)) (nd new-denv))
        (:instance lambda-closure-ok-when-evaluable
                   (params pa) (body (%hxnb)) (type? ta)
                   (denv (apply-leading-env (%hxcps) pa (%hxnb) ta genv
                                            (%hxvs))))
        (:instance acl2::string-listp-when-string-setp (acl2::x (%hxfve)))
        (:instance fve-facts
                   (a (expr-free-expr-vars (%hxnb)))
                   (b (set::mergesort (var+type?-list->var pa)))
                   (c (ll-context->locals (%hxictx)))))
  :expand ((expr-denv-ll-related-p new-denv denv (expr-let (cons b rest) body)
                                   ctx nil dw genv))
  :enable (let-step-hoisted-shape hoisted-closedness atomlam-aps
           hoisted-fve-local subset-of-intersect-when-subset
           set::subset-transitive)
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var lambda-closure
            ll-lambda-parts ll-context-new-expr ll-context-ok-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))


(defruled free-of-hoisted-replacement
  (implies (and (stringp lam) (string-setp fve))
           (equal (expr-free-expr-vars (apply-to-names (expr-var lam) fve))
                  (set::insert lam fve)))
  :use ((:instance union-of-singleton-local (a lam) (s fve)))
  :expand ((expr-free-expr-vars (expr-var lam))))

(defruled insert-intersect-subset-local
  (implies (and (set::subset fve nfv)
                (not (set::in lam l)))
           (set::subset (set::intersect (set::insert lam fve) l)
                        (set::intersect nfv l)))
  :enable (set::pick-a-point-subset-strategy set::subset-in))

(defruled fun-binders-local
  (implies (equal (bind-kind b) :fun)
           (equal (bind-binder-names b)
                  (append (var+type?-list->var (bind-fun->params b))
                          (expr-binder-names (bind-fun->expr b)))))
  :expand ((bind-binder-names b)))

(defruled fun-free-local
  (implies (equal (bind-kind b) :fun)
           (equal (bind-free-expr-vars b)
                  (set::difference (expr-free-expr-vars (bind-fun->expr b))
                                   (set::mergesort (var+type?-list->var
                                                    (bind-fun->params b))))))
  :expand ((bind-free-expr-vars b)))

(defruled hoisted-hyps-walker
  (implies (and (%hstep-hyps)
                (set::subset (%hxfve) (%hnfvx))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (not (reserrp (eval-bind b denv limit)))
                (expr-denv-wfp new-denv))
           (string-expr-value-map-ll-related-p
            new-denv (expr-denv->exprs denv)
            (expr-free-expr-vars (expr-let (cons b rest) body))
            (expr-free-expr-vars (apply-to-names (expr-var lam) (%hxfve)))
            ctx dw genv))
  :use (hoisted-def-closure
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance free-of-hoisted-replacement (fve (%hxfve)))
        (:instance walker-for-hoisted-closure
                   (nd new-denv) (map (expr-denv->exprs denv))
                   (fvx (expr-free-expr-vars (expr-let (cons b rest) body)))
                   (nfv (%hnfvx)) (fve (%hxfve)))
        (:instance hoisted-name-not-entry
                   (nd new-denv) (map (expr-denv->exprs denv))
                   (fvx (expr-free-expr-vars (expr-let (cons b rest) body)))
                   (nfv (%hnfvx))))
  :expand ((expr-denv-ll-related-p new-denv denv (expr-let (cons b rest) body)
                                   ctx nil dw genv))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var
            ll-lambda-parts ll-context-new-expr ll-context-ok-p apply-to-names
            make-atom-lambda/lambdan eval-atom lambda-curried-body
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled hoisted-hyps-new-values
  (implies (and (%hstep-hyps)
                (set::subset (%hxfve) (%hnfvx))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (not (reserrp (eval-bind b denv limit)))
                (expr-denv-wfp new-denv))
           (new-values-meet-types-p
            (set::intersect (expr-free-expr-vars
                             (apply-to-names (expr-var lam) (%hxfve)))
                            (ll-context->locals ctx))
            new-denv (ll-context->tenv ctx)))
  :use (let-step-hoisted-shape hoisted-def-closure
        (:instance free-of-hoisted-replacement (fve (%hxfve)))
        (:instance insert-intersect-subset-local
                   (fve (%hxfve)) (nfv (%hnfvx)) (l (ll-context->locals ctx))))
  :expand ((expr-denv-ll-related-p new-denv denv (expr-let (cons b rest) body)
                                   ctx nil dw genv))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var
            ll-lambda-parts ll-context-new-expr ll-context-ok-p apply-to-names
            make-atom-lambda/lambdan eval-atom lambda-curried-body
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled hoisted-hyps-fvv
  (implies (%hstep-hyps)
           (set::subset (set::intersect
