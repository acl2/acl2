(defmacro %llpf ()
  '(ll-expr (%pf) (ll-context->tenv ctx) (ll-context->tlets ctx)
            (ll-context->locals ctx) (ll-context->lmap ctx)
            (ll-context->used ctx)))

(defmacro %pctx1 () '(change-ll-context ctx :used (mv-nth 2 (%llpf))))

(defmacro %pnf () '(ll-context-new-expr (%pf) ctx))

(defmacro %pnas () '(ll-context-new-exprs (%pas) (%pctx1)))

(defruled appn-ll-facts
  (implies (equal (expr-kind x) :appn)
           (and (equal (ll-context-new-expr x ctx)
                       (expr-appn (%pnf) (%pnas)))
                (equal (ll-context-lifted x ctx)
                       (append (ll-context-lifted (%pf) ctx)
                               (mv-nth 1 (ll-expr-list
                                          (%pas)
                                          (ll-context->tenv ctx)
                                          (ll-context->tlets ctx)
                                          (ll-context->locals ctx)
                                          (ll-context->lmap ctx)
                                          (mv-nth 2 (%llpf))))))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-expr x tenv tlets locals lmap used)))
  :enable (ll-context-new-expr ll-context-lifted ll-context-new-exprs)
  :disable (ll-expr-list))

(defruled free-and-binders-of-appn
  (implies (<= 2 (len as))
           (and (equal (expr-free-expr-vars (expr-appn f as))
                       (set::union (expr-free-expr-vars f)
                                   (expr-free-expr-vars (expr-bracket as))))
                (equal (expr-binder-names (expr-appn f as))
                       (append (expr-binder-names f)
                               (expr-binder-names (expr-bracket as))))))
  :use ((:instance consp-cdr-when-len-at-least-2 (l as)))
  :expand ((expr-free-expr-vars (expr-appn f as))
           (expr-binder-names (expr-appn f as))
           (expr-free-expr-vars (expr-bracket as))
           (expr-binder-names (expr-bracket as))))

(defruled expr-fix-when-appn-local
  (implies (and (exprp x) (equal (expr-kind x) :appn))
           (equal (expr-appn (expr-appn->fun x) (expr-appn->args x)) x)))

(defruled appn-shape
  (implies (and (exprp x) (equal (expr-kind x) :appn))
           (and (consp (%pas))
                (equal (expr-free-expr-vars x)
                       (set::union (expr-free-expr-vars (%pf))
                                   (expr-free-expr-vars
                                    (expr-bracket (%pas)))))
                (equal (expr-binder-names x)
                       (append (expr-binder-names (%pf))
                               (expr-binder-names (expr-bracket (%pas)))))
                (equal (ll-context-lifted x ctx)
                       (append (ll-context-lifted (%pf) ctx)
                               (ll-context-lifted (expr-bracket (%pas))
                                                  (%pctx1))))
                (equal (ll-context-new-expr x ctx)
                       (expr-appn (%pnf) (%pnas)))
                (equal (expr-free-expr-vars (expr-appn (%pnf) (%pnas)))
                       (set::union (expr-free-expr-vars (%pnf))
                                   (expr-free-expr-vars
                                    (ll-context-new-expr (expr-bracket (%pas))
                                                         (%pctx1)))))))
  :use (appn-ll-facts
        (:instance expr-appn-requirements (x x))
        (:instance free-and-binders-of-appn (f (%pf)) (as (%pas)))
        (:instance free-and-binders-of-appn (f (%pnf)) (as (%pnas)))
        (:instance expr-fix-when-appn-local)
        (:instance ll-context-new-expr-of-bracket
                   (exprs (%pas)) (ctx (%pctx1)))
        (:instance len-of-ll-context-new-exprs-local
                   (exprs (%pas)) (ctx (%pctx1)))
        (:instance consp-cdr-when-len-at-least-2 (l (%pas))))
  :in-theory (disable ll-expr ll-expr-list ll-context-new-expr
                      ll-context-lifted ll-context-new-exprs
                      equal-of-expr-appn equal-of-expr-bracket))

(defruled used-of-appn-step
  (set::subset (ll-context->used ctx) (ll-context->used (%pctx1)))
  :use ((:instance used-of-ll-expr
                   (x (%pf))
                   (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx))
                   (used (ll-context->used ctx))))
  :disable (ll-expr))

(defruled appn-fun-parts
  (implies (and (exprp x)
                (equal (expr-kind x) :appn)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (and (expr-denv-ll-related-p new-denv denv (%pf) ctx nil dw genv)
                (ll-context-ok-p (%pf) ctx genv)))
  :use (appn-shape
        (:instance ll-defs-bound-p-when-ll-context-ok-p)
        (:instance no-duplicate-binders-when-ll-context-ok-p)
        (:instance expr-denv-ll-related-p-of-sub
                   (y (%pf)) (ctx2 ctx) (excl nil) (excl2 nil))
        (:instance ll-context-ok-p-of-part (y (%pf)) (ctx2 ctx)))
  :in-theory (e/d (appn-shape)
                      (ll-expr ll-expr-list expr-denv-ll-related-p
                      ll-context-ok-p ll-context-new-expr ll-context-lifted
                      ll-context-new-exprs equal-of-expr-appn)))

(defruled appn-args-parts
  (implies (and (exprp x)
                (equal (expr-kind x) :appn)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (and (expr-denv-ll-related-p new-denv denv (expr-bracket (%pas))
                                        (%pctx1) nil dw genv)
                (ll-context-ok-p (expr-bracket (%pas)) (%pctx1) genv)))
  :use (appn-shape
        used-of-appn-step
        (:instance ll-defs-bound-p-when-ll-context-ok-p)
        (:instance no-duplicate-binders-when-ll-context-ok-p)
        (:instance expr-denv-ll-related-p-of-sub
                   (y (expr-bracket (%pas))) (ctx2 (%pctx1))
                   (excl nil) (excl2 nil))
        (:instance ll-context-ok-p-of-part
                   (y (expr-bracket (%pas))) (ctx2 (%pctx1))))
  :in-theory (e/d (appn-shape)
                      (ll-expr ll-expr-list expr-denv-ll-related-p
                      ll-context-ok-p ll-context-new-expr ll-context-lifted
                      ll-context-new-exprs equal-of-expr-appn)))

(defruled appn-parts
  (implies (and (exprp x)
                (equal (expr-kind x) :appn)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (and (expr-denv-ll-related-p new-denv denv (%pf) ctx nil dw genv)
                (ll-context-ok-p (%pf) ctx genv)
                (expr-denv-ll-related-p new-denv denv (expr-bracket (%pas))
                                        (%pctx1) nil dw genv)
                (ll-context-ok-p (expr-bracket (%pas)) (%pctx1) genv)))
  :use (appn-fun-parts appn-args-parts)
  :in-theory (theory 'minimal-theory))

(defruled eval-expr-when-appn-ok-local
  (implies (and (equal (expr-kind x) :appn)
                (not (reserrp (eval-expr x denv limit))))
           (and (not (zp limit))
                (not (reserrp (eval-expr (%pf) denv (1- limit))))
                (not (reserrp (eval-expr-list (%pas) denv (1- limit))))
                (equal (eval-expr x denv limit)
                       (eval-app (eval-expr (%pf) denv (1- limit))
                                 (eval-expr-list (%pas) denv (1- limit))
                                 (1- limit)))))
  :expand ((eval-expr x denv limit)))

(defruled eval-expr-of-appn-at-sum-limit
  (implies (and (not (reserrp (eval-expr nf nd l1)))
                (not (reserrp (eval-expr-list nas nd l2)))
                (not (reserrp (eval-app (eval-expr nf nd l1)
                                        (eval-expr-list nas nd l2)
                                        l3)))
                (equal (expr-appn->args (expr-appn nf nas)) nas))
           (equal (eval-expr (expr-appn nf nas) nd (+ 1 l1 l2 l3))
                  (eval-app (eval-expr nf nd l1)
                            (eval-expr-list nas nd l2)
                            l3)))
  :use ((:instance posp-limit-when-eval-expr-ok (expr nf) (denv nd) (limit l1))
        (:instance posp-limit-when-eval-expr-list-ok
                   (exprs nas) (denv nd) (limit l2))
        (:instance posp-limit-when-eval-app-ok
                   (funval (eval-expr nf nd l1))
                   (argvals (eval-expr-list nas nd l2))
                   (limit l3))
        (:instance eval-expr-at-larger-limit
                   (expr nf) (denv nd) (limit l1) (limit2 (+ l1 l2 l3)))
        (:instance eval-expr-list-of-larger-limit
                   (exprs nas) (denv nd) (limit l2) (k (+ l1 l3)))
        (:instance eval-app-at-larger-limit
                   (funval (eval-expr nf nd l1))
                   (argvals (eval-expr-list nas nd l2))
                   (limit l3) (limit2 (+ l1 l2 l3))))
  :expand ((eval-expr (expr-appn nf nas) nd (+ 1 l1 l2 l3))))

(defmacro %pfv () '(eval-expr (%pf) denv (1- limit)))

(defmacro %pavs () '(eval-expr-list (%pas) denv (1- limit)))

(defmacro %pwf ()
  '(eval-expr-ll-reaches-p-witness (%pnf) new-denv (%pfv) genv))

(defmacro %pwa ()
  '(eval-expr-list-ll-reaches-p-witness (%pnas) new-denv (%pavs) genv))

(defmacro %pnfv () '(eval-expr (%pnf) new-denv (mv-nth 0 (%pwf))))

(defmacro %pnavs () '(eval-expr-list (%pnas) new-denv (mv-nth 0 (%pwa))))

(defmacro %pwapp ()
  '(eval-app-ll-reaches-p-witness (%pnfv) (%pnavs)
                                  (eval-app (%pfv) (%pavs) (1- limit)) genv))

(defruled eval-expr-ll-reaches-p-when-appn
  (implies (and (exprp x)
                (equal (expr-kind x) :appn)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok (%pf) denv (1- limit))
                (eval-expr-list-ll-ok (%pas) denv (1- limit))
                (eval-app-ll-ok (%pfv) (%pavs) (1- limit)))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (appn-shape
        appn-parts
        (:instance len-of-ll-context-new-exprs-local
                   (exprs (%pas)) (ctx (%pctx1)))
        (:instance expr-appn-requirements (x x))
        eval-expr-when-appn-ok-local
        (:instance eval-expr-ll-ok-necc (expr (%pf)) (limit (1- limit)))
        (:instance eval-expr-list-ll-ok-necc
                   (exprs (%pas)) (limit (1- limit)) (ctx (%pctx1)))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (%pnf)) (val (%pfv)))
        (:instance eval-expr-list-ll-reaches-p-elim
                   (new-exprs (%pnas)) (vals (%pavs)))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (%pf)) (limit (1- limit)))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (%pnf)) (denv new-denv)
                   (limit (mv-nth 0 (%pwf))))
        (:instance expr-value-list-wfp-of-eval-expr-list
                   (exprs (%pas)) (limit (1- limit)))
        (:instance expr-value-list-wfp-of-eval-expr-list
                   (exprs (%pnas)) (denv new-denv)
                   (limit (mv-nth 0 (%pwa))))
        (:instance eval-app-ll-ok-necc
                   (funval (%pfv)) (argvals (%pavs)) (limit (1- limit))
                   (new-funval (%pnfv)) (new-argvals (%pnavs))
                   (w (mv-nth 1 (%pwf))) (ws (mv-nth 1 (%pwa))))
        (:instance eval-app-ll-reaches-p-elim
                   (new-funval (%pnfv)) (new-argvals (%pnavs))
                   (val (eval-app (%pfv) (%pavs) (1- limit))))
        (:instance eval-expr-of-appn-at-sum-limit
                   (nf (%pnf)) (nas (%pnas)) (nd new-denv)
                   (l1 (mv-nth 0 (%pwf))) (l2 (mv-nth 0 (%pwa)))
                   (l3 (mv-nth 0 (%pwapp))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (ll-context-new-expr x ctx))
                   (limit2 (+ 1 (mv-nth 0 (%pwf)) (mv-nth 0 (%pwa))
                              (mv-nth 0 (%pwapp))))
                   (w (mv-nth 1 (%pwapp)))
                   (val (eval-expr x denv limit))))
  :in-theory (disable ll-expr ll-expr-list eval-expr eval-expr-list eval-app
                      expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-lifted ll-context-new-exprs
                      eval-expr-ll-ok eval-expr-ll-ok-necc
                      eval-expr-list-ll-ok eval-expr-list-ll-ok-necc
                      eval-app-ll-ok eval-app-ll-ok-necc
                      eval-expr-ll-reaches-p eval-expr-ll-reaches-p-suff
                      eval-expr-list-ll-reaches-p eval-app-ll-reaches-p
                      expr-value-ll-related-p expr-value-list-ll-related-p
                      equal-of-expr-appn))

; Applications with optional type and ispace arguments: the function value
; goes through two stages before it is applied.

(defun capp-tstage (fv targs denv l)
  (type-list-option-case targs
                         :some (eval-tappn fv (type-list-option-some->val targs)
                                           denv l)
                         :none fv))

(defun capp-istage (fv iargs denv l)
  (ispace-list-option-case iargs
                           :some (eval-iappn fv
                                             (ispace-list-option-some->val
                                              iargs)
                                             denv l)
                           :none fv))

(defruled capp-tstage-at-larger-limit
  (implies (and (not (reserrp (capp-tstage fv targs denv l)))
                (integerp l2)
                (<= l l2))
           (equal (capp-tstage fv targs denv l2)
                  (capp-tstage fv targs denv l)))
  :use ((:instance eval-tappn-at-larger-limit
                   (funval fv) (args (type-list-option-some->val targs))
                   (limit l) (limit2 l2))))

(defruled capp-istage-at-larger-limit
  (implies (and (not (reserrp (capp-istage fv iargs denv l)))
                (integerp l2)
                (<= l l2))
           (equal (capp-istage fv iargs denv l2)
                  (capp-istage fv iargs denv l)))
  :use ((:instance eval-iappn-at-larger-limit
                   (funval fv) (args (ispace-list-option-some->val iargs))
                   (limit l) (limit2 l2))))

(defun capp-tstage-witness (nfv fv w targs nd denv l genv)
  (if (type-list-option-case targs :some)
      (eval-tappn-ll-reaches-p-witness
       nfv (type-list-option-some->val targs) nd
       (eval-tappn fv (type-list-option-some->val targs) denv l) genv)
    (mv 0 w)))

(defun capp-istage-witness (nfv fv w iargs nd denv l genv)
  (if (ispace-list-option-case iargs :some)
      (eval-iappn-ll-reaches-p-witness
       nfv (ispace-list-option-some->val iargs) nd
       (eval-iappn fv (ispace-list-option-some->val iargs) denv l) genv)
    (mv 0 w)))

(defruled capp-tstage-reaches
  (implies (and (not (reserrp (capp-tstage fv targs denv l)))
                (expr-value-ll-related-p nfv fv w genv)
                (not (reserrp nfv))
                (expr-value-wfp fv)
                (expr-value-wfp nfv)
                (equal (expr-denv->tenv nd) (expr-denv->tenv denv))
                (implies (type-list-option-case targs :some)
                         (eval-tappn-ll-ok fv (type-list-option-some->val targs)
                                           denv l)))
           (b* (((mv l2 w2) (capp-tstage-witness nfv fv w targs nd denv l genv))
                (nv (capp-tstage nfv targs nd l2)))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv (capp-tstage fv targs denv l) w2
                                           genv)
                  (expr-value-wfp nv)
                  (natp l2))))
  :use ((:instance eval-tappn-ll-ok-necc
                   (funval fv) (args (type-list-option-some->val targs))
                   (limit l) (new-funval nfv) (new-denv nd))
        (:instance eval-tappn-ll-reaches-p-elim
                   (new-funval nfv) (args (type-list-option-some->val targs))
                   (new-denv nd)
                   (val (eval-tappn fv (type-list-option-some->val targs)
                                    denv l)))
        (:instance posp-limit-when-eval-tappn-ok
                   (funval nfv) (args (type-list-option-some->val targs))
                   (denv nd)
                   (limit (mv-nth 0 (eval-tappn-ll-reaches-p-witness
                                     nfv (type-list-option-some->val targs) nd
                                     (eval-tappn fv
                                                 (type-list-option-some->val
                                                  targs)
                                                 denv l)
                                     genv))))
        (:instance expr-value-wfp-of-eval-tappn
                   (funval nfv) (args (type-list-option-some->val targs))
                   (denv nd)
                   (limit (mv-nth 0 (eval-tappn-ll-reaches-p-witness
                                     nfv (type-list-option-some->val targs) nd
                                     (eval-tappn fv
                                                 (type-list-option-some->val
                                                  targs)
                                                 denv l)
                                     genv)))))
  :in-theory (disable eval-tappn eval-tappn-ll-ok eval-tappn-ll-ok-necc
                      eval-tappn-ll-reaches-p expr-value-ll-related-p))

(defruled capp-istage-reaches
  (implies (and (not (reserrp (capp-istage fv iargs denv l)))
                (expr-value-ll-related-p nfv fv w genv)
                (not (reserrp nfv))
                (expr-value-wfp fv)
                (expr-value-wfp nfv)
                (equal (expr-denv->tenv nd) (expr-denv->tenv denv))
                (implies (ispace-list-option-case iargs :some)
                         (eval-iappn-ll-ok fv
                                           (ispace-list-option-some->val iargs)
                                           denv l)))
           (b* (((mv l2 w2) (capp-istage-witness nfv fv w iargs nd denv l genv))
                (nv (capp-istage nfv iargs nd l2)))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv (capp-istage fv iargs denv l) w2
                                           genv)
                  (expr-value-wfp nv)
                  (natp l2))))
  :use ((:instance eval-iappn-ll-ok-necc
                   (funval fv) (args (ispace-list-option-some->val iargs))
                   (limit l) (new-funval nfv) (new-denv nd))
        (:instance eval-iappn-ll-reaches-p-elim
                   (new-funval nfv) (args (ispace-list-option-some->val iargs))
                   (new-denv nd)
                   (val (eval-iappn fv (ispace-list-option-some->val iargs)
                                    denv l)))
        (:instance posp-limit-when-eval-iappn-ok
                   (funval nfv) (args (ispace-list-option-some->val iargs))
                   (denv nd)
                   (limit (mv-nth 0 (eval-iappn-ll-reaches-p-witness
                                     nfv (ispace-list-option-some->val iargs) nd
                                     (eval-iappn fv
                                                 (ispace-list-option-some->val
                                                  iargs)
                                                 denv l)
                                     genv))))
        (:instance expr-value-wfp-of-eval-iappn
                   (funval nfv) (args (ispace-list-option-some->val iargs))
                   (denv nd)
                   (limit (mv-nth 0 (eval-iappn-ll-reaches-p-witness
                                     nfv (ispace-list-option-some->val iargs) nd
                                     (eval-iappn fv
                                                 (ispace-list-option-some->val
                                                  iargs)
                                                 denv l)
                                     genv)))))
  :in-theory (disable eval-iappn eval-iappn-ll-ok eval-iappn-ll-ok-necc
                      eval-iappn-ll-reaches-p expr-value-ll-related-p))

(defmacro %capf () '(expr-capp->fun x))

(defmacro %cas () '(expr-capp->args x))

(defmacro %cts () '(expr-capp->targs x))

(defmacro %cis () '(expr-capp->iargs x))

(defmacro %llcf ()
  '(ll-expr (%capf) (ll-context->tenv ctx) (ll-context->tlets ctx)
            (ll-context->locals ctx) (ll-context->lmap ctx)
            (ll-context->used ctx)))

(defmacro %cctx1 () '(change-ll-context ctx :used (mv-nth 2 (%llcf))))

(defmacro %cnf () '(ll-context-new-expr (%capf) ctx))

(defmacro %cnas () '(ll-context-new-exprs (%cas) (%cctx1)))

(defruled capp-ll-facts
  (implies (equal (expr-kind x) :capp)
           (and (equal (ll-context-new-expr x ctx)
                       (expr-capp (%cnf) (%cts) (%cis) (%cnas)))
                (equal (ll-context-lifted x ctx)
                       (append (ll-context-lifted (%capf) ctx)
                               (mv-nth 1 (ll-expr-list
                                          (%cas)
                                          (ll-context->tenv ctx)
                                          (ll-context->tlets ctx)
                                          (ll-context->locals ctx)
                                          (ll-context->lmap ctx)
                                          (mv-nth 2 (%llcf))))))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-expr x tenv tlets locals lmap used)))
  :enable (ll-context-new-expr ll-context-lifted ll-context-new-exprs)
  :disable (ll-expr-list))

(defruled free-and-binders-of-capp
  (and (equal (expr-free-expr-vars (expr-capp f ts is as))
              (set::union (expr-free-expr-vars f)
                          (expr-list-free-expr-vars as)))
       (equal (expr-binder-names (expr-capp f ts is as))
              (append (expr-binder-names f)
                      (expr-list-binder-names as))))
  :expand ((expr-free-expr-vars (expr-capp f ts is as))
           (expr-binder-names (expr-capp f ts is as))))

(defruled free-and-binders-of-bracket-as-list
  (implies (consp as)
           (and (equal (expr-free-expr-vars (expr-bracket as))
                       (expr-list-free-expr-vars as))
                (equal (expr-binder-names (expr-bracket as))
                       (expr-list-binder-names as))))
  :expand ((expr-free-expr-vars (expr-bracket as))
           (expr-binder-names (expr-bracket as))))

(defruled expr-fix-when-capp-local
  (implies (and (exprp x) (equal (expr-kind x) :capp))
           (equal (expr-capp (%capf) (%cts) (%cis) (%cas)) x)))

(defruled used-of-capp-step
  (set::subset (ll-context->used ctx) (ll-context->used (%cctx1)))
  :use ((:instance used-of-ll-expr
                   (x (%capf))
                   (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx))
                   (used (ll-context->used ctx))))
  :disable (ll-expr))

(defruled free-and-binders-when-capp
  (implies (and (exprp x) (equal (expr-kind x) :capp))
           (and (equal (expr-free-expr-vars x)
                       (set::union (expr-free-expr-vars (%capf))
                                   (expr-list-free-expr-vars (%cas))))
                (equal (expr-binder-names x)
                       (append (expr-binder-names (%capf))
                               (expr-list-binder-names (%cas))))))
  :use (expr-fix-when-capp-local
        (:instance free-and-binders-of-capp
                   (f (%capf)) (ts (%cts)) (is (%cis)) (as (%cas))))
  :disable (equal-of-expr-capp))

(defruled capp-fun-parts
  (implies (and (exprp x)
                (equal (expr-kind x) :capp)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (and (expr-denv-ll-related-p new-denv denv (%capf) ctx nil dw genv)
                (ll-context-ok-p (%capf) ctx genv)))
  :use ((:instance ll-defs-bound-p-when-ll-context-ok-p)
        (:instance no-duplicate-binders-when-ll-context-ok-p)
        (:instance expr-denv-ll-related-p-of-sub
                   (y (%capf)) (ctx2 ctx) (excl nil) (excl2 nil))
        (:instance ll-context-ok-p-of-part (y (%capf)) (ctx2 ctx)))
  :in-theory (e/d (capp-ll-facts free-and-binders-of-capp
                       free-and-binders-when-capp)
                  (ll-expr ll-expr-list expr-denv-ll-related-p
                   ll-context-ok-p ll-context-new-expr ll-context-lifted
                   ll-context-new-exprs equal-of-expr-capp
                   equal-of-expr-bracket)))

(defruled capp-args-parts
  (implies (and (exprp x)
                (equal (expr-kind x) :capp)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (consp (%cas)))
           (and (expr-denv-ll-related-p
                 new-denv denv (expr-bracket (%cas)) (%cctx1) nil dw genv)
                (ll-context-ok-p (expr-bracket (%cas)) (%cctx1) genv)))
  :use ((:instance ll-defs-bound-p-when-ll-context-ok-p)
        (:instance no-duplicate-binders-when-ll-context-ok-p)
        used-of-capp-step
        (:instance consp-of-ll-context-new-exprs-local
                   (exprs (%cas)) (ctx (%cctx1)))
        (:instance expr-denv-ll-related-p-of-sub
                   (y (expr-bracket (%cas))) (ctx2 (%cctx1))
                   (excl nil) (excl2 nil))
        (:instance ll-context-ok-p-of-part
                   (y (expr-bracket (%cas))) (ctx2 (%cctx1))))
  :in-theory (e/d (capp-ll-facts free-and-binders-of-capp
                       free-and-binders-when-capp
                   free-and-binders-of-bracket-as-list
                   ll-context-new-expr-of-bracket)
                  (ll-expr ll-expr-list expr-denv-ll-related-p
                   ll-context-ok-p ll-context-new-expr ll-context-lifted
                   ll-context-new-exprs equal-of-expr-capp
                   equal-of-expr-bracket)))

(defruled capp-parts
  (implies (and (exprp x)
                (equal (expr-kind x) :capp)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (and (expr-denv-ll-related-p new-denv denv (%capf) ctx nil dw genv)
                (ll-context-ok-p (%capf) ctx genv)
                (implies (consp (%cas))
                         (and (expr-denv-ll-related-p
                               new-denv denv (expr-bracket (%cas)) (%cctx1)
                               nil dw genv)
                              (ll-context-ok-p (expr-bracket (%cas)) (%cctx1)
                                               genv)))))
  :use (capp-fun-parts capp-args-parts)
  :in-theory nil)

(defmacro %cfv () '(eval-expr (%capf) denv (1- limit)))

(defmacro %ctv () '(capp-tstage (%cfv) (%cts) denv (1- limit)))

(defmacro %civ () '(capp-istage (%ctv) (%cis) denv (1- limit)))

(defmacro %cavs () '(eval-expr-list (%cas) denv (1- limit)))

(defruled eval-expr-when-capp-ok-local
  (implies (and (equal (expr-kind x) :capp)
                (not (reserrp (eval-expr x denv limit))))
           (and (not (zp limit))
                (not (reserrp (%cfv)))
                (not (reserrp (%ctv)))
                (not (reserrp (%civ)))
                (not (reserrp (%cavs)))
                (equal (eval-expr x denv limit)
                       (eval-app (%civ) (%cavs) (1- limit)))))
  :expand ((eval-expr x denv limit)))

(defmacro %cbniv () '(capp-istage (capp-tstage (eval-expr nf nd l1) ts nd lt)
                                  is nd li))

(defmacro %cbnavs () '(eval-expr-list nas nd l2))

(defruled eval-expr-of-capp-when-parts-ok
  (implies (and (natp l)
                (not (reserrp (eval-expr nf nd l)))
                (not (reserrp (capp-tstage (eval-expr nf nd l) ts nd l)))
                (not (reserrp (capp-istage (capp-tstage (eval-expr nf nd l)
                                                        ts nd l)
                                           is nd l)))
                (not (reserrp (eval-expr-list nas nd l)))
                (type-list-optionp ts)
                (ispace-list-optionp is)
                (exprp nf)
                (expr-listp nas))
           (equal (eval-expr (expr-capp nf ts is nas) nd (+ 1 l))
                  (eval-app (capp-istage (capp-tstage (eval-expr nf nd l)
                                                      ts nd l)
                                         is nd l)
                            (eval-expr-list nas nd l) l)))
  :expand ((eval-expr (expr-capp nf ts is nas) nd (+ 1 l))))

(defruled eval-expr-of-capp-at-sum-limit
  (implies (and (not (reserrp (eval-expr nf nd l1)))
                (not (reserrp (capp-tstage (eval-expr nf nd l1) ts nd lt)))
                (not (reserrp (%cbniv)))
                (not (reserrp (%cbnavs)))
                (not (reserrp (eval-app (%cbniv) (%cbnavs) l3)))
                (natp lt)
                (natp li)
                (type-list-optionp ts)
                (ispace-list-optionp is)
                (exprp nf)
                (expr-listp nas))
           (equal (eval-expr (expr-capp nf ts is nas) nd (+ 1 l1 lt li l2 l3))
                  (eval-app (%cbniv) (%cbnavs) l3)))
  :use ((:instance eval-expr-of-capp-when-parts-ok (l (+ l1 lt li l2 l3)))
        (:instance posp-limit-when-eval-expr-ok (expr nf) (denv nd) (limit l1))
        (:instance posp-limit-when-eval-expr-list-ok
                   (exprs nas) (denv nd) (limit l2))
        (:instance posp-limit-when-eval-app-ok
                   (funval (capp-istage (capp-tstage (eval-expr nf nd l1)
                                                     ts nd lt)
                                        is nd li))
                   (argvals (eval-expr-list nas nd l2))
                   (limit l3))
        (:instance eval-expr-at-larger-limit
                   (expr nf) (denv nd) (limit l1)
                   (limit2 (+ l1 lt li l2 l3)))
        (:instance capp-tstage-at-larger-limit
                   (fv (eval-expr nf nd l1)) (targs ts) (denv nd)
                   (l lt) (l2 (+ l1 lt li l2 l3)))
        (:instance capp-istage-at-larger-limit
                   (fv (capp-tstage (eval-expr nf nd l1) ts nd lt))
                   (iargs is) (denv nd)
                   (l li) (l2 (+ l1 lt li l2 l3)))
        (:instance eval-expr-list-of-larger-limit
                   (exprs nas) (denv nd) (limit l2) (k (+ l1 lt li l3)))
        (:instance eval-app-at-larger-limit
                   (funval (capp-istage (capp-tstage (eval-expr nf nd l1)
                                                     ts nd lt)
                                        is nd li))
                   (argvals (eval-expr-list nas nd l2))
                   (limit l3) (limit2 (+ l1 lt li l2 l3))))
  :disable
  (eval-expr-of-larger-limit eval-expr-list-of-larger-limit
   eval-app-of-larger-limit eval-atom-of-larger-limit eval-tappn-of-larger-limit
   eval-iappn-of-larger-limit capp-tstage capp-istage natp posp))

(defruled capp-args-reach
  (implies (and (exprp x)
                (equal (expr-kind x) :capp)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (implies (consp (%cas))
                         (eval-expr-list-ll-ok (%cas) denv (1- limit))))
           (eval-expr-list-ll-reaches-p (%cnas) new-denv (%cavs) genv))
  :cases ((consp (%cas)))
  :use (capp-parts
        eval-expr-when-capp-ok-local
        (:instance eval-expr-list-ll-ok-necc
                   (exprs (%cas)) (limit (1- limit)) (ctx (%cctx1)))
        (:instance eval-expr-list-ll-reaches-p-of-nil))
  :expand ((eval-expr-list nil denv (1- limit)))
  :in-theory (disable ll-expr ll-expr-list ll-context-ok-p
                      expr-denv-ll-related-p eval-expr eval-expr-list
                      ll-context-new-exprs eval-expr-list-ll-reaches-p
                      eval-expr-list-ll-ok eval-expr-list-ll-ok-necc))

(defruled expr-value-wfp-of-capp-stages
  (and (implies (and (expr-value-wfp fv)
                     (not (reserrp (capp-tstage fv targs denv l))))
                (expr-value-wfp (capp-tstage fv targs denv l)))
       (implies (and (expr-value-wfp fv)
                     (not (reserrp (capp-istage fv iargs denv l))))
                (expr-value-wfp (capp-istage fv iargs denv l))))
  :use ((:instance expr-value-wfp-of-eval-tappn
                   (funval fv) (args (type-list-option-some->val targs))
                   (limit l))
        (:instance expr-value-wfp-of-eval-iappn
                   (funval fv) (args (ispace-list-option-some->val iargs))
                   (limit l))))

(defmacro %cw1 ()
  '(eval-expr-ll-reaches-p-witness (%cnf) new-denv (%cfv) genv))

(defmacro %cnfv () '(eval-expr (%cnf) new-denv (mv-nth 0 (%cw1))))

(defmacro %cwt ()
  '(capp-tstage-witness (%cnfv) (%cfv) (mv-nth 1 (%cw1)) (%cts) new-denv denv
                        (1- limit) genv))

(defmacro %cntv () '(capp-tstage (%cnfv) (%cts) new-denv (mv-nth 0 (%cwt))))

(defmacro %cwi ()
  '(capp-istage-witness (%cntv) (%ctv) (mv-nth 1 (%cwt)) (%cis) new-denv denv
                        (1- limit) genv))

(defmacro %cniv () '(capp-istage (%cntv) (%cis) new-denv (mv-nth 0 (%cwi))))

(defmacro %cwa ()
  '(eval-expr-list-ll-reaches-p-witness (%cnas) new-denv (%cavs) genv))

(defmacro %cnavs () '(eval-expr-list (%cnas) new-denv (mv-nth 0 (%cwa))))

; The :CAPP case in stages: the function with its type and ispace
; arguments, the arguments, and the application.

(defruled capp-fun-stages-reach
  (implies (and (exprp x)
                (equal (expr-kind x) :capp)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok (%capf) denv (1- limit))
                (implies (type-list-option-case (%cts) :some)
                         (eval-tappn-ll-ok (%cfv)
                                           (type-list-option-some->val (%cts))
                                           denv (1- limit)))
                (implies (ispace-list-option-case (%cis) :some)
                         (eval-iappn-ll-ok (%ctv)
                                           (ispace-list-option-some->val (%cis))
                                           denv (1- limit)))
                (implies (consp (%cas))
                         (eval-expr-list-ll-ok (%cas) denv (1- limit)))
                (eval-app-ll-ok (%civ) (%cavs) (1- limit)))
           (and (not (reserrp (%cnfv)))
                (not (reserrp (%cntv)))
                (not (reserrp (%cniv)))
                (natp (mv-nth 0 (%cwt)))
                (natp (mv-nth 0 (%cwi)))
                (expr-value-ll-related-p (%cniv) (%civ) (mv-nth 1 (%cwi)) genv)
                (expr-value-wfp (%cniv))
                (expr-value-wfp (%civ))))
  :use (capp-ll-facts
        capp-parts
        eval-expr-when-capp-ok-local
        (:instance tenv-equal-when-expr-denv-ll-related-p (excl nil))
        (:instance eval-expr-ll-ok-necc (expr (%capf)) (limit (1- limit)))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (%cnf)) (val (%cfv)))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (%capf)) (limit (1- limit)))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (%cnf)) (denv new-denv) (limit (mv-nth 0 (%cw1))))
        (:instance expr-value-wfp-of-capp-stages
                   (fv (%cfv)) (targs (%cts)) (l (1- limit)))
        (:instance expr-value-wfp-of-capp-stages
                   (fv (%ctv)) (iargs (%cis)) (l (1- limit)))
        (:instance capp-tstage-reaches
                   (nfv (%cnfv)) (fv (%cfv)) (w (mv-nth 1 (%cw1)))
                   (targs (%cts)) (nd new-denv) (l (1- limit)))
        (:instance capp-istage-reaches
                   (nfv (%cntv)) (fv (%ctv)) (w (mv-nth 1 (%cwt)))
                   (iargs (%cis)) (nd new-denv) (l (1- limit))))
  :in-theory (disable ll-expr ll-expr-list eval-expr eval-expr-list eval-app
                      expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-lifted ll-context-new-exprs
                      eval-expr-ll-ok eval-expr-ll-ok-necc
                      eval-expr-list-ll-ok eval-expr-list-ll-ok-necc
                      eval-app-ll-ok eval-app-ll-ok-necc
                      eval-tappn-ll-ok eval-iappn-ll-ok
                      eval-expr-ll-reaches-p eval-expr-ll-reaches-p-suff
                      eval-expr-list-ll-reaches-p eval-app-ll-reaches-p
                      expr-value-ll-related-p expr-value-list-ll-related-p
                      capp-tstage capp-istage capp-tstage-witness
                      capp-istage-witness equal-of-expr-capp natp))

(defruled capp-args-reach-facts
  (implies (and (exprp x)
                (equal (expr-kind x) :capp)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok (%capf) denv (1- limit))
                (implies (type-list-option-case (%cts) :some)
                         (eval-tappn-ll-ok (%cfv)
                                           (type-list-option-some->val (%cts))
                                           denv (1- limit)))
                (implies (ispace-list-option-case (%cis) :some)
                         (eval-iappn-ll-ok (%ctv)
                                           (ispace-list-option-some->val (%cis))
                                           denv (1- limit)))
                (implies (consp (%cas))
                         (eval-expr-list-ll-ok (%cas) denv (1- limit)))
                (eval-app-ll-ok (%civ) (%cavs) (1- limit)))
           (and (not (reserrp (%cnavs)))
                (expr-value-list-ll-related-p (%cnavs) (%cavs) (mv-nth 1 (%cwa))
                                              genv)
                (expr-value-list-wfp (%cnavs))
                (expr-value-list-wfp (%cavs))))
  :use (capp-ll-facts
        capp-parts
        capp-args-reach
        eval-expr-when-capp-ok-local
        (:instance eval-expr-list-ll-reaches-p-elim
                   (new-exprs (%cnas)) (vals (%cavs)))
        (:instance expr-value-list-wfp-of-eval-expr-list
                   (exprs (%cas)) (limit (1- limit)))
        (:instance expr-value-list-wfp-of-eval-expr-list
                   (exprs (%cnas)) (denv new-denv) (limit (mv-nth 0 (%cwa)))))
  :in-theory (disable ll-expr ll-expr-list eval-expr eval-expr-list eval-app
                      expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-lifted ll-context-new-exprs
                      eval-expr-ll-ok eval-expr-ll-ok-necc
                      eval-expr-list-ll-ok eval-expr-list-ll-ok-necc
                      eval-app-ll-ok eval-app-ll-ok-necc
                      eval-tappn-ll-ok eval-iappn-ll-ok
                      eval-expr-ll-reaches-p eval-expr-ll-reaches-p-suff
                      eval-expr-list-ll-reaches-p eval-app-ll-reaches-p
                      expr-value-ll-related-p expr-value-list-ll-related-p
                      capp-tstage capp-istage capp-tstage-witness
                      capp-istage-witness equal-of-expr-capp))

;; The last stage, over arbitrary new values for the function and arguments.

(defmacro %cbw ()
  '(eval-app-ll-reaches-p-witness (%cbniv) (%cbnavs) (eval-app iv avs l) g))

(defruled eval-expr-ll-reaches-p-of-capp-combine
  (implies (and (eval-app-ll-ok iv avs l)
                (not (reserrp (eval-app iv avs l)))
                (not (reserrp (eval-expr nf nd l1)))
                (not (reserrp (capp-tstage (eval-expr nf nd l1) ts nd lt)))
                (not (reserrp (%cbniv)))
                (not (reserrp (%cbnavs)))
                (natp lt)
                (natp li)
                (type-list-optionp ts)
                (ispace-list-optionp is)
                (exprp nf)
                (expr-listp nas)
                (expr-value-ll-related-p (%cbniv) iv wi g)
                (expr-value-list-ll-related-p (%cbnavs) avs wa g)
                (expr-value-wfp (%cbniv))
                (expr-value-wfp iv)
                (expr-value-list-wfp (%cbnavs))
                (expr-value-list-wfp avs))
           (eval-expr-ll-reaches-p (expr-capp nf ts is nas) nd
                                   (eval-app iv avs l) g))
  :use ((:instance eval-app-ll-ok-necc
                   (funval iv) (argvals avs) (limit l)
                   (new-funval (%cbniv)) (new-argvals (%cbnavs))
                   (w wi) (ws wa) (genv g))
        (:instance eval-app-ll-reaches-p-elim
                   (new-funval (%cbniv)) (new-argvals (%cbnavs))
                   (val (eval-app iv avs l)) (genv g))
        (:instance eval-expr-of-capp-at-sum-limit (l3 (mv-nth 0 (%cbw))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (expr-capp nf ts is nas)) (new-denv nd)
                   (limit2 (+ 1 l1 lt li l2 (mv-nth 0 (%cbw))))
                   (w (mv-nth 1 (%cbw)))
                   (val (eval-app iv avs l)) (genv g)))
  :in-theory (theory 'minimal-theory))

(defruled eval-expr-ll-reaches-p-when-capp
  (implies (and (exprp x)
                (equal (expr-kind x) :capp)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok (%capf) denv (1- limit))
                (implies (type-list-option-case (%cts) :some)
                         (eval-tappn-ll-ok (%cfv)
                                           (type-list-option-some->val (%cts))
                                           denv (1- limit)))
                (implies (ispace-list-option-case (%cis) :some)
                         (eval-iappn-ll-ok (%ctv)
                                           (ispace-list-option-some->val (%cis))
                                           denv (1- limit)))
                (implies (consp (%cas))
                         (eval-expr-list-ll-ok (%cas) denv (1- limit)))
                (eval-app-ll-ok (%civ) (%cavs) (1- limit)))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (capp-fun-stages-reach
        capp-args-reach-facts
        capp-ll-facts
        eval-expr-when-capp-ok-local
        (:instance eval-expr-ll-reaches-p-of-capp-combine
                   (iv (%civ)) (avs (%cavs)) (l (1- limit))
                   (nf (%cnf)) (ts (%cts)) (is (%cis)) (nas (%cnas))
                   (nd new-denv)
                   (l1 (mv-nth 0 (%cw1))) (lt (mv-nth 0 (%cwt)))
                   (li (mv-nth 0 (%cwi))) (l2 (mv-nth 0 (%cwa)))
                   (wi (mv-nth 1 (%cwi))) (wa (mv-nth 1 (%cwa))) (g genv)))
  :in-theory (union-theories (theory 'minimal-theory)
                             '(type-list-optionp-of-expr-capp->targs
                               ispace-list-optionp-of-expr-capp->iargs
                               exprp-of-ll-context-new-expr
                               expr-listp-of-ll-context-new-exprs)))


; A context extended with one local variable V0, with the same type
; environment: the body context of an unboxing.

(defmacro %xctx-hyps ()
  '(and (equal (ll-context->tenv ctx2) (ll-context->tenv ctx))
        (equal (ll-context->tlets ctx2)
               (tlets-without (list v0) (ll-context->tlets ctx)))
        (equal (ll-context->locals ctx2)
               (set::insert v0 (ll-context->locals ctx)))
        (equal (ll-context->lmap ctx2)
               (string-expr-map-remove-keys (list v0) (ll-context->lmap ctx)))
        (stringp v0)))

(defruled xctx-facts-at-other
  (implies (and (%xctx-hyps)
                (not (equal v v0)))
           (and (equal (omap::assoc v (ll-context->lmap ctx2))
                       (omap::assoc v (ll-context->lmap ctx)))
                (equal (set::in v (ll-context->tlets ctx2))
                       (set::in v (ll-context->tlets ctx)))
                (equal (set::in v (ll-context->locals ctx2))
                       (set::in v (ll-context->locals ctx)))))
  :enable (tlets-without string-expr-map-remove-keys))

(defruled xctx-names-in-context
  (implies (%xctx-hyps)
           (names-in-context-p (list v0) ctx2))
  :enable (names-in-context-p tlets-without string-expr-map-remove-keys))

(defruled intersect-of-insert-when-not-in-local
  (implies (and (not (set::in v0 s)) (set::setp s))
           (equal (set::intersect s (set::insert v0 l))
                  (set::intersect s l)))
  :enable (set::double-containment set::pick-a-point-subset-strategy))

(defruled difference-of-insert-when-not-in-local
  (implies (and (not (set::in v0 s)) (set::setp s))
           (equal (set::difference s (set::insert v0 l))
                  (set::difference s l))))

(defruled subset-when-subset-of-delete-local
  (implies (and (set::subset a nfv2)
                (not (set::in v0 a))
                (set::subset (set::delete v0 nfv2) nfv))
           (set::subset a nfv))
  :enable (set::pick-a-point-subset-strategy)
  :hints (("Subgoal 2"
           :use ((:instance set::subset-in (a set::arbitrary-element)
                            (x a) (y nfv2))
                 (:instance set::subset-in (a set::arbitrary-element)
                            (x (set::delete v0 nfv2)) (y nfv))))))

(defruled not-in-intersect-when-not-in-local
  (implies (not (set::in v0 s))
           (not (set::in v0 (set::intersect s l)))))

; The condition of the walker at a variable other than V0.

(defruled ll-var-types-ok-p-of-xctx
  (implies (and (%xctx-hyps)
                (stringp v)
                (not (equal v v0))
                (ll-var-types-ok-p v val ctx))
           (ll-var-types-ok-p v val ctx2))
  :use (xctx-facts-at-other)
  :enable (ll-var-types-ok-p)
  :disable (set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled ll-var-referred-ok-p-of-xctx
  (implies (and (%xctx-hyps)
                (stringp v)
                (not (equal v v0))
                (ll-var-referred-ok-p v val new-denv nfv ctx dw genv)
                (implies (omap::assoc v (ll-context->lmap ctx))
                         (not (set::in v0 (expr-free-expr-vars
                                           (cdr (omap::assoc
                                                 v (ll-context->lmap ctx)))))))
                (set::subset (set::delete v0 nfv2) nfv))
           (ll-var-referred-ok-p v val new-denv nfv2 ctx2 dw genv))
  :use (xctx-facts-at-other
        (:instance set::subset-in (a v) (x (set::delete v0 nfv2)) (y nfv))
        (:instance intersect-of-insert-when-not-in-local
                   (s (expr-free-expr-vars
                       (cdr (omap::assoc v (ll-context->lmap ctx)))))
                   (l (ll-context->locals ctx)))
        (:instance difference-of-insert-when-not-in-local
                   (s (expr-free-expr-vars
                       (cdr (omap::assoc v (ll-context->lmap ctx)))))
                   (l (ll-context->locals ctx)))
        (:instance subset-when-subset-of-delete-local
                   (a (set::intersect
                       (expr-free-expr-vars
                        (cdr (omap::assoc v (ll-context->lmap ctx))))
                       (ll-context->locals ctx))))
        (:instance not-in-intersect-when-not-in-local
                   (s (expr-free-expr-vars
                       (cdr (omap::assoc v (ll-context->lmap ctx)))))
                   (l (ll-context->locals ctx))))
  :enable (ll-var-referred-ok-p)
  :disable (set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled ll-var-ok-p-of-xctx
  (implies (and (%xctx-hyps)
                (stringp v)
                (not (equal v v0))
                (ll-var-ok-p v val new-denv nfv ctx dw genv)
                (implies (omap::assoc v (ll-context->lmap ctx))
                         (not (set::in v0 (expr-free-expr-vars
                                           (cdr (omap::assoc
                                                 v (ll-context->lmap ctx)))))))
                (set::subset (set::delete v0 nfv2) nfv))
           (ll-var-ok-p v val new-denv nfv2 ctx2 dw genv))
  :use (ll-var-types-ok-p-of-xctx
        ll-var-referred-ok-p-of-xctx
        (:instance ll-var-ok-p-split (var v) (ctx ctx2) (nfv nfv2))
        (:instance ll-var-ok-p-split (var v)))
  :in-theory (theory 'minimal-theory))

; The replacements of the hoisted functions do not refer to the binders.

(defruled not-in-replacement-free-vars-when-binder
  (implies (and (lmap-replacements-ok-p lmap locals pnames genv)
                (string-expr-mapp lmap)
                (string-setp locals)
                (string-listp pnames)
                (member-equal v0 pnames)
                (omap::assoc v lmap))
           (not (set::in v0 (expr-free-expr-vars (cdr (omap::assoc v lmap))))))
  :use ((:instance ll-replacement-ok-p-when-lmap-replacements-ok-p (k v))
        (:instance ll-replacement-ok-p-unpack
                   (repl (cdr (omap::assoc v lmap))))
        (:instance acl2::intersectp-member
                   (a v0)
                   (x (mv-nth 2 (replacement-parts (cdr (omap::assoc v lmap)))))
                   (y pnames)))
  :expand ((:free (n) (expr-free-expr-vars (expr-var n))))
  :disable (ll-replacement-ok-p apply-to-names))

(defmacro %xfv () '(set::difference (expr-free-expr-vars y)
                                    (set::mergesort (list v0))))

(defmacro %xnfv () '(expr-free-expr-vars (ll-context-new-expr y ctx2)))

(defmacro %xfvx () '(expr-free-expr-vars x))

(defmacro %xnfvx () '(expr-free-expr-vars (ll-context-new-expr x ctx)))

(defmacro %xenv-hyps ()
  '(and (%xctx-hyps)
        (string-expr-value-map-ll-related-p
         new-denv (expr-denv->exprs denv) (%xfvx) (%xnfvx) ctx dw genv)
        (set::subset (set::delete v0 (expr-free-expr-vars y)) (%xfvx))
        (set::subset (set::delete v0 (%xnfv)) (%xnfvx))
        (lmap-replacements-ok-p (ll-context->lmap ctx) (ll-context->locals ctx)
                                pnames genv)
        (string-listp pnames)
        (member-equal v0 pnames)))

(defruled difference-of-singleton-mergesort-local
  (implies (stringp v0)
           (equal (set::difference s (set::mergesort (list v0)))
                  (set::delete v0 (set::sfix s))))
  :enable (set::double-containment set::pick-a-point-subset-strategy))

(defruled walker-of-xctx-at
  (implies (and (%xenv-hyps)
                (omap::assoc w (expr-denv->exprs denv))
                (set::in w (%xfv)))
           (ll-var-ok-p w (cdr (omap::assoc w (expr-denv->exprs denv)))
                        new-denv (%xnfv) ctx2 dw genv))
  :use (difference-of-singleton-mergesort-local
        (:instance walker-ll-var-ok-p-at
                   (map (expr-denv->exprs denv)) (fv (%xfvx)) (nfv (%xnfvx))
                   (var w))
        (:instance ll-var-ok-p-of-xctx
                   (v w) (val (cdr (omap::assoc w (expr-denv->exprs denv))))
                   (nfv (%xnfvx)) (nfv2 (%xnfv)))
        (:instance not-in-replacement-free-vars-when-binder
                   (lmap (ll-context->lmap ctx)) (locals
                                                  (ll-context->locals ctx))
                   (v w))
        (:instance stringp-when-assoc-of-string-expr-value-mapp
                   (m (expr-denv->exprs denv)) (k w))
        (:instance set::subset-in
                   (a w) (x (set::delete v0 (expr-free-expr-vars y)))
                   (y (%xfvx))))
  :disable (ll-var-ok-p ll-var-ok-p-of-xctx lmap-replacements-ok-p))

(defruled walker-of-xctx
  (implies (%xenv-hyps)
           (string-expr-value-map-ll-related-p
            new-denv (expr-denv->exprs denv) (%xfv) (%xnfv) ctx2 dw genv))
  :use ((:instance string-expr-value-map-ll-related-p-when-pointwise
                   (map (expr-denv->exprs denv)) (fv (%xfv)) (nfv (%xnfv))
                   (ctx ctx2))
        (:instance walker-of-xctx-at
                   (w (walker-pointwise-p-witness
                       new-denv (expr-denv->exprs denv) (%xfv) (%xnfv)
                       ctx2 dw genv))))
  :expand ((walker-pointwise-p new-denv (expr-denv->exprs denv) (%xfv) (%xnfv)
                               ctx2 dw genv))
  :disable (ll-var-ok-p walker-pointwise-p-necc lmap-replacements-ok-p))

(defruled in-when-in-subset-of-delete-local
  (implies (and (set::subset (set::delete v0 nfv) nfvx)
                (set::in e nfv)
                (not (equal e v0)))
           (set::in e nfvx))
  :use ((:instance set::subset-in (a e) (x (set::delete v0 nfv)) (y nfvx))))

(defruled xctx-subsets
  (implies (and (set::subset (set::delete v0 nfv) nfvx)
                (stringp v0))
           (and (set::subset (set::difference
                              (set::intersect nfv (set::insert v0 locals))
                              (set::mergesort (list v0)))
                             (set::intersect nfvx locals))
                (set::subset (set::difference nfv (set::insert v0 locals))
                             (set::difference nfvx locals))))
  :enable (set::pick-a-point-subset-strategy in-when-in-subset-of-delete-local))

(defruled expr-denv-ll-related-p-of-xctx
  (implies (and (%xctx-hyps)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (set::subset (set::delete v0 (expr-free-expr-vars y)) (%xfvx))
                (set::subset (set::delete v0 (%xnfv)) (%xnfvx))
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx) pnames genv)
                (string-listp pnames)
                (member-equal v0 pnames))
           (expr-denv-ll-related-p new-denv denv y ctx2 (list v0) dw genv))
  :use (walker-of-xctx
        (:instance xctx-subsets (nfv (%xnfv)) (nfvx (%xnfvx))
                   (locals (ll-context->locals ctx)))
        (:instance names-bound-as-in-p-when-subset
                   (names (set::difference (%xnfvx) (ll-context->locals ctx)))
                   (names2 (set::difference (%xnfv) (ll-context->locals ctx2))))
        (:instance new-values-meet-types-p-when-subset
                   (names (set::intersect (%xnfvx) (ll-context->locals ctx)))
                   (names2 (set::difference
                            (set::intersect (%xnfv) (ll-context->locals ctx2))
                            (set::mergesort (list v0))))
                   (tenv (ll-context->tenv ctx))))
  :expand ((expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
           (expr-denv-ll-related-p new-denv denv y ctx2 (list v0) dw genv))
  :enable (difference-of-nil-when-setp)
  :disable (walker-of-xctx names-bound-as-in-p-when-subset
            new-values-meet-types-p-when-subset lmap-replacements-ok-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

; Unboxing: the target is lifted in the context, the body in the context
; extended with the variable, with the names in use after the target.

(defmacro %ut () '(expr-unbox->target x))

(defmacro %ub () '(expr-unbox->body x))

(defmacro %uv () '(expr-unbox->var x))

(defmacro %llut ()
  '(ll-expr (%ut) (ll-context->tenv ctx) (ll-context->tlets ctx)
            (ll-context->locals ctx) (ll-context->lmap ctx)
            (ll-context->used ctx)))

(defmacro %ubctx ()
  '(make-ll-context
    :tenv (ll-context->tenv ctx)
    :tlets (tlets-without (list (%uv)) (ll-context->tlets ctx))
    :locals (set::insert (%uv) (ll-context->locals ctx))
    :lmap (string-expr-map-remove-keys (list (%uv)) (ll-context->lmap ctx))
    :used (mv-nth 2 (%llut))))

(defmacro %unt () '(ll-context-new-expr (%ut) ctx))

(defmacro %unb () '(ll-context-new-expr (%ub) (%ubctx)))

(defruled unbox-ll-facts
  (implies (equal (expr-kind x) :unbox)
           (and (equal (ll-context-new-expr x ctx)
                       (expr-unbox (expr-unbox->ispace x) (%uv) (%unt) (%unb)
                                   (expr-unbox->type? x)))
                (equal (ll-context-lifted x ctx)
                       (append (ll-context-lifted (%ut) ctx)
                               (ll-context-lifted (%ub) (%ubctx))))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-expr x tenv tlets locals lmap used)))
  :enable (ll-context-new-expr ll-context-lifted))

(defruled free-and-binders-of-unbox
  (and (equal (expr-free-expr-vars (expr-unbox i v tg b ty))
              (set::union (expr-free-expr-vars tg)
                          (set::delete (str-fix v) (expr-free-expr-vars b))))
       (equal (expr-binder-names (expr-unbox i v tg b ty))
              (cons (str-fix v)
                    (append (ispace-var-list->name (list i))
                            (append (expr-binder-names tg)
                                    (expr-binder-names b))))))
  :expand ((expr-free-expr-vars (expr-unbox i v tg b ty))
           (expr-binder-names (expr-unbox i v tg b ty))))

(defruled expr-fix-when-unbox-local
  (implies (and (exprp x) (equal (expr-kind x) :unbox))
           (equal (expr-unbox (expr-unbox->ispace x) (%uv) (%ut) (%ub)
                              (expr-unbox->type? x))
                  x)))

(defruled used-of-unbox-step
  (set::subset (ll-context->used ctx) (mv-nth 2 (%llut)))
  :use ((:instance used-of-ll-expr
                   (x (%ut))
                   (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx))
                   (used (ll-context->used ctx))))
  :disable (ll-expr))

(defruled unbox-replacement-at
  (implies (and (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        pnames genv)
                (string-listp pnames)
                (subsetp-equal (cons v0 pnames2) pnames)
                (string-listp pnames2)
                (stringp v0)
                (omap::assoc k (string-expr-map-remove-keys
                                (list v0) (ll-context->lmap ctx))))
           (ll-replacement-ok-p
            (cdr (omap::assoc k (string-expr-map-remove-keys
                                 (list v0) (ll-context->lmap ctx))))
            (set::insert v0 (ll-context->locals ctx))
            pnames2 genv))
  :use ((:instance ll-replacement-ok-p-when-lmap-replacements-ok-p
                   (lmap (ll-context->lmap ctx))
                   (locals (ll-context->locals ctx)))
        (:instance ll-replacement-ok-p-of-more-locals
                   (repl (cdr (omap::assoc k (ll-context->lmap ctx))))
                   (locals (ll-context->locals ctx))
                   (more (list v0))))
  :enable (string-expr-map-remove-keys)
  :expand ((set::mergesort (list v0)))
  :disable (ll-replacement-ok-p))

(defruled unbox-replacements
  (implies (and (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        pnames genv)
                (string-listp pnames)
                (subsetp-equal (cons v0 pnames2) pnames)
                (string-listp pnames2)
                (stringp v0))
           (lmap-replacements-ok-p
            (string-expr-map-remove-keys (list v0) (ll-context->lmap ctx))
            (set::insert v0 (ll-context->locals ctx))
            pnames2 genv))
  :use ((:instance lmap-replacements-ok-p-when-pointwise
                   (lmap (string-expr-map-remove-keys (list v0)
                                                      (ll-context->lmap ctx)))
                   (locals (set::insert v0 (ll-context->locals ctx)))
                   (pnames pnames2))
        (:instance unbox-replacement-at
                   (k (lmap-replacements-pointwise-p-witness
                       (string-expr-map-remove-keys (list v0)
                                                    (ll-context->lmap ctx))
                       (set::insert v0 (ll-context->locals ctx))
                       pnames2 genv))))
  :expand ((lmap-replacements-pointwise-p
            (string-expr-map-remove-keys (list v0) (ll-context->lmap ctx))
            (set::insert v0 (ll-context->locals ctx))
            pnames2 genv))
  :disable (ll-replacement-ok-p lmap-replacements-ok-p
            string-expr-map-remove-keys))

(defruled unbox-binder-facts
  (implies (and (exprp x)
                (equal (expr-kind x) :unbox))
           (and (equal (expr-binder-names x)
                       (cons (%uv)
                             (append (ispace-var-list->name
                                      (list (expr-unbox->ispace x)))
                                     (append (expr-binder-names (%ut))
                                             (expr-binder-names (%ub))))))
                (member-equal (%uv) (expr-binder-names x))
                (subsetp-equal (expr-binder-names (%ub))
                               (expr-binder-names x))))
  :use (expr-fix-when-unbox-local
        (:instance free-and-binders-of-unbox
                   (i (expr-unbox->ispace x)) (v (%uv)) (tg (%ut)) (b (%ub))
                   (ty (expr-unbox->type? x))))
  :disable (ll-expr equal-of-expr-unbox))

(defruled unbox-body-used-facts
  (implies (and (exprp x)
                (equal (expr-kind x) :unbox)
                (ll-context-ok-p x ctx genv))
           (and (set::in (%uv) (ll-context->used ctx))
                (subsetp-equal (expr-binder-names (%ub)) (mv-nth 2 (%llut)))))
  :use (unbox-binder-facts
        ll-context-ok-p-facts
        used-of-unbox-step
        (:instance in-when-member-of-subsetp
                   (e (%uv)) (l (expr-binder-names x))
                   (s (ll-context->used ctx)))
        (:instance subsetp-equal-when-subset-of-set
                   (l (expr-binder-names (%ub)))
                   (s1 (ll-context->used ctx))
                   (s2 (mv-nth 2 (%llut))))
        (:instance acl2::subsetp-trans
                   (x (expr-binder-names (%ub)))
                   (y (expr-binder-names x))
                   (z (ll-context->used ctx))))
  :disable (ll-context-ok-p ll-expr acl2::subsetp-trans equal-of-expr-unbox))

(defruled unbox-body-replacements-binders
  (implies (and (exprp x)
                (equal (expr-kind x) :unbox)
                (ll-context-ok-p x ctx genv))
           (lmap-replacements-ok-p
            (string-expr-map-remove-keys (list (%uv)) (ll-context->lmap ctx))
            (set::insert (%uv) (ll-context->locals ctx))
            (expr-binder-names (%ub)) genv))
  :use (unbox-binder-facts
        ll-context-ok-p-facts-nb
        (:instance unbox-replacements
                   (pnames (expr-binder-names x))
                   (pnames2 (expr-binder-names (%ub)))
                   (v0 (%uv))))
  :disable (ll-context-ok-p lmap-replacements-ok-p ll-expr
            equal-of-expr-unbox))

(defruled ll-context-ok-p-of-unbox-body
  (implies (and (exprp x)
                (equal (expr-kind x) :unbox)
                (ll-context-ok-p x ctx genv))
           (ll-context-ok-p (%ub) (%ubctx) genv))
  :use ((:instance not-intersectp-binders-of-unbox-body
                   (bx (expr-binder-names x)) (locals (ll-context->locals ctx))
                   (v (%uv))
                   (a (ispace-var-list->name (list (expr-unbox->ispace x))))
                   (b (expr-binder-names (%ut)))
                   (bb (expr-binder-names (%ub))))
        no-duplicate-binders-when-ll-context-ok-p
        unbox-ll-facts
        unbox-binder-facts
        unbox-body-used-facts
        unbox-body-replacements-binders
        used-of-unbox-step
        (:instance lmap-closed-p-when-string-expr-map-closed-p
                   (m (ll-context->lmap ctx)))
        (:instance string-expr-map-closed-p-when-lmap-closed-p
                   (m (string-expr-map-remove-keys (list (%uv))
                                                   (ll-context->lmap ctx))))
        (:instance lmap-closed-p-of-string-expr-map-remove-keys
                   (keys (list (%uv))) (lmap (ll-context->lmap ctx))))
  :enable (ll-context-ok-p set::pick-a-point-subset-strategy
           in-keys-of-remove-keys set::subset-in
           set::subset-transitive)
  :disable
  (no-duplicatesp-equal member-equal
   no-duplicatesp-equal-when-no-duplicatesp-equal-of-type-var-list->name
   no-duplicatesp-equal-when-no-duplicatesp-equal-of-ispace-var-list->name
   acl2::subsetp-car-member acl2::consp-when-member-equal-of-cons-listp
   acl2::subsetp-trans no-duplicatesp-equal-when-not-duplicated-names
   acl2::subsetp-member duplicated-names-when-no-duplicatesp-equal
   acl2::subsetp-when-atom-right set::insert-identity ll-expr
   lmap-replacements-ok-p equal-of-expr-unbox set::intersect-under-set-equiv
   set::difference-under-set-equiv set::union-under-set-equiv
   set::mergesort-under-set-equiv))

; The replacements in the body's context do not refer to the variable.

(defruled unbox-body-replacements-var
  (implies (and (exprp x)
                (equal (expr-kind x) :unbox)
                (ll-context-ok-p x ctx genv))
           (lmap-replacements-ok-p (ll-context->lmap (%ubctx))
                                   (ll-context->locals (%ubctx))
                                   (list (%uv)) genv))
  :use ((:instance ll-context-ok-p-facts-nb)
        (:instance free-and-binders-of-unbox
                   (i (expr-unbox->ispace x)) (v (%uv)) (tg (%ut)) (b (%ub))
                   (ty (expr-unbox->type? x)))
        expr-fix-when-unbox-local
        (:instance unbox-replacements
                   (pnames (expr-binder-names x))
                   (pnames2 (list (%uv)))
                   (v0 (%uv))))
  :disable (ll-context-ok-p lmap-replacements-ok-p ll-expr))

(defruled unbox-var-not-typed
  (implies (and (exprp x)
                (equal (expr-kind x) :unbox)
                (ll-context-ok-p x ctx genv))
           (not (omap::assoc (%uv) (ll-context->tenv (%ubctx)))))
  :use (ll-context-ok-p-facts
        (:instance free-and-binders-of-unbox
                   (i (expr-unbox->ispace x)) (v (%uv)) (tg (%ut)) (b (%ub))
                   (ty (expr-unbox->type? x)))
        expr-fix-when-unbox-local
        (:instance acl2::intersectp-member
                   (a (%uv)) (x (expr-binder-names x))
                   (y (ll-context->locals ctx)))
        (:instance omap::in-of-keys-to-assoc
                   (omap::key (%uv)) (omap::map (ll-context->tenv ctx)))
        (:instance set::subset-in (a (%uv))
                   (x (omap::keys (ll-context->tenv ctx)))
                   (y (ll-context->locals ctx)))
        (:instance set::in-to-member (set::a (%uv))
                   (set::x (ll-context->locals ctx))))
  :disable (ll-context-ok-p ll-expr set::subset-in
            acl2::intersectp-member omap::in-of-keys-to-assoc))

(defruled lmap-replacements-when-ll-context-ok-p
  (implies (ll-context-ok-p x ctx genv)
           (lmap-replacements-ok-p (ll-context->lmap ctx)
                                   (ll-context->locals ctx)
                                   (expr-binder-names x) genv))
  :enable ll-context-ok-p)

(defruled free-and-binders-when-unbox
  (implies (and (exprp x) (equal (expr-kind x) :unbox))
           (and (equal (expr-free-expr-vars x)
                       (set::union (expr-free-expr-vars (%ut))
                                   (set::delete (%uv)
                                                (expr-free-expr-vars (%ub)))))
                (equal (expr-binder-names x)
                       (cons (%uv)
                             (append (ispace-var-list->name
                                      (list (expr-unbox->ispace x)))
                                     (append (expr-binder-names (%ut))
                                             (expr-binder-names (%ub))))))))
  :use (expr-fix-when-unbox-local
        (:instance free-and-binders-of-unbox
                   (i (expr-unbox->ispace x)) (v (%uv)) (tg (%ut)) (b (%ub))
                   (ty (expr-unbox->type? x))))
  :disable (equal-of-expr-unbox))

(defruled unbox-target-parts
  (implies (and (exprp x)
                (equal (expr-kind x) :unbox)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (and (expr-denv-ll-related-p new-denv denv (%ut) ctx nil dw genv)
                (ll-context-ok-p (%ut) ctx genv)))
  :use ((:instance ll-defs-bound-p-when-ll-context-ok-p)
        (:instance no-duplicate-binders-when-ll-context-ok-p)
        (:instance expr-denv-ll-related-p-of-sub
                   (y (%ut)) (ctx2 ctx) (excl nil) (excl2 nil))
        (:instance ll-context-ok-p-of-part (y (%ut)) (ctx2 ctx)))
  :in-theory (e/d (unbox-ll-facts free-and-binders-of-unbox
                   free-and-binders-when-unbox)
                  (ll-expr expr-denv-ll-related-p ll-context-ok-p
                   ll-context-new-expr ll-context-lifted
                   lmap-replacements-ok-p equal-of-expr-unbox
                   names-in-context-p)))

(defruled unbox-body-related
  (implies (and (exprp x)
                (equal (expr-kind x) :unbox)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (expr-denv-ll-related-p new-denv denv (%ub) (%ubctx)
                                   (list (%uv)) dw genv))
  :use (unbox-ll-facts
        expr-fix-when-unbox-local
        lmap-replacements-when-ll-context-ok-p
        (:instance free-and-binders-of-unbox
                   (i (expr-unbox->ispace x)) (v (%uv)) (tg (%ut)) (b (%ub))
                   (ty (expr-unbox->type? x)))
        (:instance free-and-binders-of-unbox
                   (i (expr-unbox->ispace x)) (v (%uv)) (tg (%unt)) (b (%unb))
                   (ty (expr-unbox->type? x)))
        (:instance expr-denv-ll-related-p-of-xctx
                   (ctx2 (%ubctx)) (v0 (%uv)) (y (%ub))
                   (pnames (expr-binder-names x))))
  :in-theory (disable ll-expr expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-lifted
                      lmap-replacements-ok-p equal-of-expr-unbox
                      names-in-context-p))

(defruled unbox-parts
  (implies (and (exprp x)
                (equal (expr-kind x) :unbox)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (and (expr-denv-ll-related-p new-denv denv (%ut) ctx nil dw genv)
                (ll-context-ok-p (%ut) ctx genv)
                (names-in-context-p (list (%uv)) (%ubctx))
                (expr-denv-ll-related-p new-denv denv (%ub) (%ubctx)
                                        (list (%uv)) dw genv)
                (ll-context-ok-p (%ub) (%ubctx) genv)))
  :use (unbox-target-parts
        unbox-body-related
        ll-context-ok-p-of-unbox-body
        (:instance xctx-names-in-context (ctx2 (%ubctx)) (v0 (%uv))))
  :in-theory (disable ll-expr expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-lifted
                      lmap-replacements-ok-p names-in-context-p))

(defruled posp-limit-when-eval-unbox-ok
  (implies (not (reserrp (eval-unbox target ispaces var body type denv limit)))
           (posp limit))
  :expand ((eval-unbox target ispaces var body type denv limit)))

(defruled eval-unbox-at-larger-limit
  (implies (and (not (reserrp (eval-unbox target ispaces var body type denv
                                          limit)))
                (integerp limit2)
                (<= limit limit2))
           (equal (eval-unbox target ispaces var body type denv limit2)
                  (eval-unbox target ispaces var body type denv limit)))
  :use (posp-limit-when-eval-unbox-ok
        (:instance eval-unbox-of-larger-limit (k (- limit2 limit)))))

(defruled eval-unbox-ll-reaches-p-elim
  (implies (eval-unbox-ll-reaches-p new-target ispaces var new-body type
                                    new-denv val genv)
           (b* (((mv l w)
                 (eval-unbox-ll-reaches-p-witness new-target ispaces var
                                                  new-body
                                                  type new-denv val genv))
                (nv
                 (eval-unbox new-target ispaces var new-body type new-denv l)))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv val w genv))))
  :enable eval-unbox-ll-reaches-p)

(defmacro %utval ()
  '(eval-type (type-option-some->val (expr-unbox->type? x))
              (expr-denv->tenv denv)))

(defmacro %utv () '(eval-expr (%ut) denv (1- limit)))

(defmacro %uis () '(list (expr-unbox->ispace x)))

(defruled eval-expr-when-unbox-ok-local
  (implies (and (equal (expr-kind x) :unbox)
                (not (reserrp (eval-expr x denv limit))))
           (and (not (zp limit))
                (not (reserrp (%utv)))
                (expr-unbox->type? x)
                (not (reserrp (%utval)))
                (equal (eval-expr x denv limit)
                       (eval-unbox (%utv) (%uis) (%uv) (%ub) (%utval) denv
                                   (1- limit)))))
  :expand ((eval-expr x denv limit)))

(defruled eval-expr-of-unbox-at-sum-limit
  (implies (and (not (reserrp (eval-expr nt nd l1)))
                ty
                (not (reserrp (eval-type (type-option-some->val ty)
                                         (expr-denv->tenv nd))))
                (not (reserrp (eval-unbox (eval-expr nt nd l1) (list i) v nb
                                          (eval-type (type-option-some->val ty)
                                                     (expr-denv->tenv nd))
                                          nd l2)))
                (ispace-varp i) (stringp v) (exprp nb) (type-optionp ty))
           (equal (eval-expr (expr-unbox i v nt nb ty) nd (+ 1 l1 l2))
                  (eval-unbox (eval-expr nt nd l1) (list i) v nb
                              (eval-type (type-option-some->val ty)
                                         (expr-denv->tenv nd))
                              nd l2)))
  :use ((:instance posp-limit-when-eval-expr-ok (expr nt) (denv nd) (limit l1))
        (:instance posp-limit-when-eval-unbox-ok
                   (target (eval-expr nt nd l1)) (ispaces (list i)) (var v)
                   (body nb)
                   (type (eval-type (type-option-some->val ty)
                                    (expr-denv->tenv nd)))
                   (denv nd) (limit l2))
        (:instance eval-expr-at-larger-limit
                   (expr nt) (denv nd) (limit l1) (limit2 (+ l1 l2)))
        (:instance eval-unbox-at-larger-limit
                   (target (eval-expr nt nd l1)) (ispaces (list i)) (var v)
                   (body nb)
                   (type (eval-type (type-option-some->val ty)
                                    (expr-denv->tenv nd)))
                   (denv nd) (limit l2) (limit2 (+ l1 l2))))
  :expand ((:free (l) (eval-expr (expr-unbox i v nt nb ty) nd l))))

(defmacro %uw1 ()
  '(eval-expr-ll-reaches-p-witness (%unt) new-denv (%utv) genv))

(defmacro %untv () '(eval-expr (%unt) new-denv (mv-nth 0 (%uw1))))

(defmacro %uw2 ()
  '(eval-unbox-ll-reaches-p-witness
    (%untv) (%uis) (%uv) (%unb) (%utval) new-denv
    (eval-unbox (%utv) (%uis) (%uv) (%ub) (%utval) denv (1- limit)) genv))

(defruled eval-expr-ll-reaches-p-when-unbox
  (implies (and (exprp x)
                (equal (expr-kind x) :unbox)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok (%ut) denv (1- limit))
                (eval-unbox-ll-ok (%utv) (%uis) (%uv) (%ub) (%utval) denv
                                  (1- limit)))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (unbox-ll-facts
        unbox-parts
        eval-expr-when-unbox-ok-local
        (:instance tenv-equal-when-expr-denv-ll-related-p (excl nil))
        (:instance eval-expr-ll-ok-necc (expr (%ut)) (limit (1- limit)))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (%unt)) (val (%utv)))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (%ut)) (limit (1- limit)))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (%unt)) (denv new-denv) (limit (mv-nth 0 (%uw1))))
        unbox-var-not-typed
        unbox-body-replacements-var
        (:instance eval-unbox-ll-ok-necc
                   (target (%utv)) (ispaces (%uis)) (var (%uv)) (body (%ub))
                   (type (%utval)) (limit (1- limit))
                   (new-target (%untv)) (w (mv-nth 1 (%uw1)))
                   (ctx (%ubctx)))
        (:instance eval-unbox-ll-reaches-p-elim
                   (new-target (%untv)) (ispaces (%uis)) (var (%uv))
                   (new-body (%unb)) (type (%utval))
                   (val (eval-unbox (%utv) (%uis) (%uv) (%ub) (%utval) denv
                                    (1- limit))))
        (:instance eval-expr-of-unbox-at-sum-limit
                   (nt (%unt)) (nd new-denv) (i (expr-unbox->ispace x))
                   (v (%uv)) (nb (%unb)) (ty (expr-unbox->type? x))
                   (l1 (mv-nth 0 (%uw1))) (l2 (mv-nth 0 (%uw2))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (ll-context-new-expr x ctx))
                   (limit2 (+ 1 (mv-nth 0 (%uw1)) (mv-nth 0 (%uw2))))
                   (w (mv-nth 1 (%uw2)))
                   (val (eval-expr x denv limit))))
  :in-theory (disable ll-expr eval-expr eval-unbox expr-denv-ll-related-p
                      ll-context-ok-p ll-context-new-expr ll-context-lifted
                      eval-expr-ll-ok eval-expr-ll-ok-necc eval-unbox-ll-ok
                      eval-unbox-ll-ok-necc eval-expr-ll-reaches-p
                      eval-expr-ll-reaches-p-suff eval-unbox-ll-reaches-p
                      expr-value-ll-related-p names-in-context-p
                      equal-of-expr-unbox))

; Unboxing with several ispaces: the target is lifted in the context, the body in the context
; extended with the variable, with the names in use after the target.

(defmacro %qt () '(expr-unboxn->target x))

(defmacro %qb () '(expr-unboxn->body x))

(defmacro %qv () '(expr-unboxn->var x))

(defmacro %llqt ()
  '(ll-expr (%qt) (ll-context->tenv ctx) (ll-context->tlets ctx)
            (ll-context->locals ctx) (ll-context->lmap ctx)
            (ll-context->used ctx)))

(defmacro %qbctx ()
  '(make-ll-context
    :tenv (ll-context->tenv ctx)
    :tlets (tlets-without (list (%qv)) (ll-context->tlets ctx))
    :locals (set::insert (%qv) (ll-context->locals ctx))
    :lmap (string-expr-map-remove-keys (list (%qv)) (ll-context->lmap ctx))
    :used (mv-nth 2 (%llqt))))

(defmacro %qnt () '(ll-context-new-expr (%qt) ctx))

(defmacro %qnb () '(ll-context-new-expr (%qb) (%qbctx)))

(defruled unboxn-ll-facts
  (implies (equal (expr-kind x) :unboxn)
           (and (equal (ll-context-new-expr x ctx)
                       (expr-unboxn (expr-unboxn->ispaces x) (%qv) (%qnt) (%qnb)
                                   (expr-unboxn->type? x)))
                (equal (ll-context-lifted x ctx)
                       (append (ll-context-lifted (%qt) ctx)
                               (ll-context-lifted (%qb) (%qbctx))))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-expr x tenv tlets locals lmap used)))
  :enable (ll-context-new-expr ll-context-lifted))

(defruled free-and-binders-of-unboxn
  (and (equal (expr-free-expr-vars (expr-unboxn i v tg b ty))
              (set::union (expr-free-expr-vars tg)
                          (set::delete (str-fix v) (expr-free-expr-vars b))))
       (equal (expr-binder-names (expr-unboxn i v tg b ty))
              (cons (str-fix v)
                    (append (ispace-var-list->name
                             (expr-unboxn->ispaces (expr-unboxn i v tg b ty)))
                            (append (expr-binder-names tg)
                                    (expr-binder-names b))))))
  :expand ((expr-free-expr-vars (expr-unboxn i v tg b ty))
           (expr-binder-names (expr-unboxn i v tg b ty))))

(defruled expr-fix-when-unboxn-local
  (implies (and (exprp x) (equal (expr-kind x) :unboxn))
           (equal (expr-unboxn (expr-unboxn->ispaces x) (%qv) (%qt) (%qb)
                              (expr-unboxn->type? x))
                  x)))

(defruled used-of-unboxn-step
  (set::subset (ll-context->used ctx) (mv-nth 2 (%llqt)))
  :use ((:instance used-of-ll-expr
                   (x (%qt))
                   (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx))
                   (used (ll-context->used ctx))))
  :disable (ll-expr))

(defruled no-duplicatesp-of-unbox-body-local
  (implies (and (no-duplicatesp-equal bx)
                (equal bx (cons v (append a (append b bb)))))
           (no-duplicatesp-equal bb))
  :use ((:instance no-duplicatesp-equal-of-append-parts
                   (a a) (b (append b bb)))
        (:instance no-duplicatesp-equal-of-append-parts
                   (a b) (b bb))))

(defruled unboxn-binder-facts
  (implies (and (exprp x)
                (equal (expr-kind x) :unboxn))
           (and (equal (expr-binder-names x)
                       (cons (%qv)
                             (append (ispace-var-list->name
                                      (expr-unboxn->ispaces x))
                                     (append (expr-binder-names (%qt))
                                             (expr-binder-names (%qb))))))
                (member-equal (%qv) (expr-binder-names x))
                (subsetp-equal (expr-binder-names (%qb))
                               (expr-binder-names x))))
  :use (expr-fix-when-unboxn-local
        (:instance free-and-binders-of-unboxn
                   (i (expr-unboxn->ispaces x)) (v (%qv)) (tg (%qt)) (b (%qb))
                   (ty (expr-unboxn->type? x))))
  :disable (ll-expr equal-of-expr-unboxn))

(defruled unboxn-body-used-facts
  (implies (and (exprp x)
                (equal (expr-kind x) :unboxn)
                (ll-context-ok-p x ctx genv))
           (and (set::in (%qv) (ll-context->used ctx))
                (subsetp-equal (expr-binder-names (%qb)) (mv-nth 2 (%llqt)))))
  :use (unboxn-binder-facts
        ll-context-ok-p-facts
        used-of-unboxn-step
        (:instance in-when-member-of-subsetp
                   (e (%qv)) (l (expr-binder-names x))
                   (s (ll-context->used ctx)))
        (:instance subsetp-equal-when-subset-of-set
                   (l (expr-binder-names (%qb)))
                   (s1 (ll-context->used ctx))
                   (s2 (mv-nth 2 (%llqt))))
        (:instance acl2::subsetp-trans
                   (x (expr-binder-names (%qb)))
                   (y (expr-binder-names x))
                   (z (ll-context->used ctx))))
  :disable (ll-context-ok-p ll-expr acl2::subsetp-trans equal-of-expr-unboxn))

(defruled unboxn-body-replacements-binders
  (implies (and (exprp x)
                (equal (expr-kind x) :unboxn)
                (ll-context-ok-p x ctx genv))
           (lmap-replacements-ok-p
            (string-expr-map-remove-keys (list (%qv)) (ll-context->lmap ctx))
            (set::insert (%qv) (ll-context->locals ctx))
            (expr-binder-names (%qb)) genv))
  :use (unboxn-binder-facts
        ll-context-ok-p-facts-nb
        (:instance unbox-replacements
                   (pnames (expr-binder-names x))
                   (pnames2 (expr-binder-names (%qb)))
                   (v0 (%qv))))
  :disable (ll-context-ok-p lmap-replacements-ok-p ll-expr
            equal-of-expr-unboxn))

(defruled ll-context-ok-p-of-unboxn-body
  (implies (and (exprp x)
                (equal (expr-kind x) :unboxn)
                (ll-context-ok-p x ctx genv))
           (ll-context-ok-p (%qb) (%qbctx) genv))
  :use ((:instance not-intersectp-binders-of-unbox-body
                   (bx (expr-binder-names x)) (locals (ll-context->locals ctx))
                   (v (%qv))
                   (a (ispace-var-list->name (expr-unboxn->ispaces x)))
                   (b (expr-binder-names (%qt)))
                   (bb (expr-binder-names (%qb))))
        no-duplicate-binders-when-ll-context-ok-p
        (:instance no-duplicatesp-of-unbox-body-local
                   (bx (expr-binder-names x)) (v (%qv))
                   (a (ispace-var-list->name (expr-unboxn->ispaces x)))
                   (b (expr-binder-names (%qt)))
                   (bb (expr-binder-names (%qb))))
        unboxn-ll-facts
        unboxn-binder-facts
        unboxn-body-used-facts
        unboxn-body-replacements-binders
        used-of-unboxn-step
        (:instance lmap-closed-p-when-string-expr-map-closed-p
                   (m (ll-context->lmap ctx)))
        (:instance string-expr-map-closed-p-when-lmap-closed-p
                   (m (string-expr-map-remove-keys (list (%qv))
                                                   (ll-context->lmap ctx))))
        (:instance lmap-closed-p-of-string-expr-map-remove-keys
                   (keys (list (%qv))) (lmap (ll-context->lmap ctx))))
  :enable (ll-context-ok-p set::pick-a-point-subset-strategy
           in-keys-of-remove-keys set::subset-in
           set::subset-transitive)
  :disable
  (no-duplicatesp-equal member-equal
   no-duplicatesp-equal-when-no-duplicatesp-equal-of-type-var-list->name
   no-duplicatesp-equal-when-no-duplicatesp-equal-of-ispace-var-list->name
   acl2::subsetp-car-member acl2::consp-when-member-equal-of-cons-listp
   no-duplicatesp-equal-when-not-duplicated-names acl2::subsetp-trans
   duplicated-names-when-no-duplicatesp-equal acl2::subsetp-member
   acl2::subsetp-when-atom-right
   member-equal-of-type-var-list->name-when-member-equal ll-expr
   lmap-replacements-ok-p equal-of-expr-unboxn set::intersect-under-set-equiv
   set::difference-under-set-equiv set::union-under-set-equiv
   set::mergesort-under-set-equiv))

(defruled unboxn-body-replacements-var
  (implies (and (exprp x)
                (equal (expr-kind x) :unboxn)
                (ll-context-ok-p x ctx genv))
           (lmap-replacements-ok-p (ll-context->lmap (%qbctx))
                                   (ll-context->locals (%qbctx))
                                   (list (%qv)) genv))
  :use ((:instance ll-context-ok-p-facts-nb)
        (:instance free-and-binders-of-unboxn
                   (i (expr-unboxn->ispaces x)) (v (%qv)) (tg (%qt)) (b (%qb))
                   (ty (expr-unboxn->type? x)))
        expr-fix-when-unboxn-local
        (:instance unbox-replacements
                   (pnames (expr-binder-names x))
                   (pnames2 (list (%qv)))
                   (v0 (%qv))))
  :disable (ll-context-ok-p lmap-replacements-ok-p ll-expr))

(defruled unboxn-var-not-typed
  (implies (and (exprp x)
                (equal (expr-kind x) :unboxn)
                (ll-context-ok-p x ctx genv))
           (not (omap::assoc (%qv) (ll-context->tenv (%qbctx)))))
  :use (ll-context-ok-p-facts
        (:instance free-and-binders-of-unboxn
                   (i (expr-unboxn->ispaces x)) (v (%qv)) (tg (%qt)) (b (%qb))
                   (ty (expr-unboxn->type? x)))
        expr-fix-when-unboxn-local
        (:instance acl2::intersectp-member
                   (a (%qv)) (x (expr-binder-names x))
                   (y (ll-context->locals ctx)))
        (:instance omap::in-of-keys-to-assoc
                   (omap::key (%qv)) (omap::map (ll-context->tenv ctx)))
        (:instance set::subset-in (a (%qv))
                   (x (omap::keys (ll-context->tenv ctx)))
                   (y (ll-context->locals ctx)))
        (:instance set::in-to-member (set::a (%qv))
                   (set::x (ll-context->locals ctx))))
  :disable (ll-context-ok-p ll-expr set::subset-in
            acl2::intersectp-member omap::in-of-keys-to-assoc))

(defruled no-duplicatesp-of-unbox-target-local
  (implies (and (no-duplicatesp-equal bx)
                (equal bx (cons v (append a (append b bb)))))
           (no-duplicatesp-equal b))
  :use ((:instance no-duplicatesp-equal-of-append-parts
                   (a a) (b (append b bb)))
        (:instance no-duplicatesp-equal-of-append-parts
                   (a b) (b bb))))

(defruled free-and-binders-when-unboxn
  (implies (and (exprp x) (equal (expr-kind x) :unboxn))
           (and (equal (expr-free-expr-vars x)
                       (set::union (expr-free-expr-vars (%qt))
                                   (set::delete (%qv)
                                                (expr-free-expr-vars (%qb)))))
                (equal (expr-binder-names x)
                       (cons (%qv)
                             (append (ispace-var-list->name
                                      (expr-unboxn->ispaces x))
                                     (append (expr-binder-names (%qt))
                                             (expr-binder-names (%qb))))))))
  :use (expr-fix-when-unboxn-local
        (:instance free-and-binders-of-unboxn
                   (i (expr-unboxn->ispaces x)) (v (%qv)) (tg (%qt)) (b (%qb))
                   (ty (expr-unboxn->type? x))))
  :disable (equal-of-expr-unboxn))

(defruled unboxn-target-parts
  (implies (and (exprp x)
                (equal (expr-kind x) :unboxn)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (and (expr-denv-ll-related-p new-denv denv (%qt) ctx nil dw genv)
                (ll-context-ok-p (%qt) ctx genv)))
  :use ((:instance no-duplicatesp-of-unbox-target-local
                   (bx (expr-binder-names x)) (v (%qv))
                   (a (ispace-var-list->name (expr-unboxn->ispaces x)))
                   (b (expr-binder-names (%qt)))
                   (bb (expr-binder-names (%qb))))
        (:instance ll-defs-bound-p-when-ll-context-ok-p)
        (:instance no-duplicate-binders-when-ll-context-ok-p)
        (:instance expr-denv-ll-related-p-of-sub
                   (y (%qt)) (ctx2 ctx) (excl nil) (excl2 nil))
        (:instance ll-context-ok-p-of-part (y (%qt)) (ctx2 ctx)))
  :in-theory (e/d (unboxn-ll-facts free-and-binders-of-unboxn
                   free-and-binders-when-unboxn)
                  (ll-expr expr-denv-ll-related-p ll-context-ok-p
                   ll-context-new-expr ll-context-lifted
                   lmap-replacements-ok-p equal-of-expr-unboxn
                   names-in-context-p)))

(defruled unboxn-body-related
  (implies (and (exprp x)
                (equal (expr-kind x) :unboxn)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (expr-denv-ll-related-p new-denv denv (%qb) (%qbctx)
                                   (list (%qv)) dw genv))
  :use (unboxn-ll-facts
        expr-fix-when-unboxn-local
        lmap-replacements-when-ll-context-ok-p
        (:instance free-and-binders-of-unboxn
                   (i (expr-unboxn->ispaces x)) (v (%qv)) (tg (%qt)) (b (%qb))
                   (ty (expr-unboxn->type? x)))
        (:instance free-and-binders-of-unboxn
                   (i (expr-unboxn->ispaces x)) (v (%qv)) (tg (%qnt)) (b (%qnb))
                   (ty (expr-unboxn->type? x)))
        (:instance expr-denv-ll-related-p-of-xctx
                   (ctx2 (%qbctx)) (v0 (%qv)) (y (%qb))
                   (pnames (expr-binder-names x))))
  :in-theory (disable ll-expr expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-lifted
                      lmap-replacements-ok-p equal-of-expr-unboxn
                      names-in-context-p))

(defruled unboxn-parts
  (implies (and (exprp x)
                (equal (expr-kind x) :unboxn)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv))
           (and (expr-denv-ll-related-p new-denv denv (%qt) ctx nil dw genv)
                (ll-context-ok-p (%qt) ctx genv)
                (names-in-context-p (list (%qv)) (%qbctx))
                (expr-denv-ll-related-p new-denv denv (%qb) (%qbctx)
                                        (list (%qv)) dw genv)
                (ll-context-ok-p (%qb) (%qbctx) genv)))
  :use (unboxn-target-parts
        unboxn-body-related
        ll-context-ok-p-of-unboxn-body
        (:instance xctx-names-in-context (ctx2 (%qbctx)) (v0 (%qv))))
  :in-theory (disable ll-expr expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-lifted
                      lmap-replacements-ok-p names-in-context-p))

(defmacro %qtval ()
  '(eval-type (type-option-some->val (expr-unboxn->type? x))
              (expr-denv->tenv denv)))

(defmacro %qtv () '(eval-expr (%qt) denv (1- limit)))

(defmacro %qis () '(expr-unboxn->ispaces x))

(defruled eval-expr-when-unboxn-ok-local
  (implies (and (equal (expr-kind x) :unboxn)
                (not (reserrp (eval-expr x denv limit))))
           (and (not (zp limit))
                (not (reserrp (%qtv)))
                (expr-unboxn->type? x)
                (not (reserrp (%qtval)))
                (equal (eval-expr x denv limit)
                       (eval-unbox (%qtv) (%qis) (%qv) (%qb) (%qtval) denv
                                   (1- limit)))))
  :expand ((eval-expr x denv limit)))

(defruled eval-expr-of-unboxn-at-sum-limit
  (implies (and (not (reserrp (eval-expr nt nd l1)))
                ty
                (not (reserrp (eval-type (type-option-some->val ty)
                                         (expr-denv->tenv nd))))
                (not (reserrp (eval-unbox (eval-expr nt nd l1) i v nb
                                          (eval-type (type-option-some->val ty)
                                                     (expr-denv->tenv nd))
                                          nd l2)))
                (ispace-var-listp i) (<= 2 (len i)) (stringp v) (exprp
                                                                 nb) (type-optionp ty))
           (equal (eval-expr (expr-unboxn i v nt nb ty) nd (+ 1 l1 l2))
                  (eval-unbox (eval-expr nt nd l1) i v nb
                              (eval-type (type-option-some->val ty)
                                         (expr-denv->tenv nd))
                              nd l2)))
  :use ((:instance posp-limit-when-eval-expr-ok (expr nt) (denv nd) (limit l1))
        (:instance posp-limit-when-eval-unbox-ok
                   (target (eval-expr nt nd l1)) (ispaces i) (var v)
                   (body nb)
                   (type (eval-type (type-option-some->val ty)
                                    (expr-denv->tenv nd)))
                   (denv nd) (limit l2))
        (:instance eval-expr-at-larger-limit
                   (expr nt) (denv nd) (limit l1) (limit2 (+ l1 l2)))
        (:instance eval-unbox-at-larger-limit
                   (target (eval-expr nt nd l1)) (ispaces i) (var v)
                   (body nb)
                   (type (eval-type (type-option-some->val ty)
                                    (expr-denv->tenv nd)))
                   (denv nd) (limit l2) (limit2 (+ l1 l2))))
  :expand ((:free (l) (eval-expr (expr-unboxn i v nt nb ty) nd l))))

(defmacro %qw1 ()
  '(eval-expr-ll-reaches-p-witness (%qnt) new-denv (%qtv) genv))

(defmacro %qntv () '(eval-expr (%qnt) new-denv (mv-nth 0 (%qw1))))

(defmacro %qw2 ()
  '(eval-unbox-ll-reaches-p-witness
    (%qntv) (%qis) (%qv) (%qnb) (%qtval) new-denv
    (eval-unbox (%qtv) (%qis) (%qv) (%qb) (%qtval) denv (1- limit)) genv))

(defruled eval-expr-ll-reaches-p-when-unboxn
  (implies (and (exprp x)
                (equal (expr-kind x) :unboxn)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok (%qt) denv (1- limit))
                (eval-unbox-ll-ok (%qtv) (%qis) (%qv) (%qb) (%qtval) denv
                                  (1- limit)))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (unboxn-ll-facts
        unboxn-parts
        eval-expr-when-unboxn-ok-local
        (:instance tenv-equal-when-expr-denv-ll-related-p (excl nil))
        (:instance eval-expr-ll-ok-necc (expr (%qt)) (limit (1- limit)))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (%qnt)) (val (%qtv)))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (%qt)) (limit (1- limit)))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (%qnt)) (denv new-denv) (limit (mv-nth 0 (%qw1))))
        unboxn-var-not-typed
        unboxn-body-replacements-var
        (:instance eval-unbox-ll-ok-necc
                   (target (%qtv)) (ispaces (%qis)) (var (%qv)) (body (%qb))
                   (type (%qtval)) (limit (1- limit))
                   (new-target (%qntv)) (w (mv-nth 1 (%qw1)))
                   (ctx (%qbctx)))
        (:instance eval-unbox-ll-reaches-p-elim
                   (new-target (%qntv)) (ispaces (%qis)) (var (%qv))
                   (new-body (%qnb)) (type (%qtval))
                   (val (eval-unbox (%qtv) (%qis) (%qv) (%qb) (%qtval) denv
                                    (1- limit))))
        (:instance eval-expr-of-unboxn-at-sum-limit
                   (nt (%qnt)) (nd new-denv) (i (expr-unboxn->ispaces x))
                   (v (%qv)) (nb (%qnb)) (ty (expr-unboxn->type? x))
                   (l1 (mv-nth 0 (%qw1))) (l2 (mv-nth 0 (%qw2))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (ll-context-new-expr x ctx))
                   (limit2 (+ 1 (mv-nth 0 (%qw1)) (mv-nth 0 (%qw2))))
                   (w (mv-nth 1 (%qw2)))
                   (val (eval-expr x denv limit))))
  :in-theory (disable ll-expr eval-expr eval-unbox expr-denv-ll-related-p
                      ll-context-ok-p ll-context-new-expr ll-context-lifted
                      eval-expr-ll-ok eval-expr-ll-ok-necc eval-unbox-ll-ok
                      eval-unbox-ll-ok-necc eval-expr-ll-reaches-p
                      eval-expr-ll-reaches-p-suff eval-unbox-ll-reaches-p
                      expr-value-ll-related-p names-in-context-p
                      equal-of-expr-unboxn))


; Binding a variable excluded from the relation, in both environments.

(define ll-denv-witness-add ((v0 stringp) (w ll-value-witness-p)
                             (dw ll-denv-witness-p))
  :returns (new-dw ll-denv-witness-p)
  (change-ll-denv-witness dw :vals (omap::update (str-fix v0)
                                                 (ll-value-witness-fix w)
                                                 (ll-denv-witness->vals dw))))

(defrule ll-denv-witness-add-accessors
  (and (equal (ll-denv-witness->limit (ll-denv-witness-add v0 w dw))
              (ll-denv-witness->limit dw))
       (equal (omap::assoc var (ll-denv-witness->vals
                                (ll-denv-witness-add v0 w dw)))
              (if (equal var (str-fix v0))
                  (cons (str-fix v0) (ll-value-witness-fix w))
                (omap::assoc var (ll-denv-witness->vals dw)))))
  :enable (ll-denv-witness-add))

(acl2::defun-sk new-values-pointwise-p (names nd tenv)
  (forall n
          (implies (set::in n names)
                   (and (not (reserrp (expr-denv-lookup-expr n nd)))
                        (value-meets-required-type-p
                         (expr-denv-lookup-expr n nd) n tenv)))))

(local (in-theory (disable new-values-pointwise-p)))

(defruled new-values-meet-types-p-when-pointwise
  (implies (new-values-pointwise-p names nd tenv)
           (new-values-meet-types-p names nd tenv))
  :induct (set-ind names)
  :enable (omap::assoc-when-assoc-tail omap::assoc-when-emptyp
           (:t omap::tail-when-emptyp) set::in-tail set::tail-when-emptyp
           set::emptyp-subset-2
           new-values-meet-types-p)
  :hints (("Subgoal *1/2"
           :use ((:instance new-values-pointwise-p-necc (n (set::head names)))
                 (:instance new-values-pointwise-p-necc
                            (names names)
                            (n (new-values-pointwise-p-witness
                                (set::tail names) nd tenv))))
           :expand ((new-values-pointwise-p (set::tail names) nd tenv)))))

(defruled stringp-when-in-string-setp-local
  (implies (and (string-setp s) (set::in a s))
           (stringp a))
  :induct (set-ind s)
  :enable (string-setp))

(defruled new-values-meet-types-p-of-add-expr
  (implies (and (new-values-meet-types-p (set::delete v0 names) nd tenv)
                (string-setp names)
                (stringp v0)
                (expr-valuep nv)
                (value-meets-required-type-p nv v0 tenv))
           (new-values-meet-types-p names (expr-denv-add-expr v0 nv nd) tenv))
  :use ((:instance new-values-meet-types-p-when-pointwise
                   (nd (expr-denv-add-expr v0 nv nd)))
        (:instance new-values-meet-types-p-when-in
                   (names (set::delete v0 names)) (new-denv nd)
                   (name (new-values-pointwise-p-witness
                          names (expr-denv-add-expr v0 nv nd) tenv))))
  :expand ((new-values-pointwise-p names (expr-denv-add-expr v0 nv nd) tenv))
  :enable (expr-denv-lookup-expr-of-expr-denv-add-expr
           not-reserrp-when-expr-valuep stringp-when-in-string-setp-local)
  :disable (value-meets-required-type-p))

(defruled names-bound-as-in-p-of-add-expr
  (implies (and (names-bound-as-in-p s nd genv)
                (not (set::in v0 s))
                (stringp v0)
                (string-setp s))
           (names-bound-as-in-p s (expr-denv-add-expr v0 nv nd) genv))
  :induct (set-ind s)
  :enable (omap::assoc-when-assoc-tail omap::assoc-when-emptyp
           (:t omap::tail-when-emptyp) set::in-tail set::tail-when-emptyp
           set::emptyp-subset-2
           names-bound-as-in-p expr-denv-lookup-expr-of-expr-denv-add-expr))

(defruled lookup-of-with-names-from-of-add-expr-other
  (implies (and (string-setp s)
                (stringp n)
                (not (equal n (str-fix v0))))
           (equal (expr-denv-lookup-expr
                   n (expr-denv-with-names-from s (expr-denv-add-expr v0 nv nd)
                                                g))
                  (expr-denv-lookup-expr
                   n (expr-denv-with-names-from s nd g))))
  :enable (lookup-of-expr-denv-with-names-from
           expr-denv-lookup-expr-of-expr-denv-add-expr))

(defruled lookups-agree-p-of-with-names-from-of-add-expr
  (implies (and (string-setp s)
                (string-listp hns)
                (not (member-equal (str-fix v0) hns)))
           (lookups-agree-p
            hns
            (expr-denv-with-names-from s (expr-denv-add-expr v0 nv nd) g)
            (expr-denv-with-names-from s nd g)))
  :induct (len hns)
  :enable (lookups-agree-p len lookup-of-with-names-from-of-add-expr-other))

(defruled eval-replacement-of-add-expr
  (implies (and (ll-replacement-ok-p repl locals pnames genv)
                (string-setp locals)
                (string-listp pnames)
                (exprp repl)
                (member-equal v0 pnames)
                (stringp v0)
                (string-setp s))
           (equal (eval-expr repl
                             (expr-denv-with-names-from
                              s (expr-denv-add-expr v0 nv nd) g)
                             l)
                  (eval-expr repl (expr-denv-with-names-from s nd g) l)))
  :use (ll-replacement-ok-p-unpack
        (:instance eval-expr-of-apply-to-names-when-agree
                   (h (mv-nth 1 (replacement-parts repl)))
                   (names (mv-nth 2 (replacement-parts repl)))
                   (d1 (expr-denv-with-names-from
                        s (expr-denv-add-expr v0 nv nd) g))
                   (d2 (expr-denv-with-names-from s nd g)))
        (:instance lookups-agree-p-of-with-names-from-of-add-expr
                   (hns (mv-nth 2 (replacement-parts repl))))
        (:instance lookup-of-with-names-from-of-add-expr-other
                   (n (mv-nth 1 (replacement-parts repl))))
        (:instance acl2::intersectp-member
                   (a v0) (x (mv-nth 2 (replacement-parts repl))) (y pnames)))
  :disable (apply-to-names))

(defruled ll-var-ok-p-of-add-expr-other
  (implies (and (ll-var-ok-p var val nd nfv ctx dw genv)
                (stringp var)
                (not (equal var (str-fix v0)))
                (implies (omap::assoc var (ll-context->lmap ctx))
                         (ll-replacement-ok-p
                          (cdr (omap::assoc var (ll-context->lmap ctx)))
                          (ll-context->locals ctx) pnames genv))
                (string-listp pnames)
                (member-equal v0 pnames)
                (stringp v0))
           (ll-var-ok-p var val (expr-denv-add-expr v0 nv nd) nfv ctx
                        (ll-denv-witness-add v0 w dw) genv))
  :use ((:instance eval-replacement-of-add-expr
                   (repl (cdr (omap::assoc var (ll-context->lmap ctx))))
                   (locals (ll-context->locals ctx))
                   (s (set::difference
                       (expr-free-expr-vars
                        (cdr (omap::assoc var (ll-context->lmap ctx))))
                       (ll-context->locals ctx)))
                   (g genv)
                   (l (ll-denv-witness->limit dw))))
  :enable (ll-var-ok-p expr-denv-lookup-expr-of-expr-denv-add-expr)
  :disable (ll-replacement-ok-p eval-expr expr-value-ll-related-p
            value-meets-required-type-p value-has-inferred-type-p))

(defrule assoc-of-exprs-of-expr-denv-add-expr
  (equal (omap::assoc var (expr-denv->exprs (expr-denv-add-expr v0 val d)))
         (if (equal var (str-fix v0))
             (cons var (expr-value-fix val))
           (omap::assoc var (expr-denv->exprs d))))
  :enable (expr-denv-add-expr))

(defruled walker-of-add-excluded-at
  (implies (and (string-expr-value-map-ll-related-p
                 nd (expr-denv->exprs d) (set::delete v0 fv) nfv ctx dw genv)
                (string-setp fv)
                (stringp v0)
                (ll-var-ok-p v0 val (expr-denv-add-expr v0 nv nd) nfv ctx
                             (ll-denv-witness-add v0 w dw) genv)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx) pnames genv)
                (string-listp pnames)
                (member-equal v0 pnames)
                (expr-valuep val)
                (omap::assoc var
                             (expr-denv->exprs (expr-denv-add-expr v0 val d)))
                (set::in var fv))
           (ll-var-ok-p var
                        (cdr (omap::assoc var (expr-denv->exprs
                                               (expr-denv-add-expr v0 val d))))
                        (expr-denv-add-expr v0 nv nd) nfv ctx
                        (ll-denv-witness-add v0 w dw) genv))
  :use ((:instance walker-ll-var-ok-p-at
                   (new-denv nd) (map (expr-denv->exprs d))
                   (fv (set::delete v0 fv)))
        (:instance ll-var-ok-p-of-add-expr-other
                   (val (cdr (omap::assoc var (expr-denv->exprs d)))))
        (:instance ll-replacement-ok-p-when-lmap-replacements-ok-p
                   (lmap (ll-context->lmap ctx)) (locals
                                                  (ll-context->locals ctx))
                   (k var))
        (:instance stringp-when-in-string-setp-local (a var) (s fv)))
  :disable (ll-var-ok-p-of-add-expr-other ll-replacement-ok-p ll-var-ok-p
            lmap-replacements-ok-p eval-expr expr-value-ll-related-p
            value-meets-required-type-p value-has-inferred-type-p))

(defruled walker-of-add-excluded
  (implies (and (string-expr-value-map-ll-related-p
                 nd (expr-denv->exprs d) (set::delete v0 fv) nfv ctx dw genv)
                (string-setp fv)
                (stringp v0)
                (ll-var-ok-p v0 val (expr-denv-add-expr v0 nv nd) nfv ctx
                             (ll-denv-witness-add v0 w dw) genv)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx) pnames genv)
                (string-listp pnames)
                (member-equal v0 pnames)
                (expr-valuep val))
           (string-expr-value-map-ll-related-p
            (expr-denv-add-expr v0 nv nd)
            (expr-denv->exprs (expr-denv-add-expr v0 val d))
            fv nfv ctx (ll-denv-witness-add v0 w dw) genv))
  :use ((:instance string-expr-value-map-ll-related-p-when-pointwise
                   (new-denv (expr-denv-add-expr v0 nv nd))
                   (map (expr-denv->exprs (expr-denv-add-expr v0 val d)))
                   (dw (ll-denv-witness-add v0 w dw)))
        (:instance walker-of-add-excluded-at
                   (var (walker-pointwise-p-witness
                         (expr-denv-add-expr v0 nv nd)
                         (expr-denv->exprs (expr-denv-add-expr v0 val d))
                         fv nfv ctx (ll-denv-witness-add v0 w dw) genv))))
  :expand ((walker-pointwise-p (expr-denv-add-expr v0 nv nd)
                               (expr-denv->exprs (expr-denv-add-expr v0 val d))
                               fv nfv ctx (ll-denv-witness-add v0 w dw) genv))
  :disable (ll-var-ok-p walker-pointwise-p-necc lmap-replacements-ok-p
            assoc-of-exprs-of-expr-denv-add-expr))

(defruled ll-var-ok-p-of-added
  (implies (and (stringp v0)
                (set::in v0 (ll-context->locals ctx))
                (not (omap::assoc v0 (ll-context->lmap ctx)))
                (expr-valuep val)
                (expr-valuep nv)
                (ll-value-witness-p w)
                (implies (set::in v0 nfv)
                         (expr-value-ll-related-p nv val w genv))
                (value-meets-required-type-p val v0 (ll-context->tenv ctx))
                (implies (set::in v0 (ll-context->tlets ctx))
                         (value-has-inferred-type-p val v0
                                                    (ll-context->tenv ctx))))
           (ll-var-ok-p v0 val (expr-denv-add-expr v0 nv nd) nfv ctx
                        (ll-denv-witness-add v0 w dw) genv))
  :enable (ll-var-ok-p expr-denv-lookup-expr-of-expr-denv-add-expr
           not-reserrp-when-expr-valuep)
  :disable (expr-value-ll-related-p value-meets-required-type-p
            value-has-inferred-type-p))

(defrule expr-denv->tenv-of-expr-denv-add-expr-local
  (equal (expr-denv->tenv (expr-denv-add-expr v x d))
         (expr-denv->tenv d))
  :enable (expr-denv-add-expr))

; The main lemma.

(defruled expr-denv-ll-related-p-of-add-excluded
  (implies (and (expr-denv-ll-related-p nd d y ctx (list v0) dw genv)
                (stringp v0)
                (set::in v0 (ll-context->locals ctx))
                (not (omap::assoc v0 (ll-context->lmap ctx)))
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx) pnames genv)
                (string-listp pnames)
                (member-equal v0 pnames)
                (expr-valuep val)
                (expr-valuep nv)
                (ll-value-witness-p w)
                (implies (set::in v0 (expr-free-expr-vars
                                      (ll-context-new-expr y ctx)))
                         (expr-value-ll-related-p nv val w genv))
                (value-meets-required-type-p val v0 (ll-context->tenv ctx))
                (value-meets-required-type-p nv v0 (ll-context->tenv ctx))
                (implies (set::in v0 (ll-context->tlets ctx))
                         (value-has-inferred-type-p val v0
                                                    (ll-context->tenv ctx))))
           (expr-denv-ll-related-p (expr-denv-add-expr v0 nv nd)
                                   (expr-denv-add-expr v0 val d)
                                   y ctx nil (ll-denv-witness-add v0 w dw)
                                   genv))
  :use ((:instance walker-of-add-excluded
                   (fv (expr-free-expr-vars y))
                   (nfv (expr-free-expr-vars (ll-context-new-expr y ctx))))
        (:instance ll-var-ok-p-of-added
                   (nfv (expr-free-expr-vars (ll-context-new-expr y ctx))))
        (:instance names-bound-as-in-p-of-add-expr
                   (s (set::difference
                       (expr-free-expr-vars (ll-context-new-expr y ctx))
                       (ll-context->locals ctx))))
        (:instance new-values-meet-types-p-of-add-expr
                   (names (set::intersect
                           (expr-free-expr-vars (ll-context-new-expr y ctx))
                           (ll-context->locals ctx)))
                   (tenv (ll-context->tenv ctx)))
        (:instance difference-of-singleton-mergesort-local
                   (s (expr-free-expr-vars y)))
        (:instance difference-of-singleton-mergesort-local
                   (s (set::intersect
                       (expr-free-expr-vars (ll-context-new-expr y ctx))
                       (ll-context->locals ctx)))))
  :expand ((expr-denv-ll-related-p nd d y ctx (list v0) dw genv)
           (expr-denv-ll-related-p (expr-denv-add-expr v0 nv nd)
                                   (expr-denv-add-expr v0 val d)
                                   y ctx nil (ll-denv-witness-add v0 w dw)
                                   genv))
  :enable (difference-of-nil-when-setp)
  :disable (walker-of-add-excluded ll-var-ok-p lmap-replacements-ok-p
            names-bound-as-in-p-when-subset new-values-meet-types-p-when-subset
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

