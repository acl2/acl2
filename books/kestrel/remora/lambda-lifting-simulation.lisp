                                              genv)))))

(acl2::defun-sk eval-app-ll-ok (funval argvals limit)
  (forall (new-funval new-argvals w ws genv)
          (b* ((val (eval-app funval argvals limit)))
            (implies (and (not (reserrp val))
                          (expr-value-ll-related-p new-funval funval w genv)
                          (expr-value-list-ll-related-p new-argvals argvals ws
                                                        genv)
                          (expr-value-wfp funval)
                          (expr-value-wfp new-funval)
                          (expr-value-list-wfp argvals)
                          (expr-value-list-wfp new-argvals))
                     (eval-app-ll-reaches-p new-funval new-argvals val
                                            genv)))))

(acl2::defun-sk eval-app-list-ll-ok (funcells argcells limit)
  (forall (new-funcells new-argcells ws1 ws2 genv)
          (b* ((vals (eval-app-list funcells argcells limit)))
            (implies (and (not (reserrp vals))
                          (expr-value-list-ll-related-p new-funcells funcells
                                                        ws1 genv)
                          (expr-value-list-ll-related-p new-argcells argcells
                                                        ws2 genv)
                          (expr-value-list-wfp funcells)
                          (expr-value-list-wfp new-funcells)
                          (expr-value-list-wfp argcells)
                          (expr-value-list-wfp new-argcells))
                     (eval-app-list-ll-reaches-p new-funcells new-argcells
                                                 vals genv)))))

(acl2::defun-sk eval-app-cell-ll-ok (funcell argcell limit)
  (forall (new-funcell new-argcell w1 w2 genv)
