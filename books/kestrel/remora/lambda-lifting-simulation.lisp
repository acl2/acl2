; EVAL-PRIMOP-FUN: first-order operations are covered by
; EVAL-PRIMOP-FUN-FO-LL (at the same limit); the last stages of reduce and
; fold are covered by their statements (one more than their limit).

(defruled eval-primop-fun-when-ok-local
  (implies (not (reserrp (eval-primop-fun op arg l)))
           (and (posp l)
                (implies (primop-value-fun-fo-p op)
                         (equal (eval-primop-fun op arg l)
                                (eval-primop-fun-fo op arg)))
                (implies (not (primop-value-fun-fo-p op))
                         (or (equal (primop-value-kind op) :reduce-t-d-s-f)
                             (equal (primop-value-kind op)
                                    :fold-t-t2-d-s-s2-f-z)))
                (implies (and (not (primop-value-fun-fo-p op))
                              (equal (primop-value-kind op) :reduce-t-d-s-f))
                         (equal (eval-primop-fun op arg l)
                                (prim-reduce
                                 (primop-value-reduce-t-d-s-f->tval op)
                                 (primop-value-reduce-t-d-s-f->dval op)
                                 (primop-value-reduce-t-d-s-f->sval op)
                                 (primop-value-reduce-t-d-s-f->fval op)
                                 arg (1- l))))
                (implies (and (not (primop-value-fun-fo-p op))
                              (equal (primop-value-kind op)
                                     :fold-t-t2-d-s-s2-f-z))
                         (equal (eval-primop-fun op arg l)
                                (prim-fold
                                 (primop-value-fold-t-t2-d-s-s2-f-z->tval op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->t2val op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->dval op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->sval op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->s2val op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->fval op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->zval op)
                                 arg (1- l))))))
  :expand ((eval-primop-fun op arg l)))

(defruled eval-primop-fun-when-fo
  (implies (and (not (zp limit))
                (primop-value-fun-fo-p op))
           (equal (eval-primop-fun op arg limit)
                  (eval-primop-fun-fo op arg)))
  :expand ((eval-primop-fun op arg limit)))

(defruled eval-primop-fun-at-succ
  (implies (and (natp l)
                (not (primop-value-fun-fo-p op)))
           (and (implies (equal (primop-value-kind op) :reduce-t-d-s-f)
                         (equal (eval-primop-fun op arg (+ 1 l))
                                (prim-reduce
                                 (primop-value-reduce-t-d-s-f->tval op)
                                 (primop-value-reduce-t-d-s-f->dval op)
                                 (primop-value-reduce-t-d-s-f->sval op)
                                 (primop-value-reduce-t-d-s-f->fval op)
                                 arg l)))
                (implies (equal (primop-value-kind op) :fold-t-t2-d-s-s2-f-z)
                         (equal (eval-primop-fun op arg (+ 1 l))
                                (prim-fold
                                 (primop-value-fold-t-t2-d-s-s2-f-z->tval op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->t2val op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->dval op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->sval op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->s2val op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->fval op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->zval op)
                                 arg l)))))
  :expand ((eval-primop-fun op arg (+ 1 l))))

(defruled primop-value-fun-fo-p-when-related
  (implies (primop-value-ll-related-p new-op op ws genv)
           (equal (primop-value-fun-fo-p new-op) (primop-value-fun-fo-p op)))
  :use primop-value-kind-when-related
  :enable primop-value-fun-fo-p)

(defruled primop-value-reduce-decompose-when-ll-related
  (implies (and (primop-value-ll-related-p new-op op ws genv)
                (equal (primop-value-kind op) :reduce-t-d-s-f))
           (and (equal (primop-value-kind new-op) :reduce-t-d-s-f)
                (equal (primop-value-reduce-t-d-s-f->tval new-op)
                       (primop-value-reduce-t-d-s-f->tval op))
                (equal (primop-value-reduce-t-d-s-f->dval new-op)
                       (primop-value-reduce-t-d-s-f->dval op))
                (equal (primop-value-reduce-t-d-s-f->sval new-op)
                       (primop-value-reduce-t-d-s-f->sval op))
                (expr-value-ll-related-p
                 (primop-value-reduce-t-d-s-f->fval new-op)
                 (primop-value-reduce-t-d-s-f->fval op)
                 (car (ll-value-witness-list-fix ws)) genv)))
  :expand ((primop-value-ll-related-p new-op op ws genv)))

(defruled primop-value-fold-decompose-when-ll-related
  (implies (and (primop-value-ll-related-p new-op op ws genv)
                (equal (primop-value-kind op) :fold-t-t2-d-s-s2-f-z))
           (and (equal (primop-value-kind new-op) :fold-t-t2-d-s-s2-f-z)
                (equal (primop-value-fold-t-t2-d-s-s2-f-z->tval new-op)
                       (primop-value-fold-t-t2-d-s-s2-f-z->tval op))
                (equal (primop-value-fold-t-t2-d-s-s2-f-z->t2val new-op)
                       (primop-value-fold-t-t2-d-s-s2-f-z->t2val op))
                (equal (primop-value-fold-t-t2-d-s-s2-f-z->dval new-op)
                       (primop-value-fold-t-t2-d-s-s2-f-z->dval op))
                (equal (primop-value-fold-t-t2-d-s-s2-f-z->sval new-op)
                       (primop-value-fold-t-t2-d-s-s2-f-z->sval op))
                (equal (primop-value-fold-t-t2-d-s-s2-f-z->s2val new-op)
                       (primop-value-fold-t-t2-d-s-s2-f-z->s2val op))
                (expr-value-ll-related-p
                 (primop-value-fold-t-t2-d-s-s2-f-z->fval new-op)
                 (primop-value-fold-t-t2-d-s-s2-f-z->fval op)
                 (car (ll-value-witness-list-fix ws)) genv)
                (expr-value-ll-related-p
                 (primop-value-fold-t-t2-d-s-s2-f-z->zval new-op)
                 (primop-value-fold-t-t2-d-s-s2-f-z->zval op)
                 (cadr (ll-value-witness-list-fix ws)) genv)))
  :expand ((primop-value-ll-related-p new-op op ws genv)))

(defruled prim-reduce-ll-reaches-p-elim
  (implies (prim-reduce-ll-reaches-p tval d s new-fval new-arg val genv)
           (b* (((mv l w)
                 (prim-reduce-ll-reaches-p-witness tval d s new-fval new-arg
                                                   val genv))
                (nv (prim-reduce tval d s new-fval new-arg l)))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv val w genv))))
  :enable prim-reduce-ll-reaches-p)

(defruled prim-fold-ll-reaches-p-elim
  (implies (prim-fold-ll-reaches-p tval t2val d s s2 new-fval new-zval new-arg
                                   val genv)
           (b* (((mv l w)
                 (prim-fold-ll-reaches-p-witness tval t2val d s s2 new-fval
                                                 new-zval new-arg val genv))
                (nv (prim-fold tval t2val d s s2 new-fval new-zval new-arg l)))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv val w genv))))
  :enable prim-fold-ll-reaches-p)

(defruled posp-limit-when-prim-reduce-ok
  (implies (not (reserrp (prim-reduce tval d s fval arg limit)))
           (posp limit))
  :expand ((prim-reduce tval d s fval arg limit)))

(defruled posp-limit-when-prim-fold-ok
  (implies (not (reserrp (prim-fold tval t2val d s s2 fval zval arg limit)))
           (posp limit))
  :expand ((prim-fold tval t2val d s s2 fval zval arg limit)))

(defruled eval-primop-fun-ll-reaches-p-when-fo
  (implies (and (primop-value-fun-fo-p op)
                (not (reserrp (eval-primop-fun op arg limit)))
                (primop-value-ll-related-p new-op op ws genv)
                (expr-value-ll-related-p new-arg arg w genv)
                (primop-value-wfp op)
                (primop-value-wfp new-op)
                (expr-value-wfp arg)
                (expr-value-wfp new-arg))
           (eval-primop-fun-ll-reaches-p new-op new-arg
                                         (eval-primop-fun op arg limit) genv))
  :use ((:instance eval-primop-fun-when-ok-local (l limit))
        (:instance eval-primop-fun-when-ok-local (l limit) (op new-op)
                   (arg new-arg))
        primop-value-fun-fo-p-when-related
        (:instance eval-primop-fun-fo-ll (aw w))
        (:instance eval-primop-fun-when-fo (op new-op) (arg new-arg))
        (:instance expr-value-ll-equiv-p
                   (new-val (eval-primop-fun-fo new-op new-arg))
                   (val (eval-primop-fun-fo op arg)))
        (:instance eval-primop-fun-ll-reaches-p-suff
                   (val (eval-primop-fun op arg limit))
                   (limit2 limit)
                   (w (expr-value-ll-equiv-p-witness
                       (eval-primop-fun-fo new-op new-arg)
                       (eval-primop-fun-fo op arg) genv))))
  :disable (eval-primop-fun eval-primop-fun-fo eval-primop-fun-ll-reaches-p-suff
            expr-value-ll-equiv-p primop-value-ll-related-p
            expr-value-ll-related-p))

(defmacro %prw ()
  '(prim-reduce-ll-reaches-p-witness
    (primop-value-reduce-t-d-s-f->tval op)
    (primop-value-reduce-t-d-s-f->dval op)
    (primop-value-reduce-t-d-s-f->sval op)
    (primop-value-reduce-t-d-s-f->fval new-op)
    new-arg (eval-primop-fun op arg limit) genv))

(defruled eval-primop-fun-ll-reaches-p-when-reduce
  (implies (and (not (primop-value-fun-fo-p op))
                (equal (primop-value-kind op) :reduce-t-d-s-f)
                (not (reserrp (eval-primop-fun op arg limit)))
                (prim-reduce-ll-ok (primop-value-reduce-t-d-s-f->tval op)
                                   (primop-value-reduce-t-d-s-f->dval op)
                                   (primop-value-reduce-t-d-s-f->sval op)
                                   (primop-value-reduce-t-d-s-f->fval op)
                                   arg (1- limit))
                (primop-value-ll-related-p new-op op ws genv)
                (expr-value-ll-related-p new-arg arg w genv)
                (primop-value-wfp op)
                (primop-value-wfp new-op)
                (expr-value-wfp arg)
                (expr-value-wfp new-arg))
           (eval-primop-fun-ll-reaches-p new-op new-arg
                                         (eval-primop-fun op arg limit) genv))
  :use ((:instance eval-primop-fun-when-ok-local (l limit))
        primop-value-fun-fo-p-when-related
        primop-value-reduce-decompose-when-ll-related
        (:instance prim-reduce-ll-ok-necc
                   (tval (primop-value-reduce-t-d-s-f->tval op))
                   (d (primop-value-reduce-t-d-s-f->dval op))
                   (s (primop-value-reduce-t-d-s-f->sval op))
                   (fval (primop-value-reduce-t-d-s-f->fval op))
                   (limit (1- limit))
                   (new-fval (primop-value-reduce-t-d-s-f->fval new-op))
                   (w1 (car (ll-value-witness-list-fix ws))) (w2 w))
        (:instance prim-reduce-ll-reaches-p-elim
                   (tval (primop-value-reduce-t-d-s-f->tval op))
                   (d (primop-value-reduce-t-d-s-f->dval op))
                   (s (primop-value-reduce-t-d-s-f->sval op))
                   (new-fval (primop-value-reduce-t-d-s-f->fval new-op))
                   (val (eval-primop-fun op arg limit)))
        (:instance posp-limit-when-prim-reduce-ok
                   (tval (primop-value-reduce-t-d-s-f->tval op))
                   (d (primop-value-reduce-t-d-s-f->dval op))
                   (s (primop-value-reduce-t-d-s-f->sval op))
                   (fval (primop-value-reduce-t-d-s-f->fval new-op))
                   (arg new-arg) (limit (mv-nth 0 (%prw))))
        (:instance eval-primop-fun-at-succ
                   (op new-op) (arg new-arg) (l (mv-nth 0 (%prw))))
        (:instance eval-primop-fun-ll-reaches-p-suff
                   (val (eval-primop-fun op arg limit))
                   (limit2 (+ 1 (mv-nth 0 (%prw))))
                   (w (mv-nth 1 (%prw)))))
  :disable (eval-primop-fun prim-reduce eval-primop-fun-ll-reaches-p-suff
            prim-reduce-ll-ok prim-reduce-ll-ok-necc prim-reduce-ll-reaches-p
            primop-value-ll-related-p expr-value-ll-related-p))

(defmacro %pdw ()
  '(prim-fold-ll-reaches-p-witness
    (primop-value-fold-t-t2-d-s-s2-f-z->tval op)
    (primop-value-fold-t-t2-d-s-s2-f-z->t2val op)
    (primop-value-fold-t-t2-d-s-s2-f-z->dval op)
    (primop-value-fold-t-t2-d-s-s2-f-z->sval op)
    (primop-value-fold-t-t2-d-s-s2-f-z->s2val op)
    (primop-value-fold-t-t2-d-s-s2-f-z->fval new-op)
    (primop-value-fold-t-t2-d-s-s2-f-z->zval new-op)
    new-arg (eval-primop-fun op arg limit) genv))

(defruled eval-primop-fun-ll-reaches-p-when-fold
  (implies (and (not (primop-value-fun-fo-p op))
                (equal (primop-value-kind op) :fold-t-t2-d-s-s2-f-z)
                (not (reserrp (eval-primop-fun op arg limit)))
                (prim-fold-ll-ok (primop-value-fold-t-t2-d-s-s2-f-z->tval op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->t2val op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->dval op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->sval op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->s2val op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->fval op)
                                 (primop-value-fold-t-t2-d-s-s2-f-z->zval op)
                                 arg (1- limit))
                (primop-value-ll-related-p new-op op ws genv)
                (expr-value-ll-related-p new-arg arg w genv)
                (primop-value-wfp op)
                (primop-value-wfp new-op)
                (expr-value-wfp arg)
                (expr-value-wfp new-arg))
           (eval-primop-fun-ll-reaches-p new-op new-arg
                                         (eval-primop-fun op arg limit) genv))
  :use ((:instance eval-primop-fun-when-ok-local (l limit))
        primop-value-fun-fo-p-when-related
        primop-value-fold-decompose-when-ll-related
        (:instance prim-fold-ll-ok-necc
                   (tval (primop-value-fold-t-t2-d-s-s2-f-z->tval op))
                   (t2val (primop-value-fold-t-t2-d-s-s2-f-z->t2val op))
                   (d (primop-value-fold-t-t2-d-s-s2-f-z->dval op))
                   (s (primop-value-fold-t-t2-d-s-s2-f-z->sval op))
                   (s2 (primop-value-fold-t-t2-d-s-s2-f-z->s2val op))
                   (fval (primop-value-fold-t-t2-d-s-s2-f-z->fval op))
                   (zval (primop-value-fold-t-t2-d-s-s2-f-z->zval op))
                   (limit (1- limit))
                   (new-fval (primop-value-fold-t-t2-d-s-s2-f-z->fval new-op))
                   (new-zval (primop-value-fold-t-t2-d-s-s2-f-z->zval new-op))
                   (w1 (car (ll-value-witness-list-fix ws)))
                   (w2 (cadr (ll-value-witness-list-fix ws))) (w3 w))
        (:instance prim-fold-ll-reaches-p-elim
                   (tval (primop-value-fold-t-t2-d-s-s2-f-z->tval op))
                   (t2val (primop-value-fold-t-t2-d-s-s2-f-z->t2val op))
                   (d (primop-value-fold-t-t2-d-s-s2-f-z->dval op))
                   (s (primop-value-fold-t-t2-d-s-s2-f-z->sval op))
                   (s2 (primop-value-fold-t-t2-d-s-s2-f-z->s2val op))
                   (new-fval (primop-value-fold-t-t2-d-s-s2-f-z->fval new-op))
                   (new-zval (primop-value-fold-t-t2-d-s-s2-f-z->zval new-op))
                   (val (eval-primop-fun op arg limit)))
        (:instance posp-limit-when-prim-fold-ok
                   (tval (primop-value-fold-t-t2-d-s-s2-f-z->tval op))
                   (t2val (primop-value-fold-t-t2-d-s-s2-f-z->t2val op))
                   (d (primop-value-fold-t-t2-d-s-s2-f-z->dval op))
                   (s (primop-value-fold-t-t2-d-s-s2-f-z->sval op))
                   (s2 (primop-value-fold-t-t2-d-s-s2-f-z->s2val op))
                   (fval (primop-value-fold-t-t2-d-s-s2-f-z->fval new-op))
                   (zval (primop-value-fold-t-t2-d-s-s2-f-z->zval new-op))
                   (arg new-arg) (limit (mv-nth 0 (%pdw))))
        (:instance eval-primop-fun-at-succ
                   (op new-op) (arg new-arg) (l (mv-nth 0 (%pdw))))
        (:instance eval-primop-fun-ll-reaches-p-suff
                   (val (eval-primop-fun op arg limit))
                   (limit2 (+ 1 (mv-nth 0 (%pdw))))
                   (w (mv-nth 1 (%pdw)))))
  :disable (eval-primop-fun prim-fold eval-primop-fun-ll-reaches-p-suff
            prim-fold-ll-ok prim-fold-ll-ok-necc prim-fold-ll-reaches-p
            primop-value-ll-related-p expr-value-ll-related-p)
  :enable (primop-value-fun-fo-p-when-related
           primop-value-fold-decompose-when-ll-related))

(defmacro %pfnw () '(eval-primop-fun-ll-ok-witness op arg limit))

(defruled eval-primop-fun-ll-ok-when-ok
  (implies (and (implies (and (not (zp limit))
                              (not (primop-value-fun-fo-p op))
                              (equal (primop-value-kind op) :reduce-t-d-s-f))
                         (prim-reduce-ll-ok
                          (primop-value-reduce-t-d-s-f->tval op)
                          (primop-value-reduce-t-d-s-f->dval op)
                          (primop-value-reduce-t-d-s-f->sval op)
                          (primop-value-reduce-t-d-s-f->fval op)
                          arg (1- limit)))
                (implies (and (not (zp limit))
                              (not (primop-value-fun-fo-p op))
                              (equal (primop-value-kind op)
                                     :fold-t-t2-d-s-s2-f-z))
                         (prim-fold-ll-ok
                          (primop-value-fold-t-t2-d-s-s2-f-z->tval op)
                          (primop-value-fold-t-t2-d-s-s2-f-z->t2val op)
                          (primop-value-fold-t-t2-d-s-s2-f-z->dval op)
                          (primop-value-fold-t-t2-d-s-s2-f-z->sval op)
                          (primop-value-fold-t-t2-d-s-s2-f-z->s2val op)
                          (primop-value-fold-t-t2-d-s-s2-f-z->fval op)
                          (primop-value-fold-t-t2-d-s-s2-f-z->zval op)
                          arg (1- limit))))
           (eval-primop-fun-ll-ok op arg limit))
  :expand ((eval-primop-fun-ll-ok op arg limit))
  :use ((:instance eval-primop-fun-when-ok-local (l limit))
        (:instance eval-primop-fun-ll-reaches-p-when-fo
                   (new-op (mv-nth 0 (%pfnw))) (new-arg (mv-nth 1 (%pfnw)))
                   (ws (mv-nth 2 (%pfnw))) (w (mv-nth 3 (%pfnw)))
                   (genv (mv-nth 4 (%pfnw))))
        (:instance eval-primop-fun-ll-reaches-p-when-reduce
                   (new-op (mv-nth 0 (%pfnw))) (new-arg (mv-nth 1 (%pfnw)))
                   (ws (mv-nth 2 (%pfnw))) (w (mv-nth 3 (%pfnw)))
                   (genv (mv-nth 4 (%pfnw))))
        (:instance eval-primop-fun-ll-reaches-p-when-fold
                   (new-op (mv-nth 0 (%pfnw))) (new-arg (mv-nth 1 (%pfnw)))
                   (ws (mv-nth 2 (%pfnw))) (w (mv-nth 3 (%pfnw)))
                   (genv (mv-nth 4 (%pfnw)))))
  :disable (eval-primop-fun prim-reduce-ll-ok prim-fold-ll-ok
            eval-primop-fun-ll-reaches-p primop-value-ll-related-p
            expr-value-ll-related-p))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The induction.  First, the statements in the form the induction of the
; evaluator clique supplies them: each induction hypothesis is guarded by the
; conditions under which the evaluator makes the corresponding call (the
; case lemmas above take some of them unguarded, which is fine when the
; evaluation does not fail), and the zero-limit case is separate.

(defruled eval-expr-ll-ok-when-zp-limit
