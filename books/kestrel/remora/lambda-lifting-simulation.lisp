; EVAL-UNBOX-LIST: the targets are unboxed one by one.

(defruled eval-unbox-list-when-ok-local
  (implies (not (reserrp (eval-unbox-list tgs ispaces var body type d l)))
           (and (posp l)
                (implies (not (consp tgs))
                         (equal (eval-unbox-list tgs ispaces var body type d l)
                                nil))
                (implies (consp tgs)
                         (and (not (reserrp (eval-unbox (car tgs) ispaces var
                                                        body type d (1- l))))
                              (not (reserrp (eval-unbox-list (cdr tgs) ispaces
                                                             var body type d
                                                             (1- l))))
                              (equal (eval-unbox-list tgs ispaces var body type
                                                      d l)
                                     (cons
                                      (eval-unbox (car tgs) ispaces var body
                                                       type d (1- l))
                                           (eval-unbox-list (cdr tgs) ispaces
                                                            var body type d
                                                            (1- l))))))))
  :expand ((eval-unbox-list tgs ispaces var body type d l)))

(defruled eval-unbox-list-of-nil-at-limit
  (implies (and (not (consp tgs)) (posp l))
           (equal (eval-unbox-list tgs ispaces var body type d l) nil))
  :expand ((eval-unbox-list tgs ispaces var body type d l)))

(defruled eval-unbox-list-of-cons-at-sum
  (implies (and (consp tgs)
                (not
                 (reserrp (eval-unbox (car tgs) ispaces var body type d l1)))
                (not (reserrp (eval-unbox-list (cdr tgs) ispaces var body type d
                                               l2))))
           (equal (eval-unbox-list tgs ispaces var body type d (+ 1 l1 l2))
                  (cons (eval-unbox (car tgs) ispaces var body type d l1)
                        (eval-unbox-list (cdr tgs) ispaces var body type d
                                         l2))))
  :use ((:instance posp-limit-when-eval-unbox-ok
                   (target (car tgs)) (denv d) (limit l1))
        (:instance posp-limit-when-eval-unbox-list-ok
                   (targets (cdr tgs)) (denv d) (limit l2))
        (:instance eval-unbox-at-larger-limit
                   (target (car tgs)) (denv d) (limit l1) (limit2 (+ l1 l2)))
        (:instance eval-unbox-list-of-larger-limit
                   (targets (cdr tgs)) (denv d) (limit l2) (k l1)))
  :expand ((eval-unbox-list tgs ispaces var body type d (+ 1 l1 l2))))

(defruled eval-unbox-list-ll-reaches-p-of-cons-generic
  (implies (and (consp nts)
                (not (reserrp (eval-unbox (car nts) ispaces var nb type nd l1)))
                (expr-value-ll-related-p
                 (eval-unbox (car nts) ispaces var nb type nd l1) v w1 genv)
                (not (reserrp (eval-unbox-list (cdr nts) ispaces var nb type nd
                                               l2)))
                (expr-value-list-ll-related-p
                 (eval-unbox-list (cdr nts) ispaces var nb type nd l2) vs ws2
                 genv)
                (equal vals (cons v vs)))
           (eval-unbox-list-ll-reaches-p nts ispaces var nb type nd vals genv))
  :use ((:instance eval-unbox-list-of-cons-at-sum
                   (tgs nts) (body nb) (d nd))
        (:instance eval-unbox-list-ll-reaches-p-suff
                   (new-targets nts) (new-body nb) (new-denv nd) (val vals)
                   (limit2 (+ 1 l1 l2)) (w (cons w1 ws2))))
  :expand ((:free (a b c d e f)
                  (expr-value-list-ll-related-p (cons a b) (cons c d) (cons e f)
                                                genv)))
  :disable (eval-unbox eval-unbox-list eval-unbox-list-ll-reaches-p-suff
            expr-value-ll-related-p)
  :enable (not-reserrp-when-expr-value-listp expr-valuep-when-result-not-error
           expr-value-listp-when-result-not-error))

(defmacro %ulw ()
  '(eval-unbox-list-ll-ok-witness targets ispaces var body type denv limit))

(defmacro %ulnt () '(mv-nth 0 (%ulw)))

(defmacro %ulws () '(mv-nth 1 (%ulw)))

(defmacro %ulctx () '(mv-nth 2 (%ulw)))

(defmacro %ulnd () '(mv-nth 3 (%ulw)))

(defmacro %uldw () '(mv-nth 4 (%ulw)))

(defmacro %ulg () '(mv-nth 5 (%ulw)))

(defmacro %ulnb () '(ll-context-new-expr body (%ulctx)))

(defruled eval-unbox-list-ll-reaches-p-of-cons-step
  (implies (and (consp nts)
                (eval-unbox-ll-ok tg ispaces var body type denv l)
                (eval-unbox-list-ll-ok tgs ispaces var body type denv l)
                (not (reserrp (eval-unbox tg ispaces var body type denv l)))
                (not (reserrp (eval-unbox-list tgs ispaces var body type denv
                                               l)))
                (expr-value-ll-related-p (car nts) tg w g)
                (expr-value-list-ll-related-p (cdr nts) tgs ws g)
                (names-in-context-p (list var) ctx)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        (list var) g)
                (not (omap::assoc var (ll-context->tenv ctx)))
                (stringp var)
                (expr-denv-ll-related-p new-denv denv body ctx (list var) dw g)
                (ll-context-ok-p body ctx g)
                (expr-value-wfp tg)
                (expr-value-wfp (car nts))
                (expr-value-list-wfp tgs)
                (expr-value-list-wfp (cdr nts))
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (eval-unbox-list-ll-reaches-p
            nts ispaces var (ll-context-new-expr body ctx) type new-denv
            (cons (eval-unbox tg ispaces var body type denv l)
                  (eval-unbox-list tgs ispaces var body type denv l))
            g))
  :use ((:instance eval-unbox-ll-ok-necc
                   (target tg) (limit l) (new-target (car nts)) (genv g))
        (:instance eval-unbox-list-ll-ok-necc
                   (targets tgs) (limit l) (new-targets (cdr nts)) (genv g))
        (:instance eval-unbox-ll-reaches-p-elim
                   (new-target (car nts))
                   (new-body (ll-context-new-expr body ctx))
                   (val (eval-unbox tg ispaces var body type denv l))
                   (genv g))
        (:instance eval-unbox-list-ll-reaches-p-elim
                   (new-targets (cdr nts))
                   (new-body (ll-context-new-expr body ctx))
                   (vals (eval-unbox-list tgs ispaces var body type denv l))
                   (genv g))
        (:instance eval-unbox-list-ll-reaches-p-of-cons-generic
                   (nb (ll-context-new-expr body ctx)) (nd new-denv)
                   (l1 (mv-nth 0 (eval-unbox-ll-reaches-p-witness
                                  (car nts) ispaces var
                                  (ll-context-new-expr body ctx) type new-denv
                                  (eval-unbox tg ispaces var body type denv l)
                                  g)))
                   (l2 (mv-nth 0 (eval-unbox-list-ll-reaches-p-witness
                                  (cdr nts) ispaces var
                                  (ll-context-new-expr body ctx) type new-denv
                                  (eval-unbox-list tgs ispaces var body type
                                                   denv l)
                                  g)))
                   (v (eval-unbox tg ispaces var body type denv l))
                   (vs (eval-unbox-list tgs ispaces var body type denv l))
                   (w1 (mv-nth 1 (eval-unbox-ll-reaches-p-witness
                                  (car nts) ispaces var
                                  (ll-context-new-expr body ctx) type new-denv
                                  (eval-unbox tg ispaces var body type denv l)
                                  g)))
                   (ws2 (mv-nth 1 (eval-unbox-list-ll-reaches-p-witness
                                   (cdr nts) ispaces var
                                   (ll-context-new-expr body ctx) type new-denv
                                   (eval-unbox-list tgs ispaces var body type
                                                    denv l)
                                   g)))
                   (vals (cons (eval-unbox tg ispaces var body type denv l)
                               (eval-unbox-list tgs ispaces var body type denv
                                                l)))
                   (genv g)))
  :in-theory (theory 'minimal-theory))

(defruled eval-unbox-list-ll-ok-when-ok
  (implies (implies (consp targets)
                    (and (eval-unbox-ll-ok (car targets) ispaces var body type
                                           denv (1- limit))
                         (eval-unbox-list-ll-ok (cdr targets) ispaces var body
                                                type denv (1- limit))))
           (eval-unbox-list-ll-ok targets ispaces var body type denv limit))
  :cases ((consp targets))
  :hints (("Subgoal 2"
           :use ((:instance eval-unbox-list-when-ok-local
                            (tgs targets) (d denv) (l limit))
                 (:instance eval-unbox-list-of-nil-at-limit
                            (tgs (%ulnt)) (body (%ulnb)) (d (%ulnd)) (l limit))
                 (:instance eval-unbox-list-ll-reaches-p-suff
                            (new-targets (%ulnt)) (new-body (%ulnb))
                            (new-denv (%ulnd)) (limit2 limit) (w nil)
                            (val (eval-unbox-list targets ispaces var body type
                                                  denv limit))
                            (genv (%ulg))))
           :expand ((eval-unbox-list-ll-ok targets ispaces var body type denv
                                           limit)
                    (expr-value-list-ll-related-p (%ulnt) targets (%ulws)
                                                  (%ulg))
                    (expr-value-list-ll-related-p nil nil nil (%ulg))))
          ("Subgoal 1"
           :use ((:instance eval-unbox-list-when-ok-local
                            (tgs targets) (d denv) (l limit))
                 (:instance eval-unbox-list-ll-reaches-p-of-cons-step
                            (tg (car targets)) (tgs (cdr targets))
                            (l (1- limit)) (nts (%ulnt))
                            (w (car (%ulws))) (ws (cdr (%ulws)))
                            (ctx (%ulctx)) (new-denv (%ulnd)) (dw (%uldw))
                            (g (%ulg))))
           :expand ((eval-unbox-list-ll-ok targets ispaces var body type denv
                                           limit)
                    (expr-value-list-ll-related-p (%ulnt) targets (%ulws)
                                                  (%ulg)))))
  :disable (eval-unbox eval-unbox-list eval-unbox-ll-ok-necc
            eval-unbox-list-ll-ok-necc eval-unbox-list-ll-reaches-p-suff
            expr-value-ll-related-p expr-denv-ll-related-p ll-context-ok-p
            lmap-replacements-ok-p names-in-context-p))

; The statement for EVAL-UNBOX.

(defmacro %uokw ()
  '(eval-unbox-ll-ok-witness target ispaces var body type denv limit))

(defruled eval-unbox-not-error-kinds
  (implies (not (reserrp (eval-unbox target ispaces var body type denv limit)))
           (member-equal (expr-value-kind target)
                         '(:box :vector :vector-empty)))
  :expand ((eval-unbox target ispaces var body type denv limit)))

(defruled eval-unbox-ll-ok-when-ok
  (implies (and (implies (and (equal (expr-value-kind target) :box)
                              (not (consp (cdr ispaces))))
                         (eval-expr-ll-ok
                          body
                          (expr-denv-add-expr
                           var (expr-value-box->array target)
                           (expr-denv-add-ispace (car ispaces)
                                                 (expr-value-box->ispace target)
                                                 denv))
                          (1- limit)))
                (implies (and (equal (expr-value-kind target) :box)
                              (consp (cdr ispaces)))
                         (eval-unbox-ll-ok
                          (expr-value-box->array target) (cdr ispaces) var body
                          type
                          (expr-denv-add-ispace (car ispaces)
                                                (expr-value-box->ispace target)
                                                denv)
                          (1- limit)))
                (implies (equal (expr-value-kind target) :vector)
                         (eval-unbox-list-ll-ok
                          (expr-value-vector->elems target)
                                                ispaces var body type denv
