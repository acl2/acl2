  :use base-case-when-expr-value-ll-related-via-p)

(defruled check-expr-value-bool-when-related
  (implies (and (expr-value-ll-related-p new-val val w genv)
                (syntaxp (not (equal new-val val))))
           (equal (check-expr-value-bool new-val)
                  (check-expr-value-bool val)))
  :enable (check-expr-value-bool
           expr-value-kind-when-expr-value-ll-related-via-p-safe)
  :use base-case-when-expr-value-ll-related-via-p)

(defruled check-expr-value-int-when-ll-equiv
  (implies (and (expr-value-ll-equiv-p new-val val genv)
                (syntaxp (not (equal new-val val))))
           (equal (check-expr-value-int new-val)
                  (check-expr-value-int val)))
  :enable expr-value-ll-equiv-p
  :use ((:instance check-expr-value-int-when-related
                   (w (expr-value-ll-equiv-p-witness new-val val genv)))))

(defruled check-expr-value-int-of-car-when-list-ll-equiv
  (implies (and (expr-value-list-ll-equiv-p new-vals vals genv)
                (consp vals)
                (syntaxp (not (equal new-vals vals))))
           (equal (check-expr-value-int (car new-vals))
                  (check-expr-value-int (car vals))))
  :enable check-expr-value-int-when-ll-equiv
  :use expr-value-ll-equiv-p-of-car-when-list-ll-equiv)

(defruled check-expr-value-list-int-when-list-ll-equiv
  (implies (expr-value-list-ll-equiv-p new-vals vals genv)
           (equal (check-expr-value-list-int new-vals)
                  (check-expr-value-list-int vals)))
  :induct (two-cdrs-induct vals new-vals)
  :enable (check-expr-value-list-int
           consp-when-expr-value-list-ll-equiv-p
           expr-value-list-ll-equiv-p-of-cdr-when-list-ll-equiv
           check-expr-value-int-of-car-when-list-ll-equiv))

(defruled expr-value-vector-elements-ll-equiv
  (implies (expr-value-ll-equiv-p new-val val genv)
           (expr-value-list-ll-equiv-p (expr-value-vector-elements new-val)
                                       (expr-value-vector-elements val) genv))
  :enable (expr-value-vector-elements
           expr-value-kind-when-expr-value-ll-equiv-p
           expr-value-list-ll-equiv-p-of-vector-elems-when-ll-equiv
           expr-value-list-ll-equiv-p-of-nil))

; Atoms of related values.

(acl2::defun-sk atoms-ll-ok (val genv)
  (forall (new-val)
    (implies (expr-value-ll-equiv-p new-val val genv)
             (expr-value-list-ll-equiv-p (expr-value-atoms new-val)
                                         (expr-value-atoms val) genv))))

(acl2::defun-sk list-atoms-ll-ok (vals genv)
  (forall (new-vals)
    (implies (expr-value-list-ll-equiv-p new-vals vals genv)
             (expr-value-list-ll-equiv-p (expr-value-list-atoms new-vals)
                                         (expr-value-list-atoms vals) genv))))

(defruled atoms-ll-ok-when-vector
  (implies (and (equal (expr-value-kind val) :vector)
                (list-atoms-ll-ok (expr-value-vector->elems val) genv))
           (atoms-ll-ok val genv))
  :expand ((atoms-ll-ok val genv)
           (expr-value-atoms val)
           (expr-value-atoms (atoms-ll-ok-witness val genv)))
  :enable (expr-value-kind-when-expr-value-ll-equiv-p
           expr-value-list-ll-equiv-p-of-vector-elems-when-ll-equiv)
  :use ((:instance list-atoms-ll-ok-necc
                   (vals (expr-value-vector->elems val))
                   (new-vals
                    (expr-value-vector->elems
                     (atoms-ll-ok-witness val genv))))))

(defruled atoms-ll-ok-when-vector-empty
  (implies (equal (expr-value-kind val) :vector-empty)
           (atoms-ll-ok val genv))
  :expand ((atoms-ll-ok val genv)
           (expr-value-atoms val)
           (expr-value-atoms (atoms-ll-ok-witness val genv)))
  :enable (expr-value-kind-when-expr-value-ll-equiv-p
           expr-value-list-ll-equiv-p-of-nil))

(defruled atoms-ll-ok-when-otherwise
  (implies (and (not (equal (expr-value-kind val) :vector))
                (not (equal (expr-value-kind val) :vector-empty)))
           (atoms-ll-ok val genv))
  :expand ((atoms-ll-ok val genv)
           (expr-value-atoms val)
           (expr-value-atoms (atoms-ll-ok-witness val genv)))
  :enable (expr-value-kind-when-expr-value-ll-equiv-p
           expr-value-list-ll-equiv-p-of-singleton-fix-when-equiv))

(defruled list-atoms-ll-ok-when-endp
  (implies (not (consp vals))
           (list-atoms-ll-ok vals genv))
  :expand ((list-atoms-ll-ok vals genv)
           (expr-value-list-atoms vals)
           (expr-value-list-atoms (list-atoms-ll-ok-witness vals genv)))
  :enable (consp-when-expr-value-list-ll-equiv-p
           expr-value-list-ll-equiv-p-of-nil))

(defruled list-atoms-ll-ok-when-consp
  (implies (and (consp vals)
                (atoms-ll-ok (car vals) genv)
                (list-atoms-ll-ok (cdr vals) genv))
           (list-atoms-ll-ok vals genv))
  :expand ((list-atoms-ll-ok vals genv)
           (expr-value-list-atoms vals)
           (expr-value-list-atoms (list-atoms-ll-ok-witness vals genv)))
  :enable (consp-when-expr-value-list-ll-equiv-p
           expr-value-ll-equiv-p-of-car-when-list-ll-equiv
           expr-value-list-ll-equiv-p-of-cdr-when-list-ll-equiv
           expr-value-list-ll-equiv-p-of-append)
  :use ((:instance atoms-ll-ok-necc
                   (val (car vals))
                   (new-val (car (list-atoms-ll-ok-witness vals genv))))
        (:instance list-atoms-ll-ok-necc
                   (vals (cdr vals))
                   (new-vals (cdr (list-atoms-ll-ok-witness vals genv))))))

; The atoms clique does not export its flag function.

(flag::make-flag expr-values-atoms-flag2 expr-value-atoms
                 :flag-mapping ((expr-value-atoms expr-value-atoms)
                                (expr-value-list-atoms expr-value-list-atoms)))

(defthm-expr-values-atoms-flag2
  (defthm atoms-ll-ok-holds
    (atoms-ll-ok val genv)
    :flag expr-value-atoms)
  (defthm list-atoms-ll-ok-holds
    (list-atoms-ll-ok vals genv)
    :flag expr-value-list-atoms)
  :hints (("Goal"
           :in-theory (enable atoms-ll-ok-when-vector
                              atoms-ll-ok-when-vector-empty
                              atoms-ll-ok-when-otherwise
                              list-atoms-ll-ok-when-endp
                              list-atoms-ll-ok-when-consp))))

(defruled expr-value-atoms-ll-equiv
  (implies (expr-value-ll-equiv-p new-val val genv)
           (expr-value-list-ll-equiv-p (expr-value-atoms new-val)
                                       (expr-value-atoms val) genv))
  :enable atoms-ll-ok-holds
  :use atoms-ll-ok-necc)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The scalar primitives: their results depend only on the checked base
; values, which agree on related values, so the results are equal.  (The
; results are base values, hence ground: see VALUE-GROUNDNESS.)

; The lemmas have one shape for the binary primitives and one for the
; unary ones, so a macro generates them.

(defmacro def-prim-when-related (fn &key unary)
  `(defruled ,(intern-in-package-of-symbol
               (concatenate 'string (symbol-name fn) "-WHEN-RELATED")
               fn)
     ,(if unary
          `(implies (expr-value-ll-related-p new1 val1 w1 genv)
                    (equal (,fn new1) (,fn val1)))
        `(implies (and (expr-value-ll-related-p new1 val1 w1 genv)
                       (expr-value-ll-related-p new2 val2 w2 genv))
                  (equal (,fn new1 new2) (,fn val1 val2))))
     :enable (,fn
              check-expr-value-int-when-related
              check-expr-value-float-when-related
              check-expr-value-bool-when-related)))

(def-prim-when-related prim-int-add)
(def-prim-when-related prim-int-sub)
(def-prim-when-related prim-int-mul)
(def-prim-when-related prim-int-div)
(def-prim-when-related prim-int-expt)
(def-prim-when-related prim-int-mod)
(def-prim-when-related prim-int-max)
(def-prim-when-related prim-int-min)
(def-prim-when-related prim-int-bit-and)
(def-prim-when-related prim-int-bit-or)
(def-prim-when-related prim-int-bit-xor)
(def-prim-when-related prim-int-shl)
(def-prim-when-related prim-int-shr)
(def-prim-when-related prim-int-bit-not :unary t)
(def-prim-when-related prim-int-popc :unary t)
(def-prim-when-related prim-int-eq)
(def-prim-when-related prim-int-neq)
(def-prim-when-related prim-int-lt)
(def-prim-when-related prim-int-gt)
(def-prim-when-related prim-int-leq)
(def-prim-when-related prim-int-geq)
(def-prim-when-related prim-int-to-float :unary t)
(def-prim-when-related prim-int-to-bool :unary t)
(def-prim-when-related prim-float-add)
(def-prim-when-related prim-float-sub)
(def-prim-when-related prim-float-mul)
(def-prim-when-related prim-float-div)
(def-prim-when-related prim-float-expt)
(def-prim-when-related prim-float-max)
(def-prim-when-related prim-float-min)
(def-prim-when-related prim-float-sqrt :unary t)
(def-prim-when-related prim-float-eq)
(def-prim-when-related prim-float-neq)
(def-prim-when-related prim-float-lt)
(def-prim-when-related prim-float-gt)
(def-prim-when-related prim-float-leq)
(def-prim-when-related prim-float-geq)
