  :expand ((expr-denv-ll-related-p new-denv denv x ctx excl dw genv)))

(defruled atomlam-new-closure-ok
  (implies (and (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (not (reserrp (%v))))
           (not (reserrp (lambda-closure pa (%anb) ta new-denv))))
  :use ((:instance tenv-equal-when-expr-denv-ll-related-p (excl nil))
        (:instance reserrp-of-lambda-closure-same-tenv
