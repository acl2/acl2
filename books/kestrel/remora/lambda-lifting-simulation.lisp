        (:instance ll-var-ok-p-split
                   (var (bind-name b)) (val (%v)) (nfv (%hnfvx)) (ctx (%ctx2))
                   (dw (%hdw l))))
  :in-theory (theory 'minimal-theory))

(defmacro %hlim ()
  '(+ 7 (len (%hxfve)) (ll-denv-witness->limit dw)))

(defruled hoisted-ctx2-type-facts
  (implies (%hstep-hyps)
           (and (tenv-agrees-off-p (ll-context->tenv (%ctx2))
                                   (ll-context->tenv ctx) (bind-name b))
                (equal (set::delete (bind-name b) (ll-context->tlets (%ctx2)))
                       (set::delete (bind-name b) (ll-context->tlets ctx)))))
  :use (ll-let-step-fields bind-bound-expr-vars-subset-of-name
        (:instance tenv-agrees-off-p-of-extend-tenv-with-let-bind
                   (v0 (bind-name b)) (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx)))
        (:instance delete-of-tlets-of-extend-tenv-with-let-bind
                   (v0 (bind-name b)) (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))))
  :disable (ll-bind hoist-local-fun ll-let-step tenv-agrees-off-p))

(defruled in-free-of-let-when-in-rest
  (implies (and (bindp b) (bind-listp rest) (exprp body)
                (set::in w (expr-free-expr-vars (let-or-body rest body)))
                (not (set::in w (bind-bound-expr-vars b))))
           (set::in w (expr-free-expr-vars (expr-let (cons b rest) body))))
  :enable (expr-free-expr-vars-of-let-cons))

(defruled hoisted-other-var-ok
  (implies (and (%hstep-hyps)
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (omap::assoc w (expr-denv->exprs denv))
                (set::in w (expr-free-expr-vars (let-or-body rest body)))
                (not (equal w (bind-name b))))
           (ll-var-ok-p w (cdr (omap::assoc w (expr-denv->exprs denv)))
                        new-denv (%hnfvx) (%ctx2) (%hdw (%hlim)) genv))
  :use (hoisted-ctx2-facts hoisted-ctx2-type-facts
        in-free-of-let-when-in-rest bind-bound-expr-vars-subset-of-name
        (:instance set::subset-in (a w) (x (bind-bound-expr-vars b))
                   (y (set::insert (bind-name b) nil)))
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance walker-ll-var-ok-p-at
                   (map (expr-denv->exprs denv))
                   (fv (expr-free-expr-vars (expr-let (cons b rest) body)))
                   (nfv (%hnfvx)) (var w))
        (:instance stringp-when-assoc-of-string-expr-value-mapp
                   (m (expr-denv->exprs denv)) (k w))
        (:instance not-in-replacement-free-vars-when-binder
                   (lmap (ll-context->lmap ctx)) (locals
                                                  (ll-context->locals ctx))
                   (pnames (%bx)) (v0 (bind-name b)) (v w))
        (:instance ll-var-ok-p-of-hctx
                   (v w) (val (cdr (omap::assoc w (expr-denv->exprs denv))))
                   (nd new-denv) (nfv (%hnfvx)) (v0 (bind-name b))
                   (ctx2 (%ctx2)) (w (%hw)) (l2 (%hlim))))
  :expand ((expr-denv-ll-related-p new-denv denv (expr-let (cons b rest) body)
                                   ctx nil dw genv))
  :enable (difference-of-nil-when-setp omap::assoc-of-update)
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var ll-expr
            ll-lambda-parts ll-context-ok-p apply-to-names lambda-closure
            ll-context-new-expr ll-var-ok-p ll-var-ok-p-of-hctx set::subset-in
            lmap-replacements-ok-p tenv-agrees-off-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled hoisted-orig-eval
  (implies (and (%hstep-hyps)
                (not (reserrp (eval-bind b denv limit))))
           (and (equal (eval-bind b denv limit)
                       (expr-denv-add-expr (bind-name b) (%v) denv))
                (not (reserrp (%v)))
                (expr-valuep (%v))))
  :use (let-step-hoisted-params (:instance fun-orig-eval))
  :enable (lambda-closure expr-valuep-when-result-not-error)
  :disable (eval-bind eval-atom make-atom-lambda/lambdan))

(defruled hoisted-v-ok
  (implies (and (%hstep-hyps)
                (not (reserrp (eval-bind b denv limit))))
           (and (not (reserrp (%v)))
                (expr-valuep (%v))))
  :use hoisted-orig-eval
  :disable (eval-bind lambda-closure))

(defruled hoisted-walker
  (implies (and (%hstep-hyps)
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (not (reserrp (eval-bind b denv limit)))
                (expr-denv-wfp new-denv)
                (ll-bound-value-ok-p (%v) (bind-name b) (%ctx2)))
           (string-expr-value-map-ll-related-p
            new-denv
            (expr-denv->exprs (expr-denv-add-expr (bind-name b) (%v) denv))
            (expr-free-expr-vars (let-or-body rest body))
            (%hnfvx) (%ctx2) (%hdw (%hlim)) genv))
  :use (hoisted-orig-eval hoisted-ctx2-facts
        (:instance string-expr-value-map-ll-related-p-when-pointwise
                   (map (expr-denv->exprs (expr-denv-add-expr (bind-name b) (%v)
                                                              denv)))
                   (fv (expr-free-expr-vars (let-or-body rest body)))
                   (nfv (%hnfvx)) (ctx (%ctx2)) (dw (%hdw (%hlim))))
        (:instance hoisted-var-ok (l (%hlim)))
        (:instance hoisted-other-var-ok
                   (w (walker-pointwise-p-witness
                       new-denv
                       (expr-denv->exprs (expr-denv-add-expr (bind-name b) (%v)
                                                             denv))
                       (expr-free-expr-vars (let-or-body rest body))
                       (%hnfvx) (%ctx2) (%hdw (%hlim)) genv))))
  :expand ((walker-pointwise-p
            new-denv
            (expr-denv->exprs (expr-denv-add-expr (bind-name b) (%v) denv))
            (expr-free-expr-vars (let-or-body rest body))
            (%hnfvx) (%ctx2) (%hdw (%hlim)) genv))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var ll-expr
            ll-lambda-parts ll-context-ok-p apply-to-names lambda-closure
            ll-context-new-expr ll-var-ok-p walker-pointwise-p-necc
            expr-denv-ll-related-p))

(defruled let-step-related-hoisted-add
  (implies (and (%hstep-hyps)
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (not (reserrp (eval-bind b denv limit)))
                (expr-denv-wfp new-denv)
                (ll-bound-value-ok-p (%v) (bind-name b) (%ctx2)))
           (expr-denv-ll-related-p new-denv
                                   (expr-denv-add-expr (bind-name b) (%v) denv)
                                   (let-or-body rest body) (%ctx2) nil
                                   (%hdw (%hlim)) genv))
  :use (hoisted-v-ok hoisted-walker hoisted-ctx2-facts
        (:instance intersect-of-insert-when-not-in-local
                   (v0 (bind-name b)) (s (%hnfvx)) (l (ll-context->locals ctx)))
        hoisted-ctx2-type-facts hoisted-var-not-free let-step-new-exprs-hoisted
        (:instance names-bound-as-in-p-when-subset
                   (names (set::difference (%hnfvx) (ll-context->locals ctx)))
                   (names2 (set::difference (%hnfvx)
                                            (ll-context->locals (%ctx2))))
                   (new-denv new-denv))
        (:instance new-values-meet-types-p-when-subset-and-agree
                   (names (set::intersect (%hnfvx) (ll-context->locals ctx)))
                   (names2 (set::intersect (%hnfvx)
                                           (ll-context->locals (%ctx2))))
                   (nd new-denv) (v0 (bind-name b))
                   (tenv (ll-context->tenv ctx))
                   (tenv2 (ll-context->tenv (%ctx2)))))
  :expand ((expr-denv-ll-related-p new-denv denv (expr-let (cons b rest) body)
                                   ctx nil dw genv)
           (:free (dw2 pa ba ta)
                  (expr-denv-ll-related-p new-denv
                                          (expr-denv-add-expr (bind-name b) (%v)
                                                              denv)
                                          (let-or-body rest body) (%ctx2) nil
                                          dw2 genv)))
  :enable difference-of-nil-when-setp
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var ll-expr
            ll-lambda-parts ll-context-ok-p apply-to-names lambda-closure
            ll-context-new-expr hoisted-walker names-bound-as-in-p-when-subset
            new-values-meet-types-p-when-subset
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled let-step-related-hoisted
  (implies (and (%hstep-hyps)
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (not (reserrp (eval-bind b denv limit)))
                (expr-denv-wfp new-denv)
                (ll-bound-value-ok-p (%v) (bind-name b) (%ctx2)))
           (expr-denv-ll-related-p new-denv (eval-bind b denv limit)
                                   (let-or-body rest body) (%ctx2) nil
                                   (%hdw (%hlim)) genv))
  :use (hoisted-orig-eval let-step-related-hoisted-add)
  :in-theory (theory 'minimal-theory))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Lists of bindings.

(defruled posp-limit-when-eval-bind-ok
  (implies (not (reserrp (eval-bind bind denv limit)))
           (posp limit))
  :expand ((eval-bind bind denv limit)))

(defruled posp-limit-when-eval-bind-list-ok
  (implies (not (reserrp (eval-bind-list binds denv limit)))
           (posp limit))
  :expand ((eval-bind-list binds denv limit)))

(defruled eval-bind-at-larger-limit
  (implies (and (not (reserrp (eval-bind bind denv limit)))
                (integerp limit2)
                (<= limit limit2))
           (equal (eval-bind bind denv limit2)
                  (eval-bind bind denv limit)))
  :use (posp-limit-when-eval-bind-ok
        (:instance eval-bind-of-larger-limit (k (- limit2 limit)))))

(defruled eval-bind-list-at-larger-limit
  (implies (and (not (reserrp (eval-bind-list binds denv limit)))
                (integerp limit2)
                (<= limit limit2))
           (equal (eval-bind-list binds denv limit2)
                  (eval-bind-list binds denv limit)))
  :use (posp-limit-when-eval-bind-list-ok
        (:instance eval-bind-list-of-larger-limit (k (- limit2 limit)))))

(defruled eval-bind-list-of-cons-when-ok
  (implies (not (reserrp (eval-bind-list (cons b rest) denv limit)))
           (and (posp limit)
                (not (reserrp (eval-bind b denv (1- limit))))
                (equal (eval-bind-list (cons b rest) denv limit)
                       (eval-bind-list rest (eval-bind b denv (1- limit))
                                       (1- limit)))))
  :expand ((eval-bind-list (cons b rest) denv limit)))

(defruled eval-bind-list-of-nil-when-ok
  (implies (not (reserrp (eval-bind-list nil denv limit)))
           (equal (eval-bind-list nil denv limit) (expr-denv-fix denv)))
  :expand ((eval-bind-list nil denv limit)))

(defruled eval-bind-list-of-nil-at-1
  (equal (eval-bind-list nil denv 1) (expr-denv-fix denv))
  :expand ((eval-bind-list nil denv 1)))

; Combining the evaluation of the first binding with that of the rest.

(defruled eval-bind-list-of-cons-at-sum
  (implies (and (not (reserrp (eval-bind nb nd l1)))
                (not (reserrp (eval-bind-list kr (eval-bind nb nd l1) l2))))
           (equal (eval-bind-list (cons nb kr) nd (+ 1 l1 l2))
                  (eval-bind-list kr (eval-bind nb nd l1) l2)))
  :use ((:instance posp-limit-when-eval-bind-ok (bind nb) (denv nd) (limit l1))
        (:instance posp-limit-when-eval-bind-list-ok
                   (binds kr) (denv (eval-bind nb nd l1)) (limit l2))
        (:instance eval-bind-at-larger-limit
                   (bind nb) (denv nd) (limit l1) (limit2 (+ l1 l2)))
        (:instance eval-bind-list-at-larger-limit
                   (binds kr) (denv (eval-bind nb nd l1)) (limit l2)
                   (limit2 (+ l1 l2))))
  :expand ((eval-bind-list (cons nb kr) nd (+ 1 l1 l2))))

(defruled eval-bind-list-ll-reaches-p-elim
  (implies (eval-bind-list-ll-reaches-p new-binds new-denv denv2 x ctx genv)
           (b* (((mv l dw)
                 (eval-bind-list-ll-reaches-p-witness new-binds new-denv denv2
                                                      x ctx genv))
                (nd2 (eval-bind-list new-binds new-denv l)))
             (and (not (reserrp nd2))
                  (expr-denv-ll-related-p nd2 denv2 x ctx nil dw genv))))
  :enable eval-bind-list-ll-reaches-p)

(defruled eval-bind-ll-reaches-p-elim
  (implies (eval-bind-ll-reaches-p new-bind new-denv denv2 x ctx genv)
           (b* (((mv l dw)
                 (eval-bind-ll-reaches-p-witness new-bind new-denv denv2
                                                 x ctx genv))
                (nd2 (eval-bind new-bind new-denv l)))
             (and (not (reserrp nd2))
                  (expr-denv-ll-related-p nd2 denv2 x ctx nil dw genv))))
  :enable eval-bind-ll-reaches-p)

(defruled expr-denv-ll-related-p-of-denv-fixes
  (implies (and (expr-denv-ll-related-p nd d y ctx excl dw genv)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx) pnames genv)
                (string-listp pnames))
           (expr-denv-ll-related-p (expr-denv-fix nd) (expr-denv-fix d)
                                   y ctx excl dw genv))
  :use ((:instance expr-denv-ll-related-p-when-same-exprs
                   (nd2 (expr-denv-fix nd)) (d2 (expr-denv-fix d)))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (new-denv nd) (denv d) (x y)))
  :disable (expr-denv-ll-related-p lmap-replacements-ok-p))

(defruled eval-bind-list-stmt-nil
  (implies (and (exprp body)
                (not (reserrp (eval-bind-list nil denv limit)))
                (expr-denv-ll-related-p new-denv denv body ctx nil dw genv)
                (ll-context-ok-p body ctx genv))
           (eval-bind-list-ll-reaches-p
            (mv-nth 0 (ll-let-result nil body ctx)) new-denv
            (eval-bind-list nil denv limit)
            body (mv-nth 1 (ll-let-result nil body ctx)) genv))
  :use (eval-bind-list-of-nil-when-ok
        (:instance eval-bind-list-of-nil-at-1 (denv new-denv))
        (:instance lmap-replacements-when-ll-context-ok-p (x body))
        (:instance expr-denv-ll-related-p-of-denv-fixes
                   (nd new-denv) (d denv) (y body) (excl nil)
                   (pnames (expr-binder-names body)))
        (:instance eval-bind-list-ll-reaches-p-suff
                   (new-binds nil) (denv2 (eval-bind-list nil denv limit))
                   (x body) (ctx (ll-context-fix ctx)) (limit2 1)))
  :enable (ll-let-result-of-nil not-reserrp-when-expr-denvp)
  :disable (expr-denv-ll-related-p eval-bind-list-ll-reaches-p
            eval-bind-list-ll-reaches-p-suff ll-context-ok-p eval-bind-list))

(defmacro %kw1 ()
  '(eval-bind-ll-reaches-p-witness (mv-nth 1 (%step)) new-denv
                                   (eval-bind b denv (1- limit))
                                   (let-or-body rest body) (%ctx2) genv))

(defmacro %ksw ()
  '(eval-bind-list-ll-reaches-p-witness
    (mv-nth 0 (ll-let-result rest body ctx2)) (eval-bind nb nd l1)
    (eval-bind-list rest d1 l) body (mv-nth 1 (ll-let-result rest body ctx2))
    g))

(defruled eval-bind-list-ll-reaches-p-of-kept-step
  (implies (and (not (reserrp (eval-bind nb nd l1)))
                (expr-denv-ll-related-p (eval-bind nb nd l1) d1
                                        (let-or-body rest body) ctx2 nil dw1 g)
                (eval-bind-list-ll-ok rest d1 l)
                (not (reserrp (eval-bind-list rest d1 l)))
                (bind-listp rest)
                (exprp body)
                (ll-context-ok-p (let-or-body rest body) ctx2 g)
                (expr-denv-wfp d1)
                (expr-denv-wfp (eval-bind nb nd l1)))
           (eval-bind-list-ll-reaches-p
            (cons nb (mv-nth 0 (ll-let-result rest body ctx2))) nd
            (eval-bind-list rest d1 l)
            body (mv-nth 1 (ll-let-result rest body ctx2)) g))
  :use ((:instance eval-bind-list-ll-ok-necc
                   (binds rest) (denv d1) (limit l) (ctx ctx2)
                   (new-denv (eval-bind nb nd l1)) (dw dw1) (genv g))
        (:instance eval-bind-list-ll-reaches-p-elim
                   (new-binds (mv-nth 0 (ll-let-result rest body ctx2)))
                   (new-denv (eval-bind nb nd l1))
                   (denv2 (eval-bind-list rest d1 l))
                   (x body) (ctx (mv-nth 1 (ll-let-result rest body ctx2)))
                   (genv g))
        (:instance eval-bind-list-of-cons-at-sum
                   (kr (mv-nth 0 (ll-let-result rest body ctx2)))
                   (l2 (mv-nth 0 (%ksw))))
        (:instance eval-bind-list-ll-reaches-p-suff
                   (new-binds (cons nb (mv-nth 0 (ll-let-result rest body
                                                                ctx2))))
                   (new-denv nd) (denv2 (eval-bind-list rest d1 l))
                   (x body) (ctx (mv-nth 1 (ll-let-result rest body ctx2)))
                   (limit2 (+ 1 l1 (mv-nth 0 (%ksw))))
                   (dw (mv-nth 1 (%ksw))) (genv g)))
  :in-theory (theory 'minimal-theory))

(defruled eval-bind-list-stmt-kept
  (implies (and (%step-hyps)
                (not (mv-nth 0 (%step)))
                (not (reserrp (eval-bind-list (cons b rest) denv limit)))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-bind-ll-ok b denv (1- limit))
                (eval-bind-list-ll-ok rest (eval-bind b denv (1- limit))
                                      (1- limit)))
           (eval-bind-list-ll-reaches-p
            (mv-nth 0 (ll-let-result (cons b rest) body ctx)) new-denv
            (eval-bind-list (cons b rest) denv limit)
            body (mv-nth 1 (ll-let-result (cons b rest) body ctx)) genv))
  :use (ll-context-ok-p-of-let-step
        eval-bind-list-of-cons-when-ok
        (:instance eval-bind-ll-ok-necc (bind b) (limit (1- limit)))
        (:instance eval-bind-ll-reaches-p-elim
                   (new-bind (mv-nth 1 (%step)))
                   (denv2 (eval-bind b denv (1- limit)))
                   (x (let-or-body rest body)) (ctx (%ctx2)))
        (:instance expr-denv-wfp-of-eval-bind (bind b) (limit (1- limit)))
        (:instance expr-denv-wfp-of-eval-bind
                   (bind (mv-nth 1 (%step))) (denv new-denv)
                   (limit (mv-nth 0 (%kw1))))
        (:instance eval-bind-list-ll-reaches-p-of-kept-step
                   (nb (mv-nth 1 (%step))) (nd new-denv)
                   (l1 (mv-nth 0 (%kw1))) (dw1 (mv-nth 1 (%kw1)))
                   (d1 (eval-bind b denv (1- limit))) (l (1- limit))
                   (ctx2 (%ctx2)) (g genv)))
  :enable (ll-let-result-of-cons let-or-body)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-bind eval-bind-list expr-denv-ll-related-p
            eval-bind-ll-ok eval-bind-ll-ok-necc eval-bind-list-ll-ok
            eval-bind-list-ll-ok-necc eval-bind-ll-reaches-p
            eval-bind-list-ll-reaches-p eval-bind-list-ll-reaches-p-suff
            ll-let-result))

(defruled eval-bind-list-stmt-hoisted
  (implies (and (%step-hyps)
                (mv-nth 0 (%step))
                (not (reserrp (eval-bind-list (cons b rest) denv limit)))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (let-bind-typed-p b denv (1- limit))
                (eval-bind-list-ll-ok rest (eval-bind b denv (1- limit))
                                      (1- limit)))
           (eval-bind-list-ll-reaches-p
            (mv-nth 0 (ll-let-result (cons b rest) body ctx)) new-denv
            (eval-bind-list (cons b rest) denv limit)
            body (mv-nth 1 (ll-let-result (cons b rest) body ctx)) genv))
  :use (ll-context-ok-p-of-let-step let-step-hoisted-params
        eval-bind-list-of-cons-when-ok
        (:instance let-bind-typed-p-necc (bind b) (limit (1- limit)))
        (:instance bind-bound-expr-vars-nonempty)
        (:instance hoisted-orig-eval
                   (pa (bind-fun->params b)) (ba (bind-fun->expr b))
                   (ta (bind-fun->type? b)) (lam (%name)) (limit (1- limit)))
        (:instance lookup-of-name-in-added-local
                   (n (bind-name b)) (d denv)
                   (v (lambda-closure (bind-fun->params b) (bind-fun->expr b)
                                      (bind-fun->type? b) denv)))
        (:instance let-step-related-hoisted
                   (pa (bind-fun->params b)) (ba (bind-fun->expr b))
                   (ta (bind-fun->type? b)) (lam (%name)) (limit (1- limit)))
        (:instance expr-denv-wfp-of-eval-bind (bind b) (limit (1- limit)))
        (:instance eval-bind-list-ll-ok-necc
                   (binds rest) (denv (eval-bind b denv (1- limit)))
                   (limit (1- limit)) (ctx (%ctx2)) (new-denv new-denv)
                   (dw (b* ((pa (bind-fun->params b)) (ba (bind-fun->expr b)))
                         (%hdw (%hlim))))))
  :in-theory (union-theories (theory 'minimal-theory)
                             '(ll-let-result-of-cons
                               let-or-body bind-name
                               expr-valuep-when-result-not-error
                               acl2::mv-nth-of-cons zp posp
                               stringp-of-bind-fun->var)))

(defmacro %blw () '(eval-bind-list-ll-ok-witness binds denv limit))

(defruled eval-bind-list-ll-ok-when-ok
  (implies (implies (consp binds)
                    (and (eval-bind-ll-ok (car binds) denv (1- limit))
                         (let-bind-typed-p (car binds) denv (1- limit))
                         (eval-bind-list-ll-ok (cdr binds)
                                               (eval-bind (car binds) denv
                                                          (1- limit))
                                               (1- limit))))
           (eval-bind-list-ll-ok binds denv limit))
  :expand ((eval-bind-list-ll-ok binds denv limit))
  :cases ((consp binds))
  :use ((:instance eval-bind-list-stmt-nil
                   (body (mv-nth 0 (%blw))) (ctx (mv-nth 1 (%blw)))
                   (new-denv (mv-nth 2 (%blw))) (dw (mv-nth 3 (%blw)))
                   (genv (mv-nth 4 (%blw))))
        (:instance eval-bind-list-stmt-kept
                   (b (car binds)) (rest (cdr binds))
                   (body (mv-nth 0 (%blw))) (ctx (mv-nth 1 (%blw)))
                   (new-denv (mv-nth 2 (%blw))) (dw (mv-nth 3 (%blw)))
                   (genv (mv-nth 4 (%blw))))
        (:instance eval-bind-list-stmt-hoisted
                   (b (car binds)) (rest (cdr binds))
                   (body (mv-nth 0 (%blw))) (ctx (mv-nth 1 (%blw)))
                   (new-denv (mv-nth 2 (%blw))) (dw (mv-nth 3 (%blw)))
                   (genv (mv-nth 4 (%blw)))))
  :enable (let-or-body)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-bind eval-bind-list expr-denv-ll-related-p
            eval-bind-ll-ok eval-bind-list-ll-ok-necc
            eval-bind-list-ll-reaches-p ll-let-result let-bind-typed-p))

; The context at the body of a :LET.

(defun let-result-ind (binds body ctx)
  (declare (xargs :measure (len binds)
                  :hints (("Goal" :in-theory (enable len)))))
  (if (endp binds)
      (list body ctx)
    (b* (((mv & & ctx2) (ll-let-step (car binds) (cdr binds) body ctx)))
      (let-result-ind (cdr binds) body ctx2))))

(defruled ll-context-ok-p-of-let-result
  (implies (and (bind-listp binds)
                (exprp body)
                (ll-context-ok-p (let-or-body binds body) ctx genv))
           (ll-context-ok-p body (mv-nth 1 (ll-let-result binds body ctx))
                            genv))
  :induct (let-result-ind binds body ctx)
  :hints (("Subgoal *1/2"
           :use ((:instance ll-let-result-of-cons
                            (b (car binds)) (rest (cdr binds)))
                 (:instance ll-context-ok-p-of-let-step
                            (b (car binds)) (rest (cdr binds)))))
          ("Subgoal *1/1"
           :use (ll-let-result-of-nil)))
  :enable (let-or-body)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-let-result))

; The :LET case.

(defruled eval-expr-of-let-when-ok
  (implies (and (equal (expr-kind x) :let)
                (not (reserrp (eval-expr x denv limit))))
           (and (posp limit)
                (not (reserrp (eval-bind-list (expr-let->binds x) denv
                                              (1- limit))))
                (equal (eval-expr x denv limit)
                       (eval-expr (expr-let->body x)
                                  (eval-bind-list (expr-let->binds x) denv
                                                  (1- limit))
                                  (1- limit)))))
  :expand ((eval-expr x denv limit)))

(defruled eval-expr-of-let-at-sum
  (implies (and (consp kept)
                (bind-listp kept)
                (exprp nb)
                (not (reserrp (eval-bind-list kept nd l1)))
                (not (reserrp (eval-expr nb (eval-bind-list kept nd l1) l2))))
           (equal (eval-expr (expr-let kept nb) nd (+ 1 l1 l2))
                  (eval-expr nb (eval-bind-list kept nd l1) l2)))
  :use ((:instance posp-limit-when-eval-bind-list-ok
                   (binds kept) (denv nd) (limit l1))
        (:instance posp-limit-when-eval-expr-ok
                   (expr nb) (denv (eval-bind-list kept nd l1)) (limit l2))
        (:instance eval-bind-list-at-larger-limit
                   (binds kept) (denv nd) (limit l1) (limit2 (+ l1 l2)))
        (:instance eval-expr-at-larger-limit
                   (expr nb) (denv (eval-bind-list kept nd l1)) (limit l2)
                   (limit2 (+ l1 l2))))
  :expand ((eval-expr (expr-let kept nb) nd (+ 1 l1 l2))))

(defruled eval-let-or-body-at-sum
  (implies (and (bind-listp kept)
                (exprp nb)
                (not (reserrp (eval-bind-list kept nd l1)))
                (not (reserrp (eval-expr nb (eval-bind-list kept nd l1) l2))))
           (equal (eval-expr (let-or-body kept nb) nd (+ 1 l1 l2))
                  (eval-expr nb (eval-bind-list kept nd l1) l2)))
  :cases ((consp kept))
  :use (eval-expr-of-let-at-sum
        (:instance eval-bind-list-of-nil-when-ok (denv nd) (limit l1))
        (:instance posp-limit-when-eval-bind-list-ok
                   (binds kept) (denv nd) (limit l1))
        (:instance posp-limit-when-eval-expr-ok
                   (expr nb) (denv nd) (limit l2))
        (:instance eval-expr-at-larger-limit
                   (expr nb) (denv nd) (limit l2) (limit2 (+ 1 l1 l2))))
  :enable (let-or-body))

(defmacro %lb () '(expr-let->binds x))

(defmacro %lbody () '(expr-let->body x))

(defmacro %lres () '(ll-let-result (%lb) (%lbody) ctx))

(defmacro %ld2 () '(eval-bind-list (%lb) denv (1- limit)))

(defmacro %lw1 ()
  '(eval-bind-list-ll-reaches-p-witness (mv-nth 0 (%lres)) new-denv (%ld2)
                                        (%lbody) (mv-nth 1 (%lres)) genv))

(defmacro %lnd2 ()
  '(eval-bind-list (mv-nth 0 (%lres)) new-denv (mv-nth 0 (%lw1))))

(defmacro %lnb () '(ll-context-new-expr (%lbody) (mv-nth 1 (%lres))))

(defmacro %lw2 ()
  '(eval-expr-ll-reaches-p-witness (%lnb) (%lnd2)
                                   (eval-expr (%lbody) (%ld2) (1- limit))
                                   genv))

(defruled let-case-facts
  (implies (and (exprp x)
                (equal (expr-kind x) :let))
           (and (consp (%lb))
                (bind-listp (%lb))
                (exprp (%lbody))
                (equal (let-or-body (%lb) (%lbody)) x)
                (equal (ll-context-new-expr x ctx)
                       (let-or-body (mv-nth 0 (%lres)) (%lnb)))))
  :use ((:instance ll-context-new-expr-of-let-or-body
                   (binds (%lb)) (body (%lbody))))
  :enable (let-or-body))

(defruled eval-expr-ll-reaches-p-when-let
  (implies (and (exprp x)
                (equal (expr-kind x) :let)
                (not (reserrp (eval-expr x denv limit)))
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-bind-list-ll-ok (%lb) denv (1- limit))
                (eval-expr-ll-ok (%lbody) (%ld2) (1- limit)))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (let-case-facts eval-expr-of-let-when-ok
        (:instance eval-bind-list-ll-ok-necc
                   (binds (%lb)) (limit (1- limit)) (body (%lbody)))
        (:instance eval-bind-list-ll-reaches-p-elim
                   (new-binds (mv-nth 0 (%lres))) (denv2 (%ld2))
                   (x (%lbody)) (ctx (mv-nth 1 (%lres))))
        (:instance ll-context-ok-p-of-let-result
                   (binds (%lb)) (body (%lbody)))
        (:instance expr-denv-wfp-of-eval-bind-list
                   (binds (%lb)) (limit (1- limit)))
        (:instance expr-denv-wfp-of-eval-bind-list
                   (binds (mv-nth 0 (%lres))) (denv new-denv)
                   (limit (mv-nth 0 (%lw1))))
        (:instance eval-expr-ll-ok-necc
                   (expr (%lbody)) (denv (%ld2)) (limit (1- limit))
                   (ctx (mv-nth 1 (%lres))) (new-denv (%lnd2))
                   (dw (mv-nth 1 (%lw1))))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (%lnb)) (new-denv (%lnd2))
                   (val (eval-expr (%lbody) (%ld2) (1- limit))))
        (:instance eval-let-or-body-at-sum
                   (kept (mv-nth 0 (%lres))) (nb (%lnb)) (nd new-denv)
                   (l1 (mv-nth 0 (%lw1))) (l2 (mv-nth 0 (%lw2))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (ll-context-new-expr x ctx))
                   (val (eval-expr x denv limit))
                   (limit2 (+ 1 (mv-nth 0 (%lw1)) (mv-nth 0 (%lw2))))
                   (w (mv-nth 1 (%lw2)))))
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-expr eval-bind-list expr-denv-ll-related-p
            eval-bind-list-ll-ok eval-bind-list-ll-ok-necc
            eval-bind-list-ll-reaches-p eval-expr-ll-ok eval-expr-ll-ok-necc
            eval-expr-ll-reaches-p eval-expr-ll-reaches-p-suff
            ll-let-result ll-context-new-expr expr-value-ll-related-p
            let-or-body))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The typing of the values bound by :LETs, from the soundness of the type
; checker (CHECK-SOUND-P).

(defruled assoc-of-restrict-to-keys
  (equal (omap::assoc k (restrict-to-keys keys m))
         (and (set::in k (string-sfix keys))
              (omap::assoc k (string-type-map-fix m))))
  :induct (restrict-to-keys keys m)
  :enable (restrict-to-keys omap::assoc-of-update omap::assoc))

(defruled closed-when-assoc-in-all-closed
  (implies (and (type-map-all-closed-p m)
                (omap::assoc k (string-type-map-fix m)))
           (type-closed-p (cdr (omap::assoc k (string-type-map-fix m)))))
  :induct (type-map-all-closed-p m)
  :enable (type-map-all-closed-p type-closed-p omap::assoc))

(defruled primop-types-all-closed
  (type-map-all-closed-p (primop-types))
  :enable ((:e type-map-all-closed-p) (:e primop-types)))

(defruled expr-vars-typed-p-at
  (implies (and (expr-vars-typed-p types denv)
                (omap::assoc k (string-type-map-fix types)))
           (b* ((val (expr-denv-lookup-expr k denv))
                (tval (eval-type (cdr (omap::assoc k (string-type-map-fix
                                                      types)))
                                 (expr-denv->tenv denv))))
             (and (not (reserrp val))
                  (not (reserrp tval))
                  (expr-value-typed-p val tval))))
  :induct (expr-vars-typed-p types denv)
  :enable (expr-vars-typed-p omap::assoc)
  :disable (expr-value-typed-p))

(defruled expr-vars-typed-at-p-at
  (implies (and (expr-vars-typed-at-p types names denv)
                (omap::assoc k (string-type-map-fix types))
                (set::in k (string-sfix names))
                (not (reserrp (expr-denv-lookup-expr k denv))))
           (b* ((val (expr-denv-lookup-expr k denv))
                (tval (eval-type (cdr (omap::assoc k (string-type-map-fix
                                                      types)))
                                 (expr-denv->tenv denv))))
             (and (not (reserrp tval))
                  (expr-value-typed-p val tval))))
  :induct (expr-vars-typed-at-p types names denv)
  :enable (expr-vars-typed-at-p omap::assoc)
  :disable (expr-value-typed-p))

(acl2::defun-sk expr-vars-typed-at-pointwise-p (types names denv)
  (forall k
          (implies (and (omap::assoc k (string-type-map-fix types))
                        (set::in k (string-sfix names))
                        (not (reserrp (expr-denv-lookup-expr k denv))))
                   (b* ((val (expr-denv-lookup-expr k denv))
                        (tval (eval-type (cdr (omap::assoc
                                               k (string-type-map-fix types)))
                                         (expr-denv->tenv denv))))
                     (and (not (reserrp tval))
                          (expr-value-typed-p val tval))))))

(defun tmap-ind (m)
  (declare (xargs :measure (acl2-count (string-type-map-fix m))))
  (b* ((m (string-type-map-fix m)))
    (if (omap::emptyp m) nil (tmap-ind (omap::tail m)))))

(defruled expr-vars-typed-at-pointwise-p-head
  (b* ((m (string-type-map-fix types))
       (var (omap::head-key m))
       (val (expr-denv-lookup-expr var denv))
       (tval (eval-type (omap::head-val m) (expr-denv->tenv denv))))
    (implies (and (expr-vars-typed-at-pointwise-p types names denv)
                  (not (omap::emptyp m))
                  (set::in var (string-sfix names))
                  (not (reserrp val)))
             (and (not (reserrp tval))
                  (expr-value-typed-p val tval))))
  :use ((:instance expr-vars-typed-at-pointwise-p-necc
                   (k (omap::head-key (string-type-map-fix types)))))
  :enable (omap::head-key omap::head-val omap::assoc-of-head)
  :disable (expr-value-typed-p expr-vars-typed-at-pointwise-p
            expr-vars-typed-at-pointwise-p-necc))

(defruled expr-vars-typed-at-pointwise-p-tail
  (implies (expr-vars-typed-at-pointwise-p types names denv)
           (expr-vars-typed-at-pointwise-p
            (omap::tail (string-type-map-fix types)) names denv))
  :use ((:instance expr-vars-typed-at-pointwise-p-necc
                   (k (expr-vars-typed-at-pointwise-p-witness
                       (omap::tail (string-type-map-fix types))
                       names denv))))
  :expand ((expr-vars-typed-at-pointwise-p
            (omap::tail (string-type-map-fix types)) names denv))
  :disable (expr-value-typed-p expr-vars-typed-at-pointwise-p-necc))

(defruled expr-vars-typed-at-p-when-pointwise
  (implies (expr-vars-typed-at-pointwise-p types names denv)
           (expr-vars-typed-at-p types names denv))
  :induct (tmap-ind types)
  :enable (expr-vars-typed-at-p)
  :disable (expr-value-typed-p expr-vars-typed-at-pointwise-p)
  :hints (("Subgoal *1/2"
           :use (expr-vars-typed-at-pointwise-p-head
                 expr-vars-typed-at-pointwise-p-tail))))

; The static ispace and type environments of the check of a :LET binding
; are empty, so any dynamic environment is typed by them.

(defruled expr-denv-typed-for-p-of-init-senvs
  (equal (expr-denv-typed-for-p denv (init-ispace-senv) (init-type-senv)
                                eenv names)
         (expr-vars-typed-at-p (expr-senv->exprs eenv) names denv))
  :enable (expr-denv-typed-for-p (:e init-ispace-senv) (:e init-type-senv)
           ispace-denv-typed-p type-denv-typed-p))

; The check that EXTEND-TENV-WITH-LET-BIND makes, and its result.

(define let-bind-check ((b bindp)
                        (tenv string-type-mapp)
                        (tlets string-setp)
                        (locals string-setp))
  :returns (mv (okp booleanp) new sbs scope)
  :verify-guards nil
  (b* ((b (bind-fix b))
       (tenv (string-type-map-fix tenv))
       (tlets (string-sfix tlets))
       (vars (bind-bound-expr-vars b))
       (free-locals (set::intersect (bind-free-expr-vars b)
                                    (string-sfix locals)))
       ((unless (set::subset free-locals tlets)) (mv nil nil nil nil))
       (scope (restrict-to-keys free-locals tenv))
       (sbs (check-bind-list (list b)
                             (init-ispace-senv)
                             (init-type-senv)
                             (tenv-to-expr-senv scope)))
       ((when (reserrp sbs)) (mv nil nil nil nil))
       (new (restrict-to-keys vars (expr-senv->exprs (senvs+binds->eenv sbs))))
       ((unless (and (type-map-all-wfp new)
                     (type-map-all-closed-p new)))
        (mv nil nil nil nil)))
    (mv t new sbs scope)))

(defruled extend-tenv-with-let-bind-via-check
  (b* (((mv okp new & &) (let-bind-check b tenv tlets locals))
       (others (set::difference (string-sfix tlets)
                                (bind-bound-expr-vars b))))
    (equal (extend-tenv-with-let-bind b tenv tlets locals)
           (if okp
               (mv (omap::update* new (string-type-map-fix tenv))
                   (set::union (omap::keys new) others))
             (mv (string-type-map-fix tenv) others))))
  :enable (extend-tenv-with-let-bind let-bind-check))

; What the walker says of the type of a variable's value, at the :LET.

(defruled walker-type-facts-at
  (implies (and (string-expr-value-map-ll-related-p nd (expr-denv->exprs d) fvx
                                                    nfv ctx dw genv)
                (set::in k fvx)
                (omap::assoc k (expr-denv->exprs d)))
           (b* ((val (cdr (omap::assoc k (expr-denv->exprs d)))))
             (and (implies (set::in k (ll-context->tlets ctx))
                           (value-has-inferred-type-p val k
                                                      (ll-context->tenv ctx)))
                  (implies (not (set::in k (ll-context->locals ctx)))
                           (equal val (expr-denv-lookup-expr
                                       k (init-expr-denv)))))))
  :use ((:instance walker-ll-var-ok-p-at (new-denv nd)
                   (map (expr-denv->exprs d))
                   (fv fvx) (var k)))
  :enable (ll-var-ok-p)
  :disable (expr-value-ll-related-p value-meets-required-type-p
            value-has-inferred-type-p eval-expr (:e init-expr-denv)))

(defruled lookup-when-not-error-local
  (implies (not (reserrp (expr-denv-lookup-expr k d)))
           (and (omap::assoc (str-fix k) (expr-denv->exprs d))
                (equal (expr-denv-lookup-expr k d)
                       (cdr (omap::assoc (str-fix k) (expr-denv->exprs d))))))
  :enable (expr-denv-lookup-expr))

(defruled exprs-of-init-expr-senv
  (equal (expr-senv->exprs (init-expr-senv)) (primop-types))
  :enable (init-expr-senv)
  :disable ((:e primop-types) (:e init-expr-senv)))

(defruled init-typed-at
  (implies (omap::assoc k (primop-types))
           (b* ((val (expr-denv-lookup-expr k (init-expr-denv)))
                (tval (eval-type (cdr (omap::assoc k (primop-types)))
                                 (expr-denv->tenv (init-expr-denv)))))
             (and (not (reserrp val))
                  (not (reserrp tval))
                  (expr-value-typed-p val tval))))
  :use (expr-denv-typed-p-of-init
        (:instance expr-vars-typed-p-at
                   (types (primop-types)) (denv (init-expr-denv))))
  :enable (expr-denv-typed-p exprs-of-init-expr-senv)
  :disable ((:e init-expr-denv) (:e expr-denv-typed-p) expr-value-typed-p
            (:e primop-types) (:e init-expr-senv) (:e init-ispace-senv)
            (:e init-type-senv) expr-vars-typed-p expr-denv-typed-p-of-init))

(defmacro %lbc () '(let-bind-check b (ll-context->tenv ctx)
                                   (ll-context->tlets ctx)
                                   (ll-context->locals ctx)))

(defmacro %scope () '(mv-nth 3 (%lbc)))

(defruled let-bind-check-facts
  (implies (mv-nth 0 (%lbc))
           (and (equal (%scope)
                       (restrict-to-keys (set::intersect
                                          (bind-free-expr-vars b)
                                          (ll-context->locals ctx))
                                         (ll-context->tenv ctx)))
                (set::subset (set::intersect (bind-free-expr-vars b)
                                             (ll-context->locals ctx))
                             (ll-context->tlets ctx))
                (not (reserrp (mv-nth 2 (%lbc))))
                (equal (mv-nth 2 (%lbc))
                       (check-bind-list (list (bind-fix b))
                                        (init-ispace-senv) (init-type-senv)
                                        (tenv-to-expr-senv (%scope))))
                (equal (mv-nth 1 (%lbc))
                       (restrict-to-keys
                        (bind-bound-expr-vars b)
                        (expr-senv->exprs
                         (senvs+binds->eenv (mv-nth 2 (%lbc))))))
                (type-map-all-closed-p (mv-nth 1 (%lbc)))))
  :enable (let-bind-check))

; The environment where the binding is evaluated is typed, as far as the
; variables the binding refers to go, by the environment it is checked in.

(defruled scope-typed-at
  (implies (and (%step-hyps)
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (mv-nth 0 (%lbc))
                (omap::assoc k (string-type-map-fix
                                (expr-senv->exprs
                                 (tenv-to-expr-senv (%scope)))))
                (set::in k (bind-free-expr-vars b))
                (not (reserrp (expr-denv-lookup-expr k denv))))
           (b* ((val (expr-denv-lookup-expr k denv))
                (tval (eval-type (cdr (omap::assoc
                                       k (string-type-map-fix
                                          (expr-senv->exprs
                                           (tenv-to-expr-senv (%scope))))))
                                 (expr-denv->tenv denv))))
             (and (not (reserrp tval))
                  (expr-value-typed-p val tval))))
  :use (let-bind-check-facts
        (:instance expr-free-expr-vars-of-let-cons)
        (:instance lookup-when-not-error-local (d denv))
        (:instance walker-type-facts-at
                   (nd new-denv) (d denv)
                   (fvx (expr-free-expr-vars (expr-let (cons b rest) body)))
                   (nfv (expr-free-expr-vars (ll-context-new-expr
                                              (expr-let (cons b rest) body)
                                              ctx))))
        (:instance init-typed-at)
        (:instance closed-when-assoc-in-all-closed (m (primop-types)))
        primop-types-all-closed
        (:instance set::subset-in (a k)
                   (x (set::intersect (bind-free-expr-vars b)
                                      (ll-context->locals ctx)))
                   (y (ll-context->tlets ctx))))
  :expand ((expr-denv-ll-related-p new-denv denv (expr-let (cons b rest) body)
                                   ctx nil dw genv))
  :enable (let-bind-check-facts primop-types-all-closed tenv-to-expr-senv
           omap::assoc-of-update* assoc-of-restrict-to-keys
           value-has-inferred-type-p type-closed-p eval-type-when-closed
           name-to-type-option
           set::subset-in difference-of-nil-when-setp)
  :disable (expr-value-typed-p (:e init-expr-denv) (:e primop-types)
            ll-bind hoist-local-fun ll-let-step ll-context-ok-p
            string-expr-value-map-ll-related-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defmacro %scope-eenv () '(tenv-to-expr-senv (%scope)))

(defruled scope-typed
  (implies (and (%step-hyps)
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (mv-nth 0 (%lbc)))
           (expr-denv-typed-for-p denv (init-ispace-senv) (init-type-senv)
                                  (%scope-eenv)
                                  (bind-list-free-expr-vars (list b))))
  :use ((:instance expr-vars-typed-at-p-when-pointwise
                   (types (expr-senv->exprs (%scope-eenv)))
                   (names (bind-free-expr-vars b)))
        (:instance scope-typed-at
                   (k (expr-vars-typed-at-pointwise-p-witness
                       (expr-senv->exprs (%scope-eenv))
                       (bind-free-expr-vars b) denv))))
  :expand ((expr-vars-typed-at-pointwise-p
            (expr-senv->exprs (%scope-eenv)) (bind-free-expr-vars b) denv))
  :enable (expr-denv-typed-for-p-of-init-senvs)
  :disable (expr-value-typed-p expr-vars-typed-at-p tenv-to-expr-senv
            ll-bind hoist-local-fun ll-let-step ll-context-ok-p
            expr-denv-ll-related-p let-bind-check
            (:e init-ispace-senv) (:e init-type-senv)))

(defruled eval-bind-list-of-list
  (implies (not (reserrp (eval-bind b denv limit)))
           (equal (eval-bind-list (list b) denv (+ 1 limit))
                  (eval-bind b denv limit)))
  :use ((:instance posp-limit-when-eval-bind-ok (bind b)))
  :expand ((eval-bind-list (list b) denv (+ 1 limit))
           (eval-bind-list nil (eval-bind b denv limit) limit))
  :enable (expr-denvp-when-result-not-error-local)
  :prep-lemmas
  ((defrule expr-denvp-when-result-not-error-local
     (implies (and (expr-denv-resultp x) (not (reserrp x)))
              (expr-denvp x))
     :enable (expr-denv-resultp))))

(defruled lookup-of-name-in-eval-bind
  (implies (and (not (reserrp (eval-bind b d l)))
                (not (set::emptyp (bind-bound-expr-vars b))))
           (not (reserrp (expr-denv-lookup-expr (bind-name b)
                                                (eval-bind b d l)))))
  :expand ((eval-bind b d l))
  :enable (expr-denv-lookup-expr-of-expr-denv-add-expr bind-name
           bind-bound-expr-vars not-reserrp-when-expr-valuep))

; The value bound gets the type that the checker infers for it.

(defruled bind-bound-expr-vars-nonempty-when-assoc-local
  (implies (and (mv-nth 0 (%lbc))
                (omap::assoc (bind-name b) (mv-nth 1 (%lbc))))
           (not (set::emptyp (bind-bound-expr-vars b))))
  :use let-bind-check-facts
  :enable (assoc-of-restrict-to-keys))

(defruled let-bind-result-typed-at
  (implies (and (check-sound-p)
                (%step-hyps)
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (not (reserrp (eval-bind b denv limit)))
                (mv-nth 0 (%lbc)))
           (expr-vars-typed-at-p
            (expr-senv->exprs (senvs+binds->eenv (mv-nth 2 (%lbc))))
            (bind-bound-expr-vars b)
            (eval-bind b denv limit)))
  :use (scope-typed let-bind-check-facts
        (:instance check-sound-p-necc
                   (binds (list b)) (ienv (init-ispace-senv))
                   (tenv (init-type-senv)) (eenv (%scope-eenv))
                   (limit (+ 1 limit)))
        (:instance eval-bind-list-of-list))
  :enable (expr-denv-typed-for-p bind-list-bound-expr-vars-of-list)
  :disable (expr-value-typed-p expr-vars-typed-at-p tenv-to-expr-senv
            check-sound-p check-sound-p-necc eval-bind eval-bind-list
            ll-bind hoist-local-fun ll-let-step ll-context-ok-p
            expr-denv-ll-related-p let-bind-check
            expr-denv-typed-for-p-of-init-senvs
            (:e init-ispace-senv) (:e init-type-senv)))

(defruled let-bound-value-typed
  (implies (and (check-sound-p)
                (%step-hyps)
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (not (reserrp (eval-bind b denv limit)))
                (mv-nth 0 (%lbc))
                (omap::assoc (bind-name b) (mv-nth 1 (%lbc))))
           (b* ((val (expr-denv-lookup-expr (bind-name b)
                                            (eval-bind b denv limit)))
                (type (cdr (omap::assoc (bind-name b) (mv-nth 1 (%lbc)))))
                (tval (eval-type type (type-denv (ispace-denv nil) nil))))
             (and (not (reserrp val))
                  (type-closed-p type)
                  (not (reserrp tval))
                  (expr-value-typed-p val tval))))
  :use (let-bind-result-typed-at
        let-bind-check-facts
        bind-bound-expr-vars-subset-of-name
        (:instance lookup-of-name-in-eval-bind (d denv) (l limit))
        (:instance bind-bound-expr-vars-nonempty-when-assoc-local)
        (:instance expr-vars-typed-at-p-at
                   (types
                    (expr-senv->exprs (senvs+binds->eenv (mv-nth 2 (%lbc)))))
                   (names (bind-bound-expr-vars b))
                   (denv (eval-bind b denv limit))
                   (k (bind-name b)))
        (:instance closed-when-assoc-in-all-closed
                   (m (mv-nth 1 (%lbc))) (k (bind-name b))))
  :enable (let-bind-result-typed-at let-bind-check-facts
           bind-bound-expr-vars-subset-of-name assoc-of-restrict-to-keys
           eval-type-when-closed type-closed-p)
  :disable (expr-value-typed-p expr-vars-typed-at-p tenv-to-expr-senv
            check-sound-p check-sound-p-necc eval-bind eval-bind-list
            ll-bind hoist-local-fun ll-let-step ll-context-ok-p
            expr-denv-ll-related-p let-bind-check expr-denv-typed-for-p
            expr-denv-typed-for-p-of-init-senvs
            (:e init-ispace-senv) (:e init-type-senv)))

(defruled let-binder-not-typed
  (implies (%step-hyps)
           (and (not (omap::assoc (bind-name b) (ll-context->tenv ctx)))
                (equal
                 (name-to-type-option (bind-name b) (ll-context->tenv ctx))
                       (type-option-none))))
  :use (let-binders-facts
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance acl2::intersectp-member
                   (a (bind-name b)) (x (%bx)) (y (ll-context->locals ctx)))
        (:instance omap::in-of-keys-to-assoc
                   (omap::key (bind-name b)) (omap::map (ll-context->tenv ctx)))
        (:instance set::subset-in (a (bind-name b))
                   (x (omap::keys (ll-context->tenv ctx)))
                   (y (ll-context->locals ctx)))
        (:instance in-to-member-local (a (bind-name b))
                   (x (ll-context->locals ctx))))
  :enable (name-to-type-option)
  :disable (ll-context-ok-p set::subset-in))

(defrule in-bind-bound-expr-vars-when-name-local
  (implies (not (set::emptyp (bind-bound-expr-vars b)))
           (set::in (bind-name b) (bind-bound-expr-vars b)))
  :rule-classes nil
  :enable (bind-bound-expr-vars bind-name))

(defruled let-bound-value-ok-unchecked
  (implies (and (check-sound-p)
                (%step-hyps)
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (not (reserrp (eval-bind b denv limit)))
                (not (set::emptyp (bind-bound-expr-vars b)))
                (expr-denv-wfp denv)
                (not (mv-nth 0 (%lbc))))
           (ll-bound-value-ok-p (expr-denv-lookup-expr (bind-name b)
                                                       (eval-bind b denv limit))
                                (bind-name b) (%ctx2)))
  :use (ll-let-step-fields let-binder-not-typed
        (:instance extend-tenv-with-let-bind-via-check
                   (tenv (ll-context->tenv ctx)) (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx)))
        (:instance in-bind-bound-expr-vars-when-name-local))
  :enable (ll-bound-value-ok-p value-meets-required-type-p var-required-type
           name-to-type-option)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p
            expr-denv-ll-related-p let-bind-check eval-bind expr-value-typed-p
            check-sound-p value-has-inferred-type-p))

(defruled let-bound-value-ok-not-inferred
  (implies (and (check-sound-p)
                (%step-hyps)
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (not (reserrp (eval-bind b denv limit)))
                (not (set::emptyp (bind-bound-expr-vars b)))
                (expr-denv-wfp denv)
                (and (mv-nth 0 (%lbc))
                     (not (omap::assoc (bind-name b) (mv-nth 1 (%lbc))))))
           (ll-bound-value-ok-p (expr-denv-lookup-expr (bind-name b)
                                                       (eval-bind b denv limit))
                                (bind-name b) (%ctx2)))
  :use (ll-let-step-fields let-binder-not-typed
        (:instance extend-tenv-with-let-bind-via-check
                   (tenv (ll-context->tenv ctx)) (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx)))
        (:instance in-bind-bound-expr-vars-when-name-local))
  :enable (ll-let-step-fields let-binder-not-typed ll-bound-value-ok-p
           value-meets-required-type-p var-required-type
           name-to-type-option omap::assoc-of-update* omap::in-of-keys-to-assoc)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p
            expr-denv-ll-related-p let-bind-check eval-bind expr-value-typed-p
            check-sound-p value-has-inferred-type-p))

(defruled type-closed-p-of-type-fix-local
  (equal (type-closed-p (type-fix ty)) (type-closed-p ty))
  :enable (type-closed-p))

(defruled bound-value-ok-when-type-some
  (b* ((tv (eval-type ty (type-denv (ispace-denv nil) nil))))
    (implies (and (equal (name-to-type-option n tenv) (type-option-some ty))
                  (typep ty)
                  (type-closed-p ty)
                  (not (reserrp tv))
                  (expr-value-typed-p v tv)
                  (expr-value-wfp v))
             (and (value-meets-required-type-p v n tenv)
                  (value-has-inferred-type-p v n tenv))))
  :use ((:instance expr-values-match-type-values-p-when-typed
                   (tv (eval-type ty (type-denv (ispace-denv nil) nil))))
        (:instance type-value-flat-p-of-eval-type (type ty)
                   (denv (type-denv (ispace-denv nil) nil))))
  :enable (value-meets-required-type-p var-required-type
           value-has-inferred-type-p)
  :disable (expr-value-typed-p))

(defruled let-bound-tenv-entry
  (implies (and (%step-hyps)
                (mv-nth 0 (%lbc))
                (omap::assoc (bind-name b) (mv-nth 1 (%lbc))))
           (equal (name-to-type-option (bind-name b) (ll-context->tenv (%ctx2)))
                  (type-option-some (cdr (omap::assoc (bind-name b)
                                                      (mv-nth 1 (%lbc)))))))
  :use (ll-let-step-fields
        (:instance extend-tenv-with-let-bind-via-check
                   (tenv (ll-context->tenv ctx)) (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))))
  :enable (name-to-type-option omap::assoc-of-update*)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p
            expr-denv-ll-related-p let-bind-check eval-bind expr-value-typed-p
            check-sound-p))

(defruled let-bound-value-ok-inferred
  (implies (and (check-sound-p)
                (%step-hyps)
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (not (reserrp (eval-bind b denv limit)))
                (not (set::emptyp (bind-bound-expr-vars b)))
                (expr-denv-wfp denv)
                (and (mv-nth 0 (%lbc))
                     (omap::assoc (bind-name b) (mv-nth 1 (%lbc)))))
           (ll-bound-value-ok-p (expr-denv-lookup-expr (bind-name b)
                                                       (eval-bind b denv limit))
                                (bind-name b) (%ctx2)))
  :use (let-bound-value-typed
        let-bound-tenv-entry
        (:instance expr-denv-wfp-of-eval-bind (bind b))
        (:instance expr-value-wfp-of-expr-denv-lookup-expr
                   (var (bind-name b)) (denv (eval-bind b denv limit)))
        (:instance bound-value-ok-when-type-some
                   (n (bind-name b)) (tenv (ll-context->tenv (%ctx2)))
                   (ty (type-fix (cdr (omap::assoc (bind-name b)
                                                   (mv-nth 1 (%lbc))))))
                   (v (expr-denv-lookup-expr (bind-name b)
                                             (eval-bind b denv limit)))))
  :in-theory (e/d (ll-bound-value-ok-p type-closed-p-of-type-fix-local)
                  (ll-bind hoist-local-fun ll-let-step ll-context-ok-p
                   expr-denv-ll-related-p let-bind-check eval-bind
                   expr-value-typed-p check-sound-p value-meets-required-type-p
                   value-has-inferred-type-p eval-type)))

(defruled let-bound-value-ok
  (implies (and (check-sound-p)
                (%step-hyps)
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (not (reserrp (eval-bind b denv limit)))
                (not (set::emptyp (bind-bound-expr-vars b)))
                (expr-denv-wfp denv))
           (ll-bound-value-ok-p (expr-denv-lookup-expr (bind-name b)
                                                       (eval-bind b denv limit))
                                (bind-name b) (%ctx2)))
  :use (let-bound-value-ok-unchecked let-bound-value-ok-not-inferred
        let-bound-value-ok-inferred)
  :in-theory (theory 'minimal-theory))

(defmacro %tw () '(let-bind-typed-p-witness bind denv limit))

(defruled let-bind-typed-p-when-check-sound
  (implies (check-sound-p)
           (let-bind-typed-p bind denv limit))
  :expand ((let-bind-typed-p bind denv limit))
  :use ((:instance let-bound-value-ok
                   (b bind)
                   (rest (mv-nth 0 (%tw))) (body (mv-nth 1 (%tw)))
                   (ctx (mv-nth 2 (%tw))) (new-denv (mv-nth 3 (%tw)))
                   (dw (mv-nth 4 (%tw))) (genv (mv-nth 5 (%tw)))))
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p
            expr-denv-ll-related-p let-bind-check eval-bind
            ll-bound-value-ok-p check-sound-p))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The functions on values.  Type and ispace applications of related type and
; ispace closures: both bodies are evaluated in their environments extended
; with the same type or ispace variable.

(defmacro %tlctx () '(ll-value-witness-tlambda->ctx w))

(defmacro %tldw () '(ll-value-witness-tlambda->denv w))

(defruled tlambda-related-unpack
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (expr-value-kind f) :tlambda))
           (and (equal (expr-value-kind nf) :tlambda)
                (equal (ll-value-witness-kind w) :tlambda)
                (equal (expr-value-tlambda->param nf)
                       (expr-value-tlambda->param f))
                (equal (expr-value-tlambda->body nf)
                       (ll-context-new-expr (expr-value-tlambda->body f)
                                            (%tlctx)))
                (ll-context-ok-p (expr-value-tlambda->body f) (%tlctx) genv)
                (expr-denv-ll-related-p (expr-value-tlambda->denv nf)
                                        (expr-value-tlambda->denv f)
                                        (expr-value-tlambda->body f) (%tlctx)
                                        nil (%tldw) genv)))
  :expand ((expr-value-ll-related-p nf f w genv))
  :enable (expr-value-groundp)
  :disable (ll-context-ok-p expr-denv-ll-related-p))

(defruled ilambda-related-unpack
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (expr-value-kind f) :ilambda))
           (and (equal (expr-value-kind nf) :ilambda)
                (equal (ll-value-witness-kind w) :tlambda)
                (equal (expr-value-ilambda->param nf)
                       (expr-value-ilambda->param f))
                (equal (expr-value-ilambda->body nf)
                       (ll-context-new-expr (expr-value-ilambda->body f)
                                            (%tlctx)))
                (ll-context-ok-p (expr-value-ilambda->body f) (%tlctx) genv)
                (expr-denv-ll-related-p (expr-value-ilambda->denv nf)
                                        (expr-value-ilambda->denv f)
                                        (expr-value-ilambda->body f) (%tlctx)
                                        nil (%tldw) genv)))
  :expand ((expr-value-ll-related-p nf f w genv))
  :enable (expr-value-groundp)
  :disable (ll-context-ok-p expr-denv-ll-related-p))

; Changing the type environments alike keeps environments related.

(defruled expr-denv-ll-related-p-of-same-tenv-change
  (implies (and (expr-denv-ll-related-p nd d y ctx nil dw genv)
                (ll-context-ok-p y ctx genv)
                (equal (expr-denv->exprs nd2) (expr-denv->exprs nd))
                (equal (expr-denv->exprs d2) (expr-denv->exprs d))
                (equal (expr-denv->tenv nd2) (expr-denv->tenv d2)))
           (expr-denv-ll-related-p nd2 d2 y ctx nil dw genv))
  :use ((:instance ll-context-ok-p-facts (x y))
        (:instance expr-denv-ll-related-p-when-same-exprs
                   (excl nil) (pnames (expr-binder-names y))))
  :disable (ll-context-ok-p expr-denv-ll-related-p lmap-replacements-ok-p))

(defruled tlambda-body-env-related
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (expr-value-kind f) :tlambda))
           (expr-denv-ll-related-p
            (expr-denv-add-type p tv (expr-value-tlambda->denv nf))
            (expr-denv-add-type p tv (expr-value-tlambda->denv f))
            (expr-value-tlambda->body f) (%tlctx) nil (%tldw) genv))
  :use (tlambda-related-unpack
        (:instance expr-denv-ll-related-p-of-same-tenv-change
                   (nd (expr-value-tlambda->denv nf))
                   (d (expr-value-tlambda->denv f))
                   (y (expr-value-tlambda->body f)) (ctx (%tlctx)) (dw (%tldw))
                   (nd2 (expr-denv-add-type p tv (expr-value-tlambda->denv nf)))
                   (d2 (expr-denv-add-type p tv (expr-value-tlambda->denv f))))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (new-denv (expr-value-tlambda->denv nf))
                   (denv (expr-value-tlambda->denv f))
                   (x (expr-value-tlambda->body f)) (ctx (%tlctx)) (excl nil)
                   (dw (%tldw))))
  :enable (expr-denv-add-type)
  :disable (ll-context-ok-p expr-denv-ll-related-p))

(defruled ilambda-body-env-related
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (expr-value-kind f) :ilambda))
           (expr-denv-ll-related-p
            (expr-denv-add-ispace p iv (expr-value-ilambda->denv nf))
            (expr-denv-add-ispace p iv (expr-value-ilambda->denv f))
            (expr-value-ilambda->body f) (%tlctx) nil (%tldw) genv))
  :use (ilambda-related-unpack
        (:instance expr-denv-ll-related-p-of-same-tenv-change
                   (nd (expr-value-ilambda->denv nf))
                   (d (expr-value-ilambda->denv f))
                   (y (expr-value-ilambda->body f)) (ctx (%tlctx)) (dw (%tldw))
                   (nd2
                    (expr-denv-add-ispace p iv (expr-value-ilambda->denv nf)))
                   (d2
                    (expr-denv-add-ispace p iv (expr-value-ilambda->denv f))))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (new-denv (expr-value-ilambda->denv nf))
                   (denv (expr-value-ilambda->denv f))
                   (x (expr-value-ilambda->body f)) (ctx (%tlctx)) (excl nil)
                   (dw (%tldw))))
  :enable (expr-denv-add-ispace)
  :disable (ll-context-ok-p expr-denv-ll-related-p))

(defmacro %tlbody () '(expr-value-tlambda->body funval))

(defmacro %tlenv () '(expr-denv-add-type (expr-value-tlambda->param funval) tval
                                         (expr-value-tlambda->denv funval)))

(defmacro %ntlenv ()
          '(expr-denv-add-type (expr-value-tlambda->param funval) tval
                                          (expr-value-tlambda->denv
                                           new-funval)))

(defruled eval-tapp-when-tlambda-local
  (implies (and (equal (expr-value-kind f) :tlambda)
                (not (reserrp (eval-tapp f tv l))))
           (and (posp l)
                (type-values-match-type-vars-p (list tv)
                                               (list
                                                (expr-value-tlambda->param f)))
                (equal (eval-tapp f tv l)
                       (eval-expr (expr-value-tlambda->body f)
                                  (expr-denv-add-type
                                   (expr-value-tlambda->param f)
                                                      tv
                                                      (expr-value-tlambda->denv
                                                       f))
                                  (1- l)))))
  :expand ((eval-tapp f tv l)))

(defruled eval-tapp-of-tlambda-at-succ
  (implies (and (equal (expr-value-kind f) :tlambda)
                (type-values-match-type-vars-p (list tv)
                                               (list
                                                (expr-value-tlambda->param f)))
                (natp l))
           (equal (eval-tapp f tv (+ 1 l))
                  (eval-expr (expr-value-tlambda->body f)
                             (expr-denv-add-type (expr-value-tlambda->param f)
                                                 tv
                                                 (expr-value-tlambda->denv f))
                             l)))
  :expand ((eval-tapp f tv (+ 1 l))))

(defruled eval-tapp-ll-reaches-p-when-tlambda
  (implies (and (equal (expr-value-kind funval) :tlambda)
                (not (reserrp (eval-tapp funval tval limit)))
                (eval-expr-ll-ok (%tlbody) (%tlenv) (1- limit))
                (expr-value-ll-related-p new-funval funval w genv)
                (expr-value-wfp funval)
                (expr-value-wfp new-funval))
           (eval-tapp-ll-reaches-p new-funval tval
                                   (eval-tapp funval tval limit) genv))
  :use ((:instance eval-tapp-when-tlambda-local (f funval) (tv tval) (l limit))
        (:instance tlambda-related-unpack (nf new-funval) (f funval))
        (:instance tlambda-body-env-related (nf new-funval) (f funval)
                   (p (expr-value-tlambda->param funval)) (tv tval))
        (:instance eval-expr-ll-ok-necc
                   (expr (%tlbody)) (denv (%tlenv)) (limit (1- limit))
                   (ctx (%tlctx)) (new-denv (%ntlenv)) (dw (%tldw)))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (ll-context-new-expr (%tlbody) (%tlctx)))
                   (new-denv (%ntlenv))
                   (val (eval-tapp funval tval limit)))
        (:instance eval-tapp-of-tlambda-at-succ
                   (f new-funval) (tv tval)
                   (l (mv-nth 0 (eval-expr-ll-reaches-p-witness
                                 (ll-context-new-expr (%tlbody) (%tlctx))
                                 (%ntlenv) (eval-tapp funval tval
                                                      limit) genv))))
        (:instance posp-limit-when-eval-expr-ok
                   (expr (ll-context-new-expr (%tlbody) (%tlctx)))
                   (denv (%ntlenv))
                   (limit (mv-nth 0 (eval-expr-ll-reaches-p-witness
                                     (ll-context-new-expr (%tlbody) (%tlctx))
                                     (%ntlenv) (eval-tapp funval tval limit)
                                     genv))))
        (:instance eval-tapp-ll-reaches-p-suff
                   (limit2 (+ 1 (mv-nth 0 (eval-expr-ll-reaches-p-witness
                                           (ll-context-new-expr (%tlbody)
                                                                (%tlctx))
                                           (%ntlenv) (eval-tapp funval tval
                                                                limit)
                                           genv))))
                   (w (mv-nth 1 (eval-expr-ll-reaches-p-witness
                                 (ll-context-new-expr (%tlbody) (%tlctx))
                                 (%ntlenv) (eval-tapp funval tval limit) genv)))
                   (val (eval-tapp funval tval limit))))
  :disable (eval-tapp eval-expr ll-context-ok-p expr-denv-ll-related-p
            expr-value-ll-related-p eval-expr-ll-ok eval-expr-ll-ok-necc
            eval-tapp-ll-reaches-p eval-tapp-ll-reaches-p-suff
            eval-expr-ll-reaches-p))

; A primitive operation applicable to types or ispaces has no expression
; values in it, so a related one is equal to it, and so is the result of
; the application, which is related to itself.

(defruled primop-tfun-when-related
  (implies (and (primop-value-ll-related-p new-op op ws genv)
                (primop-value-tfunp op))
           (and (primop-value-tfunp new-op)
                (equal (eval-primop-tfun new-op tval)
                       (eval-primop-tfun op tval))))
  :expand ((primop-value-ll-related-p new-op op ws genv))
  :enable (primop-value-tfunp eval-primop-tfun))

(defruled primop-tfun-result-related
  (implies (and (primop-value-tfunp op)
                (not (reserrp (eval-primop-tfun op tval))))
           (expr-value-ll-related-p (eval-primop-tfun op tval)
                                    (eval-primop-tfun op tval)
                                    (ll-value-witness-primop nil) genv))
  :enable (primop-value-tfunp eval-primop-tfun)
  :expand ((:free (v w) (expr-value-ll-related-p v v w genv))
           (:free (o ws) (primop-value-ll-related-p o o ws genv))))

(defruled primop-ifun-when-related
  (implies (and (primop-value-ll-related-p new-op op ws genv)
                (primop-value-ifunp op))
           (and (primop-value-ifunp new-op)
                (equal (eval-primop-ifun new-op ival)
                       (eval-primop-ifun op ival))))
  :expand ((primop-value-ll-related-p new-op op ws genv))
  :enable (primop-value-ifunp eval-primop-ifun))

; The ispace primitives that yield arrays directly (IOTA/STATIC and
; REIFY-SHAPE) yield arrays of base values, related to themselves via
; ground witnesses arranged by the dimensions.

(defun ll-ground-ws (vals)
  (if (endp vals)
      nil
    (cons (ll-value-witness-ground) (ll-ground-ws (cdr vals)))))

(defruled expr-value-list-ll-related-p-of-ground-ws
  (implies (expr-value-list-groundp vals)
           (expr-value-list-ll-related-p vals vals (ll-ground-ws vals) genv))
  :induct (len vals)
  :enable (len)
  :hints (("Subgoal *1/1"
           :use ((:instance expr-value-ll-related-p-of-ground
                            (val (car vals))))))
  :expand ((:free (ws) (expr-value-list-ll-related-p vals vals ws genv))
           (ll-ground-ws vals)
           (expr-value-list-groundp vals)))

(defmacro %iota-vals (s)
  `(expr-value-base-list
    (base-value-int-list
     (int-value-list-of (nat-list-from-to 0 (nat-list-product ,s))))))

(defmacro %rs-vals (s)
  `(expr-value-base-list (base-value-int-list (int-value-list-of ,s))))

(defun ll-ifun-witness (op ival)
  (b* ((r (eval-primop-ifun op ival)))
    (cond ((and (primop-value-case op :iota/static)
                (ispace-value-case ival :shape))
           (b* ((s (nat-list-fix (ispace-value-shape->val ival))))
             (if (member-equal 0 s)
                 (ll-empty-dim-witness s)
               (ll-nd-witness 'one s (take (len (%iota-vals s))
                                           (ll-ground-ws (%iota-vals s)))))))
          ((and (primop-value-case op :reify-shape)
                (ispace-value-case ival :shape))
           (b* ((s (nat-list-fix (ispace-value-shape->val ival))))
             (ll-value-witness-box
              (if (endp s)
                  (ll-empty-dim-witness (list 0))
                (ll-nd-witness 'one (list (len s))
                               (take (len (%rs-vals s))
                                     (ll-ground-ws (%rs-vals s))))))))
          ((expr-value-groundp r) (ll-value-witness-ground))
          (t (ll-value-witness-primop nil)))))

(defruled primop-ifun-result-related-iota
  (implies (and (equal (primop-value-kind op) :iota/static)
                (not (reserrp (eval-primop-ifun op ival))))
           (expr-value-ll-related-p (eval-primop-ifun op ival)
                                    (eval-primop-ifun op ival)
                                    (ll-ifun-witness op ival) genv))
  :use ((:instance expr-value-ll-related-p-of-empty-dim
                   (dims (nat-list-fix (ispace-value-shape->val ival)))
                   (elem (type-value-base (base-type-int))))
        (:instance expr-value-ll-related-p-of-nonempty-dims
                   (dims (nat-list-fix (ispace-value-shape->val ival)))
                   (nvals
                    (%iota-vals (nat-list-fix (ispace-value-shape->val ival))))
                   (vals
                    (%iota-vals (nat-list-fix (ispace-value-shape->val ival))))
                   (ws (ll-ground-ws
                        (%iota-vals
                         (nat-list-fix (ispace-value-shape->val ival))))))
        (:instance expr-value-list-ll-related-p-of-ground-ws
                   (vals
                    (%iota-vals (nat-list-fix (ispace-value-shape->val ival)))))
        (:instance expr-value-list-groundp-of-expr-value-base-list
                   (vals (base-value-int-list
                        (int-value-list-of
                         (nat-list-from-to
                          0 (nat-list-product
                             (nat-list-fix
                              (ispace-value-shape->val ival)))))))))
  :expand ((eval-primop-ifun op ival)
           (prim-iota/static (ispace-value-shape->val ival)))
  :disable (expr-value-with-empty-dim expr-value-with-nonempty-dims
            ll-nd-witness ll-empty-dim-witness))

(defruled expr-value-ll-related-p-of-box-same
  (implies (expr-value-ll-related-p a a aw genv)
           (expr-value-ll-related-p (expr-value-box i a ty)
                                    (expr-value-box i a ty)
                                    (ll-value-witness-box aw) genv))
  :expand ((expr-value-ll-related-p (expr-value-box i a ty)
                                    (expr-value-box i a ty)
                                    (ll-value-witness-box aw) genv)))

(defruled primop-ifun-result-related-reify-shape
  (implies (and (equal (primop-value-kind op) :reify-shape)
                (not (reserrp (eval-primop-ifun op ival))))
           (expr-value-ll-related-p (eval-primop-ifun op ival)
                                    (eval-primop-ifun op ival)
                                    (ll-ifun-witness op ival) genv))
  :use ((:instance expr-value-ll-related-p-of-empty-dim
                   (dims (list 0))
                   (elem (type-value-base (base-type-int))))
        (:instance expr-value-ll-related-p-of-nonempty-dims
                   (dims
                    (list (len (nat-list-fix (ispace-value-shape->val ival)))))
                   (nvals
                    (%rs-vals (nat-list-fix (ispace-value-shape->val ival))))
                   (vals
                    (%rs-vals (nat-list-fix (ispace-value-shape->val ival))))
                   (ws (ll-ground-ws
                        (%rs-vals
                         (nat-list-fix (ispace-value-shape->val ival))))))
        (:instance expr-value-list-ll-related-p-of-ground-ws
                   (vals
                    (%rs-vals (nat-list-fix (ispace-value-shape->val ival)))))
        (:instance expr-value-ll-related-p-of-box-same
                   (i (ispace-value-dim 0))
                   (a (expr-value-with-empty-dim (list 0)
                                                 (type-value-base
                                                  (base-type-int))))
                   (aw (ll-empty-dim-witness (list 0)))
                   (ty (make-type-value-sigma
                        :param (ispace-var-dim "r")
                        :body (t[] :int (shp "$r"))
                        :denv (make-type-denv
                               :ienv (make-ispace-denv :ispaces nil)
                               :types nil))))
        (:instance expr-value-list-groundp-of-expr-value-base-list
                   (vals (base-value-int-list
                        (int-value-list-of
                         (nat-list-fix (ispace-value-shape->val ival)))))))
  :expand ((eval-primop-ifun op ival)
           (prim-reify-shape (ispace-value-shape->val ival))
           (:free (i a ty w) (expr-value-ll-related-p (expr-value-box i a ty)
                                                      (expr-value-box i a ty)
                                                      w genv)))
  :disable (expr-value-with-empty-dim expr-value-with-nonempty-dims
            ll-nd-witness ll-empty-dim-witness))

(defruled primop-ifun-result-related-other
  (implies (and (primop-value-ifunp op)
                (not (equal (primop-value-kind op) :iota/static))
                (not (equal (primop-value-kind op) :reify-shape))
                (not (reserrp (eval-primop-ifun op ival))))
           (expr-value-ll-related-p (eval-primop-ifun op ival)
                                    (eval-primop-ifun op ival)
                                    (ll-ifun-witness op ival) genv))
  :cases ((expr-value-groundp (eval-primop-ifun op ival)))
  :hints (("Subgoal 1"
           :use ((:instance expr-value-ll-related-p-of-ground
                            (val (eval-primop-ifun op ival)))))
          ("Subgoal 2"
           :in-theory (enable primop-value-ifunp eval-primop-ifun
                              prim-reify-dim)
           :expand ((:free (b) (expr-value-groundp (expr-value-base b)))
                    (:free (v w) (expr-value-ll-related-p v v w genv))
                    (:free (o ws) (primop-value-ll-related-p o o ws genv))))))

(defruled primop-ifun-result-related
  (implies (and (primop-value-ifunp op)
                (not (reserrp (eval-primop-ifun op ival))))
           (expr-value-ll-related-p (eval-primop-ifun op ival)
                                    (eval-primop-ifun op ival)
                                    (ll-ifun-witness op ival) genv))
  :use (primop-ifun-result-related-iota primop-ifun-result-related-reify-shape
        primop-ifun-result-related-other)
  :disable (ll-ifun-witness eval-primop-ifun))

; Unpacking the relation at primitive operations, vectors, and empty
; vectors.  A ground witness relates a value only to itself; its components
; are then related via ground witnesses.

(defruled groundp-when-related-via-ground
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (ll-value-witness-kind w) :ground))
           (and (expr-value-groundp f)
                (equal (expr-value-fix nf) (expr-value-fix f))))
  :expand ((expr-value-ll-related-p nf f w genv)))

(defruled primop-related-unpack
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (expr-value-kind f) :primop)
                (not (equal (ll-value-witness-kind w) :ground)))
           (and (equal (expr-value-kind nf) :primop)
                (primop-value-ll-related-p (expr-value-primop->val nf)
                                           (expr-value-primop->val f)
                                           (ll-value-witness-primop->ws w)
                                           genv)))
  :expand ((expr-value-ll-related-p nf f w genv))
  :disable (primop-value-ll-related-p))

(defruled vector-empty-related-unpack
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (expr-value-kind f) :vector-empty))
           (equal (expr-value-fix nf) (expr-value-fix f)))
  :expand ((expr-value-ll-related-p nf f w genv)))

(defmacro %vws ()
  '(if (equal (ll-value-witness-kind w) :ground)
       (ll-ground-ws (expr-value-vector->elems f))
     (ll-value-witness-vector->elems w)))

(defruled vector-related-unpack
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (expr-value-kind f) :vector))
           (and (equal (expr-value-kind nf) :vector)
                (expr-value-list-ll-related-p (expr-value-vector->elems nf)
                                              (expr-value-vector->elems f)
                                              (%vws) genv)))
  :cases ((equal (ll-value-witness-kind w) :ground))
  :hints (("Subgoal 1"
           :use ((:instance equal-when-expr-value-ll-related-p-groundp
                            (new-val nf) (val f))
                 (:instance expr-value-list-ll-related-p-of-ground-ws
                            (vals (expr-value-vector->elems f)))
                 (:instance expr-value-kind-of-expr-value-fix-local (x nf))
                 (:instance expr-value-vector->elems-of-expr-value-fix-local
                            (x nf)))
           :expand ((expr-value-ll-related-p nf f w genv)
                    (expr-value-groundp f)))
          ("Subgoal 2"
           :expand ((expr-value-ll-related-p nf f w genv))))
  :disable (expr-value-list-ll-related-p)
  :prep-lemmas
  ((defrule expr-value-kind-of-expr-value-fix-local
     (equal (expr-value-kind (expr-value-fix x)) (expr-value-kind x))
     :rule-classes nil)
   (defrule expr-value-vector->elems-of-expr-value-fix-local
     (equal (expr-value-vector->elems (expr-value-fix x))
            (expr-value-vector->elems x))
     :rule-classes nil)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; EVAL-TAPP of a primitive operation or empty vector: the lifted value is
; applied alike.

(defruled eval-tapp-of-related-primop
  (implies (and (equal (expr-value-kind funval) :primop)
                (not (reserrp (eval-tapp funval tval limit)))
                (expr-value-ll-related-p new-funval funval w genv))
           (equal (eval-tapp new-funval tval limit)
                  (eval-tapp funval tval limit)))
  :cases ((equal (ll-value-witness-kind w) :ground))
  :hints (("Subgoal 1"
           :use ((:instance groundp-when-related-via-ground
                            (nf new-funval) (f funval))
                 (:instance eval-tapp-of-expr-value-fix-funval
                            (funval new-funval))
                 (:instance eval-tapp-of-expr-value-fix-funval))
           :in-theory (disable eval-tapp-of-expr-value-fix-funval
                               eval-tapp-expr-value-equiv-congruence-on-funval))
          ("Subgoal 2"
           :use ((:instance primop-related-unpack (nf new-funval) (f funval))
                 (:instance primop-tfun-when-related
                            (new-op (expr-value-primop->val new-funval))
                            (op (expr-value-primop->val funval))
                            (ws (ll-value-witness-primop->ws w))))
           :expand ((eval-tapp new-funval tval limit)
                    (eval-tapp funval tval limit)))))

(defruled eval-tapp-of-related-vector-empty
  (implies (and (equal (expr-value-kind funval) :vector-empty)
                (expr-value-ll-related-p new-funval funval w genv))
           (equal (eval-tapp new-funval tval limit)
                  (eval-tapp funval tval limit)))
  :use ((:instance vector-empty-related-unpack (nf new-funval) (f funval))
        (:instance eval-tapp-of-expr-value-fix-funval (funval new-funval))
        (:instance eval-tapp-of-expr-value-fix-funval))
  :in-theory (disable eval-tapp-of-expr-value-fix-funval
                      eval-tapp-expr-value-equiv-congruence-on-funval))

(defun ll-tapp-same-witness (funval)
  (if (equal (expr-value-kind funval) :primop)
      (ll-value-witness-primop nil)
    (ll-value-witness-vector nil)))

(defruled eval-tapp-result-related-when-primop-or-empty
  (implies (and (member-equal (expr-value-kind funval) '(:primop :vector-empty))
                (not (reserrp (eval-tapp funval tval limit))))
           (expr-value-ll-related-p (eval-tapp funval tval limit)
                                    (eval-tapp funval tval limit)
                                    (ll-tapp-same-witness funval) genv))
  :cases ((equal (expr-value-kind funval) :primop))
  :hints (("Subgoal 1"
           :use ((:instance primop-tfun-result-related
                            (op (expr-value-primop->val funval))))
           :expand ((eval-tapp funval tval limit)))
          ("Subgoal 2"
           :expand ((eval-tapp funval tval limit))
           :in-theory (enable expr-value-ll-related-p-of-vector-empty))))

(defruled eval-tapp-ll-reaches-p-when-primop-or-empty
  (implies (and (member-equal (expr-value-kind funval) '(:primop :vector-empty))
                (not (reserrp (eval-tapp funval tval limit)))
                (expr-value-ll-related-p new-funval funval w genv))
           (eval-tapp-ll-reaches-p new-funval tval
                                   (eval-tapp funval tval limit) genv))
  :use (eval-tapp-of-related-primop eval-tapp-of-related-vector-empty
        eval-tapp-result-related-when-primop-or-empty
        (:instance eval-tapp-ll-reaches-p-suff
                   (limit2 limit) (w (ll-tapp-same-witness funval))
                   (val (eval-tapp funval tval limit))))
  :disable (eval-tapp eval-tapp-ll-reaches-p eval-tapp-ll-reaches-p-suff
            ll-tapp-same-witness))

; EVAL-TAPP of a vector: the elements are applied by EVAL-TAPP-LIST.

(defmacro %tvels () '(expr-value-vector->elems funval))

(defmacro %ntvels () '(expr-value-vector->elems new-funval))

(defmacro %tvws ()
  '(if (equal (ll-value-witness-kind w) :ground)
       (ll-ground-ws (expr-value-vector->elems funval))
     (ll-value-witness-vector->elems w)))

(defmacro %tvlw ()
  '(eval-tapp-list-ll-reaches-p-witness (%ntvels) tval
                                        (eval-tapp-list (%tvels) tval
                                                        (1- limit))
                                        genv))

(defruled eval-tapp-when-vector-local
  (implies (and (equal (expr-value-kind f) :vector)
                (not (reserrp (eval-tapp f tv l))))
           (and (posp l)
                (not (reserrp (eval-tapp-list (expr-value-vector->elems f) tv
                                              (1- l))))
                (consp (eval-tapp-list (expr-value-vector->elems f) tv (1- l)))
                (list-repeatp (dims-of-expr-value-list
                               (eval-tapp-list (expr-value-vector->elems f) tv
                                               (1- l))))
                (equal (eval-tapp f tv l)
                       (expr-value-vector
                        (eval-tapp-list (expr-value-vector->elems f) tv
                                        (1- l))))))
  :expand ((eval-tapp f tv l)))

(defruled eval-tapp-of-vector-at-succ
  (implies (and (equal (expr-value-kind f) :vector)
                (natp l)
                (not
                 (reserrp (eval-tapp-list (expr-value-vector->elems f) tv l)))
                (consp (eval-tapp-list (expr-value-vector->elems f) tv l))
                (list-repeatp (dims-of-expr-value-list
                               (eval-tapp-list (expr-value-vector->elems f) tv
                                               l))))
           (equal (eval-tapp f tv (+ 1 l))
                  (expr-value-vector
                   (eval-tapp-list (expr-value-vector->elems f) tv l))))
  :expand ((eval-tapp f tv (+ 1 l))))

(defruled eval-tapp-list-ll-reaches-p-elim
  (implies (eval-tapp-list-ll-reaches-p new-funvals tval vals genv)
           (b* (((mv l ws)
                 (eval-tapp-list-ll-reaches-p-witness new-funvals tval vals
                                                      genv))
                (nvs (eval-tapp-list new-funvals tval l)))
             (and (not (reserrp nvs))
                  (expr-value-list-ll-related-p nvs vals ws genv))))
  :enable eval-tapp-list-ll-reaches-p)

(defruled posp-limit-when-eval-tapp-list-ok
  (implies (not (reserrp (eval-tapp-list funvals tval limit)))
           (posp limit))
  :expand ((eval-tapp-list funvals tval limit)))

(defruled eval-tapp-ll-reaches-p-of-vector-generic
  (implies (and (equal (expr-value-kind nf) :vector)
                (natp l)
                (not
                 (reserrp (eval-tapp-list (expr-value-vector->elems nf) tv l)))
                (expr-value-list-ll-related-p
                 (eval-tapp-list (expr-value-vector->elems nf) tv l) vs ws genv)
                (consp vs)
                (list-repeatp (dims-of-expr-value-list vs))
                (expr-value-list-wfp vs)
                (expr-value-list-wfp
                 (eval-tapp-list (expr-value-vector->elems nf) tv l))
                (equal val (expr-value-vector vs)))
           (eval-tapp-ll-reaches-p nf tv val genv))
  :use ((:instance consp-when-expr-value-list-ll-related-p
                   (nvals (eval-tapp-list (expr-value-vector->elems nf) tv l))
                   (vals vs))
        (:instance dims-of-expr-value-list-when-ll-related
                   (new-vals
                    (eval-tapp-list (expr-value-vector->elems nf) tv l))
                   (vals vs))
        (:instance eval-tapp-of-vector-at-succ (f nf))
        (:instance expr-value-ll-related-p-of-vector-values
                   (a (eval-tapp-list (expr-value-vector->elems nf) tv l))
                   (b vs) (w (ll-value-witness-vector ws)))
        (:instance eval-tapp-ll-reaches-p-suff
                   (new-funval nf) (tval tv)
                   (limit2 (+ 1 l)) (w (ll-value-witness-vector ws))))
  :disable (eval-tapp eval-tapp-list expr-value-ll-related-p
            expr-value-list-ll-related-p eval-tapp-ll-reaches-p
            eval-tapp-ll-reaches-p-suff equal-of-expr-value-vector)
  :enable (not-reserrp-when-expr-valuep))

(defruled eval-tapp-ll-reaches-p-when-vector
  (implies (and (equal (expr-value-kind funval) :vector)
                (not (reserrp (eval-tapp funval tval limit)))
                (eval-tapp-list-ll-ok (%tvels) tval (1- limit))
                (expr-value-ll-related-p new-funval funval w genv)
                (expr-value-wfp funval)
                (expr-value-wfp new-funval))
           (eval-tapp-ll-reaches-p new-funval tval
                                   (eval-tapp funval tval limit) genv))
  :use ((:instance eval-tapp-when-vector-local (f funval) (tv tval) (l limit))
        (:instance vector-related-unpack (nf new-funval) (f funval))
        (:instance eval-tapp-list-ll-ok-necc
                   (funvals (%tvels)) (limit (1- limit))
                   (new-funvals (%ntvels)) (ws (%tvws)))
        (:instance eval-tapp-list-ll-reaches-p-elim
                   (new-funvals (%ntvels))
                   (vals (eval-tapp-list (%tvels) tval (1- limit))))
        (:instance posp-limit-when-eval-tapp-list-ok
                   (funvals (%ntvels)) (limit (mv-nth 0 (%tvlw))))
        (:instance eval-tapp-ll-reaches-p-of-vector-generic
                   (nf new-funval) (tv tval) (l (mv-nth 0 (%tvlw)))
                   (vs (eval-tapp-list (%tvels) tval (1- limit)))
                   (ws (mv-nth 1 (%tvlw)))
                   (val (eval-tapp funval tval limit))))
  :in-theory (e/d (natp posp expr-value-list-wfp-of-eval-tapp-list
                   expr-value-list-wfp-of-expr-value-vector->elems)
                  (eval-tapp eval-tapp-list expr-value-ll-related-p
                   expr-value-list-ll-related-p eval-tapp-list-ll-ok
                   eval-tapp-list-ll-ok-necc eval-tapp-ll-reaches-p
                   eval-tapp-ll-reaches-p-suff eval-tapp-list-ll-reaches-p
                   equal-of-expr-value-vector)))

; The statement for EVAL-TAPP.

(defmacro %taw () '(eval-tapp-ll-ok-witness funval tval limit))

(defruled eval-tapp-not-error-kinds
  (implies (not (reserrp (eval-tapp funval tval limit)))
           (member-equal (expr-value-kind funval)
                         '(:tlambda :primop :vector :vector-empty)))
  :expand ((eval-tapp funval tval limit)))

(defruled eval-tapp-ll-ok-when-ok
  (implies (and (implies (equal (expr-value-kind funval) :tlambda)
                         (eval-expr-ll-ok (%tlbody) (%tlenv) (1- limit)))
                (implies (equal (expr-value-kind funval) :vector)
                         (eval-tapp-list-ll-ok (%tvels) tval (1- limit))))
           (eval-tapp-ll-ok funval tval limit))
  :expand ((eval-tapp-ll-ok funval tval limit))
  :use (eval-tapp-not-error-kinds
        (:instance eval-tapp-ll-reaches-p-when-tlambda
                   (new-funval (mv-nth 0 (%taw))) (w (mv-nth 1 (%taw)))
                   (genv (mv-nth 2 (%taw))))
        (:instance eval-tapp-ll-reaches-p-when-vector
                   (new-funval (mv-nth 0 (%taw))) (w (mv-nth 1 (%taw)))
                   (genv (mv-nth 2 (%taw))))
        (:instance eval-tapp-ll-reaches-p-when-primop-or-empty
                   (new-funval (mv-nth 0 (%taw))) (w (mv-nth 1 (%taw)))
                   (genv (mv-nth 2 (%taw)))))
  :disable (eval-tapp eval-tapp-ll-reaches-p eval-expr-ll-ok
            eval-tapp-list-ll-ok expr-value-ll-related-p))

; The statement for EVAL-TAPP-LIST.

(defmacro %tlw () '(eval-tapp-list-ll-ok-witness funvals tval limit))

(defmacro %tlnf () '(mv-nth 0 (%tlw)))

(defmacro %tlws () '(mv-nth 1 (%tlw)))

(defmacro %tlg () '(mv-nth 2 (%tlw)))

(defruled eval-tapp-list-when-ok-local
  (implies (not (reserrp (eval-tapp-list fs tv l)))
           (and (posp l)
                (implies (not (consp fs)) (equal (eval-tapp-list fs tv l) nil))
                (implies (consp fs)
                         (and (not (reserrp (eval-tapp (car fs) tv (1- l))))
                              (not (reserrp (eval-tapp-list (cdr fs) tv
                                                            (1- l))))
                              (equal (eval-tapp-list fs tv l)
                                     (cons (eval-tapp (car fs) tv (1- l))
                                           (eval-tapp-list (cdr fs) tv
                                                           (1- l))))))))
  :expand ((eval-tapp-list fs tv l)))

(defruled eval-tapp-list-of-cons-at-sum
  (implies (and (consp fs)
                (not (reserrp (eval-tapp (car fs) tv l1)))
                (not (reserrp (eval-tapp-list (cdr fs) tv l2))))
           (equal (eval-tapp-list fs tv (+ 1 l1 l2))
                  (cons (eval-tapp (car fs) tv l1)
                        (eval-tapp-list (cdr fs) tv l2))))
  :use ((:instance posp-limit-when-eval-tapp-ok (funval (car fs)) (tval tv)
                   (limit l1))
        (:instance posp-limit-when-eval-tapp-list-ok (funvals (cdr fs))
                   (tval tv)
                   (limit l2))
        (:instance eval-tapp-at-larger-limit (funval (car fs)) (tval tv)
                   (limit l1) (limit2 (+ l1 l2)))
        (:instance eval-tapp-list-at-larger-limit-local (funvals (cdr fs))
                   (tval tv) (limit l2) (limit2 (+ l1 l2))))
  :expand ((eval-tapp-list fs tv (+ 1 l1 l2)))
  :prep-lemmas
  ((defruled eval-tapp-list-at-larger-limit-local
     (implies (and (not (reserrp (eval-tapp-list funvals tval limit)))
                   (integerp limit2)
                   (<= limit limit2))
              (equal (eval-tapp-list funvals tval limit2)
                     (eval-tapp-list funvals tval limit)))
     :use (posp-limit-when-eval-tapp-list-ok
           (:instance eval-tapp-list-of-larger-limit (k (- limit2 limit)))))))

(defruled eval-tapp-list-ll-reaches-p-of-cons-generic
  (implies (and (consp nfs)
                (not (reserrp (eval-tapp (car nfs) tv l1)))
                (expr-value-ll-related-p (eval-tapp (car nfs) tv l1) v w1 genv)
                (not (reserrp (eval-tapp-list (cdr nfs) tv l2)))
                (expr-value-list-ll-related-p (eval-tapp-list (cdr nfs) tv l2)
                                              vs ws2 genv)
                (equal vals (cons v vs)))
           (eval-tapp-list-ll-reaches-p nfs tv vals genv))
  :use ((:instance eval-tapp-list-of-cons-at-sum (fs nfs))
        (:instance eval-tapp-list-ll-reaches-p-suff
                   (new-funvals nfs) (tval tv) (val vals)
                   (limit2 (+ 1 l1 l2)) (w (cons w1 ws2))))
  :expand ((:free (a b c d e f)
                  (expr-value-list-ll-related-p (cons a b) (cons c d) (cons e f)
                                                genv)))
  :disable (eval-tapp eval-tapp-list eval-tapp-list-ll-reaches-p
            eval-tapp-list-ll-reaches-p-suff expr-value-ll-related-p)
  :enable (not-reserrp-when-expr-value-listp expr-valuep-when-result-not-error
           expr-value-listp-when-result-not-error))

(defruled eval-tapp-list-ll-reaches-p-of-cons-step
  (implies (and (consp nfs)
                (eval-tapp-ll-ok f tv l)
                (eval-tapp-list-ll-ok fs tv l)
                (not (reserrp (eval-tapp f tv l)))
                (not (reserrp (eval-tapp-list fs tv l)))
                (expr-value-ll-related-p (car nfs) f w1 g)
                (expr-value-list-ll-related-p (cdr nfs) fs ws1 g)
                (expr-value-wfp f)
                (expr-value-wfp (car nfs))
                (expr-value-list-wfp fs)
                (expr-value-list-wfp (cdr nfs)))
           (eval-tapp-list-ll-reaches-p
            nfs tv (cons (eval-tapp f tv l) (eval-tapp-list fs tv l)) g))
  :use ((:instance eval-tapp-ll-ok-necc
                   (funval f) (tval tv) (limit l)
                   (new-funval (car nfs)) (w w1) (genv g))
        (:instance eval-tapp-list-ll-ok-necc
                   (funvals fs) (tval tv) (limit l)
                   (new-funvals (cdr nfs)) (ws ws1) (genv g))
        (:instance eval-tapp-ll-reaches-p-elim
                   (new-funval (car nfs)) (tval tv)
                   (val (eval-tapp f tv l)) (genv g))
        (:instance eval-tapp-list-ll-reaches-p-elim
                   (new-funvals (cdr nfs)) (tval tv)
                   (vals (eval-tapp-list fs tv l)) (genv g))
        (:instance eval-tapp-list-ll-reaches-p-of-cons-generic
                   (l1 (mv-nth 0 (eval-tapp-ll-reaches-p-witness
                                  (car nfs) tv (eval-tapp f tv l) g)))
                   (l2 (mv-nth 0 (eval-tapp-list-ll-reaches-p-witness
                                  (cdr nfs) tv (eval-tapp-list fs tv l) g)))
                   (v (eval-tapp f tv l)) (vs (eval-tapp-list fs tv l))
                   (w1 (mv-nth 1 (eval-tapp-ll-reaches-p-witness
                                  (car nfs) tv (eval-tapp f tv l) g)))
                   (ws2 (mv-nth 1 (eval-tapp-list-ll-reaches-p-witness
                                   (cdr nfs) tv (eval-tapp-list fs tv l) g)))
                   (vals (cons (eval-tapp f tv l) (eval-tapp-list fs tv l)))
                   (genv g)))
  :in-theory (theory 'minimal-theory))

(defruled eval-tapp-list-ll-ok-when-ok
  (implies (implies (consp funvals)
                    (and (eval-tapp-ll-ok (car funvals) tval (1- limit))
                         (eval-tapp-list-ll-ok (cdr funvals) tval (1- limit))))
           (eval-tapp-list-ll-ok funvals tval limit))
  :cases ((consp funvals))
  :hints (("Subgoal 2"
           :use ((:instance eval-tapp-list-when-ok-local (fs funvals) (tv tval)
                            (l limit))
                 (:instance eval-tapp-list-when-ok-local (fs (%tlnf)) (tv tval)
                            (l limit))
                 (:instance eval-tapp-list-ll-reaches-p-suff
                            (new-funvals (%tlnf)) (limit2 limit) (w nil)
                            (val (eval-tapp-list funvals tval limit))
                            (genv (%tlg))))
           :expand ((eval-tapp-list-ll-ok funvals tval limit)
                    (expr-value-list-ll-related-p (%tlnf) funvals (%tlws)
                                                  (%tlg))
                    (eval-tapp-list (%tlnf) tval limit)
                    (expr-value-list-ll-related-p nil nil nil (%tlg))))
          ("Subgoal 1"
           :use ((:instance eval-tapp-list-when-ok-local (fs funvals) (tv tval)
                            (l limit))
                 (:instance eval-tapp-list-ll-reaches-p-of-cons-step
                            (f (car funvals)) (fs (cdr funvals)) (tv tval)
                            (l (1- limit)) (nfs (%tlnf))
                            (w1 (car (%tlws))) (ws1 (cdr (%tlws)))
                            (g (%tlg))))
           :expand ((eval-tapp-list-ll-ok funvals tval limit)
                    (expr-value-list-ll-related-p (%tlnf) funvals (%tlws)
                                                  (%tlg)))))
  :disable (eval-tapp eval-tapp-list eval-tapp-ll-ok eval-tapp-list-ll-ok
            eval-tapp-ll-ok-necc eval-tapp-list-ll-ok-necc
            eval-tapp-ll-reaches-p eval-tapp-list-ll-reaches-p
            eval-tapp-list-ll-reaches-p-suff expr-value-ll-related-p))

(defmacro %ilbody () '(expr-value-ilambda->body funval))

(defmacro %ilenv ()
          '(expr-denv-add-ispace (expr-value-ilambda->param funval) ival
                                         (expr-value-ilambda->denv funval)))

(defmacro %nilenv ()
          '(expr-denv-add-ispace (expr-value-ilambda->param funval) ival
                                          (expr-value-ilambda->denv
                                           new-funval)))

(defruled eval-iapp-when-ilambda-local
  (implies (and (equal (expr-value-kind f) :ilambda)
                (not (reserrp (eval-iapp f iv l))))
           (and (posp l)
                (ispace-values-match-ispace-vars-p (list iv)
                                               (list
                                                (expr-value-ilambda->param f)))
                (equal (eval-iapp f iv l)
                       (eval-expr (expr-value-ilambda->body f)
                                  (expr-denv-add-ispace
                                   (expr-value-ilambda->param f)
                                                      iv
                                                      (expr-value-ilambda->denv
                                                       f))
                                  (1- l)))))
  :expand ((eval-iapp f iv l)))

(defruled eval-iapp-of-ilambda-at-succ
  (implies (and (equal (expr-value-kind f) :ilambda)
                (ispace-values-match-ispace-vars-p (list iv)
                                               (list
                                                (expr-value-ilambda->param f)))
                (natp l))
           (equal (eval-iapp f iv (+ 1 l))
                  (eval-expr (expr-value-ilambda->body f)
                             (expr-denv-add-ispace (expr-value-ilambda->param f)
                                                 iv
                                                 (expr-value-ilambda->denv f))
                             l)))
  :expand ((eval-iapp f iv (+ 1 l))))

(defruled eval-iapp-ll-reaches-p-when-ilambda
  (implies (and (equal (expr-value-kind funval) :ilambda)
                (not (reserrp (eval-iapp funval ival limit)))
                (eval-expr-ll-ok (%ilbody) (%ilenv) (1- limit))
                (expr-value-ll-related-p new-funval funval w genv)
                (expr-value-wfp funval)
                (expr-value-wfp new-funval))
           (eval-iapp-ll-reaches-p new-funval ival
                                   (eval-iapp funval ival limit) genv))
  :use ((:instance eval-iapp-when-ilambda-local (f funval) (iv ival) (l limit))
        (:instance ilambda-related-unpack (nf new-funval) (f funval))
        (:instance ilambda-body-env-related (nf new-funval) (f funval)
                   (p (expr-value-ilambda->param funval)) (iv ival))
        (:instance eval-expr-ll-ok-necc
                   (expr (%ilbody)) (denv (%ilenv)) (limit (1- limit))
                   (ctx (%tlctx)) (new-denv (%nilenv)) (dw (%tldw)))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (ll-context-new-expr (%ilbody) (%tlctx)))
                   (new-denv (%nilenv))
                   (val (eval-iapp funval ival limit)))
        (:instance eval-iapp-of-ilambda-at-succ
                   (f new-funval) (iv ival)
                   (l (mv-nth 0 (eval-expr-ll-reaches-p-witness
                                 (ll-context-new-expr (%ilbody) (%tlctx))
                                 (%nilenv) (eval-iapp funval ival
                                                      limit) genv))))
        (:instance posp-limit-when-eval-expr-ok
                   (expr (ll-context-new-expr (%ilbody) (%tlctx)))
                   (denv (%nilenv))
                   (limit (mv-nth 0 (eval-expr-ll-reaches-p-witness
                                     (ll-context-new-expr (%ilbody) (%tlctx))
                                     (%nilenv) (eval-iapp funval ival limit)
                                     genv))))
        (:instance eval-iapp-ll-reaches-p-suff
                   (limit2 (+ 1 (mv-nth 0 (eval-expr-ll-reaches-p-witness
                                           (ll-context-new-expr (%ilbody)
                                                                (%tlctx))
                                           (%nilenv) (eval-iapp funval ival
                                                                limit)
                                           genv))))
                   (w (mv-nth 1 (eval-expr-ll-reaches-p-witness
                                 (ll-context-new-expr (%ilbody) (%tlctx))
                                 (%nilenv) (eval-iapp funval ival limit) genv)))
                   (val (eval-iapp funval ival limit))))
  :disable (eval-iapp eval-expr ll-context-ok-p expr-denv-ll-related-p
            expr-value-ll-related-p eval-expr-ll-ok eval-expr-ll-ok-necc
            eval-iapp-ll-reaches-p eval-iapp-ll-reaches-p-suff
            eval-expr-ll-reaches-p))

; EVAL-IAPP of a primitive operation or empty vector: the lifted value is
; applied alike.

(defruled eval-iapp-of-related-primop
  (implies (and (equal (expr-value-kind funval) :primop)
                (not (reserrp (eval-iapp funval ival limit)))
                (expr-value-ll-related-p new-funval funval w genv))
           (equal (eval-iapp new-funval ival limit)
                  (eval-iapp funval ival limit)))
  :cases ((equal (ll-value-witness-kind w) :ground))
  :hints (("Subgoal 1"
           :use ((:instance groundp-when-related-via-ground
                            (nf new-funval) (f funval))
                 (:instance eval-iapp-of-expr-value-fix-funval
                            (funval new-funval))
                 (:instance eval-iapp-of-expr-value-fix-funval))
           :in-theory (disable eval-iapp-of-expr-value-fix-funval
                               eval-iapp-expr-value-equiv-congruence-on-funval))
          ("Subgoal 2"
           :use ((:instance primop-related-unpack (nf new-funval) (f funval))
                 (:instance primop-ifun-when-related
                            (new-op (expr-value-primop->val new-funval))
                            (op (expr-value-primop->val funval))
                            (ws (ll-value-witness-primop->ws w))))
           :expand ((eval-iapp new-funval ival limit)
                    (eval-iapp funval ival limit)))))

(defruled eval-iapp-of-related-vector-empty
  (implies (and (equal (expr-value-kind funval) :vector-empty)
                (expr-value-ll-related-p new-funval funval w genv))
           (equal (eval-iapp new-funval ival limit)
                  (eval-iapp funval ival limit)))
  :use ((:instance vector-empty-related-unpack (nf new-funval) (f funval))
        (:instance eval-iapp-of-expr-value-fix-funval (funval new-funval))
        (:instance eval-iapp-of-expr-value-fix-funval))
  :in-theory (disable eval-iapp-of-expr-value-fix-funval
                      eval-iapp-expr-value-equiv-congruence-on-funval))

(defun ll-iapp-same-witness (funval ival)
  (if (equal (expr-value-kind funval) :primop)
      (ll-ifun-witness (expr-value-primop->val funval) ival)
    (ll-value-witness-vector nil)))

(defruled eval-iapp-result-related-when-primop-or-empty
  (implies (and (member-equal (expr-value-kind funval) '(:primop :vector-empty))
                (not (reserrp (eval-iapp funval ival limit))))
           (expr-value-ll-related-p (eval-iapp funval ival limit)
                                    (eval-iapp funval ival limit)
                                    (ll-iapp-same-witness funval ival) genv))
  :cases ((equal (expr-value-kind funval) :primop))
  :hints (("Subgoal 1"
           :use ((:instance primop-ifun-result-related
                            (op (expr-value-primop->val funval))))
           :expand ((eval-iapp funval ival limit)))
          ("Subgoal 2"
           :expand ((eval-iapp funval ival limit))
           :in-theory (enable expr-value-ll-related-p-of-vector-empty))))

(defruled eval-iapp-ll-reaches-p-when-primop-or-empty
  (implies (and (member-equal (expr-value-kind funval) '(:primop :vector-empty))
                (not (reserrp (eval-iapp funval ival limit)))
                (expr-value-ll-related-p new-funval funval w genv))
           (eval-iapp-ll-reaches-p new-funval ival
                                   (eval-iapp funval ival limit) genv))
  :use (eval-iapp-of-related-primop eval-iapp-of-related-vector-empty
        eval-iapp-result-related-when-primop-or-empty
        (:instance eval-iapp-ll-reaches-p-suff
                   (limit2 limit) (w (ll-iapp-same-witness funval ival))
                   (val (eval-iapp funval ival limit))))
  :disable (eval-iapp eval-iapp-ll-reaches-p eval-iapp-ll-reaches-p-suff
            ll-iapp-same-witness))

; EVAL-IAPP of a vector: the elements are applied by EVAL-IAPP-LIST.

(defmacro %ivels () '(expr-value-vector->elems funval))

(defmacro %nivels () '(expr-value-vector->elems new-funval))

(defmacro %ivws ()
  '(if (equal (ll-value-witness-kind w) :ground)
       (ll-ground-ws (expr-value-vector->elems funval))
     (ll-value-witness-vector->elems w)))

(defmacro %ivlw ()
  '(eval-iapp-list-ll-reaches-p-witness (%nivels) ival
                                        (eval-iapp-list (%ivels) ival
                                                        (1- limit))
                                        genv))

(defruled eval-iapp-when-vector-local
  (implies (and (equal (expr-value-kind f) :vector)
                (not (reserrp (eval-iapp f iv l))))
           (and (posp l)
                (not (reserrp (eval-iapp-list (expr-value-vector->elems f) iv
                                              (1- l))))
                (consp (eval-iapp-list (expr-value-vector->elems f) iv (1- l)))
                (list-repeatp (dims-of-expr-value-list
                               (eval-iapp-list (expr-value-vector->elems f) iv
                                               (1- l))))
                (equal (eval-iapp f iv l)
                       (expr-value-vector
                        (eval-iapp-list (expr-value-vector->elems f) iv
                                        (1- l))))))
  :expand ((eval-iapp f iv l)))

(defruled eval-iapp-of-vector-at-succ
  (implies (and (equal (expr-value-kind f) :vector)
                (natp l)
                (not
                 (reserrp (eval-iapp-list (expr-value-vector->elems f) iv l)))
                (consp (eval-iapp-list (expr-value-vector->elems f) iv l))
                (list-repeatp (dims-of-expr-value-list
                               (eval-iapp-list (expr-value-vector->elems f) iv
                                               l))))
           (equal (eval-iapp f iv (+ 1 l))
                  (expr-value-vector
                   (eval-iapp-list (expr-value-vector->elems f) iv l))))
  :expand ((eval-iapp f iv (+ 1 l))))

(defruled eval-iapp-list-ll-reaches-p-elim
  (implies (eval-iapp-list-ll-reaches-p new-funvals ival vals genv)
           (b* (((mv l ws)
                 (eval-iapp-list-ll-reaches-p-witness new-funvals ival vals
                                                      genv))
                (nvs (eval-iapp-list new-funvals ival l)))
             (and (not (reserrp nvs))
                  (expr-value-list-ll-related-p nvs vals ws genv))))
  :enable eval-iapp-list-ll-reaches-p)

(defruled posp-limit-when-eval-iapp-list-ok
  (implies (not (reserrp (eval-iapp-list funvals ival limit)))
           (posp limit))
  :expand ((eval-iapp-list funvals ival limit)))

(defruled eval-iapp-ll-reaches-p-of-vector-generic
  (implies (and (equal (expr-value-kind nf) :vector)
                (natp l)
                (not
                 (reserrp (eval-iapp-list (expr-value-vector->elems nf) iv l)))
                (expr-value-list-ll-related-p
                 (eval-iapp-list (expr-value-vector->elems nf) iv l) vs ws genv)
                (consp vs)
                (list-repeatp (dims-of-expr-value-list vs))
                (expr-value-list-wfp vs)
