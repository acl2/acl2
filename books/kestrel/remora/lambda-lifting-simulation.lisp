; The hoisted variable is not free in what remains of the :LET, rebuilt:
; its uses are replaced, and the replacements do not refer to it.

(defruled subset-of-delete-when-not-in-local
  (implies (and (set::subset a u) (not (set::in v a)))
           (set::subset a (set::delete v u)))
  :enable (set::pick-a-point-subset-strategy set::subset-in))

(defruled not-in-map-free-vars-when-binder
  (implies (and (lmap-replacements-ok-p lmap locals pnames genv)
                (string-expr-mapp lmap)
                (string-setp locals)
                (string-listp pnames)
                (member-equal v0 pnames))
           (not (set::in v0 (string-expr-map-free-expr-vars lmap))))
  :use ((:instance
         subset-of-string-expr-map-free-expr-vars-when-values-free-within
                   (m lmap)
                   (s (set::delete v0 (string-expr-map-free-expr-vars lmap))))
        (:instance expr-free-expr-vars-of-assoc-subset
                   (m lmap)
                   (k (map-values-free-within-witness
                       lmap (set::delete v0 (string-expr-map-free-expr-vars
                                             lmap)))))
        (:instance not-in-replacement-free-vars-when-binder
                   (v (map-values-free-within-witness
                       lmap (set::delete v0 (string-expr-map-free-expr-vars
                                             lmap)))))
        (:instance set::subset-in (a v0)
                   (x (string-expr-map-free-expr-vars lmap))
                   (y (set::delete v0 (string-expr-map-free-expr-vars lmap)))))
  :expand ((map-values-free-within
            lmap (set::delete v0 (string-expr-map-free-expr-vars lmap))))
  :enable (subset-of-delete-when-not-in-local)
  :disable (lmap-replacements-ok-p set::subset-in))

(defrule in-to-member-local
  (implies (set::setp x)
           (iff (set::in a x) (member-equal a x)))
  :rule-classes nil
  :enable (set::in-to-member))

(defruled hoisted-ctx2-facts
  (implies (%hstep-hyps)
           (and (equal (ll-context->lmap (%ctx2))
