(defruled eval-atom-ll-reaches-p-when-lambda
  (b* ((atom (make-atom-lambda/lambdan pa ba ta))
       (x (expr-array nil (list atom))))
    (implies (and (var+type?-listp pa)
                  (consp pa)
                  (exprp ba)
                  (type-optionp ta)
                  (not (reserrp (eval-atom atom denv limit)))
                  (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                  (ll-context-ok-p x ctx genv))
             (eval-atom-ll-reaches-p (ll-context-new-atom atom ctx)
                                     new-denv
                                     (eval-atom atom denv limit)
                                     genv)))
  :use ((:instance atomlam-new-closure-ok
                   (x (expr-array nil
                                  (list (make-atom-lambda/lambdan pa ba ta)))))
        atomlam-shape-of-singleton-array
        eval-atom-of-lambda/lambdan-when-ok
        ll-atom-of-make-atom-lambda/lambdan
        (:instance expr-value-ll-related-p-of-atomlam-closure-at
                   (x (expr-array nil
                                  (list (make-atom-lambda/lambdan pa ba ta)))))
        (:instance eval-atom-of-lambda/lambdan
                   (params pa) (body (%anb)) (type? ta) (denv new-denv)
                   (limit 1))
        (:instance eval-atom-ll-reaches-p-suff
                   (new-atom (ll-context-new-atom
                              (make-atom-lambda/lambdan pa ba ta) ctx))
                   (limit2 1)
                   (w (ll-value-witness-lambda (%actx) (cdr pa) nil dw))
                   (val (eval-atom (make-atom-lambda/lambdan pa ba ta)
                                   denv limit))))
  :in-theory (disable ll-lambda-parts ll-expr ll-atom lambda-closure
                      eval-expr eval-atom expr-value-ll-related-p
                      expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-lifted ll-context-new-atom
                      eval-atom-ll-reaches-p eval-atom-ll-reaches-p-suff
                      make-atom-lambda/lambdan))


; Restricting both environments of the relation to what an expression with
; fewer free variables (and whose lifted form has fewer) refers to keeps
; the relation, at that expression, in the same context.

(defmacro %rnew () '(expr-denv-restrict nivars ntvars nevars new-denv))

(defruled lookup-in-restricted-new
  (implies (and (stringp n)
                (set::in n nevars)
                (string-setp nevars))
           (equal (expr-denv-lookup-expr n (%rnew))
                  (expr-denv-lookup-expr n new-denv)))
  :enable (expr-denv-lookup-expr-of-expr-denv-restrict))

(defruled ll-var-referred-ok-p-of-restrict-plain
  (implies (and (stringp v)
                (not (omap::assoc v (ll-context->lmap ctx)))
                (ll-var-referred-ok-p v val new-denv nfv ctx dw genv)
                (set::subset nfv2 nfv)
                (set::subset nfv2 nevars)
                (string-setp nevars))
           (ll-var-referred-ok-p v val (%rnew) nfv2 ctx dw genv))
  :use ((:instance lookup-in-restricted-new (n v))
        (:instance set::subset-in (a v) (x nfv2) (y nfv))
        (:instance set::subset-in (a v) (x nfv2) (y nevars)))
  :enable (ll-var-referred-ok-p))

(defruled lookups-agree-p-of-restricted-new
  (implies (and (string-listp hns)
                (set::subset (set::mergesort hns) nevars)
                (string-setp nevars))
           (lookups-agree-p hns (%rnew) new-denv))
  :induct (len hns)
  :enable (lookups-agree-p len set::subset-in)
  :expand ((set::mergesort hns))
  :hints (("Subgoal *1/1"
           :use ((:instance lookup-in-restricted-new (n (car hns)))))))

(in-theory (enable intersectp-equal-of-nil-right))

(defruled ll-var-referred-ok-p-of-restrict-hoisted
  (implies (and (stringp v)
                (equal (cdr (omap::assoc v (ll-context->lmap ctx)))
                       (apply-to-names (expr-var h) hns))
                (omap::assoc v (ll-context->lmap ctx))
                (stringp h)
                (string-listp hns)
                (not (set::in h (ll-context->locals ctx)))
                (not (reserrp (expr-denv-lookup-expr h genv)))
                (subsetp-equal hns (ll-context->locals ctx))
                (ll-var-referred-ok-p v val new-denv nfv ctx dw genv)
                (string-setp nfv2)
                (set::subset nfv2 nfv)
                (set::subset nfv2 nevars)
                (string-setp nevars))
           (ll-var-referred-ok-p v val (%rnew) nfv2 ctx dw genv))
  :use ((:instance kept-replacement-sets
                   (pnames nil)
                   (locals (ll-context->locals ctx))
                   (nbfv nfv2))
        (:instance lookups-agree-p-of-restricted-new)
        (:instance lookups-agree-p-of-with-names-from-insert
                   (d1 (%rnew)) (d2 new-denv) (g genv))
        (:instance eval-expr-of-apply-to-names-when-agree
                   (names hns)
                   (d1 (expr-denv-with-names-from (set::insert h nil)
                                                  (%rnew) genv))
                   (d2 (expr-denv-with-names-from (set::insert h nil)
                                                  new-denv genv))
                   (l (ll-denv-witness->limit dw)))
        (:instance lookup-of-expr-denv-with-names-from
                   (n h) (names (set::insert h nil)) (d (%rnew)) (g genv))
        (:instance lookup-of-expr-denv-with-names-from
                   (n h) (names (set::insert h nil)) (d new-denv) (g genv))
        (:instance in-when-member-of-subsetp
                   (e h) (l hns) (s (ll-context->locals ctx)))
        (:instance set::subset-transitive
                   (x (set::intersect
                       (expr-free-expr-vars (apply-to-names (expr-var h) hns))
                       (ll-context->locals ctx)))
                   (y nfv2) (z nfv))
        (:instance set::subset-transitive
                   (x (set::mergesort hns)) (y nfv2) (z nevars)))
  :enable (ll-var-referred-ok-p)
  :expand ((:free (n) (expr-free-expr-vars (expr-var n))))
  :disable (set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv
            apply-to-names))

(defruled ll-var-ok-p-of-restrict
  (implies (and (stringp v)
                (expr-valuep val)
                (ll-var-ok-p v val new-denv nfv ctx dw genv)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        pnames genv)
                (string-listp pnames)
                (string-setp nfv2)
                (set::subset nfv2 nfv)
                (set::subset nfv2 nevars)
                (string-setp nevars))
           (ll-var-ok-p v val (%rnew) nfv2 ctx dw genv))
  :use ((:instance ll-var-ok-p-split (var v))
        (:instance ll-var-ok-p-split
                   (var v) (new-denv (%rnew)) (nfv nfv2))
        ll-var-referred-ok-p-of-restrict-plain
        (:instance ll-var-referred-ok-p-of-restrict-hoisted
                   (h (mv-nth 1 (replacement-parts
                                 (cdr (omap::assoc v (ll-context->lmap ctx))))))
                   (hns (mv-nth 2 (replacement-parts
                                   (cdr (omap::assoc v
                                                     (ll-context->lmap
                                                      ctx)))))))
        (:instance ll-replacement-ok-p-unpack
                   (repl (cdr (omap::assoc v (ll-context->lmap ctx))))
                   (locals (ll-context->locals ctx)))
        (:instance ll-replacement-ok-p-when-lmap-replacements-ok-p
                   (lmap (ll-context->lmap ctx)) (k v)
                   (locals (ll-context->locals ctx))))
  :disable (ll-var-referred-ok-p ll-var-ok-p ll-var-types-ok-p))

(defmacro %rold () '(expr-denv-restrict oivars otvars oevars denv))

(defmacro %restrict-walker-hyps ()
  '(and (string-expr-value-map-ll-related-p
         new-denv (expr-denv->exprs denv) fv nfv ctx dw genv)
        (lmap-replacements-ok-p (ll-context->lmap ctx)
                                (ll-context->locals ctx)
                                pnames genv)
        (string-listp pnames)
        (string-setp nfv2)
        (set::subset nfv2 nfv)
        (set::subset nfv2 nevars)
        (string-setp nevars)
        (set::subset fv2 fv)))

(defruled walker-of-restrict-at
  (implies (and (%restrict-walker-hyps)
                (omap::assoc w (expr-denv->exprs (%rold)))
                (set::in w fv2))
           (ll-var-ok-p w (cdr (omap::assoc w (expr-denv->exprs (%rold))))
                        (%rnew) nfv2 ctx dw genv))
  :use ((:instance walker-ll-var-ok-p-at
                   (map (expr-denv->exprs denv)) (var w))
        (:instance ll-var-ok-p-of-restrict
                   (v w) (val (cdr (omap::assoc w (expr-denv->exprs denv)))))
        (:instance stringp-when-assoc-of-string-expr-value-mapp
                   (m (expr-denv->exprs denv)) (k w))
        (:instance set::subset-in (a w) (x fv2) (y fv)))
  :enable (omap::assoc-of-restrict expr-denv-restrict)
  :disable (ll-var-ok-p ll-var-ok-p-of-restrict))

(defruled walker-of-restrict
  (implies (%restrict-walker-hyps)
           (string-expr-value-map-ll-related-p
            (%rnew) (expr-denv->exprs (%rold)) fv2 nfv2 ctx dw genv))
  :use ((:instance string-expr-value-map-ll-related-p-when-pointwise
                   (new-denv (%rnew)) (map (expr-denv->exprs (%rold)))
                   (fv fv2) (nfv nfv2))
        (:instance walker-of-restrict-at
                   (w (walker-pointwise-p-witness
                       (%rnew) (expr-denv->exprs (%rold)) fv2 nfv2
                       ctx dw genv))))
  :expand ((walker-pointwise-p (%rnew) (expr-denv->exprs (%rold)) fv2 nfv2
                               ctx dw genv))
  :disable (ll-var-ok-p walker-pointwise-p-necc))

(defruled names-bound-as-in-p-of-restrict
  (implies (and (string-setp s)
                (set::subset s nevars)
                (string-setp nevars)
                (names-bound-as-in-p s new-denv genv))
           (names-bound-as-in-p s (%rnew) genv))
  :induct (set-ind s)
  :enable (names-bound-as-in-p subset-of-tail-when-subset)
  :hints (("Subgoal *1/2"
           :use ((:instance set::subset-in (a (set::head s)) (x s) (y nevars))
                 (:instance lookup-in-restricted-new (n (set::head s)))))))

(defruled new-values-meet-types-p-of-restrict
  (implies (and (string-setp s)
                (set::subset s nevars)
                (string-setp nevars)
                (new-values-meet-types-p s new-denv tenv))
           (new-values-meet-types-p s (%rnew) tenv))
  :induct (set-ind s)
  :enable (new-values-meet-types-p subset-of-tail-when-subset)
  :hints (("Subgoal *1/2"
           :use ((:instance set::subset-in (a (set::head s)) (x s) (y nevars))
                 (:instance lookup-in-restricted-new (n (set::head s))))
           :in-theory (disable value-meets-required-type-p))))

(defruled expr-denv-ll-related-p-of-restrict
  (implies (and (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (set::subset (expr-free-expr-vars y) (expr-free-expr-vars x))
                (set::subset (expr-free-expr-vars (ll-context-new-expr y ctx))
                             (expr-free-expr-vars (ll-context-new-expr x ctx)))
                (set::subset (expr-free-expr-vars (ll-context-new-expr y ctx))
                             nevars)
                (string-setp nevars)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        pnames genv)
                (string-listp pnames)
                (equal (expr-denv->tenv (%rnew)) (expr-denv->tenv (%rold))))
           (expr-denv-ll-related-p (%rnew) (%rold) y ctx nil dw genv))
  :use ((:instance walker-of-restrict
                   (fv (expr-free-expr-vars x))
                   (nfv (expr-free-expr-vars (ll-context-new-expr x ctx)))
                   (fv2 (expr-free-expr-vars y))
                   (nfv2 (expr-free-expr-vars (ll-context-new-expr y ctx))))
        (:instance names-bound-as-in-p-of-restrict
                   (s (set::difference
                       (expr-free-expr-vars (ll-context-new-expr y ctx))
                       (ll-context->locals ctx))))
        (:instance subset-of-difference-and-intersect-when-subset
                   (a (expr-free-expr-vars (ll-context-new-expr y ctx)))
                   (b nevars) (c (ll-context->locals ctx)))
        (:instance subset-of-difference-when-subset
                   (a (expr-free-expr-vars (ll-context-new-expr y ctx)))
                   (b (expr-free-expr-vars (ll-context-new-expr x ctx)))
                   (c (ll-context->locals ctx)))
        (:instance subset-of-intersect-when-subset
                   (a (expr-free-expr-vars (ll-context-new-expr y ctx)))
                   (b (expr-free-expr-vars (ll-context-new-expr x ctx)))
                   (c (ll-context->locals ctx)))
        (:instance names-bound-as-in-p-when-subset
                   (names (set::difference
                           (expr-free-expr-vars (ll-context-new-expr x ctx))
                           (ll-context->locals ctx)))
                   (names2 (set::difference
                            (expr-free-expr-vars (ll-context-new-expr y ctx))
                            (ll-context->locals ctx))))
        (:instance new-values-meet-types-p-of-restrict
                   (s (set::intersect
                       (expr-free-expr-vars (ll-context-new-expr y ctx))
                       (ll-context->locals ctx)))
                   (tenv (ll-context->tenv ctx)))
        (:instance new-values-meet-types-p-when-subset
                   (names (set::intersect
                           (expr-free-expr-vars (ll-context-new-expr x ctx))
                           (ll-context->locals ctx)))
                   (names2 (set::intersect
                            (expr-free-expr-vars (ll-context-new-expr y ctx))
                            (ll-context->locals ctx)))
                   (tenv (ll-context->tenv ctx))))
  :expand ((expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
           (expr-denv-ll-related-p (%rnew) (%rold) y ctx nil dw genv))
  :enable (difference-of-nil-when-setp)
  :disable (names-bound-as-in-p-when-subset new-values-meet-types-p-when-subset
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

; The context invariant at an expression gives it at one whose binders are
; a suffix of the expression's, with the same lifted definitions.

(defruled ll-context-ok-p-of-binder-suffix
  (implies (and (ll-context-ok-p x ctx genv)
                (equal (expr-binder-names x)
                       (append pre (expr-binder-names y)))
                (equal (ll-context-lifted y ctx) (ll-context-lifted x ctx)))
           (ll-context-ok-p y ctx genv))
  :use ((:instance not-intersectp-when-subsetp-local
                   (bx (expr-binder-names x)) (l (ll-context->locals ctx)) (bi
                                                                            (expr-binder-names y)))
        (:instance lmap-replacements-ok-p-when-fewer-pnames
                   (lmap (ll-context->lmap ctx))
                   (locals (ll-context->locals ctx))
                   (pnames (expr-binder-names x))
                   (pnames2 (expr-binder-names y))))
  :enable (ll-context-ok-p)
  :disable (lmap-replacements-ok-p))

; Type and ispace lambda values over related environments, with bodies
; related by lifting in the same context.

(defruled expr-value-ll-related-p-of-tlambda/ilambda-values
  (implies (and (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (ll-context-ok-p x ctx genv)
                (ll-context-ok-p vb ctx genv)
                (exprp vb)
                (ll-context-p ctx)
                (set::subset (expr-free-expr-vars vb) (expr-free-expr-vars x))
                (set::subset (expr-free-expr-vars (ll-context-new-expr vb ctx))
                             (expr-free-expr-vars (ll-context-new-expr x ctx)))
                (set::subset (expr-free-expr-vars (ll-context-new-expr vb ctx))
                             nevars)
                (string-setp nevars)
                (equal (expr-denv->tenv (%rnew)) (expr-denv->tenv (%rold))))
           (and (expr-value-ll-related-p
                 (make-expr-value-tlambda :param p
                                          :body (ll-context-new-expr vb ctx)
                                          :denv (%rnew))
                 (make-expr-value-tlambda :param p :body vb :denv (%rold))
                 (ll-value-witness-tlambda ctx dw)
                 genv)
                (expr-value-ll-related-p
                 (make-expr-value-ilambda :param q
                                          :body (ll-context-new-expr vb ctx)
                                          :denv (%rnew))
                 (make-expr-value-ilambda :param q :body vb :denv (%rold))
                 (ll-value-witness-tlambda ctx dw)
                 genv)))
  :use ((:instance expr-denv-ll-related-p-of-restrict
                   (y vb)
                   (pnames (expr-binder-names x)))
        (:instance expr-denv-ll-related-p-of-ll-denv-witness-fix
                   (new-denv (%rnew)) (denv (%rold)) (x vb) (excl nil)))
  :expand ((:free (nv v w)
                  (expr-value-ll-related-p nv v w genv)))
  :enable (ll-context-ok-p)
  :disable (expr-denv-ll-related-p lmap-replacements-ok-p
            ll-context-new-expr expr-denv-restrict))

(defrule ll-context-new-expr-of-ll-context-fix
  (equal (ll-context-new-expr x (ll-context-fix ctx))
         (ll-context-new-expr x ctx))
  :enable ll-context-new-expr)

(defrule ll-context-lifted-of-ll-context-fix
  (equal (ll-context-lifted x (ll-context-fix ctx))
         (ll-context-lifted x ctx))
  :enable ll-context-lifted)

(defrule ll-context-ok-p-of-ll-context-fix
  (equal (ll-context-ok-p x (ll-context-fix ctx) genv)
         (ll-context-ok-p x ctx genv))
  :enable ll-context-ok-p)

(defrule expr-denv-ll-related-p-of-ll-context-fix
  (equal (expr-denv-ll-related-p new-denv denv x (ll-context-fix ctx)
                                 excl dw genv)
         (expr-denv-ll-related-p new-denv denv x ctx excl dw genv))
  :use ((:instance string-expr-value-map-ll-related-p-of-same-fields
                   (map (expr-denv->exprs denv))
                   (ctx2 (ll-context-fix ctx))
                   (fv (set::difference (expr-free-expr-vars x)
                                        (set::mergesort
                                         (str::string-list-fix excl))))
                   (nfv (expr-free-expr-vars (ll-context-new-expr x ctx)))))
  :expand ((:free (ctx) (expr-denv-ll-related-p new-denv denv x ctx
                                                excl dw genv))))

(defruled lmap-closed-p-when-ll-context-ok-p
  (implies (ll-context-ok-p x ctx genv)
           (lmap-closed-p (ll-context->lmap ctx)))
  :use ((:instance lmap-closed-p-when-string-expr-map-closed-p
                   (m (ll-context->lmap ctx))))
  :enable ll-context-ok-p)

(defruled free-type/ispace-vars-of-ll-context-new
  (implies (lmap-closed-p (ll-context->lmap ctx))
           (and (equal (atom-free-type-vars (ll-context-new-atom a ctx))
                       (atom-free-type-vars a))
                (equal (atom-free-ispace-vars (ll-context-new-atom a ctx))
                       (atom-free-ispace-vars a))
                (equal (expr-free-type-vars (ll-context-new-expr x ctx))
                       (expr-free-type-vars x))
                (equal (expr-free-ispace-vars (ll-context-new-expr x ctx))
                       (expr-free-ispace-vars x))))
  :use ((:instance free-type/ispace-vars-of-ll-atom
                   (x a) (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx))
                   (used (ll-context->used ctx)))
        (:instance free-type/ispace-vars-of-ll-expr
                   (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx))
                   (used (ll-context->used ctx))))
  :enable (ll-context-new-atom ll-context-new-expr)
  :disable (ll-atom ll-expr))

(defrule expr-denv->tenv-of-expr-denv-restrict-local
  (equal (expr-denv->tenv (expr-denv-restrict ivars tvars evars d))
         (type-denv-restrict ivars tvars (expr-denv->tenv d)))
  :enable expr-denv-restrict)

(defrule not-reserrp-of-expr-value-tlambda/ilambda
  (and (not (reserrp (expr-value-tlambda p b d)))
       (not (reserrp (expr-value-ilambda q b d))))
  :enable (not-reserrp-when-expr-valuep))

(defruled tlambda-atom-facts
  (implies (and (atomp a)
                (equal (atom-kind a) :tlambda))
           (b* ((b (atom-tlambda->body a))
                (nb (ll-context-new-expr b ctx))
                (a2 (ll-context-new-atom a ctx)))
             (and (equal a2 (atom-tlambda (atom-tlambda->param a) nb))
                  (equal (mv-nth 1 (ll-atom a (ll-context->tenv ctx)
                                            (ll-context->tlets ctx)
                                            (ll-context->locals ctx)
                                            (ll-context->lmap ctx)
                                            (ll-context->used ctx)))
                         (ll-context-lifted b ctx))
                  (equal (atom-free-expr-vars a) (expr-free-expr-vars b))
                  (equal (atom-free-expr-vars a2) (expr-free-expr-vars nb))
                  (equal (atom-binder-names a)
                         (cons (type-var->name (atom-tlambda->param a))
                               (expr-binder-names b)))
                  (implies (not (zp limit))
                           (equal (eval-atom a denv limit)
                                  (make-expr-value-tlambda
                                   :param (atom-tlambda->param a)
                                   :body b
                                   :denv (expr-denv-restrict
                                          (expr-free-ispace-vars b)
                                          (atom-free-type-vars a)
                                          (expr-free-expr-vars b)
                                          denv))))
                  (implies (not (zp limit))
                           (equal (eval-atom a2 new-denv limit)
                                  (make-expr-value-tlambda
                                   :param (atom-tlambda->param a)
                                   :body nb
                                   :denv (expr-denv-restrict
                                          (expr-free-ispace-vars nb)
                                          (atom-free-type-vars a2)
                                          (expr-free-expr-vars nb)
                                          new-denv))))
                  (implies (zp limit)
                           (reserrp (eval-atom a denv limit))))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-atom a tenv tlets locals lmap used))
           (:free (d l) (eval-atom a d l))
           (:free (p b d l) (eval-atom (atom-tlambda p b) d l))
           (atom-free-expr-vars a)
           (:free (p b) (atom-free-expr-vars (atom-tlambda p b)))
           (atom-binder-names a))
  :enable (ll-context-new-atom ll-context-new-expr ll-context-lifted))

(defruled eval-atom-ll-reaches-p-when-tlambda
  (b* ((x (expr-array nil (list a))))
    (implies (and (atomp a)
                  (equal (atom-kind a) :tlambda)
                  (not (reserrp (eval-atom a denv limit)))
                  (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                  (ll-context-ok-p x ctx genv))
             (eval-atom-ll-reaches-p (ll-context-new-atom a ctx)
                                     new-denv
                                     (eval-atom a denv limit)
                                     genv)))
  :use ((:instance tlambda-atom-facts (limit limit))
        (:instance tlambda-atom-facts (limit 1))
        (:instance ll-expr-of-singleton-array)
        (:instance free-and-binders-of-singleton-array (d nil))
        (:instance free-and-binders-of-singleton-array
                   (d nil) (a (ll-context-new-atom a ctx)))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (x (expr-array nil (list a))) (excl nil))
        (:instance lmap-closed-p-when-ll-context-ok-p
                   (x (expr-array nil (list a))))
        (:instance free-type/ispace-vars-of-ll-context-new
                   (x (atom-tlambda->body a)))
        (:instance ll-context-ok-p-of-binder-suffix
                   (x (expr-array nil (list a)))
                   (y (atom-tlambda->body a))
                   (pre (list (type-var->name (atom-tlambda->param a)))))
        (:instance expr-value-ll-related-p-of-tlambda/ilambda-values
                   (x (expr-array nil (list a)))
                   (vb (atom-tlambda->body a))
                   (p (atom-tlambda->param a))
                   (q nil)
                   (nivars (expr-free-ispace-vars
                            (ll-context-new-expr (atom-tlambda->body a) ctx)))
                   (ntvars (atom-free-type-vars (ll-context-new-atom a ctx)))
                   (nevars (expr-free-expr-vars
                            (ll-context-new-expr (atom-tlambda->body a) ctx)))
                   (oivars (expr-free-ispace-vars (atom-tlambda->body a)))
                   (otvars (atom-free-type-vars a))
                   (oevars (expr-free-expr-vars (atom-tlambda->body a)))
                   (ctx (ll-context-fix ctx)))
        (:instance eval-atom-ll-reaches-p-suff
                   (new-atom (ll-context-new-atom a ctx))
                   (limit2 1)
                   (w (ll-value-witness-tlambda (ll-context-fix ctx) dw))
                   (val (eval-atom a denv limit))))
  :in-theory (e/d (tlambda-atom-facts ll-expr-of-singleton-array
                   free-and-binders-of-singleton-array)
                      (ll-expr ll-atom eval-atom expr-value-ll-related-p
                      expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-lifted ll-context-new-atom
                      eval-atom-ll-reaches-p eval-atom-ll-reaches-p-suff
                      equal-of-expr-array expr-denv-restrict
                      equal-of-expr-value-tlambda equal-of-expr-value-ilambda
                      equal-of-atom-tlambda)))

(defruled ilambda-atom-facts
  (implies (and (atomp a)
                (equal (atom-kind a) :ilambda))
           (b* ((b (atom-ilambda->body a))
                (nb (ll-context-new-expr b ctx))
                (a2 (ll-context-new-atom a ctx)))
             (and (equal a2 (atom-ilambda (atom-ilambda->param a) nb))
                  (equal (mv-nth 1 (ll-atom a (ll-context->tenv ctx)
                                            (ll-context->tlets ctx)
                                            (ll-context->locals ctx)
                                            (ll-context->lmap ctx)
                                            (ll-context->used ctx)))
                         (ll-context-lifted b ctx))
                  (equal (atom-free-expr-vars a) (expr-free-expr-vars b))
                  (equal (atom-free-expr-vars a2) (expr-free-expr-vars nb))
                  (equal (atom-binder-names a)
                         (cons (ispace-var->name (atom-ilambda->param a))
                               (expr-binder-names b)))
                  (implies (not (zp limit))
                           (equal (eval-atom a denv limit)
                                  (make-expr-value-ilambda
                                   :param (atom-ilambda->param a)
                                   :body b
                                   :denv (expr-denv-restrict
                                          (atom-free-ispace-vars a)
                                          (expr-free-type-vars b)
                                          (expr-free-expr-vars b)
                                          denv))))
                  (implies (not (zp limit))
                           (equal (eval-atom a2 new-denv limit)
                                  (make-expr-value-ilambda
                                   :param (atom-ilambda->param a)
                                   :body nb
                                   :denv (expr-denv-restrict
                                          (atom-free-ispace-vars a2)
                                          (expr-free-type-vars nb)
                                          (expr-free-expr-vars nb)
                                          new-denv))))
                  (implies (zp limit)
                           (reserrp (eval-atom a denv limit))))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-atom a tenv tlets locals lmap used))
           (:free (d l) (eval-atom a d l))
           (:free (p b d l) (eval-atom (atom-ilambda p b) d l))
           (atom-free-expr-vars a)
           (:free (p b) (atom-free-expr-vars (atom-ilambda p b)))
           (atom-binder-names a))
  :enable (ll-context-new-atom ll-context-new-expr ll-context-lifted))

(defruled eval-atom-ll-reaches-p-when-ilambda
  (b* ((x (expr-array nil (list a))))
    (implies (and (atomp a)
                  (equal (atom-kind a) :ilambda)
                  (not (reserrp (eval-atom a denv limit)))
                  (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                  (ll-context-ok-p x ctx genv))
             (eval-atom-ll-reaches-p (ll-context-new-atom a ctx)
                                     new-denv
                                     (eval-atom a denv limit)
                                     genv)))
  :use ((:instance ilambda-atom-facts (limit limit))
        (:instance ilambda-atom-facts (limit 1))
        (:instance ll-expr-of-singleton-array)
        (:instance free-and-binders-of-singleton-array (d nil))
        (:instance free-and-binders-of-singleton-array
                   (d nil) (a (ll-context-new-atom a ctx)))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (x (expr-array nil (list a))) (excl nil))
        (:instance lmap-closed-p-when-ll-context-ok-p
                   (x (expr-array nil (list a))))
        (:instance free-type/ispace-vars-of-ll-context-new
                   (x (atom-ilambda->body a)))
        (:instance ll-context-ok-p-of-binder-suffix
                   (x (expr-array nil (list a)))
                   (y (atom-ilambda->body a))
                   (pre (list (ispace-var->name (atom-ilambda->param a)))))
        (:instance expr-value-ll-related-p-of-tlambda/ilambda-values
                   (x (expr-array nil (list a)))
                   (vb (atom-ilambda->body a))
                   (p nil)
                   (q (atom-ilambda->param a))
                   (nivars (atom-free-ispace-vars (ll-context-new-atom a ctx)))
                   (ntvars (expr-free-type-vars
                            (ll-context-new-expr (atom-ilambda->body a) ctx)))
                   (nevars (expr-free-expr-vars
                            (ll-context-new-expr (atom-ilambda->body a) ctx)))
                   (oivars (atom-free-ispace-vars a))
                   (otvars (expr-free-type-vars (atom-ilambda->body a)))
                   (oevars (expr-free-expr-vars (atom-ilambda->body a)))
                   (ctx (ll-context-fix ctx)))
        (:instance eval-atom-ll-reaches-p-suff
                   (new-atom (ll-context-new-atom a ctx))
                   (limit2 1)
                   (w (ll-value-witness-tlambda (ll-context-fix ctx) dw))
                   (val (eval-atom a denv limit))))
  :in-theory (e/d (ilambda-atom-facts ll-expr-of-singleton-array
                   free-and-binders-of-singleton-array)
                      (ll-expr ll-atom eval-atom expr-value-ll-related-p
                      expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-lifted ll-context-new-atom
                      eval-atom-ll-reaches-p eval-atom-ll-reaches-p-suff
                      equal-of-expr-array expr-denv-restrict
                      equal-of-expr-value-tlambda equal-of-expr-value-ilambda
                      equal-of-atom-ilambda)))

; The curried bodies of n-ary type and ispace lambdas are lifted as their
; bodies are.

(defrule len-equal-0-local
  (equal (equal (len x) 0) (not (consp x)))
  :enable len)

(defruled tlambda/ilambda-curried-body-facts
  (implies (exprp b)
           (and (equal (ll-context-new-expr (tlambda-curried-body ps b) ctx)
                       (tlambda-curried-body ps (ll-context-new-expr b ctx)))
                (equal (ll-context-lifted (tlambda-curried-body ps b) ctx)
                       (ll-context-lifted b ctx))
                (equal (expr-free-expr-vars (tlambda-curried-body ps b))
                       (expr-free-expr-vars b))
                (equal (expr-binder-names (tlambda-curried-body ps b))
                       (append (type-var-list->name (cdr ps))
                               (expr-binder-names b)))
                (equal (ll-context-new-expr (ilambda-curried-body qs b) ctx)
                       (ilambda-curried-body qs (ll-context-new-expr b ctx)))
                (equal (ll-context-lifted (ilambda-curried-body qs b) ctx)
                       (ll-context-lifted b ctx))
                (equal (expr-free-expr-vars (ilambda-curried-body qs b))
                       (expr-free-expr-vars b))
                (equal (expr-binder-names (ilambda-curried-body qs b))
                       (append (ispace-var-list->name (cdr qs))
                               (expr-binder-names b)))))
  :cases ((and (consp (cdr ps)) (consp (cdr qs)))
          (and (consp (cdr ps)) (not (consp (cdr qs))))
          (and (not (consp (cdr ps))) (consp (cdr qs))))
  :expand ((:free (a tenv tlets locals lmap used)
                  (ll-expr (expr-atom a) tenv tlets locals lmap used))
           (:free (a tenv tlets locals lmap used)
                  (ll-atom a tenv tlets locals lmap used))
           (:free (a) (expr-free-expr-vars (expr-atom a)))
           (:free (a) (expr-binder-names (expr-atom a)))
           (:free (p b) (atom-free-expr-vars (atom-tlambda p b)))
           (:free (p b) (atom-free-expr-vars (atom-tlambdan p b)))
           (:free (p b) (atom-free-expr-vars (atom-ilambda p b)))
           (:free (p b) (atom-free-expr-vars (atom-ilambdan p b)))
           (:free (p b) (atom-binder-names (atom-tlambda p b)))
           (:free (p b) (atom-binder-names (atom-tlambdan p b)))
           (:free (p b) (atom-binder-names (atom-ilambda p b)))
           (:free (p b) (atom-binder-names (atom-ilambdan p b)))
           (:free (a tenv locals lmap) (liftable-lambda-p a tenv locals lmap))
           (type-var-list->name (cdr ps))
           (ispace-var-list->name (cdr qs)))
  :enable (tlambda-curried-body ilambda-curried-body
           make-atom-tlambda/tlambdan make-atom-ilambda/ilambdan
           ll-context-new-expr ll-context-lifted
           type-var-list->name-when-not-consp
           ispace-var-list->name-when-not-consp))

(defruled tlambdan-atom-facts
  (implies (and (atomp a)
                (equal (atom-kind a) :tlambdan))
           (b* ((ps (atom-tlambdan->params a))
                (b (atom-tlambdan->body a))
                (nb (ll-context-new-expr b ctx))
                (a2 (ll-context-new-atom a ctx)))
             (and (equal a2 (atom-tlambdan ps nb))
                  (consp ps)
                  (equal (mv-nth 1 (ll-atom a (ll-context->tenv ctx)
                                            (ll-context->tlets ctx)
                                            (ll-context->locals ctx)
                                            (ll-context->lmap ctx)
                                            (ll-context->used ctx)))
                         (ll-context-lifted b ctx))
                  (equal (atom-free-expr-vars a) (expr-free-expr-vars b))
                  (equal (atom-free-expr-vars a2) (expr-free-expr-vars nb))
                  (equal (atom-binder-names a)
                         (cons (type-var->name (car ps))
                               (append (type-var-list->name (cdr ps))
                                       (expr-binder-names b))))
                  (implies (not (zp limit))
                           (equal (eval-atom a denv limit)
                                  (make-expr-value-tlambda
                                   :param (car ps)
                                   :body (tlambda-curried-body ps b)
                                   :denv (expr-denv-restrict
                                          (expr-free-ispace-vars b)
                                          (atom-free-type-vars a)
                                          (expr-free-expr-vars b)
                                          denv))))
                  (implies (not (zp limit))
                           (equal (eval-atom a2 new-denv limit)
                                  (make-expr-value-tlambda
                                   :param (car ps)
                                   :body (tlambda-curried-body ps nb)
                                   :denv (expr-denv-restrict
                                          (expr-free-ispace-vars nb)
                                          (atom-free-type-vars a2)
                                          (expr-free-expr-vars nb)
                                          new-denv))))
                  (implies (zp limit)
                           (reserrp (eval-atom a denv limit))))))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-atom a tenv tlets locals lmap used))
           (:free (d l) (eval-atom a d l))
           (:free (p b d l) (eval-atom (atom-tlambdan p b) d l))
           (atom-free-expr-vars a)
           (:free (p b) (atom-free-expr-vars (atom-tlambdan p b)))
           (atom-binder-names a)
           (type-var-list->name (atom-tlambdan->params a)))
  :use ((:instance atom-tlambdan-requirements (x a)))
  :enable (ll-context-new-atom ll-context-new-expr ll-context-lifted))

(defruled eval-atom-ll-reaches-p-when-tlambdan
  (b* ((x (expr-array nil (list a))))
    (implies (and (atomp a)
                  (equal (atom-kind a) :tlambdan)
                  (not (reserrp (eval-atom a denv limit)))
                  (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                  (ll-context-ok-p x ctx genv))
             (eval-atom-ll-reaches-p (ll-context-new-atom a ctx)
                                     new-denv
                                     (eval-atom a denv limit)
                                     genv)))
  :use ((:instance tlambdan-atom-facts (limit limit))
        (:instance tlambdan-atom-facts (limit 1))
        (:instance tlambda/ilambda-curried-body-facts
                   (ps (atom-tlambdan->params a)) (qs nil)
                   (b (atom-tlambdan->body a)))
        (:instance tlambda/ilambda-curried-body-facts
                   (ps (atom-tlambdan->params a)) (qs nil)
                   (b (ll-context-new-expr (atom-tlambdan->body a) ctx)))
        (:instance ll-expr-of-singleton-array)
        (:instance free-and-binders-of-singleton-array (d nil))
        (:instance free-and-binders-of-singleton-array
                   (d nil) (a (ll-context-new-atom a ctx)))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (x (expr-array nil (list a))) (excl nil))
        (:instance lmap-closed-p-when-ll-context-ok-p
                   (x (expr-array nil (list a))))
        (:instance free-type/ispace-vars-of-ll-context-new
                   (x (atom-tlambdan->body a)))
        (:instance ll-context-ok-p-of-binder-suffix
                   (x (expr-array nil (list a)))
                   (y (tlambda-curried-body (atom-tlambdan->params a)
                                            (atom-tlambdan->body a)))
                   (pre (list (type-var->name
                               (car (atom-tlambdan->params a))))))
        (:instance expr-value-ll-related-p-of-tlambda/ilambda-values
                   (x (expr-array nil (list a)))
                   (vb (tlambda-curried-body (atom-tlambdan->params a)
                                             (atom-tlambdan->body a)))
                   (p (car (atom-tlambdan->params a)))
                   (q nil)
                   (nivars (expr-free-ispace-vars
                            (ll-context-new-expr (atom-tlambdan->body a) ctx)))
                   (ntvars (atom-free-type-vars (ll-context-new-atom a ctx)))
                   (nevars (expr-free-expr-vars
                            (ll-context-new-expr (atom-tlambdan->body a) ctx)))
                   (oivars (expr-free-ispace-vars (atom-tlambdan->body a)))
                   (otvars (atom-free-type-vars a))
                   (oevars (expr-free-expr-vars (atom-tlambdan->body a)))
                   (ctx (ll-context-fix ctx)))
        (:instance eval-atom-ll-reaches-p-suff
                   (new-atom (ll-context-new-atom a ctx))
                   (limit2 1)
                   (w (ll-value-witness-tlambda (ll-context-fix ctx) dw))
                   (val (eval-atom a denv limit))))
  :in-theory (e/d (tlambdan-atom-facts tlambda/ilambda-curried-body-facts
                       ll-expr-of-singleton-array
                       free-and-binders-of-singleton-array)
                      (ll-expr ll-atom eval-atom expr-value-ll-related-p
                      expr-denv-ll-related-p ll-context-ok-p
                      ll-context-new-expr ll-context-lifted ll-context-new-atom
                      eval-atom-ll-reaches-p eval-atom-ll-reaches-p-suff
                      equal-of-expr-array expr-denv-restrict
                      equal-of-expr-value-tlambda equal-of-expr-value-ilambda
                      equal-of-atom-tlambdan tlambda-curried-body)))

(defruled ilambdan-atom-facts
  (implies (and (atomp a)
                (equal (atom-kind a) :ilambdan))
           (b* ((ps (atom-ilambdan->params a))
                (b (atom-ilambdan->body a))
