                                              (type-denv->ienv
                                               (expr-denv->tenv denv))) (1-
                                                                         limit)))
           (eval-expr-ll-reaches-p (ll-context-new-expr x ctx)
                                   new-denv
                                   (eval-expr x denv limit)
                                   genv))
  :use (iapp-shape
        iapp-parts
        eval-expr-when-iapp-ok-local
        (:instance tenv-equal-when-expr-denv-ll-related-p (excl nil))
        (:instance eval-expr-ll-ok-necc (expr (%iapp-f)) (limit (1- limit)))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (%iapp-nf)) (val (%iapp-fv)))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (%iapp-f)) (limit (1- limit)))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (%iapp-nf)) (denv new-denv)
                   (limit (mv-nth 0 (%iapp-wf))))
        (:instance eval-iapp-ll-ok-necc
                   (funval (%iapp-fv)) (ival
                                        (eval-ispace (expr-iapp->arg x)
                                                     (type-denv->ienv
                                                      (expr-denv->tenv
                                                       denv)))) (limit
                                                                 (1- limit))
