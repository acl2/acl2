;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Type and ispace bindings: both environments get the same type or ispace
; variable, and the expression variables do not change.

(defruled lookup-when-same-exprs
  (implies (equal (expr-denv->exprs d2) (expr-denv->exprs d))
           (equal (expr-denv-lookup-expr n d2) (expr-denv-lookup-expr n d)))
  :enable (expr-denv-lookup-expr))

(defun wnf-ind2 (s d d2 g)
  (declare (xargs :measure (acl2-count s)))
  (if (set::emptyp s)
      (list d d2 g)
    (b* ((name (set::head s))
         (val (expr-denv-lookup-expr name g)))
      (if (reserrp val)
          (wnf-ind2 (set::tail s) d d2 g)
        (wnf-ind2 (set::tail s)
                  (expr-denv-add-expr name val d)
                  (expr-denv-add-expr name val d2)
                  g)))))

(defruled exprs-of-with-names-from-when-same-exprs
  (implies (equal (expr-denv->exprs d2) (expr-denv->exprs d))
           (equal (expr-denv->exprs (expr-denv-with-names-from s d2 g))
                  (expr-denv->exprs (expr-denv-with-names-from s d g))))
  :induct (wnf-ind2 s d d2 g)
  :enable (expr-denv-add-expr)
  :expand ((expr-denv-with-names-from s d2 g)
           (expr-denv-with-names-from s d g)))

(defruled lookups-agree-p-when-same-exprs
  (implies (equal (expr-denv->exprs d2) (expr-denv->exprs d))
           (lookups-agree-p names d2 d))
  :induct (len names)
  :enable (lookups-agree-p len expr-denv-lookup-expr))

(defruled eval-replacement-when-same-exprs
  (implies (and (ll-replacement-ok-p repl locals pnames genv)
                (string-setp locals)
                (string-listp pnames)
                (exprp repl)
                (equal (expr-denv->exprs nd2) (expr-denv->exprs nd)))
           (equal (eval-expr repl (expr-denv-with-names-from s nd2 g) l)
                  (eval-expr repl (expr-denv-with-names-from s nd g) l)))
  :use (ll-replacement-ok-p-unpack
        (:instance exprs-of-with-names-from-when-same-exprs (d2 nd2) (d nd))
        (:instance eval-expr-of-apply-to-names-when-agree
                   (h (mv-nth 1 (replacement-parts repl)))
                   (names (mv-nth 2 (replacement-parts repl)))
                   (d1 (expr-denv-with-names-from s nd2 g))
                   (d2 (expr-denv-with-names-from s nd g)))
        (:instance lookups-agree-p-when-same-exprs
                   (names (mv-nth 2 (replacement-parts repl)))
                   (d2 (expr-denv-with-names-from s nd2 g))
                   (d (expr-denv-with-names-from s nd g)))
        (:instance lookup-when-same-exprs
                   (n (mv-nth 1 (replacement-parts repl)))
                   (d2 (expr-denv-with-names-from s nd2 g))
                   (d (expr-denv-with-names-from s nd g))))
  :disable (apply-to-names))

(defruled ll-var-ok-p-when-same-exprs
  (implies (and (ll-var-ok-p var val nd nfv ctx dw genv)
                (equal (expr-denv->exprs nd2) (expr-denv->exprs nd))
                (implies (omap::assoc var (ll-context->lmap ctx))
                         (ll-replacement-ok-p
                          (cdr (omap::assoc var (ll-context->lmap ctx)))
                          (ll-context->locals ctx) pnames genv))
                (string-listp pnames))
           (ll-var-ok-p var val nd2 nfv ctx dw genv))
  :use ((:instance eval-replacement-when-same-exprs
                   (repl (cdr (omap::assoc var (ll-context->lmap ctx))))
                   (locals (ll-context->locals ctx))
                   (s (set::difference
                       (expr-free-expr-vars
                        (cdr (omap::assoc var (ll-context->lmap ctx))))
                       (ll-context->locals ctx)))
                   (g genv) (l (ll-denv-witness->limit dw)))
        (:instance lookup-when-same-exprs (n var) (d2 nd2) (d nd)))
  :enable (ll-var-ok-p)
  :disable (ll-replacement-ok-p eval-expr expr-value-ll-related-p
            value-meets-required-type-p value-has-inferred-type-p))

(defruled walker-when-same-exprs
  (implies (and (string-expr-value-map-ll-related-p nd map fv nfv ctx dw genv)
                (string-expr-value-mapp map)
                (equal (expr-denv->exprs nd2) (expr-denv->exprs nd))
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx) pnames genv)
                (string-listp pnames))
           (string-expr-value-map-ll-related-p nd2 map fv nfv ctx dw genv))
  :use ((:instance string-expr-value-map-ll-related-p-when-pointwise
                   (new-denv nd2))
        (:instance walker-ll-var-ok-p-at
                   (new-denv nd)
                   (var
                    (walker-pointwise-p-witness nd2 map fv nfv ctx dw genv)))
        (:instance ll-var-ok-p-when-same-exprs
                   (var (walker-pointwise-p-witness nd2 map fv nfv ctx dw genv))
                   (val (cdr (omap::assoc (walker-pointwise-p-witness
                                           nd2 map fv nfv ctx dw genv)
                                          map))))
        (:instance ll-replacement-ok-p-when-lmap-replacements-ok-p
                   (lmap (ll-context->lmap ctx)) (locals
                                                  (ll-context->locals ctx))
                   (k (walker-pointwise-p-witness nd2 map fv nfv ctx dw genv))))
  :expand ((walker-pointwise-p nd2 map fv nfv ctx dw genv))
  :disable (ll-var-ok-p walker-pointwise-p-necc lmap-replacements-ok-p
            ll-replacement-ok-p))

(defruled names-bound-as-in-p-when-same-exprs
  (implies (and (names-bound-as-in-p s nd genv)
                (equal (expr-denv->exprs nd2) (expr-denv->exprs nd)))
           (names-bound-as-in-p s nd2 genv))
  :induct (set-ind s)
  :enable (names-bound-as-in-p expr-denv-lookup-expr))

(defruled new-values-meet-types-p-when-same-exprs
  (implies (and (new-values-meet-types-p s nd tenv)
                (equal (expr-denv->exprs nd2) (expr-denv->exprs nd)))
           (new-values-meet-types-p s nd2 tenv))
  :induct (set-ind s)
  :enable (new-values-meet-types-p expr-denv-lookup-expr)
  :disable (value-meets-required-type-p))

(defruled expr-denv-ll-related-p-when-same-exprs
  (implies (and (expr-denv-ll-related-p nd d y ctx excl dw genv)
                (equal (expr-denv->exprs nd2) (expr-denv->exprs nd))
                (equal (expr-denv->exprs d2) (expr-denv->exprs d))
                (equal (expr-denv->tenv nd2) (expr-denv->tenv d2))
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx) pnames genv)
                (string-listp pnames))
           (expr-denv-ll-related-p nd2 d2 y ctx excl dw genv))
  :use ((:instance walker-when-same-exprs
                   (map (expr-denv->exprs d))
                   (fv (set::difference (expr-free-expr-vars y)
                                        (set::mergesort
                                         (str::string-list-fix excl))))
                   (nfv (expr-free-expr-vars (ll-context-new-expr y ctx))))
        (:instance names-bound-as-in-p-when-same-exprs
                   (s (set::difference
                       (expr-free-expr-vars (ll-context-new-expr y ctx))
                       (ll-context->locals ctx))))
        (:instance new-values-meet-types-p-when-same-exprs
                   (s (set::difference
                       (set::intersect
                        (expr-free-expr-vars (ll-context-new-expr y ctx))
                        (ll-context->locals ctx))
                       (set::mergesort (str::string-list-fix excl))))
                   (tenv (ll-context->tenv ctx))))
  :expand ((expr-denv-ll-related-p nd d y ctx excl dw genv)
           (expr-denv-ll-related-p nd2 d2 y ctx excl dw genv))
  :disable (walker-when-same-exprs lmap-replacements-ok-p))

(defmacro %tybind-p ()
  '(or (equal (bind-kind b) :type) (equal (bind-kind b) :ispace)))

(defruled type-bind-shape
  (implies (and (bindp b) (%tybind-p))
           (and (equal (bind-bound-expr-vars b) nil)
                (equal (mv-nth 0 (%llb0)) b)
                (equal (mv-nth 1 (%llb0)) nil)
                (equal (mv-nth 2 (%llb0)) (ll-context->used ctx))))
  :expand ((ll-bind b (ll-context->tenv ctx) (ll-context->tlets ctx)
                    (ll-context->locals ctx) (ll-context->lmap ctx)
                    (ll-context->used ctx)))
  :enable (bind-bound-expr-vars))

(defruled restrict-to-keys-of-nil-keys
  (equal (restrict-to-keys nil m) nil)
  :induct (restrict-to-keys nil m)
  :enable (restrict-to-keys))

(defruled update*-of-nil-local
  (equal (omap::update* nil m) (omap::mfix m)))

(defruled extend-tenv-with-let-bind-when-no-vars
  (implies (equal (bind-bound-expr-vars b) nil)
           (and
            (equal (mv-nth 0 (extend-tenv-with-let-bind b tenv tlets locals))
                       (string-type-map-fix tenv))
                (equal
                 (mv-nth 1 (extend-tenv-with-let-bind b tenv tlets locals))
                       (string-sfix tlets))))
  :enable (extend-tenv-with-let-bind restrict-to-keys-of-nil-keys
           update*-of-nil-local))

(defruled type-bind-ctx2
  (implies (and (bindp b) (%tybind-p))
           (and (not (mv-nth 0 (%step)))
                (equal (mv-nth 1 (%step)) b)
                (equal (ll-context->tenv (%ctx2)) (ll-context->tenv ctx))
                (equal (ll-context->tlets (%ctx2)) (ll-context->tlets ctx))
                (equal (ll-context->locals (%ctx2)) (ll-context->locals ctx))
                (equal (ll-context->lmap (%ctx2)) (ll-context->lmap ctx))))
  :use (type-bind-shape ll-let-step-fields
        (:instance extend-tenv-with-let-bind-when-no-vars
                   (tenv (ll-context->tenv ctx)) (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))))
  :enable (string-expr-map-remove-keys)
  :disable (ll-bind hoist-local-fun ll-let-step))

(defruled eval-bind-when-type-bind
  (implies (and (%tybind-p)
                (not (reserrp (eval-bind b d l)))
                (equal (expr-denv->tenv nd) (expr-denv->tenv d)))
           (and (not (reserrp (eval-bind b nd l)))
                (equal (expr-denv->exprs (eval-bind b nd l))
                       (expr-denv->exprs nd))
                (equal (expr-denv->exprs (eval-bind b d l))
                       (expr-denv->exprs d))
                (equal (expr-denv->tenv (eval-bind b nd l))
                       (expr-denv->tenv (eval-bind b d l)))))
  :expand ((eval-bind b nd l) (eval-bind b d l))
  :enable (expr-denv-add-type expr-denv-add-ispace not-reserrp-when-expr-denvp))

(defruled eval-bind-ll-reaches-p-when-type-bind
  (implies (and (%step-hyps)
                (%tybind-p)
                (not (reserrp (eval-bind b denv limit)))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv))
           (eval-bind-ll-reaches-p (mv-nth 1 (%step)) new-denv
                                   (eval-bind b denv limit)
                                   (let-or-body rest body) (%ctx2) genv))
  :use (type-bind-ctx2 type-bind-shape
        (:instance let-step-free-vars-not-hoisted)
        ll-context-ok-p-of-let-step
        (:instance ll-context-ok-p-facts (x (let-or-body rest body))
                   (ctx (%ctx2)))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (x (expr-let (cons b rest) body)) (excl nil))
        (:instance eval-bind-when-type-bind (d denv) (nd new-denv) (l limit))
        (:instance expr-denv-ll-related-p-of-sub
                   (x (expr-let (cons b rest) body)) (y (let-or-body rest body))
                   (ctx2 (%ctx2)) (excl nil) (excl2 nil))
        (:instance expr-denv-ll-related-p-when-same-exprs
                   (nd new-denv) (d denv) (y (let-or-body rest body))
                   (ctx (%ctx2)) (excl nil)
                   (nd2 (eval-bind b new-denv limit))
                   (d2 (eval-bind b denv limit)) (pnames (%by)))
        (:instance eval-bind-ll-reaches-p-suff
                   (new-bind (mv-nth 1 (%step))) (denv2
                                                  (eval-bind b denv limit))
                   (x (let-or-body rest body)) (ctx (%ctx2)) (limit2 limit)))
  :enable (difference-of-nil-when-setp)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-bind expr-denv-ll-related-p eval-bind-ll-reaches-p
            eval-bind-ll-reaches-p-suff lmap-replacements-ok-p))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; A kept binding whose value is that of an abstraction atom A, which lifting
; rebuilds in the same context as the binding (a function binding with
; parameters).

(define abstraction-atom-p ((a atomp))
  :returns (yes/no booleanp)
  (and (member-eq (atom-kind a)
                  '(:lambda :lambdan :tlambda :tlambdan :ilambda :ilambdan))
       t))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Combined function bindings: the value is that of the nested abstraction
; expression, which lifting rebuilds layer by layer.

(define cfun-expression ((tparams? type-var-list-optionp)
                         (iparams? ispace-var-list-optionp)
                         (params var+type?-listp)
                         (type typep)
                         (expr exprp))
  :returns (e exprp)
  :short "The nested abstraction expression that a combined function binding
          evaluates (see @(tsee eval-bind))."
  (b* ((tparams (type-var-list-option-case tparams? :some tparams?.val
                                           :none nil))
       (iparams (ispace-var-list-option-case iparams? :some iparams?.val
                                             :none nil))
       (e (if (consp params)
              (make-expr-array :dims nil
                               :atoms (list (make-atom-lambda/lambdan
                                             params expr type)))
            (expr-fix expr)))
       (e (if (consp iparams)
              (make-expr-array :dims nil
                               :atoms (list (make-atom-ilambda/ilambdan
                                             iparams e)))
            e))
       (e (if (consp tparams)
              (make-expr-array :dims nil
                               :atoms (list (make-atom-tlambda/tlambdan
                                             tparams e)))
            e)))
    e)
  :verify-guards nil)

(define cfun-type-ok-p ((tparams? type-var-list-optionp)
                        (iparams? ispace-var-list-optionp)
                        (params var+type?-listp)
                        (type typep)
                        (tenv type-denvp))
  :returns (yes/no booleanp)
  (b* ((tparams (type-var-list-option-case tparams? :some tparams?.val
                                           :none nil))
       (iparams (ispace-var-list-option-case iparams? :some iparams?.val
                                             :none nil))
       (in (var+type?-list->type-list-or-err params))
       ((when (reserrp in)) nil)
       (ty (if (consp in)
               (if (endp (cdr in))
                   (make-type-fun :in (car in) :out type)
                 (make-type-funn :in in :out type))
             type))
       (ty (if (consp iparams) (make-type-pi/pin iparams ty) ty))
       (ty (if (consp tparams) (make-type-forall/foralln tparams ty) ty)))
    (not (reserrp (eval-type ty tenv))))
  :verify-guards nil)

(defmacro %cfe (b)
  `(cfun-expression (bind-cfun->tparams? ,b) (bind-cfun->iparams? ,b)
                    (bind-cfun->params ,b) (bind-cfun->type ,b)
                    (bind-cfun->expr ,b)))

(defruled eval-bind-when-cfun-ok
  (implies (and (equal (bind-kind b) :cfun)
                (not (reserrp (eval-bind b d l))))
           (and (posp l)
                (not (reserrp (eval-expr (%cfe b) d (1- l))))
                (equal (eval-bind b d l)
                       (expr-denv-add-expr (bind-name b)
                                           (eval-expr (%cfe b) d (1- l))
                                           d))
                (cfun-type-ok-p (bind-cfun->tparams? b) (bind-cfun->iparams? b)
                                (bind-cfun->params b) (bind-cfun->type b)
                                (expr-denv->tenv d))))
  :expand ((eval-bind b d l))
  :enable (cfun-expression cfun-type-ok-p bind-name))

(defruled eval-bind-of-cfun
  (implies (and (not (reserrp (eval-expr (%cfe (bind-cfun v tp ip ps ty e))
                                         nd l2)))
                (cfun-type-ok-p tp ip ps ty (expr-denv->tenv nd))
                (natp l2))
           (equal (eval-bind (bind-cfun v tp ip ps ty e) nd (+ 1 l2))
                  (expr-denv-add-expr v (eval-expr (%cfe (bind-cfun v tp ip ps
                                                                    ty e))
                                                   nd l2)
                                      nd)))
  :expand ((eval-bind (bind-cfun v tp ip ps ty e) nd (+ 1 l2)))
  :enable (cfun-expression cfun-type-ok-p))

(defmacro %cbctx () '(mv-nth 3 (ll-lambda-parts (bind-cfun->params b) '(:var "")
                                                nil ctx)))

(defmacro %cnb ()
  '(bind-cfun (bind-cfun->var b) (bind-cfun->tparams? b) (bind-cfun->iparams? b)
              (bind-cfun->params b) (bind-cfun->type b)
              (ll-context-new-expr (bind-cfun->expr b) (%cbctx))))

(defmacro %cfe-new ()
  '(cfun-expression (bind-cfun->tparams? b) (bind-cfun->iparams? b)
                    (bind-cfun->params b) (bind-cfun->type b)
                    (ll-context-new-expr (bind-cfun->expr b) (%cbctx))))

(defruled ll-bind-when-cfun
  (implies (and (bindp b) (equal (bind-kind b) :cfun))
           (b* (((mv nb lifted &) (%llb0)))
             (and (equal nb (%cnb))
                  (equal lifted (ll-context-lifted (bind-cfun->expr b)
                                                   (%cbctx))))))
  :use ((:instance fun-body-context (pa (bind-cfun->params b))))
  :expand ((ll-bind b (ll-context->tenv ctx) (ll-context->tlets ctx)
                    (ll-context->locals ctx) (ll-context->lmap ctx)
                    (ll-context->used ctx)))
  :enable (ll-context-new-expr ll-context-lifted))

(defruled cbctx-when-no-params
  (implies (not (consp (bind-cfun->params b)))
           (equal (%cbctx) (ll-context-fix ctx)))
  :use ((:instance fun-body-context (pa (bind-cfun->params b))))
  :enable (extend-tenv-with-params tlets-without locals-with-params
           string-expr-map-remove-keys difference-of-nil-when-setp
           ll-context-fix))

(defruled cfun-expression-shape
  (implies (and (bindp b) (equal (bind-kind b) :cfun))
           (and (equal (ll-context-new-expr (%cfe b) ctx) (%cfe-new))
                (equal (ll-context-lifted (%cfe b) ctx)
                       (ll-context-lifted (bind-cfun->expr b) (%cbctx)))
                (equal (expr-free-expr-vars (%cfe b)) (bind-free-expr-vars b))
                (equal (expr-binder-names (%cfe b)) (bind-binder-names b))
                (equal (expr-free-expr-vars (%cfe-new))
                       (bind-free-expr-vars (%cnb)))))
  :cases ((consp (bind-cfun->params b)))
  :use (cbctx-when-no-params)
  :expand ((bind-free-expr-vars b)
           (bind-binder-names b)
           (:free (v tp ip ps ty e)
                  (bind-free-expr-vars (bind-cfun v tp ip ps ty e))))
  :enable (cfun-expression ll-expr-of-singleton-array
           free-and-binders-of-singleton-array
           ll-atom-of-make-atom-tlambda/tlambdan
           ll-atom-of-make-atom-ilambda/ilambdan
           ll-atom-of-make-atom-lambda/lambdan
           free-and-binders-of-make-atom-tlambda/tlambdan
           free-and-binders-of-make-atom-ilambda/ilambdan
           atom-free-expr-vars-of-make-atom-lambda/lambdan
           atom-binder-names-of-make-atom-lambda/lambdan
           difference-of-nil-when-setp)
  :disable (ll-lambda-parts ll-atom ll-expr make-atom-lambda/lambdan
            make-atom-tlambda/tlambdan make-atom-ilambda/ilambdan
            equal-of-expr-array))

(defruled cfun-new-bind
  (implies (and (bindp b)
                (equal (bind-kind b) :cfun)
                (not (mv-nth 0 (%step))))
           (equal (mv-nth 1 (%step)) (%cnb)))
  :use (let-step-not-hoisted-facts ll-bind-when-cfun)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-new-expr
            ll-lambda-parts))

(defruled cfun-new-eval
  (implies (and (bindp b)
                (equal (bind-kind b) :cfun)
                (not (mv-nth 0 (%step)))
                (not (reserrp (eval-bind b denv limit)))
                (not (reserrp (eval-expr (ll-context-new-expr (%cfe b) ctx)
                                         nd l2)))
                (natp l2)
                (equal (expr-denv->tenv nd) (expr-denv->tenv denv)))
           (equal (eval-bind (mv-nth 1 (%step)) nd (+ 1 l2))
                  (expr-denv-add-expr (bind-name b)
                                      (eval-expr (ll-context-new-expr (%cfe b)
                                                                      ctx)
                                                 nd l2)
                                      nd)))
  :use ((:instance eval-bind-when-cfun-ok (d denv) (l limit))
        cfun-expression-shape
        (:instance eval-bind-of-cfun
                   (v (bind-cfun->var b)) (tp (bind-cfun->tparams? b))
                   (ip (bind-cfun->iparams? b)) (ps (bind-cfun->params b))
                   (ty (bind-cfun->type b))
                   (e (ll-context-new-expr (bind-cfun->expr b) (%cbctx)))))
  :enable (cfun-new-bind bind-name)
  :disable (ll-bind hoist-local-fun ll-let-step eval-bind eval-expr
            ll-context-new-expr ll-lambda-parts cfun-expression))

(defruled eval-bind-ll-reaches-p-when-cfun
  (implies (and (%step-hyps)
                (equal (bind-kind b) :cfun)
                (not (mv-nth 0 (%step)))
                (not (reserrp (eval-bind b denv limit)))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok (%cfe b) denv (1- limit))
                (ll-bound-value-ok-p (eval-expr (%cfe b) denv (1- limit))
                                     (bind-name b) (%ctx2)))
           (eval-bind-ll-reaches-p (mv-nth 1 (%step)) new-denv
                                   (eval-bind b denv limit)
                                   (let-or-body rest body) (%ctx2) genv))
  :use ((:instance bind-bound-expr-vars-nonempty)
        (:instance eval-bind-when-cfun-ok (d denv) (l limit))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (x (expr-let (cons b rest) body)) (excl nil))
        (:instance ebind-ih (e (%cfe b)))
        (:instance cfun-new-eval (nd new-denv)
                   (l2 (mv-nth 0 (eval-expr-ll-reaches-p-witness
                                  (ll-context-new-expr (%cfe b) ctx) new-denv
                                  (eval-expr (%cfe b) denv (1- limit))
                                  genv))))
        (:instance eval-bind-ll-reaches-p-when-ebind (e (%cfe b))))
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-expr eval-bind expr-denv-ll-related-p eval-expr-ll-ok
            eval-expr-ll-ok-necc eval-expr-ll-reaches-p
            eval-bind-ll-reaches-p eval-bind-ll-reaches-p-suff
            expr-value-ll-related-p value-meets-required-type-p
            value-has-inferred-type-p lmap-replacements-ok-p
            ll-context-new-expr ll-bound-value-ok-p cfun-expression
            ll-lambda-parts)
  :enable (ll-bind-when-cfun cfun-expression-shape))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The statement for a kept binding.

; What the context after a kept binding requires of the value it binds:
; the requirement of its type, and its inferred type if any.  This is where
; the soundness of the type checker is needed; it is a hypothesis here.

(acl2::defun-sk let-bind-typed-p (bind denv limit)
  (forall (rest body ctx new-denv dw genv)
          (b* ((denv2 (eval-bind bind denv limit))
               (x (expr-let (cons bind rest) body))
               ((mv & & ctx2) (ll-let-step bind rest body ctx)))
            (implies (and (bindp bind)
                          (bind-listp rest)
                          (exprp body)
                          (not (reserrp denv2))
                          (not (set::emptyp (bind-bound-expr-vars bind)))
                          (expr-denv-ll-related-p new-denv denv x ctx nil
                                                  dw genv)
                          (ll-context-ok-p x ctx genv)
                          (expr-denv-wfp denv)
                          (expr-denv-wfp new-denv))
                     (ll-bound-value-ok-p
                      (expr-denv-lookup-expr (bind-name bind) denv2)
                      (bind-name bind) ctx2)))))

(defruled lookup-of-name-in-added-local
  (implies (and (stringp n) (expr-valuep v))
           (equal (expr-denv-lookup-expr n (expr-denv-add-expr n v d)) v))
  :enable (expr-denv-lookup-expr-of-expr-denv-add-expr))

(defmacro %stmt-hyps ()
  '(and (bindp b)
        (bind-listp rest)
        (exprp body)
        (not (mv-nth 0 (%step)))
        (not (reserrp (eval-bind b denv limit)))
        (expr-denv-ll-related-p new-denv denv (expr-let (cons b rest) body) ctx
                                nil dw genv)
        (ll-context-ok-p (expr-let (cons b rest) body) ctx genv)
        (expr-denv-wfp denv)
        (expr-denv-wfp new-denv)
        (let-bind-typed-p b denv limit)))

(defmacro %stmt-concl ()
  '(eval-bind-ll-reaches-p (mv-nth 1 (%step)) new-denv
                           (eval-bind b denv limit)
                           (let-or-body rest body) (%ctx2) genv))

(defruled eval-bind-stmt-when-plain
  (implies (and (%stmt-hyps)
                (bind-plain-p b)
                (eval-expr-ll-ok (bind-plain-expr b) denv (1- limit)))
           (%stmt-concl))
  :use ((:instance let-bind-typed-p-necc (bind b))
        (:instance bind-bound-expr-vars-nonempty)
        bind-kind-when-plain
        (:instance eval-bind-when-plain-ok (d denv) (l limit))
        eval-bind-ll-reaches-p-when-plain)
  :enable (lookup-of-name-in-added-local expr-valuep-when-result-not-error)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-expr eval-bind eval-atom expr-denv-ll-related-p
            eval-expr-ll-ok eval-bind-ll-reaches-p ll-bound-value-ok-p
            let-bind-typed-p-necc cfun-expression
            make-atom-lambda/lambdan make-atom-tlambda/tlambdan
            make-atom-ilambda/ilambdan))

(defruled eval-bind-stmt-when-cfun
  (implies (and (%stmt-hyps)
                (equal (bind-kind b) :cfun)
                (eval-expr-ll-ok (%cfe b) denv (1- limit)))
           (%stmt-concl))
  :use ((:instance let-bind-typed-p-necc (bind b))
        (:instance bind-bound-expr-vars-nonempty)
        (:instance eval-bind-when-cfun-ok (d denv) (l limit))
        eval-bind-ll-reaches-p-when-cfun)
  :enable (lookup-of-name-in-added-local expr-valuep-when-result-not-error)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-expr eval-bind eval-atom expr-denv-ll-related-p
            eval-expr-ll-ok eval-bind-ll-reaches-p ll-bound-value-ok-p
            let-bind-typed-p-necc cfun-expression
            make-atom-lambda/lambdan make-atom-tlambda/tlambdan
            make-atom-ilambda/ilambdan))

(defruled eval-bind-stmt-when-fun-params
  (implies (and (%stmt-hyps)
                (equal (bind-kind b) :fun)
                (consp (bind-fun->params b)))
           (%stmt-concl))
  :use ((:instance let-bind-typed-p-necc (bind b))
        (:instance bind-bound-expr-vars-nonempty)
        fun-orig-eval
        eval-bind-ll-reaches-p-when-fun-params)
  :enable (lookup-of-name-in-added-local expr-valuep-when-result-not-error)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-expr eval-bind eval-atom expr-denv-ll-related-p
            eval-expr-ll-ok eval-bind-ll-reaches-p ll-bound-value-ok-p
            let-bind-typed-p-necc cfun-expression
            make-atom-lambda/lambdan make-atom-tlambda/tlambdan
            make-atom-ilambda/ilambdan))

(defruled eval-bind-stmt-when-tfun-params
  (implies (and (%stmt-hyps)
                (equal (bind-kind b) :tfun)
                (consp (bind-tfun->params b)))
           (%stmt-concl))
  :use ((:instance let-bind-typed-p-necc (bind b))
        (:instance bind-bound-expr-vars-nonempty)
        tfun-orig-eval
        eval-bind-ll-reaches-p-when-tfun-params)
  :enable (lookup-of-name-in-added-local expr-valuep-when-result-not-error)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-expr eval-bind eval-atom expr-denv-ll-related-p
            eval-expr-ll-ok eval-bind-ll-reaches-p ll-bound-value-ok-p
            let-bind-typed-p-necc cfun-expression
            make-atom-lambda/lambdan make-atom-tlambda/tlambdan
            make-atom-ilambda/ilambdan))

(defruled eval-bind-stmt-when-ifun-params
  (implies (and (%stmt-hyps)
                (equal (bind-kind b) :ifun)
                (consp (bind-ifun->params b)))
           (%stmt-concl))
  :use ((:instance let-bind-typed-p-necc (bind b))
        (:instance bind-bound-expr-vars-nonempty)
        ifun-orig-eval
        eval-bind-ll-reaches-p-when-ifun-params)
  :enable (lookup-of-name-in-added-local expr-valuep-when-result-not-error)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-expr eval-bind eval-atom expr-denv-ll-related-p
            eval-expr-ll-ok eval-bind-ll-reaches-p ll-bound-value-ok-p
