; The lifted forms of the arguments of the clique's functions.

(define ll-context-new-exprs ((xs expr-listp) (ctx ll-context-p))
  :returns (new-xs expr-listp)
  :short "What lifting rebuilds a list of expressions into, in a context."
  (b* (((ll-context ctx) ctx)
       ((mv new-xs & &)
        (ll-expr-list xs ctx.tenv ctx.tlets ctx.locals ctx.lmap ctx.used)))
    new-xs))

(define ll-context-new-atom ((a atomp) (ctx ll-context-p))
  :returns (new-a atomp)
  :short "What lifting rebuilds an atom into, in a context."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the atom in an array, which is not lifted itself, even if it is
     a lambda: only the lambdas inside it are (see @(tsee ll-atom))."))
  (b* (((ll-context ctx) ctx)
       ((mv new-a & &)
        (ll-atom a ctx.tenv ctx.tlets ctx.locals ctx.lmap ctx.used)))
    new-a))

(define ll-context-new-atoms ((as atom-listp) (ctx ll-context-p))
  :returns (new-as atom-listp)
  :short "What lifting rebuilds a list of atoms into, in a context."
  (b* (((ll-context ctx) ctx)
       ((mv new-as & &)
        (ll-atom-list as ctx.tenv ctx.tlets ctx.locals ctx.lmap ctx.used)))
    new-as))

(define let-or-body ((binds bind-listp) (body exprp))
  :returns (e exprp :hyp (exprp body))
  :short "A @(':let') of some bindings, or its body if there are none."
  :long
  (xdoc::topstring
   (xdoc::p
    "A @(':let') has at least one binding, so this is what remains of one
     as its bindings are evaluated."))
  (if (consp binds) (expr-let binds body) body))

(define ll-let-step ((b bindp)
                     (rest bind-listp)
                     (body exprp)
                     (ctx ll-context-p))
  :returns (mv (hoistedp booleanp)
               (new-b bindp)
               (new-ctx ll-context-p))
  :short "The step of @(tsee ll-let-binds) for the first binding of a
          @(':let'): whether it is hoisted, what it is rebuilt into, and
          the context for the rest of the @(':let')."
  (b* (((ll-context c) ctx)
       (b (bind-fix b))
       ((mv new-b & used) (ll-bind b c.tenv c.tlets c.locals c.lmap c.used))
       (rebound (append (bind-list-expr-var-binders rest)
                        (expr-expr-var-binders body)))
       ((mv hoistedp var & replacement used)
        (hoist-local-fun new-b rebound c.tenv c.locals used))
       ((mv tenv tlets) (extend-tenv-with-let-bind b c.tenv c.tlets c.locals))
       (locals (set::union (bind-bound-expr-vars b) c.locals))
       (lmap (if hoistedp
                 (omap::update var replacement c.lmap)
               (string-expr-map-remove-keys (bind-bound-expr-vars b) c.lmap))))
    (mv hoistedp
        new-b
        (make-ll-context :tenv tenv
                         :tlets tlets
                         :locals locals
                         :lmap lmap
                         :used used)))
  :verify-guards nil)

(define ll-let-result ((binds bind-listp) (body exprp) (ctx ll-context-p))
  :returns (mv (kept bind-listp) (body-ctx ll-context-p))
  :short "The bindings that lifting keeps of a @(':let'), and the context
          at its body."
  (b* (((ll-context c) ctx)
       ((mv kept & tenv locals lmap used tlets)
        (ll-let-binds binds (expr-expr-var-binders body)
                      c.tenv c.tlets c.locals c.lmap c.used)))
    (mv kept (make-ll-context :tenv tenv
                              :tlets tlets
                              :locals locals
                              :lmap lmap
                              :used used)))
  :verify-guards nil)

