                    (eval-iapp-list (expr-value-vector->elems nf) iv l))
                   (vals vs))
        (:instance eval-iapp-of-vector-at-succ (f nf))
        (:instance expr-value-ll-related-p-of-vector-values
                   (a (eval-iapp-list (expr-value-vector->elems nf) iv l))
                   (b vs) (w (ll-value-witness-vector ws)))
        (:instance eval-iapp-ll-reaches-p-suff
                   (new-funval nf) (ival iv)
                   (limit2 (+ 1 l)) (w (ll-value-witness-vector ws))))
  :disable (eval-iapp eval-iapp-list expr-value-ll-related-p
            expr-value-list-ll-related-p eval-iapp-ll-reaches-p
            eval-iapp-ll-reaches-p-suff equal-of-expr-value-vector)
  :enable (not-reserrp-when-expr-valuep))

(defruled eval-iapp-ll-reaches-p-when-vector
  (implies (and (equal (expr-value-kind funval) :vector)
                (not (reserrp (eval-iapp funval ival limit)))
                (eval-iapp-list-ll-ok (%ivels) ival (1- limit))
                (expr-value-ll-related-p new-funval funval w genv)
                (expr-value-wfp funval)
                (expr-value-wfp new-funval))
           (eval-iapp-ll-reaches-p new-funval ival
                                   (eval-iapp funval ival limit) genv))
  :use ((:instance eval-iapp-when-vector-local (f funval) (iv ival) (l limit))
        (:instance vector-related-unpack (nf new-funval) (f funval))
        (:instance eval-iapp-list-ll-ok-necc
