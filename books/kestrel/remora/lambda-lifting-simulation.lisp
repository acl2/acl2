                (equal (ll-context->locals (%ctx2))
                       (set::insert (bind-name b) (ll-context->locals ctx)))
                (set::in (bind-name b) (ll-context->used (%ctx2)))
                (stringp (bind-name b))
                (member-equal (bind-name b) (%bx))
                (not (set::in (bind-name b) (ll-context->locals ctx)))
                (not (equal lam (bind-name b)))
                (not (set::in lam (ll-context->locals (%ctx2))))))
  :use (let-step-hoisted-facts let-step-hoisted-shape let-step-locals
        let-step-name-in-used let-step-used let-step-name-fresh let-binders-facts
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance union-of-singleton-local
                   (a (bind-name b)) (s (ll-context->locals ctx)))
        (:instance set::subset-in (a (bind-name b)) (x (ll-context->used ctx))
                   (y (ll-context->used (%ctx2))))
        (:instance acl2::intersectp-member
                   (a (bind-name b)) (x (%bx)) (y (ll-context->locals ctx)))
        (:instance in-to-member-local (a (bind-name b))
                   (x (ll-context->locals ctx))))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var ll-expr
            ll-lambda-parts ll-context-ok-p apply-to-names
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled not-in-map-free-of-update-local
  (implies (and (not (set::in v (string-expr-map-free-expr-vars m)))
                (not (set::in v (expr-free-expr-vars e)))
                (string-expr-mapp m)
                (stringp k)
                (exprp e))
           (not (set::in v (string-expr-map-free-expr-vars
                            (omap::update k e m)))))
  :use ((:instance string-expr-map-free-expr-vars-of-update (v e))
        (:instance set::subset-in (a v)
                   (x (string-expr-map-free-expr-vars (omap::update k e m)))
                   (y (set::union (expr-free-expr-vars e)
                                  (string-expr-map-free-expr-vars m)))))
  :disable (string-expr-map-free-expr-vars-of-update set::subset-in))

(defruled hoisted-var-not-in-map-free
  (implies (%hstep-hyps)
           (not (set::in (bind-name b)
