                   prim-int-mul-when-related prim-int-div-when-related
                   prim-int-expt-when-related prim-int-mod-when-related
                   prim-int-max-when-related prim-int-min-when-related
                   prim-int-bit-and-when-related prim-int-bit-or-when-related
                   prim-int-bit-xor-when-related prim-int-shl-when-related
                   prim-int-shr-when-related prim-int-bit-not-when-related
                   prim-int-popc-when-related prim-int-eq-when-related
                   prim-int-neq-when-related prim-int-lt-when-related
                   prim-int-gt-when-related prim-int-leq-when-related
                   prim-int-geq-when-related prim-int-to-float-when-related
                   prim-int-to-bool-when-related prim-float-add-when-related
                   prim-float-sub-when-related prim-float-mul-when-related
                   prim-float-div-when-related prim-float-expt-when-related
                   prim-float-max-when-related prim-float-min-when-related
                   prim-float-sqrt-when-related prim-float-eq-when-related
                   prim-float-neq-when-related prim-float-lt-when-related
                   prim-float-gt-when-related prim-float-leq-when-related
                   prim-float-geq-when-related prim-float-truncate-when-related
                   prim-float-round-when-related
                   prim-float-ceiling-when-related
                   prim-float-floor-when-related prim-bool-not-when-related
                   prim-bool-and-when-related prim-bool-or-when-related
                   prim-bool-eq-when-related prim-bool-neq-when-related
                   prim-bool-to-int-when-related
                   prim-bool-to-float-when-related
                   expr-value-groundp-of-prim-int-add
                   expr-value-groundp-of-prim-int-sub
                   expr-value-groundp-of-prim-int-mul
                   expr-value-groundp-of-prim-int-div
                   expr-value-groundp-of-prim-int-expt
                   expr-value-groundp-of-prim-int-mod
                   expr-value-groundp-of-prim-int-max
                   expr-value-groundp-of-prim-int-min
                   expr-value-groundp-of-prim-int-bit-and
                   expr-value-groundp-of-prim-int-bit-or
                   expr-value-groundp-of-prim-int-bit-xor
                   expr-value-groundp-of-prim-int-shl
                   expr-value-groundp-of-prim-int-shr
                   expr-value-groundp-of-prim-int-bit-not
                   expr-value-groundp-of-prim-int-popc
                   expr-value-groundp-of-prim-int-eq
                   expr-value-groundp-of-prim-int-neq
                   expr-value-groundp-of-prim-int-lt
                   expr-value-groundp-of-prim-int-gt
                   expr-value-groundp-of-prim-int-leq
                   expr-value-groundp-of-prim-int-geq
                   expr-value-groundp-of-prim-int-to-float
                   expr-value-groundp-of-prim-int-to-bool
                   expr-value-groundp-of-prim-float-add
                   expr-value-groundp-of-prim-float-sub
                   expr-value-groundp-of-prim-float-mul
                   expr-value-groundp-of-prim-float-div
                   expr-value-groundp-of-prim-float-expt
                   expr-value-groundp-of-prim-float-max
                   expr-value-groundp-of-prim-float-min
                   expr-value-groundp-of-prim-float-sqrt
                   expr-value-groundp-of-prim-float-eq
                   expr-value-groundp-of-prim-float-neq
                   expr-value-groundp-of-prim-float-lt
                   expr-value-groundp-of-prim-float-gt
                   expr-value-groundp-of-prim-float-leq
                   expr-value-groundp-of-prim-float-geq
                   expr-value-groundp-of-prim-float-truncate
                   expr-value-groundp-of-prim-float-round
                   expr-value-groundp-of-prim-float-ceiling
                   expr-value-groundp-of-prim-float-floor
                   expr-value-groundp-of-prim-bool-not
                   expr-value-groundp-of-prim-bool-and
                   expr-value-groundp-of-prim-bool-or
                   expr-value-groundp-of-prim-bool-eq
                   expr-value-groundp-of-prim-bool-neq
                   expr-value-groundp-of-prim-bool-to-int
                   expr-value-groundp-of-prim-bool-to-float
                   ;; array operations
                   prim-head-ll2 prim-tail-ll prim-length-ll2 prim-append-ll
                   prim-reverse-ll prim-index-ll2 prim-index2d-ll2 prim-sum-ll
                   prim-reshape-ll prim-flatten-ll prim-transpose2d-ll
                   prim-iota-ll prim-trace-ll2)))))

