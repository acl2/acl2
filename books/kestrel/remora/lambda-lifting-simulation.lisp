                          (expr-value-ll-related-p new-argcell argcell w2 genv)
                          (expr-value-wfp funcell)
                          (expr-value-wfp new-funcell)
                          (expr-value-wfp argcell)
                          (expr-value-wfp new-argcell))
                     (eval-app-cell-ll-reaches-p new-funcell new-argcell val
                                                 genv)))))

; The body of an unboxing is evaluated in the environment extended with the
; unboxed variable, which is local in the context of the body; the
; environments are related at the body, excluding that variable.

(acl2::defun-sk eval-unbox-ll-ok (target ispaces var body type denv limit)
  (forall (new-target w ctx new-denv dw genv)
          (b* ((val (eval-unbox target ispaces var body type denv limit)))
            (implies (and (not (reserrp val))
                          (expr-value-ll-related-p new-target target w genv)
                          (names-in-context-p (list var) ctx)
                          (lmap-replacements-ok-p (ll-context->lmap ctx)
                                                  (ll-context->locals ctx)
                                                  (list var) genv)
                          (not (omap::assoc var (ll-context->tenv ctx)))
                          (stringp var)
                          (expr-denv-ll-related-p new-denv denv body ctx
                                                  (list var) dw genv)
                          (ll-context-ok-p body ctx genv)
                          (expr-value-wfp target)
                          (expr-value-wfp new-target)
                          (expr-denv-wfp denv)
                          (expr-denv-wfp new-denv))
                     (eval-unbox-ll-reaches-p new-target ispaces var
                                              (ll-context-new-expr body ctx)
                                              type new-denv val genv)))))

(acl2::defun-sk eval-unbox-list-ll-ok (targets ispaces var body type denv
                                               limit)
  (forall (new-targets ws ctx new-denv dw genv)
          (b* ((vals (eval-unbox-list targets ispaces var body type denv
                                      limit)))
            (implies (and (not (reserrp vals))
                          (expr-value-list-ll-related-p new-targets targets ws
                                                        genv)
                          (names-in-context-p (list var) ctx)
                          (lmap-replacements-ok-p (ll-context->lmap ctx)
                                                  (ll-context->locals ctx)
                                                  (list var) genv)
                          (not (omap::assoc var (ll-context->tenv ctx)))
                          (stringp var)
                          (expr-denv-ll-related-p new-denv denv body ctx
                                                  (list var) dw genv)
                          (ll-context-ok-p body ctx genv)
                          (expr-value-list-wfp targets)
                          (expr-value-list-wfp new-targets)
                          (expr-denv-wfp denv)
                          (expr-denv-wfp new-denv))
                     (eval-unbox-list-ll-reaches-p
                      new-targets ispaces var (ll-context-new-expr body ctx)
                      type new-denv vals genv)))))

(acl2::defun-sk eval-primop-fun-ll-ok (op arg limit)
  (forall (new-op new-arg ws w genv)
          (b* ((val (eval-primop-fun op arg limit)))
            (implies (and (not (reserrp val))
                          (primop-value-ll-related-p new-op op ws genv)
                          (expr-value-ll-related-p new-arg arg w genv)
                          (primop-value-wfp op)
                          (primop-value-wfp new-op)
                          (expr-value-wfp arg)
                          (expr-value-wfp new-arg))
                     (eval-primop-fun-ll-reaches-p new-op new-arg val
                                                   genv)))))

(acl2::defun-sk prim-reduce/fold-loop-ll-ok (acc cells fval limit)
  (forall (new-acc new-cells new-fval w1 ws w2 genv)
          (b* ((val (prim-reduce/fold-loop acc cells fval limit)))
            (implies (and (not (reserrp val))
                          (expr-value-ll-related-p new-acc acc w1 genv)
                          (expr-value-list-ll-related-p new-cells cells ws
                                                        genv)
                          (expr-value-ll-related-p new-fval fval w2 genv)
                          (expr-value-wfp acc)
                          (expr-value-wfp new-acc)
                          (expr-value-list-wfp cells)
                          (expr-value-list-wfp new-cells)
                          (expr-value-wfp fval)
                          (expr-value-wfp new-fval))
                     (prim-reduce/fold-loop-ll-reaches-p new-acc new-cells
                                                         new-fval val
                                                         genv)))))

(acl2::defun-sk prim-reduce-ll-ok (tval d s fval arg limit)
  (forall (new-fval new-arg w1 w2 genv)
          (b* ((val (prim-reduce tval d s fval arg limit)))
            (implies (and (not (reserrp val))
                          (expr-value-ll-related-p new-fval fval w1 genv)
                          (expr-value-ll-related-p new-arg arg w2 genv)
                          (expr-value-wfp fval)
                          (expr-value-wfp new-fval)
                          (expr-value-wfp arg)
                          (expr-value-wfp new-arg))
                     (prim-reduce-ll-reaches-p tval d s new-fval new-arg val
                                               genv)))))

(acl2::defun-sk prim-fold-ll-ok (tval t2val d s s2 fval zval arg limit)
  (forall (new-fval new-zval new-arg w1 w2 w3 genv)
          (b* ((val (prim-fold tval t2val d s s2 fval zval arg limit)))
            (implies (and (not (reserrp val))
                          (expr-value-ll-related-p new-fval fval w1 genv)
                          (expr-value-ll-related-p new-zval zval w2 genv)
                          (expr-value-ll-related-p new-arg arg w3 genv)
                          (expr-value-wfp fval)
                          (expr-value-wfp new-fval)
                          (expr-value-wfp zval)
                          (expr-value-wfp new-zval)
                          (expr-value-wfp arg)
                          (expr-value-wfp new-arg))
                     (prim-fold-ll-reaches-p tval t2val d s s2 new-fval
                                             new-zval new-arg val genv)))))

; The statements and conclusions are opened only where a proof asks for it.

