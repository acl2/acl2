                  (type-optionp ity1)
                  (not (reserrp (lambda-closure m2 in1 ity1 d2)))
                  (equal (expr-denv->tenv d1) (expr-denv->tenv d2)))
             (not (reserrp (lambda-closure (append m2 ps) b ity d1)))))
  :use ((:instance lambda-chain-type-when-nothing-absorbed
