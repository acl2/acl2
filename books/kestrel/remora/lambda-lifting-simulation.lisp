           (equal (eval-atom (make-atom-lambda/lambdan pa ba ta) denv limit)
                  (%v)))
  :cases ((zp limit))
  :use ((:instance eval-atom-of-lambda/lambdan
                   (params pa) (body ba) (type? ta)))
  :hints (("Subgoal 1"
           :expand ((eval-atom (make-atom-lambda/lambdan pa ba ta)
