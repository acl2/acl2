; The conclusions: the lifted evaluation succeeds with some limit, and its
; result is related to the original one via some witness.

(defmacro def-ll-reaches (name formals call &key list)
  `(acl2::defun-sk ,name (,@formals val genv)
     (exists (limit2 w)
             (b* ((new-val ,call))
               (and (not (reserrp new-val))
                    (,(if list
                          'expr-value-list-ll-related-p
                        'expr-value-ll-related-p)
                     new-val val w genv))))))

(def-ll-reaches eval-expr-ll-reaches-p (new-expr new-denv)
  (eval-expr new-expr new-denv limit2))

(def-ll-reaches eval-expr-list-ll-reaches-p (new-exprs new-denv)
  (eval-expr-list new-exprs new-denv limit2)
  :list t)

(def-ll-reaches eval-atom-ll-reaches-p (new-atom new-denv)
  (eval-atom new-atom new-denv limit2))

(def-ll-reaches eval-atom-list-ll-reaches-p (new-atoms new-denv)
  (eval-atom-list new-atoms new-denv limit2)
  :list t)

(def-ll-reaches eval-tapp-ll-reaches-p (new-funval tval)
  (eval-tapp new-funval tval limit2))

(def-ll-reaches eval-tapp-list-ll-reaches-p (new-funvals tval)
  (eval-tapp-list new-funvals tval limit2)
  :list t)

(def-ll-reaches eval-tappn-ll-reaches-p (new-funval args new-denv)
  (eval-tappn new-funval args new-denv limit2))

(def-ll-reaches eval-iapp-ll-reaches-p (new-funval ival)
  (eval-iapp new-funval ival limit2))

(def-ll-reaches eval-iapp-list-ll-reaches-p (new-funvals ival)
  (eval-iapp-list new-funvals ival limit2)
  :list t)

(def-ll-reaches eval-iappn-ll-reaches-p (new-funval args new-denv)
  (eval-iappn new-funval args new-denv limit2))

(def-ll-reaches eval-app-ll-reaches-p (new-funval new-argvals)
  (eval-app new-funval new-argvals limit2))

(def-ll-reaches eval-app-list-ll-reaches-p (new-funcells new-argcells)
  (eval-app-list new-funcells new-argcells limit2)
  :list t)

(def-ll-reaches eval-app-cell-ll-reaches-p (new-funcell new-argcell)
  (eval-app-cell new-funcell new-argcell limit2))

(def-ll-reaches eval-unbox-ll-reaches-p
  (new-target ispaces var new-body type new-denv)
  (eval-unbox new-target ispaces var new-body type new-denv limit2))

(def-ll-reaches eval-unbox-list-ll-reaches-p
  (new-targets ispaces var new-body type new-denv)
  (eval-unbox-list new-targets ispaces var new-body type new-denv limit2)
  :list t)

(def-ll-reaches eval-primop-fun-ll-reaches-p (new-op new-arg)
  (eval-primop-fun new-op new-arg limit2))

(def-ll-reaches prim-reduce/fold-loop-ll-reaches-p
  (new-acc new-cells new-fval)
  (prim-reduce/fold-loop new-acc new-cells new-fval limit2))

(def-ll-reaches prim-reduce-ll-reaches-p (tval d s new-fval new-arg)
  (prim-reduce tval d s new-fval new-arg limit2))

(def-ll-reaches prim-fold-ll-reaches-p
  (tval t2val d s s2 new-fval new-zval new-arg)
  (prim-fold tval t2val d s s2 new-fval new-zval new-arg limit2))

; The bindings conclude with related environments, at the rest of the
; :LET.

(acl2::defun-sk eval-bind-ll-reaches-p (new-bind new-denv denv2 x ctx genv)
  (exists (limit2 dw)
          (b* ((new-denv2 (eval-bind new-bind new-denv limit2)))
            (and (not (reserrp new-denv2))
                 (expr-denv-ll-related-p new-denv2 denv2 x ctx nil dw genv)))))

(acl2::defun-sk eval-bind-list-ll-reaches-p
                (new-binds new-denv denv2 x ctx genv)
  (exists (limit2 dw)
          (b* ((new-denv2 (eval-bind-list new-binds new-denv limit2)))
            (and (not (reserrp new-denv2))
                 (expr-denv-ll-related-p new-denv2 denv2 x ctx nil dw genv)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The statements of the induction, one per function of the evaluator
; clique.  The CHECK-SOUND-P assumption, needed for the :LET case, is a
; hypothesis of the induction theorem as a whole, not of each statement.

(acl2::defun-sk eval-expr-ll-ok (expr denv limit)
  (forall (ctx new-denv dw genv)
          (b* ((val (eval-expr expr denv limit)))
            (implies (and (not (reserrp val))
                          (expr-denv-ll-related-p new-denv denv expr ctx nil
                                                  dw genv)
                          (ll-context-ok-p expr ctx genv)
                          (expr-denv-wfp denv)
                          (expr-denv-wfp new-denv))
                     (eval-expr-ll-reaches-p (ll-context-new-expr expr ctx)
                                             new-denv val genv)))))

(acl2::defun-sk eval-expr-list-ll-ok (exprs denv limit)
  (forall (ctx new-denv dw genv)
          (b* ((vals (eval-expr-list exprs denv limit))
               (x (expr-bracket exprs)))
            (implies (and (not (reserrp vals))
                          (expr-denv-ll-related-p new-denv denv x ctx nil
                                                  dw genv)
                          (ll-context-ok-p x ctx genv)
                          (expr-denv-wfp denv)
                          (expr-denv-wfp new-denv))
                     (eval-expr-list-ll-reaches-p
                      (ll-context-new-exprs exprs ctx) new-denv vals genv)))))

(acl2::defun-sk eval-atom-ll-ok (atom denv limit)
  (forall (ctx new-denv dw genv)
          (b* ((val (eval-atom atom denv limit))
               (x (expr-array nil (list atom))))
            (implies (and (not (reserrp val))
                          (expr-denv-ll-related-p new-denv denv x ctx nil
                                                  dw genv)
                          (ll-context-ok-p x ctx genv)
                          (expr-denv-wfp denv)
                          (expr-denv-wfp new-denv))
                     (eval-atom-ll-reaches-p (ll-context-new-atom atom ctx)
                                             new-denv val genv)))))

(acl2::defun-sk eval-atom-list-ll-ok (atoms denv limit)
  (forall (ctx new-denv dw genv)
          (b* ((vals (eval-atom-list atoms denv limit))
               (x (expr-array nil atoms)))
            (implies (and (not (reserrp vals))
                          (expr-denv-ll-related-p new-denv denv x ctx nil
                                                  dw genv)
                          (ll-context-ok-p x ctx genv)
                          (expr-denv-wfp denv)
                          (expr-denv-wfp new-denv))
                     (eval-atom-list-ll-reaches-p
                      (ll-context-new-atoms atoms ctx) new-denv vals genv)))))

; A binding that is hoisted is not evaluated in the lifted program; that
; case is handled by the one for lists of bindings.

(acl2::defun-sk eval-bind-ll-ok (bind denv limit)
  (forall (rest body ctx new-denv dw genv)
          (b* ((denv2 (eval-bind bind denv limit))
               (x (expr-let (cons bind rest) body))
               ((mv hoistedp new-bind ctx2) (ll-let-step bind rest body ctx)))
            (implies (and (bindp bind)
                          (bind-listp rest)
                          (exprp body)
                          (not hoistedp)
                          (not (reserrp denv2))
                          (expr-denv-ll-related-p new-denv denv x ctx nil
                                                  dw genv)
                          (ll-context-ok-p x ctx genv)
                          (expr-denv-wfp denv)
                          (expr-denv-wfp new-denv))
                     (eval-bind-ll-reaches-p new-bind new-denv denv2
                                             (let-or-body rest body) ctx2
                                             genv)))))

(acl2::defun-sk eval-bind-list-ll-ok (binds denv limit)
  (forall (body ctx new-denv dw genv)
          (b* ((denv2 (eval-bind-list binds denv limit))
               (x (let-or-body binds body))
               ((mv kept body-ctx) (ll-let-result binds body ctx)))
            (implies (and (bind-listp binds)
                          (exprp body)
                          (not (reserrp denv2))
                          (expr-denv-ll-related-p new-denv denv x ctx nil
                                                  dw genv)
                          (ll-context-ok-p x ctx genv)
                          (expr-denv-wfp denv)
                          (expr-denv-wfp new-denv))
                     (eval-bind-list-ll-reaches-p kept new-denv denv2
                                                  body body-ctx genv)))))

; The functions on values.

(acl2::defun-sk eval-tapp-ll-ok (funval tval limit)
  (forall (new-funval w genv)
          (b* ((val (eval-tapp funval tval limit)))
            (implies (and (not (reserrp val))
                          (expr-value-ll-related-p new-funval funval w genv)
                          (expr-value-wfp funval)
                          (expr-value-wfp new-funval))
                     (eval-tapp-ll-reaches-p new-funval tval val genv)))))

(acl2::defun-sk eval-tapp-list-ll-ok (funvals tval limit)
  (forall (new-funvals ws genv)
          (b* ((vals (eval-tapp-list funvals tval limit)))
            (implies (and (not (reserrp vals))
                          (expr-value-list-ll-related-p new-funvals funvals ws
                                                        genv)
                          (expr-value-list-wfp funvals)
                          (expr-value-list-wfp new-funvals))
                     (eval-tapp-list-ll-reaches-p new-funvals tval vals
                                                  genv)))))

(acl2::defun-sk eval-tappn-ll-ok (funval args denv limit)
  (forall (new-funval w new-denv genv)
