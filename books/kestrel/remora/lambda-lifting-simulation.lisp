            eval-unbox-ll-ok eval-unbox-ll-ok-necc
            eval-unbox-ll-reaches-p eval-unbox-ll-reaches-p-suff))

; An empty vector: the result depends only on the target and the type.

(defruled eval-unbox-of-vector-empty-indep
  (implies (and (equal (expr-value-kind tg) :vector-empty)
                (posp l)
                (posp l2))
           (equal (eval-unbox tg is v2 b2 ty d2 l2)
                  (eval-unbox tg is v b ty d l)))
  :expand ((eval-unbox tg is v2 b2 ty d2 l2)
           (eval-unbox tg is v b ty d l)))

(defun ll-unbox-empty-witness (tg ty)
  (declare (xargs :verify-guards nil))
  (ll-empty-dim-witness
   (append (expr-value-vector-empty->dims tg)
           (if (equal (type-value-kind ty) :array)
               (type-value-array->dims ty)
             nil))))

(defruled eval-unbox-of-vector-empty-related
  (implies (and (equal (expr-value-kind tg) :vector-empty)
                (not (reserrp (eval-unbox tg is v b ty d l))))
           (expr-value-ll-related-p (eval-unbox tg is v b ty d l)
                                    (eval-unbox tg is v b ty d l)
                                    (ll-unbox-empty-witness tg ty) genv))
  :expand ((eval-unbox tg is v b ty d l))
  :enable (expr-value-ll-related-p-of-empty-dim)
  :disable (expr-value-with-empty-dim ll-empty-dim-witness))

(defruled eval-unbox-ll-reaches-p-when-vector-empty
  (implies (and (%ubx-hyps)
                (equal (expr-value-kind target) :vector-empty)
