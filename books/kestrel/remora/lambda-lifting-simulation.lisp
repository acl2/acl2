        (:instance expr-value-ll-related-p-of-lifted-closure
                   (lam (%lam))
                   (fvx (expr-free-expr-vars x))
                   (fvv (atom-free-expr-vars
                         (make-atom-lambda/lambdan pa ba ta))))
        (:instance eval-expr-ll-reaches-p-suff
                   (new-expr (ll-context-new-expr x ctx))
                   (limit2 (+ 7 (len (%fve))))
                   (w (ll-value-witness-lambda (%ictx) (cdr (%ps)) t (%dw2)))
                   (val (eval-expr x denv limit))))
  :in-theory (disable ll-lambda-parts ll-expr lambda-closure apply-to-names
                      eval-expr expr-value-ll-related-p expr-denv-ll-related-p
                      ll-context-ok-p ll-context-new-expr
                      eval-expr-ll-reaches-p eval-expr-ll-reaches-p-suff
                      string-expr-value-map-ll-related-p
