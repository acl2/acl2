        atomlam-params-facts
        atomlam-inner-replacements
        atomlam-aps
        (:instance lifted-inner-lmap-keys (ba '(:var "")) (ta nil))
        (:instance ll-lambda-parts-locals (params pa) (body '(:var ""))
