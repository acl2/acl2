; Binders that are not local: the part of an expression, or the body of a
; binder, in a context with the names bound by the binder made local.

(defruled intersectp-equal-commute-local
  (iff (intersectp-equal x y) (intersectp-equal y x))
  :induct (len x)
  :enable (intersectp-equal acl2::intersectp-equal-of-cons-right))

(defruled not-intersectp-when-no-duplicatesp-append-local
  (implies (no-duplicatesp-equal (append a b))
           (not (intersectp-equal a b)))
  :induct (len a)
  :enable (intersectp-equal))

(defruled not-intersectp-when-subsetp-local
  (implies (and (not (intersectp-equal bx l))
                (subsetp-equal bi bx))
           (not (intersectp-equal bi l)))
  :induct (len bi)
  :enable (intersectp-equal subsetp-equal acl2::intersectp-member))

(defruled not-intersectp-when-new-locals
  (implies (and (not (intersectp-equal bx locals))
                (subsetp-equal bi bx)
                (not (intersectp-equal bi pre))
                (subsetp-equal new-locals (append pre locals)))
           (not (intersectp-equal bi new-locals)))
  :induct (len bi)
  :enable (intersectp-equal subsetp-equal acl2::intersectp-member
           acl2::subsetp-member))

(defruled not-intersectp-binders-of-inner
  (implies (and (not (intersectp-equal bx locals))
                (no-duplicatesp-equal bx)
                (equal bx (append pre bi))
                (set::setp locals))
           (not (intersectp-equal bi (set::union (set::mergesort pre) locals))))
  :use ((:instance not-intersectp-when-new-locals
                   (new-locals (set::union (set::mergesort pre) locals)))
        (:instance subsetp-of-union-mergesort-append (l pre) (s locals))
        (:instance intersectp-equal-commute-local (x bi) (y pre))
        (:instance not-intersectp-when-no-duplicatesp-append-local
                   (a pre) (b bi))))

(defruled not-intersectp-binders-of-unbox-body
  (implies (and (not (intersectp-equal bx locals))
                (no-duplicatesp-equal bx)
                (equal bx (cons v (append a (append b bb))))
                (set::setp locals))
           (not (intersectp-equal bb (set::insert v locals))))
  :use ((:instance not-intersectp-when-new-locals
                   (bi bb) (pre (list v))
                   (new-locals (set::insert v locals)))
        (:instance subsetp-of-insert-cons (a v) (s locals))
        (:instance intersectp-equal-commute-local (x bb) (y (list v))))
  :enable (intersectp-equal))


