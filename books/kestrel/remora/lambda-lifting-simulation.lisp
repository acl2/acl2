; :LET -- syntactic facts.

(define ll-let-lifted ((binds bind-listp) (body exprp) (ctx ll-context-p))
  :returns (lifted bind-listp)
  :short "The definitions lifted out of the bindings of a @(':let')."
  (b* (((ll-context c) ctx)
       ((mv & lifted & & & & &)
        (ll-let-binds binds (expr-expr-var-binders body)
                      c.tenv c.tlets c.locals c.lmap c.used)))
    lifted)
  :verify-guards nil)

(defmacro %llb ()
  '(ll-bind (bind-fix b) (ll-context->tenv ctx) (ll-context->tlets ctx)
            (ll-context->locals ctx) (ll-context->lmap ctx)
            (ll-context->used ctx)))

(defmacro %hoist ()
  '(hoist-local-fun (mv-nth 0 (%llb))
                    (append (bind-list-expr-var-binders rest)
                            (expr-expr-var-binders body))
                    (ll-context->tenv ctx) (ll-context->locals ctx)
                    (mv-nth 2 (%llb))))

(defmacro %step () '(ll-let-step b rest body ctx))

(defmacro %ctx2 () '(mv-nth 2 (%step)))

(defruled ll-let-result-of-cons
  (equal (ll-let-result (cons b rest) body ctx)
         (b* (((mv h nb ctx2) (ll-let-step b rest body ctx))
              ((mv kr bc) (ll-let-result rest body ctx2)))
           (mv (if h kr (cons nb kr)) bc)))
  :enable (ll-let-result ll-let-step)
  :expand ((ll-let-binds (cons b rest) (expr-expr-var-binders body)
                         (ll-context->tenv ctx) (ll-context->tlets ctx)
                         (ll-context->locals ctx) (ll-context->lmap ctx)
                         (ll-context->used ctx))))

(defruled ll-let-lifted-of-cons
  (equal (ll-let-lifted (cons b rest) body ctx)
         (append (mv-nth 1 (%llb))
                 (if (mv-nth 0 (%hoist)) (list (mv-nth 2 (%hoist))) nil)
                 (ll-let-lifted rest body (%ctx2))))
  :enable (ll-let-lifted ll-let-step)
  :expand ((ll-let-binds (cons b rest) (expr-expr-var-binders body)
                         (ll-context->tenv ctx) (ll-context->tlets ctx)
                         (ll-context->locals ctx) (ll-context->lmap ctx)
                         (ll-context->used ctx))))

(defruled ll-let-result-of-nil
  (equal (ll-let-result nil body ctx)
         (mv nil (ll-context-fix ctx)))
  :enable (ll-let-result ll-context-fix)
  :expand ((:free (bb tenv tlets locals lmap used)
            (ll-let-binds nil bb tenv tlets locals lmap used))))

(defruled ll-context-new-expr-of-let-or-body
  (implies (and (bind-listp binds) (exprp body))
           (equal (ll-context-new-expr (let-or-body binds body) ctx)
                  (b* (((mv kept bc) (ll-let-result binds body ctx)))
                    (let-or-body kept (ll-context-new-expr body bc)))))
  :cases ((consp binds))
  :enable (let-or-body ll-context-new-expr ll-let-result)
  :expand ((:free (bb tenv tlets locals lmap used)
            (ll-let-binds nil bb tenv tlets locals lmap used))
           (:free (tenv tlets locals lmap used)
            (ll-expr (expr-let binds body) tenv tlets locals lmap used))))

(defruled ll-context-lifted-of-let-or-body
  (implies (and (bind-listp binds) (exprp body))
           (equal (ll-context-lifted (let-or-body binds body) ctx)
                  (b* (((mv & bc) (ll-let-result binds body ctx)))
                    (append (ll-let-lifted binds body ctx)
                            (ll-context-lifted body bc)))))
  :cases ((consp binds))
  :enable (let-or-body ll-context-lifted ll-let-result ll-let-lifted)
  :expand ((:free (bb tenv tlets locals lmap used)
            (ll-let-binds nil bb tenv tlets locals lmap used))
           (:free (tenv tlets locals lmap used)
            (ll-expr (expr-let binds body) tenv tlets locals lmap used))))

(defruled expr-free-expr-vars-of-let-cons
  (implies (and (bindp b) (bind-listp rest) (exprp body))
           (equal (expr-free-expr-vars (expr-let (cons b rest) body))
                  (set::union (bind-free-expr-vars b)
                              (set::difference
                               (expr-free-expr-vars (let-or-body rest body))
                               (bind-bound-expr-vars b)))))
  :cases ((consp rest))
  :enable (let-or-body set::double-containment
           set::pick-a-point-subset-strategy)
  :expand ((:free (bs) (expr-free-expr-vars (expr-let bs body)))
           (:free (a bs) (bind-list-free-expr-vars (cons a bs)))
           (:free (a bs) (bind-list-bound-expr-vars (cons a bs)))
           (bind-list-free-expr-vars nil)
           (bind-list-bound-expr-vars nil)))

(defruled expr-binder-names-of-let-cons
  (implies (and (bindp b) (bind-listp rest) (exprp body))
           (and (equal (expr-binder-names (expr-let (cons b rest) body))
                       (cons (bind-name b)
                             (append (bind-list-names rest)
                                     (append (bind-binder-names b)
                                             (append
                                              (bind-list-binder-names rest)
                                                     (expr-binder-names
                                                      body))))))
                (equal (expr-binder-names (let-or-body rest body))
                       (append (bind-list-names rest)
                               (append (bind-list-binder-names rest)
                                       (expr-binder-names body))))))
  :cases ((consp rest))
  :enable (let-or-body)
  :expand ((:free (bs) (expr-binder-names (expr-let bs body)))
           (:free (a bs) (bind-list-names (cons a bs)))
           (:free (a bs) (bind-list-binder-names (cons a bs)))
           (bind-list-names nil)
           (bind-list-binder-names nil)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The context after a binding of a :LET.

(defruled var-expr-names-of-names-to-exprs
  (implies (string-listp names)
           (equal (var-expr-names (names-to-exprs names))
                  (mv t names)))
  :induct (len names)
  :enable (var-expr-names names-to-exprs len))

(defruled replacement-parts-of-apply-to-names
  (implies (and (stringp h) (string-listp names))
           (equal (replacement-parts (apply-to-names (expr-var h) names))
                  (mv t h names)))
  :cases ((not (consp names)) (not (consp (cdr names))))
  :use (var-expr-names-of-names-to-exprs)
  :enable (replacement-parts apply-to-names)
  :expand ((names-to-exprs names) (names-to-exprs (cdr names))
           (var-expr-names (names-to-exprs names))
           (var-expr-names (names-to-exprs (cdr names)))
           (len names) (len (cdr names))))

(defruled ll-let-step-fields
  (implies (bindp b)
           (b* (((mv h nb ctx2) (ll-let-step b rest body ctx)))
             (and (equal h (mv-nth 0 (%hoist)))
                  (equal nb (mv-nth 0 (%llb)))
                  (equal (ll-context->tenv ctx2)
                         (mv-nth 0 (extend-tenv-with-let-bind
                                    b (ll-context->tenv ctx)
                                    (ll-context->tlets ctx)
                                    (ll-context->locals ctx))))
                  (equal (ll-context->tlets ctx2)
                         (mv-nth 1 (extend-tenv-with-let-bind
                                    b (ll-context->tenv ctx)
                                    (ll-context->tlets ctx)
                                    (ll-context->locals ctx))))
                  (equal (ll-context->locals ctx2)
                         (set::union (bind-bound-expr-vars b)
                                     (ll-context->locals ctx)))
                  (equal (ll-context->lmap ctx2)
                         (if (mv-nth 0 (%hoist))
                             (omap::update (mv-nth 1 (%hoist))
                                           (mv-nth 3 (%hoist))
                                           (ll-context->lmap ctx))
                           (string-expr-map-remove-keys
                            (bind-bound-expr-vars b)
                            (ll-context->lmap ctx))))
                  (equal (ll-context->used ctx2) (mv-nth 4 (%hoist))))))
  :enable (ll-let-step))

(defruled hoist-local-fun-replacement
  (implies (mv-nth 0 (hoist-local-fun b rebound tenv locals used))
           (equal (mv-nth 3 (hoist-local-fun b rebound tenv locals used))
                  (apply-to-names
                   (expr-var
                    (fresh-expr-var (bind-fun->var b) (string-sfix used)))
                   (set::intersect (bind-free-expr-vars b) locals))))
  :enable (hoist-local-fun))

(defruled hoist-local-fun-def
  (implies (mv-nth 0 (hoist-local-fun b rebound tenv locals used))
           (and (equal (bind-kind (mv-nth 2 (hoist-local-fun b rebound tenv
                                                              locals used)))
                       :fun)
                (equal (bind-fun->var (mv-nth 2 (hoist-local-fun b rebound tenv
                                                                 locals used)))
                       (fresh-expr-var (bind-fun->var b) (string-sfix used)))
                (consp (bind-fun->params (mv-nth 2 (hoist-local-fun
                                                    b rebound tenv locals
                                                    used))))))
  :enable (hoist-local-fun))

(defruled ll-bind-var-when-fun
  (implies (equal (bind-kind b) :fun)
           (and (equal (bind-kind (mv-nth 0 (ll-bind b tenv tlets locals lmap
                                                     used)))
                       :fun)
                (equal (bind-fun->var (mv-nth 0 (ll-bind b tenv tlets locals
                                                         lmap used)))
                       (bind-fun->var b))
                (equal (bind-fun->params (mv-nth 0 (ll-bind b tenv tlets locals
                                                            lmap used)))
                       (bind-fun->params b))
                (equal (bind-fun->type? (mv-nth 0 (ll-bind b tenv tlets locals
                                                           lmap used)))
                       (bind-fun->type? b))))
  :expand ((ll-bind b tenv tlets locals lmap used)))

(defruled ll-bind-kind
  (equal (bind-kind (mv-nth 0 (ll-bind b tenv tlets locals lmap used)))
         (bind-kind b))
  :expand ((ll-bind b tenv tlets locals lmap used)))

(defruled assoc-of-extend-tenv-with-let-bind-other
  (implies (not (set::in v (bind-bound-expr-vars b)))
           (equal (omap::assoc
                   v (mv-nth 0 (extend-tenv-with-let-bind b tenv tlets locals)))
                  (omap::assoc v (string-type-map-fix tenv))))
  :enable (omap::assoc-when-assoc-tail omap::assoc-when-emptyp
           (:t omap::tail-when-emptyp) set::in-tail set::tail-when-emptyp
           set::emptyp-subset-2
           extend-tenv-with-let-bind omap::assoc-of-update*))

(defruled in-tlets-of-extend-tenv-with-let-bind-other
  (implies (not (set::in v (bind-bound-expr-vars b)))
           (equal (set::in
                   v (mv-nth 1 (extend-tenv-with-let-bind b tenv tlets locals)))
                  (set::in v (string-sfix tlets))))
  :enable (omap::assoc-when-assoc-tail omap::assoc-when-emptyp
           (:t omap::tail-when-emptyp) set::in-tail set::tail-when-emptyp
           set::emptyp-subset-2
           extend-tenv-with-let-bind omap::in-of-keys-to-assoc))

(defruled keys-of-extend-tenv-with-let-bind-at
  (implies (and (set::subset (omap::keys (string-type-map-fix tenv)) locals)
                (set::in k (omap::keys
                            (mv-nth 0 (extend-tenv-with-let-bind b tenv tlets
                                                                 locals2))))
                (not (set::in k (bind-bound-expr-vars b))))
           (set::in k locals))
  :use ((:instance assoc-of-extend-tenv-with-let-bind-other
                   (v k) (locals locals2))
        (:instance omap::in-of-keys-to-assoc
                   (omap::key k)
                   (omap::map (mv-nth 0 (extend-tenv-with-let-bind
                                         b tenv tlets locals2))))
        (:instance omap::in-of-keys-to-assoc
                   (omap::key k)
                   (omap::map (string-type-map-fix tenv)))
        (:instance set::subset-in (a k)
                   (x (omap::keys (string-type-map-fix tenv)))
                   (y locals))))

(defruled keys-of-extend-tenv-with-let-bind
  (implies (set::subset (omap::keys (string-type-map-fix tenv)) locals)
           (set::subset (omap::keys
                         (mv-nth 0 (extend-tenv-with-let-bind b tenv tlets
                                                              locals2)))
                        (set::union (bind-bound-expr-vars b) locals)))
  :enable (set::pick-a-point-subset-strategy
           keys-of-extend-tenv-with-let-bind-at))

(defruled no-duplicatesp-of-drop-middle
  (implies (no-duplicatesp-equal (append a (append b c)))
           (and (no-duplicatesp-equal (append a c))
                (not (intersectp-equal b (append a c)))))
  :induct (len a)
  :enable (len
           acl2::intersectp-equal-of-cons-right)
  :hints (("Subgoal *1/2"
           :use ((:instance not-intersectp-when-no-duplicatesp-append-local
                            (a b) (b c))))))

; The binders of a :LET and of what remains of it after its first binding.

(defruled binders-perm-facts
  (b* ((bx (cons nm (append n (append bb (append r e)))))
       (by (append n (append r e))))
    (and (subsetp-equal by bx)
         (member-equal nm bx)
         (subsetp-equal bb bx)
         (implies (no-duplicatesp-equal bx)
                  (and (no-duplicatesp-equal by)
                       (not (member-equal nm by))
                       (not (intersectp-equal bb by))))))
  :use ((:instance no-duplicatesp-of-drop-middle
                   (a n) (b bb) (c (append r e)))))

(defruled let-binders-facts
  (implies (and (bindp b) (bind-listp rest) (exprp body))
           (b* ((bx (expr-binder-names (expr-let (cons b rest) body)))
                (by (expr-binder-names (let-or-body rest body))))
             (and (subsetp-equal by bx)
                  (member-equal (bind-name b) bx)
                  (subsetp-equal (bind-binder-names b) bx)
                  (implies (no-duplicatesp-equal bx)
                           (and (no-duplicatesp-equal by)
                                (not (member-equal (bind-name b) by))
                                (not (intersectp-equal (bind-binder-names b)
                                                       by)))))))
  :use ((:instance binders-perm-facts
                   (nm (bind-name b))
                   (n (bind-list-names rest))
                   (bb (bind-binder-names b))
                   (r (bind-list-binder-names rest))
                   (e (expr-binder-names body))))
  :enable (expr-binder-names-of-let-cons))

(defmacro %step-hyps ()
  '(and (bindp b) (bind-listp rest) (exprp body)
        (ll-context-ok-p (expr-let (cons b rest) body) ctx genv)))

(defmacro %bx () '(expr-binder-names (expr-let (cons b rest) body)))

(defmacro %by () '(expr-binder-names (let-or-body rest body)))

(defruled let-step-used
  (implies (bindp b)
           (and (set::subset (ll-context->used ctx) (mv-nth 2 (%llb)))
                (set::subset (mv-nth 2 (%llb)) (ll-context->used (%ctx2)))
                (set::subset (ll-context->used ctx)
                             (ll-context->used (%ctx2)))))
  :use (ll-let-step-fields
        (:instance used-of-ll-bind
                   (x b) (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx))
                   (used (ll-context->used ctx))))
  :cases ((mv-nth 0 (%hoist)))
  :enable (set::subset-transitive)
  :disable (ll-bind hoist-local-fun))

(defruled bind-bound-expr-vars-subset-of-name
  (set::subset (bind-bound-expr-vars b) (set::insert (bind-name b) nil))
  :enable (bind-bound-expr-vars bind-name))

(defruled let-step-name-in-used
  (implies (%step-hyps)
           (and (set::in (bind-name b) (ll-context->used ctx))
                (set::subset (bind-bound-expr-vars b)
                             (ll-context->used ctx))))
  :use ((:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        let-binders-facts
        bind-bound-expr-vars-subset-of-name
        (:instance in-when-member-of-subsetp
                   (e (bind-name b)) (l (%bx)) (s (ll-context->used ctx)))
        (:instance set::subset-transitive
                   (x (bind-bound-expr-vars b))
                   (y (set::insert (bind-name b) nil))
                   (z (ll-context->used ctx)))))

(defruled let-step-locals
  (implies (%step-hyps)
           (and (equal (ll-context->locals (%ctx2))
                       (set::union (bind-bound-expr-vars b)
                                   (ll-context->locals ctx)))
                (set::subset (ll-context->locals (%ctx2))
                             (ll-context->used (%ctx2)))))
  :use (ll-let-step-fields let-step-used let-step-name-in-used
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance set::subset-transitive
                   (x (bind-bound-expr-vars b)) (y (ll-context->used ctx))
                   (z (ll-context->used (%ctx2))))
        (:instance set::subset-transitive
                   (x (ll-context->locals ctx)) (y (ll-context->used ctx))
                   (z (ll-context->used (%ctx2)))))
  :enable (subset-of-union)
  :disable (ll-bind hoist-local-fun))

(defruled let-step-lifted
  (implies (and (bindp b) (bind-listp rest) (exprp body))
           (equal (ll-context-lifted (expr-let (cons b rest) body) ctx)
                  (append (mv-nth 1 (%llb))
                          (if (mv-nth 0 (%hoist))
                              (list (mv-nth 2 (%hoist)))
                            nil)
                          (ll-context-lifted (let-or-body rest body) (%ctx2)))))
  :use ((:instance ll-context-lifted-of-let-or-body (binds (cons b rest)))
        (:instance ll-context-lifted-of-let-or-body (binds rest) (ctx (%ctx2))))
  :enable (let-or-body ll-let-lifted-of-cons ll-let-result-of-cons)
  :disable (ll-bind hoist-local-fun ll-let-step))

(defmacro %name () '(fresh-expr-var (bind-name b) (mv-nth 2 (%llb))))

(defmacro %hfv () '(set::intersect (bind-free-expr-vars (mv-nth 0 (%llb)))
                                   (ll-context->locals ctx)))

(defruled let-step-hoisted-facts
  (implies (and (bindp b) (mv-nth 0 (%step)))
           (and (equal (bind-kind b) :fun)
                (equal (bind-fun->var b) (bind-name b))
                (equal (bind-bound-expr-vars b)
                       (set::insert (bind-name b) nil))
                (equal (ll-context->lmap (%ctx2))
                       (omap::update (bind-name b)
                                     (apply-to-names (expr-var (%name)) (%hfv))
                                     (ll-context->lmap ctx)))
                (equal (ll-context->used (%ctx2))
                       (set::insert (%name) (mv-nth 2 (%llb))))
                (not (set::in (%name) (mv-nth 2 (%llb))))
                (equal (mv-nth 1 (%step)) (mv-nth 0 (%llb)))
                (equal (bind-kind (mv-nth 2 (%hoist))) :fun)
                (equal (bind-fun->var (mv-nth 2 (%hoist))) (%name))
                (consp (bind-fun->params (mv-nth 2 (%hoist))))
                (mv-nth 0 (%hoist))))
  :use (ll-let-step-fields
        (:instance hoist-local-fun-when-hoisted
                   (b (mv-nth 0 (%llb)))
                   (rebound (append (bind-list-expr-var-binders rest)
                                    (expr-expr-var-binders body)))
                   (tenv (ll-context->tenv ctx))
                   (locals (ll-context->locals ctx))
                   (used (mv-nth 2 (%llb))))
        (:instance hoist-local-fun-replacement
                   (b (mv-nth 0 (%llb)))
                   (rebound (append (bind-list-expr-var-binders rest)
                                    (expr-expr-var-binders body)))
                   (tenv (ll-context->tenv ctx))
                   (locals (ll-context->locals ctx))
                   (used (mv-nth 2 (%llb))))
        (:instance hoist-local-fun-def
                   (b (mv-nth 0 (%llb)))
                   (rebound (append (bind-list-expr-var-binders rest)
                                    (expr-expr-var-binders body)))
                   (tenv (ll-context->tenv ctx))
                   (locals (ll-context->locals ctx))
                   (used (mv-nth 2 (%llb))))
        (:instance ll-bind-kind
                   (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx))
                   (used (ll-context->used ctx)))
        (:instance ll-bind-var-when-fun
                   (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx))
                   (used (ll-context->used ctx)))
        (:instance fresh-expr-var-is-fresh
                   (prefix (bind-name b)) (used (mv-nth 2 (%llb)))))
  :enable (bind-name bind-bound-expr-vars-when-fun)
  :disable (ll-bind hoist-local-fun ll-let-step))

(defruled let-step-not-hoisted-facts
  (implies (and (bindp b) (not (mv-nth 0 (%step))))
           (and (equal (ll-context->lmap (%ctx2))
                       (string-expr-map-remove-keys (bind-bound-expr-vars b)
                                                    (ll-context->lmap ctx)))
                (equal (ll-context->used (%ctx2)) (mv-nth 2 (%llb)))
                (equal (mv-nth 1 (%step)) (mv-nth 0 (%llb)))
                (not (mv-nth 0 (%hoist)))))
  :use (ll-let-step-fields
        (:instance hoist-local-fun-when-not-hoisted
                   (b (mv-nth 0 (%llb)))
                   (rebound (append (bind-list-expr-var-binders rest)
                                    (expr-expr-var-binders body)))
                   (tenv (ll-context->tenv ctx))
                   (locals (ll-context->locals ctx))
                   (used (mv-nth 2 (%llb)))))
  :disable (ll-bind hoist-local-fun ll-let-step))

(defruled let-step-name-fresh
  (implies (and (%step-hyps) (mv-nth 0 (%step)))
           (and (not (set::in (%name) (ll-context->locals ctx)))
                (not (equal (%name) (bind-name b)))
                (not (set::in (%name) (ll-context->locals (%ctx2))))
                (not (member-equal (%name) (%bx)))
                (not (member-equal (%name) (%by)))))
  :use (let-step-hoisted-facts let-step-used let-step-name-in-used
        let-step-locals let-binders-facts
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance set::subset-transitive
                   (x (ll-context->locals ctx)) (y (ll-context->used ctx))
                   (z (mv-nth 2 (%llb))))
        (:instance set::subset-in (a (%name)) (x (ll-context->locals ctx))
                   (y (mv-nth 2 (%llb))))
        (:instance set::subset-in (a (bind-name b)) (x (ll-context->used ctx))
                   (y (mv-nth 2 (%llb))))
        (:instance subsetp-equal-when-subset-of-set
                   (l (%bx)) (s1 (ll-context->used ctx))
                   (s2 (mv-nth 2 (%llb))))
        (:instance in-when-member-of-subsetp
                   (e (%name)) (l (%bx)) (s (mv-nth 2 (%llb))))
        (:instance acl2::subsetp-member (a (%name)) (x (%by)) (y (%bx))))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var))

(defruled let-step-hoisted-def-bound
  (implies (and (%step-hyps) (mv-nth 0 (%step)))
           (not (reserrp (expr-denv-lookup-expr (%name) genv))))
  :use (let-step-hoisted-facts let-step-lifted
        (:instance ll-context-ok-p-facts-nb (x (expr-let (cons b rest) body)))
        (:instance lookup-of-lifted-def-in-genv
                   (defs (ll-context-lifted (expr-let (cons b rest) body) ctx))
                   (def (mv-nth 2 (%hoist))))
        (:instance lambda-closure-ok-when-eval-bind-ok
                   (bind (mv-nth 2 (%hoist))) (denv genv) (limit 1))
        (:instance ll-defs-bound-p-member-eval-bind-ok
                   (defs (ll-context-lifted (expr-let (cons b rest) body) ctx))
                   (def (mv-nth 2 (%hoist)))))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var lambda-closure
            ll-defs-bound-p)
  :enable (let-step-hoisted-facts let-step-lifted))

(defrule string-listp-of-intersect-local
  (implies (string-setp a)
           (string-listp (set::intersect a b)))
  :enable (acl2::string-listp-when-string-setp))

(defruled subsetp-of-intersect-right-local
  (implies (set::setp b)
           (subsetp-equal (set::intersect a b) b))
  :use ((:instance subsetp-equal-when-subset-of-set
                   (l (set::intersect a b)) (s1 (set::intersect a b)) (s2 b))))

(defruled let-step-new-replacement-ok
  (implies (and (%step-hyps) (mv-nth 0 (%step)))
           (ll-replacement-ok-p (apply-to-names (expr-var (%name)) (%hfv))
                                (ll-context->locals (%ctx2)) (%by) genv))
  :use (let-step-name-fresh let-step-hoisted-def-bound let-step-locals
        let-binders-facts
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance not-intersectp-when-subsetp-local
                   (bx (%bx)) (l (ll-context->locals ctx)) (bi (%by)))
        (:instance not-intersectp-when-subsetp-local
                   (bx (ll-context->locals ctx)) (l (%by)) (bi (%hfv)))
        (:instance intersectp-equal-commute-local
                   (x (%by)) (y (ll-context->locals ctx)))
        (:instance subsetp-equal-when-subset-of-set
                   (l (%hfv)) (s1 (%hfv))
                   (s2 (ll-context->locals (%ctx2))))
        (:instance subsetp-of-intersect-right-local
                   (a (bind-free-expr-vars (mv-nth 0 (%llb))))
                   (b (ll-context->locals ctx))))
  :enable (ll-replacement-ok-p subset-of-union-right-2
           replacement-parts-of-apply-to-names)
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var apply-to-names
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled insert-of-nil-local
  (equal (set::insert a nil) (list a))
  :enable (set::insert))

(defruled union-of-singleton-local
  (implies (set::setp s)
           (equal (set::union (set::insert a nil) s)
                  (set::insert a s))))

; The replacement at each key of the updated map: the new one, or an old one
; under one more local; the facts are combined at the level of variables.

(defruled let-step-replacement-at-hoisted-combine
  (implies (and (equal lmap2 (omap::update n r lmap))
                (equal locals2 (set::union bbv locals))
                (equal bbv (set::insert n nil))
                (omap::assoc k lmap2)
                (ll-replacement-ok-p r locals2 by genv)
                (lmap-replacements-ok-p lmap locals bx genv)
                (string-expr-mapp lmap)
                (string-setp locals)
                (string-listp bx)
                (string-listp by)
                (stringp n)
                (member-equal n bx)
                (subsetp-equal by bx))
           (ll-replacement-ok-p (cdr (omap::assoc k lmap2)) locals2 by genv))
  :use ((:instance ll-replacement-ok-p-when-lmap-replacements-ok-p
                   (pnames bx))
        (:instance ll-replacement-ok-p-of-more-locals
                   (repl (cdr (omap::assoc k lmap)))
                   (pnames bx) (more (list n)) (pnames2 by)))
  :enable (omap::assoc-of-update)
  :disable (ll-replacement-ok-p lmap-replacements-ok-p)
  :expand ((set::mergesort (list n))))

(defruled let-step-replacement-at-hoisted
  (implies (and (%step-hyps)
                (mv-nth 0 (%step))
                (omap::assoc k (ll-context->lmap (%ctx2))))
           (ll-replacement-ok-p (cdr (omap::assoc k (ll-context->lmap (%ctx2))))
                                (ll-context->locals (%ctx2)) (%by) genv))
  :use (let-step-hoisted-facts let-step-locals let-step-new-replacement-ok
        let-binders-facts
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance let-step-replacement-at-hoisted-combine
                   (lmap2 (ll-context->lmap (%ctx2)))
                   (locals2 (ll-context->locals (%ctx2)))
                   (bbv (bind-bound-expr-vars b))
                   (n (bind-name b))
                   (r (apply-to-names (expr-var (%name)) (%hfv)))
                   (lmap (ll-context->lmap ctx))
                   (locals (ll-context->locals ctx))
                   (bx (%bx)) (by (%by))))
  :in-theory (union-theories (theory 'minimal-theory)
                             '(return-type-of-expr-binder-names.result
                               string-expr-mapp-of-ll-context->lmap
                               string-setp-of-ll-context->locals
                               stringp-of-bind-name)))

(defruled let-step-replacements-hoisted
  (implies (and (%step-hyps) (mv-nth 0 (%step)))
           (lmap-replacements-ok-p (ll-context->lmap (%ctx2))
                                   (ll-context->locals (%ctx2)) (%by) genv))
  :use ((:instance lmap-replacements-ok-p-when-pointwise
                   (lmap (ll-context->lmap (%ctx2)))
                   (locals (ll-context->locals (%ctx2)))
                   (pnames (%by)))
        (:instance let-step-replacement-at-hoisted
                   (k (lmap-replacements-pointwise-p-witness
                       (ll-context->lmap (%ctx2))
                       (ll-context->locals (%ctx2)) (%by) genv))))
  :expand ((lmap-replacements-pointwise-p
            (ll-context->lmap (%ctx2)) (ll-context->locals (%ctx2)) (%by) genv))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var apply-to-names
            ll-replacement-ok-p lmap-replacements-ok-p))

(defrule bind-bound-expr-vars-is-name-local
  (implies (not (set::emptyp (bind-bound-expr-vars b)))
           (equal (bind-bound-expr-vars b)
                  (set::insert (bind-name b) nil)))
  :rule-classes nil
  :enable (bind-bound-expr-vars bind-name))

(defruled let-step-replacements-not-hoisted
  (implies (and (%step-hyps) (not (mv-nth 0 (%step))))
           (lmap-replacements-ok-p (ll-context->lmap (%ctx2))
                                   (ll-context->locals (%ctx2)) (%by) genv))
  :cases ((set::emptyp (bind-bound-expr-vars b)))
  :use (let-step-not-hoisted-facts let-step-locals let-binders-facts
        bind-bound-expr-vars-subset-of-name
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance unbox-replacements
                   (v0 (bind-name b)) (pnames (%bx)) (pnames2 (%by)))
        (:instance lmap-replacements-ok-p-when-fewer-pnames
                   (lmap (ll-context->lmap ctx))
                   (locals (ll-context->locals ctx))
                   (pnames (%bx)) (pnames2 (%by)))
        (:instance union-of-singleton-local
                   (a (bind-name b)) (s (ll-context->locals ctx))))
  :enable (insert-of-nil-local)
  :hints (("Subgoal 2"
           :use ((:instance bind-bound-expr-vars-is-name-local)))
          ("Subgoal 1"
           :use ((:instance bind-bound-expr-vars-nil-local))
           :in-theory (enable string-expr-map-remove-keys)))
  :prep-lemmas
  ((defrule bind-bound-expr-vars-nil-local
     (implies (set::emptyp (bind-bound-expr-vars b))
              (equal (bind-bound-expr-vars b) nil))
     :rule-classes nil
     :enable (bind-bound-expr-vars bind-name)))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var apply-to-names
            ll-replacement-ok-p lmap-replacements-ok-p))

(defruled let-step-lmap-closed
  (implies (%step-hyps)
           (string-expr-map-closed-p (ll-context->lmap (%ctx2))))
  :cases ((mv-nth 0 (%step)))
  :use (let-step-hoisted-facts let-step-not-hoisted-facts
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance lmap-closed-p-when-string-expr-map-closed-p
                   (m (ll-context->lmap ctx)))
        (:instance string-expr-map-closed-p-when-lmap-closed-p
                   (m (ll-context->lmap (%ctx2))))
        (:instance lmap-closed-p-of-update
                   (lmap (ll-context->lmap ctx)) (name (bind-name b))
                   (e (apply-to-names (expr-var (%name)) (%hfv))))
        (:instance lmap-closed-p-of-string-expr-map-remove-keys
                   (keys (bind-bound-expr-vars b))
                   (lmap (ll-context->lmap ctx))))
  :expand ((:free (n) (expr-free-type-vars (expr-var n)))
           (:free (n) (expr-free-ispace-vars (expr-var n))))
  :disable
  (ll-bind hoist-local-fun ll-let-step fresh-expr-var apply-to-names
   lmap-closed-p-of-update lmap-closed-p-of-string-expr-map-remove-keys))

(defruled let-step-lmap-keys
  (implies (%step-hyps)
           (set::subset (omap::keys (ll-context->lmap (%ctx2)))
                        (ll-context->locals (%ctx2))))
  :cases ((mv-nth 0 (%step)))
  :use (let-step-hoisted-facts let-step-not-hoisted-facts let-step-locals
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body))))
  :enable (set::pick-a-point-subset-strategy in-keys-of-remove-keys
           set::subset-in)
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var apply-to-names))

(defruled not-intersectp-bind-bound-expr-vars-local
  (implies (not (member-equal (bind-name b) l))
           (not (intersectp-equal l (bind-bound-expr-vars b))))
  :enable (bind-bound-expr-vars bind-name))

(defruled let-step-binders-not-local
  (implies (%step-hyps)
           (not (intersectp-equal (%by) (ll-context->locals (%ctx2)))))
  :use (let-step-locals let-binders-facts
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance not-intersectp-bind-bound-expr-vars-local (l (%by)))
        (:instance not-intersectp-when-new-locals
                   (bx (%bx)) (locals (ll-context->locals ctx)) (bi (%by))
                   (pre (bind-bound-expr-vars b))
                   (new-locals (ll-context->locals (%ctx2))))
        (:instance subsetp-of-union-mergesort-append
                   (l (bind-bound-expr-vars b)) (s (ll-context->locals ctx))))
  :disable (ll-bind hoist-local-fun ll-let-step))

(defruled let-step-defs-bound
  (implies (and (bindp b) (bind-listp rest) (exprp body)
                (ll-defs-bound-p
                 (ll-context-lifted (expr-let (cons b rest) body)
                                                    ctx)
                                 genv))
           (ll-defs-bound-p (ll-context-lifted (let-or-body rest body) (%ctx2))
                            genv))
  :enable (let-step-lifted)
  :disable (ll-bind hoist-local-fun ll-let-step))

(defruled ll-context-ok-p-of-let-step
  (implies (%step-hyps)
           (ll-context-ok-p (let-or-body rest body) (%ctx2) genv))
  :use (let-step-locals let-step-used let-step-defs-bound let-binders-facts
        let-step-replacements-hoisted let-step-replacements-not-hoisted
        let-step-lmap-closed let-step-lmap-keys let-step-binders-not-local
        ll-let-step-fields
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance keys-of-extend-tenv-with-let-bind
                   (tenv (ll-context->tenv ctx)) (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (locals2 (ll-context->locals ctx)))
        (:instance subsetp-equal-when-subset-of-set
                   (l (%bx)) (s1 (ll-context->used ctx))
                   (s2 (ll-context->used (%ctx2))))
        (:instance acl2::subsetp-trans
                   (x (%by)) (y (%bx)) (z (ll-context->used (%ctx2)))))
  :expand ((ll-context-ok-p (let-or-body rest body) (%ctx2) genv))
  :disable (ll-bind hoist-local-fun ll-let-step fresh-expr-var apply-to-names
            ll-context-ok-p))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The relation after a kept binding of an expression variable, excluding it.

(acl2::defun-sk tenv-agrees-off-p (tenv2 tenv v0)
  (forall n
          (implies (and (stringp n) (not (equal n v0)))
                   (equal (name-to-type-option n tenv2)
                          (name-to-type-option n tenv)))))

(local (in-theory (disable tenv-agrees-off-p)))

(defruled value-meets-required-type-p-when-same-type-option
  (implies (equal (name-to-type-option v tenv2) (name-to-type-option v tenv))
           (equal (value-meets-required-type-p val v tenv2)
                  (value-meets-required-type-p val v tenv)))
  :enable (value-meets-required-type-p var-required-type))

(defruled value-has-inferred-type-p-when-same-type-option
  (implies (equal (name-to-type-option v tenv2) (name-to-type-option v tenv))
           (equal (value-has-inferred-type-p val v tenv2)
                  (value-has-inferred-type-p val v tenv)))
  :enable (value-has-inferred-type-p))

(defmacro %lctx-hyps ()
  '(and (tenv-agrees-off-p (ll-context->tenv ctx2) (ll-context->tenv ctx) v0)
        (equal (set::delete v0 (ll-context->tlets ctx2))
               (set::delete v0 (ll-context->tlets ctx)))
        (equal (ll-context->locals ctx2)
               (set::insert v0 (ll-context->locals ctx)))
        (equal (ll-context->lmap ctx2)
               (string-expr-map-remove-keys (list v0) (ll-context->lmap ctx)))
        (stringp v0)))

(defruled lctx-facts-at-other
  (implies (and (%lctx-hyps)
                (stringp v)
                (not (equal v v0)))
           (and (equal (omap::assoc v (ll-context->lmap ctx2))
                       (omap::assoc v (ll-context->lmap ctx)))
                (equal (set::in v (ll-context->tlets ctx2))
                       (set::in v (ll-context->tlets ctx)))
                (equal (set::in v (ll-context->locals ctx2))
                       (set::in v (ll-context->locals ctx)))
                (equal (name-to-type-option v (ll-context->tenv ctx2))
                       (name-to-type-option v (ll-context->tenv ctx)))))
  :use ((:instance tenv-agrees-off-p-necc
                   (tenv2 (ll-context->tenv ctx2)) (tenv (ll-context->tenv ctx))
                   (n v))
        (:instance set::delete-in
                   (a v) (b v0) (x (ll-context->tlets ctx2)))
        (:instance set::delete-in
                   (a v) (b v0) (x (ll-context->tlets ctx))))
  :enable (string-expr-map-remove-keys)
  :disable (set::delete-in tenv-agrees-off-p))

(defruled ll-var-types-ok-p-of-lctx
  (implies (and (%lctx-hyps)
                (stringp v)
                (not (equal v v0))
                (ll-var-types-ok-p v val ctx))
           (ll-var-types-ok-p v val ctx2))
  :use (lctx-facts-at-other
        (:instance value-meets-required-type-p-when-same-type-option
                   (tenv2 (ll-context->tenv ctx2)) (tenv
                                                    (ll-context->tenv ctx)))
        (:instance value-has-inferred-type-p-when-same-type-option
                   (tenv2 (ll-context->tenv ctx2)) (tenv
                                                    (ll-context->tenv ctx))))
  :enable (ll-var-types-ok-p)
  :disable (tenv-agrees-off-p set::intersect-in
            value-meets-required-type-p value-has-inferred-type-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled ll-var-referred-ok-p-of-lctx
  (implies (and (%lctx-hyps)
                (stringp v)
                (not (equal v v0))
                (ll-var-referred-ok-p v val new-denv nfv ctx dw genv)
                (implies (omap::assoc v (ll-context->lmap ctx))
                         (not (set::in v0 (expr-free-expr-vars
                                           (cdr (omap::assoc
                                                 v (ll-context->lmap ctx)))))))
                (set::subset (set::delete v0 nfv2) nfv))
           (ll-var-referred-ok-p v val new-denv nfv2 ctx2 dw genv))
  :use (lctx-facts-at-other
        (:instance set::subset-in (a v) (x (set::delete v0 nfv2)) (y nfv))
        (:instance intersect-of-insert-when-not-in-local
                   (s (expr-free-expr-vars
                       (cdr (omap::assoc v (ll-context->lmap ctx)))))
                   (l (ll-context->locals ctx)))
        (:instance difference-of-insert-when-not-in-local
                   (s (expr-free-expr-vars
                       (cdr (omap::assoc v (ll-context->lmap ctx)))))
                   (l (ll-context->locals ctx)))
        (:instance subset-when-subset-of-delete-local
                   (a (set::intersect
                       (expr-free-expr-vars
                        (cdr (omap::assoc v (ll-context->lmap ctx))))
                       (ll-context->locals ctx))))
        (:instance not-in-intersect-when-not-in-local
                   (s (expr-free-expr-vars
                       (cdr (omap::assoc v (ll-context->lmap ctx)))))
                   (l (ll-context->locals ctx))))
  :enable (ll-var-referred-ok-p)
  :disable (tenv-agrees-off-p set::intersect-in
            value-meets-required-type-p value-has-inferred-type-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

(defruled ll-var-ok-p-of-lctx
  (implies (and (%lctx-hyps)
                (stringp v)
                (not (equal v v0))
                (ll-var-ok-p v val new-denv nfv ctx dw genv)
                (implies (omap::assoc v (ll-context->lmap ctx))
                         (not (set::in v0 (expr-free-expr-vars
                                           (cdr (omap::assoc
                                                 v (ll-context->lmap ctx)))))))
                (set::subset (set::delete v0 nfv2) nfv))
           (ll-var-ok-p v val new-denv nfv2 ctx2 dw genv))
  :use (ll-var-types-ok-p-of-lctx
        ll-var-referred-ok-p-of-lctx
        (:instance ll-var-ok-p-split (var v) (ctx ctx2) (nfv nfv2))
        (:instance ll-var-ok-p-split (var v)))
  :in-theory (theory 'minimal-theory))

(defmacro %lenv-hyps ()
  '(and (%lctx-hyps)
        (string-expr-value-map-ll-related-p
         new-denv (expr-denv->exprs denv) (%xfvx) (%xnfvx) ctx dw genv)
        (set::subset (set::delete v0 (expr-free-expr-vars y)) (%xfvx))
        (set::subset (set::delete v0 (%xnfv)) (%xnfvx))
        (lmap-replacements-ok-p (ll-context->lmap ctx) (ll-context->locals ctx)
                                pnames genv)
        (string-listp pnames)
        (member-equal v0 pnames)))

(defruled walker-of-lctx-at
  (implies (and (%lenv-hyps)
                (omap::assoc w (expr-denv->exprs denv))
                (set::in w (%xfv)))
           (ll-var-ok-p w (cdr (omap::assoc w (expr-denv->exprs denv)))
                        new-denv (%xnfv) ctx2 dw genv))
  :use (difference-of-singleton-mergesort-local
        (:instance walker-ll-var-ok-p-at
                   (map (expr-denv->exprs denv)) (fv (%xfvx)) (nfv (%xnfvx))
                   (var w))
        (:instance ll-var-ok-p-of-lctx
                   (v w) (val (cdr (omap::assoc w (expr-denv->exprs denv))))
                   (nfv (%xnfvx)) (nfv2 (%xnfv)))
        (:instance not-in-replacement-free-vars-when-binder
                   (lmap (ll-context->lmap ctx)) (locals
                                                  (ll-context->locals ctx))
                   (v w))
        (:instance stringp-when-assoc-of-string-expr-value-mapp
                   (m (expr-denv->exprs denv)) (k w))
        (:instance set::subset-in
                   (a w) (x (set::delete v0 (expr-free-expr-vars y)))
                   (y (%xfvx))))
  :disable (ll-var-ok-p-of-lctx lmap-replacements-ok-p ll-var-ok-p))

(defruled walker-of-lctx
  (implies (%lenv-hyps)
           (string-expr-value-map-ll-related-p
            new-denv (expr-denv->exprs denv) (%xfv) (%xnfv) ctx2 dw genv))
  :use ((:instance string-expr-value-map-ll-related-p-when-pointwise
                   (map (expr-denv->exprs denv)) (fv (%xfv)) (nfv (%xnfv))
                   (ctx ctx2))
        (:instance walker-of-lctx-at
                   (w (walker-pointwise-p-witness
                       new-denv (expr-denv->exprs denv) (%xfv) (%xnfv)
                       ctx2 dw genv))))
  :expand ((walker-pointwise-p new-denv (expr-denv->exprs denv) (%xfv) (%xnfv)
                               ctx2 dw genv))
  :disable (ll-var-ok-p walker-pointwise-p-necc lmap-replacements-ok-p))

(defruled new-values-meet-types-p-when-subset-and-agree
  (implies (and (new-values-meet-types-p names nd tenv)
                (set::subset names2 names)
                (string-setp names2)
                (not (set::in v0 names2))
                (tenv-agrees-off-p tenv2 tenv v0))
           (new-values-meet-types-p names2 nd tenv2))
  :use ((:instance new-values-meet-types-p-when-pointwise
                   (names names2) (tenv tenv2))
        (:instance new-values-meet-types-p-when-in-subset
                   (new-denv nd) (s names2)
                   (name (new-values-pointwise-p-witness names2 nd tenv2)))
        (:instance tenv-agrees-off-p-necc
                   (n (new-values-pointwise-p-witness names2 nd tenv2)))
        (:instance stringp-when-in-string-setp-local
                   (a (new-values-pointwise-p-witness names2 nd tenv2))
                   (s names2))
        (:instance value-meets-required-type-p-when-same-type-option
                   (val (expr-denv-lookup-expr
                         (new-values-pointwise-p-witness names2 nd tenv2) nd))
                   (v (new-values-pointwise-p-witness names2 nd tenv2))))
  :expand ((new-values-pointwise-p names2 nd tenv2))
  :disable (value-meets-required-type-p tenv-agrees-off-p-necc))

(defruled expr-denv-ll-related-p-of-lctx
  (implies (and (%lctx-hyps)
                (expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
                (set::subset (set::delete v0 (expr-free-expr-vars y)) (%xfvx))
                (set::subset (set::delete v0 (%xnfv)) (%xnfvx))
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx) pnames genv)
                (string-listp pnames)
                (member-equal v0 pnames))
           (expr-denv-ll-related-p new-denv denv y ctx2 (list v0) dw genv))
  :use (walker-of-lctx
        (:instance xctx-subsets (nfv (%xnfv)) (nfvx (%xnfvx))
                   (locals (ll-context->locals ctx)))
        (:instance names-bound-as-in-p-when-subset
                   (names (set::difference (%xnfvx) (ll-context->locals ctx)))
                   (names2 (set::difference (%xnfv) (ll-context->locals ctx2))))
        (:instance new-values-meet-types-p-when-subset-and-agree
                   (names (set::intersect (%xnfvx) (ll-context->locals ctx)))
                   (names2 (set::difference
                            (set::intersect (%xnfv) (ll-context->locals ctx2))
                            (set::mergesort (list v0))))
                   (nd new-denv)
                   (tenv (ll-context->tenv ctx))
                   (tenv2 (ll-context->tenv ctx2))))
  :expand ((expr-denv-ll-related-p new-denv denv x ctx nil dw genv)
           (expr-denv-ll-related-p new-denv denv y ctx2 (list v0) dw genv))
  :enable (difference-of-nil-when-setp)
  :disable (walker-of-lctx names-bound-as-in-p-when-subset
            new-values-meet-types-p-when-subset lmap-replacements-ok-p
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

; The context after a kept binding of an expression variable is one with
; that variable local.

(defruled tenv-agrees-off-p-of-extend-tenv-with-let-bind
  (implies (set::subset (bind-bound-expr-vars b) (set::insert v0 nil))
           (tenv-agrees-off-p
            (mv-nth 0 (extend-tenv-with-let-bind b tenv tlets locals))
            tenv v0))
  :expand ((tenv-agrees-off-p
            (mv-nth 0 (extend-tenv-with-let-bind b tenv tlets locals))
            tenv v0))
  :use ((:instance name-to-type-option-of-extend-tenv-with-let-bind
                   (v (tenv-agrees-off-p-witness
                       (mv-nth 0
                               (extend-tenv-with-let-bind b tenv tlets locals))
                       tenv v0)))
        (:instance set::subset-in
                   (a (tenv-agrees-off-p-witness
                       (mv-nth 0
                               (extend-tenv-with-let-bind b tenv tlets locals))
                       tenv v0))
                   (x (bind-bound-expr-vars b)) (y (set::insert v0 nil)))))

(defruled in-tlets-of-extend-tenv-with-let-bind-off
  (implies (and (set::subset (bind-bound-expr-vars b) (set::insert v0 nil))
                (not (equal v v0)))
           (equal (set::in v (mv-nth 1 (extend-tenv-with-let-bind
                                        b tenv tlets locals)))
                  (set::in v (string-sfix tlets))))
  :use ((:instance in-tlets-of-extend-tenv-with-let-bind-other)
        (:instance set::subset-in (a v) (x (bind-bound-expr-vars b))
                   (y (set::insert v0 nil)))))

(defruled delete-of-tlets-of-extend-tenv-with-let-bind
  (implies (and (set::subset (bind-bound-expr-vars b) (set::insert v0 nil))
                (string-setp tlets))
           (equal (set::delete v0 (mv-nth 1 (extend-tenv-with-let-bind
                                             b tenv tlets locals)))
                  (set::delete v0 tlets)))
  :enable (set::double-containment set::pick-a-point-subset-strategy
           in-tlets-of-extend-tenv-with-let-bind-off))

(defruled let-step-lctx-hyps
  (implies (and (%step-hyps)
                (not (mv-nth 0 (%step)))
                (not (set::emptyp (bind-bound-expr-vars b))))
           (b* ((v0 (bind-name b))
                (ctx2 (%ctx2)))
             (%lctx-hyps)))
  :use (let-step-not-hoisted-facts let-step-locals ll-let-step-fields
        bind-bound-expr-vars-is-name-local bind-bound-expr-vars-subset-of-name
        (:instance tenv-agrees-off-p-of-extend-tenv-with-let-bind
                   (v0 (bind-name b)) (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx)))
        (:instance delete-of-tlets-of-extend-tenv-with-let-bind
                   (v0 (bind-name b)) (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx)))
        (:instance union-of-singleton-local
                   (a (bind-name b)) (s (ll-context->locals ctx))))
  :enable (insert-of-nil-local bind-name)
  :disable (ll-bind hoist-local-fun ll-let-step tenv-agrees-off-p))

; The rebuilt :LET and the rebuilt rest of it, after a kept binding.

(defmacro %kr () '(mv-nth 0 (ll-let-result rest body (%ctx2))))

(defmacro %nbody ()
          '(ll-context-new-expr body (mv-nth 1 (ll-let-result rest body
                                                                         (%ctx2)))))

(defruled let-step-new-exprs-not-hoisted
  (implies (and (bindp b) (bind-listp rest) (exprp body)
                (not (mv-nth 0 (%step))))
           (and (equal (ll-context-new-expr (expr-let (cons b rest) body) ctx)
                       (expr-let (cons (mv-nth 0 (%llb)) (%kr)) (%nbody)))
                (equal (ll-context-new-expr (let-or-body rest body) (%ctx2))
                       (let-or-body (%kr) (%nbody)))))
  :use (let-step-not-hoisted-facts
        (:instance ll-context-new-expr-of-let-or-body (binds (cons b rest)))
        (:instance ll-context-new-expr-of-let-or-body (binds rest)
                   (ctx (%ctx2))))
  :enable (let-or-body ll-let-result-of-cons)
  :disable (ll-bind hoist-local-fun ll-let-step))

(defruled let-step-new-exprs-hoisted
  (implies (and (bindp b) (bind-listp rest) (exprp body)
                (mv-nth 0 (%step)))
           (equal (ll-context-new-expr (expr-let (cons b rest) body) ctx)
                  (ll-context-new-expr (let-or-body rest body) (%ctx2))))
  :use ((:instance ll-context-new-expr-of-let-or-body (binds (cons b rest)))
        (:instance ll-context-new-expr-of-let-or-body (binds rest)
                   (ctx (%ctx2))))
  :enable (let-or-body ll-let-result-of-cons)
  :disable (ll-bind hoist-local-fun ll-let-step))

(defruled let-step-free-vars-not-hoisted
  (implies (and (%step-hyps) (not (mv-nth 0 (%step))))
           (b* ((nfvx (expr-free-expr-vars
                       (ll-context-new-expr (expr-let (cons b rest) body) ctx)))
                (nfvy (expr-free-expr-vars
                       (ll-context-new-expr (let-or-body rest body) (%ctx2)))))
             (and (set::subset (bind-free-expr-vars (mv-nth 0 (%llb))) nfvx)
                  (set::subset (set::difference nfvy (bind-bound-expr-vars b))
                               nfvx)
                  (set::subset (bind-free-expr-vars b)
                               (expr-free-expr-vars
                                (expr-let (cons b rest) body)))
                  (set::subset (set::difference
                                (expr-free-expr-vars (let-or-body rest body))
                                (bind-bound-expr-vars b))
                               (expr-free-expr-vars
                                (expr-let (cons b rest) body))))))
  :use (let-step-new-exprs-not-hoisted
        (:instance ll-context-ok-p-facts-nb (x (expr-let (cons b rest) body)))
        (:instance lmap-closed-p-when-string-expr-map-closed-p
                   (m (ll-context->lmap ctx)))
        (:instance expr-free-expr-vars-of-let-cons
                   (b (mv-nth 0 (%llb))) (rest (%kr)) (body (%nbody)))
        expr-free-expr-vars-of-let-cons)
  :enable (let-step-new-exprs-not-hoisted expr-free-expr-vars-of-let-cons
           subset-of-union-right-1 subset-of-union-right-2)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p))

(defruled difference-of-insert-nil-local
  (equal (set::difference s (set::insert a nil))
         (set::delete a (set::sfix s))))

(defruled let-step-related-excl
  (implies (and (%step-hyps)
                (not (mv-nth 0 (%step)))
                (not (set::emptyp (bind-bound-expr-vars b)))
                (expr-denv-ll-related-p nd d (expr-let (cons b rest) body) ctx
                                        nil dw genv))
           (expr-denv-ll-related-p nd d (let-or-body rest body) (%ctx2)
                                   (list (bind-name b)) dw genv))
  :use (let-step-lctx-hyps let-step-free-vars-not-hoisted let-binders-facts
        bind-bound-expr-vars-is-name-local
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance expr-denv-ll-related-p-of-lctx
                   (v0 (bind-name b)) (ctx2 (%ctx2))
                   (x (expr-let (cons b rest) body)) (y (let-or-body rest body))
                   (new-denv nd) (denv d) (pnames (%bx))))
  :enable (difference-of-insert-nil-local)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; A kept value binding.

(define ll-bound-value-ok-p ((val expr-valuep) (name stringp)
                             (ctx ll-context-p))
  :returns (yes/no booleanp)
  :short "Whether the value bound to a variable by a @(':let') meets what
          the context after the binding requires of it."
  (b* (((ll-context c) ctx))
    (and (value-meets-required-type-p val name c.tenv)
         (or (not (set::in name c.tlets))
             (value-has-inferred-type-p val name c.tenv))))
  :verify-guards nil)

(defruled value-meets-required-type-p-when-same-dims
  (implies (equal (dims-of-expr-value nv) (dims-of-expr-value v))
           (equal (value-meets-required-type-p nv name tenv)
                  (value-meets-required-type-p v name tenv)))
  :enable (value-meets-required-type-p expr-values-match-type-values-p))

(defruled let-binders-of-bind-no-dups
  (implies (and (bindp b) (bind-listp rest) (exprp body)
                (no-duplicatesp-equal (expr-binder-names
                                       (expr-let (cons b rest) body))))
           (no-duplicatesp-equal (bind-binder-names b)))
  :use (expr-binder-names-of-let-cons
        (:instance no-duplicatesp-equal-of-append-parts
                   (a (bind-list-names rest))
                   (b (append (bind-binder-names b)
                              (append (bind-list-binder-names rest)
                                      (expr-binder-names body)))))
        (:instance no-duplicatesp-equal-of-append-parts
                   (a (bind-binder-names b))
                   (b (append (bind-list-binder-names rest)
                              (expr-binder-names body))))))

(defmacro %llb0 ()
  '(ll-bind b (ll-context->tenv ctx) (ll-context->tlets ctx)
            (ll-context->locals ctx) (ll-context->lmap ctx)
            (ll-context->used ctx)))

(defruled let-step-not-hoisted-hoist
  (implies (and (bindp b) (not (mv-nth 0 (%step))))
           (not (mv-nth 0 (%hoist))))
  :use let-step-not-hoisted-facts)

(defruled eval-bind-ll-reaches-p-of-added
  (implies (and (expr-denv-ll-related-p nd d y ctx2 (list v0) dw genv)
                (equal (eval-bind nb nd l2) (expr-denv-add-expr v0 nv nd))
                (expr-valuep val)
                (expr-valuep nv)
                (expr-value-ll-related-p nv val w genv)
                (stringp v0)
                (set::in v0 (ll-context->locals ctx2))
                (not (omap::assoc v0 (ll-context->lmap ctx2)))
                (lmap-replacements-ok-p (ll-context->lmap ctx2)
                                        (ll-context->locals ctx2) pnames genv)
                (string-listp pnames)
                (member-equal v0 pnames)
                (ll-bound-value-ok-p val v0 ctx2)
                (value-meets-required-type-p nv v0 (ll-context->tenv ctx2)))
           (eval-bind-ll-reaches-p nb nd (expr-denv-add-expr v0 val d) y ctx2
                                   genv))
  :use ((:instance expr-denv-ll-related-p-of-add-excluded
                   (ctx ctx2) (w (ll-value-witness-fix w)))
        (:instance eval-bind-ll-reaches-p-suff
                   (new-bind nb) (new-denv nd)
                   (denv2 (expr-denv-add-expr v0 val d)) (x y) (ctx ctx2)
                   (limit2 l2)
                   (dw (ll-denv-witness-add v0 (ll-value-witness-fix w) dw))))
  :enable (ll-bound-value-ok-p
           not-reserrp-when-expr-denvp)
  :disable (expr-denv-ll-related-p eval-bind-ll-reaches-p
            eval-bind-ll-reaches-p-suff expr-value-ll-related-p
            value-meets-required-type-p value-has-inferred-type-p
            lmap-replacements-ok-p))

; The context after a kept binding of an expression variable binds it
; locally, with no replacement, and keeps the replacements well formed.

(defruled bind-bound-expr-vars-nonempty
  (implies (and (not (equal (bind-kind b) :type))
                (not (equal (bind-kind b) :ispace)))
           (not (set::emptyp (bind-bound-expr-vars b))))
  :enable (bind-bound-expr-vars))

(defruled let-step-ctx2-bind-facts
  (implies (and (%step-hyps)
                (not (mv-nth 0 (%step)))
                (not (set::emptyp (bind-bound-expr-vars b))))
           (and (stringp (bind-name b))
                (set::in (bind-name b) (ll-context->locals (%ctx2)))
                (not (omap::assoc (bind-name b) (ll-context->lmap (%ctx2))))
                (lmap-replacements-ok-p (ll-context->lmap (%ctx2))
                                        (ll-context->locals (%ctx2))
                                        (%bx) genv)
                (member-equal (bind-name b) (%bx))))
  :use (let-step-lctx-hyps let-binders-facts
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance unbox-replacements
                   (v0 (bind-name b)) (pnames (%bx)) (pnames2 (%bx))))
  :enable (assoc-of-string-expr-map-remove-keys)
  :disable (ll-bind hoist-local-fun ll-let-step lmap-replacements-ok-p
            ll-context-ok-p))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; A kept binding whose value is that of an expression E, which lifting
; rebuilds in the same context into the expression of the rebuilt binding.

(defmacro %ne () '(ll-context-new-expr e ctx))

(defmacro %ew () '(eval-expr-ll-reaches-p-witness
                   (%ne) new-denv (eval-expr e denv (1- limit)) genv))

(defmacro %ev () '(eval-expr e denv (1- limit)))

(defmacro %nev () '(eval-expr (%ne) new-denv (mv-nth 0 (%ew))))

(defmacro %ebind-hyps ()
  '(and (%step-hyps)
        (not (mv-nth 0 (%step)))
        (not (set::emptyp (bind-bound-expr-vars b)))
        (exprp e)
        (set::subset (expr-free-expr-vars e) (bind-free-expr-vars b))
        (subsetp-equal (expr-binder-names e) (bind-binder-names b))
        (implies (no-duplicatesp-equal (bind-binder-names b))
                 (no-duplicatesp-equal (expr-binder-names e)))
        (equal (mv-nth 1 (%llb0)) (ll-context-lifted e ctx))
        (set::subset (expr-free-expr-vars (%ne))
                     (bind-free-expr-vars (mv-nth 0 (%llb0))))))

(defruled ebind-parts
  (implies (and (%ebind-hyps)
                (expr-denv-ll-related-p nd d (expr-let (cons b rest) body) ctx
                                        nil dw genv))
           (and (expr-denv-ll-related-p nd d e ctx nil dw genv)
                (ll-context-ok-p e ctx genv)))
  :use (let-step-free-vars-not-hoisted let-binders-facts
        let-binders-of-bind-no-dups let-step-lifted let-step-not-hoisted-hoist
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance expr-denv-ll-related-p-of-sub
                   (new-denv nd) (denv d) (x (expr-let (cons b rest) body))
                   (y e) (ctx2 ctx) (excl nil) (excl2 nil))
        (:instance ll-context-ok-p-of-part
                   (x (expr-let (cons b rest) body)) (y e) (ctx2 ctx)))
  :enable (difference-of-nil-when-setp set::subset-transitive)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p
            expr-denv-ll-related-p))

(defruled ebind-ih
  (implies (and (%ebind-hyps)
                (not (reserrp (%ev)))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok e denv (1- limit)))
           (and (not (reserrp (%nev)))
                (expr-valuep (%ev))
                (expr-valuep (%nev))
                (posp (mv-nth 0 (%ew)))
                (expr-value-ll-related-p (%nev) (%ev) (mv-nth 1 (%ew)) genv)
                (equal (dims-of-expr-value (%nev)) (dims-of-expr-value (%ev)))))
  :use ((:instance ebind-parts (nd new-denv) (d denv))
        (:instance eval-expr-ll-ok-necc (expr e) (limit (1- limit)))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (%ne)) (val (%ev)))
        (:instance posp-limit-when-eval-expr-ok
                   (expr (%ne)) (denv new-denv) (limit (mv-nth 0 (%ew))))
        (:instance expr-value-wfp-of-eval-expr
                   (expr e) (limit (1- limit)))
        (:instance expr-value-wfp-of-eval-expr
                   (expr (%ne)) (denv new-denv) (limit (mv-nth 0 (%ew))))
        (:instance dims-of-expr-value-when-ll-related
                   (new-val (%nev)) (val (%ev)) (w (mv-nth 1 (%ew)))))
  :enable (expr-valuep-when-result-not-error)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-expr eval-bind expr-denv-ll-related-p eval-expr-ll-ok
            eval-expr-ll-ok-necc eval-expr-ll-reaches-p
            expr-value-ll-related-p ll-context-new-expr))

(defruled eval-bind-ll-reaches-p-when-ebind
  (implies (and (%ebind-hyps)
                (not (reserrp (eval-bind b denv limit)))
                (not (reserrp (%ev)))
                (equal (eval-bind b denv limit)
                       (expr-denv-add-expr (bind-name b) (%ev) denv))
                (equal (eval-bind (mv-nth 1 (%step)) new-denv
                                  (+ 1 (mv-nth 0 (%ew))))
                       (expr-denv-add-expr (bind-name b) (%nev) new-denv))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok e denv (1- limit))
                (ll-bound-value-ok-p (%ev) (bind-name b) (%ctx2)))
           (eval-bind-ll-reaches-p (mv-nth 1 (%step)) new-denv
                                   (eval-bind b denv limit)
                                   (let-or-body rest body) (%ctx2) genv))
  :use (ebind-ih let-step-ctx2-bind-facts
        (:instance let-step-related-excl (nd new-denv) (d denv))
        (:instance value-meets-required-type-p-when-same-dims
                   (nv (%nev)) (v (%ev)) (name (bind-name b))
                   (tenv (ll-context->tenv (%ctx2))))
        (:instance eval-bind-ll-reaches-p-of-added
                   (nd new-denv) (d denv) (y (let-or-body rest body))
                   (ctx2 (%ctx2)) (v0 (bind-name b)) (pnames (%bx))
                   (nb (mv-nth 1 (%step))) (l2 (+ 1 (mv-nth 0 (%ew))))
                   (val (%ev)) (nv (%nev)) (w (mv-nth 1 (%ew)))))
  :enable (ll-bound-value-ok-p)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-expr eval-bind expr-denv-ll-related-p eval-expr-ll-ok
            eval-expr-ll-ok-necc eval-expr-ll-reaches-p
            eval-bind-ll-reaches-p eval-bind-ll-reaches-p-suff
            expr-value-ll-related-p value-meets-required-type-p
            value-has-inferred-type-p lmap-replacements-ok-p
            ll-context-new-expr))

; Bindings whose value is that of their expression: value bindings, and
; function bindings without parameters.

(defmacro %nbe () '(ll-context-new-expr (bind-plain-expr b) ctx))

(define bind-plain-p ((b bindp))
  :returns (yes/no booleanp)
  (bind-case b
             :val t
             :fun (endp b.params)
             :tfun (endp b.params)
             :ifun (endp b.params)
             :otherwise nil))

(define bind-plain-expr ((b bindp))
  :returns (e exprp)
  (bind-case b
             :val b.expr
             :fun b.expr
             :tfun b.expr
             :ifun b.expr
             :otherwise (expr-var "")))

(define bind-plain-type? ((b bindp))
  :returns (type? type-optionp)
  (bind-case b
             :val b.type?
             :fun b.type?
             :tfun b.type?
             :ifun b.type?
             :otherwise nil))

(defruled eval-bind-when-plain-ok
  (implies (and (bind-plain-p b)
                (not (reserrp (eval-bind b d l))))
           (and (posp l)
                (not (reserrp (eval-expr (bind-plain-expr b) d (1- l))))
                (equal (eval-bind b d l)
                       (expr-denv-add-expr (bind-name b)
                                           (eval-expr (bind-plain-expr b) d
                                                      (1- l))
                                           d))
                (implies (bind-plain-type? b)
                         (not (reserrp
                               (eval-type (type-option-some->val
                                           (bind-plain-type? b))
                                          (expr-denv->tenv d)))))))
  :expand ((eval-bind b d l))
  :enable (bind-plain-p bind-plain-expr bind-plain-type? bind-name))

(defruled ll-bind-when-plain
  (implies (and (bind-plain-p b) (bindp b))
           (b* (((mv nb lifted &) (%llb0)))
             (and (bind-plain-p nb)
                  (equal (bind-kind nb) (bind-kind b))
                  (equal (bind-name nb) (bind-name b))
                  (equal (bind-plain-type? nb) (bind-plain-type? b))
                  (equal (bind-plain-expr nb) (%nbe))
                  (equal lifted (ll-context-lifted (bind-plain-expr b) ctx))
                  (equal (bind-free-expr-vars b)
                         (expr-free-expr-vars (bind-plain-expr b)))
                  (equal (bind-binder-names b)
                         (expr-binder-names (bind-plain-expr b)))
                  (equal (bind-free-expr-vars nb)
                         (expr-free-expr-vars (%nbe))))))
  :expand ((ll-bind b (ll-context->tenv ctx) (ll-context->tlets ctx)
                    (ll-context->locals ctx) (ll-context->lmap ctx)
                    (ll-context->used ctx))
           (bind-free-expr-vars b)
           (bind-binder-names b)
           (:free (v ps ty e) (bind-free-expr-vars (bind-fun v ps ty e)))
           (:free (v ps ty e) (bind-free-expr-vars (bind-tfun v ps ty e)))
           (:free (v ps ty e) (bind-free-expr-vars (bind-ifun v ps ty e)))
           (:free (v ty e) (bind-free-expr-vars (bind-val v ty e))))
  :enable (bind-plain-p bind-plain-expr bind-plain-type? bind-name
           ll-context-new-expr ll-context-lifted extend-tenv-with-params
           tlets-without locals-with-params string-expr-map-remove-keys
           difference-of-nil-when-setp))

(defruled eval-bind-of-plain
  (implies (and (bind-plain-p nb)
                (not (reserrp (eval-expr (bind-plain-expr nb) nd l2)))
                (implies (bind-plain-type? nb)
                         (not (reserrp
                               (eval-type (type-option-some->val
                                           (bind-plain-type? nb))
                                          (expr-denv->tenv nd))))))
           (equal (eval-bind nb nd (+ 1 l2))
                  (expr-denv-add-expr (bind-name nb)
                                      (eval-expr (bind-plain-expr nb) nd l2)
                                      nd)))
  :use ((:instance posp-limit-when-eval-expr-ok
                   (expr (bind-plain-expr nb)) (denv nd) (limit l2)))
  :expand ((eval-bind nb nd (+ 1 l2)))
  :enable (bind-plain-p bind-plain-expr bind-plain-type? bind-name))

(defruled bind-kind-when-plain
  (implies (bind-plain-p b)
           (and (not (equal (bind-kind b) :type))
                (not (equal (bind-kind b) :ispace))))
  :enable (bind-plain-p))

(defruled plain-new-bind
  (implies (and (bindp b)
                (bind-plain-p b)
                (not (mv-nth 0 (%step))))
           (and (bind-plain-p (mv-nth 1 (%step)))
                (equal (bind-name (mv-nth 1 (%step))) (bind-name b))
                (equal (bind-plain-type? (mv-nth 1 (%step)))
                       (bind-plain-type? b))
                (equal (bind-plain-expr (mv-nth 1 (%step))) (%nbe))))
  :use (let-step-not-hoisted-facts ll-bind-when-plain)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-new-expr))

(defruled plain-new-eval
  (implies (and (bindp b)
                (bind-plain-p b)
                (not (mv-nth 0 (%step)))
                (not (reserrp (eval-bind b denv limit)))
                (not (reserrp (eval-expr (%nbe) nd l2)))
                (equal (expr-denv->tenv nd) (expr-denv->tenv denv)))
           (equal (eval-bind (mv-nth 1 (%step)) nd (+ 1 l2))
                  (expr-denv-add-expr (bind-name b) (eval-expr (%nbe) nd l2)
                                      nd)))
  :use (plain-new-bind
        (:instance eval-bind-when-plain-ok (d denv) (l limit))
        (:instance eval-bind-of-plain (nb (mv-nth 1 (%step)))))
  :disable (ll-bind hoist-local-fun ll-let-step eval-expr eval-bind
            ll-context-new-expr)
  :enable (plain-new-bind))

(defruled eval-bind-ll-reaches-p-when-plain
  (implies (and (%step-hyps)
                (bind-plain-p b)
                (not (mv-nth 0 (%step)))
                (not (reserrp (eval-bind b denv limit)))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (eval-expr-ll-ok (bind-plain-expr b) denv (1- limit))
                (ll-bound-value-ok-p (eval-expr (bind-plain-expr b) denv
                                                (1- limit))
                                     (bind-name b) (%ctx2)))
           (eval-bind-ll-reaches-p (mv-nth 1 (%step)) new-denv
                                   (eval-bind b denv limit)
                                   (let-or-body rest body) (%ctx2) genv))
  :use (bind-kind-when-plain ll-bind-when-plain
        (:instance bind-bound-expr-vars-nonempty)
        (:instance eval-bind-when-plain-ok (d denv) (l limit))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (x (expr-let (cons b rest) body)) (excl nil))
        (:instance ebind-ih (e (bind-plain-expr b)))
        (:instance plain-new-eval (nd new-denv)
                   (l2 (mv-nth 0 (eval-expr-ll-reaches-p-witness
                                  (%nbe) new-denv
                                  (eval-expr (bind-plain-expr b) denv
                                             (1- limit))
                                  genv))))
        (:instance eval-bind-ll-reaches-p-when-ebind (e (bind-plain-expr b))))
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-expr eval-bind expr-denv-ll-related-p eval-expr-ll-ok
            eval-expr-ll-ok-necc eval-expr-ll-reaches-p
            eval-bind-ll-reaches-p eval-bind-ll-reaches-p-suff
            expr-value-ll-related-p value-meets-required-type-p
            value-has-inferred-type-p lmap-replacements-ok-p
            ll-context-new-expr ll-bound-value-ok-p))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; A kept binding whose value is that of an abstraction atom A, which lifting
; rebuilds in the same context as the binding (a function binding with
; parameters).

(define abstraction-atom-p ((a atomp))
  :returns (yes/no booleanp)
  (and (member-eq (atom-kind a)
                  '(:lambda :lambdan :tlambda :tlambdan :ilambda :ilambdan))
       t))

(defruled eval-atom-of-abstraction-at-limit
  (implies (and (abstraction-atom-p a)
                (posp l))
           (equal (eval-atom a d l) (eval-atom a d 1)))
  :expand ((eval-atom a d l) (eval-atom a d 1))
  :enable (abstraction-atom-p))

(defruled abstraction-atom-p-of-ll-context-new-atom
  (implies (abstraction-atom-p a)
           (abstraction-atom-p (ll-context-new-atom a ctx)))
  :expand ((:free (tenv tlets locals lmap used)
                  (ll-atom a tenv tlets locals lmap used)))
  :enable (abstraction-atom-p ll-context-new-atom))

(defmacro %ab-na () '(ll-context-new-atom a ctx))

(defmacro %ab-xa () '(expr-array nil (list a)))

(defmacro %ab-aw () '(eval-atom-ll-reaches-p-witness
                   (%ab-na) new-denv (eval-atom a denv 1) genv))

(defmacro %ab-av () '(eval-atom a denv 1))

(defmacro %ab-nav () '(eval-atom (%ab-na) new-denv 1))

(defmacro %abind-hyps ()
  '(and (%step-hyps)
        (not (mv-nth 0 (%step)))
        (not (set::emptyp (bind-bound-expr-vars b)))
        (atomp a)
        (abstraction-atom-p a)
        (set::subset (atom-free-expr-vars a) (bind-free-expr-vars b))
        (subsetp-equal (atom-binder-names a) (bind-binder-names b))
        (implies (no-duplicatesp-equal (bind-binder-names b))
                 (no-duplicatesp-equal (atom-binder-names a)))
        (equal (mv-nth 1 (%llb0))
               (mv-nth 1 (ll-atom a (ll-context->tenv ctx)
                                  (ll-context->tlets ctx)
                                  (ll-context->locals ctx)
                                  (ll-context->lmap ctx)
                                  (ll-context->used ctx))))
        (set::subset (atom-free-expr-vars (%ab-na))
                     (bind-free-expr-vars (mv-nth 0 (%llb0))))))

(defruled abind-parts
  (implies (and (%abind-hyps)
                (expr-denv-ll-related-p nd d (expr-let (cons b rest) body) ctx
                                        nil dw genv))
           (and (expr-denv-ll-related-p nd d (%ab-xa) ctx nil dw genv)
                (ll-context-ok-p (%ab-xa) ctx genv)))
  :use (let-step-free-vars-not-hoisted let-binders-facts
        let-binders-of-bind-no-dups let-step-lifted let-step-not-hoisted-hoist
        ll-expr-of-singleton-array
        (:instance free-and-binders-of-singleton-array (d nil))
        (:instance free-and-binders-of-singleton-array (d nil) (a (%ab-na)))
        (:instance ll-context-ok-p-facts (x (expr-let (cons b rest) body)))
        (:instance expr-denv-ll-related-p-of-sub
                   (new-denv nd) (denv d) (x (expr-let (cons b rest) body))
                   (y (%ab-xa)) (ctx2 ctx) (excl nil) (excl2 nil))
        (:instance ll-context-ok-p-of-part
                   (x (expr-let (cons b rest) body)) (y (%ab-xa)) (ctx2 ctx)))
  :enable (difference-of-nil-when-setp set::subset-transitive)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-atom
            expr-denv-ll-related-p ll-context-new-atom ll-context-new-expr
            ll-context-lifted equal-of-expr-array))

(defruled eval-atom-ll-ok-when-abstraction
  (implies (and (atomp a)
                (abstraction-atom-p a))
           (eval-atom-ll-ok a denv limit))
  :use (:instance eval-atom-ll-ok-when-ok (atom a))
  :enable (abstraction-atom-p)
  :disable (eval-atom-ll-ok))

(defruled abstraction-atom-reach-at-1
  (implies (and (abstraction-atom-p na)
                (eval-atom-ll-reaches-p na nd val genv)
                (expr-denv-wfp nd)
                (expr-value-wfp val))
           (b* ((nav (eval-atom na nd 1)))
             (and (not (reserrp nav))
                  (expr-valuep nav)
                  (expr-value-ll-related-p
                   nav val (mv-nth 1 (eval-atom-ll-reaches-p-witness
                                      na nd val genv))
                   genv)
                  (equal (dims-of-expr-value nav)
                         (dims-of-expr-value val)))))
  :use ((:instance eval-atom-ll-reaches-p-elim
                   (new-atom na) (new-denv nd))
        (:instance posp-limit-when-eval-atom-ok
                   (atom na) (denv nd)
                   (limit (mv-nth 0 (eval-atom-ll-reaches-p-witness
                                     na nd val genv))))
        (:instance eval-atom-of-abstraction-at-limit
                   (a na) (d nd)
                   (l (mv-nth 0 (eval-atom-ll-reaches-p-witness
                                 na nd val genv))))
        (:instance expr-value-wfp-of-eval-atom
                   (atom na) (denv nd) (limit 1))
        (:instance dims-of-expr-value-when-ll-related
                   (new-val (eval-atom na nd 1))
                   (w (mv-nth 1 (eval-atom-ll-reaches-p-witness
                                 na nd val genv)))))
  :enable (expr-valuep-when-result-not-error)
  :disable (eval-atom eval-atom-ll-reaches-p expr-value-ll-related-p
            abstraction-atom-p))

(defruled abind-ih
  (implies (and (%abind-hyps)
                (not (reserrp (%ab-av)))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv))
           (and (not (reserrp (%ab-nav)))
                (expr-valuep (%ab-av))
                (expr-valuep (%ab-nav))
                (expr-value-ll-related-p (%ab-nav) (%ab-av) (mv-nth 1 (%ab-aw))
                                         genv)
                (equal (dims-of-expr-value (%ab-nav))
                       (dims-of-expr-value (%ab-av)))))
  :use ((:instance abind-parts (nd new-denv) (d denv))
        (:instance eval-atom-ll-ok-when-abstraction (limit 1))
        (:instance eval-atom-ll-ok-necc (atom a) (limit 1))
        abstraction-atom-p-of-ll-context-new-atom
        (:instance expr-value-wfp-of-eval-atom (atom a) (limit 1))
        (:instance abstraction-atom-reach-at-1
                   (na (%ab-na)) (nd new-denv) (val (%ab-av))))
  :enable (expr-valuep-when-result-not-error)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-atom eval-bind expr-denv-ll-related-p eval-atom-ll-ok
            eval-atom-ll-ok-necc eval-atom-ll-reaches-p
            expr-value-ll-related-p ll-context-new-atom abstraction-atom-p))

(defruled eval-bind-ll-reaches-p-when-abind
  (implies (and (%abind-hyps)
                (not (reserrp (eval-bind b denv limit)))
                (not (reserrp (%ab-av)))
                (equal (eval-bind b denv limit)
                       (expr-denv-add-expr (bind-name b) (%ab-av) denv))
                (equal (eval-bind (mv-nth 1 (%step)) new-denv 1)
                       (expr-denv-add-expr (bind-name b) (%ab-nav) new-denv))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (ll-bound-value-ok-p (%ab-av) (bind-name b) (%ctx2)))
           (eval-bind-ll-reaches-p (mv-nth 1 (%step)) new-denv
                                   (eval-bind b denv limit)
                                   (let-or-body rest body) (%ctx2) genv))
  :use (abind-ih let-step-ctx2-bind-facts
        (:instance let-step-related-excl (nd new-denv) (d denv))
        (:instance value-meets-required-type-p-when-same-dims
                   (nv (%ab-nav)) (v (%ab-av)) (name (bind-name b))
                   (tenv (ll-context->tenv (%ctx2))))
        (:instance eval-bind-ll-reaches-p-of-added
                   (nd new-denv) (d denv) (y (let-or-body rest body))
                   (ctx2 (%ctx2)) (v0 (bind-name b)) (pnames (%bx))
                   (nb (mv-nth 1 (%step))) (l2 1)
                   (val (%ab-av)) (nv (%ab-nav)) (w (mv-nth 1 (%ab-aw)))))
  :enable (ll-bound-value-ok-p)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-atom eval-bind expr-denv-ll-related-p
            eval-bind-ll-reaches-p eval-bind-ll-reaches-p-suff
            expr-value-ll-related-p value-meets-required-type-p
            value-has-inferred-type-p lmap-replacements-ok-p
            ll-context-new-atom))

; Function bindings with parameters: the abstraction is the lambda atom
; over the parameters.

(defmacro %fa () '(make-atom-lambda/lambdan (bind-fun->params b)
                                            (bind-fun->expr b)
                                            (bind-fun->type? b)))

(defruled eval-bind-of-fun-when-closure-ok
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (posp limit)
                (implies (bind-fun->type? bind)
                         (not (reserrp (eval-type (type-option-some->val
                                                   (bind-fun->type? bind))
                                                  (expr-denv->tenv denv)))))
                (not (reserrp (lambda-closure (bind-fun->params bind)
                                              (bind-fun->expr bind)
                                              (bind-fun->type? bind)
                                              denv))))
           (equal (eval-bind bind denv limit)
                  (expr-denv-add-expr (bind-fun->var bind)
                                      (lambda-closure (bind-fun->params bind)
                                                      (bind-fun->expr bind)
                                                      (bind-fun->type? bind)
                                                      denv)
                                      denv)))
  :enable (lambda-closure make-atom-lambda/lambdan lambda-curried-body
           difference-of-singleton-mergesort)
  :expand ((eval-bind bind denv limit)
           (:free (a) (eval-atom a denv 1))
           (:free (p b ty) (atom-free-expr-vars (atom-lambda p b ty)))
           (:free (p b ty) (atom-free-expr-vars (atom-lambdan p b ty)))
           (var+type?-list->var (bind-fun->params bind))
           (var+type?-list->var (cdr (bind-fun->params bind)))))

(defruled fun-body-context
  (implies (var+type?-listp pa)
           (equal (mv-nth 3 (ll-lambda-parts pa '(:var "") nil ctx))
                  (make-ll-context
                   :tenv (extend-tenv-with-params pa (ll-context->tenv ctx))
                   :tlets (tlets-without (var+type?-list->var pa)
                                         (ll-context->tlets ctx))
                   :locals (locals-with-params pa (ll-context->locals ctx))
                   :lmap (string-expr-map-remove-keys (var+type?-list->var pa)
                                                      (ll-context->lmap ctx))
                   :used (ll-context->used ctx))))
  :expand ((ll-lambda-parts pa '(:var "") nil ctx)))

(defruled ll-bind-when-fun-params
  (implies (and (bindp b)
                (equal (bind-kind b) :fun)
                (consp (bind-fun->params b)))
           (b* (((mv nb lifted &) (%llb0))
                (pa (bind-fun->params b))
                (ba (bind-fun->expr b))
                (ta (bind-fun->type? b)))
             (and (equal nb (bind-fun (bind-fun->var b) pa ta (%anb)))
                  (equal lifted (ll-context-lifted ba (%actx))))))
  :use ((:instance fun-body-context (pa (bind-fun->params b))))
  :expand ((ll-bind b (ll-context->tenv ctx) (ll-context->tlets ctx)
                    (ll-context->locals ctx) (ll-context->lmap ctx)
                    (ll-context->used ctx)))
  :enable (ll-context-new-expr ll-context-lifted))

(defruled abstraction-atom-p-of-make-atom-lambda/lambdan
  (abstraction-atom-p (make-atom-lambda/lambdan params body type?))
  :enable (abstraction-atom-p make-atom-lambda/lambdan))

(defruled eval-bind-fun-type-ok
  (implies (and (equal (bind-kind bind) :fun)
                (consp (bind-fun->params bind))
                (not (reserrp (eval-bind bind denv limit)))
                (bind-fun->type? bind))
           (not (reserrp (eval-type (type-option-some->val
                                     (bind-fun->type? bind))
                                    (expr-denv->tenv denv)))))
  :expand ((eval-bind bind denv limit)))

(defruled fun-abind-hyps
  (implies (and (%step-hyps)
                (not (mv-nth 0 (%step)))
                (equal (bind-kind b) :fun)
                (consp (bind-fun->params b)))
           (b* ((a (%fa)))
             (%abind-hyps)))
  :use (bind-bound-expr-vars-nonempty
        (:instance atom-free-expr-vars-of-make-atom-lambda/lambdan
                   (params (bind-fun->params b)) (body (bind-fun->expr b))
                   (type? (bind-fun->type? b)))
        (:instance atom-free-expr-vars-of-make-atom-lambda/lambdan
                   (params (bind-fun->params b))
                   (body (ll-context-new-expr
                          (bind-fun->expr b)
                          (mv-nth 3 (ll-lambda-parts (bind-fun->params b)
                                                     '(:var "") nil ctx))))
                   (type? (bind-fun->type? b)))
        (:instance atom-binder-names-of-make-atom-lambda/lambdan
                   (params (bind-fun->params b)) (body (bind-fun->expr b))
                   (type? (bind-fun->type? b))))
  :expand ((bind-free-expr-vars b)
           (bind-binder-names b)
           (:free (v ps ty e) (bind-free-expr-vars (bind-fun v ps ty e))))
  :enable (abstraction-atom-p-of-make-atom-lambda/lambdan
           ll-bind-when-fun-params ll-atom-of-make-atom-lambda/lambdan)
  :disable (ll-bind hoist-local-fun ll-let-step ll-atom ll-lambda-parts
            ll-context-new-expr ll-context-lifted ll-context-new-atom))

(defruled fun-new-bind
  (implies (and (bindp b)
                (equal (bind-kind b) :fun)
                (consp (bind-fun->params b))
                (not (mv-nth 0 (%step))))
           (b* ((pa (bind-fun->params b))
                (ba (bind-fun->expr b))
                (ta (bind-fun->type? b)))
             (equal (mv-nth 1 (%step))
                    (bind-fun (bind-fun->var b) pa ta (%anb)))))
  :use (let-step-not-hoisted-facts ll-bind-when-fun-params)
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-new-expr
            ll-lambda-parts))

(defruled fun-new-eval
  (implies (and (bindp b)
                (equal (bind-kind b) :fun)
                (consp (bind-fun->params b))
                (not (mv-nth 0 (%step)))
                (not (reserrp (eval-bind b denv limit)))
                (equal (expr-denv->tenv nd) (expr-denv->tenv denv))
                (not
                 (reserrp (eval-atom (ll-context-new-atom (%fa) ctx) nd 1))))
           (equal (eval-bind (mv-nth 1 (%step)) nd 1)
                  (expr-denv-add-expr (bind-name b)
                                      (eval-atom (ll-context-new-atom (%fa) ctx)
                                                 nd 1)
                                      nd)))
  :use ((:instance eval-bind-fun-type-ok (bind b) (denv denv))
        (:instance ll-atom-of-make-atom-lambda/lambdan
                   (pa (bind-fun->params b)) (ba (bind-fun->expr b))
                   (ta (bind-fun->type? b)))
        (:instance eval-bind-of-fun-when-closure-ok
                   (bind (mv-nth 1 (%step))) (denv nd) (limit 1)))
  :enable (fun-new-bind lambda-closure bind-name)
  :disable (ll-bind hoist-local-fun ll-let-step eval-bind eval-atom
            ll-context-new-expr ll-lambda-parts ll-context-new-atom
            make-atom-lambda/lambdan))

(defruled fun-orig-eval
  (implies (and (equal (bind-kind b) :fun)
                (consp (bind-fun->params b))
                (not (reserrp (eval-bind b denv limit))))
           (and (not (reserrp (eval-atom (%fa) denv 1)))
                (equal (eval-bind b denv limit)
                       (expr-denv-add-expr (bind-name b)
                                           (eval-atom (%fa) denv 1)
                                           denv))))
  :use ((:instance eval-bind-when-fun-with-params (bind b))
        (:instance lambda-closure-ok-when-eval-bind-ok (bind b)))
  :enable (lambda-closure bind-name)
  :disable (eval-bind eval-atom make-atom-lambda/lambdan))

(defruled eval-bind-ll-reaches-p-when-fun-params
  (implies (and (%step-hyps)
                (equal (bind-kind b) :fun)
                (consp (bind-fun->params b))
                (not (mv-nth 0 (%step)))
                (not (reserrp (eval-bind b denv limit)))
                (expr-denv-ll-related-p new-denv denv
                                        (expr-let (cons b rest) body) ctx
                                        nil dw genv)
                (expr-denv-wfp denv)
                (expr-denv-wfp new-denv)
                (ll-bound-value-ok-p (eval-atom (%fa) denv 1)
                                     (bind-name b) (%ctx2)))
           (eval-bind-ll-reaches-p (mv-nth 1 (%step)) new-denv
                                   (eval-bind b denv limit)
                                   (let-or-body rest body) (%ctx2) genv))
  :use (fun-abind-hyps fun-orig-eval
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (x (expr-let (cons b rest) body)) (excl nil))
        (:instance abind-ih (a (%fa)))
        (:instance fun-new-eval (nd new-denv))
        (:instance eval-bind-ll-reaches-p-when-abind (a (%fa))))
  :disable (ll-bind hoist-local-fun ll-let-step ll-context-ok-p ll-expr
            eval-atom eval-bind expr-denv-ll-related-p
            eval-bind-ll-reaches-p eval-bind-ll-reaches-p-suff
            expr-value-ll-related-p value-meets-required-type-p
            value-has-inferred-type-p lmap-replacements-ok-p
            ll-context-new-atom ll-bound-value-ok-p make-atom-lambda/lambdan
            ll-lambda-parts ll-atom))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; A kept binding whose value is that of an abstraction atom A, which lifting
; rebuilds in the same context as the binding (a function binding with
; parameters).

(define abstraction-atom-p ((a atomp))
  :returns (yes/no booleanp)
  (and (member-eq (atom-kind a)
                  '(:lambda :lambdan :tlambda :tlambdan :ilambda :ilambdan))
       t))

; Type and ispace function bindings with parameters: the abstraction is the
; type or ispace lambda atom over the parameters, whose body lifting
; rebuilds in the same context.

(defmacro %ta () '(make-atom-tlambda/tlambdan (bind-tfun->params b)
                                              (bind-tfun->expr b)))

(defmacro %ia () '(make-atom-ilambda/ilambdan (bind-ifun->params b)
                                              (bind-ifun->expr b)))

(defruled difference-of-mergesort-of-singleton-local
  (implies (and (consp ps) (not (consp (cdr ps))))
           (equal (set::difference s (set::mergesort ps))
                  (set::delete (car ps) (set::sfix s))))
  :expand ((set::mergesort ps))
  :enable (set::double-containment set::pick-a-point-subset-strategy))

(defruled tfun-orig-eval
  (implies (and (equal (bind-kind b) :tfun)
                (consp (bind-tfun->params b))
                (not (reserrp (eval-bind b denv limit))))
           (and (not (reserrp (eval-atom (%ta) denv 1)))
                (equal (eval-bind b denv limit)
                       (expr-denv-add-expr (bind-name b)
                                           (eval-atom (%ta) denv 1)
                                           denv))
                (implies (bind-tfun->type? b)
                         (not (reserrp
                               (eval-type
                                (make-type-forall/foralln
                                 (bind-tfun->params b)
                                 (type-option-some->val (bind-tfun->type? b)))
                                (expr-denv->tenv denv)))))))
  :cases ((consp (cdr (bind-tfun->params b))))
  :expand ((eval-bind b denv limit)
           (:free (a) (eval-atom a denv 1))
           (:free (p e) (atom-free-type-vars (atom-tlambda p e)))
           (:free (p e) (atom-free-type-vars (atom-tlambdan p e))))
  :enable (make-atom-tlambda/tlambdan tlambda-curried-body bind-name
           difference-of-mergesort-of-singleton-local))

(defruled ifun-orig-eval
  (implies (and (equal (bind-kind b) :ifun)
                (consp (bind-ifun->params b))
                (not (reserrp (eval-bind b denv limit))))
           (and (not (reserrp (eval-atom (%ia) denv 1)))
                (equal (eval-bind b denv limit)
                       (expr-denv-add-expr (bind-name b)
                                           (eval-atom (%ia) denv 1)
                                           denv))
                (implies (bind-ifun->type? b)
                         (not (reserrp
                               (eval-type
                                (make-type-pi/pin
                                 (bind-ifun->params b)
                                 (type-option-some->val (bind-ifun->type? b)))
                                (expr-denv->tenv denv)))))))
