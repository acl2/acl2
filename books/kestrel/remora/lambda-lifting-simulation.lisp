            (implies (and (not (reserrp val))
                          (expr-value-ll-related-p new-funval funval w genv)
                          (equal (expr-denv->tenv new-denv)
                                 (expr-denv->tenv denv))
                          (expr-value-wfp funval)
                          (expr-value-wfp new-funval))
                     (eval-tappn-ll-reaches-p new-funval args new-denv val
                                              genv)))))

(acl2::defun-sk eval-iapp-ll-ok (funval ival limit)
  (forall (new-funval w genv)
