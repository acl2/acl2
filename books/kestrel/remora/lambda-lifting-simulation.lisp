           (b* ((val (prim-trace tval rval s q val1 val2))
                (new-val (prim-trace new-tval new-rval s q new-val1 new-val2)))
             (and (equal (reserrp new-val) (reserrp val))
                  (implies (not (reserrp val))
                           (expr-value-ll-equiv-p new-val val genv)))))
  :enable (prim-trace
           dims-of-expr-value-when-expr-value-ll-related-via-p
           expr-value-ll-equiv-p-of-fix-when-equiv
           not-reserrp-when-expr-valuep)
  :use ((:instance expr-value-ll-equiv-p-suff (new-val new-val2) (val val2)
                   (w w2)))
  :disable (expr-value-ll-equiv-p-suff))

) ; end of encapsulate

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The first-order application of primitive operations to one argument cell,
; one lemma per first-order operation kind (see PRIMOP-VALUE-FUN-FO-P; the
; monolithic proof blows up): scalar operations yield equal ground results;
; array operations are covered by the lemmas above; the remaining stage
; constructors store the argument (or the stored first argument and the
; argument) in the next stage, whose ll-equivalence is witnessed by the
; primop witness of the stored values.

; The lemmas differ only in the kind and, for the stage constructors, in
; the witness, so a macro generates them: without a witness, the lemma is
; proved from the lemmas of the scalar and array operations; with a
; witness, from the relation of the next stage via that witness.

(defmacro def-eval-primop-fun-fo-ll-when (kind &key witness)
  `(defruled ,(intern-in-package-of-symbol
               (concatenate 'string "EVAL-PRIMOP-FUN-FO-LL-WHEN-"
                            (symbol-name kind))
               'eval-primop-fun-fo-ll)
     (implies (and (equal (primop-value-kind op) ,kind)
                   (primop-value-ll-related-p new-op op ws genv)
                   (expr-value-ll-related-p new-arg arg aw genv)
                   (primop-value-wfp op)
                   (primop-value-wfp new-op)
                   (expr-value-wfp arg)
                   (expr-value-wfp new-arg))
              (b* ((val (eval-primop-fun-fo op arg))
                   (new-val (eval-primop-fun-fo new-op new-arg)))
                (and (equal (reserrp new-val) (reserrp val))
                     (implies (not (reserrp val))
                              (expr-value-ll-equiv-p new-val val genv)))))
     ,@(if witness
           `(:expand ((:free (new-val val w)
                      (expr-value-ll-related-p new-val
                                               (expr-value-primop val) w genv))
                     (:free (new-op op ws)
                      (primop-value-ll-related-p new-op op ws genv)))
            :enable (eval-primop-fun-fo
                     primop-value-kind-when-related
                     primop-value-wfp
                     expr-value-wfp-of-expr-value-stages
                     expr-value-ll-equiv-p-of-same
                     expr-value-ll-equiv-p-of-fix-when-equiv
                     not-reserrp-when-expr-valuep)
            :use ((:instance expr-value-ll-equiv-p-suff
                             (new-val (eval-primop-fun-fo new-op new-arg))
                             (val (eval-primop-fun-fo op arg))
                             (w ,witness)))
            :disable (expr-value-ll-equiv-p-suff))
         '(:expand ((primop-value-ll-related-p new-op op ws genv)
                   (:free (new-val val w)
                    (expr-value-ll-related-p new-val
                                             (expr-value-primop val) w genv))
                   (:free (new-op op ws)
                    (primop-value-ll-related-p new-op op ws genv)))
          :enable (eval-primop-fun-fo
                   primop-value-wfp
                   expr-value-wfp-of-expr-value-stages
                   expr-value-ll-equiv-p-of-same
                   expr-value-ll-equiv-p-of-fix-when-equiv
                   not-reserrp-when-expr-valuep
                   ;; scalar operations
