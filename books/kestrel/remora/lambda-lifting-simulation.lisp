; The free type and ispace variables of a lambda over a chain of lambdas
; that it flattens are those of the chain.

(defmacro def-fv-of-lambda-atom (kind)
  (b* ((sfx (symbol-name kind))
       (efn (intern-in-package-of-symbol
             (concatenate 'string "EXPR-FREE-" sfx "-VARS") 'remora::expr))
       (pfn (intern-in-package-of-symbol
             (concatenate 'string "VAR+TYPE?-LIST-FREE-" sfx "-VARS")
             'remora::expr))
       (tfn (intern-in-package-of-symbol
             (concatenate 'string "TYPE-OPTION-FREE-" sfx "-VARS")
             'remora::expr))
       (afn (intern-in-package-of-symbol
             (concatenate 'string "ATOM-FREE-" sfx "-VARS") 'remora::expr))
       (name (intern-in-package-of-symbol
              (concatenate 'string "FREE-" sfx "-VARS-OF-LAMBDA-ATOM-EXPR")
              'remora::expr)))
    `(defruled ,name
       (implies (consp params)
                (equal (,efn (expr-atom (make-atom-lambda/lambdan params body
                                                                  type?)))
                       (set::union (,pfn params)
                                   (set::union (,efn body) (,tfn type?)))))
       :enable (make-atom-lambda/lambdan set::double-containment
                set::pick-a-point-subset-strategy)
       :expand ((:free (a) (,efn (expr-atom a)))
                (:free (p b ty) (,afn (atom-lambda p b ty)))
                (:free (p b ty) (,afn (atom-lambdan p b ty)))
                (,pfn params)
                (,pfn (cdr params))
                (:free (x y) (,pfn (cons x y)))))))

(def-fv-of-lambda-atom :type)

(def-fv-of-lambda-atom :ispace)

(defun chain-ind (more body type?)
  (declare (xargs :measure (expr-count body)
                  :hints (("Goal" :in-theory (enable nested-lambda)))))
  (b* (((mv nestedp m2 inner ity) (nested-lambda body)))
    (if (and nestedp (type-option-case type? :none))
        (chain-ind (append more m2) inner ity)
      (list more body type?))))

(defruled nested-lambda-shape
  (b* (((mv nestedp m2 inner ity) (nested-lambda body)))
    (implies nestedp
             (equal (expr-fix body)
                    (expr-atom (make-atom-lambda/lambdan m2 inner ity)))))
  :enable (nested-lambda make-atom-lambda/lambdan)
  :use ((:instance consp-of-cdr-of-atom-lambdan->params
                   (atom (expr-atom->atom (expr-fix body))))))

(defmacro def-fv-of-curried-chain (kind)
  (b* ((sfx (symbol-name kind))
       (efn (intern-in-package-of-symbol
             (concatenate 'string "EXPR-FREE-" sfx "-VARS") 'remora::expr))
       (pfn (intern-in-package-of-symbol
             (concatenate 'string "VAR+TYPE?-LIST-FREE-" sfx "-VARS")
             'remora::expr))
       (tfn (intern-in-package-of-symbol
             (concatenate 'string "TYPE-OPTION-FREE-" sfx "-VARS")
             'remora::expr))
       (alem (intern-in-package-of-symbol
              (concatenate 'string "FREE-" sfx "-VARS-OF-LAMBDA-ATOM-EXPR")
              'remora::expr))
       (nlem (intern-in-package-of-symbol
              (concatenate 'string "FREE-" sfx "-VARS-OF-NESTED-LAMBDA")
              'remora::expr))
       (name (intern-in-package-of-symbol
              (concatenate 'string "FREE-" sfx "-VARS-OF-CURRIED-CHAIN")
              'remora::expr)))
    `(progn
       (defruled ,nlem
         (b* (((mv nestedp m2 inner ity) (nested-lambda body)))
           (implies nestedp
                    (equal (,efn body)
                           (set::union (,pfn m2)
                                       (set::union (,efn inner)
                                                   (,tfn ity))))))
         :use (nested-lambda-shape
               (:instance ,alem
                          (params (mv-nth 1 (nested-lambda body)))
                          (body (mv-nth 2 (nested-lambda body)))
                          (type? (mv-nth 3 (nested-lambda body))))
               (:instance nested-lambda-params-consp))
         :disable (nested-lambda-params-consp))
       (defruled ,name
         (b* (((mv ps in ity) (lambda-chain body type?)))
           (implies (and (consp more)
                         (var+type?-listp more))
                    (equal (,efn (lambda-curried-body (append more ps) in ity))
                           (,efn (lambda-curried-body more body type?)))))
         :induct (chain-ind more body type?)
         :expand ((:free (ty) (lambda-chain body ty)))
         :enable (lambda-curried-body ,alem ,nlem)))))

(def-fv-of-curried-chain :type)

(def-fv-of-curried-chain :ispace)

; The shape of a closure body that flattens: a lambda over some of the
; remaining parameters, whose chain gives the rest.

(defmacro %fl-nl () '(nested-lambda (expr-value-lambda->body f)))

(defmacro %fl-m2 () '(mv-nth 1 (%fl-nl)))

(defmacro %fl-in1 () '(mv-nth 2 (%fl-nl)))

(defmacro %fl-ity1 () '(mv-nth 3 (%fl-nl)))

(defmacro %fl-ch () '(lambda-chain (%fl-in1) (%fl-ity1)))

(defrule closure-body-parts-flat-shape
  (implies (and (consp prest)
                (var+type?-listp prest)
                (exprp body)
                flat
                (mv-nth 0 (closure-body-parts body type? prest flat)))
           (b* (((mv nestedp m2 in1 ity1) (nested-lambda body))
                ((mv ps inner ity) (lambda-chain in1 ity1)))
             (and (not type?)
                  nestedp
                  (equal prest (append m2 ps))
                  (equal (mv-nth 1 (closure-body-parts body type? prest flat))
                         inner)
                  (equal (mv-nth 2 (closure-body-parts body type? prest flat))
                         ity))))
  :rule-classes nil
  :enable (closure-body-parts)
  :expand ((lambda-chain body nil)))

(defruled flat-closure-type?-equal
  (b* (((mv ps & ity) (lambda-chain in1 ity1)))
    (implies (and (consp m2)
                  (type-optionp ity1)
                  (not (reserrp (lambda-closure m2 in1 ity1 d2)))
                  (not (reserrp (lambda-closure (append m2 ps) b ity d1)))
                  (equal (expr-denv->tenv d1) (expr-denv->tenv d2)))
             (equal (expr-value-lambda->type?
                     (lambda-closure (append m2 ps) b ity d1))
                    (expr-value-lambda->type?
                     (lambda-closure m2 in1 ity1 d2)))))
  :use ((:instance type?-of-lambda-closure-single
                   (params m2) (body in1) (type? ity1) (denv d2))
        (:instance type?-of-lambda-closure-multi
                   (params m2) (body in1) (type? ity1) (denv d2))
        (:instance type?-of-lambda-closure-single
                   (params (append m2 (mv-nth 0 (lambda-chain in1 ity1))))
                   (body b) (type? (mv-nth 2 (lambda-chain in1 ity1)))
                   (denv d1))
        (:instance type?-of-lambda-closure-multi
                   (params (append m2 (mv-nth 0 (lambda-chain in1 ity1))))
                   (body b) (type? (mv-nth 2 (lambda-chain in1 ity1)))
                   (denv d1))
        (:instance lambda-chain-type-when-nothing-absorbed
                   (body in1) (type? ity1)))
  :expand ((lambda-chain in1 ity1))
  :disable (lambda-closure))

(defmacro %rmval-fl ()
  '(lambda-closure (%fl-m2) (%fl-in1) (%fl-ity1) (%lcenv)))

(defmacro %flat-hyps ()
  '(and (equal (expr-value-kind f) :lambda)
        (consp (%lwp))
        (%lwf)
        (expr-value-ll-related-p nf f w genv)
        (expr-value-ll-related-p na a w2 genv)
        (expr-value-wfp a)
        (expr-value-wfp na)
        (expr-values-match-type-values-p
         (list a) (list (var+typevalue->type
                         (expr-value-lambda->param f))))
        (not (reserrp (%rmval-fl)))
        (not (reserrp (%rmnew)))))

(defruled lambda-more-flat-shape
  (implies (%flat-hyps)
           (and (not (expr-value-lambda->type? f))
                (mv-nth 0 (%fl-nl))
                (consp (%fl-m2))
                (equal (%lwp) (append (%fl-m2) (mv-nth 0 (%fl-ch))))
                (equal (%rmi) (mv-nth 1 (%fl-ch)))
                (equal (%rmt) (mv-nth 2 (%fl-ch)))))
  :use (lambda-related-unpack
        (:instance closure-body-parts-flat-shape
                   (body (expr-value-lambda->body f))
                   (type? (expr-value-lambda->type? f))
                   (prest (%lwp)) (flat (%lwf)))
        (:instance nested-lambda-params-consp
                   (body (expr-value-lambda->body f))))
  :in-theory (e/d (exprp-of-expr-value-lambda->body
                   var+type?-listp-of-ll-value-witness-lambda->prest)
                  (closure-body-parts lambda-chain nested-lambda
                   expr-value-ll-related-p ll-context-ok-p
                   expr-denv-ll-related-p)))

(defruled lambda-more-flat-fields
  (implies (%flat-hyps)
           (and (equal (expr-value-kind (%rmval-fl)) :lambda)
                (equal (expr-value-kind (%rmnew)) :lambda)
                (equal (expr-value-lambda->param (%rmnew))
                       (expr-value-lambda->param (%rmval-fl)))
                (equal (expr-value-lambda->type? (%rmnew))
                       (expr-value-lambda->type? (%rmval-fl)))
                (equal (var+typevalue->var
                        (expr-value-lambda->param (%rmval-fl)))
                       (var+type?->var (car (%lwp))))))
  :use (lambda-more-flat-shape
        lambda-related-unpack
        (:instance expr-value-kind-of-lambda-closure
                   (params (%fl-m2)) (body (%fl-in1)) (type? (%fl-ity1))
                   (denv (%lcenv)))
        (:instance expr-value-kind-of-lambda-closure
                   (params (%lwp)) (body (%rmni)) (type? (%rmt))
                   (denv (%nlcenv)))
        (:instance lambda-closure-when-ok
                   (params (%fl-m2)) (body (%fl-in1)) (type? (%fl-ity1))
                   (denv (%lcenv)))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (new-denv (expr-value-lambda->denv nf))
                   (denv (expr-value-lambda->denv f))
                   (x (%rmi)) (ctx (%lwc)) (excl (%lpn)) (dw (%lwd)))
        (:instance flat-closure-type?-equal
                   (m2 (%fl-m2)) (in1 (%fl-in1)) (ity1 (%fl-ity1))
                   (b (%rmni)) (d1 (%nlcenv)) (d2 (%lcenv)))
        (:instance param-of-lambda-closure
                   (params (%fl-m2)) (body (%fl-in1)) (type? (%fl-ity1))
                   (denv (%lcenv)))
        (:instance param-of-lambda-closure
                   (params (%lwp)) (body (%rmni)) (type? (%rmt))
                   (denv (%nlcenv))))
  :disable (ll-context-ok-p expr-denv-ll-related-p closure-body-parts
            names-in-context-p lmap-replacements-ok-p param-type-consistent-p
            prest-tenv-consistent-p lifted-closure-body expr-value-ll-related-p
            lambda-closure lambda-curried-body ll-context-new-expr lambda-chain
            nested-lambda))

(defruled lambda-more-flat-body
  (implies (%flat-hyps)
           (b* (((mv okp inner ity2)
                 (closure-body-parts (expr-value-lambda->body (%rmval-fl))
                                     (expr-value-lambda->type? (%rmval-fl))
                                     (cdr (%lwp)) t)))
             (and okp
                  (equal inner (%rmi))
                  (equal (expr-value-lambda->body (%rmnew))
                         (lifted-closure-body (cdr (%lwp))
                                              (ll-context-new-expr inner
                                                                   (%lwc))
                                              ity2)))))
  :use (lambda-more-flat-shape
        (:instance lambda-closure-when-ok
                   (params (%fl-m2)) (body (%fl-in1)) (type? (%fl-ity1))
                   (denv (%lcenv)))
        (:instance lambda-closure-when-ok
                   (params (%lwp)) (body (%rmni)) (type? (%rmt))
                   (denv (%nlcenv)))
        (:instance closure-body-parts-of-lambda-curried-body
                   (params (%fl-m2)) (body (%fl-in1)) (type? (%fl-ity1))
                   (tyv (expr-value-lambda->type? (%rmval-fl)))
                   (new-inner (%rmni)))
        (:instance type?-of-lambda-closure-iff
                   (params (%fl-m2)) (body (%fl-in1)) (type? (%fl-ity1))
