                              (not (reserrp (var+type?-list->type-list-or-err
                                             (bind-cfun->params bind)))))
                         (eval-expr-ll-ok (%cfe bind) denv (1- limit))))
           (eval-bind-ll-ok bind denv limit))
  :cases ((and (equal (bind-kind bind) :cfun)
                (reserrp (var+type?-list->type-list-or-err
                          (bind-cfun->params bind)))))
  :use (eval-bind-ll-ok-when-ok let-bind-typed-p-when-check-sound
        eval-bind-ll-ok-when-cfun-params-error)
  :enable (bind-plain-p bind-plain-expr)
  :disable (let-bind-typed-p eval-bind-ll-ok))

(defruled eval-bind-list-ll-ok-cases
  (implies (and (not (zp limit))
                (check-sound-p)
                (consp binds)
                (implies (consp binds)
                         (eval-bind-ll-ok (car binds) denv (1- limit)))
                (implies (and (consp binds)
                              (not
                               (reserrp
                                (eval-bind (car binds) denv (1- limit)))))
                         (eval-bind-list-ll-ok (cdr binds)
                                               (eval-bind (car binds) denv
                                                          (1- limit))
                                               (1- limit))))
           (eval-bind-list-ll-ok binds denv limit))
  :expand ((eval-bind-list-ll-ok binds denv limit)
           (eval-bind-list binds denv limit))
  :use (eval-bind-list-ll-ok-when-ok
        (:instance let-bind-typed-p-when-check-sound
                   (bind (car binds)) (limit (1- limit))))
  :disable (let-bind-typed-p))

(defruled eval-tapp-ll-ok-cases
  (implies (and (not (zp limit))
                (implies (and (equal (expr-value-kind funval) :tlambda)
                              (type-values-match-type-vars-p
                               (list tval) (list
                                            (expr-value-tlambda->param
                                             funval))))
                         (eval-expr-ll-ok (%tlbody) (%tlenv) (1- limit)))
                (implies (equal (expr-value-kind funval) :vector)
                         (eval-tapp-list-ll-ok (%tvels) tval (1- limit))))
           (eval-tapp-ll-ok funval tval limit))
  :expand ((eval-tapp-ll-ok funval tval limit)
           (eval-tapp funval tval limit))
  :use eval-tapp-ll-ok-when-ok)

(defruled eval-iapp-ll-ok-cases
  (implies (and (not (zp limit))
                (implies (and (equal (expr-value-kind funval) :ilambda)
                              (ispace-values-match-ispace-vars-p
                               (list ival) (list
                                            (expr-value-ilambda->param
                                             funval))))
                         (eval-expr-ll-ok (%ilbody) (%ilenv) (1- limit)))
                (implies (equal (expr-value-kind funval) :vector)
                         (eval-iapp-list-ll-ok (%ivels) ival (1- limit))))
           (eval-iapp-ll-ok funval ival limit))
  :expand ((eval-iapp-ll-ok funval ival limit)
           (eval-iapp funval ival limit))
  :use eval-iapp-ll-ok-when-ok)

(defruled eval-tapp-list-ll-ok-cases
  (implies (and (not (zp limit))
                (implies (consp funvals)
                         (eval-tapp-ll-ok (car funvals) tval (1- limit)))
                (implies (and (consp funvals)
                              (not
                               (reserrp
                                (eval-tapp (car funvals) tval (1- limit)))))
                         (eval-tapp-list-ll-ok (cdr funvals) tval (1- limit))))
           (eval-tapp-list-ll-ok funvals tval limit))
  :expand ((eval-tapp-list-ll-ok funvals tval limit)
           (eval-tapp-list funvals tval limit))
  :use eval-tapp-list-ll-ok-when-ok)

(defruled eval-iapp-list-ll-ok-cases
  (implies (and (not (zp limit))
                (implies (consp funvals)
                         (eval-iapp-ll-ok (car funvals) ival (1- limit)))
                (implies (and (consp funvals)
                              (not
                               (reserrp
                                (eval-iapp (car funvals) ival (1- limit)))))
                         (eval-iapp-list-ll-ok (cdr funvals) ival (1- limit))))
           (eval-iapp-list-ll-ok funvals ival limit))
  :expand ((eval-iapp-list-ll-ok funvals ival limit)
           (eval-iapp-list funvals ival limit))
  :use eval-iapp-list-ll-ok-when-ok)

(defruled eval-tappn-ll-ok-cases
  (implies (and (not (zp limit))
                (implies (and (consp args)
                              (not (reserrp (%tnarg))))
                         (eval-tapp-ll-ok funval (%tnarg) (1- limit)))
                (implies (and (consp args)
                              (not (reserrp (%tnarg)))
                              (not (reserrp (%tnv1))))
                         (eval-tappn-ll-ok (%tnv1) (cdr args) denv (1- limit))))
           (eval-tappn-ll-ok funval args denv limit))
  :expand ((eval-tappn-ll-ok funval args denv limit)
           (eval-tappn funval args denv limit))
  :use eval-tappn-ll-ok-when-ok)

(defruled eval-iappn-ll-ok-cases
  (implies (and (not (zp limit))
                (implies (and (consp args)
                              (not (reserrp (%inarg))))
                         (eval-iapp-ll-ok funval (%inarg) (1- limit)))
                (implies (and (consp args)
                              (not (reserrp (%inarg)))
                              (not (reserrp (%inv1))))
                         (eval-iappn-ll-ok (%inv1) (cdr args) denv (1- limit))))
           (eval-iappn-ll-ok funval args denv limit))
  :expand ((eval-iappn-ll-ok funval args denv limit)
           (eval-iappn funval args denv limit))
  :use eval-iappn-ll-ok-when-ok)

(defruled eval-app-list-ll-ok-cases
  (implies (and (not (zp limit))
                (implies (and (consp funcells)
                              (consp argcells)
                              (expr-value-wfp (car argcells)))
                         (eval-app-cell-ll-ok (car funcells) (car argcells)
                                              (1- limit)))
                (implies (and (consp funcells)
                              (consp argcells)
                              (expr-value-wfp (car argcells))
                              (not
                               (reserrp
                                (eval-app-cell (car funcells) (car argcells)
                                                           (1- limit)))))
                         (eval-app-list-ll-ok (cdr funcells) (cdr argcells)
                                              (1- limit))))
           (eval-app-list-ll-ok funcells argcells limit))
  :expand ((eval-app-list-ll-ok funcells argcells limit)
           (eval-app-list funcells argcells limit))
  :use eval-app-list-ll-ok-when-ok)

(defruled eval-app-cell-ll-ok-cases
  (implies (and (not (zp limit))
                (implies (and (equal (expr-value-kind funcell) :lambda)
                              (expr-values-match-type-values-p
                               (list argcell)
                               (list (var+typevalue->type
                                      (expr-value-lambda->param funcell)))))
                         (eval-expr-ll-ok (expr-value-lambda->body funcell)
                                          (expr-denv-add-expr
                                           (var+typevalue->var
                                            (expr-value-lambda->param funcell))
                                           argcell
                                           (expr-value-lambda->denv funcell))
                                          (1- limit)))
                (implies (and (equal (expr-value-kind funcell) :primop)
                              (primop-value-funp
                               (expr-value-primop->val funcell)))
                         (eval-primop-fun-ll-ok (expr-value-primop->val funcell)
                                                argcell
                                                (1- limit))))
           (eval-app-cell-ll-ok funcell argcell limit))
  :expand ((eval-app-cell-ll-ok funcell argcell limit)
           (eval-app-cell funcell argcell limit))
  :use eval-app-cell-ll-ok-when-ok)

(defruled eval-unbox-ll-ok-cases
  (implies (and (not (zp limit))
                (implies (and (equal (expr-value-kind target) :box)
                              (ispace-values-match-ispace-vars-p
                               (list (expr-value-box->ispace target))
                               (list (car ispaces)))
                              (not (consp (cdr ispaces))))
                         (eval-expr-ll-ok body
                                          (expr-denv-add-expr
                                           var (expr-value-box->array target)
                                           (expr-denv-add-ispace
                                            (car ispaces)
                                            (expr-value-box->ispace target)
                                            denv))
                                          (1- limit)))
                (implies (and (equal (expr-value-kind target) :box)
                              (ispace-values-match-ispace-vars-p
                               (list (expr-value-box->ispace target))
                               (list (car ispaces)))
                              (consp (cdr ispaces)))
                         (eval-unbox-ll-ok (expr-value-box->array target)
                                           (cdr ispaces) var
                                           body type
                                           (expr-denv-add-ispace
                                            (car ispaces)
                                            (expr-value-box->ispace target)
                                            denv)
                                           (1- limit)))
                (implies (equal (expr-value-kind target) :vector)
                         (eval-unbox-list-ll-ok
                          (expr-value-vector->elems target) ispaces var
                          body type denv (1- limit))))
           (eval-unbox-ll-ok target ispaces var body type denv limit))
  :expand ((eval-unbox-ll-ok target ispaces var body type denv limit)
           (eval-unbox target ispaces var body type denv limit))
  :use eval-unbox-ll-ok-when-ok)

(defruled eval-unbox-list-ll-ok-cases
  (implies (and (not (zp limit))
                (implies (consp targets)
                         (eval-unbox-ll-ok (car targets) ispaces var body type
                                           denv
                                           (1- limit)))
                (implies (and (consp targets)
                              (not
                               (reserrp
                                (eval-unbox (car targets) ispaces var body type
                                                        denv (1- limit)))))
                         (eval-unbox-list-ll-ok (cdr targets) ispaces var body
                                                type denv
                                                (1- limit))))
           (eval-unbox-list-ll-ok targets ispaces var body type denv limit))
  :expand ((eval-unbox-list-ll-ok targets ispaces var body type denv limit)
           (eval-unbox-list targets ispaces var body type denv limit))
  :use eval-unbox-list-ll-ok-when-ok)

(defruled eval-expr-list-ll-ok-when-endp
  (implies (and (expr-listp exprs) (not (consp exprs)))
           (eval-expr-list-ll-ok exprs denv limit))
  :use eval-expr-list-ll-ok-when-ok)

(defruled eval-atom-list-ll-ok-when-endp
  (implies (and (atom-listp atoms) (not (consp atoms)))
           (eval-atom-list-ll-ok atoms denv limit))
  :use eval-atom-list-ll-ok-when-ok)

(defruled eval-bind-list-ll-ok-when-endp
  (implies (and t (not (consp binds)))
           (eval-bind-list-ll-ok binds denv limit))
  :use eval-bind-list-ll-ok-when-ok)
(defmacro %upd () '(fun-value-param-dims funval))

(defmacro %usuf ()
  '(check-list-suffix (dims-of-expr-value (car argvals)) (car (%upd))))

(defmacro %ujoin ()
  '(list-prefix-join (list (dims-of-expr-value funval) (mv-nth 1 (%usuf)))))

(defmacro %upf () '(mv-nth 1 (%ujoin)))

(defmacro %ufc ()
  '(lift-expr-value-to-frame funval (dims-of-expr-value funval) (%upf)))

(defmacro %uac ()
  '(lift-expr-value-to-frame (car argvals) (mv-nth 1 (%usuf)) (%upf)))

(defmacro %ures () '(eval-app-list (%ufc) (%uac) (1- limit)))

(defruled eval-app-ll-ok-cases
  (implies (and (not (zp limit))
                (implies (and (consp argvals)
                              (not (reserrp (%upd)))
                              (consp (%upd))
                              (mv-nth 0 (%usuf))
                              (mv-nth 0 (%ujoin))
                              (not (member-equal 0 (%upf)))
                              (not (reserrp (%ufc)))
                              (not (reserrp (%uac))))
                         (eval-app-list-ll-ok (%ufc) (%uac) (1- limit)))
                (implies (and (consp argvals)
                              (not (reserrp (%upd)))
                              (consp (%upd))
                              (mv-nth 0 (%usuf))
                              (mv-nth 0 (%ujoin))
                              (not (member-equal 0 (%upf)))
                              (not (reserrp (%ufc)))
                              (not (reserrp (%uac)))
                              (not (reserrp (%ures)))
                              (equal (len (%ures)) (nat-list-product (%upf)))
                              (expr-value-list-wfp (%ures))
                              (list-repeatp (dims-of-expr-value-list (%ures))))
                         (eval-app-ll-ok (expr-value-with-nonempty-dims
                                          (%upf) (%ures))
                                         (cdr argvals) (1- limit))))
           (eval-app-ll-ok funval argvals limit))
  :expand ((eval-app-ll-ok funval argvals limit)
           (eval-app funval argvals limit))
  :use eval-app-ll-ok-when-ok
  :enable eval-app-frames)

; The induction theorem: under the soundness of the checker, every
; statement holds, each case being discharged by the lemmas above.  It is
; proved as one formula, with a case for each statement (selected by FLAG),
; and the statements are then derived from it.

; The induction scheme.  The scheme of the evaluator clique also splits on
; whether the intermediate evaluations return errors (231 cases); this one
; makes the same recursive calls but splits only on the kinds that the case
; lemmas test (65 cases).  The functions of the clique are referenced by the
; flag values given to them here.

(local
 (defmacro ll-ok-ind-call (flag &key expr exprs atom atoms bind binds funvals
                            ival args funval argvals funcells argcells funcell
                            argcell target targets ispaces var body type denv
                            op acc cells tval t2val d s s2 fval zval arg)
   `(ll-ok-ind ',flag ,expr ,exprs ,atom ,atoms ,bind ,binds ,funvals ,ival
               ,args ,funval ,argvals ,funcells ,argcells ,funcell ,argcell
               ,target ,targets ,ispaces ,var ,body ,type ,denv ,op ,acc
               ,cells ,tval ,t2val ,d ,s ,s2 ,fval ,zval ,arg (1- limit))))

(local
 (defun-nx ll-ok-ind (flag expr exprs atom atoms bind binds funvals ival args
                      funval argvals funcells argcells funcell argcell target
                      targets ispaces var body type denv op acc cells tval
                      t2val d s s2 fval zval arg limit)
   (declare (xargs :measure (nfix limit) :verify-guards nil))
   (if (zp limit)
       nil
     (case flag
       (expr
        (let ((x expr))
          (case (expr-kind x)
            (:atom (ll-ok-ind-call atom :atom (expr-atom->atom x) :denv denv))
            (:array (ll-ok-ind-call atoms :atoms (%aas) :denv denv))
            (:frame (ll-ok-ind-call exprs :exprs (%fes) :denv denv))
            (:bracket (ll-ok-ind-call exprs :exprs (%bes) :denv denv))
            (:app
             (list (ll-ok-ind-call expr :expr (%f) :denv denv)
                   (ll-ok-ind-call expr :expr (%a) :denv denv)
                   (ll-ok-ind-call app :funval (%fval)
                                   :argvals (list (%aval)))))
            (:appn
             (list (ll-ok-ind-call expr :expr (%pf) :denv denv)
                   (ll-ok-ind-call exprs :exprs (%pas) :denv denv)
                   (ll-ok-ind-call app :funval (%pfv) :argvals (%pavs))))
            (:tapp
             (list (ll-ok-ind-call expr :expr (%tapp-f) :denv denv)
                   (ll-ok-ind-call tapp :funval (%tapp-fv)
                                   :tval (eval-type (expr-tapp->arg x)
                                                    (expr-denv->tenv denv)))))
            (:iapp
             (list (ll-ok-ind-call expr :expr (%iapp-f) :denv denv)
                   (ll-ok-ind-call iapp :funval (%iapp-fv)
                                   :ival (eval-ispace (expr-iapp->arg x)
                                                      (type-denv->ienv
                                                       (expr-denv->tenv
                                                        denv))))))
            (:tappn
             (list (ll-ok-ind-call expr :expr (%tappn-f) :denv denv)
                   (ll-ok-ind-call tappn :funval (%tappn-fv)
                                   :args (expr-tappn->args x) :denv denv)))
            (:iappn
             (list (ll-ok-ind-call expr :expr (%iappn-f) :denv denv)
                   (ll-ok-ind-call iappn :funval (%iappn-fv)
                                   :args (expr-iappn->args x) :denv denv)))
            (:capp
             (list (ll-ok-ind-call expr :expr (%capf) :denv denv)
                   (ll-ok-ind-call tappn :funval (%cfv)
                                   :args (type-list-option-some->val (%cts))
                                   :denv denv)
                   (ll-ok-ind-call iappn :funval (%ctv)
                                   :args (ispace-list-option-some->val (%cis))
                                   :denv denv)
                   (ll-ok-ind-call exprs :exprs (%cas) :denv denv)
                   (ll-ok-ind-call app :funval (%civ) :argvals (%cavs))))
            (:unbox
             (list (ll-ok-ind-call expr :expr (%ut) :denv denv)
                   (ll-ok-ind-call unbox :target (%utv) :ispaces (%uis)
                                   :var (%uv) :body (%ub) :type (%utval)
                                   :denv denv)))
            (:unboxn
             (list (ll-ok-ind-call expr :expr (%qt) :denv denv)
                   (ll-ok-ind-call unbox :target (%qtv) :ispaces (%qis)
                                   :var (%qv) :body (%qb) :type (%qtval)
                                   :denv denv)))
            (:var nil)
            (:array-empty nil)
            (:frame-empty nil)
            (:string nil)
            (otherwise ; :let
             (list (ll-ok-ind-call binds :binds (%lb) :denv denv)
                   (ll-ok-ind-call expr :expr (%lbody) :denv (%ld2)))))))
       (exprs
        (and (consp exprs)
             (list (ll-ok-ind-call expr :expr (car exprs) :denv denv)
                   (ll-ok-ind-call exprs :exprs (cdr exprs) :denv denv))))
       (atom
        (case (atom-kind atom)
          (:box (ll-ok-ind-call expr :expr (atom-box->array atom) :denv denv))
          (:boxn (ll-ok-ind-call expr :expr (atom-boxn->array atom)
                                 :denv denv))
          (otherwise nil)))
       (atoms
        (and (consp atoms)
             (list (ll-ok-ind-call atom :atom (car atoms) :denv denv)
                   (ll-ok-ind-call atoms :atoms (cdr atoms) :denv denv))))
       (bind
        (case (bind-kind bind)
          (:val (ll-ok-ind-call expr :expr (bind-val->expr bind) :denv denv))
          (:fun (ll-ok-ind-call expr :expr (bind-fun->expr bind) :denv denv))
          (:tfun (ll-ok-ind-call expr :expr (bind-tfun->expr bind)
                                 :denv denv))
          (:ifun (ll-ok-ind-call expr :expr (bind-ifun->expr bind)
                                 :denv denv))
          (:cfun (ll-ok-ind-call expr :expr (%cfe bind) :denv denv))
          (otherwise nil)))
       (binds
        (and (consp binds)
             (list (ll-ok-ind-call bind :bind (car binds) :denv denv)
                   (ll-ok-ind-call binds :binds (cdr binds)
                                   :denv (eval-bind (car binds) denv
                                                    (1- limit))))))
       (tapp
        (case (expr-value-kind funval)
          (:tlambda (ll-ok-ind-call expr :expr (%tlbody) :denv (%tlenv)))
          (:vector (ll-ok-ind-call tapps :funvals (%tvels) :tval tval))
          (otherwise nil)))
       (tapps
        (and (consp funvals)
             (list (ll-ok-ind-call tapp :funval (car funvals) :tval tval)
                   (ll-ok-ind-call tapps :funvals (cdr funvals) :tval tval))))
       (tappn
        (and (consp args)
             (list (ll-ok-ind-call tapp :funval funval :tval (%tnarg))
                   (ll-ok-ind-call tappn :funval (%tnv1) :args (cdr args)
                                   :denv denv))))
       (iapp
        (case (expr-value-kind funval)
          (:ilambda (ll-ok-ind-call expr :expr (%ilbody) :denv (%ilenv)))
          (:vector (ll-ok-ind-call iapps :funvals (%ivels) :ival ival))
          (otherwise nil)))
       (iapps
        (and (consp funvals)
             (list (ll-ok-ind-call iapp :funval (car funvals) :ival ival)
                   (ll-ok-ind-call iapps :funvals (cdr funvals) :ival ival))))
       (iappn
        (and (consp args)
             (list (ll-ok-ind-call iapp :funval funval :ival (%inarg))
                   (ll-ok-ind-call iappn :funval (%inv1) :args (cdr args)
                                   :denv denv))))
       (app
        (and (consp argvals)
             (list (ll-ok-ind-call apps :funcells (%ufc) :argcells (%uac))
                   (ll-ok-ind-call app
                                   :funval (expr-value-with-nonempty-dims
                                            (%upf) (%ures))
                                   :argvals (cdr argvals)))))
       (apps
        (and (consp funcells)
             (consp argcells)
             (list (ll-ok-ind-call app-cell :funcell (car funcells)
                                   :argcell (car argcells))
                   (ll-ok-ind-call apps :funcells (cdr funcells)
                                   :argcells (cdr argcells)))))
       (app-cell
        (case (expr-value-kind funcell)
          (:lambda
           (ll-ok-ind-call expr
                           :expr (expr-value-lambda->body funcell)
                           :denv (expr-denv-add-expr
                                  (var+typevalue->var
                                   (expr-value-lambda->param funcell))
                                  argcell
                                  (expr-value-lambda->denv funcell))))
          (:primop (ll-ok-ind-call primop-fun
                                   :op (expr-value-primop->val funcell)
                                   :arg argcell))
          (otherwise nil)))
       (unbox
        (case (expr-value-kind target)
          (:box
           (list (ll-ok-ind-call expr
                                 :expr body
                                 :denv (expr-denv-add-expr
                                        var (expr-value-box->array target)
                                        (expr-denv-add-ispace
                                         (car ispaces)
                                         (expr-value-box->ispace target)
                                         denv)))
                 (ll-ok-ind-call unbox
                                 :target (expr-value-box->array target)
                                 :ispaces (cdr ispaces) :var var :body body
                                 :type type
                                 :denv (expr-denv-add-ispace
                                        (car ispaces)
                                        (expr-value-box->ispace target)
                                        denv))))
          (:vector (ll-ok-ind-call unboxes
                                   :targets (expr-value-vector->elems target)
                                   :ispaces ispaces :var var :body body
                                   :type type :denv denv))
          (otherwise nil)))
       (unboxes
        (and (consp targets)
             (list (ll-ok-ind-call unbox :target (car targets)
                                   :ispaces ispaces :var var :body body
                                   :type type :denv denv)
                   (ll-ok-ind-call unboxes :targets (cdr targets)
                                   :ispaces ispaces :var var :body body
                                   :type type :denv denv))))
       (primop-fun
        (case (primop-value-kind op)
          (:reduce-t-d-s-f
           (ll-ok-ind-call reduce
                           :tval (primop-value-reduce-t-d-s-f->tval op)
                           :d (primop-value-reduce-t-d-s-f->dval op)
                           :s (primop-value-reduce-t-d-s-f->sval op)
                           :fval (primop-value-reduce-t-d-s-f->fval op)
                           :arg arg))
          (:fold-t-t2-d-s-s2-f-z
           (ll-ok-ind-call fold
                           :tval (primop-value-fold-t-t2-d-s-s2-f-z->tval op)
                           :t2val (primop-value-fold-t-t2-d-s-s2-f-z->t2val op)
                           :d (primop-value-fold-t-t2-d-s-s2-f-z->dval op)
                           :s (primop-value-fold-t-t2-d-s-s2-f-z->sval op)
                           :s2 (primop-value-fold-t-t2-d-s-s2-f-z->s2val op)
                           :fval (primop-value-fold-t-t2-d-s-s2-f-z->fval op)
                           :zval (primop-value-fold-t-t2-d-s-s2-f-z->zval op)
                           :arg arg))
          (otherwise nil)))
       (reduce/fold-loop
        (and (consp cells)
             (list (ll-ok-ind-call app-cell :funcell fval :argcell acc)
                   (ll-ok-ind-call app-cell
                                   :funcell (eval-app-cell fval acc (1- limit))
                                   :argcell (car cells))
                   (ll-ok-ind-call reduce/fold-loop
                                   :acc (eval-app-cell
                                         (eval-app-cell fval acc (1- limit))
                                         (car cells) (1- limit))
                                   :cells (cdr cells) :fval fval))))
       (reduce
        (ll-ok-ind-call reduce/fold-loop :acc (car (%rcells))
                        :cells (cdr (%rcells)) :fval fval))
       (otherwise
        (ll-ok-ind-call reduce/fold-loop :acc zval :cells (%rcells)
                        :fval fval))))))

(local
 (defthm ll-ok-holds-flag
   (case flag
    (expr
     (implies (and (check-sound-p) (exprp expr))
              (eval-expr-ll-ok expr denv limit)))
    (exprs
     (implies (and (check-sound-p) (expr-listp exprs))
              (eval-expr-list-ll-ok exprs denv limit)))
    (atom
     (implies (and (check-sound-p) (atomp atom))
              (eval-atom-ll-ok atom denv limit)))
    (atoms
     (implies (and (check-sound-p) (atom-listp atoms))
              (eval-atom-list-ll-ok atoms denv limit)))
    (bind
     (implies (check-sound-p)
              (eval-bind-ll-ok bind denv limit)))
    (binds
     (implies (check-sound-p)
              (eval-bind-list-ll-ok binds denv limit)))
    (tapp
     (implies (check-sound-p)
              (eval-tapp-ll-ok funval tval limit)))
    (tapps
     (implies (check-sound-p)
              (eval-tapp-list-ll-ok funvals tval limit)))
    (tappn
     (implies (check-sound-p)
              (eval-tappn-ll-ok funval args denv limit)))
    (iapp
     (implies (check-sound-p)
              (eval-iapp-ll-ok funval ival limit)))
    (iapps
     (implies (check-sound-p)
              (eval-iapp-list-ll-ok funvals ival limit)))
    (iappn
     (implies (check-sound-p)
              (eval-iappn-ll-ok funval args denv limit)))
    (app
     (implies (check-sound-p)
              (eval-app-ll-ok funval argvals limit)))
    (apps
     (implies (check-sound-p)
              (eval-app-list-ll-ok funcells argcells limit)))
    (app-cell
     (implies (check-sound-p)
              (eval-app-cell-ll-ok funcell argcell limit)))
    (unbox
     (implies (and (check-sound-p) (exprp body))
              (eval-unbox-ll-ok target ispaces var body type denv limit)))
    (unboxes
     (implies (and (check-sound-p) (exprp body))
              (eval-unbox-list-ll-ok targets ispaces var body type denv
                                     limit)))
    (primop-fun
     (implies (check-sound-p)
              (eval-primop-fun-ll-ok op arg limit)))
    (reduce/fold-loop
     (implies (check-sound-p)
              (prim-reduce/fold-loop-ll-ok acc cells fval limit)))
    (reduce
     (implies (check-sound-p)
              (prim-reduce-ll-ok tval d s fval arg limit)))
    (otherwise ; fold
     (implies (check-sound-p)
              (prim-fold-ll-ok tval t2val d s s2 fval zval arg limit))))
   :rule-classes nil
   :hints (("Goal"
            :induct (ll-ok-ind flag expr exprs atom atoms bind binds funvals
                               ival args funval argvals funcells argcells
                               funcell argcell target targets ispaces var body
                               type denv op acc cells tval t2val d s s2 fval
                               zval arg limit)
            :in-theory
            (e/d
             (cfun-expression
              eval-expr-ll-ok-when-zp-limit
              eval-expr-list-ll-ok-when-zp-limit
              eval-atom-ll-ok-when-zp-limit
              eval-atom-list-ll-ok-when-zp-limit
              eval-bind-ll-ok-when-zp-limit
              eval-bind-list-ll-ok-when-zp-limit
              eval-tapp-ll-ok-when-zp-limit
              eval-tapp-list-ll-ok-when-zp-limit
              eval-tappn-ll-ok-when-zp-limit
              eval-iapp-ll-ok-when-zp-limit
              eval-iapp-list-ll-ok-when-zp-limit
              eval-iappn-ll-ok-when-zp-limit
              eval-app-ll-ok-when-zp-limit
              eval-app-list-ll-ok-when-zp-limit
              eval-app-cell-ll-ok-when-zp-limit
              eval-unbox-ll-ok-when-zp-limit
              eval-unbox-list-ll-ok-when-zp-limit
              eval-primop-fun-ll-ok-when-zp-limit
              prim-reduce/fold-loop-ll-ok-when-zp-limit
              prim-reduce-ll-ok-when-zp-limit
              prim-fold-ll-ok-when-zp-limit
              eval-expr-ll-ok-when-var
              eval-expr-ll-ok-when-array-empty
              eval-expr-ll-ok-when-frame-empty
              eval-expr-ll-ok-when-string
              eval-expr-ll-ok-when-atom
              eval-expr-ll-ok-when-array
              eval-expr-ll-ok-when-frame
              eval-expr-ll-ok-when-bracket
              eval-expr-ll-ok-when-app
              eval-expr-ll-ok-when-appn
              eval-expr-ll-ok-when-tapp
              eval-expr-ll-ok-when-iapp
              eval-expr-ll-ok-when-tappn
              eval-expr-ll-ok-when-iappn
              eval-expr-ll-ok-when-capp
              eval-expr-ll-ok-when-unbox
              eval-expr-ll-ok-when-unboxn
              eval-expr-ll-ok-when-let
              eval-expr-list-ll-ok-when-endp
              eval-expr-list-ll-ok-cases
              eval-atom-list-ll-ok-when-endp
              eval-atom-list-ll-ok-cases
              eval-atom-ll-ok-cases
              eval-bind-ll-ok-cases
              eval-bind-list-ll-ok-when-endp
              eval-bind-list-ll-ok-cases
              eval-tapp-ll-ok-cases
              eval-iapp-ll-ok-cases
              eval-tapp-list-ll-ok-cases
              eval-iapp-list-ll-ok-cases
              eval-tappn-ll-ok-cases
              eval-iappn-ll-ok-cases
              eval-app-list-ll-ok-cases
              eval-app-cell-ll-ok-cases
              eval-unbox-ll-ok-cases
              eval-unbox-list-ll-ok-cases
              eval-app-ll-ok-cases
              eval-primop-fun-ll-ok-when-ok
              prim-reduce/fold-loop-ll-ok-when-ok
              prim-reduce-ll-ok-when-ok
              prim-fold-ll-ok-when-ok)
             (check-sound-p
              acl2::zp-open
              fty::reserrp-when-reserr-optionp
              fty::reserr-optionp-when-reserrp
              default-<-1
              default-<-2))))))

(defthm eval-expr-ll-ok-holds
  (implies (and (check-sound-p) (exprp expr))
           (eval-expr-ll-ok expr denv limit))
  :hints (("Goal" :use (:instance ll-ok-holds-flag (flag 'expr)))))
