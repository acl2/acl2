  (implies (implies (consp args)
                    (and (eval-iapp-ll-ok funval (%inarg) (1- limit))
                         (eval-iappn-ll-ok (%inv1) (cdr args) denv (1- limit))))
           (eval-iappn-ll-ok funval args denv limit))
  :cases ((consp args))
  :hints (("Subgoal 2"
           :use ((:instance eval-iappn-when-ok-local (f funval) (as args)
                            (d denv) (l limit))
                 (:instance eval-iappn-when-ok-local (f (%inf)) (as args)
                            (d (%ind)) (l limit))
                 (:instance expr-value-ll-related-p-of-fixes
                            (nv (%inf)) (v funval) (w (%inwv)) (genv (%ing)))
                 (:instance eval-iappn-ll-reaches-p-suff
                            (new-funval (%inf)) (new-denv (%ind))
                            (limit2 limit) (w (%inwv))
                            (val (eval-iappn funval args denv limit))
                            (genv (%ing))))
           :expand ((eval-iappn-ll-ok funval args denv limit)
                    (eval-iappn (%inf) args (%ind) limit)))
          ("Subgoal 1"
           :use ((:instance eval-iappn-when-ok-local (f funval) (as args)
                            (d denv) (l limit))
                 (:instance eval-iappn-ll-reaches-p-of-cons-step
                            (f funval) (iv (%inarg)) (l (1- limit))
                            (nf (%inf)) (w (%inwv)) (nd (%ind)) (g (%ing))))
           :expand ((eval-iappn-ll-ok funval args denv limit))))
  :disable (eval-iapp eval-iappn eval-iapp-ll-ok eval-iappn-ll-ok
            eval-iapp-ll-ok-necc eval-iappn-ll-ok-necc eval-iapp-ll-reaches-p
            eval-iappn-ll-reaches-p eval-iappn-ll-reaches-p-suff
            expr-value-ll-related-p expr-value-wfp-of-eval-iapp)
  :enable (not-reserrp-when-expr-valuep))


; Binding one excluded variable, out of several.

(defruled difference-of-mergesort-cons-local
  (equal (set::difference s (set::mergesort (cons v0 excl)))
         (set::delete v0 (set::difference s (set::mergesort excl))))
  :enable (set::double-containment set::pick-a-point-subset-strategy))

(defruled expr-denv-ll-related-p-of-add-excluded-more
  (implies (and (expr-denv-ll-related-p nd d y ctx (cons v0 excl) dw genv)
                (stringp v0)
                (string-listp excl)
                (set::in v0 (ll-context->locals ctx))
                (not (omap::assoc v0 (ll-context->lmap ctx)))
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx) pnames genv)
                (string-listp pnames)
                (member-equal v0 pnames)
                (not (member-equal v0 excl))
                (expr-valuep val)
                (expr-valuep nv)
                (ll-value-witness-p w)
                (implies (set::in v0 (expr-free-expr-vars
                                      (ll-context-new-expr y ctx)))
                         (expr-value-ll-related-p nv val w genv))
                (value-meets-required-type-p val v0 (ll-context->tenv ctx))
                (value-meets-required-type-p nv v0 (ll-context->tenv ctx))
                (implies (set::in v0 (ll-context->tlets ctx))
                         (value-has-inferred-type-p val v0
                                                    (ll-context->tenv ctx))))
           (expr-denv-ll-related-p (expr-denv-add-expr v0 nv nd)
                                   (expr-denv-add-expr v0 val d)
                                   y ctx excl (ll-denv-witness-add v0 w dw)
                                   genv))
  :use ((:instance walker-of-add-excluded
                   (fv (set::difference (expr-free-expr-vars y)
                                        (set::mergesort excl)))
                   (nfv (expr-free-expr-vars (ll-context-new-expr y ctx))))
        (:instance ll-var-ok-p-of-added
                   (nfv (expr-free-expr-vars (ll-context-new-expr y ctx))))
        (:instance names-bound-as-in-p-of-add-expr
                   (s (set::difference
                       (expr-free-expr-vars (ll-context-new-expr y ctx))
                       (ll-context->locals ctx))))
        (:instance new-values-meet-types-p-of-add-expr
                   (names (set::difference
                           (set::intersect
                            (expr-free-expr-vars (ll-context-new-expr y ctx))
                            (ll-context->locals ctx))
                           (set::mergesort excl)))
                   (tenv (ll-context->tenv ctx)))
        (:instance difference-of-mergesort-cons-local
                   (s (expr-free-expr-vars y)))
        (:instance difference-of-mergesort-cons-local
                   (s (set::intersect
                       (expr-free-expr-vars (ll-context-new-expr y ctx))
                       (ll-context->locals ctx)))))
  :expand ((expr-denv-ll-related-p nd d y ctx (cons v0 excl) dw genv)
           (expr-denv-ll-related-p (expr-denv-add-expr v0 nv nd)
                                   (expr-denv-add-expr v0 val d)
                                   y ctx excl (ll-denv-witness-add v0 w dw)
                                   genv))
  :enable (str::string-list-fix-when-string-listp)
  :disable (walker-of-add-excluded ll-var-ok-p lmap-replacements-ok-p
            names-bound-as-in-p-when-subset new-values-meet-types-p-when-subset
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; EVAL-APP-CELL of a related lambda closure.

(defruled posp-limit-when-eval-app-cell-ok
  (implies (not (reserrp (eval-app-cell funcell argcell limit)))
           (posp limit))
  :expand ((eval-app-cell funcell argcell limit)))

(defruled eval-app-cell-at-larger-limit
  (implies (and (not (reserrp (eval-app-cell funcell argcell limit)))
                (integerp limit2)
                (<= limit limit2))
           (equal (eval-app-cell funcell argcell limit2)
                  (eval-app-cell funcell argcell limit)))
  :use (posp-limit-when-eval-app-cell-ok
        (:instance eval-app-cell-of-larger-limit (k (- limit2 limit)))))

(defruled eval-app-cell-ll-reaches-p-elim
  (implies (eval-app-cell-ll-reaches-p new-funcell new-argcell val genv)
           (b* (((mv l w)
                 (eval-app-cell-ll-reaches-p-witness new-funcell new-argcell val
                                                     genv))
                (nv (eval-app-cell new-funcell new-argcell l)))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv val w genv))))
  :enable eval-app-cell-ll-reaches-p)

(defmacro %lwc () '(ll-value-witness-lambda->ctx w))

(defmacro %lwp () '(ll-value-witness-lambda->prest w))

(defmacro %lwf () '(ll-value-witness-lambda->flat w))

(defmacro %lwd () '(ll-value-witness-lambda->denv w))

(defmacro %lfv () '(var+typevalue->var (expr-value-lambda->param f)))

(defmacro %lpn () '(cons (%lfv) (var+type?-list->var (%lwp))))

(defmacro %lcbp ()
  '(closure-body-parts (expr-value-lambda->body f)
                       (expr-value-lambda->type? f)
                       (%lwp) (%lwf)))

(defruled lambda-related-unpack
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (expr-value-kind f) :lambda))
           (and (equal (expr-value-kind nf) :lambda)
                (equal (ll-value-witness-kind w) :lambda)
                (mv-nth 0 (%lcbp))
                (equal (expr-value-lambda->param nf)
                       (expr-value-lambda->param f))
                (equal (expr-value-lambda->type? nf)
                       (expr-value-lambda->type? f))
                (equal (expr-value-lambda->body nf)
                       (lifted-closure-body
                        (%lwp)
                        (ll-context-new-expr (mv-nth 1 (%lcbp)) (%lwc))
                        (mv-nth 2 (%lcbp))))
                (no-duplicatesp-equal (%lpn))
                (names-in-context-p (%lpn) (%lwc))
                (lmap-replacements-ok-p (ll-context->lmap (%lwc))
                                        (ll-context->locals (%lwc))
                                        (%lpn) genv)
                (param-type-consistent-p (expr-value-lambda->param f)
                                         (ll-context->tenv (%lwc)))
                (prest-tenv-consistent-p (%lwp) (ll-context->tenv (%lwc)))
                (ll-context-ok-p (mv-nth 1 (%lcbp)) (%lwc) genv)
                (expr-denv-ll-related-p (expr-value-lambda->denv nf)
                                        (expr-value-lambda->denv f)
                                        (mv-nth 1 (%lcbp)) (%lwc) (%lpn)
                                        (%lwd) genv)))
  :expand ((expr-value-ll-related-p nf f w genv))
  :enable (expr-value-groundp)
  :disable (ll-context-ok-p expr-denv-ll-related-p closure-body-parts
            names-in-context-p lmap-replacements-ok-p param-type-consistent-p
            prest-tenv-consistent-p lifted-closure-body))

; With no remaining parameters, the original body is the inner one.

(defruled lambda-chain-when-no-params
  (implies (not (consp (mv-nth 0 (lambda-chain body type?))))
           (equal (mv-nth 1 (lambda-chain body type?))
                  (expr-fix body)))
  :expand ((lambda-chain body type?))
  :use ((:instance nested-lambda-params-consp))
  :disable (nested-lambda-params-consp))

(defruled closure-body-parts-of-no-prest
  (implies (and (not (consp prest))
                (mv-nth 0 (closure-body-parts body type? prest flat)))
           (equal (mv-nth 1 (closure-body-parts body type? prest flat))
                  (expr-fix body)))
  :enable (closure-body-parts)
  :use ((:instance lambda-chain-when-no-params
                   (body (expr-fix body)) (type? (type-option-none)))))

; Values with the same dimensions match the same type values.

(defruled expr-values-match-type-values-p-of-list-when-same-dims
  (implies (equal (dims-of-expr-value nv) (dims-of-expr-value v))
           (equal (expr-values-match-type-values-p (list nv) tvs)
                  (expr-values-match-type-values-p (list v) tvs)))
  :enable (expr-values-match-type-values-p))

(defruled eval-app-cell-when-lambda-local
  (implies (and (equal (expr-value-kind f) :lambda)
                (not (reserrp (eval-app-cell f a l))))
           (and (posp l)
                (expr-values-match-type-values-p
                 (list a) (list (var+typevalue->type
                                 (expr-value-lambda->param f))))
                (equal (eval-app-cell f a l)
                       (eval-expr (expr-value-lambda->body f)
                                  (expr-denv-add-expr
                                   (%lfv) a (expr-value-lambda->denv f))
                                  (1- l)))))
  :expand ((eval-app-cell f a l)))

(defruled eval-app-cell-of-lambda-at-succ
  (implies (and (equal (expr-value-kind f) :lambda)
                (expr-values-match-type-values-p
                 (list a) (list (var+typevalue->type
                                 (expr-value-lambda->param f))))
                (natp l))
           (equal (eval-app-cell f a (+ 1 l))
                  (eval-expr (expr-value-lambda->body f)
                             (expr-denv-add-expr
                              (%lfv) a (expr-value-lambda->denv f))
                             l)))
  :expand ((eval-app-cell f a (+ 1 l))))

; The argument meets the requirement of the parameter's type.

(defruled value-meets-required-type-p-of-param
  (implies (and (param-type-consistent-p p tenv)
                (expr-values-match-type-values-p
                 (list a) (list (var+typevalue->type p))))
           (value-meets-required-type-p a (var+typevalue->var p) tenv))
  :enable (param-type-consistent-p value-meets-required-type-p))

(defruled value-meets-required-type-p-of-expr-value-fix
  (equal (value-meets-required-type-p (expr-value-fix v) name tenv)
         (value-meets-required-type-p v name tenv))
  :enable (value-meets-required-type-p expr-values-match-type-values-p))

(defruled ll-denv-witness-add-of-ll-value-witness-fix
  (equal (ll-denv-witness-add v0 (ll-value-witness-fix w) dw)
         (ll-denv-witness-add v0 w dw))
  :enable (ll-denv-witness-add))

; A closure over its last parameter: the bodies are evaluated in the
; environments extended with the related arguments.

(defmacro %lcbody () '(expr-value-lambda->body f))

(defmacro %lcenv () '(expr-denv-add-expr (%lfv) a (expr-value-lambda->denv f)))

(defmacro %nlcenv ()
  '(expr-denv-add-expr (%lfv) na (expr-value-lambda->denv nf)))

(defmacro %lcdw () '(ll-denv-witness-add (%lfv) w2 (%lwd)))

(defmacro %lcrw ()
  '(eval-expr-ll-reaches-p-witness (ll-context-new-expr (%lcbody) (%lwc))
                                   (%nlcenv) (eval-app-cell f a limit) genv))

(defruled lambda-last-env-related
  (implies (and (equal (expr-value-kind f) :lambda)
                (not (consp (%lwp)))
                (expr-value-ll-related-p nf f w genv)
                (expr-value-ll-related-p na a w2 genv)
                (expr-value-wfp a)
                (expr-value-wfp na)
                (expr-values-match-type-values-p
                 (list a) (list (var+typevalue->type
                                 (expr-value-lambda->param f)))))
           (expr-denv-ll-related-p (%nlcenv) (%lcenv) (%lcbody) (%lwc) nil
                                   (%lcdw) genv))
  :use (lambda-related-unpack
        (:instance closure-body-parts-of-no-prest
                   (body (expr-value-lambda->body f))
                   (type? (expr-value-lambda->type? f))
                   (prest (%lwp)) (flat (%lwf)))
        (:instance dims-of-expr-value-when-ll-related
                   (new-val na) (val a) (w w2))
        (:instance expr-values-match-type-values-p-of-list-when-same-dims
                   (nv na) (v a)
                   (tvs (list (var+typevalue->type
                               (expr-value-lambda->param f)))))
        (:instance value-meets-required-type-p-of-param
                   (p (expr-value-lambda->param f))
                   (tenv (ll-context->tenv (%lwc))))
        (:instance value-meets-required-type-p-of-param
                   (a na) (p (expr-value-lambda->param f))
                   (tenv (ll-context->tenv (%lwc))))
        (:instance expr-value-ll-related-p-of-fixes (nv na) (v a) (w w2))
        (:instance expr-denv-ll-related-p-of-add-excluded
                   (nd (expr-value-lambda->denv nf))
                   (d (expr-value-lambda->denv f))
                   (y (%lcbody)) (ctx (%lwc)) (v0 (%lfv)) (dw (%lwd))
                   (pnames (list (%lfv)))
                   (val (expr-value-fix a)) (nv (expr-value-fix na))
                   (w (ll-value-witness-fix w2))))
  :expand ((names-in-context-p (list (%lfv)) (%lwc))
           (var+type?-list->var (%lwp)))
  :enable (value-meets-required-type-p-of-expr-value-fix
           ll-denv-witness-add-of-ll-value-witness-fix)
  :disable (ll-context-ok-p expr-denv-ll-related-p closure-body-parts
            names-in-context-p lmap-replacements-ok-p param-type-consistent-p
            prest-tenv-consistent-p lifted-closure-body expr-value-ll-related-p
            value-meets-required-type-p))

(defruled eval-app-cell-ll-reaches-p-when-lambda-last
  (implies (and (equal (expr-value-kind f) :lambda)
                (not (consp (%lwp)))
                (not (reserrp (eval-app-cell f a limit)))
                (eval-expr-ll-ok (%lcbody) (%lcenv) (1- limit))
                (expr-value-ll-related-p nf f w genv)
                (expr-value-ll-related-p na a w2 genv)
                (expr-value-wfp f)
                (expr-value-wfp nf)
                (expr-value-wfp a)
                (expr-value-wfp na))
           (eval-app-cell-ll-reaches-p nf na (eval-app-cell f a limit) genv))
  :use ((:instance eval-app-cell-when-lambda-local (l limit))
        lambda-related-unpack
        lambda-last-env-related
        (:instance closure-body-parts-of-no-prest
                   (body (expr-value-lambda->body f))
                   (type? (expr-value-lambda->type? f))
                   (prest (%lwp)) (flat (%lwf)))
        (:instance dims-of-expr-value-when-ll-related
                   (new-val na) (val a) (w w2))
        (:instance expr-values-match-type-values-p-of-list-when-same-dims
                   (nv na) (v a)
                   (tvs (list (var+typevalue->type
                               (expr-value-lambda->param f)))))
        (:instance eval-expr-ll-ok-necc
                   (expr (%lcbody)) (denv (%lcenv)) (limit (1- limit))
                   (ctx (%lwc)) (new-denv (%nlcenv)) (dw (%lcdw)))
        (:instance eval-expr-ll-reaches-p-elim
                   (new-expr (ll-context-new-expr (%lcbody) (%lwc)))
                   (new-denv (%nlcenv)) (val (eval-app-cell f a limit)))
        (:instance posp-limit-when-eval-expr-ok
                   (expr (ll-context-new-expr (%lcbody) (%lwc)))
                   (denv (%nlcenv)) (limit (mv-nth 0 (%lcrw))))
        (:instance eval-app-cell-of-lambda-at-succ
                   (f nf) (a na) (l (mv-nth 0 (%lcrw))))
        (:instance eval-app-cell-ll-reaches-p-suff
                   (new-funcell nf) (new-argcell na)
                   (limit2 (+ 1 (mv-nth 0 (%lcrw)))) (w (mv-nth 1 (%lcrw)))
                   (val (eval-app-cell f a limit))))
  :enable (lambda-related-unpack lambda-last-env-related lifted-closure-body)
  :disable (ll-context-ok-p expr-denv-ll-related-p closure-body-parts
            names-in-context-p lmap-replacements-ok-p param-type-consistent-p
            prest-tenv-consistent-p expr-value-ll-related-p eval-expr
            eval-app-cell eval-expr-ll-ok eval-expr-ll-ok-necc
            eval-expr-ll-reaches-p eval-app-cell-ll-reaches-p
            eval-app-cell-ll-reaches-p-suff))

; EVAL-APP-CELL of a related primitive operation.  A ground operation is
; related to itself via ground witnesses for its expression values.

(defruled expr-value-ll-related-p-of-ground-constant
  (implies (expr-value-groundp val)
           (expr-value-ll-related-p val val '(:ground) genv))
  :use expr-value-ll-related-p-of-ground)

(defruled primop-value-ll-related-p-of-ground
  (implies (primop-value-groundp op)
           (primop-value-ll-related-p op op
                                      (list (ll-value-witness-ground)
                                            (ll-value-witness-ground))
                                      genv))
  :expand ((:free (ws) (primop-value-ll-related-p op op ws genv))
           (primop-value-groundp op))
  :enable (expr-value-ll-related-p-of-ground-constant))

(defruled primop-value-kind-when-related
  (implies (primop-value-ll-related-p new-op op ws genv)
           (equal (primop-value-kind new-op) (primop-value-kind op)))
  :expand ((primop-value-ll-related-p new-op op ws genv)))

(defruled primop-value-funp-when-related
  (implies (primop-value-ll-related-p new-op op ws genv)
           (equal (primop-value-funp new-op) (primop-value-funp op)))
  :use primop-value-kind-when-related
  :enable (primop-value-funp))

(defruled kind-and-primop-equal-when-fixes-equal
  (implies (equal (expr-value-fix x) (expr-value-fix y))
           (and (equal (expr-value-kind x) (expr-value-kind y))
                (equal (expr-value-primop->val x) (expr-value-primop->val y))))
  :use ((:instance (:theorem (implies (equal a b)
                                      (and (equal (expr-value-kind a)
                                                  (expr-value-kind b))
                                           (equal (expr-value-primop->val a)
                                                  (expr-value-primop->val b)))))
                   (a (expr-value-fix x)) (b (expr-value-fix y)))))

(defmacro %pws ()
  '(if (equal (ll-value-witness-kind w) :ground)
       (list (ll-value-witness-ground) (ll-value-witness-ground))
     (ll-value-witness-primop->ws w)))

(defruled primop-related-unpack-any
  (implies (and (expr-value-ll-related-p nf f w genv)
                (equal (expr-value-kind f) :primop))
           (and (equal (expr-value-kind nf) :primop)
                (primop-value-ll-related-p (expr-value-primop->val nf)
                                           (expr-value-primop->val f)
                                           (%pws) genv)))
  :cases ((equal (ll-value-witness-kind w) :ground))
  :hints (("Subgoal 1"
           :use ((:instance groundp-when-related-via-ground)
                 (:instance primop-value-ll-related-p-of-ground
                            (op (expr-value-primop->val f)))
                 (:instance kind-and-primop-equal-when-fixes-equal
                            (x nf) (y f)))
           :expand ((expr-value-groundp f))
           :in-theory
           (disable
            expr-value-ll-related-p-when-groundp
            expr-value-kind$inline-expr-value-equiv-congruence-on-x
            expr-value-primop->val$inline-expr-value-equiv-congruence-on-x
            primop-value-ll-related-p
            expr-value-ll-related-p))
          ("Subgoal 2" :use primop-related-unpack))
  :disable (primop-value-ll-related-p expr-value-ll-related-p))

(defruled eval-app-cell-when-primop-local
  (implies (and (equal (expr-value-kind f) :primop)
                (not (reserrp (eval-app-cell f a l))))
           (and (posp l)
                (primop-value-funp (expr-value-primop->val f))
                (equal (eval-app-cell f a l)
                       (eval-primop-fun (expr-value-primop->val f) a
                                        (1- l)))))
  :expand ((eval-app-cell f a l)))

(defruled eval-app-cell-of-primop-at-succ
  (implies (and (equal (expr-value-kind f) :primop)
                (primop-value-funp (expr-value-primop->val f))
                (natp l))
           (equal (eval-app-cell f a (+ 1 l))
                  (eval-primop-fun (expr-value-primop->val f) a l)))
  :expand ((eval-app-cell f a (+ 1 l))))

(defruled posp-limit-when-eval-primop-fun-ok
  (implies (not (reserrp (eval-primop-fun op arg limit)))
           (posp limit))
  :expand ((eval-primop-fun op arg limit)))

(defruled eval-primop-fun-ll-reaches-p-elim
  (implies (eval-primop-fun-ll-reaches-p new-op new-arg val genv)
           (b* (((mv l w)
                 (eval-primop-fun-ll-reaches-p-witness new-op new-arg val
                                                       genv))
                (nv (eval-primop-fun new-op new-arg l)))
             (and (not (reserrp nv))
                  (expr-value-ll-related-p nv val w genv))))
  :enable eval-primop-fun-ll-reaches-p)

(defmacro %pfw ()
  '(eval-primop-fun-ll-reaches-p-witness (expr-value-primop->val nf) na
                                         (eval-app-cell f a limit) genv))

(defruled eval-app-cell-ll-reaches-p-when-primop
  (implies (and (equal (expr-value-kind f) :primop)
                (not (reserrp (eval-app-cell f a limit)))
                (eval-primop-fun-ll-ok (expr-value-primop->val f) a (1- limit))
                (expr-value-ll-related-p nf f w genv)
                (expr-value-ll-related-p na a w2 genv)
                (expr-value-wfp f)
                (expr-value-wfp nf)
                (expr-value-wfp a)
                (expr-value-wfp na))
           (eval-app-cell-ll-reaches-p nf na (eval-app-cell f a limit) genv))
  :use ((:instance eval-app-cell-when-primop-local (l limit))
        primop-related-unpack-any
        (:instance primop-value-funp-when-related
                   (new-op (expr-value-primop->val nf))
                   (op (expr-value-primop->val f)) (ws (%pws)))
        (:instance eval-primop-fun-ll-ok-necc
                   (op (expr-value-primop->val f)) (arg a) (limit (1- limit))
                   (new-op (expr-value-primop->val nf)) (new-arg na)
                   (ws (%pws)) (w w2))
        (:instance eval-primop-fun-ll-reaches-p-elim
                   (new-op (expr-value-primop->val nf)) (new-arg na)
                   (val (eval-app-cell f a limit)))
        (:instance posp-limit-when-eval-primop-fun-ok
                   (op (expr-value-primop->val nf)) (arg na)
                   (limit (mv-nth 0 (%pfw))))
        (:instance eval-app-cell-of-primop-at-succ
                   (f nf) (a na) (l (mv-nth 0 (%pfw))))
        (:instance eval-app-cell-ll-reaches-p-suff
                   (new-funcell nf) (new-argcell na)
                   (limit2 (+ 1 (mv-nth 0 (%pfw)))) (w (mv-nth 1 (%pfw)))
                   (val (eval-app-cell f a limit))))
  :disable (expr-value-ll-related-p primop-value-ll-related-p eval-app-cell
            eval-primop-fun eval-primop-fun-ll-ok eval-primop-fun-ll-ok-necc
            eval-primop-fun-ll-reaches-p eval-app-cell-ll-reaches-p
            eval-app-cell-ll-reaches-p-suff primop-value-funp))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Restricting related environments with some variables excluded: the
; replacements of the hoisted functions do not refer to the excluded
; variables, so whether a variable is referred to does not depend on them.

(defruled in-difference-mergesort-when-disjoint
  (implies (and (set::in a x)
                (set::subset x n)
                (set::subset x (set::mergesort hns))
                (not (intersectp-equal hns excl)))
           (set::in a (set::difference n (set::mergesort excl))))
  :use ((:instance set::subset-in (a a) (x x) (y (set::mergesort hns)))
        (:instance set::subset-in (a a) (x x) (y n))
        (:instance acl2::intersectp-member (a a) (x hns) (y excl)))
  :disable (set::subset-in acl2::intersectp-member))

(defruled subset-of-difference-mergesort-when-disjoint-1
  (implies (and (set::subset x n)
                (set::subset x (set::mergesort hns))
                (not (intersectp-equal hns excl)))
           (set::subset x (set::difference n (set::mergesort excl))))
  :enable (set::pick-a-point-subset-strategy
           in-difference-mergesort-when-disjoint))

(defruled subset-of-difference-mergesort-when-disjoint
  (implies (and (set::subset x (set::mergesort hns))
                (not (intersectp-equal hns excl)))
           (equal (set::subset x (set::difference n (set::mergesort excl)))
                  (set::subset x n)))
  :use (subset-of-difference-mergesort-when-disjoint-1
        (:instance set::subset-transitive
                   (x x) (y (set::difference n (set::mergesort excl))) (z n))))

(defruled intersect-of-replacement-vars-and-locals
  (implies (and (stringp h)
                (string-listp hns)
                (not (set::in h locals))
                (string-setp locals))
           (set::subset (set::intersect
                         (expr-free-expr-vars (apply-to-names (expr-var h) hns))
                         locals)
                        (set::mergesort hns)))
  :enable (set::pick-a-point-subset-strategy)
  :expand ((:free (n) (expr-free-expr-vars (expr-var n))))
  :disable (apply-to-names))

(defruled not-intersectp-when-subsetp-of-other
  (implies (and (not (intersectp-equal hns pnames))
                (subsetp-equal excl pnames))
           (not (intersectp-equal hns excl)))
  :enable (acl2::intersectp-member acl2::subsetp-member)
  :use ((:instance acl2::intersectp-witness-rw (x hns) (y excl))))

(defruled ll-var-referred-ok-p-of-nfv-minus-excl
  (implies (and (stringp v)
                (not (member-equal v excl))
                (implies (omap::assoc v (ll-context->lmap ctx))
                         (ll-replacement-ok-p
                          (cdr (omap::assoc v (ll-context->lmap ctx)))
                          (ll-context->locals ctx) pnames genv))
                (string-listp pnames)
                (string-listp excl)
                (subsetp-equal excl pnames))
           (equal (ll-var-referred-ok-p v val nd
                                        (set::difference
                                         nfv (set::mergesort excl))
                                        ctx dw genv)
                  (ll-var-referred-ok-p v val nd nfv ctx dw genv)))
  :use ((:instance ll-replacement-ok-p-unpack
                   (repl (cdr (omap::assoc v (ll-context->lmap ctx))))
                   (locals (ll-context->locals ctx)))
        (:instance intersect-of-replacement-vars-and-locals
                   (h (mv-nth 1 (replacement-parts
                                 (cdr (omap::assoc v (ll-context->lmap ctx))))))
                   (hns (mv-nth 2 (replacement-parts
                                   (cdr (omap::assoc v
                                                     (ll-context->lmap ctx))))))
                   (locals (ll-context->locals ctx)))
        (:instance not-intersectp-when-subsetp-of-other
                   (hns (mv-nth 2 (replacement-parts
                                   (cdr (omap::assoc
                                             v (ll-context->lmap ctx)))))))
        (:instance subset-of-difference-mergesort-when-disjoint
                   (x (set::intersect
                       (expr-free-expr-vars
                        (cdr (omap::assoc v (ll-context->lmap ctx))))
                       (ll-context->locals ctx)))
                   (hns (mv-nth 2 (replacement-parts
                                   (cdr (omap::assoc v
                                                     (ll-context->lmap ctx))))))
                   (n nfv)))
  :enable (ll-var-referred-ok-p)
  :disable (ll-replacement-ok-p apply-to-names eval-expr
            expr-value-ll-related-p))

(defmacro %wexfv () '(set::difference fv0 (set::mergesort excl)))

(defmacro %wexnfv () '(set::difference nfv (set::mergesort excl)))

(defruled walker-of-nfv-minus-excl-at
  (implies (and (string-expr-value-map-ll-related-p nd map (%wexfv) (%wexnfv)
                                                    ctx dw genv)
                (string-expr-value-mapp map)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx) pnames genv)
                (string-listp pnames)
                (string-listp excl)
                (subsetp-equal excl pnames)
                (omap::assoc var map)
                (set::in var (%wexfv)))
           (ll-var-ok-p var (cdr (omap::assoc var map)) nd nfv ctx dw genv))
  :use ((:instance walker-ll-var-ok-p-at
                   (new-denv nd) (fv (%wexfv)) (nfv (%wexnfv)))
        (:instance ll-var-ok-p-split (new-denv nd) (nfv (%wexnfv))
                   (val (cdr (omap::assoc var map))))
        (:instance ll-var-ok-p-split (new-denv nd)
                   (val (cdr (omap::assoc var map))))
        (:instance ll-var-referred-ok-p-of-nfv-minus-excl
                   (v var) (val (cdr (omap::assoc var map))))
        (:instance ll-replacement-ok-p-when-lmap-replacements-ok-p
                   (lmap (ll-context->lmap ctx))
                   (locals (ll-context->locals ctx)) (k var))
        (:instance stringp-when-assoc-of-string-expr-value-mapp
                   (m map) (k var)))
  :disable (ll-var-ok-p ll-var-referred-ok-p ll-var-types-ok-p
            ll-replacement-ok-p lmap-replacements-ok-p
            ll-var-ok-p-split))

(defruled walker-of-nfv-minus-excl
  (implies (and (string-expr-value-map-ll-related-p nd map (%wexfv) (%wexnfv)
                                                    ctx dw genv)
                (string-expr-value-mapp map)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx) pnames genv)
                (string-listp pnames)
                (string-listp excl)
                (subsetp-equal excl pnames))
           (string-expr-value-map-ll-related-p nd map (%wexfv) nfv ctx dw
                                               genv))
  :use ((:instance string-expr-value-map-ll-related-p-when-pointwise
                   (new-denv nd) (fv (%wexfv)))
        (:instance walker-of-nfv-minus-excl-at
                   (var (walker-pointwise-p-witness nd map (%wexfv) nfv
                                                    ctx dw genv))))
  :expand ((walker-pointwise-p nd map (%wexfv) nfv ctx dw genv))
  :disable (ll-var-ok-p walker-pointwise-p-necc lmap-replacements-ok-p))

(defruled subset-of-differences-when-subset-local
  (implies (set::subset e l)
           (set::subset (set::difference n l) (set::difference n e)))
  :enable (set::pick-a-point-subset-strategy set::subset-in))

(defruled subset-of-intersect-difference-local
  (set::subset (set::difference (set::intersect n l) e)
               (set::difference n e)))

(defmacro %rxn () '(expr-free-expr-vars (ll-context-new-expr x ctx)))

(defmacro %rxe () '(set::mergesort excl))

(defruled expr-denv-ll-related-p-of-restrict-excl
  (implies (and (expr-denv-ll-related-p new-denv denv x ctx excl dw genv)
                (string-listp excl)
                (subsetp-equal excl pnames)
                (set::subset (%rxe) (ll-context->locals ctx))
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        pnames genv)
                (string-listp pnames)
                (set::subset (set::difference (%rxn) (%rxe)) nevars)
                (string-setp nevars)
                (equal (expr-denv->tenv (%rnew)) (expr-denv->tenv (%rold))))
           (expr-denv-ll-related-p (%rnew) (%rold) x ctx excl dw genv))
  :use ((:instance string-expr-value-map-ll-related-p-when-subsets
                   (map (expr-denv->exprs denv))
                   (fv (set::difference (expr-free-expr-vars x) (%rxe)))
                   (nfv (%rxn))
                   (fv2 (set::difference (expr-free-expr-vars x) (%rxe)))
                   (nfv2 (set::difference (%rxn) (%rxe))))
        (:instance walker-of-restrict
                   (fv (set::difference (expr-free-expr-vars x) (%rxe)))
                   (nfv (set::difference (%rxn) (%rxe)))
                   (fv2 (set::difference (expr-free-expr-vars x) (%rxe)))
                   (nfv2 (set::difference (%rxn) (%rxe))))
        (:instance walker-of-nfv-minus-excl
                   (nd (%rnew)) (map (expr-denv->exprs (%rold)))
                   (fv0 (expr-free-expr-vars x)) (nfv (%rxn)))
        (:instance subset-of-differences-when-subset-local
                   (n (%rxn)) (l (ll-context->locals ctx)) (e (%rxe)))
        (:instance subset-of-intersect-difference-local
                   (n (%rxn)) (l (ll-context->locals ctx)) (e (%rxe)))
        (:instance set::subset-transitive
                   (x (set::difference (%rxn) (ll-context->locals ctx)))
                   (y (set::difference (%rxn) (%rxe))) (z nevars))
        (:instance set::subset-transitive
                   (x (set::difference (set::intersect
                                        (%rxn) (ll-context->locals ctx))
                                       (%rxe)))
                   (y (set::difference (%rxn) (%rxe))) (z nevars))
        (:instance names-bound-as-in-p-of-restrict
                   (s (set::difference (%rxn) (ll-context->locals ctx))))
        (:instance new-values-meet-types-p-of-restrict
                   (s (set::difference (set::intersect
                                        (%rxn) (ll-context->locals ctx))
                                       (%rxe)))
                   (tenv (ll-context->tenv ctx))))
  :expand ((expr-denv-ll-related-p new-denv denv x ctx excl dw genv)
           (expr-denv-ll-related-p (%rnew) (%rold) x ctx excl dw genv))
  :enable (str::string-list-fix-when-string-listp)
  :disable (string-expr-value-map-ll-related-p-when-subsets
            names-bound-as-in-p-when-subset new-values-meet-types-p-when-subset
            set::intersect-under-set-equiv set::difference-under-set-equiv
            set::union-under-set-equiv set::mergesort-under-set-equiv))

; The closure over the remaining parameters: its environment, restricted to
; the variables of the remaining lambda, is related to the original one at
; the inner body, excluding the remaining parameters.

(defruled in-locals-when-names-in-context-p
  (implies (and (names-in-context-p names ctx)
                (string-listp names)
                (member-equal a names))
           (set::in a (ll-context->locals ctx)))
  :induct (len names)
  :enable (names-in-context-p len))

(defruled mergesort-subset-locals-when-names-in-context-p
  (implies (and (names-in-context-p names ctx)
                (string-listp names))
           (set::subset (set::mergesort names) (ll-context->locals ctx)))
  :enable (set::pick-a-point-subset-strategy
           in-locals-when-names-in-context-p))

(defmacro %rcnew ()
  '(lambda-closure prest (ll-context-new-expr inner ctx) ity ne))

(defmacro %rcval () '(lambda-closure pa ba ta e))

(defruled remaining-closure-env-related
  (implies (and (expr-denv-ll-related-p ne e inner ctx
                                        (var+type?-list->var prest) dw2 genv)
                (var+type?-listp prest)
                (consp prest)
                (consp pa)
                (names-in-context-p (var+type?-list->var prest) ctx)
                (lmap-replacements-ok-p (ll-context->lmap ctx)
                                        (ll-context->locals ctx)
                                        (var+type?-list->var prest) genv)
                (not (reserrp (%rcval)))
                (not (reserrp (%rcnew)))
                (equal (expr-free-type-vars
                        (lambda-curried-body prest
                                             (ll-context-new-expr inner ctx)
                                             ity))
                       (expr-free-type-vars (lambda-curried-body pa ba ta)))
                (equal (expr-free-ispace-vars
                        (lambda-curried-body prest
                                             (ll-context-new-expr inner ctx)
                                             ity))
                       (expr-free-ispace-vars (lambda-curried-body pa ba ta))))
           (expr-denv-ll-related-p (expr-value-lambda->denv (%rcnew))
                                   (expr-value-lambda->denv (%rcval))
                                   inner ctx (var+type?-list->var prest) dw2
                                   genv))
  :use ((:instance expr-value-lambda->denv-of-lambda-closure
                   (params pa) (body ba) (type? ta) (denv e))
        (:instance expr-value-lambda->denv-of-lambda-closure
                   (params prest) (body (ll-context-new-expr inner ctx))
                   (type? ity) (denv ne))
        (:instance atom-free-expr-vars-of-make-atom-lambda/lambdan
                   (params prest) (body (ll-context-new-expr inner ctx))
                   (type? ity))
        (:instance mergesort-subset-locals-when-names-in-context-p
                   (names (var+type?-list->var prest)))
        (:instance tenv-equal-when-expr-denv-ll-related-p
                   (new-denv ne) (denv e) (x inner)
                   (excl (var+type?-list->var prest)) (dw dw2))
        (:instance expr-denv-ll-related-p-of-restrict-excl
                   (new-denv ne) (denv e) (x inner)
                   (excl (var+type?-list->var prest)) (dw dw2)
                   (pnames (var+type?-list->var prest))
                   (nivars (expr-free-ispace-vars
                            (lambda-curried-body
                             prest (ll-context-new-expr inner ctx) ity)))
                   (ntvars (expr-free-type-vars
                            (lambda-curried-body
                             prest (ll-context-new-expr inner ctx) ity)))
                   (nevars (atom-free-expr-vars
                            (make-atom-lambda/lambdan
                             prest (ll-context-new-expr inner ctx) ity)))
                   (oivars (expr-free-ispace-vars
                            (lambda-curried-body pa ba ta)))
                   (otvars (expr-free-type-vars (lambda-curried-body pa ba ta)))
                   (oevars (atom-free-expr-vars
                            (make-atom-lambda/lambdan pa ba ta)))))
  :disable (lambda-closure expr-denv-ll-related-p names-in-context-p
            lmap-replacements-ok-p lambda-curried-body
            make-atom-lambda/lambdan ll-context-new-expr))

; A closure over more parameters than its own, without flattening: its body
; is the lambda over the remaining ones, which evaluates to the closure over
; them.

(defruled param-type-consistent-p-when-prest-consistent
  (implies (and (consp prest)
                (prest-tenv-consistent-p prest tenv)
                (not (reserrp (eval-var+type? (car prest) dtenv))))
           (param-type-consistent-p
            (var+typevalue-fix (eval-var+type? (car prest) dtenv)) tenv))
  :expand ((prest-tenv-consistent-p prest tenv))
  :enable (param-type-consistent-p var-required-type eval-var+type?
           var+type?->type-or-err eval-type-when-closed type-closed-p
           type-valuep-when-result-not-error))

(defruled eval-expr-of-lambda-atom
  (implies (and (consp params)
                (integerp l)
                (<= 2 l))
           (equal (eval-expr (expr-atom (make-atom-lambda/lambdan params body
                                                                  type?))
                             d l)
                  (lambda-closure params body type? d)))
  :use ((:instance eval-atom-of-lambda/lambdan (denv d) (limit (1- l))))
  :expand ((eval-expr (expr-atom (make-atom-lambda/lambdan params body type?))
                      d l)))

(defruled eval-expr-of-lambda-atom-when-ok
  (implies (and (consp params)
                (not (reserrp (eval-expr (expr-atom (make-atom-lambda/lambdan
                                                     params body type?))
                                         d l))))
           (and (integerp l)
                (<= 2 l)
                (equal (eval-expr (expr-atom (make-atom-lambda/lambdan
                                              params body type?))
                                  d l)
                       (lambda-closure params body type? d))))
  :use (eval-expr-of-lambda-atom)
  :expand ((eval-expr (expr-atom (make-atom-lambda/lambdan params body type?))
                      d l)
           (:free (a l) (eval-atom a d l))))

(defruled closure-body-parts-nonflat-shape
  (implies (and (consp prest)
                (var+type?-listp prest)
                (not flat)
                (mv-nth 0 (closure-body-parts body type? prest flat)))
           (equal (expr-fix body)
                  (lifted-closure-body
                   prest
                   (mv-nth 1 (closure-body-parts body type? prest flat))
                   (mv-nth 2 (closure-body-parts body type? prest flat)))))
  :enable (closure-body-parts))

(defmacro %rmi () '(mv-nth 1 (%lcbp)))

(defmacro %rmt () '(mv-nth 2 (%lcbp)))

(defmacro %rmni () '(ll-context-new-expr (%rmi) (%lwc)))

(defmacro %rmval () '(lambda-closure pa ba ta (%lcenv)))

(defmacro %rmnew () '(lambda-closure (%lwp) (%rmni) (%rmt) (%nlcenv)))

; The environments extended with the argument, at the inner body, with the
; remaining parameters excluded.

(defruled lambda-more-env-related
  (implies (and (equal (expr-value-kind f) :lambda)
                (consp (%lwp))
                (expr-value-ll-related-p nf f w genv)
                (expr-value-ll-related-p na a w2 genv)
                (expr-value-wfp a)
                (expr-value-wfp na)
                (expr-values-match-type-values-p
                 (list a) (list (var+typevalue->type
                                 (expr-value-lambda->param f)))))
           (expr-denv-ll-related-p (%nlcenv) (%lcenv) (%rmi) (%lwc)
                                   (var+type?-list->var (%lwp)) (%lcdw) genv))
  :use (lambda-related-unpack
        (:instance dims-of-expr-value-when-ll-related
                   (new-val na) (val a) (w w2))
        (:instance expr-values-match-type-values-p-of-list-when-same-dims
                   (nv na) (v a)
                   (tvs (list (var+typevalue->type
                               (expr-value-lambda->param f)))))
        (:instance value-meets-required-type-p-of-param
                   (p (expr-value-lambda->param f))
                   (tenv (ll-context->tenv (%lwc))))
        (:instance value-meets-required-type-p-of-param
                   (a na) (p (expr-value-lambda->param f))
                   (tenv (ll-context->tenv (%lwc))))
        (:instance expr-value-ll-related-p-of-fixes (nv na) (v a) (w w2))
        (:instance expr-denv-ll-related-p-of-add-excluded-more
                   (nd (expr-value-lambda->denv nf))
                   (d (expr-value-lambda->denv f))
                   (y (%rmi)) (ctx (%lwc)) (v0 (%lfv)) (dw (%lwd))
                   (excl (var+type?-list->var (%lwp)))
                   (pnames (%lpn))
                   (val (expr-value-fix a)) (nv (expr-value-fix na))
                   (w (ll-value-witness-fix w2))))
  :expand ((names-in-context-p (%lpn) (%lwc)))
  :enable (value-meets-required-type-p-of-expr-value-fix
           ll-denv-witness-add-of-ll-value-witness-fix)
  :disable (ll-context-ok-p expr-denv-ll-related-p closure-body-parts
            names-in-context-p lmap-replacements-ok-p param-type-consistent-p
            prest-tenv-consistent-p lifted-closure-body expr-value-ll-related-p
            value-meets-required-type-p))

; The closures over the remaining parameters have related environments.

(defruled lambda-more-closure-env-related
  (implies (and (equal (expr-value-kind f) :lambda)
                (consp (%lwp))
                (expr-value-ll-related-p nf f w genv)
                (expr-value-ll-related-p na a w2 genv)
                (expr-value-wfp a)
                (expr-value-wfp na)
                (expr-values-match-type-values-p
                 (list a) (list (var+typevalue->type
                                 (expr-value-lambda->param f))))
                (consp pa)
                (not (reserrp (%rmval)))
                (not (reserrp (%rmnew)))
                (equal (expr-free-type-vars
                        (lambda-curried-body (%lwp) (%rmni) (%rmt)))
                       (expr-free-type-vars (lambda-curried-body pa ba ta)))
                (equal (expr-free-ispace-vars
                        (lambda-curried-body (%lwp) (%rmni) (%rmt)))
                       (expr-free-ispace-vars (lambda-curried-body pa ba ta))))
           (expr-denv-ll-related-p (expr-value-lambda->denv (%rmnew))
                                   (expr-value-lambda->denv (%rmval))
                                   (%rmi) (%lwc)
                                   (var+type?-list->var (%lwp)) (%lcdw) genv))
  :use (lambda-related-unpack
        lambda-more-env-related
        (:instance lmap-replacements-ok-p-when-fewer-pnames
                   (lmap (ll-context->lmap (%lwc)))
                   (locals (ll-context->locals (%lwc)))
                   (pnames (%lpn))
                   (pnames2 (var+type?-list->var (%lwp))))
        (:instance remaining-closure-env-related
                   (ne (%nlcenv)) (e (%lcenv)) (inner (%rmi)) (ctx (%lwc))
                   (prest (%lwp)) (ity (%rmt)) (dw2 (%lcdw))))
  :expand ((names-in-context-p (%lpn) (%lwc)))
  :disable (ll-context-ok-p expr-denv-ll-related-p closure-body-parts
            names-in-context-p lmap-replacements-ok-p param-type-consistent-p
            prest-tenv-consistent-p lifted-closure-body expr-value-ll-related-p
            value-meets-required-type-p lambda-closure lambda-curried-body
            ll-context-new-expr))

; The new body's free type and ispace variables are those of the original
; one, since the replacements of the hoisted functions are closed.

(defruled free-type/ispace-vars-of-new-expr-when-ok
  (implies (ll-context-ok-p x ctx genv)
           (and (equal (expr-free-type-vars (ll-context-new-expr x ctx))
                       (expr-free-type-vars x))
                (equal (expr-free-ispace-vars (ll-context-new-expr x ctx))
                       (expr-free-ispace-vars x))))
  :use (ll-context-ok-p-facts
        (:instance lmap-closed-p-when-string-expr-map-closed-p
                   (m (ll-context->lmap ctx)))
        (:instance free-type/ispace-vars-of-ll-expr
                   (tenv (ll-context->tenv ctx))
                   (tlets (ll-context->tlets ctx))
                   (locals (ll-context->locals ctx))
                   (lmap (ll-context->lmap ctx))
                   (used (ll-context->used ctx))))
  :enable (ll-context-new-expr)
