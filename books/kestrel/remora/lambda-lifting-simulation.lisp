        (:instance ll-context-ok-p-of-binder-suffix
                   (x (expr-array nil (list a)))
                   (y (ilambda-curried-body (atom-ilambdan->params a)
                                            (atom-ilambdan->body a)))
                   (pre (list (ispace-var->name
