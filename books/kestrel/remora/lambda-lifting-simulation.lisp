        (:instance ll-lambda-parts-used (params pa) (body '(:var ""))
                   (type? nil))
        (:instance ll-lambda-parts-locals-subset-used
                   (params pa) (body '(:var "")) (type? nil))
        (:instance lmap-closed-p-of-ll-lambda-parts
