(defruled atomlam-shape-of-singleton-array
  (implies (and (var+type?-listp pa)
                (consp pa)
                (exprp ba)
                (type-optionp ta))
           (b* ((x (expr-array nil (list (make-atom-lambda/lambdan pa ba ta)))))
             (%atomlam-shape-hyps)))
  :use ((:instance ll-expr-of-singleton-array
                   (a (make-atom-lambda/lambdan pa ba ta)))
        ll-atom-of-make-atom-lambda/lambdan
        (:instance free-and-binders-of-singleton-array
                   (d nil) (a (make-atom-lambda/lambdan pa ba ta)))
        (:instance free-and-binders-of-singleton-array
                   (d nil) (a (make-atom-lambda/lambdan pa (%anb) ta)))
        (:instance atom-binder-names-of-make-atom-lambda/lambdan
