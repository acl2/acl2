                   (limit 1))
        (:instance eval-unbox-of-vector-empty-indep
                   (tg target) (is ispaces) (v2 var)
                   (b2 (ll-context-new-expr body ctx)) (ty type) (d2 new-denv)
                   (l2 1) (v var) (b body) (d denv) (l limit))
        (:instance eval-unbox-of-vector-empty-related
                   (tg target) (is ispaces) (v var) (b body) (ty type)
                   (d denv) (l limit))
        (:instance eval-unbox-of-expr-value-fix-target
                   (body (ll-context-new-expr body ctx)) (denv new-denv)
                   (limit 1))
        (:instance eval-unbox-ll-reaches-p-suff
                   (new-body (ll-context-new-expr body ctx)) (limit2 1)
