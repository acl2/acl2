                   (new-funvals (%nivels)) (ws (%ivws)))
        (:instance eval-iapp-list-ll-reaches-p-elim
                   (new-funvals (%nivels))
                   (vals (eval-iapp-list (%ivels) ival (1- limit))))
        (:instance posp-limit-when-eval-iapp-list-ok
                   (funvals (%nivels)) (limit (mv-nth 0 (%ivlw))))
        (:instance eval-iapp-ll-reaches-p-of-vector-generic
                   (nf new-funval) (iv ival) (l (mv-nth 0 (%ivlw)))
                   (vs (eval-iapp-list (%ivels) ival (1- limit)))
                   (ws (mv-nth 1 (%ivlw)))
                   (val (eval-iapp funval ival limit))))
  :in-theory (e/d (natp posp expr-value-list-wfp-of-eval-iapp-list
                   expr-value-list-wfp-of-expr-value-vector->elems)
                  (eval-iapp eval-iapp-list expr-value-ll-related-p
                   expr-value-list-ll-related-p eval-iapp-list-ll-ok
                   eval-iapp-list-ll-ok-necc eval-iapp-ll-reaches-p
                   eval-iapp-ll-reaches-p-suff eval-iapp-list-ll-reaches-p
                   equal-of-expr-value-vector)))

; The statement for EVAL-IAPP.

(defmacro %iaw () '(eval-iapp-ll-ok-witness funval ival limit))

(defruled eval-iapp-not-error-kinds
  (implies (not (reserrp (eval-iapp funval ival limit)))
           (member-equal (expr-value-kind funval)
                         '(:ilambda :primop :vector :vector-empty)))
  :expand ((eval-iapp funval ival limit)))

(defruled eval-iapp-ll-ok-when-ok
  (implies (and (implies (equal (expr-value-kind funval) :ilambda)
                         (eval-expr-ll-ok (%ilbody) (%ilenv) (1- limit)))
                (implies (equal (expr-value-kind funval) :vector)
