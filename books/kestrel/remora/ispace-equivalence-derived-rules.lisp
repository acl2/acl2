  (defruled dim-eq-mul-zero-left
    (implies (dimp dim)
             (dim-eq (dim* 0 dim) (dim-const 0)))
    :use (:instance dim-eq-when-proof-validp
                    (proof (dim-eq-proof-mul-zero-left dim))
                    (concl.dim1 (dim* 0 dim))
                    (concl.dim2 (dim-const 0)))
