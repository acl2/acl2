      (make-dim-eq-proof-trans
       :dim1 (dim* 0 dim)
       :dim2 (dim* dim 0)
       :dim3 (dim-const 0)
       :premise1-proof (make-dim-eq-proof-mul-comm :dim1 (dim-const 0)
                                                   :dim2 dim)
