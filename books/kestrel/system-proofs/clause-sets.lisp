;;; What the functions return, and well-formedness

(local (include-book "kestrel/terms-light/termp" :dir :system))
(local (include-book "helpers")) ; for term-listp-of-append

;; ADD-LITERAL returns the clause, the true clause, or the clause with the
;; literal added at the front or (if AT-END-FLG) the end.
(defthm add-literal-cases
  (let ((result (add-literal lit cl at-end-flg)))
    (or (equal result cl)
        (equal result *true-clause*)
        (equal result (if at-end-flg (append cl (list lit)) (cons lit cl)))))
  :hints (("Goal" :in-theory (enable add-literal)))
  :rule-classes nil)

;; CONJOIN-CLAUSE-TO-CLAUSE-SET returns the set of clauses or the set with the
;; clause added at the front.
(defthm conjoin-clause-to-clause-set-cases
  (let ((result (conjoin-clause-to-clause-set cl cl-set)))
    (or (equal result cl-set)
        (equal result (cons cl cl-set))))
  :hints (("Goal" :in-theory (enable conjoin-clause-to-clause-set)))
  :rule-classes nil)

(defthm pseudo-term-listp-of-add-literal
  (implies (and (pseudo-termp lit)
                (pseudo-term-listp cl))
           (pseudo-term-listp (add-literal lit cl at-end-flg)))
  :hints (("Goal" :in-theory (enable add-literal))))

(defthm term-listp-of-add-literal
  (implies (and (termp lit w)
                (term-listp cl w))
           (term-listp (add-literal lit cl at-end-flg) w))
  :hints (("Goal" :in-theory (enable add-literal))))

(defthm pseudo-term-listp-of-add-each-literal
  (implies (pseudo-term-listp cl)
           (pseudo-term-listp (add-each-literal cl)))
  :hints (("Goal" :in-theory (enable add-each-literal))))

(defthm term-listp-of-add-each-literal
  (implies (term-listp cl w)
           (term-listp (add-each-literal cl) w))
  :hints (("Goal" :in-theory (enable add-each-literal))))

(local
 (defthm pseudo-term-listp-of-disjoin-clauses1
   (implies (and (pseudo-term-listp cl1)
                 (pseudo-term-listp cl2))
            (pseudo-term-listp (disjoin-clauses1 cl1 cl2)))
   :hints (("Goal" :in-theory (enable disjoin-clauses1)))))

(local
 (defthm term-listp-of-disjoin-clauses1
   (implies (and (term-listp cl1 w)
                 (term-listp cl2 w))
            (term-listp (disjoin-clauses1 cl1 cl2) w))
   :hints (("Goal" :in-theory (enable disjoin-clauses1)))))

(defthm pseudo-term-listp-of-disjoin-clauses
  (implies (and (pseudo-term-listp cl1)
                (pseudo-term-listp cl2))
           (pseudo-term-listp (disjoin-clauses cl1 cl2)))
  :hints (("Goal" :in-theory (enable disjoin-clauses))))

(defthm term-listp-of-disjoin-clauses
  (implies (and (term-listp cl1 w)
                (term-listp cl2 w))
           (term-listp (disjoin-clauses cl1 cl2) w))
  :hints (("Goal" :in-theory (enable disjoin-clauses))))

(defthm pseudo-term-list-listp-of-conjoin-clause-to-clause-set
  (implies (and (pseudo-term-listp cl)
                (pseudo-term-list-listp cl-set))
           (pseudo-term-list-listp (conjoin-clause-to-clause-set cl cl-set)))
  :hints (("Goal" :in-theory (enable conjoin-clause-to-clause-set))))

(defthm term-list-listp-of-conjoin-clause-to-clause-set
  (implies (and (term-listp cl w)
                (term-list-listp cl-set w))
           (term-list-listp (conjoin-clause-to-clause-set cl cl-set) w))
  :hints (("Goal" :in-theory (enable conjoin-clause-to-clause-set))))

(defthm pseudo-term-list-listp-of-conjoin-clause-sets
  (implies (and (pseudo-term-list-listp cl-set1)
                (pseudo-term-list-listp cl-set2))
           (pseudo-term-list-listp (conjoin-clause-sets cl-set1 cl-set2)))
  :hints (("Goal" :in-theory (enable conjoin-clause-sets conjoin-clause-sets-rec
                                     conjoin-clause-sets-trivial
                                     conjoin-clause-to-clause-set-trivial))))

(defthm term-list-listp-of-conjoin-clause-sets
  (implies (and (term-list-listp cl-set1 w)
                (term-list-listp cl-set2 w))
           (term-list-listp (conjoin-clause-sets cl-set1 cl-set2) w))
  :hints (("Goal" :in-theory (enable conjoin-clause-sets conjoin-clause-sets-rec
                                     conjoin-clause-sets-trivial
                                     conjoin-clause-to-clause-set-trivial))))

(defthm pseudo-term-list-listp-of-disjoin-clause-segment-to-clause-set
  (implies (and (pseudo-term-listp segment)
                (pseudo-term-list-listp cl-set))
           (pseudo-term-list-listp (disjoin-clause-segment-to-clause-set segment cl-set)))
  :hints (("Goal" :in-theory (e/d (disjoin-clause-segment-to-clause-set) (disjoin-clauses)))))

(defthm term-list-listp-of-disjoin-clause-segment-to-clause-set
  (implies (and (term-listp segment w)
                (term-list-listp cl-set w))
           (term-list-listp (disjoin-clause-segment-to-clause-set segment cl-set) w))
  :hints (("Goal" :in-theory (e/d (disjoin-clause-segment-to-clause-set) (disjoin-clauses)))))

(defthm pseudo-term-list-listp-of-split-on-assumptions
  (implies (and (pseudo-term-listp assumptions)
                (pseudo-term-listp cl)
                (pseudo-term-list-listp ans))
           (pseudo-term-list-listp (split-on-assumptions assumptions cl ans)))
  :hints (("Goal" :in-theory (enable split-on-assumptions))))

(defthm term-list-listp-of-split-on-assumptions
  (implies (and (term-listp assumptions w)
                (term-listp cl w)
                (term-list-listp ans w))
           (term-list-listp (split-on-assumptions assumptions cl ans) w))
  :hints (("Goal" :in-theory (enable split-on-assumptions))))
