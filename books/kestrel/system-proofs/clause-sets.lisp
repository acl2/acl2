(in-package "ACL2")

;; A clause is a list of literals, representing their disjunction, and a set of
;; clauses represents the conjunction of its clauses.  The simplifier builds
;; clauses with ADD-LITERAL (in simplify.lisp), which adds a literal to a
;; clause, dropping the literal if it is false or already present (modulo
;; commuting EQUAL and IFF) and returning the true clause if the literal is
;; true or its complement is present.  It combines sets of clauses with
;; CONJOIN-CLAUSE-TO-CLAUSE-SET, which drops a clause that is true or already
;; present (modulo commuting EQUAL and IFF), and with the functions built on
;; these.  This book proves that these functions do what they should, in terms
;; of an evaluator that knows the functions they treat specially.

(include-book "kestrel/evaluators/defevaluator-plus" :dir :system)
(local (include-book "kestrel/lists-light/append" :dir :system))
(local (include-book "kestrel/lists-light/member-equal" :dir :system))
(local (include-book "kestrel/typed-lists-light/pseudo-term-listp" :dir :system))
(local (include-book "system/pseudo-termp-lemmas" :dir :system))
(local (include-book "tools/flag" :dir :system))

;; These functions are in :program mode in the sources.  We put them in
;; :logic mode here.  Several of them test for the end of a list with NULL, so
;; they can recur once on a non-NIL atom; for those we use measures that make
;; NIL smaller than any other atom.
(verify-termination comm-equal)
(verify-termination
  (member-term2 (declare (xargs :measure (if (null cl) 0 (+ 1 (acl2-count cl)))))))
(verify-termination
  (member-complement-term2 (declare (xargs :measure (if (null cl) 0 (+ 1 (acl2-count cl)))))))
(verify-termination
  (member-complement-term1 (declare (xargs :measure (if (null cl) 0 (+ 1 (acl2-count cl)))))))
(verify-termination (member-term) (member-complement-term))
(verify-termination add-literal)
(verify-termination
  (add-each-literal (declare (xargs :measure (if (null cl) 0 (+ 1 (acl2-count cl)))))))

;; An evaluator that knows the functions that add-literal and the functions
;; below treat specially:
(defevaluator+ clause-set-eval
  if not equal iff hard-error integerp rationalp)

(local (in-theory (disable clause-set-eval-of-disjoin)))

;; A set of clauses is true if all of its clauses are.
(defund clause-set-true (cl-set a)
  (if (endp cl-set)
      t
    (and (clause-set-eval (disjoin (car cl-set)) a)
         (clause-set-true (cdr cl-set) a))))

(defthm clause-set-true-when-not-consp
  (implies (not (consp cl-set))
           (clause-set-true cl-set a))
  :hints (("Goal" :in-theory (enable clause-set-true))))

(defthm clause-set-true-of-cons
  (equal (clause-set-true (cons cl cl-set) a)
         (and (clause-set-eval (disjoin cl) a)
              (clause-set-true cl-set a)))
  :hints (("Goal" :in-theory (enable clause-set-true))))

(defthm clause-set-true-of-append
  (equal (clause-set-true (append cl-set1 cl-set2) a)
         (and (clause-set-true cl-set1 a)
              (clause-set-true cl-set2 a)))
  :hints (("Goal" :in-theory (enable clause-set-true append))))

;; This is the meaning ACL2 gives to a set of clauses.
(defthm clause-set-eval-of-conjoin-clauses
  (iff (clause-set-eval (conjoin-clauses cl-set) a)
       (clause-set-true cl-set a))
  :hints (("Goal" :in-theory (enable clause-set-true conjoin-clauses disjoin-lst))))

;; We reason about clauses using the "all false" function generated by
;; defevaluator+, in terms of which clause-set-eval-of-disjoin states the
;; meaning of a clause.

(local (in-theory (enable clause-set-eval-of-disjoin)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;; MEMBER-TERM and MEMBER-COMPLEMENT-TERM

;; If cl is false, then any member of cl, modulo commuting EQUAL or IFF, is
;; false.

(local
 (defthm member-term2-lemma
   (implies (and (member-term2 fn lhs rhs cl)
                 (all-eval-to-false-with-clause-set-eval cl a))
            (and (implies (equal fn 'equal)
                          (not (equal (clause-set-eval lhs a)
                                      (clause-set-eval rhs a))))
                 (implies (equal fn 'iff)
                          (not (iff (clause-set-eval lhs a)
                                    (clause-set-eval rhs a))))))
   :hints (("Goal" :in-theory (enable member-term2 comm-equal)))))

(local
 (defthm member-complement-term2-lemma
   (implies (and (member-complement-term2 fn lhs rhs cl)
                 (all-eval-to-false-with-clause-set-eval cl a))
            (and (implies (equal fn 'equal)
                          (equal (clause-set-eval lhs a)
                                 (clause-set-eval rhs a)))
                 (implies (equal fn 'iff)
                          (iff (clause-set-eval lhs a)
                               (clause-set-eval rhs a)))))
   :hints (("Goal" :in-theory (enable member-complement-term2 comm-equal)))))

(local
 (defthm clause-set-eval-when-member-complement-term1
   (implies (and (member-complement-term1 lit cl)
                 (all-eval-to-false-with-clause-set-eval cl a))
            (clause-set-eval lit a))
   :hints (("Goal" :in-theory (enable member-complement-term1)))))

(local (make-flag member-term))

;; If lit is a member of cl (modulo commuting EQUAL or IFF), then lit is false
;; if cl is.  If the complement of lit is a member of cl, then lit is true if
;; cl is false.
(defthm-flag-member-term
  (defthm not-clause-set-eval-when-member-term
    (implies (and (member-term lit cl)
                  (all-eval-to-false-with-clause-set-eval cl a))
             (not (clause-set-eval lit a)))
    :flag member-term)
  (defthm clause-set-eval-when-member-complement-term
    (implies (and (member-complement-term lit cl)
                  (all-eval-to-false-with-clause-set-eval cl a))
             (clause-set-eval lit a))
    :flag member-complement-term)
  :hints (("Goal" :in-theory (enable member-term member-complement-term))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;; ADD-LITERAL

;; Adding a literal to a clause makes the disjunction of the literal and the
;; clause.  (The literal must be a pseudo-term, because a malformed quoted
;; constant such as (QUOTE NIL NIL), whose value is NIL, would be treated as a
;; true literal.)
(defthm add-literal-correct
  (implies (pseudo-termp lit)
           (iff (clause-set-eval (disjoin (add-literal lit cl at-end-flg)) a)
                (or (clause-set-eval lit a)
                    (clause-set-eval (disjoin cl) a))))
  :hints (("Goal" :in-theory (e/d (add-literal)
                                  (member-term member-complement-term
                                   member-complement-term1 member-complement-term2
                                   member-term2))
           :use ((:instance clause-set-eval-when-member-complement-term1
                            (lit (cons 'integerp (cdr lit))))
                 (:instance not-clause-set-eval-when-all-eval-to-false-with-clause-set-eval-and-member-equal
                            (term (cons 'rationalp (cdr (cadr lit))))
                            (terms cl))))))

(local
 (defthm all-eval-to-false-with-clause-set-eval-of-add-literal
   (implies (pseudo-termp lit)
            (equal (all-eval-to-false-with-clause-set-eval (add-literal lit cl at-end-flg) a)
                   (and (not (clause-set-eval lit a))
                        (all-eval-to-false-with-clause-set-eval cl a))))
   :hints (("Goal" :use add-literal-correct
            :in-theory (disable add-literal-correct add-literal)))))

(local (in-theory (disable add-literal)))

;; See add-literal-needs-pseudo-termp in clause-sets-tests.lisp for an
;; example showing that the literal must be a pseudo-term.

(defthm add-each-literal-correct
  (implies (pseudo-term-listp cl)
           (iff (clause-set-eval (disjoin (add-each-literal cl)) a)
                (clause-set-eval (disjoin cl) a)))
  :hints (("Goal" :in-theory (enable add-each-literal)
           :induct (add-each-literal cl))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;; DISJOIN-CLAUSES

(verify-termination disjoin-clauses1)
(verify-termination disjoin-clauses)

;; Disjoining two clauses makes their disjunction.
(defthm disjoin-clauses1-correct
  (implies (pseudo-term-listp cl2)
           (iff (clause-set-eval (disjoin (disjoin-clauses1 cl1 cl2)) a)
                (or (clause-set-eval (disjoin cl1) a)
                    (clause-set-eval (disjoin cl2) a))))
  :hints (("Goal" :in-theory (enable disjoin-clauses1))))

(defthm disjoin-clauses-correct
  (implies (pseudo-term-listp cl2)
           (iff (clause-set-eval (disjoin (disjoin-clauses cl1 cl2)) a)
                (or (clause-set-eval (disjoin cl1) a)
                    (clause-set-eval (disjoin cl2) a))))
  :hints (("Goal" :in-theory (e/d (disjoin-clauses) (disjoin-clauses1-correct))
           :use disjoin-clauses1-correct)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;; CONJOIN-CLAUSE-TO-CLAUSE-SET

(verify-termination equal-mod-commuting-lst)
(verify-termination member-equal-mod-commuting-lst)
(verify-termination conjoin-clause-to-clause-set)

;; Terms that are equal modulo commuting EQUAL and IFF have the same value.
;; (With a non-NIL world, equal-mod-commuting also commutes the arguments of
;; other equivalence relations, but conjoin-clause-to-clause-set passes NIL.)
(defthm equal-mod-commuting-correct
  (implies (equal-mod-commuting x y nil)
           (equal (clause-set-eval x a)
                  (clause-set-eval y a)))
  :hints (("Goal" :in-theory (enable equal-mod-commuting)
           :cases ((equal (car x) 'equal)))))

(defthm equal-mod-commuting-lst-correct
  (implies (equal-mod-commuting-lst cl1 cl2)
           (equal (all-eval-to-false-with-clause-set-eval cl1 a)
                  (all-eval-to-false-with-clause-set-eval cl2 a)))
  :hints (("Goal" :in-theory (e/d (equal-mod-commuting-lst) (equal-mod-commuting)))))

(defthm member-equal-mod-commuting-lst-correct
  (implies (and (member-equal-mod-commuting-lst cl cl-set)
                (clause-set-true cl-set a))
           (clause-set-eval (disjoin cl) a))
  :hints (("Goal" :in-theory (e/d (member-equal-mod-commuting-lst) (equal-mod-commuting-lst)))))

(local
 (defthm not-all-eval-to-false-with-clause-set-eval-when-member-equal-mod-commuting-lst
   (implies (and (member-equal-mod-commuting-lst cl cl-set)
                 (clause-set-true cl-set a))
            (not (all-eval-to-false-with-clause-set-eval cl a)))
   :hints (("Goal" :use member-equal-mod-commuting-lst-correct
            :in-theory (disable member-equal-mod-commuting-lst-correct
                                member-equal-mod-commuting-lst)))))

(local
 (defthm not-all-eval-to-false-with-clause-set-eval-when-member-equal-of-quote-t
   (implies (member-equal *t* cl)
            (not (all-eval-to-false-with-clause-set-eval cl a)))
   :hints (("Goal" :in-theory (enable all-eval-to-false-with-clause-set-eval)))))

;; Conjoining a clause to a set of clauses makes their conjunction.
(defthm conjoin-clause-to-clause-set-correct
  (iff (clause-set-true (conjoin-clause-to-clause-set cl cl-set) a)
       (and (clause-set-eval (disjoin cl) a)
            (clause-set-true cl-set a)))
  :hints (("Goal" :in-theory (e/d (conjoin-clause-to-clause-set)
                                  (member-equal-mod-commuting-lst)))))

(local (in-theory (disable conjoin-clause-to-clause-set)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;; Functions built on these

(verify-termination
  (add-each-literal-lst (declare (xargs :measure (if (null cl-set) 0 (+ 1 (acl2-count cl-set)))))))
(verify-termination
  (conjoin-clause-sets-rec (declare (xargs :measure (if (null cl-set1) 0 (+ 1 (acl2-count cl-set1)))))))
(verify-termination conjoin-clause-to-clause-set-trivial)
(verify-termination
  (conjoin-clause-sets-trivial (declare (xargs :measure (if (null cl-set1) 0 (+ 1 (acl2-count cl-set1)))))))
(verify-termination conjoin-clause-sets)
(verify-termination
  (disjoin-clause-segment-to-clause-set (declare (xargs :measure (if (null cl-set) 0 (+ 1 (acl2-count cl-set)))))))
(verify-termination
  (split-on-assumptions (declare (xargs :measure (if (null assumptions) 0 (+ 1 (acl2-count assumptions)))))))

(defthm add-each-literal-lst-correct
  (implies (pseudo-term-list-listp cl-set)
           (iff (clause-set-true (add-each-literal-lst cl-set) a)
                (clause-set-true cl-set a)))
  :hints (("Goal" :in-theory (enable add-each-literal-lst))))

(defthm conjoin-clause-sets-rec-correct
  (implies (true-listp cl-set1)
           (iff (clause-set-true (conjoin-clause-sets-rec cl-set1 cl-set2) a)
                (and (clause-set-true cl-set1 a)
                     (clause-set-true cl-set2 a))))
  :hints (("Goal" :in-theory (enable conjoin-clause-sets-rec))))

(defthm conjoin-clause-sets-trivial-correct
  (implies (true-listp cl-set1)
           (iff (clause-set-true (conjoin-clause-sets-trivial cl-set1 cl-set2) a)
                (and (clause-set-true cl-set1 a)
                     (clause-set-true cl-set2 a))))
  :hints (("Goal" :in-theory (enable conjoin-clause-sets-trivial
                                     conjoin-clause-to-clause-set-trivial))))

;; Conjoining two sets of clauses makes their conjunction (whatever the
;; attachment to conjoin-clause-sets-bound).  These functions test for the end
;; of CL-SET1 with NULL, so CL-SET1 must be a true list: otherwise, they treat
;; its non-NIL final CDR as a final, empty (false) clause.
(defthm conjoin-clause-sets-correct
  (implies (true-listp cl-set1)
           (iff (clause-set-true (conjoin-clause-sets cl-set1 cl-set2) a)
                (and (clause-set-true cl-set1 a)
                     (clause-set-true cl-set2 a))))
  :hints (("Goal" :in-theory (enable conjoin-clause-sets))))

;; Disjoining a clause segment to each clause of a set of clauses makes the
;; disjunction of the segment and the set.
(defthm disjoin-clause-segment-to-clause-set-correct
  (implies (pseudo-term-list-listp cl-set)
           (iff (clause-set-true (disjoin-clause-segment-to-clause-set segment cl-set) a)
                (or (clause-set-eval (disjoin segment) a)
                    (clause-set-true cl-set a))))
  :hints (("Goal" :in-theory (e/d (disjoin-clause-segment-to-clause-set)
                                  (disjoin-clauses)))))

;; Adding each of the assumptions to a clause, and conjoining the resulting
;; clauses to ANS, makes the conjunction of ANS and the disjunction of the
;; clause and the conjunction of the assumptions.
(defthm split-on-assumptions-correct
  (implies (pseudo-term-listp assumptions)
           (iff (clause-set-true (split-on-assumptions assumptions cl ans) a)
                (and (or (clause-set-eval (disjoin cl) a)
                         (all-eval-to-true-with-clause-set-eval assumptions a))
                     (clause-set-true ans a))))
  :hints (("Goal" :in-theory (enable split-on-assumptions))))

