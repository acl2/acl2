(defxdoc deftreeset
  :parents (fty-extensions fty acl2::treeset)
  :short "Generate a <see topic='@(url fty::fty)'>fixtype</see>
          of <see topic='@(url acl2::treeset)'>treesets</see>
          whose elements have a specified fixtype."

  :long
  (xdoc::topstring
   (xdoc::h3 "Introduction")
   (xdoc::p
    "This is the @(see acl2::treeset) analogue of @(tsee fty::defset) (which
     generates fixtypes of <see topic='@(url set::std/osets)'>osets</see>).")
   (xdoc::h3 "General Form")
   (xdoc::codeblock
    "(deftreeset type"
    "            :elt-type ..."
    "            :pred     ..."
    "            :fix      ..."
    "            :equiv    ..."
    "            :count    ..."
    "            :measure  ..."
    "            :xvar     ..."
    "            :parents  ..."
    "            :short    ..."
    "            :long     ..."
    "  )")
   (xdoc::h3 "Inputs")
   (xdoc::desc
    "@('type')"
    (xdoc::p
     "The name of the new fixtype."))
   (xdoc::desc
    "@(':elt-type')"
    (xdoc::p
      "The fixtype of the elements of the new set fixtype."))
   (xdoc::desc
    "@(':pred') <br/> @(':fix') <br/> @(':equiv')"
    (xdoc::p
     "The names of the recognizer, fixer, and equivalence for the new fixtype.
      The defaults are @('type') followed by @('-p'), @('-fix'), and
      @('-equiv')."))
   (xdoc::desc
    "@(':count')"
    (xdoc::p
     "The name of the generated count.
      Defaults to @('type-count').
      As with @(tsee defset),
      a standalone @('deftreeset') generates a count
      only when @(':count') is supplied;
      as a @(tsee deftypes) clique member,
      a count is generated by default."))
   (xdoc::desc
    "@(':parents') <br/> @(':short') <br/> @(':long')"
    (xdoc::p
     "XDOC documentation for the generated @('type') topic;
      omitted components are simply left out of the topic."))
   (xdoc::h3 "Generated Events")
   (xdoc::ul
    (xdoc::li
     "The recognizer, the fixer, the equivalence, and the fixtype.")
    (xdoc::li
     "A suite of theorems about the recognizer over the treeset operations
      (@(tsee treeset::in), @(tsee treeset::insert), @(tsee treeset::delete),
      @(tsee treeset::union), @(tsee treeset::intersect), @(tsee
      treeset::diff)).")
    (xdoc::li
     "When a count is generated,
      a structural count function and the linear rules that let it serve
      as a termination measure for recursions over the set."))))

