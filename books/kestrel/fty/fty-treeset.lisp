(define flextreeset-predicate-def (x)
  :mode :program
  (b* (((flextreeset x))
       (tree-all x.tree-all)
       (tree-all-measure (if (and (consp x.measure)
                                  (eq (car x.measure)
                                      'acl2::two-nats-measure))
                             '(acl2::two-nats-measure (acl2-count tree) 0)
                           '(acl2-count tree))))
    `((define ,tree-all ((tree treeset::treep))
        :measure ,tree-all-measure
        :hints (("Goal"
                 :in-theory
                 (enable treeset::acl2-count-when-not-tree-empty-p-cheap
                         treeset::fix-when-setp
                         treeset::tree-element-p-of-tree->head
                         treeset::acl2-count-of-tree-element->val-linear)))
        :guard-hints (("Goal"
                       :in-theory
                       (enable treeset::treep-of-tree->left
                               treeset::treep-of-tree->right
                               treeset::tree-element-p-of-tree->head
                               treeset::treep-when-setp-forward-chaining
                               treeset::fix-when-setp)))
        (or (treeset::tree-empty-p tree)
            (and (,x.elt-type (treeset::tree-element->val (treeset::tree->head tree)))
                 (,tree-all (treeset::tree->left tree))
                 (,tree-all (treeset::tree->right tree)))))
      (define ,x.pred (,x.xvar)
        :measure ,x.measure
        (and (treeset::setp ,x.xvar)
             (let ((tree (treeset::fix ,x.xvar)))
               (or (treeset::tree-empty-p tree)
                   (and (,x.elt-type (treeset::tree-element->val (treeset::tree->head tree)))
                        (,tree-all (treeset::tree->left tree))
                        (,tree-all (treeset::tree->right tree))))))))))

(define flextreeset-post-pred-events (x)
  :mode :program
  (b* (((flextreeset x))
       (tree-all x.tree-all)
       (pred-def (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-DEFINITION")
                  x.pred))
       (setp-when-pred (intern-in-package-of-symbol
                        (concatenate 'string "SETP-WHEN-" (symbol-name x.pred))
                        x.pred))
       (pred-of-empty (intern-in-package-of-symbol
                       (concatenate 'string (symbol-name x.pred) "-OF-EMPTY")
                       x.pred))
       (treep-when-pred (intern-in-package-of-symbol
                         (concatenate 'string "TREEP-WHEN-"
                                      (symbol-name x.pred))
                         x.pred))
       (tree-all-when-empty (intern-in-package-of-symbol
                             (concatenate 'string (symbol-name tree-all)
                                          "-WHEN-TREE-EMPTY-P")
                             x.pred))
       (tree-all-opener (intern-in-package-of-symbol
                         (concatenate 'string (symbol-name tree-all)
                                      "-OPENER-WHEN-NOT-TREE-EMPTY-P")
                         x.pred))
       (tree-all-of-fix-when-pred (intern-in-package-of-symbol
                                   (concatenate 'string (symbol-name tree-all)
                                                "-OF-FIX-WHEN-"
                                                (symbol-name x.pred))
                                   x.pred))
       (tree-all-when-pred (intern-in-package-of-symbol
                            (concatenate 'string (symbol-name tree-all)
                                         "-WHEN-" (symbol-name x.pred))
                            x.pred))
       (elt-of-head-when-tree-all (intern-in-package-of-symbol
                                   (concatenate 'string
                                                (symbol-name x.elt-type)
                                                "-OF-TREE->HEAD-WHEN-"
                                                (symbol-name tree-all))
                                   x.pred))
       (tree-all-of-left-when-tree-all
        (intern-in-package-of-symbol
         (concatenate 'string (symbol-name tree-all) "-OF-TREE->LEFT-WHEN-"
                      (symbol-name tree-all))
         x.pred))
       (tree-all-of-right-when-tree-all
        (intern-in-package-of-symbol
         (concatenate 'string (symbol-name tree-all) "-OF-TREE->RIGHT-WHEN-"
                      (symbol-name tree-all))
         x.pred))
       (pred-of-left-when-pred (intern-in-package-of-symbol
                                (concatenate 'string (symbol-name x.pred)
                                             "-OF-TREE->LEFT-WHEN-"
                                             (symbol-name x.pred))
                                x.pred))
       (pred-of-right-when-pred (intern-in-package-of-symbol
                                 (concatenate 'string (symbol-name x.pred)
                                              "-OF-TREE->RIGHT-WHEN-"
                                              (symbol-name x.pred))
                                 x.pred)))
    ;; The fold is internal, so deftypes' post-defines disable (which covers
    ;; the registered predicates) does not know about it; disable it here.
    `((local (in-theory (disable ,tree-all)))
      (defthmd ,pred-def
        (equal (,x.pred ,x.xvar)
               (and (treeset::setp ,x.xvar)
                    (,tree-all (treeset::fix ,x.xvar))))
        :hints (("Goal" :expand ((,x.pred ,x.xvar)
                                 (,tree-all (treeset::fix ,x.xvar))
                                 (,tree-all ,x.xvar))
                 :in-theory (enable treeset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,setp-when-pred
        (implies (,x.pred ,x.xvar)
                 (treeset::setp ,x.xvar))
        :hints (("Goal" :expand ((,x.pred ,x.xvar))
                 :do-not-induct t)))
      (defthm ,treep-when-pred
        (implies (,x.pred ,x.xvar)
                 (treeset::treep ,x.xvar))
        :hints (("Goal" :expand ((,x.pred ,x.xvar))
                 :in-theory (enable treeset::treep-when-setp-forward-chaining)
                 :do-not-induct t)))
      (defthm ,pred-of-empty
        (,x.pred (treeset::empty))
        ;; Enabling emptyp-of-empty would rewrite the :use fact to T.
        :hints (("Goal" :expand ((,x.pred (treeset::empty))
                                 (,tree-all (treeset::fix (treeset::empty)))
                                 (,tree-all (treeset::empty)))
                 :use (treeset::emptyp-of-empty)
                 :in-theory (enable treeset::fix-when-setp
                                    treeset::setp-of-empty
                                    treeset::emptyp$inline)
                 :do-not-induct t)))
      (defthm ,tree-all-when-empty
        (implies (treeset::tree-empty-p tree)
                 (,tree-all tree))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-opener
        (implies (not (treeset::tree-empty-p tree))
                 (equal (,tree-all tree)
                        (and (,x.elt-type (treeset::tree-element->val (treeset::tree->head tree)))
                             (,tree-all (treeset::tree->left tree))
                             (,tree-all (treeset::tree->right tree)))))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-of-fix-when-pred
        (implies (,x.pred ,x.xvar)
                 (,tree-all (treeset::fix ,x.xvar)))
        :hints (("Goal" :expand ((,x.pred ,x.xvar)
                                 (,tree-all (treeset::fix ,x.xvar))
                                 (,tree-all ,x.xvar))
                 :in-theory (enable treeset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,tree-all-when-pred
        (implies (,x.pred ,x.xvar)
                 (,tree-all ,x.xvar))
        :hints (("Goal" :expand ((,x.pred ,x.xvar)
                                 (,tree-all ,x.xvar))
                 :in-theory (enable treeset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,elt-of-head-when-tree-all
        (implies (and (,tree-all tree)
                      (not (treeset::tree-empty-p tree)))
                 (,x.elt-type (treeset::tree-element->val (treeset::tree->head tree))))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-of-left-when-tree-all
        (implies (and (,tree-all tree)
                      (not (treeset::tree-empty-p tree)))
                 (,tree-all (treeset::tree->left tree)))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-of-right-when-tree-all
        (implies (and (,tree-all tree)
                      (not (treeset::tree-empty-p tree)))
                 (,tree-all (treeset::tree->right tree)))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,pred-of-left-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (treeset::emptyp ,x.xvar)))
                 (,x.pred (treeset::tree->left ,x.xvar)))
        :hints (("Goal" :expand ((,x.pred (treeset::tree->left ,x.xvar)))
                 :in-theory (enable treeset::fix-when-setp
                                    treeset::setp-of-tree->left
                                    treeset::emptyp$inline)
                 :do-not-induct t)))
      (defthm ,pred-of-right-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (treeset::emptyp ,x.xvar)))
                 (,x.pred (treeset::tree->right ,x.xvar)))
        :hints (("Goal" :expand ((,x.pred (treeset::tree->right ,x.xvar)))
                 :in-theory (enable treeset::fix-when-setp
                                    treeset::setp-of-tree->right
                                    treeset::emptyp$inline)
                 :do-not-induct t))))))

(define flextreeset-fix-def (x flagp)
  :mode :program
  (b* (((flextreeset x))
       (pred-of-fix (acl2::packn-pos (list x.pred '-of- x.fix) x.name))
       (fix-when-pred (acl2::packn-pos (list x.fix '-when- x.pred) x.name))
       (emptyp-fix (acl2::packn-pos (list 'treeset::emptyp- x.fix) x.name))
       (emptyp-of-fix (acl2::packn-pos (list 'treeset::emptyp-of- x.fix) x.name)))
    (if x.fix-already-definedp
        '(progn)
      `(define ,x.fix ((,x.xvar ,x.pred))
         :parents (,x.name)
         ,@(and flagp `(:flag ,x.name))
         :progn t
         (mbe :logic (if (,x.pred ,x.xvar) ,x.xvar (treeset::empty))
              :exec ,x.xvar)
         :no-function t
         ///
         (defrule ,pred-of-fix
           (,x.pred (,x.fix ,x.xvar)))
         (defrule ,fix-when-pred
           (implies (,x.pred ,x.xvar)
                    (equal (,x.fix ,x.xvar) ,x.xvar)))
         (defrule ,emptyp-fix
           (implies (or (treeset::emptyp ,x.xvar)
                        (not (,x.pred ,x.xvar)))
                    (treeset::emptyp (,x.fix ,x.xvar)))
           :enable treeset::emptyp-of-empty)
         (defruled ,emptyp-of-fix
           (equal (treeset::emptyp (,x.fix ,x.xvar))
                  (or (not (,x.pred ,x.xvar))
                      (treeset::emptyp ,x.xvar)))
           :enable treeset::emptyp-of-empty)))))

(define flextreeset-fix-when-pred-thm (x flagp)
  :mode :program
  (b* (((flextreeset x))
       (name (intern-in-package-of-symbol
              (concatenate 'string (symbol-name x.fix) "-WHEN-" (symbol-name x.pred))
              x.fix)))
    (if flagp
        `(defthm ,name
           t
           :flag ,x.name
           :skip t)
      '(progn))))

(define flextreeset-suite-events (x)
  :mode :program
  (b* (((flextreeset x))
       (tree-all x.tree-all)
       (pred-def (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-DEFINITION")
                  x.pred))
       (alt (intern-in-package-of-symbol
             (concatenate 'string (symbol-name x.pred) "-ALT") x.pred))
       (bridge (intern-in-package-of-symbol
                (concatenate 'string (symbol-name tree-all) "-BECOMES-"
                             (symbol-name alt))
                x.pred))
       (av (intern-in-package-of-symbol "A" x.name))
       (yv (intern-in-package-of-symbol "Y" x.name))
       (np (symbol-name x.pred))
       (ne (symbol-name x.elt-type))
       (pred-of-delete (intern-in-package-of-symbol
                        (concatenate 'string np "-OF-DELETE") x.pred))
       (elt-of-min-when-pred (intern-in-package-of-symbol
                              (concatenate 'string ne "-OF-MIN-WHEN-" np)
                              x.pred))
       (alt-definition (intern-in-package-of-symbol
                        (concatenate 'string np "-ALT-DEFINITION") x.pred))
       (booleanp-of-pred (intern-in-package-of-symbol
                          (concatenate 'string "BOOLEANP-OF-" np) x.pred))
       (alt-equiv-congruence (intern-in-package-of-symbol
                              (concatenate 'string (symbol-name alt)
                                           "-WHEN-EQUIV-CONGRUENCE")
                              x.pred))
       (pred-of-insert (intern-in-package-of-symbol
                        (concatenate 'string np "-OF-INSERT") x.pred))
       (elt-when-in-pred (intern-in-package-of-symbol
                          (concatenate 'string ne "-WHEN-IN-" np
                                       "-BINDS-FREE-" (symbol-name x.xvar))
                          x.pred))
       (not-in-pred-when-not-elt (intern-in-package-of-symbol
                                  (concatenate 'string "NOT-IN-" np
                                               "-WHEN-NOT-" ne)
                                  x.pred))
       (pred-of-union (intern-in-package-of-symbol
                       (concatenate 'string np "-OF-UNION") x.pred))
       (pred-of-intersect (intern-in-package-of-symbol
                           (concatenate 'string np "-OF-INTERSECT") x.pred))
       (pred-of-diff (intern-in-package-of-symbol
                      (concatenate 'string np "-OF-DIFF") x.pred)))
    `((local
       (define ,alt (,x.xvar)
         (or (treeset::emptyp ,x.xvar)
             (and (,x.elt-type (treeset::min ,x.xvar))
                  (,alt (treeset::delete (treeset::min ,x.xvar) ,x.xvar))))
         :measure (treeset::cardinality ,x.xvar)
         :hints (("Goal"
                  :in-theory
                  (enable treeset::cardinality-of-delete-when-in
                          treeset::in-of-min
                          treeset::cardinality-type-prescription
                          treeset::emptyp-type-prescription
                          acl2::o-p)))
         :verify-guards nil))
      (local
       (defthmd ,bridge
         (implies (treeset::setp ,x.xvar)
                  (equal (,tree-all ,x.xvar)
                         (,alt ,x.xvar)))
         :hints (("Goal"
                  :use ((:instance
                         (:functional-instance
                          treeset::tree-all-genericp-becomes-set-all-genericp
                          (treeset::genericp ,x.elt-type)
                          (treeset::tree-all-genericp ,tree-all)
                          (treeset::set-all-genericp ,alt))
                         (treeset::set ,x.xvar)))
                  :in-theory (enable ,tree-all ,alt)
                  :do-not-induct t))))
      (defthm ,pred-of-delete
        (implies (,x.pred ,x.xvar)
                 (,x.pred (treeset::delete ,av ,x.xvar)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance treeset::set-all-genericp-of-delete
                                              (treeset::genericp ,x.elt-type)
                                              (treeset::set-all-genericp ,alt))
                        (treeset::x ,av)
                        (treeset::set ,x.xvar)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    treeset::setp-of-delete$inline
                                    treeset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,elt-of-min-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (treeset::emptyp ,x.xvar)))
                 (,x.elt-type (treeset::min ,x.xvar)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         treeset::genericp-of-min-under-iff-when-set-all-genericp
                         (treeset::genericp ,x.elt-type)
                         (treeset::set-all-genericp ,alt))
                        (treeset::set ,x.xvar)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    treeset::fix-when-setp)
                 :do-not-induct t)))
      (defthmd ,alt-definition
        (equal (,x.pred ,x.xvar)
               (and (treeset::setp ,x.xvar)
                    (or (treeset::emptyp ,x.xvar)
                        (and (,x.elt-type (treeset::min ,x.xvar))
                             (,x.pred (treeset::delete (treeset::min ,x.xvar)
                                                       ,x.xvar))))))
        :rule-classes :definition
        :hints (("Goal" :in-theory (enable ,pred-def ,bridge ,alt
                                           treeset::setp-of-delete$inline
                                           treeset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,booleanp-of-pred
        (booleanp (,x.pred ,x.xvar))
        :rule-classes :type-prescription
        ;; Not settleable by type reasoning (the automatic type prescriptions
        ;; are only as strong as the ambient theory at admission).
        :hints (("Goal" :induct (,alt ,x.xvar)
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    (:induction ,alt)
                                    treeset::fix-when-setp
                                    treeset::emptyp-type-prescription
                                    acl2::booleanp-compound-recognizer))))
      (local
       (defthm ,alt-equiv-congruence
         (implies (treeset::equiv ,x.xvar ,yv)
                  (equal (,alt ,x.xvar) (,alt ,yv)))
         :rule-classes :congruence
         :hints (("Goal"
                  :use ((:instance
                         (:functional-instance
                          treeset::set-all-genericp-when-equiv-congruence
                          (treeset::genericp ,x.elt-type)
                          (treeset::set-all-genericp ,alt))
                         (treeset::set0 ,x.xvar)
                         (treeset::set1 ,yv)))
                  :in-theory (enable ,alt)
                  :do-not-induct t))))
      (defthm ,pred-of-insert
        (equal (,x.pred (treeset::insert ,av ,x.xvar))
               (and (,x.elt-type ,av)
                    (,x.pred (treeset::fix ,x.xvar))))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance treeset::set-all-genericp-of-insert
                                              (treeset::genericp ,x.elt-type)
                                              (treeset::set-all-genericp ,alt))
                        (treeset::x ,av)
                        (treeset::set ,x.xvar)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    treeset::setp-of-insert$inline
                                    treeset::setp-of-fix
                                    treeset::fix-under-equiv
                                    treeset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,elt-when-in-pred
        (implies (and (treeset::in ,av ,x.xvar)
                      (,x.pred ,x.xvar))
                 (,x.elt-type ,av))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         treeset::genericp-when-set-all-genericp-and-in
                         (treeset::genericp ,x.elt-type)
                         (treeset::set-all-genericp ,alt))
                        (treeset::x ,av)
                        (treeset::set ,x.xvar)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    treeset::fix-when-setp)
                 :do-not-induct t)))
      (defthmd ,not-in-pred-when-not-elt
        (implies (and (,x.pred ,x.xvar)
                      (not (,x.elt-type ,av)))
                 (not (treeset::in ,av ,x.xvar)))
        :hints (("Goal" :do-not-induct t)))
      (defthm ,pred-of-union
        (equal (,x.pred (treeset::union ,x.xvar ,yv))
               (and (,x.pred (treeset::fix ,x.xvar))
                    (,x.pred (treeset::fix ,yv))))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance treeset::set-all-genericp-of-union
                                              (treeset::genericp ,x.elt-type)
                                              (treeset::set-all-genericp ,alt))
                        (treeset::x ,x.xvar)
                        (treeset::y ,yv)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    treeset::setp-of-union$inline
                                    treeset::setp-of-fix
                                    treeset::fix-under-equiv
                                    treeset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,pred-of-intersect
        (implies (or (,x.pred ,x.xvar)
                     (,x.pred ,yv))
                 (,x.pred (treeset::intersect ,x.xvar ,yv)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         treeset::set-all-genericp-of-intersect-when-set-all-genericp-of-arg1
                         (treeset::genericp ,x.elt-type)
                         (treeset::set-all-genericp ,alt))
                        (treeset::x ,x.xvar)
                        (treeset::y ,yv))
                       (:instance
                        (:functional-instance
                         treeset::set-all-genericp-of-intersect-when-set-all-genericp-of-arg2
                         (treeset::genericp ,x.elt-type)
                         (treeset::set-all-genericp ,alt))
                        (treeset::x ,x.xvar)
                        (treeset::y ,yv)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    treeset::setp-of-intersect$inline
                                    treeset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,pred-of-diff
        (implies (,x.pred ,x.xvar)
                 (,x.pred (treeset::diff ,x.xvar ,yv)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance treeset::set-all-genericp-of-diff
                                              (treeset::genericp ,x.elt-type)
                                              (treeset::set-all-genericp ,alt))
                        (treeset::x ,x.xvar)
                        (treeset::y ,yv)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    treeset::setp-of-diff$inline
                                    treeset::fix-when-setp)
                 :do-not-induct t))))))

(define flextreeset-count (x types)
  :mode :program
  (b* (((flextreeset x))
       ((unless x.count) nil)
       (eltcount (flextypes-find-count-for-pred x.elt-type types))
       (fixed `(,x.fix ,x.xvar))
       (elt-term
        (and eltcount
             `((,eltcount (treeset::tree-element->val (treeset::tree->head ,fixed)))))))
    ;; No :hints here: deftypes appends its own to this define.
    `((define ,x.count ((,x.xvar ,x.pred))
        :returns (count natp :rule-classes :type-prescription)
        :measure (let ((,x.xvar ,fixed))
                   ,x.measure)
        :verify-guards nil
        :progn t
        (if (treeset::emptyp ,fixed)
            0
          (+ 1
             ,@elt-term
             (,x.count (treeset::tree->left ,fixed))
             (,x.count (treeset::tree->right ,fixed))))))))

(define flextreeset-count-post-events (x types)
  :mode :program
  (b* (((flextreeset x))
       ((unless x.count) nil)
       (eltcount (flextypes-find-count-for-pred x.elt-type types))
       (tree-all x.tree-all)
       (emptyp-of-fix (acl2::packn-pos (list 'treeset::emptyp-of- x.fix) x.name))
       (pred-def (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-DEFINITION")
                  x.pred))
       (count-when-emptyp (intern-in-package-of-symbol
                           (concatenate 'string (symbol-name x.count) "-WHEN-EMPTYP")
                           x.count))
       (fold (intern-in-package-of-symbol
              (concatenate 'string (symbol-name x.count) "-FOLD") x.count))
       (count-becomes-fold (intern-in-package-of-symbol
                            (concatenate 'string (symbol-name x.count) "-BECOMES-"
                                         (symbol-name fold))
                            x.count))
       (count-of-delete-min (intern-in-package-of-symbol
                             (concatenate 'string (symbol-name x.count)
                                          "-OF-DELETE-MIN-LINEAR")
                             x.count))
       ;; Qualified by the member's count: eltcount alone would collide
       ;; between two treesets of the same element type.
       (eltcount-of-min (and eltcount
                             (intern-in-package-of-symbol
                              (concatenate 'string (symbol-name eltcount)
                                           "-OF-MIN-<-" (symbol-name x.count))
                              x.count)))
       (gc-subst
        `((treeset::generic-count ,(if eltcount
                                       eltcount
                                     '(lambda (treeset::x) 0)))
          (treeset::tree-generic-count ,fold)
          (treeset::set-generic-count
           (lambda (,x.xvar) (,fold (treeset::fix ,x.xvar)))))))
    `((defthm ,count-when-emptyp
        (implies (treeset::emptyp ,x.xvar)
                 (equal (,x.count ,x.xvar) 0))
        :hints (("Goal" :expand ((,x.count ,x.xvar))
                 :in-theory (enable ,emptyp-of-fix)
                 :do-not-induct t)))
      (local
       (define ,fold ((tree treeset::treep))
         :returns (count natp :rule-classes :type-prescription)
         :measure (acl2-count tree)
         :hints (("Goal"
                  :in-theory
                  (enable treeset::tree-empty-p-compound-recognizer
                          treeset::treep-compound-recognizer
                          treeset::treep-when-not-tree-empty-p-forward-chaining
                          treeset::acl2-count-when-not-tree-empty-p-cheap
                          treeset::tree-empty-p-when-treep-cheap)))
         :verify-guards nil
         (if (treeset::tree-empty-p tree)
             0
           (+ 1
              ,@(and eltcount
                     `((,eltcount (treeset::tree-element->val
                                   (treeset::tree->head tree)))))
              (,fold (treeset::tree->left tree))
              (,fold (treeset::tree->right tree))))))
      (local
       (defthmd ,count-becomes-fold
         (implies (and (treeset::setp ,x.xvar)
                       (,tree-all ,x.xvar))
                  (equal (,x.count ,x.xvar)
                         (,fold ,x.xvar)))
         ;; (:induction ,fold) is required: define leaves it disabled, and
         ;; :induct respects rune enabledness.
         :hints (("Goal" :induct (,fold ,x.xvar)
                  :in-theory (enable ,pred-def
                                     treeset::emptyp$inline
                                     treeset::fix-when-setp
                                     treeset::tree-empty-p-compound-recognizer
                                     treeset::treep-compound-recognizer
                                     treeset::setp-type-prescription
                                     (:induction ,fold))
                  :expand ((,fold ,x.xvar)
                           (,x.count ,x.xvar))))))
      (defthm ,count-of-delete-min
        (implies (and (,x.pred ,x.xvar)
                      (not (treeset::emptyp ,x.xvar)))
                 (< (,x.count (treeset::delete (treeset::min ,x.xvar) ,x.xvar))
                    (,x.count ,x.xvar)))
        :rule-classes :linear
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         treeset::set-generic-count-of-delete-min-<-set-generic-count
                         ,@gc-subst)
                        (treeset::set ,x.xvar)))
                 :in-theory (enable ,count-becomes-fold ,fold
                                    treeset::setp-of-delete$inline
                                    treeset::fix-when-setp)
                 :do-not-induct t)))
      ,@(and eltcount
             `((defthm ,eltcount-of-min
                 (implies (and (,x.pred ,x.xvar)
                               (not (treeset::emptyp ,x.xvar)))
                          (< (,eltcount (treeset::min ,x.xvar))
                             (,x.count ,x.xvar)))
                 :rule-classes :linear
                 :hints (("Goal"
                          :use ((:instance
                                 (:functional-instance
                                  treeset::generic-count-of-min-<-set-generic-count
                                  ,@gc-subst)
                                 (treeset::set ,x.xvar)))
                          :in-theory (enable ,count-becomes-fold ,fold
                                             treeset::fix-when-setp)
                          :do-not-induct t))))))))

(define flextreeset-fns (x)
  :mode :program
  (b* (((flextreeset x)))
    (list x.pred
          x.fix
          x.tree-all)))

(define flextreeset-collect-fix/pred-pairs (x)
  :mode :program
  (b* (((flextreeset x)))
    (and x.elt-type
         x.elt-fix
         (list (cons x.elt-fix x.elt-type)))))

(define flextreeset-fix-postevents (x)
  :mode :program
  :ignore-ok t
  :irrelevant-formals-ok t
  ())

