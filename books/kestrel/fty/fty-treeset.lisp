(defconst *flextreeset-keywords*
  '(:pred :fix :equiv :count :no-count :elt-type :measure :xvar
    :parents :short :long))

(define parse-flextreeset (x xvar our-fixtypes fixtypes state)
  :mode :program
  (b* (((unless (function-symbolp 'treeset::setp (w state)))
        (raise "Deftreeset requires the treeset FTY book. Do ~
                (include-book \"kestrel/fty/deftreeset\" :dir :system) ~
                before using deftreeset (standalone or as a deftypes clique ~
                member)."))
       ((cons name args) x)
       ((unless (symbolp name))
        (raise "Malformed deftreeset: ~x0: name must be a symbol" x))
       ((mv pre-/// post-///) (std::split-/// name args))
       ((mv kwd-alist rest)
        (extract-keywords name *flextreeset-keywords* pre-/// nil))
       (kwd-alist (append kwd-alist (table-alist 'deftreeset-defaults (w state))))
       ((when rest)
        (raise "Malformed deftreeset: ~x0: after kind should be a keyword/value set."
               name))
       (elt-type (getarg :elt-type nil kwd-alist))
       ((unless (and (symbolp elt-type) elt-type))
        (raise "Bad deftreeset ~x0: Element type must be a symbol" name))
       ((mv elt-type elt-fix elt-equiv recp)
        (get-pred/fix/equiv (getarg :elt-type nil kwd-alist) our-fixtypes fixtypes))
       (pred  (getarg! :pred  (intern-in-package-of-symbol (cat (symbol-name name) "-P") name) kwd-alist))
       (tree-all (intern-in-package-of-symbol (cat "TREE-ALL-" (symbol-name name)) name))
       (fix   (getarg! :fix   (intern-in-package-of-symbol (cat (symbol-name name) "-FIX") name) kwd-alist))
       (equiv (getarg! :equiv (intern-in-package-of-symbol (cat (symbol-name name) "-EQUIV") name) kwd-alist))
       (count (flextype-get-count-fn name kwd-alist))
       (xvar (or (getarg :xvar xvar kwd-alist)
                 (car (find-symbols-named-x (getarg :measure nil kwd-alist)))
                 (intern-in-package-of-symbol "X" name)))
       (measure (getarg! :measure `(acl2-count ,xvar) kwd-alist))
       (already-defined
        (check-flexset-already-defined pred kwd-alist our-fixtypes 'deftreeset state))
       (fix-already-defined
        (check-flexset-fix-already-defined fix kwd-alist our-fixtypes 'deftreeset state))
       (x1 (make-flextreeset :name name
                             :pred pred
                             :tree-all tree-all
                             :fix fix
                             :equiv equiv
                             :count count
                             :elt-type elt-type
                             :elt-fix elt-fix
                             :elt-equiv elt-equiv
                             :measure measure
                             :kwd-alist (if post-///
                                            (cons (cons :///-events post-///)
                                                  kwd-alist)
                                          kwd-alist)
                             :xvar xvar
                             :recp recp
                             :already-definedp already-defined
                             :fix-already-definedp fix-already-defined))
       (kwd-alist
        (list* (cons :post-pred-events
                     (append (flextreeset-post-pred-events x1)
                             (flextreeset-suite-events x1)))
               (cons :post-acc-events
                     (and count
                          '((local
                             (in-theory
                              (enable treeset::tree-empty-p-compound-recognizer
                                      treeset::treep-compound-recognizer
                                      treeset::treep-when-not-tree-empty-p-forward-chaining
                                      treeset::acl2-count-when-not-tree-empty-p-cheap
                                      treeset::tree-empty-p-when-treep-cheap
                                      treeset::fix-when-setp
                                      treeset::tree-element-p-of-tree->head
                                      treeset::acl2-count-of-tree-element->val-linear
                                      treeset::setp-type-prescription
                                      treeset::tree->head-type-prescription
                                      treeset::emptyp$inline))))))
               (flextreeset->kwd-alist x1))))
    (change-flextreeset x1 :kwd-alist kwd-alist)))
