(defconst *flextset-keywords*
  '(:pred :fix :equiv :count :no-count :elt-type :measure :xvar
    :parents :short :long))

(define parse-flextset (x xvar our-fixtypes fixtypes state)
  :mode :program
  (b* (((unless (function-symbolp 'tset::setp (w state)))
        (raise "Deftset requires the tset FTY book. Do ~
                (include-book \"kestrel/fty/deftset\" :dir :system) ~
                before using deftset (standalone or as a deftypes clique ~
                member)."))
       ((cons name args) x)
       ((unless (symbolp name))
        (raise "Malformed deftset: ~x0: name must be a symbol" x))
       ((mv pre-/// post-///) (std::split-/// name args))
       ((mv kwd-alist rest)
        (extract-keywords name *flextset-keywords* pre-/// nil))
       (kwd-alist (append kwd-alist (table-alist 'deftset-defaults (w state))))
       ((when rest)
        (raise "Malformed deftset: ~x0: after kind should be a keyword/value set."
               name))
       (elt-type (getarg :elt-type nil kwd-alist))
       ((unless (and (symbolp elt-type) elt-type))
        (raise "Bad deftset ~x0: Element type must be a symbol" name))
       ((mv elt-type elt-fix elt-equiv recp)
        (get-pred/fix/equiv (getarg :elt-type nil kwd-alist) our-fixtypes fixtypes))
       (pred  (getarg! :pred  (intern-in-package-of-symbol (cat (symbol-name name) "-P") name) kwd-alist))
       (tree-all (intern-in-package-of-symbol (cat "TREE-ALL-" (symbol-name name)) name))
       (fix   (getarg! :fix   (intern-in-package-of-symbol (cat (symbol-name name) "-FIX") name) kwd-alist))
       (equiv (getarg! :equiv (intern-in-package-of-symbol (cat (symbol-name name) "-EQUIV") name) kwd-alist))
       (count (flextype-get-count-fn name kwd-alist))
       (xvar (or (getarg :xvar xvar kwd-alist)
                 (car (find-symbols-named-x (getarg :measure nil kwd-alist)))
                 (intern-in-package-of-symbol "X" name)))
       (measure (getarg! :measure `(acl2-count ,xvar) kwd-alist))
       (already-defined
        (check-flexset-already-defined pred kwd-alist our-fixtypes 'deftset state))
       (fix-already-defined
        (check-flexset-fix-already-defined fix kwd-alist our-fixtypes 'deftset state))
       (x1 (make-flextset :name name
                          :pred pred
                          :tree-all tree-all
                          :fix fix
                          :equiv equiv
                          :count count
                          :elt-type elt-type
                          :elt-fix elt-fix
                          :elt-equiv elt-equiv
                          :measure measure
                          :kwd-alist (if post-///
                                         (cons (cons :///-events post-///)
                                               kwd-alist)
                                       kwd-alist)
                          :xvar xvar
                          :recp recp
                          :already-definedp already-defined
                          :fix-already-definedp fix-already-defined))
       (kwd-alist
        (list* (cons :post-pred-events
                     (append (flextset-post-pred-events x1)
                             (flextset-suite-events x1)))
               (cons :post-acc-events
                     (and count
                          '((local
                             (in-theory
                              (enable tset::tree-empty-p-compound-recognizer
                                      tset::treep-compound-recognizer
                                      tset::treep-when-not-tree-empty-p-forward-chaining
                                      tset::acl2-count-when-not-tree-empty-p-cheap
                                      tset::tree-empty-p-when-treep-cheap
                                      tset::fix-when-setp
                                      tset::tree-element-p-of-tree->head
                                      tset::acl2-count-of-tree-element->val-linear
                                      tset::setp-type-prescription
                                      tset::tree->head-type-prescription
                                      tset::emptyp$inline))))))
               (flextset->kwd-alist x1))))
    (change-flextset x1 :kwd-alist kwd-alist)))
