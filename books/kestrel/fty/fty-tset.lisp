(define flextset-predicate-def (x)
  :mode :program
  (b* (((flextset x))
       (tree-all x.tree-all)
       (tree-all-measure (if (and (consp x.measure)
                                  (eq (car x.measure)
                                      'acl2::two-nats-measure))
                             '(acl2::two-nats-measure (acl2-count tree) 0)
                           '(acl2-count tree))))
    `((define ,tree-all ((tree tset::treep))
        :measure ,tree-all-measure
        :hints (("Goal"
                 :in-theory
                 (enable tset::acl2-count-when-not-tree-empty-p-cheap
                         tset::fix-when-setp
                         tset::tree-element-p-of-tree->head
                         tset::acl2-count-of-tree-element->val-linear)))
        :guard-hints (("Goal"
                       :in-theory
                       (enable tset::treep-of-tree->left
                               tset::treep-of-tree->right
                               tset::tree-element-p-of-tree->head
                               tset::treep-when-setp-forward-chaining
                               tset::fix-when-setp)))
        (or (tset::tree-empty-p tree)
            (and (,x.elt-type (tset::tree-element->val (tset::tree->head tree)))
                 (,tree-all (tset::tree->left tree))
                 (,tree-all (tset::tree->right tree)))))
      (define ,x.pred (,x.xvar)
        :measure ,x.measure
        (and (tset::setp ,x.xvar)
             (let ((tree (tset::fix ,x.xvar)))
               (or (tset::tree-empty-p tree)
                   (and (,x.elt-type (tset::tree-element->val (tset::tree->head tree)))
                        (,tree-all (tset::tree->left tree))
                        (,tree-all (tset::tree->right tree))))))))))

(define flextset-post-pred-events (x)
  :mode :program
  (b* (((flextset x))
       (tree-all x.tree-all)
       (pred-def (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-DEFINITION")
                  x.pred))
       (setp-when-pred (intern-in-package-of-symbol
                        (concatenate 'string "SETP-WHEN-" (symbol-name x.pred))
                        x.pred))
       (pred-of-empty (intern-in-package-of-symbol
                       (concatenate 'string (symbol-name x.pred) "-OF-EMPTY")
                       x.pred))
       (treep-when-pred (intern-in-package-of-symbol
                         (concatenate 'string "TREEP-WHEN-"
                                      (symbol-name x.pred))
                         x.pred))
       (tree-all-when-empty (intern-in-package-of-symbol
                             (concatenate 'string (symbol-name tree-all)
                                          "-WHEN-TREE-EMPTY-P")
                             x.pred))
       (tree-all-opener (intern-in-package-of-symbol
                         (concatenate 'string (symbol-name tree-all)
                                      "-OPENER-WHEN-NOT-TREE-EMPTY-P")
                         x.pred))
       (tree-all-of-fix-when-pred (intern-in-package-of-symbol
                                   (concatenate 'string (symbol-name tree-all)
                                                "-OF-FIX-WHEN-"
                                                (symbol-name x.pred))
                                   x.pred))
       (tree-all-when-pred (intern-in-package-of-symbol
                            (concatenate 'string (symbol-name tree-all)
                                         "-WHEN-" (symbol-name x.pred))
                            x.pred))
       (elt-of-head-when-tree-all (intern-in-package-of-symbol
                                   (concatenate 'string
                                                (symbol-name x.elt-type)
                                                "-OF-TREE->HEAD-WHEN-"
                                                (symbol-name tree-all))
                                   x.pred))
       (tree-all-of-left-when-tree-all
        (intern-in-package-of-symbol
         (concatenate 'string (symbol-name tree-all) "-OF-TREE->LEFT-WHEN-"
                      (symbol-name tree-all))
         x.pred))
       (tree-all-of-right-when-tree-all
        (intern-in-package-of-symbol
         (concatenate 'string (symbol-name tree-all) "-OF-TREE->RIGHT-WHEN-"
                      (symbol-name tree-all))
         x.pred))
       (pred-of-left-when-pred (intern-in-package-of-symbol
                                (concatenate 'string (symbol-name x.pred)
                                             "-OF-TREE->LEFT-WHEN-"
                                             (symbol-name x.pred))
                                x.pred))
       (pred-of-right-when-pred (intern-in-package-of-symbol
                                 (concatenate 'string (symbol-name x.pred)
                                              "-OF-TREE->RIGHT-WHEN-"
                                              (symbol-name x.pred))
                                 x.pred)))
    ;; The fold is internal, so deftypes' post-defines disable (which covers
    ;; the registered predicates) does not know about it; disable it here.
    `((local (in-theory (disable ,tree-all)))
      (defthmd ,pred-def
        (equal (,x.pred ,x.xvar)
               (and (tset::setp ,x.xvar)
                    (,tree-all (tset::fix ,x.xvar))))
        :hints (("Goal" :expand ((,x.pred ,x.xvar)
                                 (,tree-all (tset::fix ,x.xvar))
                                 (,tree-all ,x.xvar))
                 :in-theory (enable tset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,setp-when-pred
        (implies (,x.pred ,x.xvar)
                 (tset::setp ,x.xvar))
        :hints (("Goal" :expand ((,x.pred ,x.xvar))
                 :do-not-induct t)))
      (defthm ,treep-when-pred
        (implies (,x.pred ,x.xvar)
                 (tset::treep ,x.xvar))
        :hints (("Goal" :expand ((,x.pred ,x.xvar))
                 :in-theory (enable tset::treep-when-setp-forward-chaining)
                 :do-not-induct t)))
      (defthm ,pred-of-empty
        (,x.pred (tset::empty))
        ;; Enabling emptyp-of-empty would rewrite the :use fact to T.
        :hints (("Goal" :expand ((,x.pred (tset::empty))
                                 (,tree-all (tset::fix (tset::empty)))
                                 (,tree-all (tset::empty)))
                 :use (tset::emptyp-of-empty)
                 :in-theory (enable tset::fix-when-setp
                                    tset::setp-of-empty
                                    tset::emptyp$inline)
                 :do-not-induct t)))
      (defthm ,tree-all-when-empty
        (implies (tset::tree-empty-p tree)
                 (,tree-all tree))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-opener
        (implies (not (tset::tree-empty-p tree))
                 (equal (,tree-all tree)
                        (and (,x.elt-type (tset::tree-element->val (tset::tree->head tree)))
                             (,tree-all (tset::tree->left tree))
                             (,tree-all (tset::tree->right tree)))))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-of-fix-when-pred
        (implies (,x.pred ,x.xvar)
                 (,tree-all (tset::fix ,x.xvar)))
        :hints (("Goal" :expand ((,x.pred ,x.xvar)
                                 (,tree-all (tset::fix ,x.xvar))
                                 (,tree-all ,x.xvar))
                 :in-theory (enable tset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,tree-all-when-pred
        (implies (,x.pred ,x.xvar)
                 (,tree-all ,x.xvar))
        :hints (("Goal" :expand ((,x.pred ,x.xvar)
                                 (,tree-all ,x.xvar))
                 :in-theory (enable tset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,elt-of-head-when-tree-all
        (implies (and (,tree-all tree)
                      (not (tset::tree-empty-p tree)))
                 (,x.elt-type (tset::tree-element->val (tset::tree->head tree))))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-of-left-when-tree-all
        (implies (and (,tree-all tree)
                      (not (tset::tree-empty-p tree)))
                 (,tree-all (tset::tree->left tree)))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-of-right-when-tree-all
        (implies (and (,tree-all tree)
                      (not (tset::tree-empty-p tree)))
                 (,tree-all (tset::tree->right tree)))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,pred-of-left-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (tset::emptyp ,x.xvar)))
                 (,x.pred (tset::tree->left ,x.xvar)))
        :hints (("Goal" :expand ((,x.pred (tset::tree->left ,x.xvar)))
                 :in-theory (enable tset::fix-when-setp
                                    tset::setp-of-tree->left
                                    tset::emptyp$inline)
                 :do-not-induct t)))
      (defthm ,pred-of-right-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (tset::emptyp ,x.xvar)))
                 (,x.pred (tset::tree->right ,x.xvar)))
        :hints (("Goal" :expand ((,x.pred (tset::tree->right ,x.xvar)))
                 :in-theory (enable tset::fix-when-setp
                                    tset::setp-of-tree->right
                                    tset::emptyp$inline)
                 :do-not-induct t))))))

(define flextset-fix-def (x flagp)
  :mode :program
  (b* (((flextset x))
       (pred-of-fix (acl2::packn-pos (list x.pred '-of- x.fix) x.name))
       (fix-when-pred (acl2::packn-pos (list x.fix '-when- x.pred) x.name))
       (emptyp-fix (acl2::packn-pos (list 'tset::emptyp- x.fix) x.name))
       (emptyp-of-fix (acl2::packn-pos (list 'tset::emptyp-of- x.fix) x.name))
       (subset-of-fix
        (acl2::packn-pos (list 'tset::subset-of- x.fix) x.name))
       (yv (intern-in-package-of-symbol "Y" x.name)))
    (if x.fix-already-definedp
        '(progn)
      `(define ,x.fix ((,x.xvar ,x.pred))
         :parents (,x.name)
         ,@(and flagp `(:flag ,x.name))
         :progn t
         (mbe :logic (if (,x.pred ,x.xvar) ,x.xvar (tset::empty))
              :exec ,x.xvar)
         :no-function t
         ///
         (defrule ,pred-of-fix
           (,x.pred (,x.fix ,x.xvar)))
         (defrule ,fix-when-pred
           (implies (,x.pred ,x.xvar)
                    (equal (,x.fix ,x.xvar) ,x.xvar)))
         (defrule ,emptyp-fix
           (implies (or (tset::emptyp ,x.xvar)
                        (not (,x.pred ,x.xvar)))
                    (tset::emptyp (,x.fix ,x.xvar)))
           :enable tset::emptyp-of-empty)
         (defruled ,emptyp-of-fix
           (equal (tset::emptyp (,x.fix ,x.xvar))
                  (or (not (,x.pred ,x.xvar))
                      (tset::emptyp ,x.xvar)))
           :enable tset::emptyp-of-empty)
         (defrule ,subset-of-fix
           (implies (tset::subset ,x.xvar ,yv)
                    (tset::subset (,x.fix ,x.xvar) ,yv))
           :use ((:instance
                  (:functional-instance tset::subset-of-generic-fix
                                        (tset::genericp ,x.pred)
                                        (tset::generic-fix ,x.fix))
                  (tset::set ,x.xvar)
                  (tset::y ,yv)))
           :enable ,x.fix)))))

(define flextset-fix-when-pred-thm (x flagp)
  :mode :program
  (b* (((flextset x))
       (name (intern-in-package-of-symbol
              (concatenate 'string (symbol-name x.fix) "-WHEN-" (symbol-name x.pred))
              x.fix)))
    (if flagp
        `(defthm ,name
           t
           :flag ,x.name
           :skip t)
      '(progn))))

(define flextset-suite-events (x)
  :mode :program
  (b* (((flextset x))
       (tree-all x.tree-all)
       (pred-def (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-DEFINITION")
                  x.pred))
       (alt (intern-in-package-of-symbol
             (concatenate 'string (symbol-name x.pred) "-ALT") x.pred))
       (bridge (intern-in-package-of-symbol
                (concatenate 'string (symbol-name tree-all) "-BECOMES-"
                             (symbol-name alt))
                x.pred))
       (av (intern-in-package-of-symbol "A" x.name))
       (yv (intern-in-package-of-symbol "Y" x.name))
       (cursorv (intern-in-package-of-symbol "CURSOR" x.name))
       (np (symbol-name x.pred))
       (ne (symbol-name x.elt-type))
       (pred-of-delete (intern-in-package-of-symbol
                        (concatenate 'string np "-OF-DELETE") x.pred))
       (elt-of-min-when-pred (intern-in-package-of-symbol
                              (concatenate 'string ne "-OF-MIN-WHEN-" np)
                              x.pred))
       (elt-of-entry-when-pred (intern-in-package-of-symbol
                                (concatenate 'string ne "-OF-ENTRY-WHEN-" np
                                             "-OF-FROM-CURSOR")
                                x.pred))
       (alt-definition (intern-in-package-of-symbol
                        (concatenate 'string np "-ALT-DEFINITION") x.pred))
       (booleanp-of-pred (intern-in-package-of-symbol
                          (concatenate 'string "BOOLEANP-OF-" np) x.pred))
       (alt-equiv-congruence (intern-in-package-of-symbol
                              (concatenate 'string (symbol-name alt)
                                           "-WHEN-EQUIV-CONGRUENCE")
                              x.pred))
       (pred-of-insert (intern-in-package-of-symbol
                        (concatenate 'string np "-OF-INSERT") x.pred))
       (elt-when-in-pred (intern-in-package-of-symbol
                          (concatenate 'string ne "-WHEN-IN-" np
                                       "-BINDS-FREE-" (symbol-name x.xvar))
                          x.pred))
       (not-in-pred-when-not-elt (intern-in-package-of-symbol
                                  (concatenate 'string "NOT-IN-" np
                                               "-WHEN-NOT-" ne)
                                  x.pred))
       (pred-of-union (intern-in-package-of-symbol
                       (concatenate 'string np "-OF-UNION") x.pred))
       (pred-of-intersect (intern-in-package-of-symbol
                           (concatenate 'string np "-OF-INTERSECT") x.pred))
       (pred-of-diff (intern-in-package-of-symbol
                      (concatenate 'string np "-OF-DIFF") x.pred)))
    `((local
       (define ,alt (,x.xvar)
         (or (tset::emptyp ,x.xvar)
             (and (,x.elt-type (tset::min ,x.xvar))
                  (,alt (tset::delete (tset::min ,x.xvar) ,x.xvar))))
         :measure (tset::cardinality ,x.xvar)
         :hints (("Goal"
                  :in-theory
                  (enable tset::cardinality-of-delete-when-in
                          tset::in-of-min
                          tset::cardinality-type-prescription
                          tset::emptyp-type-prescription
                          acl2::o-p)))
         :verify-guards nil))
      (local
       (defthmd ,bridge
         (implies (tset::setp ,x.xvar)
                  (equal (,tree-all ,x.xvar)
                         (,alt ,x.xvar)))
         :hints (("Goal"
                  :use ((:instance
                         (:functional-instance
                          tset::tree-all-genericp-becomes-set-all-genericp
                          (tset::genericp ,x.elt-type)
                          (tset::tree-all-genericp ,tree-all)
                          (tset::set-all-genericp ,alt))
                         (tset::set ,x.xvar)))
                  :in-theory (enable ,tree-all ,alt)
                  :do-not-induct t))))
      (defthm ,pred-of-delete
        (implies (,x.pred ,x.xvar)
                 (,x.pred (tset::delete ,av ,x.xvar)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance tset::set-all-genericp-of-delete
                                              (tset::genericp ,x.elt-type)
                                              (tset::set-all-genericp ,alt))
                        (tset::x ,av)
                        (tset::set ,x.xvar)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    tset::setp-of-delete$inline
                                    tset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,elt-of-min-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (tset::emptyp ,x.xvar)))
                 (,x.elt-type (tset::min ,x.xvar)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tset::genericp-of-min-under-iff-when-set-all-genericp
                         (tset::genericp ,x.elt-type)
                         (tset::set-all-genericp ,alt))
                        (tset::set ,x.xvar)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    tset::fix-when-setp)
                 :do-not-induct t)))
      ;; A cursor carries no element type, so a typed loop's guard at
      ;; (tset::entry cursor) is discharged from the type of the set walked.
      (defthm ,elt-of-entry-when-pred
        (implies (and (,x.pred (tset::from-cursor ,cursorv))
                      (tset::entryp ,cursorv))
                 (,x.elt-type (tset::entry ,cursorv)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tset::genericp-of-entry-when-set-all-genericp
                         (tset::genericp ,x.elt-type)
                         (tset::set-all-genericp ,alt))
                        (tset::cursor ,cursorv)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    tset::fix-when-setp)
                 :do-not-induct t)))
      (defthmd ,alt-definition
        (equal (,x.pred ,x.xvar)
               (and (tset::setp ,x.xvar)
                    (or (tset::emptyp ,x.xvar)
                        (and (,x.elt-type (tset::min ,x.xvar))
                             (,x.pred (tset::delete (tset::min ,x.xvar)
                                                    ,x.xvar))))))
        :rule-classes :definition
        :hints (("Goal" :in-theory (enable ,pred-def ,bridge ,alt
                                           tset::setp-of-delete$inline
                                           tset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,booleanp-of-pred
        (booleanp (,x.pred ,x.xvar))
        :rule-classes :type-prescription
        ;; Not settleable by type reasoning (the automatic type prescriptions
        ;; are only as strong as the ambient theory at admission).
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tset::set-all-genericp-type-prescription
                         (tset::genericp ,x.elt-type)
                         (tset::set-all-genericp ,alt))
                        (tset::set ,x.xvar)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    tset::fix-when-setp
                                    acl2::booleanp-compound-recognizer)
                 :do-not-induct t)))
      (local
       (defthm ,alt-equiv-congruence
         (implies (tset::equiv ,x.xvar ,yv)
                  (equal (,alt ,x.xvar) (,alt ,yv)))
         :rule-classes :congruence
         :hints (("Goal"
                  :use ((:instance
                         (:functional-instance
                          tset::set-all-genericp-when-equiv-congruence
                          (tset::genericp ,x.elt-type)
                          (tset::set-all-genericp ,alt))
                         (tset::set0 ,x.xvar)
                         (tset::set1 ,yv)))
                  :in-theory (enable ,alt)
                  :do-not-induct t))))
      (defthm ,pred-of-insert
        (equal (,x.pred (tset::insert ,av ,x.xvar))
               (and (,x.elt-type ,av)
                    (,x.pred (tset::fix ,x.xvar))))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance tset::set-all-genericp-of-insert
                                              (tset::genericp ,x.elt-type)
                                              (tset::set-all-genericp ,alt))
                        (tset::x ,av)
                        (tset::set ,x.xvar)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    tset::setp-of-insert$inline
                                    tset::setp-of-fix
                                    tset::fix-under-equiv
                                    tset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,elt-when-in-pred
        (implies (and (tset::in ,av ,x.xvar)
                      (,x.pred ,x.xvar))
                 (,x.elt-type ,av))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tset::genericp-when-set-all-genericp-and-in
                         (tset::genericp ,x.elt-type)
                         (tset::set-all-genericp ,alt))
                        (tset::x ,av)
                        (tset::set ,x.xvar)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    tset::fix-when-setp)
                 :do-not-induct t)))
      (defthmd ,not-in-pred-when-not-elt
        (implies (and (,x.pred ,x.xvar)
                      (not (,x.elt-type ,av)))
                 (not (tset::in ,av ,x.xvar)))
        :hints (("Goal" :do-not-induct t)))
      (defthm ,pred-of-union
        (equal (,x.pred (tset::union ,x.xvar ,yv))
               (and (,x.pred (tset::fix ,x.xvar))
                    (,x.pred (tset::fix ,yv))))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance tset::set-all-genericp-of-union
                                              (tset::genericp ,x.elt-type)
                                              (tset::set-all-genericp ,alt))
                        (tset::x ,x.xvar)
                        (tset::y ,yv)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    tset::setp-of-union$inline
                                    tset::setp-of-fix
                                    tset::fix-under-equiv
                                    tset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,pred-of-intersect
        (implies (or (,x.pred ,x.xvar)
                     (,x.pred ,yv))
                 (,x.pred (tset::intersect ,x.xvar ,yv)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tset::set-all-genericp-of-intersect-when-set-all-genericp-of-arg1
                         (tset::genericp ,x.elt-type)
                         (tset::set-all-genericp ,alt))
                        (tset::x ,x.xvar)
                        (tset::y ,yv))
                       (:instance
                        (:functional-instance
                         tset::set-all-genericp-of-intersect-when-set-all-genericp-of-arg2
                         (tset::genericp ,x.elt-type)
                         (tset::set-all-genericp ,alt))
                        (tset::x ,x.xvar)
                        (tset::y ,yv)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    tset::setp-of-intersect$inline
                                    tset::fix-when-setp)
                 :do-not-induct t)))
      (defthm ,pred-of-diff
        (implies (,x.pred ,x.xvar)
                 (,x.pred (tset::diff ,x.xvar ,yv)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance tset::set-all-genericp-of-diff
                                              (tset::genericp ,x.elt-type)
                                              (tset::set-all-genericp ,alt))
                        (tset::x ,x.xvar)
                        (tset::y ,yv)))
                 :in-theory (enable ,pred-def ,bridge ,alt
                                    tset::setp-of-diff$inline
                                    tset::fix-when-setp)
                 :do-not-induct t))))))

(define flextset-count (x types)
  :mode :program
  (b* (((flextset x))
       ((unless x.count) nil)
       (eltcount (flextypes-find-count-for-pred x.elt-type types))
       (fixed `(,x.fix ,x.xvar))
       (elt-term
        (and eltcount
             `((,eltcount (tset::tree-element->val (tset::tree->head ,fixed)))))))
    ;; No :hints here: deftypes appends its own to this define.
    `((define ,x.count ((,x.xvar ,x.pred))
        :returns (count natp :rule-classes :type-prescription)
        :measure (let ((,x.xvar ,fixed))
                   ,x.measure)
        :verify-guards nil
        :progn t
        (if (tset::emptyp ,fixed)
            0
          (+ 1
             ,@elt-term
             (,x.count (tset::tree->left ,fixed))
             (,x.count (tset::tree->right ,fixed))))))))

(define flextset-count-post-events (x types)
  :mode :program
  (b* (((flextset x))
       ((unless x.count) nil)
       (eltcount (flextypes-find-count-for-pred x.elt-type types))
       (tree-all x.tree-all)
       (emptyp-of-fix (acl2::packn-pos (list 'tset::emptyp-of- x.fix) x.name))
       (pred-def (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-DEFINITION")
                  x.pred))
       (count-when-emptyp (intern-in-package-of-symbol
                           (concatenate 'string (symbol-name x.count) "-WHEN-EMPTYP")
                           x.count))
       (fold (intern-in-package-of-symbol
              (concatenate 'string (symbol-name x.count) "-FOLD") x.count))
       (count-becomes-fold (intern-in-package-of-symbol
                            (concatenate 'string (symbol-name x.count) "-BECOMES-"
                                         (symbol-name fold))
                            x.count))
       (count-of-delete-min (intern-in-package-of-symbol
                             (concatenate 'string (symbol-name x.count)
                                          "-OF-DELETE-MIN-LINEAR")
                             x.count))
       ;; Qualified by the member's count: eltcount alone would collide
       ;; between two tsets of the same element type.
       (eltcount-of-min (and eltcount
                             (intern-in-package-of-symbol
                              (concatenate 'string (symbol-name eltcount)
                                           "-OF-MIN-<-" (symbol-name x.count))
                              x.count)))
       (gc-subst
        `((tset::generic-count ,(if eltcount
                                    eltcount
                                  '(lambda (tset::x) 0)))
          (tset::tree-generic-count ,fold)
          (tset::set-generic-count
           (lambda (,x.xvar) (,fold (tset::fix ,x.xvar)))))))
    `((defthm ,count-when-emptyp
        (implies (tset::emptyp ,x.xvar)
                 (equal (,x.count ,x.xvar) 0))
        :hints (("Goal" :expand ((,x.count ,x.xvar))
                 :in-theory (enable ,emptyp-of-fix)
                 :do-not-induct t)))
      (local
       (define ,fold ((tree tset::treep))
         :returns (count natp :rule-classes :type-prescription)
         :measure (acl2-count tree)
         :hints (("Goal"
                  :in-theory
                  (enable tset::tree-empty-p-compound-recognizer
                          tset::treep-compound-recognizer
                          tset::treep-when-not-tree-empty-p-forward-chaining
                          tset::acl2-count-when-not-tree-empty-p-cheap
                          tset::tree-empty-p-when-treep-cheap)))
         :verify-guards nil
         (if (tset::tree-empty-p tree)
             0
           (+ 1
              ,@(and eltcount
                     `((,eltcount (tset::tree-element->val
                                   (tset::tree->head tree)))))
              (,fold (tset::tree->left tree))
              (,fold (tset::tree->right tree))))))
      (local
       (defthmd ,count-becomes-fold
         (implies (and (tset::setp ,x.xvar)
                       (,tree-all ,x.xvar))
                  (equal (,x.count ,x.xvar)
                         (,fold ,x.xvar)))
         ;; (:induction ,fold) is required: define leaves it disabled, and
         ;; :induct respects rune enabledness.
         :hints (("Goal" :induct (,fold ,x.xvar)
                  :in-theory (enable ,pred-def
                                     tset::emptyp$inline
                                     tset::fix-when-setp
                                     tset::tree-empty-p-compound-recognizer
                                     tset::treep-compound-recognizer
                                     tset::setp-type-prescription
                                     (:induction ,fold))
                  :expand ((,fold ,x.xvar)
                           (,x.count ,x.xvar))))))
      (defthm ,count-of-delete-min
        (implies (and (,x.pred ,x.xvar)
                      (not (tset::emptyp ,x.xvar)))
                 (< (,x.count (tset::delete (tset::min ,x.xvar) ,x.xvar))
                    (,x.count ,x.xvar)))
        :rule-classes :linear
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tset::set-generic-count-of-delete-min-<-set-generic-count
                         ,@gc-subst)
                        (tset::set ,x.xvar)))
                 :in-theory (enable ,count-becomes-fold ,fold
                                    tset::setp-of-delete$inline
                                    tset::fix-when-setp)
                 :do-not-induct t)))
      ,@(and eltcount
             `((defthm ,eltcount-of-min
                 (implies (and (,x.pred ,x.xvar)
                               (not (tset::emptyp ,x.xvar)))
                          (< (,eltcount (tset::min ,x.xvar))
                             (,x.count ,x.xvar)))
                 :rule-classes :linear
                 :hints (("Goal"
                          :use ((:instance
                                 (:functional-instance
                                  tset::generic-count-of-min-<-set-generic-count
                                  ,@gc-subst)
                                 (tset::set ,x.xvar)))
                          :in-theory (enable ,count-becomes-fold ,fold
                                             tset::fix-when-setp)
                          :do-not-induct t))))))))

(define flextset-fns (x)
  :mode :program
  (b* (((flextset x)))
    (list x.pred
          x.fix
          x.tree-all)))

(define flextset-collect-fix/pred-pairs (x)
  :mode :program
  (b* (((flextset x)))
    (and x.elt-type
         x.elt-fix
         (list (cons x.elt-fix x.elt-type)))))

(define flextset-fix-postevents (x)
  :mode :program
  :ignore-ok t
  :irrelevant-formals-ok t
  ())

