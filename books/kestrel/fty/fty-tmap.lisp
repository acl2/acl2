(define flextmap-predicate-def (x)
  :mode :program
  (b* (((flextmap x))
       (tree-all-keys x.tree-all-keys)
       (tree-all-vals x.tree-all-vals)
       (tree-all-measure (if (and (consp x.measure)
                                  (eq (car x.measure)
                                      'acl2::two-nats-measure))
                             '(acl2::two-nats-measure (acl2-count tree) 0)
                           '(acl2-count tree)))
       (guard-hints
        '(("Goal"
           :in-theory
           (enable tmap::treep-of-tree->left
                   tmap::treep-of-tree->right
                   tmap::tree-element-p-of-tree->head
                   tmap::treep-when-mapp-forward-chaining
                   tmap::fix-when-mapp)))))
    `((define ,tree-all-keys ((tree tmap::treep))
        :measure ,tree-all-measure
        :hints (("Goal"
                 :in-theory
                 (enable tmap::acl2-count-when-not-tree-empty-p-cheap
                         tmap::fix-when-mapp
                         tmap::tree-element-p-of-tree->head
                         tmap::acl2-count-of-tree-element->key-linear
                         tmap::acl2-count-of-tree-element->val-linear)))
        :guard-hints ,guard-hints
        (or (tmap::tree-empty-p tree)
            (and (,x.key-type (tmap::tree-element->key (tmap::tree->head tree)))
                 (,tree-all-keys (tmap::tree->left tree))
                 (,tree-all-keys (tmap::tree->right tree)))))
      (define ,tree-all-vals ((tree tmap::treep))
        :measure ,tree-all-measure
        :guard-hints ,guard-hints
        (or (tmap::tree-empty-p tree)
            (and (,x.val-type (tmap::tree-element->val (tmap::tree->head tree)))
                 (,tree-all-vals (tmap::tree->left tree))
                 (,tree-all-vals (tmap::tree->right tree)))))
      (define ,x.pred (,x.xvar)
        :measure ,x.measure
        :guard-hints ,guard-hints
        (and (tmap::mapp ,x.xvar)
             (let ((tree (tmap::fix ,x.xvar)))
               (and (or (tmap::tree-empty-p tree)
                        (and (,x.key-type (tmap::tree-element->key (tmap::tree->head tree)))
                             (,tree-all-keys (tmap::tree->left tree))
                             (,tree-all-keys (tmap::tree->right tree))))
                    (or (tmap::tree-empty-p tree)
                        (and (,x.val-type (tmap::tree-element->val (tmap::tree->head tree)))
                             (,tree-all-vals (tmap::tree->left tree))
                             (,tree-all-vals (tmap::tree->right tree)))))))))))

(define flextmap-post-pred-one-fold-events (tree-all elt-type accessor x)
  ;; The per-fold half of the post-pred events: accessor is
  ;; tmap::tree-element->key or tmap::tree-element->val.
  :mode :program
  (b* (((flextmap x))
       (tree-all-when-empty (intern-in-package-of-symbol
                             (concatenate 'string (symbol-name tree-all)
                                          "-WHEN-TREE-EMPTY-P")
                             x.pred))
       (tree-all-opener (intern-in-package-of-symbol
                         (concatenate 'string (symbol-name tree-all)
                                      "-OPENER-WHEN-NOT-TREE-EMPTY-P")
                         x.pred))
       (tree-all-of-fix-when-pred (intern-in-package-of-symbol
                                   (concatenate 'string (symbol-name tree-all)
                                                "-OF-FIX-WHEN-"
                                                (symbol-name x.pred))
                                   x.pred))
       (tree-all-when-pred (intern-in-package-of-symbol
                            (concatenate 'string (symbol-name tree-all)
                                         "-WHEN-" (symbol-name x.pred))
                            x.pred))
       (elt-of-head-when-tree-all (intern-in-package-of-symbol
                                   (concatenate 'string
                                                (symbol-name elt-type)
                                                "-OF-TREE->HEAD-WHEN-"
                                                (symbol-name tree-all))
                                   x.pred))
       (tree-all-of-left-when-tree-all
        (intern-in-package-of-symbol
         (concatenate 'string (symbol-name tree-all) "-OF-TREE->LEFT-WHEN-"
                      (symbol-name tree-all))
         x.pred))
       (tree-all-of-right-when-tree-all
        (intern-in-package-of-symbol
         (concatenate 'string (symbol-name tree-all) "-OF-TREE->RIGHT-WHEN-"
                      (symbol-name tree-all))
         x.pred)))
    `((defthm ,tree-all-when-empty
        (implies (tmap::tree-empty-p tree)
                 (,tree-all tree))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-opener
        (implies (not (tmap::tree-empty-p tree))
                 (equal (,tree-all tree)
                        (and (,elt-type (,accessor (tmap::tree->head tree)))
                             (,tree-all (tmap::tree->left tree))
                             (,tree-all (tmap::tree->right tree)))))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-of-fix-when-pred
        (implies (,x.pred ,x.xvar)
                 (,tree-all (tmap::fix ,x.xvar)))
        :hints (("Goal" :expand ((,x.pred ,x.xvar)
                                 (,tree-all (tmap::fix ,x.xvar))
                                 (,tree-all ,x.xvar))
                 :in-theory (enable tmap::fix-when-mapp)
                 :do-not-induct t)))
      (defthm ,tree-all-when-pred
        (implies (,x.pred ,x.xvar)
                 (,tree-all ,x.xvar))
        :hints (("Goal" :expand ((,x.pred ,x.xvar)
                                 (,tree-all ,x.xvar))
                 :in-theory (enable tmap::fix-when-mapp)
                 :do-not-induct t)))
      (defthm ,elt-of-head-when-tree-all
        (implies (and (,tree-all tree)
                      (not (tmap::tree-empty-p tree)))
                 (,elt-type (,accessor (tmap::tree->head tree))))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-of-left-when-tree-all
        (implies (and (,tree-all tree)
                      (not (tmap::tree-empty-p tree)))
                 (,tree-all (tmap::tree->left tree)))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-of-right-when-tree-all
        (implies (and (,tree-all tree)
                      (not (tmap::tree-empty-p tree)))
                 (,tree-all (tmap::tree->right tree)))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t))))))

(define flextmap-post-pred-events (x)
  :mode :program
  (b* (((flextmap x))
       (tree-all-keys x.tree-all-keys)
       (tree-all-vals x.tree-all-vals)
       (pred-def (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-DEFINITION")
                  x.pred))
       (mapp-when-pred (intern-in-package-of-symbol
                        (concatenate 'string "MAPP-WHEN-" (symbol-name x.pred))
                        x.pred))
       (treep-when-pred (intern-in-package-of-symbol
                         (concatenate 'string "TREEP-WHEN-"
                                      (symbol-name x.pred))
                         x.pred))
       (pred-of-empty (intern-in-package-of-symbol
                       (concatenate 'string (symbol-name x.pred) "-OF-EMPTY")
                       x.pred))
       (pred-of-left-when-pred (intern-in-package-of-symbol
                                (concatenate 'string (symbol-name x.pred)
                                             "-OF-TREE->LEFT-WHEN-"
                                             (symbol-name x.pred))
                                x.pred))
       (pred-of-right-when-pred (intern-in-package-of-symbol
                                 (concatenate 'string (symbol-name x.pred)
                                              "-OF-TREE->RIGHT-WHEN-"
                                              (symbol-name x.pred))
                                 x.pred)))
    ;; The folds are internal, so deftypes' post-defines disable (which covers
    ;; the registered predicates) does not know about them; disable them here.
    `((local (in-theory (disable ,tree-all-keys ,tree-all-vals)))
      (defthmd ,pred-def
        (equal (,x.pred ,x.xvar)
               (and (tmap::mapp ,x.xvar)
                    (,tree-all-keys (tmap::fix ,x.xvar))
                    (,tree-all-vals (tmap::fix ,x.xvar))))
        :hints (("Goal" :expand ((,x.pred ,x.xvar)
                                 (,tree-all-keys (tmap::fix ,x.xvar))
                                 (,tree-all-keys ,x.xvar)
                                 (,tree-all-vals (tmap::fix ,x.xvar))
                                 (,tree-all-vals ,x.xvar))
                 :in-theory (enable tmap::fix-when-mapp)
                 :do-not-induct t)))
      (defthm ,mapp-when-pred
        (implies (,x.pred ,x.xvar)
                 (tmap::mapp ,x.xvar))
        :hints (("Goal" :expand ((,x.pred ,x.xvar))
                 :do-not-induct t)))
      (defthm ,treep-when-pred
        (implies (,x.pred ,x.xvar)
                 (tmap::treep ,x.xvar))
        :hints (("Goal" :expand ((,x.pred ,x.xvar))
                 :in-theory (enable tmap::treep-when-mapp-forward-chaining)
                 :do-not-induct t)))
      (defthm ,pred-of-empty
        (,x.pred (tmap::empty))
        ;; Enabling emptyp-of-empty would rewrite the :use fact to T.
        :hints (("Goal" :expand ((,x.pred (tmap::empty))
                                 (,tree-all-keys (tmap::fix (tmap::empty)))
                                 (,tree-all-keys (tmap::empty))
                                 (,tree-all-vals (tmap::fix (tmap::empty)))
                                 (,tree-all-vals (tmap::empty)))
                 :use (tmap::emptyp-of-empty)
                 :in-theory (e/d (tmap::fix-when-mapp
                                  tmap::mapp-of-empty
                                  tmap::emptyp$inline
                                  tmap::tree-empty-p-compound-recognizer)
                                 (tmap::emptyp-of-empty))
                 :do-not-induct t)))
      ,@(flextmap-post-pred-one-fold-events
         tree-all-keys x.key-type 'tmap::tree-element->key x)
      ,@(flextmap-post-pred-one-fold-events
         tree-all-vals x.val-type 'tmap::tree-element->val x)
      (defthm ,pred-of-left-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (tmap::emptyp ,x.xvar)))
                 (,x.pred (tmap::tree->left ,x.xvar)))
        :hints (("Goal" :expand ((,x.pred (tmap::tree->left ,x.xvar)))
                 :in-theory (enable tmap::fix-when-mapp
                                    tmap::mapp-of-tree->left
                                    tmap::emptyp$inline)
                 :do-not-induct t)))
      (defthm ,pred-of-right-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (tmap::emptyp ,x.xvar)))
                 (,x.pred (tmap::tree->right ,x.xvar)))
        :hints (("Goal" :expand ((,x.pred (tmap::tree->right ,x.xvar)))
                 :in-theory (enable tmap::fix-when-mapp
                                    tmap::mapp-of-tree->right
                                    tmap::emptyp$inline)
                 :do-not-induct t))))))

(define flextmap-fix-def (x flagp)
  :mode :program
  (b* (((flextmap x))
       (pred-of-fix (acl2::packn-pos (list x.pred '-of- x.fix) x.name))
       (fix-when-pred (acl2::packn-pos (list x.fix '-when- x.pred) x.name))
       (emptyp-fix (acl2::packn-pos (list 'tmap::emptyp- x.fix) x.name))
       (emptyp-of-fix (acl2::packn-pos (list 'tmap::emptyp-of- x.fix) x.name))
       (submap-of-fix
        (acl2::packn-pos (list 'tmap::submap-of- x.fix) x.name))
       (yv (intern-in-package-of-symbol "Y" x.name))
       (acl2-count-of-fix (acl2::packn-pos (list 'acl2-count-of- x.fix '-linear)
                                           x.name)))
    (if x.fix-already-definedp
        '(progn)
      `(define ,x.fix ((,x.xvar ,x.pred))
         :parents (,x.name)
         ,@(and flagp `(:flag ,x.name))
         :progn t
         (mbe :logic (if (,x.pred ,x.xvar) ,x.xvar (tmap::empty))
              :exec ,x.xvar)
         :no-function t
         ///
         (defrule ,pred-of-fix
           (,x.pred (,x.fix ,x.xvar)))
         (defrule ,fix-when-pred
           (implies (,x.pred ,x.xvar)
                    (equal (,x.fix ,x.xvar) ,x.xvar)))
         (defrule ,emptyp-fix
           (implies (or (tmap::emptyp ,x.xvar)
                        (not (,x.pred ,x.xvar)))
                    (tmap::emptyp (,x.fix ,x.xvar)))
           :enable tmap::emptyp-of-empty)
         (defruled ,emptyp-of-fix
           (equal (tmap::emptyp (,x.fix ,x.xvar))
                  (or (not (,x.pred ,x.xvar))
                      (tmap::emptyp ,x.xvar)))
           :enable tmap::emptyp-of-empty)
         (defrule ,submap-of-fix
           (implies (tmap::submap ,x.xvar ,yv)
                    (tmap::submap (,x.fix ,x.xvar) ,yv))
           :use ((:instance
                  (:functional-instance tmap::submap-of-generic-fix
                                        (tset::genericp ,x.pred)
                                        (tmap::generic-fix ,x.fix))
                  (tmap::map ,x.xvar)
                  (tmap::y ,yv)))
           :enable ,x.fix)
         ;; Lets count measures close by linear arithmetic alone.
         (defrule ,acl2-count-of-fix
           (<= (acl2-count (,x.fix ,x.xvar))
               (acl2-count ,x.xvar))
           :rule-classes :linear
           :enable (,x.fix
                    tmap::empty
                    (:e acl2-count)
                    (:t acl2-count)))))))

(define flextmap-fix-when-pred-thm (x flagp)
  :mode :program
  (b* (((flextmap x))
       (name (intern-in-package-of-symbol
              (concatenate 'string (symbol-name x.fix) "-WHEN-" (symbol-name x.pred))
              x.fix)))
    (if flagp
        `(defthm ,name
           t
           :flag ,x.name
           :skip t)
      '(progn))))

(define flextmap-suite-events (x)
  :mode :program
  (b* (((flextmap x))
       (tree-all-keys x.tree-all-keys)
       (tree-all-vals x.tree-all-vals)
       (pred-def (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-DEFINITION")
                  x.pred))
       (alt-keys (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-ALT-KEYS")
                  x.pred))
       (alt-vals (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-ALT-VALS")
                  x.pred))
       (keys-bridge (intern-in-package-of-symbol
                     (concatenate 'string (symbol-name tree-all-keys)
                                  "-BECOMES-" (symbol-name alt-keys))
                     x.pred))
       (vals-bridge (intern-in-package-of-symbol
                     (concatenate 'string (symbol-name tree-all-vals)
                                  "-BECOMES-" (symbol-name alt-vals))
                     x.pred))
       (av (intern-in-package-of-symbol "A" x.name))
       (vv (intern-in-package-of-symbol "V" x.name))
       (yv (intern-in-package-of-symbol "Y" x.name))
       (sv (intern-in-package-of-symbol "S" x.name))
       (iterv (intern-in-package-of-symbol "ITER" x.name))
       (np (symbol-name x.pred))
       (nk (symbol-name x.key-type))
       (nv (symbol-name x.val-type))
       (alt-measure-hints
        '(("Goal"
           :in-theory
           (enable tset::cardinality-of-delete-when-in
                   tset::in-of-min
                   tset::cardinality-type-prescription
                   tset::emptyp-type-prescription
                   acl2::o-p))))
       (booleanp-of-alt-keys (intern-in-package-of-symbol
                              (concatenate 'string "BOOLEANP-OF-"
                                           (symbol-name alt-keys))
                              x.pred))
       (booleanp-of-alt-vals (intern-in-package-of-symbol
                              (concatenate 'string "BOOLEANP-OF-"
                                           (symbol-name alt-vals))
                              x.pred))
       (booleanp-of-pred (intern-in-package-of-symbol
                          (concatenate 'string "BOOLEANP-OF-"
                                       (symbol-name x.pred))
                          x.pred))
       (key-when-in-pred (intern-in-package-of-symbol
                          (concatenate 'string nk "-WHEN-IN-" np
                                       "-BINDS-FREE-" (symbol-name x.xvar))
                          x.pred))
       (val-of-lookup-when-pred (intern-in-package-of-symbol
                                 (concatenate 'string nv "-OF-LOOKUP-WHEN-" np)
                                 x.pred))
       (not-in-pred-when-not-key (intern-in-package-of-symbol
                                  (concatenate 'string "NOT-IN-" np
                                               "-WHEN-NOT-" nk)
                                  x.pred))
       (pred-of-delete (intern-in-package-of-symbol
                        (concatenate 'string np "-OF-DELETE") x.pred))
       (pred-of-restrict (intern-in-package-of-symbol
                          (concatenate 'string np "-OF-RESTRICT") x.pred))
       (pred-of-update (intern-in-package-of-symbol
                        (concatenate 'string np "-OF-UPDATE") x.pred))
       (pred-of-update* (intern-in-package-of-symbol
                         (concatenate 'string np "-OF-UPDATE*") x.pred))
       (key-of-min-when-pred (intern-in-package-of-symbol
                              (concatenate 'string nk "-OF-MIN-KEY-WHEN-" np)
                              x.pred))
       (key-of-max-when-pred (intern-in-package-of-symbol
                              (concatenate 'string nk "-OF-MAX-KEY-WHEN-" np)
                              x.pred))
       (key-of-head-when-pred (intern-in-package-of-symbol
                               (concatenate 'string nk "-OF-HEAD-KEY-WHEN-" np)
                               x.pred))
       (val-of-min-when-pred (intern-in-package-of-symbol
                              (concatenate 'string nv "-OF-MIN-VAL-WHEN-" np)
                              x.pred))
       (val-of-max-when-pred (intern-in-package-of-symbol
                              (concatenate 'string nv "-OF-MAX-VAL-WHEN-" np)
                              x.pred))
       (val-of-head-when-pred (intern-in-package-of-symbol
                               (concatenate 'string nv "-OF-HEAD-VAL-WHEN-" np)
                               x.pred))
       (key-of-entry-key-when-pred (intern-in-package-of-symbol
                                    (concatenate 'string
                                                 nk "-OF-ENTRY-KEY-WHEN-"
                                                 np "-OF-FROM-ITER")
                                    x.pred))
       (val-of-entry-val-when-pred (intern-in-package-of-symbol
                                    (concatenate 'string
                                                 nv "-OF-ENTRY-VAL-WHEN-"
                                                 np "-OF-FROM-ITER")
                                    x.pred))
       (alt-definition (intern-in-package-of-symbol
                        (concatenate 'string np "-ALT-DEFINITION") x.pred)))
    ;; The compound recognizers must be enabled not just in proofs but when
    ;; the boolean type prescriptions below are STORED, or (under a bare
    ;; theory) they record useless typed terms.
    `((local (in-theory (enable acl2::booleanp-compound-recognizer
                                acl2::natp-compound-recognizer)))
      (local
       (define ,alt-keys (,sv)
         (or (tset::emptyp ,sv)
             (and (,x.key-type (tset::min ,sv))
                  (,alt-keys (tset::delete (tset::min ,sv) ,sv))))
         :measure (tset::cardinality ,sv)
         :hints ,alt-measure-hints
         :verify-guards nil))
      (local
       (define ,alt-vals (,sv)
         (or (tset::emptyp ,sv)
             (and (,x.val-type (tset::min ,sv))
                  (,alt-vals (tset::delete (tset::min ,sv) ,sv))))
         :measure (tset::cardinality ,sv)
         :hints ,alt-measure-hints
         :verify-guards nil))
      (local
       (defthmd ,keys-bridge
         (implies (tmap::mapp ,x.xvar)
                  (equal (,tree-all-keys ,x.xvar)
                         (,alt-keys (tmap::keys ,x.xvar))))
         :hints (("Goal"
                  :use ((:instance
                         (:functional-instance
                          tmap::tree-all-keys-genericp-becomes-set-all-genericp-of-keys
                          (tset::genericp ,x.key-type)
                          (tmap::tree-all-keys-genericp ,tree-all-keys)
                          (tset::set-all-genericp ,alt-keys))
                         (tmap::map ,x.xvar)))
                  :in-theory (enable ,tree-all-keys
                                     ,alt-keys
                                     tmap::tree-empty-p-compound-recognizer
                                     tmap::treep-compound-recognizer
                                     tmap::treep-when-not-tree-empty-p-forward-chaining)
                  :do-not-induct t))))
      (local
       (defthmd ,vals-bridge
         (implies (tmap::mapp ,x.xvar)
                  (equal (,tree-all-vals ,x.xvar)
                         (,alt-vals (tmap::values ,x.xvar))))
         :hints (("Goal"
                  :use ((:instance
                         (:functional-instance
                          tmap::tree-all-vals-genericp-becomes-set-all-genericp-of-values
                          (tset::genericp ,x.val-type)
                          (tmap::tree-all-vals-genericp ,tree-all-vals)
                          (tset::set-all-genericp ,alt-vals))
                         (tmap::map ,x.xvar)))
                  :in-theory (enable ,tree-all-vals
                                     ,alt-vals
                                     tmap::tree-empty-p-compound-recognizer
                                     tmap::treep-compound-recognizer
                                     tmap::treep-when-not-tree-empty-p-forward-chaining)
                  :do-not-induct t))))
      ;; The folds are clique members and so have no :induction runes;
      ;; booleanness goes through the standalone alts instead.
      (local
       (defthm ,booleanp-of-alt-keys
         (booleanp (,alt-keys ,sv))
         :rule-classes :type-prescription
         :hints (("Goal"
                  :use ((:instance
                         (:functional-instance
                          tset::set-all-genericp-type-prescription
                          (tset::genericp ,x.key-type)
                          (tset::set-all-genericp ,alt-keys))
                         (tset::set ,sv)))
                  :in-theory (enable ,alt-keys
                                     acl2::booleanp-compound-recognizer)
                  :do-not-induct t))))
      (local
       (defthm ,booleanp-of-alt-vals
         (booleanp (,alt-vals ,sv))
         :rule-classes :type-prescription
         :hints (("Goal"
                  :use ((:instance
                         (:functional-instance
                          tset::set-all-genericp-type-prescription
                          (tset::genericp ,x.val-type)
                          (tset::set-all-genericp ,alt-vals))
                         (tset::set ,sv)))
                  :in-theory (enable ,alt-vals
                                     acl2::booleanp-compound-recognizer)
                  :do-not-induct t))))
      (defthm ,booleanp-of-pred
        (booleanp (,x.pred ,x.xvar))
        :rule-classes :type-prescription
        :hints (("Goal" :in-theory (enable ,pred-def
                                           ,keys-bridge
                                           ,vals-bridge
                                           tmap::mapp-type-prescription
                                           tmap::mapp-of-fix
                                           acl2::booleanp-compound-recognizer)
                 :do-not-induct t)))
      (defthm ,key-when-in-pred
        (implies (and (tset::in ,av (tmap::keys ,x.xvar))
                      (,x.pred ,x.xvar))
                 (,x.key-type ,av))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::genericp-when-set-all-genericp-of-keys-and-in
                         (tset::genericp ,x.key-type)
                         (tset::set-all-genericp ,alt-keys))
                        (tmap::k ,av) (tmap::map ,x.xvar)))
                 :in-theory (enable ,pred-def
                                    ,keys-bridge
                                    ,alt-keys
                                    tmap::fix-when-mapp
                                    tmap::in$inline)
                 :do-not-induct t)))
      (defthm ,val-of-lookup-when-pred
        (implies (and (tset::in ,av (tmap::keys ,x.xvar))
                      (,x.pred ,x.xvar))
                 (,x.val-type (tmap::lookup ,av ,x.xvar)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::genericp-of-lookup-when-set-all-genericp-of-values
                         (tset::genericp ,x.val-type)
                         (tset::set-all-genericp ,alt-vals))
                        (tmap::k ,av) (tmap::map ,x.xvar)))
                 :in-theory (enable ,pred-def
                                    ,vals-bridge
                                    ,alt-vals
                                    tmap::fix-when-mapp
                                    tmap::in$inline)
                 :do-not-induct t)))
      (defthmd ,not-in-pred-when-not-key
        (implies (and (,x.pred ,x.xvar)
                      (not (,x.key-type ,av)))
                 (not (tset::in ,av (tmap::keys ,x.xvar))))
        :hints (("Goal" :do-not-induct t)))
      (defthm ,pred-of-delete
        (implies (,x.pred ,x.xvar)
                 (,x.pred (tmap::delete ,av ,x.xvar)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::set-all-genericp-of-keys-of-delete
                         (tset::genericp ,x.key-type)
                         (tset::set-all-genericp ,alt-keys))
                        (tmap::k ,av) (tmap::map ,x.xvar))
                       (:instance
                        (:functional-instance
                         tmap::set-all-genericp-of-values-of-delete
                         (tset::genericp ,x.val-type)
                         (tset::set-all-genericp ,alt-vals))
                        (tmap::k ,av) (tmap::map ,x.xvar)))
                 :in-theory (enable ,pred-def
                                    ,keys-bridge
                                    ,vals-bridge
                                    ,alt-keys
                                    ,alt-vals
                                    tmap::fix-when-mapp
                                    tmap::mapp-of-delete$inline)
                 :do-not-induct t)))
      (defthm ,pred-of-restrict
        (implies (,x.pred ,x.xvar)
                 (,x.pred (tmap::restrict ,sv ,x.xvar)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::set-all-genericp-of-keys-of-restrict
                         (tset::genericp ,x.key-type)
                         (tset::set-all-genericp ,alt-keys))
                        (tmap::s ,sv) (tmap::map ,x.xvar))
                       (:instance
                        (:functional-instance
                         tmap::set-all-genericp-of-values-of-restrict
                         (tset::genericp ,x.val-type)
                         (tset::set-all-genericp ,alt-vals))
                        (tmap::s ,sv) (tmap::map ,x.xvar)))
                 :in-theory (enable ,pred-def
                                    ,keys-bridge
                                    ,vals-bridge
                                    ,alt-keys
                                    ,alt-vals
                                    tmap::fix-when-mapp
                                    tmap::mapp-of-restrict$inline)
                 :do-not-induct t)))
      (defthm ,pred-of-update
        (equal (,x.pred (tmap::update ,av ,vv ,x.xvar))
               (and (,x.key-type ,av)
                    (,x.val-type ,vv)
                    (,x.pred (tmap::delete ,av ,x.xvar))))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::set-all-genericp-of-keys-of-update
                         (tset::genericp ,x.key-type)
                         (tset::set-all-genericp ,alt-keys))
                        (tmap::k ,av) (tmap::v ,vv) (tmap::map ,x.xvar))
                       (:instance
                        (:functional-instance
                         tmap::set-all-genericp-of-values-of-update
                         (tset::genericp ,x.val-type)
                         (tset::set-all-genericp ,alt-vals))
                        (tmap::k ,av) (tmap::v ,vv) (tmap::map ,x.xvar)))
                 :in-theory (enable ,pred-def
                                    ,keys-bridge
                                    ,vals-bridge
                                    ,alt-keys
                                    ,alt-vals
                                    tmap::fix-when-mapp
                                    tmap::mapp-of-update$inline
                                    tmap::mapp-of-delete$inline)
                 :do-not-induct t)))
      (defthm ,pred-of-update*
        (implies (and (,x.pred ,x.xvar)
                      (,x.pred ,yv))
                 (,x.pred (tmap::update* ,x.xvar ,yv)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::set-all-genericp-of-keys-of-update*
                         (tset::genericp ,x.key-type)
                         (tset::set-all-genericp ,alt-keys))
                        (tmap::m1 ,x.xvar) (tmap::m2 ,yv))
                       (:instance
                        (:functional-instance
                         tmap::set-all-genericp-of-values-of-update*
                         (tset::genericp ,x.val-type)
                         (tset::set-all-genericp ,alt-vals))
                        (tmap::m1 ,x.xvar) (tmap::m2 ,yv)))
                 :in-theory (enable ,pred-def
                                    ,keys-bridge
                                    ,vals-bridge
                                    ,alt-keys
                                    ,alt-vals
                                    tmap::fix-when-mapp
                                    tmap::mapp-of-update*$inline)
                 :do-not-induct t)))
      (defthm ,key-of-min-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (tmap::emptyp ,x.xvar)))
                 (,x.key-type (tset::min (tmap::keys ,x.xvar))))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::genericp-of-min-key-when-set-all-genericp-of-keys
                         (tset::genericp ,x.key-type)
                         (tset::set-all-genericp ,alt-keys))
                        (tmap::map ,x.xvar)))
                 :in-theory (enable ,pred-def
                                    ,keys-bridge
                                    ,alt-keys
                                    tmap::fix-when-mapp
                                    tmap::min-key$inline)
                 :do-not-induct t)))
      (defthm ,key-of-max-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (tmap::emptyp ,x.xvar)))
                 (,x.key-type (tset::max (tmap::keys ,x.xvar))))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::genericp-of-max-key-when-set-all-genericp-of-keys
                         (tset::genericp ,x.key-type)
                         (tset::set-all-genericp ,alt-keys))
                        (tmap::map ,x.xvar)))
                 :in-theory (enable ,pred-def
                                    ,keys-bridge
                                    ,alt-keys
                                    tmap::fix-when-mapp
                                    tmap::max-key$inline)
                 :do-not-induct t)))
      (defthm ,key-of-head-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (tmap::emptyp ,x.xvar)))
                 (,x.key-type (tmap::head-key ,x.xvar)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::genericp-of-head-key-when-set-all-genericp-of-keys
                         (tset::genericp ,x.key-type)
                         (tset::set-all-genericp ,alt-keys))
                        (tmap::map ,x.xvar)))
                 :in-theory (enable ,pred-def
                                    ,keys-bridge
                                    ,alt-keys
                                    tmap::fix-when-mapp)
                 :do-not-induct t)))
      (defthm ,val-of-min-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (tmap::emptyp ,x.xvar)))
                 (,x.val-type
                  (tmap::lookup (tset::min (tmap::keys ,x.xvar))
                                ,x.xvar)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::genericp-of-min-val-when-set-all-genericp-of-values
                         (tset::genericp ,x.val-type)
                         (tset::set-all-genericp ,alt-vals))
                        (tmap::map ,x.xvar)))
                 :in-theory (enable ,pred-def
                                    ,vals-bridge
                                    ,alt-vals
                                    tmap::fix-when-mapp
                                    tmap::min-val$inline)
                 :do-not-induct t)))
      (defthm ,val-of-max-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (tmap::emptyp ,x.xvar)))
                 (,x.val-type
                  (tmap::lookup (tset::max (tmap::keys ,x.xvar))
                                ,x.xvar)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::genericp-of-max-val-when-set-all-genericp-of-values
                         (tset::genericp ,x.val-type)
                         (tset::set-all-genericp ,alt-vals))
                        (tmap::map ,x.xvar)))
                 :in-theory (enable ,pred-def
                                    ,vals-bridge
                                    ,alt-vals
                                    tmap::fix-when-mapp
                                    tmap::max-val$inline)
                 :do-not-induct t)))
      (defthm ,val-of-head-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (tmap::emptyp ,x.xvar)))
                 (,x.val-type
                  (tmap::lookup (tmap::head-key ,x.xvar) ,x.xvar)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::genericp-of-head-val-when-set-all-genericp-of-values
                         (tset::genericp ,x.val-type)
                         (tset::set-all-genericp ,alt-vals))
                        (tmap::map ,x.xvar)))
                 :in-theory (enable ,pred-def
                                    ,vals-bridge
                                    ,alt-vals
                                    tmap::fix-when-mapp
                                    tmap::head-val$inline)
                 :do-not-induct t)))
      ;; An iterator carries no key or value type, so a typed loop's guards at
      ;; (tmap::entry-key iter) and (tmap::entry-val iter) are discharged
      ;; from the type of the map walked.
      (defthm ,key-of-entry-key-when-pred
        (implies (and (,x.pred (tmap::from-iter ,iterv))
                      (tmap::has-valuep ,iterv))
                 (,x.key-type (tmap::entry-key ,iterv)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::genericp-of-entry-key-when-set-all-genericp-of-keys
                         (tset::genericp ,x.key-type)
                         (tset::set-all-genericp ,alt-keys))
                        (tmap::iter ,iterv)))
                 :in-theory (enable ,pred-def
                                    ,keys-bridge
                                    ,alt-keys
                                    tmap::fix-when-mapp)
                 :do-not-induct t)))
      (defthm ,val-of-entry-val-when-pred
        (implies (and (,x.pred (tmap::from-iter ,iterv))
                      (tmap::has-valuep ,iterv))
                 (,x.val-type (tmap::entry-val ,iterv)))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::genericp-of-entry-val-when-set-all-genericp-of-values
                         (tset::genericp ,x.val-type)
                         (tset::set-all-genericp ,alt-vals))
                        (tmap::iter ,iterv)))
                 :in-theory (enable ,pred-def
                                    ,vals-bridge
                                    ,alt-vals
                                    tmap::fix-when-mapp)
                 :do-not-induct t)))
      (defthmd ,alt-definition
        (equal (,x.pred ,x.xvar)
               (and (tmap::mapp ,x.xvar)
                    (or (tmap::emptyp ,x.xvar)
                        (and (,x.key-type
                              (tset::min (tmap::keys ,x.xvar)))
                             (,x.val-type
                              (tmap::lookup
                               (tset::min (tmap::keys ,x.xvar))
                               ,x.xvar))
                             (,x.pred
                              (tmap::delete
                               (tset::min (tmap::keys ,x.xvar))
                               ,x.xvar))))))
        :rule-classes :definition
        :hints (("Goal"
                 :cases ((tmap::emptyp ,x.xvar))
                 :use ((:instance
                        (:functional-instance
                         tmap::set-all-genericp-of-keys-of-delete-when-in
                         (tset::genericp ,x.key-type)
                         (tset::set-all-genericp ,alt-keys))
                        (tmap::k (tset::min (tmap::keys ,x.xvar)))
                        (tmap::map ,x.xvar))
                       (:instance
                        (:functional-instance
                         tmap::set-all-genericp-of-values-of-delete-when-in
                         (tset::genericp ,x.val-type)
                         (tset::set-all-genericp ,alt-vals))
                        (tmap::k (tset::min (tmap::keys ,x.xvar)))
                        (tmap::map ,x.xvar)))
                 :in-theory (enable ,pred-def
                                    ,keys-bridge
                                    ,vals-bridge
                                    ,alt-keys
                                    ,alt-vals
                                    tmap::fix-when-mapp
                                    tmap::mapp-of-delete$inline
                                    tmap::emptyp-type-prescription
                                    tmap::emptyp-of-keys
                                    tmap::keys-when-emptyp-cheap
                                    tmap::values-when-emptyp-cheap
                                    tset::in-of-min
                                    tset::emptyp-of-empty)
                 :do-not-induct t))))))

(define flextmap-count (x types)
  :mode :program
  (b* (((flextmap x))
       ((unless x.count) nil)
       (keycount (flextypes-find-count-for-pred x.key-type types))
       (valcount (flextypes-find-count-for-pred x.val-type types))
       (fixed `(,x.fix ,x.xvar))
       (key-term
        (and keycount
             `((,keycount (tmap::tree-element->key (tmap::tree->head ,fixed))))))
       (val-term
        (and valcount
             `((,valcount (tmap::tree-element->val (tmap::tree->head ,fixed)))))))
    ;; No :hints here: deftypes appends its own to this define.
    `((define ,x.count ((,x.xvar ,x.pred))
        :returns (count natp :rule-classes :type-prescription)
        :measure (let ((,x.xvar ,fixed))
                   ,x.measure)
        :verify-guards nil
        :progn t
        (if (tmap::emptyp ,fixed)
            0
          (+ 1
             ,@key-term
             ,@val-term
             (,x.count (tmap::tree->left ,fixed))
             (,x.count (tmap::tree->right ,fixed))))))))

(define flextmap-count-post-events (x types)
  :mode :program
  (b* (((flextmap x))
       ((unless x.count) nil)
       (keycount (flextypes-find-count-for-pred x.key-type types))
       (valcount (flextypes-find-count-for-pred x.val-type types))
       (tree-all-keys x.tree-all-keys)
       (tree-all-vals x.tree-all-vals)
       (emptyp-of-fix (acl2::packn-pos (list 'tmap::emptyp-of- x.fix) x.name))
       (pred-def (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-DEFINITION")
                  x.pred))
       (tree-all-keys-when-pred (intern-in-package-of-symbol
                                 (concatenate 'string (symbol-name tree-all-keys)
                                              "-WHEN-" (symbol-name x.pred))
                                 x.pred))
       (tree-all-vals-when-pred (intern-in-package-of-symbol
                                 (concatenate 'string (symbol-name tree-all-vals)
                                              "-WHEN-" (symbol-name x.pred))
                                 x.pred))
       (count-when-emptyp (intern-in-package-of-symbol
                           (concatenate 'string (symbol-name x.count) "-WHEN-EMPTYP")
                           x.count))
       (fold (intern-in-package-of-symbol
              (concatenate 'string (symbol-name x.count) "-FOLD") x.count))
       (count-becomes-fold (intern-in-package-of-symbol
                            (concatenate 'string (symbol-name x.count) "-BECOMES-"
                                         (symbol-name fold))
                            x.count))
       (count-of-delete-min (intern-in-package-of-symbol
                             (concatenate 'string (symbol-name x.count)
                                          "-OF-DELETE-MIN-LINEAR")
                             x.count))
       (count-of-delete-head (intern-in-package-of-symbol
                              (concatenate 'string (symbol-name x.count)
                                           "-OF-DELETE-HEAD-LINEAR")
                              x.count))
       (count-of-update (intern-in-package-of-symbol
                         (concatenate 'string (symbol-name x.count)
                                      "-OF-UPDATE")
                         x.count))
       (kv (intern-in-package-of-symbol "KEY" x.count))
       (vlv (intern-in-package-of-symbol "VAL" x.count))
       ;; Qualified by the member's count: an element count alone would
       ;; collide between two tmaps sharing that element type.
       (keycount-of-min (and keycount
                             (intern-in-package-of-symbol
                              (concatenate 'string (symbol-name keycount)
                                           "-OF-MIN-KEY-<-" (symbol-name x.count))
                              x.count)))
       (keycount-of-head (and keycount
                              (intern-in-package-of-symbol
                               (concatenate 'string (symbol-name keycount)
                                            "-OF-HEAD-KEY-<-" (symbol-name x.count))
                               x.count)))
       (valcount-of-min (and valcount
                             (intern-in-package-of-symbol
                              (concatenate 'string (symbol-name valcount)
                                           "-OF-MIN-VAL-<-" (symbol-name x.count))
                              x.count)))
       (valcount-of-head (and valcount
                              (intern-in-package-of-symbol
                               (concatenate 'string (symbol-name valcount)
                                            "-OF-HEAD-VAL-<-" (symbol-name x.count))
                               x.count)))
       (gc-lambda
        `(lambda (tmap::key tmap::val)
           (+ ,(if keycount `(,keycount tmap::key) '0)
              ,(if valcount `(,valcount tmap::val) '0))))
       (gc-subst
        `((tmap::generic-count ,gc-lambda)
          (tmap::tree-generic-count ,fold)
          (tmap::map-generic-count
           (lambda (,x.xvar) (,fold (tmap::fix ,x.xvar))))))
       (count-enables
        `(,count-becomes-fold
          ,fold
          ,pred-def
          ,tree-all-keys-when-pred
          ,tree-all-vals-when-pred
          tmap::mapp-of-delete$inline
          tmap::fix-when-mapp)))
    `((defthm ,count-when-emptyp
        (implies (tmap::emptyp ,x.xvar)
                 (equal (,x.count ,x.xvar) 0))
        :hints (("Goal" :expand ((,x.count ,x.xvar))
                 :in-theory (enable ,emptyp-of-fix)
                 :do-not-induct t)))
      (local
       (define ,fold ((tree tmap::treep))
         :returns (count natp :rule-classes :type-prescription)
         :measure (acl2-count tree)
         :hints (("Goal"
                  :in-theory
                  (enable tmap::tree-empty-p-compound-recognizer
                          tmap::treep-compound-recognizer
                          tmap::treep-when-not-tree-empty-p-forward-chaining
                          tmap::acl2-count-when-not-tree-empty-p-cheap
                          tmap::tree-empty-p-when-treep-cheap)))
         :verify-guards nil
         (if (tmap::tree-empty-p tree)
             0
           (+ 1
              ,@(and keycount
                     `((,keycount (tmap::tree-element->key
                                   (tmap::tree->head tree)))))
              ,@(and valcount
                     `((,valcount (tmap::tree-element->val
                                   (tmap::tree->head tree)))))
              (,fold (tmap::tree->left tree))
              (,fold (tmap::tree->right tree))))))
      (local
       (defthmd ,count-becomes-fold
         (implies (and (tmap::mapp ,x.xvar)
                       (,tree-all-keys ,x.xvar)
                       (,tree-all-vals ,x.xvar))
                  (equal (,x.count ,x.xvar)
                         (,fold ,x.xvar)))
         ;; (:induction ,fold) is required: define leaves it disabled, and
         ;; :induct respects rune enabledness.
         :hints (("Goal" :induct (,fold ,x.xvar)
                  :in-theory (enable ,pred-def
                                     tmap::emptyp$inline
                                     tmap::fix-when-mapp
                                     tmap::tree-empty-p-compound-recognizer
                                     tmap::treep-compound-recognizer
                                     tmap::mapp-type-prescription
                                     tmap::mapp-of-tree->left
                                     tmap::mapp-of-tree->right
                                     (:induction ,fold))
                  :expand ((,fold ,x.xvar)
                           (,x.count ,x.xvar))))))
      (defthm ,count-of-delete-min
        (implies (and (,x.pred ,x.xvar)
                      (not (tmap::emptyp ,x.xvar)))
                 (< (,x.count (tmap::delete
                               (tset::min (tmap::keys ,x.xvar))
                               ,x.xvar))
                    (,x.count ,x.xvar)))
        :rule-classes :linear
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::map-generic-count-of-delete-min-<-map-generic-count
                         ,@gc-subst)
                        (tmap::map ,x.xvar)))
                 :in-theory (enable ,@count-enables)
                 :do-not-induct t)))
      (defthm ,count-of-delete-head
        (implies (and (,x.pred ,x.xvar)
                      (not (tmap::emptyp ,x.xvar)))
                 (< (,x.count (tmap::delete (tmap::head-key ,x.xvar)
                                            ,x.xvar))
                    (,x.count ,x.xvar)))
        :rule-classes :linear
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::map-generic-count-of-delete-head-<-map-generic-count
                         ,@gc-subst)
                        (tmap::map ,x.xvar)))
                 :in-theory (enable ,@count-enables)
                 :do-not-induct t)))
      (defthm ,count-of-update
        (implies (and (,x.key-type ,kv)
                      (,x.val-type ,vlv)
                      (,x.pred (tmap::delete ,kv ,x.xvar)))
                 (equal (,x.count (tmap::update ,kv ,vlv ,x.xvar))
                        (+ 1
                           ,@(and keycount `((,keycount ,kv)))
                           ,@(and valcount `((,valcount ,vlv)))
                           (,x.count (tmap::delete ,kv ,x.xvar)))))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         tmap::map-generic-count-of-update
                         ,@gc-subst)
                        (tmap::key ,kv)
                        (tmap::val ,vlv)
                        (tmap::map ,x.xvar)))
                 :in-theory (enable ,@count-enables
                                    tmap::mapp-of-update$inline)
                 :do-not-induct t)))
      ,@(and keycount
             `((defthm ,keycount-of-min
                 (implies (and (,x.pred ,x.xvar)
                               (not (tmap::emptyp ,x.xvar)))
                          (< (,keycount (tset::min (tmap::keys ,x.xvar)))
                             (,x.count ,x.xvar)))
                 :rule-classes :linear
                 :hints (("Goal"
                          :use ((:instance
                                 (:functional-instance
                                  tmap::generic-count-of-min-<-map-generic-count
                                  ,@gc-subst)
                                 (tmap::map ,x.xvar)))
                          :in-theory (enable ,@count-enables)
                          :do-not-induct t)))
               (defthm ,keycount-of-head
                 (implies (and (,x.pred ,x.xvar)
                               (not (tmap::emptyp ,x.xvar)))
                          (< (,keycount (tmap::head-key ,x.xvar))
                             (,x.count ,x.xvar)))
                 :rule-classes :linear
                 :hints (("Goal"
                          :use ((:instance
                                 (:functional-instance
                                  tmap::generic-count-of-head-<-map-generic-count
                                  ,@gc-subst)
                                 (tmap::map ,x.xvar)))
                          :in-theory (enable ,@count-enables)
                          :do-not-induct t)))))
      ,@(and valcount
             `((defthm ,valcount-of-min
                 (implies (and (,x.pred ,x.xvar)
                               (not (tmap::emptyp ,x.xvar)))
                          (< (,valcount
                              (tmap::lookup
                               (tset::min (tmap::keys ,x.xvar))
                               ,x.xvar))
                             (,x.count ,x.xvar)))
                 :rule-classes :linear
                 :hints (("Goal"
                          :use ((:instance
                                 (:functional-instance
                                  tmap::generic-count-of-min-<-map-generic-count
                                  ,@gc-subst)
                                 (tmap::map ,x.xvar)))
                          :in-theory (enable ,@count-enables)
                          :do-not-induct t)))
               (defthm ,valcount-of-head
                 (implies (and (,x.pred ,x.xvar)
                               (not (tmap::emptyp ,x.xvar)))
                          (< (,valcount
                              (tmap::lookup (tmap::head-key ,x.xvar)
                                            ,x.xvar))
                             (,x.count ,x.xvar)))
                 :rule-classes :linear
                 :hints (("Goal"
                          :use ((:instance
                                 (:functional-instance
                                  tmap::generic-count-of-head-<-map-generic-count
                                  ,@gc-subst)
                                 (tmap::map ,x.xvar)))
                          :in-theory (enable ,@count-enables)
                          :do-not-induct t))))))))

(define flextmap-fns (x)
  :mode :program
  (b* (((flextmap x)))
    (list x.pred
          x.fix
          x.tree-all-keys
          x.tree-all-vals)))

(define flextmap-collect-fix/pred-pairs (x)
  :mode :program
  (b* (((flextmap x)))
    (append (and x.key-type
                 x.key-fix
                 (list (cons x.key-fix x.key-type)))
            (and x.val-type
                 x.val-fix
                 (list (cons x.val-fix x.val-type))))))

(define flextmap-fix-postevents (x)
  :mode :program
  :ignore-ok t
  :irrelevant-formals-ok t
  ())

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defconst *flextmap-keywords*
  '(:pred :fix :equiv :count :no-count :key-type :val-type :measure :xvar
    :parents :short :long))

(define parse-flextmap (x xvar our-fixtypes fixtypes state)
  :mode :program
  (b* (((unless (function-symbolp 'tmap::mapp (w state)))
        (raise "Deftmap requires the tmap FTY book. Do ~
                (include-book \"kestrel/fty/deftmap\" :dir :system) ~
                before using deftmap (standalone or as a deftypes clique ~
                member)."))
       ((cons name args) x)
       ((unless (symbolp name))
        (raise "Malformed deftmap: ~x0: name must be a symbol" x))
       ((mv pre-/// post-///) (std::split-/// name args))
       ((mv kwd-alist rest)
        (extract-keywords name *flextmap-keywords* pre-/// nil))
       (kwd-alist (append kwd-alist (table-alist 'deftmap-defaults (w state))))
       ((when rest)
        (raise "Malformed deftmap: ~x0: after kind should be a keyword/value set."
               name))
       (key-type (getarg :key-type nil kwd-alist))
       ((unless (and (symbolp key-type) key-type))
        (raise "Bad deftmap ~x0: Key type must be a symbol" name))
       (val-type (getarg :val-type nil kwd-alist))
       ((unless (and (symbolp val-type) val-type))
        (raise "Bad deftmap ~x0: Value type must be a symbol" name))
       ((mv key-type key-fix key-equiv key-recp)
        (get-pred/fix/equiv (getarg :key-type nil kwd-alist) our-fixtypes fixtypes))
       ((mv val-type val-fix val-equiv val-recp)
        (get-pred/fix/equiv (getarg :val-type nil kwd-alist) our-fixtypes fixtypes))
       (pred  (getarg! :pred  (intern-in-package-of-symbol (cat (symbol-name name) "-P") name) kwd-alist))
       (tree-all-keys (intern-in-package-of-symbol
                       (cat "TREE-ALL-KEYS-" (symbol-name name)) name))
       (tree-all-vals (intern-in-package-of-symbol
                       (cat "TREE-ALL-VALS-" (symbol-name name)) name))
       (fix   (getarg! :fix   (intern-in-package-of-symbol (cat (symbol-name name) "-FIX") name) kwd-alist))
       (equiv (getarg! :equiv (intern-in-package-of-symbol (cat (symbol-name name) "-EQUIV") name) kwd-alist))
       (count (flextype-get-count-fn name kwd-alist))
       (xvar (or (getarg :xvar xvar kwd-alist)
                 (car (find-symbols-named-x (getarg :measure nil kwd-alist)))
                 (intern-in-package-of-symbol "X" name)))
       (measure (getarg! :measure `(acl2-count ,xvar) kwd-alist))
       (already-defined
        (check-flexset-already-defined pred kwd-alist our-fixtypes 'deftmap state))
       (fix-already-defined
        (check-flexset-fix-already-defined fix kwd-alist our-fixtypes 'deftmap state))
       (x1 (make-flextmap :name name
                          :pred pred
                          :tree-all-keys tree-all-keys
                          :tree-all-vals tree-all-vals
                          :fix fix
                          :equiv equiv
                          :count count
                          :key-type key-type
                          :key-fix key-fix
                          :key-equiv key-equiv
                          :val-type val-type
                          :val-fix val-fix
                          :val-equiv val-equiv
                          :measure measure
                          :kwd-alist (if post-///
                                         (cons (cons :///-events post-///)
                                               kwd-alist)
                                       kwd-alist)
                          :xvar xvar
                          :recp (or key-recp val-recp)
                          :already-definedp already-defined
                          :fix-already-definedp fix-already-defined))
       (kwd-alist
        (list* (cons :post-pred-events
                     (append (flextmap-post-pred-events x1)
                             (flextmap-suite-events x1)))
               (cons :post-acc-events
                     (and count
                          '((local
                             (in-theory
                              (enable tmap::tree-empty-p-compound-recognizer
                                      tmap::treep-compound-recognizer
                                      tmap::treep-when-not-tree-empty-p-forward-chaining
                                      tmap::acl2-count-when-not-tree-empty-p-cheap
                                      tmap::tree-empty-p-when-treep-cheap
                                      tmap::fix-when-mapp
                                      tmap::tree-element-p-of-tree->head
                                      tmap::acl2-count-of-tree-element->key-linear
                                      tmap::acl2-count-of-tree-element->val-linear
                                      tmap::mapp-type-prescription
                                      tmap::tree->head-type-prescription
                                      tmap::emptyp$inline))))))
               (flextmap->kwd-alist x1))))
    (change-flextmap x1 :kwd-alist kwd-alist)))
