(include-book "centaur/fty/portcullis" :dir :system)

; The TREEMAP and TREESET packages, so the generator functions can build event
; forms that mention treemap and treeset symbols.  These are defpkg-only
; dependencies: the book itself deliberately includes no treemap books.
(include-book "kestrel/data/treemap/portcullis" :dir :system)
(include-book "kestrel/data/treeset/portcullis" :dir :system)

