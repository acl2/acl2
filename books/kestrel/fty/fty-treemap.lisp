(define flextreemap-predicate-def (x)
  :mode :program
  (b* (((flextreemap x))
       (tree-all-keys x.tree-all-keys)
       (tree-all-vals x.tree-all-vals)
       (tree-all-measure (if (and (consp x.measure)
                                  (eq (car x.measure)
                                      'acl2::two-nats-measure))
                             '(acl2::two-nats-measure (acl2-count tree) 0)
                           '(acl2-count tree)))
       (guard-hints
        '(("Goal"
           :in-theory
           (enable treemap::treep-of-tree->left
                   treemap::treep-of-tree->right
                   treemap::tree-element-p-of-tree->head
                   treemap::treep-when-mapp-forward-chaining
                   treemap::fix-when-mapp)))))
    `((define ,tree-all-keys ((tree treemap::treep))
        :measure ,tree-all-measure
        :hints (("Goal"
                 :in-theory
                 (enable treemap::acl2-count-when-not-tree-empty-p-cheap
                         treemap::fix-when-mapp
                         treemap::tree-element-p-of-tree->head
                         treemap::acl2-count-of-tree-element->key-linear
                         treemap::acl2-count-of-tree-element->val-linear)))
        :guard-hints ,guard-hints
        (or (treemap::tree-empty-p tree)
            (and (,x.key-type (treemap::tree-element->key (treemap::tree->head tree)))
                 (,tree-all-keys (treemap::tree->left tree))
                 (,tree-all-keys (treemap::tree->right tree)))))
      (define ,tree-all-vals ((tree treemap::treep))
        :measure ,tree-all-measure
        :guard-hints ,guard-hints
        (or (treemap::tree-empty-p tree)
            (and (,x.val-type (treemap::tree-element->val (treemap::tree->head tree)))
                 (,tree-all-vals (treemap::tree->left tree))
                 (,tree-all-vals (treemap::tree->right tree)))))
      (define ,x.pred (,x.xvar)
        :measure ,x.measure
        :guard-hints ,guard-hints
        (and (treemap::mapp ,x.xvar)
             (let ((tree (treemap::fix ,x.xvar)))
               (and (or (treemap::tree-empty-p tree)
                        (and (,x.key-type (treemap::tree-element->key (treemap::tree->head tree)))
                             (,tree-all-keys (treemap::tree->left tree))
                             (,tree-all-keys (treemap::tree->right tree))))
                    (or (treemap::tree-empty-p tree)
                        (and (,x.val-type (treemap::tree-element->val (treemap::tree->head tree)))
                             (,tree-all-vals (treemap::tree->left tree))
                             (,tree-all-vals (treemap::tree->right tree)))))))))))

(define flextreemap-post-pred-one-fold-events (tree-all elt-type accessor x)
  ;; The per-fold half of the post-pred events: accessor is
  ;; treemap::tree-element->key or treemap::tree-element->val.
  :mode :program
  (b* (((flextreemap x))
       (tree-all-when-empty (intern-in-package-of-symbol
                             (concatenate 'string (symbol-name tree-all)
                                          "-WHEN-TREE-EMPTY-P")
                             x.pred))
       (tree-all-opener (intern-in-package-of-symbol
                         (concatenate 'string (symbol-name tree-all)
                                      "-OPENER-WHEN-NOT-TREE-EMPTY-P")
                         x.pred))
       (tree-all-of-fix-when-pred (intern-in-package-of-symbol
                                   (concatenate 'string (symbol-name tree-all)
                                                "-OF-FIX-WHEN-"
                                                (symbol-name x.pred))
                                   x.pred))
       (tree-all-when-pred (intern-in-package-of-symbol
                            (concatenate 'string (symbol-name tree-all)
                                         "-WHEN-" (symbol-name x.pred))
                            x.pred))
       (elt-of-head-when-tree-all (intern-in-package-of-symbol
                                   (concatenate 'string
                                                (symbol-name elt-type)
                                                "-OF-TREE->HEAD-WHEN-"
                                                (symbol-name tree-all))
                                   x.pred))
       (tree-all-of-left-when-tree-all
        (intern-in-package-of-symbol
         (concatenate 'string (symbol-name tree-all) "-OF-TREE->LEFT-WHEN-"
                      (symbol-name tree-all))
         x.pred))
       (tree-all-of-right-when-tree-all
        (intern-in-package-of-symbol
         (concatenate 'string (symbol-name tree-all) "-OF-TREE->RIGHT-WHEN-"
                      (symbol-name tree-all))
         x.pred)))
    `((defthm ,tree-all-when-empty
        (implies (treemap::tree-empty-p tree)
                 (,tree-all tree))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-opener
        (implies (not (treemap::tree-empty-p tree))
                 (equal (,tree-all tree)
                        (and (,elt-type (,accessor (treemap::tree->head tree)))
                             (,tree-all (treemap::tree->left tree))
                             (,tree-all (treemap::tree->right tree)))))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-of-fix-when-pred
        (implies (,x.pred ,x.xvar)
                 (,tree-all (treemap::fix ,x.xvar)))
        :hints (("Goal" :expand ((,x.pred ,x.xvar)
                                 (,tree-all (treemap::fix ,x.xvar))
                                 (,tree-all ,x.xvar))
                 :in-theory (enable treemap::fix-when-mapp)
                 :do-not-induct t)))
      (defthm ,tree-all-when-pred
        (implies (,x.pred ,x.xvar)
                 (,tree-all ,x.xvar))
        :hints (("Goal" :expand ((,x.pred ,x.xvar)
                                 (,tree-all ,x.xvar))
                 :in-theory (enable treemap::fix-when-mapp)
                 :do-not-induct t)))
      (defthm ,elt-of-head-when-tree-all
        (implies (and (,tree-all tree)
                      (not (treemap::tree-empty-p tree)))
                 (,elt-type (,accessor (treemap::tree->head tree))))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-of-left-when-tree-all
        (implies (and (,tree-all tree)
                      (not (treemap::tree-empty-p tree)))
                 (,tree-all (treemap::tree->left tree)))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t)))
      (defthm ,tree-all-of-right-when-tree-all
        (implies (and (,tree-all tree)
                      (not (treemap::tree-empty-p tree)))
                 (,tree-all (treemap::tree->right tree)))
        :hints (("Goal" :expand ((,tree-all tree)) :do-not-induct t))))))

(define flextreemap-post-pred-events (x)
  :mode :program
  (b* (((flextreemap x))
       (tree-all-keys x.tree-all-keys)
       (tree-all-vals x.tree-all-vals)
       (pred-def (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-DEFINITION")
                  x.pred))
       (mapp-when-pred (intern-in-package-of-symbol
                        (concatenate 'string "MAPP-WHEN-" (symbol-name x.pred))
                        x.pred))
       (treep-when-pred (intern-in-package-of-symbol
                         (concatenate 'string "TREEP-WHEN-"
                                      (symbol-name x.pred))
                         x.pred))
       (pred-of-empty (intern-in-package-of-symbol
                       (concatenate 'string (symbol-name x.pred) "-OF-EMPTY")
                       x.pred))
       (pred-of-left-when-pred (intern-in-package-of-symbol
                                (concatenate 'string (symbol-name x.pred)
                                             "-OF-TREE->LEFT-WHEN-"
                                             (symbol-name x.pred))
                                x.pred))
       (pred-of-right-when-pred (intern-in-package-of-symbol
                                 (concatenate 'string (symbol-name x.pred)
                                              "-OF-TREE->RIGHT-WHEN-"
                                              (symbol-name x.pred))
                                 x.pred)))
    ;; The folds are internal, so deftypes' post-defines disable (which covers
    ;; the registered predicates) does not know about them; disable them here.
    `((local (in-theory (disable ,tree-all-keys ,tree-all-vals)))
      (defthmd ,pred-def
        (equal (,x.pred ,x.xvar)
               (and (treemap::mapp ,x.xvar)
                    (,tree-all-keys (treemap::fix ,x.xvar))
                    (,tree-all-vals (treemap::fix ,x.xvar))))
        :hints (("Goal" :expand ((,x.pred ,x.xvar)
                                 (,tree-all-keys (treemap::fix ,x.xvar))
                                 (,tree-all-keys ,x.xvar)
                                 (,tree-all-vals (treemap::fix ,x.xvar))
                                 (,tree-all-vals ,x.xvar))
                 :in-theory (enable treemap::fix-when-mapp)
                 :do-not-induct t)))
      (defthm ,mapp-when-pred
        (implies (,x.pred ,x.xvar)
                 (treemap::mapp ,x.xvar))
        :hints (("Goal" :expand ((,x.pred ,x.xvar))
                 :do-not-induct t)))
      (defthm ,treep-when-pred
        (implies (,x.pred ,x.xvar)
                 (treemap::treep ,x.xvar))
        :hints (("Goal" :expand ((,x.pred ,x.xvar))
                 :in-theory (enable treemap::treep-when-mapp-forward-chaining)
                 :do-not-induct t)))
      (defthm ,pred-of-empty
        (,x.pred (treemap::empty))
        ;; Enabling emptyp-of-empty would rewrite the :use fact to T.
        :hints (("Goal" :expand ((,x.pred (treemap::empty))
                                 (,tree-all-keys (treemap::fix (treemap::empty)))
                                 (,tree-all-keys (treemap::empty))
                                 (,tree-all-vals (treemap::fix (treemap::empty)))
                                 (,tree-all-vals (treemap::empty)))
                 :use (treemap::emptyp-of-empty)
                 :in-theory (e/d (treemap::fix-when-mapp
                                  treemap::mapp-of-empty
                                  treemap::emptyp$inline
                                  treemap::tree-empty-p-compound-recognizer)
                                 (treemap::emptyp-of-empty))
                 :do-not-induct t)))
      ,@(flextreemap-post-pred-one-fold-events
         tree-all-keys x.key-type 'treemap::tree-element->key x)
      ,@(flextreemap-post-pred-one-fold-events
         tree-all-vals x.val-type 'treemap::tree-element->val x)
      (defthm ,pred-of-left-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (treemap::emptyp ,x.xvar)))
                 (,x.pred (treemap::tree->left ,x.xvar)))
        :hints (("Goal" :expand ((,x.pred (treemap::tree->left ,x.xvar)))
                 :in-theory (enable treemap::fix-when-mapp
                                    treemap::mapp-of-tree->left
                                    treemap::emptyp$inline)
                 :do-not-induct t)))
      (defthm ,pred-of-right-when-pred
        (implies (and (,x.pred ,x.xvar)
                      (not (treemap::emptyp ,x.xvar)))
                 (,x.pred (treemap::tree->right ,x.xvar)))
        :hints (("Goal" :expand ((,x.pred (treemap::tree->right ,x.xvar)))
                 :in-theory (enable treemap::fix-when-mapp
                                    treemap::mapp-of-tree->right
                                    treemap::emptyp$inline)
                 :do-not-induct t))))))

(define flextreemap-fix-def (x flagp)
  :mode :program
  (b* (((flextreemap x))
       (pred-of-fix (acl2::packn-pos (list x.pred '-of- x.fix) x.name))
       (fix-when-pred (acl2::packn-pos (list x.fix '-when- x.pred) x.name))
       (emptyp-fix (acl2::packn-pos (list 'treemap::emptyp- x.fix) x.name))
       (emptyp-of-fix (acl2::packn-pos (list 'treemap::emptyp-of- x.fix) x.name))
       (acl2-count-of-fix (acl2::packn-pos (list 'acl2-count-of- x.fix '-linear)
                                           x.name)))
    (if x.fix-already-definedp
        '(progn)
      `(define ,x.fix ((,x.xvar ,x.pred))
         :parents (,x.name)
         ,@(and flagp `(:flag ,x.name))
         :progn t
         (mbe :logic (if (,x.pred ,x.xvar) ,x.xvar (treemap::empty))
              :exec ,x.xvar)
         :no-function t
         ///
         (defrule ,pred-of-fix
           (,x.pred (,x.fix ,x.xvar)))
         (defrule ,fix-when-pred
           (implies (,x.pred ,x.xvar)
                    (equal (,x.fix ,x.xvar) ,x.xvar)))
         (defrule ,emptyp-fix
           (implies (or (treemap::emptyp ,x.xvar)
                        (not (,x.pred ,x.xvar)))
                    (treemap::emptyp (,x.fix ,x.xvar)))
           :enable treemap::emptyp-of-empty)
         (defruled ,emptyp-of-fix
           (equal (treemap::emptyp (,x.fix ,x.xvar))
                  (or (not (,x.pred ,x.xvar))
                      (treemap::emptyp ,x.xvar)))
           :enable treemap::emptyp-of-empty)
         ;; Lets count measures close by linear arithmetic alone.
         (defrule ,acl2-count-of-fix
           (<= (acl2-count (,x.fix ,x.xvar))
               (acl2-count ,x.xvar))
           :rule-classes :linear
           :enable (,x.fix
                    treemap::empty
                    (:e acl2-count)
                    (:t acl2-count)))))))

(define flextreemap-fix-when-pred-thm (x flagp)
  :mode :program
  (b* (((flextreemap x))
       (name (intern-in-package-of-symbol
              (concatenate 'string (symbol-name x.fix) "-WHEN-" (symbol-name x.pred))
              x.fix)))
    (if flagp
        `(defthm ,name
           t
           :flag ,x.name
           :skip t)
      '(progn))))

(define flextreemap-suite-events (x)
  :mode :program
  (b* (((flextreemap x))
       (tree-all-keys x.tree-all-keys)
       (tree-all-vals x.tree-all-vals)
       (pred-def (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-DEFINITION")
                  x.pred))
       (alt-keys (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-ALT-KEYS")
                  x.pred))
       (alt-vals (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-ALT-VALS")
                  x.pred))
       (keys-bridge (intern-in-package-of-symbol
                     (concatenate 'string (symbol-name tree-all-keys)
                                  "-BECOMES-" (symbol-name alt-keys))
                     x.pred))
       (vals-bridge (intern-in-package-of-symbol
                     (concatenate 'string (symbol-name tree-all-vals)
                                  "-BECOMES-" (symbol-name alt-vals))
                     x.pred))
       (av (intern-in-package-of-symbol "A" x.name))
       (vv (intern-in-package-of-symbol "V" x.name))
       (yv (intern-in-package-of-symbol "Y" x.name))
       (sv (intern-in-package-of-symbol "S" x.name))
       (np (symbol-name x.pred))
       (nk (symbol-name x.key-type))
       (nv (symbol-name x.val-type))
       (alt-measure-hints
        '(("Goal"
           :in-theory
           (enable treeset::cardinality-of-delete-when-in
                   treeset::in-of-min
                   treeset::cardinality-type-prescription
                   treeset::emptyp-type-prescription
                   acl2::o-p))))
       (booleanp-of-alt-keys (intern-in-package-of-symbol
                              (concatenate 'string "BOOLEANP-OF-"
                                           (symbol-name alt-keys))
                              x.pred))
       (booleanp-of-alt-vals (intern-in-package-of-symbol
                              (concatenate 'string "BOOLEANP-OF-"
                                           (symbol-name alt-vals))
                              x.pred))
       (booleanp-of-pred (intern-in-package-of-symbol
                          (concatenate 'string "BOOLEANP-OF-"
                                       (symbol-name x.pred))
                          x.pred))
       (key-when-in-pred (intern-in-package-of-symbol
                          (concatenate 'string nk "-WHEN-IN-" np
                                       "-BINDS-FREE-" (symbol-name x.xvar))
                          x.pred))
       (val-of-lookup-when-pred (intern-in-package-of-symbol
                                 (concatenate 'string nv "-OF-LOOKUP-WHEN-" np)
                                 x.pred))
       (not-in-pred-when-not-key (intern-in-package-of-symbol
                                  (concatenate 'string "NOT-IN-" np
                                               "-WHEN-NOT-" nk)
                                  x.pred))
       (pred-of-delete (intern-in-package-of-symbol
                        (concatenate 'string np "-OF-DELETE") x.pred))
       (pred-of-restrict (intern-in-package-of-symbol
                          (concatenate 'string np "-OF-RESTRICT") x.pred))
       (pred-of-update (intern-in-package-of-symbol
                        (concatenate 'string np "-OF-UPDATE") x.pred))
       (pred-of-update* (intern-in-package-of-symbol
                         (concatenate 'string np "-OF-UPDATE*") x.pred))
       (key-of-min-when-pred (intern-in-package-of-symbol
                              (concatenate 'string nk "-OF-MIN-KEY-WHEN-" np)
                              x.pred))
       (key-of-max-when-pred (intern-in-package-of-symbol
                              (concatenate 'string nk "-OF-MAX-KEY-WHEN-" np)
                              x.pred))
       (key-of-head-when-pred (intern-in-package-of-symbol
                               (concatenate 'string nk "-OF-HEAD-KEY-WHEN-" np)
                               x.pred))
       (val-of-min-when-pred (intern-in-package-of-symbol
                              (concatenate 'string nv "-OF-MIN-VAL-WHEN-" np)
                              x.pred))
       (val-of-max-when-pred (intern-in-package-of-symbol
                              (concatenate 'string nv "-OF-MAX-VAL-WHEN-" np)
                              x.pred))
       (val-of-head-when-pred (intern-in-package-of-symbol
                               (concatenate 'string nv "-OF-HEAD-VAL-WHEN-" np)
                               x.pred))
       (alt-definition (intern-in-package-of-symbol
                        (concatenate 'string np "-ALT-DEFINITION") x.pred)))
    ;; The compound recognizers must be enabled not just in proofs but when
    ;; the boolean type prescriptions below are STORED, or (under a bare
    ;; theory) they record useless typed terms.
    `((local (in-theory (enable acl2::booleanp-compound-recognizer
                                acl2::natp-compound-recognizer)))
      (local
       (define ,alt-keys (,sv)
         (or (treeset::emptyp ,sv)
             (and (,x.key-type (treeset::min ,sv))
                  (,alt-keys (treeset::delete (treeset::min ,sv) ,sv))))
         :measure (treeset::cardinality ,sv)
         :hints ,alt-measure-hints
