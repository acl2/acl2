(defxdoc deftreemap
  :parents (fty-extensions fty treemap::treemap)
  :short "Generate a <see topic='@(url fty::fty)'>fixtype</see>
          of <see topic='@(url treemap::treemap)'>treemaps</see>
          whose keys and values have specified fixtypes."

  :long
  (xdoc::topstring
   (xdoc::h3 "Introduction")
   (xdoc::p
    "This is the @(see treemap::treemap) analogue of @(tsee fty::defomap)
     (which generates fixtypes of <see topic='@(url omap::omaps)'>omaps</see>),
     and the two-projection analogue of @(tsee fty::deftreeset).")
   (xdoc::h3 "General Form")
   (xdoc::codeblock
    "(deftreemap type"
    "            :key-type ..."
    "            :val-type ..."
    "            :pred     ..."
    "            :fix      ..."
    "            :equiv    ..."
    "            :count    ..."
    "            :measure  ..."
    "            :xvar     ..."
    "            :parents  ..."
    "            :short    ..."
    "            :long     ..."
    "  )")
   (xdoc::h3 "Inputs")
   (xdoc::desc
    "@('type')"
    (xdoc::p
     "The name of the new fixtype."))
   (xdoc::desc
    "@(':key-type') <br/> @(':val-type')"
    (xdoc::p
      "The fixtypes of the keys and values of the new map fixtype."))
   (xdoc::desc
    "@(':pred') <br/> @(':fix') <br/> @(':equiv')"
    (xdoc::p
     "The names of the recognizer, fixer, and equivalence for the new fixtype.
      The defaults are @('type') followed by @('-p'), @('-fix'), and
      @('-equiv')."))
   (xdoc::desc
    "@(':count')"
    (xdoc::p
     "The name of the generated count.
      Defaults to @('type-count').
      As with @(tsee deftreeset),
      a standalone @('deftreemap') generates a count
      only when @(':count') is supplied;
      as a @(tsee deftypes) clique member,
      a count is generated by default."))
   (xdoc::desc
    "@(':parents') <br/> @(':short') <br/> @(':long')"
    (xdoc::p
     "XDOC documentation for the generated @('type') topic;
      omitted components are simply left out of the topic."))
   (xdoc::h3 "Generated Events")
   (xdoc::ul
    (xdoc::li
     "The recognizer, the fixer, the equivalence, and the fixtype.")
    (xdoc::li
     "A suite of theorems about the recognizer over the treemap operations
      (@(tsee treemap::lookup), @(tsee treemap::update), @(tsee
      treemap::update*), @(tsee treemap::delete), @(tsee
      treemap::restrict)).")
    (xdoc::li
     "When a count is generated,
      a structural count function and the linear rules that let it serve
      as a termination measure for recursions over the map."))))

