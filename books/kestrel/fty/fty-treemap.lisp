(define flextreemap-count (x types)
  :mode :program
  (b* (((flextreemap x))
       ((unless x.count) nil)
       (keycount (flextypes-find-count-for-pred x.key-type types))
       (valcount (flextypes-find-count-for-pred x.val-type types))
       (fixed `(,x.fix ,x.xvar))
       (key-term
        (and keycount
             `((,keycount (treemap::tree-element->key (treemap::tree->head ,fixed))))))
       (val-term
        (and valcount
             `((,valcount (treemap::tree-element->val (treemap::tree->head ,fixed)))))))
    ;; No :hints here: deftypes appends its own to this define.
    `((define ,x.count ((,x.xvar ,x.pred))
        :returns (count natp :rule-classes :type-prescription)
        :measure (let ((,x.xvar ,fixed))
                   ,x.measure)
        :verify-guards nil
        :progn t
        (if (treemap::emptyp ,fixed)
            0
          (+ 1
             ,@key-term
             ,@val-term
             (,x.count (treemap::tree->left ,fixed))
             (,x.count (treemap::tree->right ,fixed))))))))

(define flextreemap-count-post-events (x types)
  :mode :program
  (b* (((flextreemap x))
       ((unless x.count) nil)
       (keycount (flextypes-find-count-for-pred x.key-type types))
       (valcount (flextypes-find-count-for-pred x.val-type types))
       (tree-all-keys x.tree-all-keys)
       (tree-all-vals x.tree-all-vals)
       (emptyp-of-fix (acl2::packn-pos (list 'treemap::emptyp-of- x.fix) x.name))
       (pred-def (intern-in-package-of-symbol
                  (concatenate 'string (symbol-name x.pred) "-DEFINITION")
                  x.pred))
       (tree-all-keys-when-pred (intern-in-package-of-symbol
                                 (concatenate 'string (symbol-name tree-all-keys)
                                              "-WHEN-" (symbol-name x.pred))
                                 x.pred))
       (tree-all-vals-when-pred (intern-in-package-of-symbol
                                 (concatenate 'string (symbol-name tree-all-vals)
                                              "-WHEN-" (symbol-name x.pred))
                                 x.pred))
       (count-when-emptyp (intern-in-package-of-symbol
                           (concatenate 'string (symbol-name x.count) "-WHEN-EMPTYP")
                           x.count))
       (fold (intern-in-package-of-symbol
              (concatenate 'string (symbol-name x.count) "-FOLD") x.count))
       (count-becomes-fold (intern-in-package-of-symbol
                            (concatenate 'string (symbol-name x.count) "-BECOMES-"
                                         (symbol-name fold))
                            x.count))
       (count-of-delete-min (intern-in-package-of-symbol
                             (concatenate 'string (symbol-name x.count)
                                          "-OF-DELETE-MIN-LINEAR")
                             x.count))
       (count-of-delete-head (intern-in-package-of-symbol
                              (concatenate 'string (symbol-name x.count)
                                           "-OF-DELETE-HEAD-LINEAR")
                              x.count))
       (count-of-update (intern-in-package-of-symbol
                         (concatenate 'string (symbol-name x.count)
                                      "-OF-UPDATE")
                         x.count))
       (kv (intern-in-package-of-symbol "KEY" x.count))
       (vlv (intern-in-package-of-symbol "VAL" x.count))
       ;; Qualified by the member's count: an element count alone would
       ;; collide between two treemaps sharing that element type.
       (keycount-of-min (and keycount
                             (intern-in-package-of-symbol
                              (concatenate 'string (symbol-name keycount)
                                           "-OF-MIN-KEY-<-" (symbol-name x.count))
                              x.count)))
       (keycount-of-head (and keycount
                              (intern-in-package-of-symbol
                               (concatenate 'string (symbol-name keycount)
                                            "-OF-HEAD-KEY-<-" (symbol-name x.count))
                               x.count)))
       (valcount-of-min (and valcount
                             (intern-in-package-of-symbol
                              (concatenate 'string (symbol-name valcount)
                                           "-OF-MIN-VAL-<-" (symbol-name x.count))
                              x.count)))
       (valcount-of-head (and valcount
                              (intern-in-package-of-symbol
                               (concatenate 'string (symbol-name valcount)
                                            "-OF-HEAD-VAL-<-" (symbol-name x.count))
                               x.count)))
       (gc-lambda
        `(lambda (treemap::key treemap::val)
           (+ ,(if keycount `(,keycount treemap::key) '0)
              ,(if valcount `(,valcount treemap::val) '0))))
       (gc-subst
        `((treemap::generic-count ,gc-lambda)
          (treemap::tree-generic-count ,fold)
          (treemap::map-generic-count
           (lambda (,x.xvar) (,fold (treemap::fix ,x.xvar))))))
       (count-enables
        `(,count-becomes-fold
          ,fold
          ,pred-def
          ,tree-all-keys-when-pred
          ,tree-all-vals-when-pred
          treemap::mapp-of-delete$inline
          treemap::fix-when-mapp)))
    `((defthm ,count-when-emptyp
        (implies (treemap::emptyp ,x.xvar)
                 (equal (,x.count ,x.xvar) 0))
        :hints (("Goal" :expand ((,x.count ,x.xvar))
                 :in-theory (enable ,emptyp-of-fix)
                 :do-not-induct t)))
      (local
       (define ,fold ((tree treemap::treep))
         :returns (count natp :rule-classes :type-prescription)
         :measure (acl2-count tree)
         :hints (("Goal"
                  :in-theory
                  (enable treemap::tree-empty-p-compound-recognizer
                          treemap::treep-compound-recognizer
                          treemap::treep-when-not-tree-empty-p-forward-chaining
                          treemap::acl2-count-when-not-tree-empty-p-cheap
                          treemap::tree-empty-p-when-treep-cheap)))
         :verify-guards nil
         (if (treemap::tree-empty-p tree)
             0
           (+ 1
              ,@(and keycount
                     `((,keycount (treemap::tree-element->key
                                   (treemap::tree->head tree)))))
              ,@(and valcount
                     `((,valcount (treemap::tree-element->val
                                   (treemap::tree->head tree)))))
              (,fold (treemap::tree->left tree))
              (,fold (treemap::tree->right tree))))))
      (local
       (defthmd ,count-becomes-fold
         (implies (and (treemap::mapp ,x.xvar)
                       (,tree-all-keys ,x.xvar)
                       (,tree-all-vals ,x.xvar))
                  (equal (,x.count ,x.xvar)
                         (,fold ,x.xvar)))
         ;; (:induction ,fold) is required: define leaves it disabled, and
         ;; :induct respects rune enabledness.
         :hints (("Goal" :induct (,fold ,x.xvar)
                  :in-theory (enable ,pred-def
                                     treemap::emptyp$inline
                                     treemap::fix-when-mapp
                                     treemap::tree-empty-p-compound-recognizer
                                     treemap::treep-compound-recognizer
                                     treemap::mapp-type-prescription
                                     treemap::mapp-of-tree->left
                                     treemap::mapp-of-tree->right
                                     (:induction ,fold))
                  :expand ((,fold ,x.xvar)
                           (,x.count ,x.xvar))))))
      (defthm ,count-of-delete-min
        (implies (and (,x.pred ,x.xvar)
                      (not (treemap::emptyp ,x.xvar)))
                 (< (,x.count (treemap::delete
                               (treeset::min (treemap::keys ,x.xvar))
                               ,x.xvar))
                    (,x.count ,x.xvar)))
        :rule-classes :linear
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         treemap::map-generic-count-of-delete-min-<-map-generic-count
                         ,@gc-subst)
                        (treemap::map ,x.xvar)))
                 :in-theory (enable ,@count-enables)
                 :do-not-induct t)))
      (defthm ,count-of-delete-head
        (implies (and (,x.pred ,x.xvar)
                      (not (treemap::emptyp ,x.xvar)))
                 (< (,x.count (treemap::delete (treemap::head-key ,x.xvar)
                                               ,x.xvar))
                    (,x.count ,x.xvar)))
        :rule-classes :linear
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         treemap::map-generic-count-of-delete-head-<-map-generic-count
                         ,@gc-subst)
                        (treemap::map ,x.xvar)))
                 :in-theory (enable ,@count-enables)
                 :do-not-induct t)))
      (defthm ,count-of-update
        (implies (and (,x.key-type ,kv)
                      (,x.val-type ,vlv)
                      (,x.pred (treemap::delete ,kv ,x.xvar)))
                 (equal (,x.count (treemap::update ,kv ,vlv ,x.xvar))
                        (+ 1
                           ,@(and keycount `((,keycount ,kv)))
                           ,@(and valcount `((,valcount ,vlv)))
                           (,x.count (treemap::delete ,kv ,x.xvar)))))
        :hints (("Goal"
                 :use ((:instance
                        (:functional-instance
                         treemap::map-generic-count-of-update
                         ,@gc-subst)
                        (treemap::key ,kv)
                        (treemap::val ,vlv)
                        (treemap::map ,x.xvar)))
                 :in-theory (enable ,@count-enables
                                    treemap::mapp-of-update$inline)
                 :do-not-induct t)))
      ,@(and keycount
             `((defthm ,keycount-of-min
                 (implies (and (,x.pred ,x.xvar)
                               (not (treemap::emptyp ,x.xvar)))
                          (< (,keycount (treeset::min (treemap::keys ,x.xvar)))
                             (,x.count ,x.xvar)))
                 :rule-classes :linear
                 :hints (("Goal"
                          :use ((:instance
                                 (:functional-instance
                                  treemap::generic-count-of-min-<-map-generic-count
                                  ,@gc-subst)
                                 (treemap::map ,x.xvar)))
                          :in-theory (enable ,@count-enables)
                          :do-not-induct t)))
               (defthm ,keycount-of-head
                 (implies (and (,x.pred ,x.xvar)
                               (not (treemap::emptyp ,x.xvar)))
                          (< (,keycount (treemap::head-key ,x.xvar))
                             (,x.count ,x.xvar)))
                 :rule-classes :linear
                 :hints (("Goal"
                          :use ((:instance
                                 (:functional-instance
                                  treemap::generic-count-of-head-<-map-generic-count
                                  ,@gc-subst)
                                 (treemap::map ,x.xvar)))
                          :in-theory (enable ,@count-enables)
                          :do-not-induct t)))))
      ,@(and valcount
             `((defthm ,valcount-of-min
                 (implies (and (,x.pred ,x.xvar)
                               (not (treemap::emptyp ,x.xvar)))
                          (< (,valcount
                              (treemap::lookup
                               (treeset::min (treemap::keys ,x.xvar))
                               ,x.xvar))
                             (,x.count ,x.xvar)))
                 :rule-classes :linear
                 :hints (("Goal"
                          :use ((:instance
                                 (:functional-instance
                                  treemap::generic-count-of-min-<-map-generic-count
                                  ,@gc-subst)
                                 (treemap::map ,x.xvar)))
                          :in-theory (enable ,@count-enables)
                          :do-not-induct t)))
               (defthm ,valcount-of-head
                 (implies (and (,x.pred ,x.xvar)
                               (not (treemap::emptyp ,x.xvar)))
                          (< (,valcount
                              (treemap::lookup (treemap::head-key ,x.xvar)
                                               ,x.xvar))
                             (,x.count ,x.xvar)))
                 :rule-classes :linear
                 :hints (("Goal"
                          :use ((:instance
                                 (:functional-instance
                                  treemap::generic-count-of-head-<-map-generic-count
                                  ,@gc-subst)
                                 (treemap::map ,x.xvar)))
                          :in-theory (enable ,@count-enables)
                          :do-not-induct t))))))))

(define flextreemap-fns (x)
  :mode :program
  (b* (((flextreemap x)))
    (list x.pred
          x.fix
          x.tree-all-keys
          x.tree-all-vals)))

(define flextreemap-collect-fix/pred-pairs (x)
  :mode :program
  (b* (((flextreemap x)))
    (append (and x.key-type
                 x.key-fix
                 (list (cons x.key-fix x.key-type)))
            (and x.val-type
                 x.val-fix
                 (list (cons x.val-fix x.val-type))))))

(define flextreemap-fix-postevents (x)
  :mode :program
  :ignore-ok t
  :irrelevant-formals-ok t
  ())

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defconst *flextreemap-keywords*
  '(:pred :fix :equiv :count :no-count :key-type :val-type :measure :xvar
    :parents :short :long))

(define parse-flextreemap (x xvar our-fixtypes fixtypes state)
  :mode :program
  (b* (((unless (function-symbolp 'treemap::mapp (w state)))
        (raise "Deftreemap requires the treemap FTY book. Do ~
                (include-book \"kestrel/fty/deftreemap\" :dir :system) ~
                before using deftreemap (standalone or as a deftypes clique ~
                member)."))
       ((cons name args) x)
       ((unless (symbolp name))
        (raise "Malformed deftreemap: ~x0: name must be a symbol" x))
       ((mv pre-/// post-///) (std::split-/// name args))
       ((mv kwd-alist rest)
        (extract-keywords name *flextreemap-keywords* pre-/// nil))
       (kwd-alist (append kwd-alist (table-alist 'deftreemap-defaults (w state))))
       ((when rest)
        (raise "Malformed deftreemap: ~x0: after kind should be a keyword/value set."
               name))
       (key-type (getarg :key-type nil kwd-alist))
       ((unless (and (symbolp key-type) key-type))
        (raise "Bad deftreemap ~x0: Key type must be a symbol" name))
       (val-type (getarg :val-type nil kwd-alist))
       ((unless (and (symbolp val-type) val-type))
        (raise "Bad deftreemap ~x0: Value type must be a symbol" name))
       ((mv key-type key-fix key-equiv key-recp)
        (get-pred/fix/equiv (getarg :key-type nil kwd-alist) our-fixtypes fixtypes))
       ((mv val-type val-fix val-equiv val-recp)
        (get-pred/fix/equiv (getarg :val-type nil kwd-alist) our-fixtypes fixtypes))
       (pred  (getarg! :pred  (intern-in-package-of-symbol (cat (symbol-name name) "-P") name) kwd-alist))
       (tree-all-keys (intern-in-package-of-symbol
                       (cat "TREE-ALL-KEYS-" (symbol-name name)) name))
       (tree-all-vals (intern-in-package-of-symbol
                       (cat "TREE-ALL-VALS-" (symbol-name name)) name))
       (fix   (getarg! :fix   (intern-in-package-of-symbol (cat (symbol-name name) "-FIX") name) kwd-alist))
       (equiv (getarg! :equiv (intern-in-package-of-symbol (cat (symbol-name name) "-EQUIV") name) kwd-alist))
       (count (flextype-get-count-fn name kwd-alist))
       (xvar (or (getarg :xvar xvar kwd-alist)
                 (car (find-symbols-named-x (getarg :measure nil kwd-alist)))
                 (intern-in-package-of-symbol "X" name)))
       (measure (getarg! :measure `(acl2-count ,xvar) kwd-alist))
       (already-defined
        (check-flexset-already-defined pred kwd-alist our-fixtypes 'deftreemap state))
       (fix-already-defined
        (check-flexset-fix-already-defined fix kwd-alist our-fixtypes 'deftreemap state))
       (x1 (make-flextreemap :name name
                             :pred pred
                             :tree-all-keys tree-all-keys
                             :tree-all-vals tree-all-vals
                             :fix fix
                             :equiv equiv
                             :count count
                             :key-type key-type
                             :key-fix key-fix
                             :key-equiv key-equiv
                             :val-type val-type
                             :val-fix val-fix
                             :val-equiv val-equiv
                             :measure measure
                             :kwd-alist (if post-///
                                            (cons (cons :///-events post-///)
                                                  kwd-alist)
                                          kwd-alist)
                             :xvar xvar
                             :recp (or key-recp val-recp)
                             :already-definedp already-defined
                             :fix-already-definedp fix-already-defined))
       (kwd-alist
        (list* (cons :post-pred-events
                     (append (flextreemap-post-pred-events x1)
                             (flextreemap-suite-events x1)))
               (cons :post-acc-events
                     (and count
                          '((local
                             (in-theory
                              (enable treemap::tree-empty-p-compound-recognizer
                                      treemap::treep-compound-recognizer
                                      treemap::treep-when-not-tree-empty-p-forward-chaining
                                      treemap::acl2-count-when-not-tree-empty-p-cheap
                                      treemap::tree-empty-p-when-treep-cheap
                                      treemap::fix-when-mapp
                                      treemap::tree-element-p-of-tree->head
                                      treemap::acl2-count-of-tree-element->key-linear
                                      treemap::acl2-count-of-tree-element->val-linear
                                      treemap::mapp-type-prescription
                                      treemap::tree->head-type-prescription
                                      treemap::emptyp$inline))))))
               (flextreemap->kwd-alist x1))))
    (change-flextreemap x1 :kwd-alist kwd-alist)))
