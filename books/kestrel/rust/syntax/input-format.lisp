; UTF-8.

; The decoder and the encoder of [books]/unicode
; have their own recognizers of scalar values and of bytes;
; these rules relate them to ours.

(defruledl uchar?-is-uni-scalar-value-p
  (equal (acl2::uchar? x)
         (uni-scalar-value-p x))
  :enable (acl2::uchar? uni-scalar-value-p))

(defruledl ustring?-is-uni-scalar-value-listp
  (equal (acl2::ustring? x)
         (uni-scalar-value-listp x))
  :induct t
  :enable (acl2::ustring?
           uni-scalar-value-listp
           uchar?-is-uni-scalar-value-p))

(defruledl unsigned-byte-listp-8-is-byte-listp
  (equal (acl2::unsigned-byte-listp 8 x)
         (byte-listp x))
  :induct t
  :enable (acl2::unsigned-byte-listp byte-listp bytep))

(local (in-theory (disable acl2::ustring?)))

(defruledl utf8-partition-when-utf8=>ustring-not-fail
  (implies (not (equal (acl2::utf8=>ustring bytes) 'acl2::fail))
           (mv-nth 0 (acl2::utf8-partition bytes)))
  :enable acl2::utf8=>ustring)

(defruledl uni-scalar-value-listp-of-utf8=>ustring
  (implies (not (equal (acl2::utf8=>ustring bytes) 'acl2::fail))
           (uni-scalar-value-listp (acl2::utf8=>ustring bytes)))
  :enable (utf8-partition-when-utf8=>ustring-not-fail
           ustring?-is-uni-scalar-value-listp)
  :disable acl2::ustring?-of-utf8=>ustring-when-utf8-partition
  :use (:instance acl2::ustring?-of-utf8=>ustring-when-utf8-partition
                  (acl2::x bytes)))

(defruledl byte-listp-of-ustring=>utf8
  (implies (uni-scalar-value-listp text)
           (byte-listp (acl2::ustring=>utf8 text)))
  :induct t
  :enable (acl2::ustring=>utf8
           uni-scalar-value-listp
           uchar?-is-uni-scalar-value-p)
  :prep-lemmas
  ((defrule lemma
     (implies (acl2::uchar? x)
              (byte-listp (acl2::uchar=>utf8 x)))
     :use (:instance acl2::unsigned-byte-list-of-uchar=>utf8-when-uchar?
                     (acl2::x x))
     :disable acl2::unsigned-byte-list-of-uchar=>utf8-when-uchar?
     :enable unsigned-byte-listp-8-is-byte-listp)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define utf-8-bytes-to-code-points ((bytes byte-listp))
  :returns (text acl2::nat-list-resultp)
  :short "Decode UTF-8 bytes into code points."
  :long
  (xdoc::topstring
   (xdoc::p
    "It is an error if the bytes are not valid UTF-8
     [Reference: Input format: Source encoding].
     rustc reports that the file
     @('did not contain valid UTF-8').")
   (xdoc::p
    "We use the verified decoder of @(see acl2::unicode).
     It accepts the well-formed byte sequences
     of the Unicode Standard (Table 3-7) and no others:
     it rejects, for example,
     a code point encoded with more bytes than needed,
     the encoding of a surrogate,
     and bytes that end in the middle of an encoding.
     So the code points that it returns are Unicode scalar values."))
  (b* ((bytes (byte-list-fix bytes))
       (text (acl2::utf8=>ustring bytes))
       ((when (equal text 'acl2::fail)) (reserrf (list :invalid-utf-8))))
    text)
  :guard-hints
  (("Goal" :in-theory (enable unsigned-byte-listp-8-is-byte-listp)))
  :prepwork
  ((local (in-theory (enable uni-scalar-value-listp-of-utf8=>ustring))))

  ///

  (defret uni-scalar-value-listp-of-utf-8-bytes-to-code-points
    (implies (not (reserrp text))
             (uni-scalar-value-listp text))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define code-points-to-utf-8-bytes ((text nat-listp))
  :returns (bytes byte-list-resultp)
  :short "Encode code points into UTF-8 bytes."
  :long
  (xdoc::topstring
   (xdoc::p
    "It is an error if a code point is not a Unicode scalar value:
     only those have an encoding in UTF-8.")
   (xdoc::p
    "We use the verified encoder of @(see acl2::unicode).
     Encoding inverts decoding:
     see @(tsee code-points-to-utf-8-bytes-of-utf-8-bytes-to-code-points)."))
  (b* ((text (nat-list-fix text))
       ((unless (uni-scalar-value-listp text))
        (reserrf (list :not-scalar-values))))
    (acl2::ustring=>utf8 text))
  :guard-hints (("Goal" :in-theory (enable ustring?-is-uni-scalar-value-listp)))
  :prepwork ((local (in-theory (enable byte-listp-of-ustring=>utf8)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defrule code-points-to-utf-8-bytes-of-utf-8-bytes-to-code-points
  :short "Encoding in UTF-8 inverts decoding."
  (b* ((text (utf-8-bytes-to-code-points bytes)))
    (implies (not (reserrp text))
             (equal (code-points-to-utf-8-bytes text)
                    (byte-list-fix bytes))))
  :enable (utf-8-bytes-to-code-points
           code-points-to-utf-8-bytes
           utf8-partition-when-utf8=>ustring-not-fail
           uni-scalar-value-listp-of-utf8=>ustring))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Byte order mark.

(define remove-byte-order-mark ((text nat-listp))
  :returns (mv (new-text nat-listp)
               (bom booleanp))
  :short "Remove the byte order mark that a text may start with."
  :long
  (xdoc::topstring
   (xdoc::p
    "If the first code point is U+FEFF, it is removed
     [Reference: Input format: Byte order mark removal].
     We also return whether there was one.")
   (xdoc::p
    "Only one is removed, and only at the start:
     any other U+FEFF stays in the text,
     where it is neither whitespace nor part of a token,
     except inside a comment or a literal."))
  (b* ((text (nat-list-fix text)))
    (if (and (consp text)
             (eql (car text) #xfeff))
        (mv (cdr text) t)
      (mv text nil)))

  ///

  (defret uni-scalar-value-listp-of-remove-byte-order-mark
    (implies (uni-scalar-value-listp text)
             (uni-scalar-value-listp new-text))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define restore-byte-order-mark ((text nat-listp) (bom booleanp))
  :returns (old-text nat-listp)
  :short "Put back the byte order mark that was removed from a text, if any."
  (if bom
      (cons #xfeff (nat-list-fix text))
    (nat-list-fix text))

  ///

  (defrule restore-byte-order-mark-of-remove-byte-order-mark
    (b* (((mv new-text bom) (remove-byte-order-mark text)))
      (equal (restore-byte-order-mark new-text bom)
             (nat-list-fix text)))
    :enable remove-byte-order-mark))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; CRLF.

(define normalize-crlf-from ((text nat-listp) (pos natp))
  :returns (mv (new-text nat-listp)
               (crs nat-listp))
  :short "Replace each carriage return immediately followed by a line feed
          with the line feed alone,
          in a text that starts at a given position."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the loop of @(tsee normalize-crlf).
     The position is that of the first code point of @('text')
     in the text that is being produced;
     it is 0 at the start, and it is used for the positions
     of the line feeds that had a carriage return before them,
     which are returned along with the new text."))
  (b* ((text (nat-list-fix text))
       (pos (lnfix pos))
       ((when (endp text)) (mv nil nil))
       ((when (and (eql (car text) #xd)
                   (consp (cdr text))
                   (eql (cadr text) #xa)))
        (b* (((mv new-text crs) (normalize-crlf-from (cddr text) (1+ pos))))
          (mv (cons #xa new-text) (cons pos crs))))
       ((mv new-text crs) (normalize-crlf-from (cdr text) (1+ pos))))
    (mv (cons (car text) new-text) crs))
  :measure (len text)
  :verify-guards :after-returns

  ///

  (defret len-of-normalize-crlf-from.new-text
    (<= (len new-text) (len text))
    :rule-classes :linear
    :hints (("Goal" :induct t)))

  (defret uni-scalar-value-listp-of-normalize-crlf-from
    (implies (uni-scalar-value-listp text)
             (uni-scalar-value-listp new-text))
    :hints (("Goal" :induct t)))

  (defret car-of-normalize-crlf-from.crs-lower-bound
    (implies (consp crs)
             (<= (nfix pos) (car crs)))
    :rule-classes :linear
    :hints (("Goal" :induct t))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define normalize-crlf-exec ((text nat-listp)
                             (pos natp)
                             (rev-text true-listp)
                             (rev-crs true-listp))
  :returns (mv new-text crs)
  :short "Tail-recursive form of @(tsee normalize-crlf-from)."
  :long
  (xdoc::topstring
   (xdoc::p
    "The new text and the positions are accumulated in reverse,
     so that a long text does not exhaust the stack.
     This function is used only for execution:
     see the theorem that relates it to @(tsee normalize-crlf-from)."))
  (b* ((text (nat-list-fix text))
       (pos (lnfix pos))
       ((when (endp text))
        (mv (revappend rev-text nil) (revappend rev-crs nil)))
       ((when (and (eql (car text) #xd)
                   (consp (cdr text))
                   (eql (cadr text) #xa)))
        (normalize-crlf-exec (cddr text)
                             (1+ pos)
                             (cons #xa rev-text)
                             (cons pos rev-crs))))
    (normalize-crlf-exec (cdr text)
                         (1+ pos)
                         (cons (car text) rev-text)
                         rev-crs))
  :measure (len text)
  ; The fix congruences follow from the theorem below.
  :hooks nil

  ///

  (defruled normalize-crlf-exec-is-normalize-crlf-from
    (equal (normalize-crlf-exec text pos rev-text rev-crs)
           (b* (((mv new-text crs) (normalize-crlf-from text pos)))
             (mv (revappend rev-text new-text)
                 (revappend rev-crs crs))))
    :induct t
    :enable (normalize-crlf-from revappend))

  (fty::deffixequiv normalize-crlf-exec
    :hints (("Goal"
             :in-theory (enable normalize-crlf-exec-is-normalize-crlf-from)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define normalize-crlf ((text nat-listp))
  :returns (mv (new-text nat-listp)
               (crs nat-listp))
  :short "Replace each carriage return immediately followed by a line feed
          with the line feed alone."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the CRLF normalization of
     [Reference: Input format: CRLF normalization].
     We also return the positions, in the new text and in increasing order,
     of the line feeds that had a carriage return before them,
     so that the text can be reproduced (see @(tsee restore-crlf)).")
   (xdoc::p
    "The text is gone through once, from the start:
     in a carriage return followed by
     a carriage return and a line feed,
     the second carriage return is removed and the first one stays,
     now immediately followed by a line feed.
     So the new text can still have
     a carriage return immediately followed by a line feed.
     A carriage return that stays is whitespace for the lexer,
     except in a doc comment or a literal, where it is an error
     (see [SC3] in @(see grammar)).")
   (xdoc::p
    "This function is executed with a loop
     that does not use stack space in proportion to the text
     (see @(tsee normalize-crlf-exec))."))
  (mbe :logic (normalize-crlf-from text 0)
       :exec (normalize-crlf-exec text 0 nil nil))
  :guard-hints (("Goal"
                 :in-theory (enable normalize-crlf-exec-is-normalize-crlf-from)
                 :expand (normalize-crlf-from text 0)))

  ///

  (defret len-of-normalize-crlf.new-text
    (<= (len new-text) (len text))
    :rule-classes :linear)

  (defret uni-scalar-value-listp-of-normalize-crlf
    (implies (uni-scalar-value-listp text)
             (uni-scalar-value-listp new-text))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define restore-crlf-from ((text nat-listp) (crs nat-listp) (pos natp))
  :returns (old-text nat-listp)
  :short "Put back the carriage returns that were removed from a text
          that starts at a given position."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the loop of @(tsee restore-crlf).
     A carriage return is put before
     each code point whose position is in @('crs'),
     which is in increasing order."))
  (b* ((text (nat-list-fix text))
       (crs (nat-list-fix crs))
       (pos (lnfix pos))
       ((when (endp text)) nil)
       ((when (and (consp crs)
                   (eql (car crs) pos)))
        (list* #xd
               (car text)
               (restore-crlf-from (cdr text) (cdr crs) (1+ pos)))))
    (cons (car text)
          (restore-crlf-from (cdr text) crs (1+ pos))))
  :measure (len text)
  :verify-guards :after-returns
  :prepwork
  ((defrulel nat-list-fix-when-not-consp
     (implies (not (consp x))
              (equal (nat-list-fix x) nil))
     :enable nat-list-fix))

  ///

  (defrule restore-crlf-from-when-not-consp-of-crs
    (implies (not (consp crs))
             (equal (restore-crlf-from text crs pos)
                    (nat-list-fix text)))
    :induct t)

  (defrule restore-crlf-from-of-normalize-crlf-from
    (b* (((mv new-text crs) (normalize-crlf-from text pos)))
      (equal (restore-crlf-from new-text crs pos)
             (nat-list-fix text)))
    :induct (normalize-crlf-from text pos)
    :enable normalize-crlf-from))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define restore-crlf ((text nat-listp) (crs nat-listp))
  :returns (old-text nat-listp)
  :short "Put back the carriage returns that were removed from a text."
  :long
  (xdoc::topstring
   (xdoc::p
    "This inverts @(tsee normalize-crlf):
     given the new text and the positions that it returns,
     we obtain the text that it was applied to."))
  (restore-crlf-from text crs 0)

  ///

  (defrule restore-crlf-of-normalize-crlf
    (b* (((mv new-text crs) (normalize-crlf text)))
      (equal (restore-crlf new-text crs)
             (nat-list-fix text)))
    :enable normalize-crlf))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Source texts.

(define source-text-from-bytes ((bytes byte-listp))
  :returns (stext source-text-resultp)
  :short "Turn the bytes of a source file into a source text."
  :long
  (xdoc::topstring
   (xdoc::p
    "The bytes are decoded as UTF-8,
     the byte order mark is removed if there is one,
     and the CRLF normalization is applied, in this order.
     It is an error if the bytes are not valid UTF-8.")
   (xdoc::p
    "The code points of the text are Unicode scalar values."))
  (b* (((fty::okf text) (utf-8-bytes-to-code-points bytes))
       ((mv text bom) (remove-byte-order-mark text))
       ((mv text crs) (normalize-crlf text)))
    (make-source-text :text text :bom bom :crs crs))

  ///

  (defret uni-scalar-value-listp-of-source-text-from-bytes
    (implies (not (reserrp stext))
             (uni-scalar-value-listp (source-text->text stext)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define source-text-to-bytes ((stext source-textp))
  :returns (bytes byte-list-resultp)
  :short "Turn a source text back into the bytes of the source file."
  :long
  (xdoc::topstring
   (xdoc::p
    "The carriage returns and the byte order mark that were removed
     are put back, and the result is encoded in UTF-8.
     It is an error if a code point of the text
     is not a Unicode scalar value;
     this does not happen for a source text
     obtained from the bytes of a file.")
   (xdoc::p
    "This inverts @(tsee source-text-from-bytes):
     a source text determines the bytes of the file that it came from.
     So nothing of the file is lost in its source text."))
  (b* (((source-text stext))
       (text (restore-crlf stext.text stext.crs))
       (text (restore-byte-order-mark text stext.bom)))
    (code-points-to-utf-8-bytes text))

  ///

  (defrule source-text-to-bytes-of-source-text-from-bytes
    (b* ((stext (source-text-from-bytes bytes)))
      (implies (not (reserrp stext))
               (equal (source-text-to-bytes stext)
                      (byte-list-fix bytes))))
    :enable source-text-from-bytes))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define source-text-from-file ((path stringp) state)
  :returns (mv (stext source-text-resultp) state)
  :short "Read a source file into a source text."
  :long
  (xdoc::topstring
   (xdoc::p
    "It is an error if the file cannot be read,
     or if its content is not valid UTF-8.
     A relative path is relative to
     the connected book directory (see @(tsee cbd))."))
  (b* ((path (str-fix path))
       ((mv erp bytes state) (acl2::read-file-into-byte-list path state))
       ((when erp) (mv (reserrf (list :cannot-read-file path)) state)))
    (mv (source-text-from-bytes bytes) state)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Shebang.

(define bracket-after-trivia-p ((text nat-listp))
  :returns (yes/no booleanp)
  :short "Check if a text starts with an opening square bracket,
          possibly after whitespace and comments
          that are not doc comments."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the condition under which
     a @('#!') at the start of a source text
     does not start a shebang (see @(tsee shebang-length)).")
   (xdoc::p
    "We skip whitespace and comments with the lexer's functions.
     If a comment does not lex, the answer is no:
     either it is a block comment that is not closed,
     so that nothing follows it,
     or it is a doc comment with a carriage return [SC3].
     A doc comment is not skipped, so the answer is no for it as well.
     An opening square bracket is a token by itself
     whatever follows it,
     so we look for it without lexing a token."))
  (b* (((mv tree rest) (lex-whitespace text))
       ((unless (reserrp tree)) (bracket-after-trivia-p rest))
       (text (nat-list-fix text))
       ((when (or (prefixp (list #x2f #x2f) text) ; //
                  (prefixp (list #x2f #x2a) text))) ; /*
        (b* (((mv tree rest) (lex-comment text))
             ((when (reserrp tree)) nil)
             (lexeme (abs-comment tree))
             ((when (reserrp lexeme)) nil)
             ((unless (lexeme-case lexeme :comment)) nil))
          (bracket-after-trivia-p rest))))
    (and (consp text)
         (eql (car text) #x5b))) ; [
  :measure (len text)
  :guard-hints (("Goal" :in-theory (enable lexemep-when-result-not-error
                                           abnf::treep-when-result-not-error))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define first-line-length ((text nat-listp))
  :returns (length natp)
  :short "Number of code points of a text before its first line ending."
  :long
  (xdoc::topstring
   (xdoc::p
    "A line ending is a line feed,
     or a carriage return immediately followed by a line feed.
     If the text has no line ending, the result is its length."))
  (b* ((text (nat-list-fix text))
       ((when (endp text)) 0)
       ((when (eql (car text) #xa)) 0)
       ((when (and (eql (car text) #xd)
                   (consp (cdr text))
                   (eql (cadr text) #xa)))
        0))
    (1+ (first-line-length (cdr text))))
  :measure (len text)

  ///

  (defret first-line-length-upper-bound
    (<= length (len text))
    :rule-classes :linear
    :hints (("Goal" :induct t)))

  (defret no-line-feed-in-first-line
    (not (member-equal #xa (take length (nat-list-fix text))))
    :hints (("Goal"
             :induct t
             :in-theory (enable take fix)
             :expand (take (+ 1 (first-line-length (cdr (nat-list-fix text))))
                           (nat-list-fix text))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define shebang-length ((text nat-listp))
  :returns (length natp)
  :short "Length of the shebang that a source text starts with,
          or 0 if it does not start with one."
  :long
  (xdoc::topstring
   (xdoc::p
    "A shebang is a first line like @('#!/usr/bin/env rustx'),
     which lets an operating system run the file as a script.
     A source text starts with a shebang if it starts with @('#!'),
     unless what follows the @('#!') starts with
     an opening square bracket,
     possibly after whitespace and comments that are not doc comments:
     in that case the @('#!') starts an inner attribute,
     as in @('#![allow(unused)]').
     The whitespace and the comments can extend over several lines.")
   (xdoc::p
    "The shebang goes from the @('#!') to the first line ending,
     which is not part of it,
     or to the end of the text if there is no line ending.
     So a shebang has at least two code points and no line feed.
     This is the length that the function @('strip_shebang')
     of rustc's lexer returns,
     in code points where rustc counts bytes.")
   (xdoc::p
    "The lexer does not read the shebang: it starts after it.
     The shebang stays in the source text,
     and positions count from the start of the source text."))
  (b* ((text (nat-list-fix text))
       ((unless (prefixp (list #x23 #x21) text)) 0) ; #!
       ((when (bracket-after-trivia-p (cddr text))) 0))
    (first-line-length text))

  ///

  (defret shebang-length-upper-bound
    (<= length (len text))
    :rule-classes :linear)

  (defret shebang-length-lower-bound
    (implies (not (equal length 0))
             (<= 2 length))
    :rule-classes :linear
    :hints (("Goal" :expand ((first-line-length text)
                             (first-line-length (cdr text))))))

  (defret no-line-feed-in-shebang
    (not (member-equal #xa (take length (nat-list-fix text))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Entry points.

(define tokenize-source-text ((stext source-textp)
                              (edition rust::editionp)
                              (file stringp))
  :returns (tokens token+span-list-resultp)
  :short "Lex and tokenize a source text."
  :long
  (xdoc::topstring
   (xdoc::p
    "If the text starts with a shebang, lexing starts after it.
     The spans of the tokens are positions in the source text:
     after a shebang, the next position is
     in the first line, at the column that is the shebang's length.")
   (xdoc::p
    "The file name is used only in the positions of the spans."))
  (b* ((text (source-text->text stext))
       (shebang (shebang-length text))
       (trees (lexemize-rust (nthcdr shebang text)))
       ((when (reserrp trees)) (reserrf-push trees))
       (pos (position-init file))
       (pos (if (zp shebang)
                pos
              (position-inc-column shebang pos))))
    (tokenize-lexeme-csts trees pos edition))
  :guard-hints
  (("Goal" :in-theory (enable abnf::tree-listp-when-result-not-error))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define tokenize-rust-from-bytes ((bytes byte-listp)
                                 (edition rust::editionp)
                                 (file stringp))
  :returns (tokens token+span-list-resultp)
  :short "Lex and tokenize the bytes of a source file."
  :long
  (xdoc::topstring
   (xdoc::p
    "The file name is used only in the positions of the spans."))
  (b* ((stext (source-text-from-bytes bytes))
       ((when (reserrp stext)) (reserrf-push stext)))
    (tokenize-source-text stext edition file)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define tokenize-rust-from-file ((path stringp)
                                (edition rust::editionp)
                                state)
  :returns (mv (tokens token+span-list-resultp) state)
  :short "Lex and tokenize a source file."
  :long
  (xdoc::topstring
   (xdoc::p
    "The path is also the file name in the positions of the spans."))
  (b* (((mv stext state) (source-text-from-file path state))
       ((when (reserrp stext)) (mv (reserrf-push stext) state)))
    (mv (tokenize-source-text stext edition path) state)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define build-token-trees-from-bytes ((bytes byte-listp)
                                     (edition rust::editionp)
                                     (file stringp))
  :returns (trees token-tree-list-resultp)
  :short "Lex and tokenize the bytes of a source file,
          and build token trees."
  (b* ((tokens (tokenize-rust-from-bytes bytes edition file))
       ((when (reserrp tokens)) (reserrf-push tokens)))
    (build-token-trees tokens))
  :guard-hints
  (("Goal" :in-theory (enable token+span-listp-when-result-not-error))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define build-token-trees-from-file ((path stringp)
                                    (edition rust::editionp)
                                    state)
  :returns (mv (trees token-tree-list-resultp) state)
  :short "Lex and tokenize a source file, and build token trees."
  (b* (((mv tokens state) (tokenize-rust-from-file path edition state))
       ((when (reserrp tokens)) (mv (reserrf-push tokens) state)))
    (mv (build-token-trees tokens) state))
  :guard-hints
  (("Goal" :in-theory (enable token+span-listp-when-result-not-error))))
