; Result fixtypes for the types produced by the builder.
; These come before the controlled configuration below
; because the proofs generated by fty::defresult
; rely on the default theory.

(fty::defresult token-tree-result
  :parents (token-tree-builder)
  :short "Fixtype of errors and token trees."
  :ok token-tree
  :pred token-tree-resultp
  :prepwork ((local (in-theory (enable token-tree-kind)))))

(fty::defresult token-tree-list-result
  :parents (token-tree-builder)
  :short "Fixtype of errors and lists of token trees."
  :ok token-tree-list
  :pred token-tree-list-resultp)

; See lexer.lisp for why :no-function nil (fty::reserrf uses __function__).
(acl2::controlled-configuration :no-function nil)

; These rules bridge the fty::defresult idiom to the underlying types,
; as in lexer.lisp and tokenizer.lisp.
(local (in-theory (enable token-treep-when-result-not-error
                          token-tree-listp-when-result-not-error)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defxdoc+ token-tree-builder
  :parents (syntax-for-tools)
  :short "Rust token-tree builder: from tokens to token trees."
  :long
  (xdoc::topstring
   (xdoc::p
    "The tokenizer (see @(see tokenizer)) produces
     a list of tokens with spans,
     in which the delimiters @('( )'), @('[ ]'), and @('{ }')
     are tokens like the others.
     The builder matches the delimiters and groups the tokens
     into token trees (see @(see token-trees)),
     according to the grammar
     ["
    (xdoc::ahref "https://doc.rust-lang.org/1.87.0/reference/macros.html"
                 "Reference: Macros")
    "]:")
   (xdoc::codeblock
    "TokenTree : Token_except_delimiters | DelimTokenTree"
    "DelimTokenTree : ( TokenTree* ) | [ TokenTree* ] | { TokenTree* }")
   (xdoc::p
    "Building fails in three cases,
     which are the three errors that rustc reports
     when it builds token trees:")
   (xdoc::ul
    (xdoc::li
     "A closing delimiter of one kind where
      the group that is open needs one of another kind,
      as in @('( ]')
      (rustc: @('mismatched closing delimiter')).")
    (xdoc::li
     "An opening delimiter whose group is still open
      at the end of the tokens,
      as in @('( a')
      (rustc: @('this file contains an unclosed delimiter')).")
    (xdoc::li
     "A closing delimiter when no group is open,
      as in @('a )')
      (rustc: @('unexpected closing delimiter'))."))
   (xdoc::p
    "rustc builds token trees from the whole file
     before parsing and before macro expansion,
     so these are errors wherever they occur,
     including in the arguments of a macro invocation
     and in code that conditional compilation removes.
     After a closing delimiter of the wrong kind
     rustc goes on, to report further errors;
     the builder stops at the first error.
     The builder does not depend on the edition.")
   (xdoc::p
    "The builder changes no token and drops none:
     flattening the trees that it returns gives back the tokens
     (see @(tsee token-tree-list->tokens)),
     and those trees are well-formed
     (see @(tsee token-tree-list-wfp)).
     Conversely, the well-formed trees that flatten to given tokens
     are unique, and the builder finds them:
     it fails only when there are none.
     So the builder is specified by flattening and well-formedness:
     its result is the list of well-formed token trees
     whose flattening is the list of tokens,
     if there is one.")
   (xdoc::p
    "A token is a leaf as the tokenizer made it.
     In particular, a punctuation token of several characters
     such as @('>>') is one leaf:
     where the syntax needs it as two tokens,
     as when it closes two lists of generic arguments,
     the parser splits it.
     A doc comment is one leaf too;
     rustc shows it to a macro as the tokens of a @('doc') attribute,
     which is for macro expansion to do.")
   (xdoc::p
    "The builder is tested against rustc, as the lexer is
     (see @(see differential-testing)):
     on which tokens it rejects, on the kind of the error,
     and on how it groups the tokens."))
  :order-subtopics t
  :default-parent t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define token-trees-end-p ((tokens token+span-listp))
  :returns (yes/no booleanp)
  :short "Check if a sequence of token trees ends
          at the start of a list of tokens."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the case when there are no tokens,
     or when the first one is a closing delimiter.
     Any other token starts a token tree."))
  (or (not (consp tokens))
      (token-case (token+span->token (car tokens)) :close-delim))

  ///

  (defrule token-trees-end-p-of-cons
    (equal (token-trees-end-p (cons token tokens))
           (equal (token-kind (token+span->token token)) :close-delim))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defines build-token-tree-fns
  :short "Functions that build token trees from the start of a list of tokens."
  :long
  (xdoc::topstring
   (xdoc::p
    "There is one function for each of
     @('TokenTree') and @('TokenTree*') in the grammar
     (see @(see token-tree-builder)).
     Each takes a list of tokens,
     and returns what it built from the start of the list, or an error,
     along with the remaining tokens.
     They are mutually recursive:
     a delimited group contains a sequence of token trees.")
   (xdoc::p
    "A sequence of token trees ends at the end of the tokens
     or before a closing delimiter
     (see @(tsee token-trees-end-p)),
     which is left among the remaining tokens:
     it closes the group that the sequence is in,
     and the caller checks it.")
   (xdoc::p
    "An error from a nested call is returned as it is,
     without adding to it a record of the calls that it passes through:
     the error holds the delimiter tokens at fault, with their spans,
     which is what a message needs,
     and the calls are as many as the tokens before the error.")
   (xdoc::p
    "The termination measure pairs the number of tokens with
     a rank that orders the functions at equal numbers of tokens;
     the sequence function recurs only when
     the tree that it built consumed some token,
     which the @(tsee mbt) test makes available
     to the termination proof.
     Guard verification is deferred until
     the length theorems are available."))
  :verify-guards nil

  (define build-token-tree ((tokens token+span-listp))
    :returns (mv (tree token-tree-resultp)
                 (rest-tokens token+span-listp))
    :parents (token-tree-builder build-token-tree-fns)
    :short "Build one token tree from the start of a list of tokens."
    :long
    (xdoc::topstring
     (xdoc::p
      "A token that is not a delimiter is a leaf.
       An opening delimiter starts a delimited group:
       we build the sequence of token trees after it,
       and the next token must be the closing delimiter of the same kind.
       It is an error if there is no token,
       or if the first token is a closing delimiter."))
    :measure (two-nats-measure (len tokens) 0)
    (b* ((tokens (token+span-list-fix tokens))
         ((unless (consp tokens))
          (mv (reserrf (list :no-token)) tokens))
         (head (car tokens))
         (token (token+span->token head))
         ((when (token-case token :close-delim))
          (mv (reserrf (list :unexpected-closing-delimiter head)) tokens))
         ((unless (token-case token :open-delim))
          (mv (token-tree-leaf head) (cdr tokens)))
         (delim (token-open-delim->delim token))
         ((mv trees tokens1) (build-*-token-tree (cdr tokens)))
         ((when (reserrp trees)) (mv trees tokens))
         ((unless (consp tokens1))
          (mv (reserrf (list :unclosed-delimiter head)) tokens))
         (close (car tokens1))
         ((unless (equal (token+span->token close) (token-close-delim delim)))
          (mv (reserrf (list :mismatched-closing-delimiter head close))
              tokens)))
      (mv (make-token-tree-delimited :delim delim
                                     :open-span (token+span->span head)
                                     :trees trees
                                     :close-span (token+span->span close))
          (cdr tokens1))))

  (define build-*-token-tree ((tokens token+span-listp))
    :returns (mv (trees token-tree-list-resultp)
                 (rest-tokens token+span-listp))
    :parents (token-tree-builder build-token-tree-fns)
    :short "Build a sequence of token trees
            from the start of a list of tokens."
    :long
    (xdoc::topstring
     (xdoc::p
      "The sequence ends at the end of the tokens
       or before a closing delimiter."))
    :measure (two-nats-measure (len tokens) 1)
    (b* ((tokens (token+span-list-fix tokens))
         ((when (token-trees-end-p tokens)) (mv nil tokens))
         ((mv tree tokens1) (build-token-tree tokens))
         ((when (reserrp tree)) (mv tree tokens))
         ((unless (mbt (< (len tokens1) (len tokens))))
          (mv (reserrf (list :impossible)) tokens))
         ((mv trees tokens2) (build-*-token-tree tokens1))
         ((when (reserrp trees)) (mv trees tokens)))
      (mv (cons tree trees) tokens2)))

  ///

  (fty::deffixequiv-mutual build-token-tree-fns)

  (std::defret-mutual len-of-build-token-tree-fns-<=
    (defret len-of-build-token-tree-<=
      (<= (len rest-tokens) (len tokens))
      :rule-classes :linear
      :fn build-token-tree)
    (defret len-of-build-*-token-tree-<=
      (<= (len rest-tokens) (len tokens))
      :rule-classes :linear
      :fn build-*-token-tree)
    :hints (("Goal" :expand ((build-token-tree tokens)
                             (build-*-token-tree tokens)))))

  (defret len-of-build-token-tree-<
    (implies (not (reserrp tree))
             (< (len rest-tokens) (len tokens)))
    :rule-classes :linear
    :fn build-token-tree
    :hints (("Goal" :expand (build-token-tree tokens))))

  (verify-guards build-token-tree)

  (std::defret-mutual tokens-decomposition-of-build-token-tree-fns
    (defret tokens-decomposition-of-build-token-tree
      (implies (not (reserrp tree))
               (equal (append (token-tree->tokens tree) rest-tokens)
                      (token+span-list-fix tokens)))
      :fn build-token-tree)
    (defret tokens-decomposition-of-build-*-token-tree
      (implies (not (reserrp trees))
               (equal (append (token-tree-list->tokens trees) rest-tokens)
                      (token+span-list-fix tokens)))
      :fn build-*-token-tree)
    :hints (("Goal"
             :expand ((build-token-tree tokens)
                      (build-*-token-tree tokens))
             :in-theory (enable token-tree->tokens
                                token-tree-list->tokens))))

  (std::defret-mutual wfp-of-build-token-tree-fns
    (defret token-tree-wfp-of-build-token-tree
      (implies (not (reserrp tree))
               (token-tree-wfp tree))
      :fn build-token-tree)
    (defret token-tree-list-wfp-of-build-*-token-tree
      (implies (not (reserrp trees))
               (token-tree-list-wfp trees))
      :fn build-*-token-tree)
    :hints (("Goal"
             :expand ((build-token-tree tokens)
                      (build-*-token-tree tokens))
             :in-theory (enable token-tree-wfp
                                token-tree-list-wfp))))

  (std::defret-mutual rest-tokens-of-build-token-tree-fns
    (defret rest-tokens-of-build-token-tree-trivial
      t
      :rule-classes nil
      :fn build-token-tree)
    (defret token-trees-end-p-of-build-*-token-tree
      (implies (not (reserrp trees))
               (token-trees-end-p rest-tokens))
      :fn build-*-token-tree)
    :hints (("Goal" :expand (build-*-token-tree tokens))))

  (defret build-*-token-tree-when-token-trees-end-p
    (implies (token-trees-end-p tokens)
             (and (equal trees nil)
                  (equal rest-tokens (token+span-list-fix tokens))))
    :fn build-*-token-tree
    :hints (("Goal" :expand (build-*-token-tree tokens)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The tokens of a well-formed token tree start that token tree,
; whatever follows them.

(defrulel not-token-trees-end-p-of-append-of-token-tree->tokens
  (implies (token-tree-wfp tree)
           (not (token-trees-end-p (append (token-tree->tokens tree) tokens))))
  :expand ((token-tree->tokens tree)
           (token-tree-wfp tree)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Induction scheme for the theorems that the building functions
; invert flattening.
; Each function takes a tree, or a list of trees,
; and the tokens that follow their flattening;
; these tokens change in the recursive calls
; as the argument of the building functions does.

(local
 (defines build-token-tree-inverse-induction
   :verify-guards nil
   :flag-local nil

   (define build-token-tree-inverse-induct ((tree token-treep) rest)
     :measure (token-tree-count tree)
     :hooks nil
     (token-tree-case
      tree
      :leaf (list rest)
      :delimited (build-*-token-tree-inverse-induct
                  tree.trees
                  (cons (make-token+span
                         :token (token-close-delim tree.delim)
                         :span tree.close-span)
                        rest))))

   (define build-*-token-tree-inverse-induct ((trees token-tree-listp) rest)
     :measure (token-tree-list-count trees)
     :hooks nil
     (if (endp trees)
         (list rest)
       (list (build-token-tree-inverse-induct
              (car trees)
              (append (token-tree-list->tokens (cdr trees)) rest))
             (build-*-token-tree-inverse-induct (cdr trees) rest))))))

(defsection build-token-tree-fns-invert-flattening
  :parents (build-token-tree-fns)
  :short "The building functions invert flattening,
          on well-formed token trees."
  :long
  (xdoc::topstring
   (xdoc::p
    "From the tokens of a well-formed token tree
     (see @(tsee token-tree->tokens) and @(tsee token-tree-wfp))
     followed by any tokens,
     @(tsee build-token-tree) builds that tree
     and leaves the tokens that follow.
     The same holds of @(tsee build-*-token-tree)
     for a list of well-formed token trees,
     if the sequence ends at the tokens that follow
     (see @(tsee token-trees-end-p))."))

  ; The induction scheme is local, so the two theorems are proved locally;
  ; they are stated again after that, for the book to provide them.

  (local
   (defthm-build-token-tree-inverse-induction-flag
     (defthm build-token-tree-of-append-of-token-tree->tokens
       (implies (token-tree-wfp tree)
                (b* (((mv tree1 rest1)
                      (build-token-tree
                       (append (token-tree->tokens tree) rest))))
                  (and (equal tree1 (token-tree-fix tree))
                       (equal rest1 (token+span-list-fix rest)))))
       :flag build-token-tree-inverse-induct)
     (defthm build-*-token-tree-of-append-of-token-tree-list->tokens
       (implies (and (token-tree-list-wfp trees)
                     (token-trees-end-p rest))
                (b* (((mv trees1 rest1)
                      (build-*-token-tree
                       (append (token-tree-list->tokens trees) rest))))
                  (and (equal trees1 (token-tree-list-fix trees))
                       (equal rest1 (token+span-list-fix rest)))))
       :flag build-*-token-tree-inverse-induct)
     :hints (("Goal"
              :in-theory (enable not-reserrp-when-token-treep
                                 not-reserrp-when-token-tree-listp)
              :expand ((token-tree->tokens tree)
                       (token-tree-list->tokens trees)
                       (token-tree-wfp tree)
                       (token-tree-list-wfp trees)
                       (:free (x y) (build-token-tree (cons x y)))
                       (build-*-token-tree
                        (append (token-tree->tokens (car trees))
                                (append (token-tree-list->tokens (cdr trees))
                                        rest))))))))

  (defthm build-token-tree-of-append-of-token-tree->tokens
    (implies (token-tree-wfp tree)
             (b* (((mv tree1 rest1)
                   (build-token-tree
                    (append (token-tree->tokens tree) rest))))
               (and (equal tree1 (token-tree-fix tree))
                    (equal rest1 (token+span-list-fix rest))))))

  (defthm build-*-token-tree-of-append-of-token-tree-list->tokens
    (implies (and (token-tree-list-wfp trees)
                  (token-trees-end-p rest))
             (b* (((mv trees1 rest1)
                   (build-*-token-tree
                    (append (token-tree-list->tokens trees) rest))))
               (and (equal trees1 (token-tree-list-fix trees))
                    (equal rest1 (token+span-list-fix rest)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; When no tokens remain, appending them changes nothing.

(defrulel append-when-not-consp-arg2-and-token+span-listp
  (implies (and (not (consp y))
                (token+span-listp y)
                (token+span-listp x))
           (equal (append x y) x)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define build-token-trees ((tokens token+span-listp))
  :returns (trees token-tree-list-resultp)
  :short "Build the token trees of a list of tokens."
  :long
  (xdoc::topstring
   (xdoc::p
    "We build a sequence of token trees from the start of the tokens.
     It must take all of them:
     a token that remains is a closing delimiter,
     and no group is open for it to close."))
  (b* (((mv trees rest-tokens) (build-*-token-tree tokens))
       ((when (reserrp trees)) trees)
       ((when (consp rest-tokens))
        (reserrf (list :unexpected-closing-delimiter (car rest-tokens)))))
    trees)

  ///

  (defret token-tree-list->tokens-of-build-token-trees
    (implies (not (reserrp trees))
             (equal (token-tree-list->tokens trees)
                    (token+span-list-fix tokens)))
    :hints (("Goal"
             :use tokens-decomposition-of-build-*-token-tree
             :in-theory (disable tokens-decomposition-of-build-*-token-tree))))

  (defret token-tree-list-wfp-of-build-token-trees
    (implies (not (reserrp trees))
             (token-tree-list-wfp trees)))

  (defrule build-token-trees-of-token-tree-list->tokens
    (implies (token-tree-list-wfp trees)
             (equal (build-token-trees (token-tree-list->tokens trees))
                    (token-tree-list-fix trees)))
    :use (:instance build-*-token-tree-of-append-of-token-tree-list->tokens
                    (rest nil))
    :disable build-*-token-tree-of-append-of-token-tree-list->tokens))

;;;;;;;;;;;;;;;;;;;;

(defrule build-token-trees-when-token-tree-list->tokens
  :parents (build-token-trees)
  :short "The token trees that the builder returns are
          the only well-formed ones that flatten to the tokens."
  :long
  (xdoc::topstring
   (xdoc::p
    "If some well-formed token trees flatten to the tokens,
     the builder returns exactly those.
     So such trees are unique;
     and when the builder returns an error, there are none."))
  (implies (and (token-tree-list-wfp trees)
                (equal (token-tree-list->tokens trees)
                       (token+span-list-fix tokens)))
           (equal (build-token-trees tokens)
                  (token-tree-list-fix trees)))
  :rule-classes nil
  :use build-token-trees-of-token-tree-list->tokens
  :disable build-token-trees-of-token-tree-list->tokens)
