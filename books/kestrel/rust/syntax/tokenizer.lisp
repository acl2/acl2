; Result fixtypes for the types produced by the tokenizer.
; These come before the controlled configuration below
; because the proofs generated by fty::defresult
; rely on the default theory.

(fty::defresult lexeme-result
  :parents (tokenizer)
  :short "Fixtype of errors and lexemes."
  :ok lexeme
  :pred lexeme-resultp
  :prepwork ((local (in-theory (enable lexeme-kind)))))

(fty::defresult token-result
  :parents (tokenizer)
  :short "Fixtype of errors and tokens."
  :ok token
  :pred token-resultp
  :prepwork ((local (in-theory (enable token-kind)))))

(fty::defresult lexeme-list-result
  :parents (tokenizer)
  :short "Fixtype of errors and lists of lexemes."
  :ok lexeme-list
  :pred lexeme-list-resultp)

(fty::defresult token+span-list-result
  :parents (tokenizer)
  :short "Fixtype of errors and lists of tokens with spans."
  :ok token+span-list
  :pred token+span-list-resultp)

; See lexer.lisp for why :no-function nil (fty::reserrf uses __function__).
(acl2::controlled-configuration :no-function nil)

; The results of the abnf::check-tree-... utilities and of our own
; result-returning functions are values of fty::defresult types;
; these (disabled by default) rules bridge "not an error" to the
; value type, as in lexer.lisp.
(local (in-theory (enable acl2::nat-listp-when-result-not-error
                          abnf::treep-when-result-not-error
                          abnf::tree-listp-when-result-not-error
                          abnf::tree-list-listp-when-result-not-error
                          abnf::tree-list-tuple2p-when-result-not-error
                          acl2::stringp-when-result-not-error
                          lexemep-when-result-not-error
                          tokenp-when-result-not-error
                          lexeme-listp-when-result-not-error
                          token+span-listp-when-result-not-error)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defxdoc+ tokenizer
  :parents (syntax-for-tools)
  :short "Rust tokenizer: from lexeme CSTs to tokens with spans."
  :long
  (xdoc::topstring
   (xdoc::p
    "The lexer (see @(see lexer)) produces
     lexeme concrete syntax trees (CSTs).
     The tokenizer abstracts those CSTs to
     the lexeme and token fixtypes (see @(see tokens)),
     computes source spans by threading positions
     through the lexeme texts,
     and filters out the trivia
     (whitespace and non-doc comments),
     yielding the token-with-span list
     that feeds token-tree construction and parsing.")
   (xdoc::p
    "The CST abstraction functions follow the style of
     the Remora and Leo CST-to-AST abstractors:
     they are total functions on trees
     that use the @('abnf::check-tree-...') utilities
     to destructure the CSTs,
     returning errors (never expected on lexer output)
     if the trees do not have the expected shapes.")
   (xdoc::p
    "Tokenization is where the edition matters [SC6]:
     an @('identifier-or-keyword') lexeme becomes
     a keyword token or an identifier token
     according to the edition's keyword tables
     (see @(see keywords)).
     Tokenization also enforces [SC5]:
     a raw identifier must not be
     @('crate'), @('self'), @('super'), or @('Self').")
   (xdoc::p
    "Since Rust source is Unicode,
     the text stored in lexeme and token fixtype values
     (whitespace and comment content, identifier names, etc.)
     is the UTF-8 encoding of the source code points,
     as an ACL2 string of (8-bit) characters;
     for ASCII text this is the text itself.
     Positions count code points, not bytes:
     a line feed moves to the next line,
     and every other code point advances the column by one."))
  :order-subtopics t
  :default-parent t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; UTF-8 encoding of code points into ACL2 strings.

(define unicode-code-points-p ((nats nat-listp))
  :returns (yes/no booleanp)
  :short "Check if all the naturals in a list are Unicode code points."
  (b* ((nats (nat-list-fix nats)))
    (or (endp nats)
        (and (<= (car nats) #x10ffff)
             (unicode-code-points-p (cdr nats)))))
  :measure (len nats))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define code-points-to-utf-8-chars ((nats nat-listp))
  :guard (unicode-code-points-p nats)
  :returns (chars character-listp)
  :short "UTF-8-encode a list of code points into a list of characters."
  (b* ((nats (nat-list-fix nats)))
    (if (endp nats)
        nil
      (append (acl2::code-point-to-utf-8-chars (car nats))
              (code-points-to-utf-8-chars (cdr nats)))))
  :measure (len nats)
  :guard-hints (("Goal" :in-theory (enable unicode-code-points-p))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define code-points-to-utf-8-string ((nats nat-listp))
  :returns (string acl2::string-resultp)
  :short "UTF-8-encode a list of code points into an ACL2 string."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is how source text is stored in
     lexeme and token fixtype values;
     see @(see tokenizer).
     It is an error if any natural exceeds
     the maximum code point @('#x10ffff');
     this never happens for the strings of lexeme CSTs,
     whose terminals the grammar confines to Unicode."))
  (if (unicode-code-points-p nats)
      (coerce (code-points-to-utf-8-chars nats) 'string)
    (reserrf (list :not-code-points (nat-list-fix nats)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define abs-symbols-to-nats ((syms true-listp))
  :returns (nats nat-listp)
  :short "Convert an @(tsee abnf::stringp) (list of nats and rule symbols)
          to a @(tsee nat-listp), discarding any non-nat entries."
  :long
  (xdoc::topstring
   (xdoc::p
    "Same as in the Remora CST abstractor:
     @(tsee abnf::tree->string) returns a list that
     can contain rule symbols for non-terminated trees;
     the lexer only produces terminated trees
     (all leaves are naturals),
     so nothing is discarded on its output."))
  (cond ((endp syms) nil)
        ((natp (car syms))
         (cons (car syms) (abs-symbols-to-nats (cdr syms))))
        (t (abs-symbols-to-nats (cdr syms))))
  :measure (len syms))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Position threading and spans.

(define position-advance ((nat natp) (pos positionp))
  :returns (new-pos positionp)
  :short "Advance a position over one code point."
  :long
  (xdoc::topstring
   (xdoc::p
    "A line feed moves to the next line;
     every other code point advances the column by one.
     (Like rustc, we do not treat
     a carriage return as a line terminator:
     rustc normalizes CRLF to LF before lexing
     and rejects bare CR in source.)"))
  (if (eql (lnfix nat) #x0a)
      (position-inc-line 1 pos)
    (position-inc-column 1 pos)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define position-advance-to-last ((nats nat-listp) (pos positionp))
  :guard (consp nats)
  :returns (mv (last-pos positionp)
               (next-pos positionp))
  :short "Advance a position over a nonempty list of code points,
          returning the positions of the last code point
          and of the one after it."
  (b* ((nats (nat-list-fix nats))
       (pos (position-fix pos))
       ((unless (consp nats)) (mv pos pos)) ; guard excludes this
       (nat (car nats))
       ((when (endp (cdr nats))) (mv pos (position-advance nat pos))))
    (position-advance-to-last (cdr nats) (position-advance nat pos)))
  :measure (len nats))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define span-of-nats ((nats nat-listp) (pos positionp))
  :guard (consp nats)
  :returns (mv (span spanp)
               (next-pos positionp))
  :short "Span of a nonempty list of code points starting at a position,
          and the position just after it."
  :long
  (xdoc::topstring
   (xdoc::p
    "The span's (inclusive) ending position is
     that of the last code point."))
  (b* (((mv last-pos next-pos) (position-advance-to-last nats pos)))
    (mv (make-span :start (position-fix pos) :end last-pos)
        next-pos)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; CST abstraction: whitespace and comments.

(define abs-whitespace ((tree abnf::treep))
  :returns (lexeme lexeme-resultp)
  :short "Abstract a @('whitespace') CST to a lexeme."
  (b* (((fty::okf &) (abnf::check-tree-nonleaf tree "whitespace"))
       ((fty::okf content)
        (code-points-to-utf-8-string (abs-symbols-to-nats (abnf::tree->string tree)))))
    (lexeme-whitespace content)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define abs-comment ((tree abnf::treep))
  :returns (lexeme lexeme-resultp)
  :short "Abstract a @('comment') CST to a lexeme."
  :long
  (xdoc::topstring
   (xdoc::p
    "Line and block comments are trivia lexemes,
     whose content is the text after the @('//')
     or between the @('/*') and @('*/') markers.
     Doc comments are doc-comment tokens
     (they become attributes during parsing),
     whose content is the text after
     the @('///') or @('//!') marker.
     The block doc comment forms
     are not yet in the grammar slice."))
  (b* (((fty::okf sub) (abnf::check-tree-nonleaf-1-1 tree "comment"))
       ((fty::okf rulename?) (abnf::check-tree-nonleaf? sub))
       (nats (abs-symbols-to-nats (abnf::tree->string sub))))
    (cond
     ((equal rulename? "line-comment")
      (b* (((unless (prefixp (list #x2f #x2f) nats)) ; //
            (reserrf (list :no-line-comment-marker nats)))
           ((fty::okf content)
            (code-points-to-utf-8-string (nthcdr 2 nats))))
        (lexeme-comment nil content)))
     ((equal rulename? "outer-line-doc")
      (b* (((unless (prefixp (list #x2f #x2f #x2f) nats)) ; ///
            (reserrf (list :no-outer-line-doc-marker nats)))
           ((fty::okf content)
            (code-points-to-utf-8-string (nthcdr 3 nats))))
        (lexeme-token (token-doc-comment (doc-style-outer) nil content))))
     ((equal rulename? "inner-line-doc")
      (b* (((unless (prefixp (list #x2f #x2f #x21) nats)) ; //!
            (reserrf (list :no-inner-line-doc-marker nats)))
           ((fty::okf content)
            (code-points-to-utf-8-string (nthcdr 3 nats))))
        (lexeme-token (token-doc-comment (doc-style-inner) nil content))))
     ((equal rulename? "block-comment")
      (b* (((unless (and (>= (len nats) 4)
                         (prefixp (list #x2f #x2a) nats))) ; /* ... */
            (reserrf (list :no-block-comment-markers nats)))
           ((fty::okf content)
            (code-points-to-utf-8-string (butlast (nthcdr 2 nats) 2))))
        (lexeme-comment t content)))
     (t (reserrf (list :unexpected-comment-kind rulename?))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; CST abstraction: tokens.

(define abs-identifier-or-keyword ((tree abnf::treep)
                                   (edition rust::editionp))
  :returns (token token-resultp)
  :short "Abstract an @('identifier-or-keyword') CST to a token."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is where keywords are classified,
     according to the edition [SC6]:
     strict and reserved keywords become keyword tokens;
     everything else, including weak keywords,
     becomes a (non-raw) identifier token."))
  (b* (((fty::okf &) (abnf::check-tree-nonleaf tree "identifier-or-keyword"))
       ((fty::okf name)
        (code-points-to-utf-8-string (abs-symbols-to-nats (abnf::tree->string tree)))))
    (if (keyword-p name (rust::edition-fix edition))
        (token-keyword name)
      (token-ident name nil))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define abs-raw-identifier ((tree abnf::treep))
  :returns (token token-resultp)
  :short "Abstract a @('raw-identifier') CST to a token."
  :long
  (xdoc::topstring
   (xdoc::p
    "The name of the identifier token is
     the text after the @('r#') prefix,
     and the token is marked as raw.
     The side condition [SC5] is enforced here:
     a raw identifier must not be
     @('crate'), @('self'), @('super'), or @('Self').
     (Note that @('r#_') is already excluded by the grammar:
     a lone underscore is not an @('identifier-or-keyword').)
     Raw keywords like @('r#fn') are identifiers, never keywords,
     in every edition."))
  (b* (((fty::okf &) (abnf::check-tree-nonleaf tree "raw-identifier"))
       (nats (abs-symbols-to-nats (abnf::tree->string tree)))
       ((unless (prefixp (list #x72 #x23) nats)) ; r#
        (reserrf (list :no-raw-identifier-prefix nats)))
       ((fty::okf name) (code-points-to-utf-8-string (nthcdr 2 nats)))
       ((when (member-equal name (list "crate" "self" "super" "Self")))
        (reserrf (list :disallowed-raw-identifier name)))) ; [SC5]
    (token-ident name t)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define abs-integer-literal-radix+digits ((tree abnf::treep))
  :returns (mv (radix radixp)
               (digits-nats abnf::nat-list-resultp))
  :short "Abstract one of the four @('...-literal') CSTs
          inside an @('integer-literal')
          to its radix and the code points of its digits."
  :long
  (xdoc::topstring
   (xdoc::p
    "The digits are as written,
     including any @('_') separators,
     and excluding the radix prefix (if any)."))
  (b* ((rulename? (abnf::check-tree-nonleaf? tree))
       ((when (reserrp rulename?))
        (mv (radix-dec) (reserrf-push rulename?)))
       (nats (abs-symbols-to-nats (abnf::tree->string tree))))
    (cond
     ((equal rulename? "dec-literal")
      (mv (radix-dec) nats))
     ((equal rulename? "bin-literal")
      (if (prefixp (list #x30 #x62) nats) ; 0b
          (mv (radix-bin) (nthcdr 2 nats))
        (mv (radix-bin) (reserrf (list :no-bin-prefix nats)))))
     ((equal rulename? "oct-literal")
      (if (prefixp (list #x30 #x6f) nats) ; 0o
          (mv (radix-oct) (nthcdr 2 nats))
        (mv (radix-oct) (reserrf (list :no-oct-prefix nats)))))
     ((equal rulename? "hex-literal")
      (if (prefixp (list #x30 #x78) nats) ; 0x
          (mv (radix-hex) (nthcdr 2 nats))
        (mv (radix-hex) (reserrf (list :no-hex-prefix nats)))))
     (t (mv (radix-dec)
            (reserrf (list :unexpected-literal-kind rulename?)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define abs-integer-literal-suffix ((tree abnf::treep))
  :returns (suffix acl2::string-resultp)
  :short "Abstract the optional-suffix CST
          inside an @('integer-literal')
          to the suffix as a string."
  :long
  (xdoc::topstring
   (xdoc::p
    "The CST is the tree for @('[ suffix-no-e ]'):
     a nonleaf tree without rule name,
     whose branches are empty if the suffix is absent.
     An absent suffix abstracts to the empty string."))
  (b* (((fty::okf branches) (abnf::check-tree-nonleaf tree nil))
       ((when (endp branches)) "")
       ((fty::okf trees) (abnf::check-tree-list-list-1 branches))
       ((fty::okf sub) (abnf::check-tree-list-1 trees))
       ((fty::okf &) (abnf::check-tree-nonleaf sub "suffix-no-e")))
    (code-points-to-utf-8-string (abs-symbols-to-nats (abnf::tree->string sub)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define abs-integer-literal ((tree abnf::treep))
  :returns (token token-resultp)
  :short "Abstract an @('integer-literal') CST to a token."
  :long
  (xdoc::topstring
   (xdoc::p
    "The CST has two branches:
     a group holding one of the four radix-specific literals,
     and the optional suffix.
     Digits and suffix are stored as written;
     see @(see tokens)."))
  (b* (((fty::okf sub) (abnf::check-tree-nonleaf-2 tree "integer-literal"))
       ((fty::okf group-tree)
        (abnf::check-tree-list-1 (abnf::tree-list-tuple2->1st sub)))
       ((fty::okf lit-tree) (abnf::check-tree-nonleaf-1-1 group-tree nil))
       ((mv radix digits-nats) (abs-integer-literal-radix+digits lit-tree))
       ((when (reserrp digits-nats)) (reserrf-push digits-nats))
       ((fty::okf digits) (code-points-to-utf-8-string digits-nats))
       ((fty::okf opt-tree)
        (abnf::check-tree-list-1 (abnf::tree-list-tuple2->2nd sub)))
       ((fty::okf suffix) (abs-integer-literal-suffix opt-tree)))
    (token-lit (lit-int (make-int-lit :radix radix
                                      :digits digits
                                      :suffix suffix)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define abs-punctuation ((tree abnf::treep))
  :returns (token token-resultp)
  :short "Abstract a @('punctuation') CST to a token."
  :long
  (xdoc::topstring
   (xdoc::p
    "As a sanity check, tying the grammar to the token fixtypes,
     we require the text to be
     one of the 47 punctuation strings (see @(tsee punctuationp))."))
  (b* (((fty::okf &) (abnf::check-tree-nonleaf tree "punctuation"))
       ((fty::okf value)
        (code-points-to-utf-8-string (abs-symbols-to-nats (abnf::tree->string tree))))
       ((unless (punctuationp value))
        (reserrf (list :not-punctuation value))))
    (token-punct value)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define abs-delimiter ((tree abnf::treep))
  :returns (token token-resultp)
  :short "Abstract a @('delimiter') CST to a token."
  (b* (((fty::okf &) (abnf::check-tree-nonleaf tree "delimiter"))
       (nats (abs-symbols-to-nats (abnf::tree->string tree))))
    (cond ((equal nats (list #x28)) (token-open-delim (delim-paren)))
          ((equal nats (list #x29)) (token-close-delim (delim-paren)))
          ((equal nats (list #x5b)) (token-open-delim (delim-bracket)))
          ((equal nats (list #x5d)) (token-close-delim (delim-bracket)))
          ((equal nats (list #x7b)) (token-open-delim (delim-brace)))
          ((equal nats (list #x7d)) (token-close-delim (delim-brace)))
          (t (reserrf (list :unexpected-delimiter nats))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define abs-token ((tree abnf::treep) (edition rust::editionp))
  :returns (token token-resultp)
  :short "Abstract a @('token') CST to a token."
  (b* (((fty::okf sub) (abnf::check-tree-nonleaf-1-1 tree "token"))
       ((fty::okf rulename?) (abnf::check-tree-nonleaf? sub)))
    (cond ((equal rulename? "identifier-or-keyword")
           (abs-identifier-or-keyword sub edition))
          ((equal rulename? "raw-identifier")
           (abs-raw-identifier sub))
          ((equal rulename? "integer-literal")
           (abs-integer-literal sub))
          ((equal rulename? "punctuation")
           (abs-punctuation sub))
          ((equal rulename? "delimiter")
           (abs-delimiter sub))
          (t (reserrf (list :unexpected-token-kind rulename?))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define abs-lexeme ((tree abnf::treep) (edition rust::editionp))
  :returns (lexeme lexeme-resultp)
  :short "Abstract a @('lexeme') CST to a lexeme."
  (b* (((fty::okf sub) (abnf::check-tree-nonleaf-1-1 tree "lexeme"))
       ((fty::okf rulename?) (abnf::check-tree-nonleaf? sub)))
    (cond ((equal rulename? "whitespace")
           (abs-whitespace sub))
          ((equal rulename? "comment")
           (abs-comment sub))
          ((equal rulename? "token")
           (b* (((fty::okf token) (abs-token sub edition)))
             (lexeme-token token)))
          (t (reserrf (list :unexpected-lexeme-kind rulename?))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define abs-lexeme-list ((trees abnf::tree-listp) (edition rust::editionp))
  :returns (lexemes lexeme-list-resultp)
  :short "Abstract a list of @('lexeme') CSTs to a list of lexemes."
  (b* (((when (endp trees)) nil)
       ((fty::okf lexeme) (abs-lexeme (car trees) edition))
       ((fty::okf lexemes) (abs-lexeme-list (cdr trees) edition)))
    (cons lexeme lexemes))
  :measure (len trees))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Tokenization: abstraction + span threading + trivia filtering.

(define tokenize-lexeme-csts ((trees abnf::tree-listp)
                              (pos positionp)
                              (edition rust::editionp))
  :returns (tokens token+span-list-resultp)
  :short "Turn a list of lexeme CSTs into a list of tokens with spans."
  :long
  (xdoc::topstring
   (xdoc::p
    "Each lexeme's span starts at the running position
     and ends (inclusive) at its last code point;
     the running position then continues after the lexeme.
     Trivia lexemes (whitespace and non-doc comments)
     advance the position but produce no token."))
  (b* ((trees (abnf::tree-list-fix trees))
       (pos (position-fix pos))
       (edition (rust::edition-fix edition))
       ((when (endp trees)) nil)
       (tree (car trees))
       ((fty::okf lexeme) (abs-lexeme tree edition))
       (nats (abs-symbols-to-nats (abnf::tree->string tree)))
       ((unless (consp nats))
        (reserrf (list :empty-lexeme (abnf::tree-fix tree))))
       ((mv span next-pos) (span-of-nats nats pos))
       ((fty::okf rest-tokens)
        (tokenize-lexeme-csts (cdr trees) next-pos edition)))
    (lexeme-case lexeme
                 :token (cons (make-token+span :token lexeme.token
                                               :span span)
                              rest-tokens)
                 :whitespace rest-tokens
                 :comment rest-tokens))
  :measure (len trees)
  ; The fix congruences are proved by expanding the definition
  ; on both sides of each equality (no induction is needed,
  ; since the formals are fixed at entry);
  ; the default hook-generated proofs attempt induction,
  ; which case-explodes through the lexeme abstraction.
  :hooks nil

  ///

  (fty::deffixequiv tokenize-lexeme-csts
    :hints
    (("Goal"
      :expand
      ((tokenize-lexeme-csts trees pos edition)
       (tokenize-lexeme-csts (abnf::tree-list-fix trees) pos edition)
       (tokenize-lexeme-csts trees (position-fix pos) edition)
       (tokenize-lexeme-csts trees pos (rust::edition-fix edition)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define tokenize-rust ((input nat-listp)
                       (edition rust::editionp)
                       (file stringp))
  :returns (tokens token+span-list-resultp)
  :short "Lex and tokenize a list of Unicode code points."
  :long
  (xdoc::topstring
   (xdoc::p
    "The file name is used only in the positions of the spans."))
  (b* ((trees (lexemize-rust input))
       ((when (reserrp trees)) (reserrf-push trees)))
    (tokenize-lexeme-csts trees (position-init file) edition)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define tokenize-rust-from-string ((string stringp)
                                  (edition rust::editionp)
                                  (file stringp))
