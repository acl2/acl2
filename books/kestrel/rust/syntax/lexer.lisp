(define lex-integer-literal ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex an @('integer-literal')."
  :long
  (xdoc::topstring
   (xdoc::p
    "The radix is committed based on
     the first two characters [SC7]:
     @('0b'), @('0o'), and @('0x') select their radix,
     and anything else (starting with a decimal digit)
     is a decimal literal.
     After the digits, a suffix is lexed if present;
     since @(tsee lex-suffix-no-e) fails
     if no suffix-shaped text follows,
     a failure there just means an absent suffix
     (empty option CST)."))
  (b* ((input (nat-list-fix input))
       ((mv lit-tree input1)
        (cond ((prefixp (list #x30 #x62) input) ; "0b"
               (lex-bin-literal input))
              ((prefixp (list #x30 #x6f) input) ; "0o"
               (lex-oct-literal input))
              ((prefixp (list #x30 #x78) input) ; "0x"
               (lex-hex-literal input))
              (t (lex-dec-literal input))))
       ((when (reserrp lit-tree))
        (mv (reserrf-push lit-tree) input))
       (group-tree (abnf::make-tree-nonleaf
                    :rulename? nil
                    :branches (list (list lit-tree))))
       ((mv suffix-tree input2) (lex-suffix-no-e input1))
       ((when (reserrp suffix-tree))
        (mv (abnf::make-tree-nonleaf
             :rulename? (abnf::rulename "integer-literal")
             :branches (list (list group-tree)
                             (list (abnf::make-tree-nonleaf
                                    :rulename? nil
                                    :branches nil))))
            input1)))
    (mv (abnf::make-tree-nonleaf
         :rulename? (abnf::rulename "integer-literal")
         :branches (list (list group-tree)
                         (list (abnf::make-tree-nonleaf
                                :rulename? nil
                                :branches (list (list suffix-tree))))))
        input2))
  ///

  (defret len-of-lex-integer-literal-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-integer-literal-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear)

  (defret input-decomposition-of-lex-integer-literal
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal" :in-theory (enable abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (defret cst-matchp-of-lex-integer-literal
    (implies (not (reserrp tree))
             (cst-matchp tree "integer-literal"))
    :hints (("Goal"
             :in-theory
             (enable cst-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-of-make-tree-nonleaf-group-elem
                     tree-match-of-make-tree-nonleaf-option-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-terminatedp-of-lex-dec-literal
                     tree-terminatedp-of-lex-bin-literal
                     tree-terminatedp-of-lex-oct-literal
                     tree-terminatedp-of-lex-hex-literal
                     tree-terminatedp-of-lex-suffix-no-e
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-list-match-element-p
                     abnf::numrep-match-repeat-range-p))))

  (defret tree-terminatedp-of-lex-integer-literal
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :hints (("Goal" :use cst-matchp-of-lex-integer-literal
                    :in-theory (enable cst-matchp)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
; Character and string literals.
;
; The character classes, suffixes, escapes, and literal rules below follow
; the grammar's "Character and string literals" section.  [SC9] (unicode
; escape values) is checked where unicode escapes are lexed, and [SC10] (raw
; string termination) in the raw literal bodies and their hash count.

(def-lex-char-class "nonzero-hex-digit"
  (or (and (<= #x31 nat) (<= nat #x39))
      (and (<= #x41 nat) (<= nat #x46))
      (and (<= #x61 nat) (<= nat #x66))))

(def-lex-char-class "dquote"
  (eql nat #x22))

(def-lex-char-class "lf"
  (eql nat #xa))

(def-lex-char-class "char-literal-char"
  (or (<= nat #x8)
      (and (<= #xb nat) (<= nat #xc))
      (and (<= #xe nat) (<= nat #x26))
      (and (<= #x28 nat) (<= nat #x5b))
      (and (<= #x5d nat) (<= nat #xd7ff))
      (and (<= #xe000 nat) (<= nat #x10ffff))))

(def-lex-char-class "string-literal-char"
  (or (<= nat #xc)
      (and (<= #xe nat) (<= nat #x21))
      (and (<= #x23 nat) (<= nat #x5b))
      (and (<= #x5d nat) (<= nat #xd7ff))
      (and (<= #xe000 nat) (<= nat #x10ffff))))

(def-lex-char-class "c-string-literal-char"
  (or (and (<= #x1 nat) (<= nat #xc))
      (and (<= #xe nat) (<= nat #x21))
      (and (<= #x23 nat) (<= nat #x5b))
      (and (<= #x5d nat) (<= nat #xd7ff))
      (and (<= #xe000 nat) (<= nat #x10ffff))))

(def-lex-char-class "raw-string-char"
  (or (<= nat #xc)
      (and (<= #xe nat) (<= nat #xd7ff))
      (and (<= #xe000 nat) (<= nat #x10ffff))))

(def-lex-char-class "raw-c-string-char"
  (or (and (<= #x1 nat) (<= nat #xc))
      (and (<= #xe nat) (<= nat #xd7ff))
      (and (<= #xe000 nat) (<= nat #x10ffff))))

(def-lex-char-class "ascii-for-char"
  (or (<= nat #x8)
      (and (<= #xb nat) (<= nat #xc))
      (and (<= #xe nat) (<= nat #x26))
      (and (<= #x28 nat) (<= nat #x5b))
      (and (<= #x5d nat) (<= nat #x7f))))

(def-lex-char-class "ascii-for-string"
  (or (<= nat #xc)
      (and (<= #xe nat) (<= nat #x21))
      (and (<= #x23 nat) (<= nat #x5b))
      (and (<= #x5d nat) (<= nat #x7f))))

(def-lex-char-class "ascii-for-raw"
  (or (<= nat #xc)
      (and (<= #xe nat) (<= nat #x7f))))

