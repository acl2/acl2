(defsection parsing-primitive-theorems
  :short "Additional theorems about the ABNF parsing primitives."
  :long
  (xdoc::topstring
   (xdoc::p
    "The "
    (xdoc::seetopic "abnf::parsing-primitives-defresult"
                    "parsing primitives")
    " come with linear rules about the length of the remaining input,
     but not with input decomposition, tree matching, or terminatedness
     theorems, which our lexing functions need;
     we supply them here.
     These are candidates for adding to the ABNF library itself."))

  ;; result/value disjointness:

  (defruled not-reserrp-when-treep
    (implies (abnf::treep x)
             (not (reserrp x)))
    :enable (abnf::treep reserrp))

  ;; input decomposition:

  (defruled input-decomposition-of-parse-next
    (b* (((mv nat? rest-input) (abnf::parse-next input)))
      (implies (not (reserrp nat?))
               (equal (cons nat? rest-input)
                      (nat-list-fix input))))
    :enable abnf::parse-next)

  (defruled input-decomposition-of-parse-direct
    (b* (((mv tree rest-input) (abnf::parse-direct nats input)))
      (implies (not (reserrp tree))
               (equal (append (abnf::tree->string tree) rest-input)
                      (nat-list-fix input))))
    :enable (abnf::parse-direct
             abnf::tree->string
             input-decomposition-of-parse-direct-aux
             acl2::nat-listp-when-result-not-error)
    :prep-lemmas
    ((defruled input-decomposition-of-parse-direct-aux
       (b* (((mv nats1 rest-input) (abnf::parse-direct-aux nats input)))
         (implies (not (reserrp nats1))
                  (equal (append nats1 rest-input)
                         (nat-list-fix input))))
       :induct t
       :enable (abnf::parse-direct-aux
                abnf::parse-next))))

  (defruled input-decomposition-of-parse-range
    (b* (((mv tree rest-input) (abnf::parse-range min max input)))
      (implies (not (reserrp tree))
               (equal (append (abnf::tree->string tree) rest-input)
                      (nat-list-fix input))))
    :enable (abnf::parse-range
             abnf::parse-next
             abnf::tree->string))

  (defruled input-decomposition-of-parse-ichars
    (b* (((mv tree rest-input) (abnf::parse-ichars chars input)))
      (implies (not (reserrp tree))
               (equal (append (abnf::tree->string tree) rest-input)
                      (nat-list-fix input))))
    :enable (abnf::parse-ichars
             abnf::tree->string
             input-decomposition-of-parse-ichars-aux
             acl2::nat-listp-when-result-not-error)
    :prep-lemmas
    ((defruled input-decomposition-of-parse-ichars-aux
       (b* (((mv nats rest-input) (abnf::parse-ichars-aux chars input)))
         (implies (not (reserrp nats))
                  (equal (append nats rest-input)
                         (nat-list-fix input))))
       :induct t
       :enable (abnf::parse-ichars-aux
                abnf::parse-next))))

  (defruled input-decomposition-of-parse-schars
    (b* (((mv tree rest-input) (abnf::parse-schars chars input)))
      (implies (not (reserrp tree))
               (equal (append (abnf::tree->string tree) rest-input)
                      (nat-list-fix input))))
    :enable (abnf::parse-schars
             abnf::tree->string
             input-decomposition-of-parse-schars-aux
             acl2::nat-listp-when-result-not-error)
    :prep-lemmas
    ((defruled input-decomposition-of-parse-schars-aux
       (b* (((mv nats rest-input) (abnf::parse-schars-aux chars input)))
         (implies (not (reserrp nats))
                  (equal (append nats rest-input)
                         (nat-list-fix input))))
       :induct t
       :enable (abnf::parse-schars-aux
                abnf::parse-next))))

  ;; tree matching:

  (defruled tree-match-of-parse-range
    (b* (((mv tree &) (abnf::parse-range min max input)))
      (implies (not (reserrp tree))
               (abnf::tree-match-element-p
                tree
                (abnf::element-num-val (abnf::num-val-range base min max))
                rules)))
    :enable (abnf::parse-range
             abnf::parse-next
             abnf::tree-match-element-p
             abnf::tree-match-num-val-p))

  (defruled tree-match-of-parse-ichars
    (b* (((mv tree &) (abnf::parse-ichars chars input)))
      (implies (not (reserrp tree))
               (abnf::tree-match-element-p
                tree
                (abnf::element-char-val
                 (abnf::char-val-insensitive iprefix chars))
                rules)))
    :enable (abnf::parse-ichars
             abnf::tree-match-element-p
             abnf::tree-match-char-val-p
             tree-match-of-parse-ichars-aux)
    :prep-lemmas
    ((defruled tree-match-of-parse-ichars-aux
       (b* (((mv nats &) (abnf::parse-ichars-aux chars input)))
         (implies (not (reserrp nats))
                  (abnf::nats-match-insensitive-chars-p nats chars)))
       :induct t
       :enable (abnf::parse-ichars-aux
                abnf::nats-match-insensitive-chars-p))))

  (defruled tree-match-of-parse-schars
    (b* (((mv tree &) (abnf::parse-schars chars input)))
      (implies (not (reserrp tree))
               (abnf::tree-match-element-p
                tree
                (abnf::element-char-val (abnf::char-val-sensitive chars))
                rules)))
    :enable (abnf::parse-schars
             abnf::tree-match-element-p
             abnf::tree-match-char-val-p
             tree-match-of-parse-schars-aux)
    :prep-lemmas
    ((defruled tree-match-of-parse-schars-aux
       (b* (((mv nats &) (abnf::parse-schars-aux chars input)))
         (implies (not (reserrp nats))
                  (abnf::nats-match-sensitive-chars-p nats chars)))
       :induct t
       :enable (abnf::parse-schars-aux
                abnf::nats-match-sensitive-chars-p))))

  ;; The -elem variants have an (equal elem ...) hypothesis
  ;; relieved by evaluation, for the same reason as
  ;; the -elem variants in tree-construction-theorems (which see).

  (defruled tree-match-of-parse-ichars-elem
    (b* (((mv tree &) (abnf::parse-ichars chars input)))
      (implies (and (equal elem
                           (abnf::element-char-val
                            (abnf::char-val-insensitive nil chars)))
                    (not (reserrp tree)))
               (abnf::tree-match-element-p tree elem rules)))
    :hints (("Goal" :use (:instance tree-match-of-parse-ichars
                                    (iprefix nil))
                    :in-theory (theory 'acl2::minimal-theory))))

  (defruled tree-match-of-parse-schars-elem
    (b* (((mv tree &) (abnf::parse-schars chars input)))
      (implies (and (equal elem
                           (abnf::element-char-val
                            (abnf::char-val-sensitive chars)))
                    (not (reserrp tree)))
               (abnf::tree-match-element-p tree elem rules)))
    :hints (("Goal" :use tree-match-of-parse-schars
                    :in-theory (theory 'acl2::minimal-theory))))

  ;; terminatedness:

  (defruled tree-terminatedp-of-parse-range
    (b* (((mv tree &) (abnf::parse-range min max input)))
      (implies (not (reserrp tree))
               (abnf::tree-terminatedp tree)))
    :enable (abnf::parse-range
             abnf::tree-terminatedp))

  (defruled tree-terminatedp-of-parse-ichars
    (b* (((mv tree &) (abnf::parse-ichars chars input)))
      (implies (not (reserrp tree))
               (abnf::tree-terminatedp tree)))
    :enable (abnf::parse-ichars
             abnf::tree-terminatedp))

  (defruled tree-terminatedp-of-parse-schars
    (b* (((mv tree &) (abnf::parse-schars chars input)))
      (implies (not (reserrp tree))
               (abnf::tree-terminatedp tree)))
    :enable (abnf::parse-schars
             abnf::tree-terminatedp)))

(local (in-theory (enable not-reserrp-when-treep)))

