(defines lex-block-comment-fns
  :short "Lexing functions for (nested) block comments."
  :long
  (xdoc::topstring
   (xdoc::p
    "Rust block comments nest,
     so these functions are mutually recursive:
     a @('block-comment') contains @('block-item')s,
     and a @('block-item') may be a @('block-comment').
     The item repetition stops at the first point where
     the remaining input starts with @('*/'),
     which closes the current comment:
     this realizes the [SC2] side condition
     (see @(see extra-grammatical-restrictions)).")
   (xdoc::p
    "The termination measure pairs the input length with
     a rank that orders the functions at equal input length;
     the item repetition recurses only when
     the item consumed some input,
     which the @(tsee mbt) test makes available
     to the termination proof.
     Guard verification is deferred until
     the length theorems are available."))
  :verify-guards nil

  (define lex-block-comment ((input nat-listp))
    :returns (mv (tree abnf::tree-resultp)
                 (rest-input nat-listp))
    :measure (acl2::two-nats-measure (len input) 0)
    (b* (((mv tree-open input1) (abnf::parse-ichars "/*" input))
         ((when (reserrp tree-open))
          (mv (reserrf-push tree-open) (nat-list-fix input)))
         ((mv trees-items input2) (lex-*-block-item input1))
         ((mv tree-close input3) (abnf::parse-ichars "*/" input2))
         ((when (reserrp tree-close))
          (mv (reserrf (list :unclosed-block-comment))
              (nat-list-fix input))))
      (mv (abnf::make-tree-nonleaf
           :rulename? (abnf::rulename "block-comment")
           :branches (list (list tree-open)
                           trees-items
                           (list tree-close)))
          input3)))

  (define lex-block-item ((input nat-listp))
    :returns (mv (tree abnf::tree-resultp)
                 (rest-input nat-listp))
    :measure (acl2::two-nats-measure (len input) 1)
    (b* ((input (nat-list-fix input))
         ((when (prefixp (list #x2f #x2a) input)) ; starts with /*
          (b* (((mv tree input1) (lex-block-comment input))
               ((when (reserrp tree)) (mv (reserrf-push tree) input)))
            (mv (abnf::make-tree-nonleaf
                 :rulename? (abnf::rulename "block-item")
                 :branches (list (list tree)))
                input1)))
         ((mv tree input1) (lex-not-star-slash input))
         ((when (not (reserrp tree)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "block-item")
               :branches (list (list tree)))
              input1))
         ((mv tree input1) (abnf::parse-ichars "*" input))
         ((when (not (reserrp tree)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "block-item")
               :branches (list (list tree)))
              input1))
         ((mv tree input1) (abnf::parse-ichars "/" input))
         ((when (not (reserrp tree)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "block-item")
               :branches (list (list tree)))
              input1)))
      (mv (reserrf (list :found :end-of-input :required "block-item"))
          input)))

  (define lex-*-block-item ((input nat-listp))
    :returns (mv (trees abnf::tree-listp)
                 (rest-input nat-listp))
    :measure (acl2::two-nats-measure (len input) 2)
    (b* ((input (nat-list-fix input))
         ((when (prefixp (list #x2a #x2f) input)) ; stop before */ [SC2]
          (mv nil input))
         ((mv tree input1) (lex-block-item input))
         ((when (reserrp tree)) (mv nil input))
         ((unless (mbt (< (len input1) (len input)))) (mv nil input))
         ((mv trees input2) (lex-*-block-item input1)))
      (mv (cons tree trees) input2)))

  ///

  (std::defret-mutual len-of-lex-block-comment-fns-<=
    (defret len-of-lex-block-comment-<=
      (<= (len rest-input) (len input))
      :rule-classes :linear
      :fn lex-block-comment)
    (defret len-of-lex-block-item-<=
      (<= (len rest-input) (len input))
      :rule-classes :linear
      :fn lex-block-item)
    (defret len-of-lex-*-block-item-<=
      (<= (len rest-input) (len input))
      :rule-classes :linear
      :fn lex-*-block-item)
    :hints (("Goal"
             :expand ((lex-block-comment input)
                      (lex-block-item input)
                      (lex-*-block-item input))
             :in-theory (enable lex-block-comment
                                lex-block-item
                                lex-*-block-item))))

  (std::defret-mutual len-of-lex-block-comment-fns-<
    (defret len-of-lex-block-comment-<
      (implies (not (reserrp tree))
               (< (len rest-input) (len input)))
      :rule-classes :linear
      :fn lex-block-comment)
    (defret len-of-lex-block-item-<
      (implies (not (reserrp tree))
               (< (len rest-input) (len input)))
      :rule-classes :linear
      :fn lex-block-item)
    (defret len-of-lex-*-block-item-<-trivial
      t
      :rule-classes nil
      :fn lex-*-block-item)
    :hints (("Goal"
             :expand ((lex-block-comment input)
                      (lex-block-item input)
                      (lex-*-block-item input))
             :in-theory (enable lex-block-comment
                                lex-block-item
                                lex-*-block-item))))

  (verify-guards lex-block-comment)

  (std::defret-mutual input-decomposition-of-lex-block-comment-fns
    (defret input-decomposition-of-lex-block-comment
      (implies (not (reserrp tree))
               (equal (append (abnf::tree->string tree) rest-input)
                      (nat-list-fix input)))
      :fn lex-block-comment)
    (defret input-decomposition-of-lex-block-item
      (implies (not (reserrp tree))
               (equal (append (abnf::tree->string tree) rest-input)
                      (nat-list-fix input)))
      :fn lex-block-item)
    (defret input-decomposition-of-lex-*-block-item
      (equal (append (abnf::tree-list->string trees) rest-input)
             (nat-list-fix input))
      :fn lex-*-block-item)
    :hints (("Goal"
             :expand ((lex-block-comment input)
                      (lex-block-item input)
                      (lex-*-block-item input))
             :in-theory (enable lex-block-comment
                                lex-block-item
                                lex-*-block-item
                                input-decomposition-of-parse-ichars
                                       abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (std::defret-mutual cst-matchp-of-lex-block-comment-fns
    (defret cst-matchp-of-lex-block-comment
      (implies (not (reserrp tree))
               (cst-matchp tree "block-comment"))
      :fn lex-block-comment)
    (defret cst-matchp-of-lex-block-item
      (implies (not (reserrp tree))
               (cst-matchp tree "block-item"))
      :fn lex-block-item)
    (defret cst-list-elem-matchp-of-lex-*-block-item
      (cst-list-elem-matchp trees "block-item")
      :fn lex-*-block-item)
    :hints (("Goal"
             :expand ((lex-block-comment input)
                      (lex-block-item input)
                      (lex-*-block-item input))
             :in-theory
             (enable lex-block-comment
                     lex-block-item
                     lex-*-block-item
                     cst-matchp
                     cst-list-elem-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-list-match-element-p-when-cst-list-elem-matchp$
                     tree-match-of-parse-ichars-elem
                     tree-terminatedp-of-parse-ichars
                     tree-terminatedp-of-lex-not-star-slash
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-list-match-element-p
                     abnf::numrep-match-repeat-range-p))))

  (defret tree-terminatedp-of-lex-block-comment
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :fn lex-block-comment
    :hints (("Goal" :use cst-matchp-of-lex-block-comment
                    :in-theory (enable cst-matchp))))

  (defret tree-terminatedp-of-lex-block-item
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :fn lex-block-item
    :hints (("Goal" :use cst-matchp-of-lex-block-item
                    :in-theory (enable cst-matchp))))

  (defret tree-list-terminatedp-of-lex-*-block-item
    (abnf::tree-list-terminatedp trees)
    :fn lex-*-block-item
    :hints (("Goal" :use cst-list-elem-matchp-of-lex-*-block-item
                    :in-theory (enable cst-list-elem-matchp))))

  (defret cst-list-rep-matchp-of-lex-*-block-item
    (cst-list-rep-matchp trees "*block-item")
    :fn lex-*-block-item
    :hints (("Goal"
             :in-theory
             (enable cst-list-rep-matchp
                     tree-list-match-element-p-when-cst-list-elem-matchp$
                     abnf::tree-list-match-repetition-p
                     abnf::numrep-match-repeat-range-p)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lex-comment ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex a @('comment')."
  :long
  (xdoc::topstring
   (xdoc::p
    "The alternative is chosen by lookahead,
     realizing maximal munch [SC1] for
     the @('//') / @('///') / @('//!') / @('////') quirks:
     @('/*') starts a block comment;
     @('//!') starts an inner line doc comment;
     @('///') starts an outer line doc comment,
     unless a fourth @('/') follows,
     in which case the (longer) plain line comment wins;
     any other @('//') starts a plain line comment."))
  (b* ((input (nat-list-fix input))
       ((when (prefixp (list #x2f #x2a) input)) ; /*
        (b* (((mv tree input1) (lex-block-comment input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "comment")
               :branches (list (list tree)))
              input1)))
       ((when (prefixp (list #x2f #x2f #x21) input)) ; //!
        (b* (((mv tree input1) (lex-inner-line-doc input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "comment")
               :branches (list (list tree)))
              input1)))
       ((when (and (prefixp (list #x2f #x2f #x2f) input)
                   (not (prefixp (list #x2f #x2f #x2f #x2f) input)))) ; ///
        (b* (((mv tree input1) (lex-outer-line-doc input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "comment")
               :branches (list (list tree)))
              input1)))
       ((mv tree input1) (lex-line-comment input))
       ((when (reserrp tree)) (mv (reserrf-push tree) input)))
    (mv (abnf::make-tree-nonleaf
         :rulename? (abnf::rulename "comment")
         :branches (list (list tree)))
        input1))
  ///

  (defret len-of-lex-comment-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-comment-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear)

  (defret input-decomposition-of-lex-comment
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal" :in-theory (enable abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (defret cst-matchp-of-lex-comment
    (implies (not (reserrp tree))
             (cst-matchp tree "comment"))
    :hints (("Goal"
             :in-theory
             (enable cst-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-terminatedp-of-lex-block-comment
                     tree-terminatedp-of-lex-inner-line-doc
                     tree-terminatedp-of-lex-outer-line-doc
                     tree-terminatedp-of-lex-line-comment
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-list-match-element-p
                     abnf::numrep-match-repeat-range-p))))

  (defret tree-terminatedp-of-lex-comment
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :hints (("Goal" :use cst-matchp-of-lex-comment
                    :in-theory
                    (union-theories (theory 'acl2::minimal-theory)
                                    '((:definition cst-matchp$)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lex-token ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex a @('token')."
  :long
  (xdoc::topstring
   (xdoc::p
    "The alternative is chosen by lookahead at the first characters:
     a single quote starts a character literal,
     and a double quote a string literal;
     the literal prefixes
     @('b') followed by a quote,
     @('br') or @('cr') followed by a double quote or @('#'),
     @('c') followed by a double quote,
     and @('r') followed by a double quote or @('#')
     attempt the corresponding literal first;
     then @('r#') attempts a raw identifier,
     falling back to an identifier
     (which for e.g. @('r#1') lexes @('r')
     and then fails via [SC8] below,
     since @('1') is not an identifier start);
     a letter starts an identifier or keyword;
     an underscore starts an identifier if
     an identifier-continue character follows,
     otherwise it is punctuation;
     a decimal digit starts an integer literal;
     a bracket character is a delimiter;
     anything else is attempted as punctuation.")
   (xdoc::p
    "After lexing a (non-raw) identifier or keyword,
     or a lone underscore,
     the reserved prefix side condition [SC8] applies:
     if the next character is @('#'), @('\\''), or @('\"'),
     the input is rejected
     (e.g. @('foo#bar') and @('_#') do not lex
     in the supported editions).
     Genuine raw identifiers are not affected,
     because @('r#') followed by an identifier start
     lexes as a raw identifier;
     nor are valid literals with prefixes,
     which lex as single literals.
     A literal with a prefix that fails to lex
     (e.g. a byte string containing a unicode escape)
     falls back to the identifier,
     which [SC8] then rejects.")
   (xdoc::p
    "After lexing a character, byte, or string literal (of any kind),
     the side condition [SC11] applies:
     if the next character is @('_'), the input is rejected
     (e.g. @('\"Foo\"_') does not lex,
     while @('\"Foo\"__') lexes as a literal with suffix @('__')).
     A suffix has already been lexed greedily,
     so such an underscore is not followed by
     an identifier-continue character."))
  (b* ((input (nat-list-fix input))
       ((mv nat? &) (abnf::parse-next input))
       ((when (reserrp nat?))
        (mv (reserrf-push nat?) input))
       (nat (lnfix nat?))
       ((when (eql nat #x27)) ; '
        (b* (((mv tree input1) (lex-char-literal input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input))
             ((when (prefixp (list #x5f) input1)) ; _ [SC11]
              (mv (reserrf (list :underscore-literal-suffix
                                 (abnf::tree->string tree)))
                  input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "token")
               :branches (list (list tree)))
              input1)))
       ((when (eql nat #x22)) ; "
        (b* (((mv tree input1) (lex-string-literal input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input))
             ((when (prefixp (list #x5f) input1)) ; _ [SC11]
              (mv (reserrf (list :underscore-literal-suffix
                                 (abnf::tree->string tree)))
                  input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "token")
               :branches (list (list tree)))
              input1)))
       ((mv tree input1)
        (cond ((prefixp (list #x62 #x27) input) ; b'
               (lex-byte-literal input))
              ((prefixp (list #x62 #x22) input) ; b"
               (lex-byte-string-literal input))
              ((or (prefixp (list #x62 #x72 #x22) input) ; br"
                   (prefixp (list #x62 #x72 #x23) input)) ; br#
               (lex-raw-byte-string-literal input))
              ((prefixp (list #x63 #x22) input) ; c"
               (lex-c-string-literal input))
              ((or (prefixp (list #x63 #x72 #x22) input) ; cr"
                   (prefixp (list #x63 #x72 #x23) input)) ; cr#
               (lex-raw-c-string-literal input))
              ((or (prefixp (list #x72 #x22) input) ; r"
                   (prefixp (list #x72 #x23) input)) ; r#
               (lex-raw-string-literal input))
              (t (mv (reserrf :no-prefixed-literal) input))))
       ((when (and (not (reserrp tree))
                   (prefixp (list #x5f) input1))) ; _ [SC11]
        (mv (reserrf (list :underscore-literal-suffix
                           (abnf::tree->string tree)))
            input))
       ((when (not (reserrp tree)))
        (mv (abnf::make-tree-nonleaf
             :rulename? (abnf::rulename "token")
             :branches (list (list tree)))
            input1))
       ((when (prefixp (list #x72 #x23) input)) ; r#
        (b* (((mv tree input1) (lex-raw-identifier input))
             ((when (not (reserrp tree)))
              (mv (abnf::make-tree-nonleaf
                   :rulename? (abnf::rulename "token")
                   :branches (list (list tree)))
                  input1)))
          (lex-token-identifier-or-keyword input)))
       ((when (or (and (<= #x41 nat) (<= nat #x5a)) ; letter
                  (and (<= #x61 nat) (<= nat #x7a))
                  (eql nat #x5f))) ; underscore
        (b* (((mv tree input1) (lex-token-identifier-or-keyword input))
             ((when (not (reserrp tree))) (mv tree input1))
             ((unless (eql nat #x5f)) (mv tree input1))
             ;; lone underscore: punctuation, unless a reserved prefix [SC8]
             ((mv tree input1) (lex-punctuation input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input))
             ((when (or (prefixp (list #x23) input1) ; # [SC8]
                        (prefixp (list #x27) input1) ; ' [SC8]
                        (prefixp (list #x22) input1))) ; " [SC8]
              (mv (reserrf (list :reserved-prefix (list #x5f))) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "token")
               :branches (list (list tree)))
              input1)))
       ((when (and (<= #x30 nat) (<= nat #x39))) ; digit
        (b* (((mv tree input1) (lex-integer-literal input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "token")
               :branches (list (list tree)))
              input1)))
       ((when (or (eql nat #x28) (eql nat #x29) ; ( )
                  (eql nat #x5b) (eql nat #x5d) ; [ ]
                  (eql nat #x7b) (eql nat #x7d))) ; { }
        (b* (((mv tree input1) (lex-delimiter input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "token")
               :branches (list (list tree)))
              input1)))
       ((mv tree input1) (lex-punctuation input))
       ((when (reserrp tree)) (mv (reserrf-push tree) input)))
    (mv (abnf::make-tree-nonleaf
         :rulename? (abnf::rulename "token")
         :branches (list (list tree)))
        input1))
  :prepwork
  ((define lex-token-identifier-or-keyword ((input nat-listp))
     :returns (mv (tree abnf::tree-resultp)
                  (rest-input nat-listp))
     :parents nil
     (b* ((input (nat-list-fix input))
          ((mv tree input1) (lex-identifier-or-keyword input))
          ((when (reserrp tree)) (mv (reserrf-push tree) input))
          ((when (or (prefixp (list #x23) input1) ; # [SC8]
                     (prefixp (list #x27) input1) ; ' [SC8]
                     (prefixp (list #x22) input1))) ; " [SC8]
           (mv (reserrf (list :reserved-prefix
                              (abnf::tree->string tree)))
               input)))
       (mv (abnf::make-tree-nonleaf
            :rulename? (abnf::rulename "token")
            :branches (list (list tree)))
           input1))
     ///
     (defret len-of-lex-token-identifier-or-keyword-<=
       (<= (len rest-input) (len input))
       :rule-classes :linear)
     (defret len-of-lex-token-identifier-or-keyword-<
       (implies (not (reserrp tree))
                (< (len rest-input) (len input)))
       :rule-classes :linear)
     (defret input-decomposition-of-lex-token-identifier-or-keyword
       (implies (not (reserrp tree))
                (equal (append (abnf::tree->string tree) rest-input)
                       (nat-list-fix input)))
       :hints (("Goal" :in-theory (enable abnf::tree->string
                                          abnf::tree-list->string
                                          abnf::tree-list-list->string))))
     (defret cst-matchp-of-lex-token-identifier-or-keyword
       (implies (not (reserrp tree))
                (cst-matchp tree "token"))
       :hints (("Goal"
                :in-theory
                (enable cst-matchp
                        tree-match-of-make-tree-nonleaf-elem
                        tree-match-element-p-when-cst-matchp$
                        tree-terminatedp-of-lex-identifier-or-keyword
                        abnf::tree-terminatedp
                        abnf::tree-list-terminatedp
                        abnf::tree-list-list-terminatedp
                        abnf::tree-list-list-match-alternation-p
                        abnf::tree-list-list-match-concatenation-p
                        abnf::tree-list-match-repetition-p
                        abnf::tree-list-match-element-p
                        abnf::numrep-match-repeat-range-p))))
     (defret tree-terminatedp-of-lex-token-identifier-or-keyword
       (implies (not (reserrp tree))
                (abnf::tree-terminatedp tree))
       :hints (("Goal" :use cst-matchp-of-lex-token-identifier-or-keyword
                       :in-theory
                       (union-theories (theory 'acl2::minimal-theory)
                                       '((:definition cst-matchp$))))))))
  ///

  (defret len-of-lex-token-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear
    :hints (("Goal" :in-theory (enable abnf::parse-next))))

  (defret len-of-lex-token-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear
    :hints (("Goal" :in-theory (enable abnf::parse-next))))

  (defret input-decomposition-of-lex-token
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal" :in-theory (enable abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (defret cst-matchp-of-lex-token
    (implies (not (reserrp tree))
             (cst-matchp tree "token"))
    :hints (("Goal"
             :in-theory
             (enable cst-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-terminatedp-of-lex-raw-identifier
                     tree-terminatedp-of-lex-char-literal
                     tree-terminatedp-of-lex-byte-literal
                     tree-terminatedp-of-lex-string-literal
                     tree-terminatedp-of-lex-byte-string-literal
                     tree-terminatedp-of-lex-c-string-literal
                     tree-terminatedp-of-lex-raw-string-literal
                     tree-terminatedp-of-lex-raw-byte-string-literal
                     tree-terminatedp-of-lex-raw-c-string-literal
                     tree-terminatedp-of-lex-integer-literal
                     tree-terminatedp-of-lex-punctuation
                     tree-terminatedp-of-lex-delimiter
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-list-match-element-p
                     abnf::numrep-match-repeat-range-p))))

  (defret tree-terminatedp-of-lex-token
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :hints (("Goal" :use cst-matchp-of-lex-token
                    :in-theory
                    (union-theories (theory 'acl2::minimal-theory)
                                    '((:definition cst-matchp$)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lex-lexeme ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex a @('lexeme')."
  :long
  (xdoc::topstring
   (xdoc::p
    "Whitespace is attempted first
     (it fails immediately on a non-whitespace character);
     then, if the input starts with @('//') or @('/*'),
     a comment is lexed (it cannot be a token);
     otherwise a token is lexed."))
  (b* (((mv tree input1) (lex-whitespace input))
       ((when (not (reserrp tree)))
        (mv (abnf::make-tree-nonleaf
             :rulename? (abnf::rulename "lexeme")
             :branches (list (list tree)))
            input1))
       (input (nat-list-fix input))
       ((when (or (prefixp (list #x2f #x2f) input)
                  (prefixp (list #x2f #x2a) input)))
        (b* (((mv tree input1) (lex-comment input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "lexeme")
               :branches (list (list tree)))
              input1)))
       ((mv tree input1) (lex-token input))
       ((when (reserrp tree)) (mv (reserrf-push tree) input)))
    (mv (abnf::make-tree-nonleaf
         :rulename? (abnf::rulename "lexeme")
         :branches (list (list tree)))
        input1))
  ///

  (defret len-of-lex-lexeme-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-lexeme-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear)

  (defret input-decomposition-of-lex-lexeme
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal" :in-theory (enable abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (defret cst-matchp-of-lex-lexeme
    (implies (not (reserrp tree))
             (cst-matchp tree "lexeme"))
    :hints (("Goal"
             :in-theory
             (enable cst-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-terminatedp-of-lex-whitespace
                     tree-terminatedp-of-lex-comment
                     tree-terminatedp-of-lex-token
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-list-match-element-p
                     abnf::numrep-match-repeat-range-p))))

  (defret tree-terminatedp-of-lex-lexeme
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :hints (("Goal" :use cst-matchp-of-lex-lexeme
                    :in-theory
                    (union-theories (theory 'acl2::minimal-theory)
                                    '((:definition cst-matchp$)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(def-lex-repetition lex-*-lexeme
  lex-lexeme "lexeme" "*lexeme")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lexemize-rust ((input nat-listp))
  :returns (trees abnf::tree-list-resultp)
  :short "Lex the input into a list of lexeme CSTs."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the top-level lexing function:
     it lexes as many lexemes as possible [SC1],
     and it fails if any input remains.")
   (xdoc::p
    "The returned CSTs are terminated,
     they match the @('lexeme') rule,
     and their strings concatenate to the input:
     see the theorems below.
     The further properties in @(tsee lexing-okp)
     (maximal munch and the other side conditions)
     are future work."))
  (b* (((mv trees rest-input) (lex-*-lexeme input))
       ((when (consp rest-input))
        (reserrf (list :cannot-lex-rest-of-input rest-input))))
    trees)
  ///

  (defret tree-list-terminatedp-of-lexemize-rust
    (implies (not (reserrp trees))
             (abnf::tree-list-terminatedp trees)))

  (defret cst-list-elem-matchp-of-lexemize-rust
    (implies (not (reserrp trees))
             (cst-list-elem-matchp trees "lexeme")))

  (defret input-coverage-of-lexemize-rust
    (implies (not (reserrp trees))
             (equal (abnf::tree-list->string trees)
                    (nat-list-fix input)))
    :hints (("Goal"
             :use (input-decomposition-of-lex-*-lexeme
                   nat-listp-of-lex-*-lexeme.rest-input)
             :in-theory (disable input-decomposition-of-lex-*-lexeme
                                 nat-listp-of-lex-*-lexeme.rest-input)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lexemize-rust-from-string ((string stringp))
  :returns (trees abnf::tree-list-resultp)
  :short "Lex an ACL2 string into a list of lexeme CSTs."
  :long
  (xdoc::topstring
   (xdoc::p
    "The string's character codes become the input;
     since ACL2 characters have codes below 256,
     this covers all ASCII inputs.
     Non-ASCII whitespace, comment content, and literal content
     need Unicode input, i.e. a call of @(tsee lexemize-rust)
     on code points, until the UTF-8 layer is in place
     (identifiers are ASCII-only for now)."))
  (lexemize-rust (acl2::string=>nats (str-fix string))))
