(define lex-identifier-continue ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex an @('identifier-continue')."
  (b* (((mv tree1 input1) (lex-ascii-letter input))
       ((when (not (reserrp tree1)))
        (mv (abnf::make-tree-nonleaf
             :rulename? (abnf::rulename "identifier-continue")
             :branches (list (list tree1)))
            input1))
       ((mv tree1 input1) (lex-dec-digit input))
       ((when (not (reserrp tree1)))
        (mv (abnf::make-tree-nonleaf
             :rulename? (abnf::rulename "identifier-continue")
             :branches (list (list tree1)))
            input1))
       ((mv tree1 input1) (abnf::parse-ichars "_" input))
       ((when (not (reserrp tree1)))
        (mv (abnf::make-tree-nonleaf
             :rulename? (abnf::rulename "identifier-continue")
             :branches (list (list tree1)))
            input1)))
    (mv (reserrf (list :found (list-head-for-error input)
                       :required "identifier-continue"))
        (nat-list-fix input)))
  :prepwork
  ((define list-head-for-error ((input nat-listp))
     :returns (head nat-listp)
     :parents nil
     (if (consp input)
         (list (lnfix (car input)))
       nil)))
  ///

  (defret len-of-lex-identifier-continue-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-identifier-continue-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear)

  (defret input-decomposition-of-lex-identifier-continue
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal" :in-theory (enable input-decomposition-of-parse-ichars
                                       abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (defret cst-matchp-of-lex-identifier-continue
    (implies (not (reserrp tree))
             (cst-matchp tree "identifier-continue"))
    :hints (("Goal"
             :in-theory
             (enable cst-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-match-of-parse-ichars-elem
                     tree-terminatedp-of-parse-ichars
                     tree-terminatedp-of-lex-ascii-letter
                     tree-terminatedp-of-lex-dec-digit
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p))))

  (defret tree-terminatedp-of-lex-identifier-continue
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :hints (("Goal" :use cst-matchp-of-lex-identifier-continue
                    :in-theory (enable cst-matchp)))))

