;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lex-identifier-or-keyword ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex an @('identifier-or-keyword')."
  :long
  (xdoc::topstring
   (xdoc::p
    "The two alternatives are dispatched on the first character:
     an ASCII letter starts the first alternative,
     an underscore (which must be followed by
     at least one @('identifier-continue')) the second one.
     A lone underscore is not an identifier
     (it is a punctuation token),
     so if no @('identifier-continue') follows the underscore
     lexing fails here."))
  (b* (((mv tree1 input1) (lex-identifier-start input))
       ((when (not (reserrp tree1)))
        (b* (((mv trees2 input2) (lex-*-identifier-continue input1)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "identifier-or-keyword")
               :branches (list (list tree1) trees2))
              input2)))
       ((mv tree1 input1) (abnf::parse-ichars "_" input))
       ((when (reserrp tree1))
        (mv (reserrf-push tree1) (nat-list-fix input)))
       ((mv tree2 input2) (lex-identifier-continue input1))
       ((when (reserrp tree2))
        (mv (reserrf-push tree2) (nat-list-fix input)))
       ((mv trees3 input3) (lex-*-identifier-continue input2)))
    (mv (abnf::make-tree-nonleaf
         :rulename? (abnf::rulename "identifier-or-keyword")
         :branches (list (list tree1) (cons tree2 trees3)))
        input3))
  ///

  (defret len-of-lex-identifier-or-keyword-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-identifier-or-keyword-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear)

  (defret input-decomposition-of-lex-identifier-or-keyword
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal" :in-theory (enable input-decomposition-of-parse-ichars
                                       abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (defret cst-matchp-of-lex-identifier-or-keyword
    (implies (not (reserrp tree))
             (cst-matchp tree "identifier-or-keyword"))
    :hints (("Goal"
             :in-theory
             (enable cst-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-list-match-element-p-when-cst-list-elem-matchp$
                     tree-list-match-repetition-p-when-cst-list-rep-matchp$
                     tree-match-of-parse-ichars-elem
                     tree-terminatedp-of-parse-ichars
                     tree-terminatedp-of-lex-identifier-start
                     tree-terminatedp-of-lex-identifier-continue
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-list-match-element-p
                     abnf::numrep-match-repeat-range-p))))

  (defret tree-terminatedp-of-lex-identifier-or-keyword
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :hints (("Goal" :use cst-matchp-of-lex-identifier-or-keyword
                    :in-theory (enable cst-matchp)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lex-raw-identifier ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex a @('raw-identifier')."
  :long
  (xdoc::topstring
   (xdoc::p
    "The [SC5] exclusions
     (a raw identifier must not be
     @('crate'), @('self'), @('super'), or @('Self'))
     are enforced in the tokenizer,
     which inspects the identifier text;
     here we lex any @('r#') followed by
     an @('identifier-or-keyword')."))
  (b* (((mv tree1 input1) (abnf::parse-schars "r#" input))
       ((when (reserrp tree1))
        (mv (reserrf-push tree1) (nat-list-fix input)))
       ((mv tree2 input2) (lex-identifier-or-keyword input1))
       ((when (reserrp tree2))
        (mv (reserrf-push tree2) (nat-list-fix input))))
    (mv (abnf::make-tree-nonleaf
         :rulename? (abnf::rulename "raw-identifier")
         :branches (list (list tree1) (list tree2)))
        input2))
  ///

  (defret len-of-lex-raw-identifier-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-raw-identifier-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear)

  (defret input-decomposition-of-lex-raw-identifier
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal" :in-theory (enable input-decomposition-of-parse-schars
                                       abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (defret cst-matchp-of-lex-raw-identifier
    (implies (not (reserrp tree))
             (cst-matchp tree "raw-identifier"))
    :hints (("Goal"
             :in-theory
             (enable cst-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-match-of-parse-schars-elem
                     tree-terminatedp-of-parse-schars
                     tree-terminatedp-of-lex-identifier-or-keyword
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-list-match-element-p
                     abnf::numrep-match-repeat-range-p))))

  (defret tree-terminatedp-of-lex-raw-identifier
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :hints (("Goal" :use cst-matchp-of-lex-raw-identifier
                    :in-theory (enable cst-matchp)))))

