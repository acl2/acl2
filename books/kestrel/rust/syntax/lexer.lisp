(defsection tree-construction-theorems
  :short "Theorems for building CSTs that match grammar elements."
  :long
  (xdoc::topstring
   (xdoc::p
    "The theorems generated by @(tsee abnf::deftreeops)
     go in the destruction direction:
     from a tree matching a rule name
     to properties of its constituents.
     The lexing functions need the construction direction:
     a non-leaf tree matches a rule name (or group or option element)
     if its branches match the corresponding alternation.
     This is essentially the definition of
     @(tsee abnf::tree-match-element-p),
     specialized to our grammar.")
   (xdoc::p
    "The @('-elem') variants have an @('(equal elem ...)') hypothesis
     instead of an element constructor in the conclusion:
     in proofs about the lexing functions,
     the element appears as a quoted constant
     (the @('cst-matchp') predicates expand to
     constant elements parsed from
     the ABNF concrete syntax notation),
     which does not unify with a constructor term;
     the hypothesis is instead relieved by evaluation.
     These theorems are also candidates for
     @(tsee abnf::deftreeops) to generate."))

  (defruled tree-match-of-make-tree-nonleaf
    (implies (and (abnf::rulenamep rulename)
                  (abnf::tree-list-list-match-alternation-p
                   branches
                   (abnf::lookup-rulename rulename *lexical-grammar*)
                   *lexical-grammar*))
             (abnf::tree-match-element-p
              (abnf::make-tree-nonleaf :rulename? rulename
                                       :branches branches)
              (abnf::element-rulename rulename)
              *lexical-grammar*))
    :expand ((abnf::tree-match-element-p
              (abnf::tree-nonleaf rulename branches)
              (abnf::element-rulename rulename)
              *lexical-grammar*)))

  (defruled tree-match-of-make-tree-nonleaf-elem
    (implies (and (abnf::rulenamep rulename)
                  (equal elem (abnf::element-rulename rulename))
                  (abnf::tree-list-list-match-alternation-p
                   branches
                   (abnf::lookup-rulename rulename *lexical-grammar*)
                   *lexical-grammar*))
             (abnf::tree-match-element-p
              (abnf::make-tree-nonleaf :rulename? rulename
                                       :branches branches)
              elem
              *lexical-grammar*))
    :hints (("Goal" :use tree-match-of-make-tree-nonleaf
                    :in-theory (theory 'acl2::minimal-theory))))

  (defruled tree-match-of-make-tree-nonleaf-group
    (implies (abnf::tree-list-list-match-alternation-p
              branches alt *lexical-grammar*)
             (abnf::tree-match-element-p
              (abnf::make-tree-nonleaf :rulename? nil
                                       :branches branches)
              (abnf::element-group alt)
              *lexical-grammar*))
    :expand ((abnf::tree-match-element-p
              (abnf::tree-nonleaf nil branches)
              (abnf::element-group alt)
              *lexical-grammar*)))

  (defruled tree-match-of-make-tree-nonleaf-group-elem
    (implies (and (equal (abnf::element-kind elem) :group)
                  (abnf::tree-list-list-match-alternation-p
                   branches
                   (abnf::element-group->get elem)
                   *lexical-grammar*))
             (abnf::tree-match-element-p
              (abnf::make-tree-nonleaf :rulename? nil
                                       :branches branches)
              elem
              *lexical-grammar*))
    :use (:instance tree-match-of-make-tree-nonleaf-group
                    (alt (abnf::element-group->get elem))))

  (defruled tree-match-of-make-tree-nonleaf-option
    (implies (or (abnf::tree-list-list-match-alternation-p
                  branches alt *lexical-grammar*)
                 (equal branches nil))
             (abnf::tree-match-element-p
              (abnf::make-tree-nonleaf :rulename? nil
                                       :branches branches)
              (abnf::element-option alt)
              *lexical-grammar*))
    :expand ((abnf::tree-match-element-p
              (abnf::tree-nonleaf nil branches)
              (abnf::element-option alt)
              *lexical-grammar*)
             (abnf::tree-match-element-p
              '(:nonleaf nil nil)
              (abnf::element-option alt)
              *lexical-grammar*)))

  (defruled tree-match-of-make-tree-nonleaf-option-elem
    (implies (and (equal (abnf::element-kind elem) :option)
                  (or (abnf::tree-list-list-match-alternation-p
                       branches
                       (abnf::element-option->get elem)
                       *lexical-grammar*)
                      (equal branches nil)))
             (abnf::tree-match-element-p
              (abnf::make-tree-nonleaf :rulename? nil
                                       :branches branches)
              elem
              *lexical-grammar*))
    :use (:instance tree-match-of-make-tree-nonleaf-option
                    (alt (abnf::element-option->get elem)))))

