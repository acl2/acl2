; The :no-function nil is needed because fty::reserrf and fty::reserrf-push
; (used pervasively in this defresult-style book) expand to terms
; that mention __function__, which define binds
; only when :no-function is nil.
(acl2::controlled-configuration :no-function nil)

; These rules bridge the fty::defresult idiom to the underlying types:
; a result that is not an error is a value of the ok type.
; They are needed throughout this book,
; for guard verification and return type theorems.
(local (in-theory (enable acl2::natp-when-result-not-error
                          acl2::nat-listp-when-result-not-error
                          abnf::treep-when-result-not-error
                          abnf::tree-listp-when-result-not-error)))

; These trivial bridges let arithmetic guard obligations
; (rationalp, acl2-numberp, integerp)
; be discharged from natp facts that arrive via rewriting
; (in particular via natp-when-result-not-error above).
; The C lexer (c/syntax/lexer.lisp) defines the same three rules,
; there enabled via per-function guard hints;
; here they are enabled book-wide instead.
(local (defrule rationalp-when-natp
         (implies (natp x) (rationalp x))))
(local (defrule acl2-numberp-when-natp
         (implies (natp x) (acl2-numberp x))))
(local (defrule integerp-when-natp
         (implies (natp x) (integerp x))))

