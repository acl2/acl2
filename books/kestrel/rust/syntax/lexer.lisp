(define lex-unicode-escape-groups ((n natp) (input nat-listp))
  :returns (mv (trees abnf::tree-listp)
               (rest-input nat-listp))
  :short "Lex at most @('n') @('( hex-digit *\"_\" )') groups,
          as many as possible."
