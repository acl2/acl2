(defsection def-lex-repetition
  :short "Event macro to define a greedy lexing function for
          a @('*') repetition of an element."
  :long
  (xdoc::topstring
   (xdoc::p
    "Given a lexing function for an element
     (a rule name or an anonymous group),
     this macro generates a lexing function that
     lexes as many instances of the element as possible [SC1],
     returning the list of their CSTs;
     it never fails (zero instances yield @('nil')).")
   (xdoc::p
    "The generated theorems are the standard ones (see @(see lexer)),
     with the grammar soundness ones in two forms:
     matching of the list against the element
     and against the whole @('*') repetition."))

  (defmacro def-lex-repetition (fn-name elem-fn elem-string rep-string)
    (b* ((len<=-thm (acl2::packn-pos (list 'len-of- fn-name '-<=) fn-name))
         (decomp-thm (acl2::packn-pos (list 'input-decomposition-of- fn-name)
                                      fn-name))
         (term-thm (acl2::packn-pos (list 'tree-list-terminatedp-of- fn-name)
                                    fn-name))
         (elem-match-thm (acl2::packn-pos (list 'cst-list-elem-matchp-of-
                                               fn-name)
                                          fn-name))
         (rep-match-thm (acl2::packn-pos (list 'cst-list-rep-matchp-of-
                                              fn-name)
                                         fn-name))
         (callee-match-thm (acl2::packn-pos (list 'cst-matchp-of- elem-fn)
                                            fn-name))
         (callee-term-thm (acl2::packn-pos (list 'tree-terminatedp-of-
                                                elem-fn)
                                           fn-name)))
      `(define ,fn-name ((input nat-listp))
         :returns (mv (trees abnf::tree-listp)
                      (rest-input nat-listp))
         :short ,(acl2::concatenate 'acl2::string
                                    "Lex a @('" rep-string "').")
         :measure (len input)
         (b* (((mv tree input1) (,elem-fn input))
              ((when (reserrp tree)) (mv nil (nat-list-fix input)))
              ((mv trees input2) (,fn-name input1)))
           (mv (cons tree trees) input2))
         ///
         (defret ,len<=-thm
           (<= (len rest-input) (len input))
           :rule-classes :linear
           :hints (("Goal" :induct t :in-theory (enable ,fn-name))))
         (defret ,decomp-thm
           (equal (append (abnf::tree-list->string trees) rest-input)
                  (nat-list-fix input))
           :hints (("Goal"
                    :induct t
                    :in-theory (enable ,fn-name
                                       abnf::tree-list->string))))
         (defret ,term-thm
           (abnf::tree-list-terminatedp trees)
           :hints (("Goal"
                    :induct t
                    :in-theory (enable ,fn-name
                                       ,callee-term-thm
                                       abnf::tree-list-terminatedp))))
         (defret ,elem-match-thm
           (cst-list-elem-matchp trees ,elem-string)
           :hints (("Goal"
                    :induct t
                    :in-theory
                    (enable ,fn-name
                            cst-list-elem-matchp
                            tree-match-element-p-when-cst-matchp$
                            ,callee-match-thm
                            ,callee-term-thm
                            abnf::tree-list-match-element-p
                            abnf::tree-list-terminatedp))))
         (defret ,rep-match-thm
           (cst-list-rep-matchp trees ,rep-string)
           :hints (("Goal"
                    :in-theory
                    (enable cst-list-rep-matchp
                            tree-list-match-element-p-when-cst-list-elem-matchp$
                            abnf::tree-list-match-repetition-p
                            abnf::numrep-match-repeat-range-p))))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(def-lex-repetition lex-*-whitespace-char
  lex-whitespace-char "whitespace-char" "*whitespace-char")

(def-lex-repetition lex-*-identifier-continue
  lex-identifier-continue "identifier-continue" "*identifier-continue")

(def-lex-repetition lex-*-not-lf
  lex-not-lf "not-lf" "*not-lf")

