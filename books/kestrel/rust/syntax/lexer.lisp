(defsection def-lex-radix-literal
  :short "Event macro to define the lexing functions for
          the radix-prefixed integer literal rules."
  :long
  (xdoc::topstring
   (xdoc::p
    "The rules @('bin-literal'), @('oct-literal'), and @('hex-literal')
     all have the form")
   (xdoc::codeblock
    "x-literal = prefix *( x-digit / \"_\" ) x-digit *( x-digit / \"_\" )")
   (xdoc::p
    "Lexing commits to the radix after the prefix [SC7]:
     underscores before the first digit
     become the first repetition,
     the first digit becomes the mandatory element,
     and everything after it (digits and underscores, greedily)
     becomes the second repetition.
     If there is no digit, lexing fails
     (e.g. @('0b') and @('0b_') do not lex, per [SC7]).
     If a decimal digit immediately follows the literal
     (e.g. @('0b102')), lexing also fails:
     this is a reserved form [SC7]."))

  (defmacro def-lex-radix-literal (fn-name
                                   prefix-string
                                   rulename
                                   underscores-fn
                                   digit-fn
                                   items-fn)
    (b* ((len<=-thm (acl2::packn-pos (list 'len-of- fn-name '-<=) fn-name))
         (len<-thm (acl2::packn-pos (list 'len-of- fn-name '-<) fn-name))
         (decomp-thm (acl2::packn-pos (list 'input-decomposition-of- fn-name)
                                      fn-name))
         (term-thm (acl2::packn-pos (list 'tree-terminatedp-of- fn-name)
                                    fn-name))
         (match-thm (acl2::packn-pos (list 'cst-matchp-of- fn-name) fn-name))
         (underscores-decomp-thm (acl2::packn-pos
                                  (list 'input-decomposition-of-
                                        underscores-fn)
                                  fn-name))
         (underscores-term-thm (acl2::packn-pos
                                (list 'tree-list-terminatedp-of-
                                      underscores-fn)
                                fn-name))
         (underscores-match-thm (acl2::packn-pos
                                 (list 'cst-list-elem-matchp-of-
                                       underscores-fn)
                                 fn-name))
         (digit-match-thm (acl2::packn-pos (list 'cst-matchp-of- digit-fn)
                                           fn-name))
         (digit-term-thm (acl2::packn-pos (list 'tree-terminatedp-of-
                                               digit-fn)
                                          fn-name))
         (items-rep-match-thm (acl2::packn-pos
                               (list 'cst-list-rep-matchp-of- items-fn)
                               fn-name)))
      `(define ,fn-name ((input nat-listp))
         :returns (mv (tree abnf::tree-resultp)
                      (rest-input nat-listp))
         :short ,(acl2::concatenate 'acl2::string
                                    "Lex a @('" rulename "').")
         (b* (((mv tree-prefix input1) (abnf::parse-schars ,prefix-string
                                                           input))
              ((when (reserrp tree-prefix))
               (mv (reserrf-push tree-prefix) (nat-list-fix input)))
              ((mv trees-lead input2) (,underscores-fn input1))
              ((mv tree-digit input3) (,digit-fn input2))
              ((when (reserrp tree-digit)) ; [SC7]: no digits
               (mv (reserrf (list :no-digits-after ,prefix-string))
                   (nat-list-fix input)))
              ((mv trees-tail input4) (,items-fn input3))
              ((mv tree-probe &) (lex-dec-digit input4))
              ((when (not (reserrp tree-probe))) ; [SC7]: reserved form
               (mv (reserrf (list :decimal-digit-after ,rulename))
                   (nat-list-fix input))))
           (mv (abnf::make-tree-nonleaf
                :rulename? (abnf::rulename ,rulename)
                :branches (list (list tree-prefix)
                                trees-lead
                                (list tree-digit)
                                trees-tail))
               input4))
         ///
         (defret ,len<=-thm
           (<= (len rest-input) (len input))
           :rule-classes :linear)
         (defret ,len<-thm
           (implies (not (reserrp tree))
                    (< (len rest-input) (len input)))
           :rule-classes :linear)
         (defret ,decomp-thm
           (implies (not (reserrp tree))
                    (equal (append (abnf::tree->string tree) rest-input)
                           (nat-list-fix input)))
           :hints (("Goal"
                    :in-theory (enable input-decomposition-of-parse-schars
                                       ,underscores-decomp-thm
                                       abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))
         (defret ,match-thm
           (implies (not (reserrp tree))
                    (cst-matchp tree ,rulename))
           :hints (("Goal"
                    :in-theory
                    (enable cst-matchp
                            tree-match-of-make-tree-nonleaf-elem
                            tree-match-element-p-when-cst-matchp$
                            tree-list-match-element-p-when-cst-list-elem-matchp$
                            tree-list-match-repetition-p-when-cst-list-rep-matchp$
                            tree-match-of-parse-schars-elem
                            tree-terminatedp-of-parse-schars
                            ,underscores-term-thm
                            ,underscores-match-thm
                            ,digit-match-thm
                            ,digit-term-thm
                            ,items-rep-match-thm
                            abnf::tree-terminatedp
                            abnf::tree-list-terminatedp
                            abnf::tree-list-list-terminatedp
                            abnf::tree-list-list-match-alternation-p
                            abnf::tree-list-list-match-concatenation-p
                            abnf::tree-list-match-repetition-p
                            abnf::tree-list-match-element-p
                            abnf::numrep-match-repeat-range-p))))
         (defret ,term-thm
           (implies (not (reserrp tree))
                    (abnf::tree-terminatedp tree))
           :hints (("Goal" :use ,match-thm
                           :in-theory (enable cst-matchp))))))))

