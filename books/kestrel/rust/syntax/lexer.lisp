(defsection cst-matchp-bridge-theorems
  :short "Theorems bridging the @('cst-matchp') predicates
          to their tree matching content."
  :long
  (xdoc::topstring
   (xdoc::p
    "A lexing function's grammar soundness theorem
     states @('cst-matchp') of the returned tree,
     which conjoins terminatedness and matching.
     A caller's soundness proof needs the matching conjunct
     in @(tsee abnf::tree-match-element-p) form,
     because that is the form in which the obligation arises
     when unfolding the matching of the caller's larger tree.
     These rules extract the conjuncts by backchaining."))

  (defruled tree-match-element-p-when-cst-matchp$
    (implies (cst-matchp$ tree elem)
             (abnf::tree-match-element-p tree elem *lexical-grammar*))
    :enable cst-matchp$)

  (defruled tree-list-match-repetition-p-when-cst-list-rep-matchp$
    (implies (cst-list-rep-matchp$ trees rep)
             (abnf::tree-list-match-repetition-p trees
                                                 rep
                                                 *lexical-grammar*))
    :enable cst-list-rep-matchp$)

  (defruled tree-list-match-element-p-when-cst-list-elem-matchp$
    (implies (cst-list-elem-matchp$ trees elem)
             (abnf::tree-list-match-element-p trees
                                              elem
                                              *lexical-grammar*))
    :enable cst-list-elem-matchp$))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defsection def-lex-char-class
  :short "Event macro to define a lexing function for
          a character class rule."
  :long
  (xdoc::topstring
   (xdoc::p
    "Several rules of the lexical grammar are character classes:
     alternations of single-character numeric values (and ranges).
     Their lexing functions are all instances of one pattern:
     read the next character,
     check that it satisfies the class condition,
     and build a CST with the character as a terminal leaf.
     This macro generates the lexing function and its theorems
     from the rule name and the class condition
     (a term over the variable @('nat')).")
   (xdoc::p
    "The generated theorems are the standard ones
     (see @(see lexer)):
     length bounds, input decomposition,
     terminatedness, and grammar soundness."))

  (defmacro def-lex-char-class (rulename condition)
    (b* ((fn-name (acl2::packn-pos (list 'lex- (acl2::string-upcase rulename))
                                   'lex-whitespace-char))
         (len<=-thm (acl2::packn-pos (list 'len-of- fn-name '-<=) fn-name))
         (len<-thm (acl2::packn-pos (list 'len-of- fn-name '-<) fn-name))
         (decomp-thm (acl2::packn-pos (list 'input-decomposition-of- fn-name)
                                      fn-name))
         (term-thm (acl2::packn-pos (list 'tree-terminatedp-of- fn-name)
                                    fn-name))
         (match-thm (acl2::packn-pos (list 'cst-matchp-of- fn-name) fn-name)))
      `(define ,fn-name ((input nat-listp))
         :returns (mv (tree abnf::tree-resultp)
                      (rest-input nat-listp))
         :short ,(acl2::concatenate 'acl2::string "Lex a @('" rulename "').")
         (b* (((mv nat? input1) (abnf::parse-next input))
              ((when (reserrp nat?))
               (mv (reserrf-push nat?) (nat-list-fix input)))
              (nat (lnfix nat?))
              ((unless ,condition)
               (mv (reserrf (list :found nat :required ,rulename))
                   (nat-list-fix input))))
           (mv (abnf::make-tree-nonleaf
                :rulename? (abnf::rulename ,rulename)
                :branches (list (list (abnf::tree-leafterm (list nat)))))
               input1))
         ///
         (defret ,len<=-thm
           (<= (len rest-input) (len input))
           :rule-classes :linear)
         (defret ,len<-thm
           (implies (not (reserrp tree))
                    (< (len rest-input) (len input)))
           :rule-classes :linear)
         (defret ,decomp-thm
           (implies (not (reserrp tree))
                    (equal (append (abnf::tree->string tree) rest-input)
                           (nat-list-fix input)))
           :hints (("Goal" :in-theory (enable abnf::parse-next
                                              abnf::tree->string))))
         (defret ,match-thm
           (implies (not (reserrp tree))
                    (cst-matchp tree ,rulename))
           :hints (("Goal"
                    :in-theory
                    (enable abnf::parse-next
                            cst-matchp
                            tree-match-of-make-tree-nonleaf-elem
                            abnf::tree-terminatedp
                            abnf::tree-list-terminatedp
                            abnf::tree-list-list-terminatedp
                            abnf::tree-list-list-match-alternation-p
                            abnf::tree-list-list-match-concatenation-p
                            abnf::tree-list-match-repetition-p
                            abnf::tree-match-element-p
                            abnf::tree-match-num-val-p))))
         (defret ,term-thm
           (implies (not (reserrp tree))
                    (abnf::tree-terminatedp tree))
           :hints (("Goal" :use ,match-thm
                           :in-theory (enable cst-matchp))))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(def-lex-char-class "whitespace-char"
  (or (eql nat #x9) ; horizontal tab
      (eql nat #xa) ; line feed
      (eql nat #xb) ; vertical tab
      (eql nat #xc) ; form feed
      (eql nat #xd) ; carriage return
      (eql nat #x20) ; space
      (eql nat #x85) ; next line
      (eql nat #x200e) ; left-to-right mark
      (eql nat #x200f) ; right-to-left mark
      (eql nat #x2028) ; line separator
      (eql nat #x2029))) ; paragraph separator

(def-lex-char-class "ascii-letter"
  (or (and (<= #x41 nat) (<= nat #x5a))
      (and (<= #x61 nat) (<= nat #x7a))))

(def-lex-char-class "ascii-letter-no-e"
  (or (and (<= #x41 nat) (<= nat #x44))
      (and (<= #x46 nat) (<= nat #x5a))
      (and (<= #x61 nat) (<= nat #x64))
      (and (<= #x66 nat) (<= nat #x7a))))

(def-lex-char-class "dec-digit"
  (and (<= #x30 nat) (<= nat #x39)))

(def-lex-char-class "bin-digit"
  (and (<= #x30 nat) (<= nat #x31)))

(def-lex-char-class "oct-digit"
  (and (<= #x30 nat) (<= nat #x37)))

(def-lex-char-class "not-lf"
  (or (<= nat #x9)
      (and (<= #xb nat) (<= nat #xd7ff))
      (and (<= #xe000 nat) (<= nat #x10ffff))))

(def-lex-char-class "not-slash-bang-lf"
  (or (<= nat #x9)
      (and (<= #xb nat) (<= nat #x20))
      (and (<= #x22 nat) (<= nat #x2e))
      (and (<= #x30 nat) (<= nat #xd7ff))
      (and (<= #xe000 nat) (<= nat #x10ffff))))

(def-lex-char-class "not-slash-lf"
  (or (<= nat #x9)
      (and (<= #xb nat) (<= nat #x2e))
      (and (<= #x30 nat) (<= nat #xd7ff))
      (and (<= #xe000 nat) (<= nat #x10ffff))))

(def-lex-char-class "not-star-slash"
  (or (<= nat #x29)
      (and (<= #x2b nat) (<= nat #x2e))
      (and (<= #x30 nat) (<= nat #xd7ff))
      (and (<= #xe000 nat) (<= nat #x10ffff))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lex-hex-digit ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex a @('hex-digit')."
  :long
  (xdoc::topstring
   (xdoc::p
    "This rule is not a plain character class:
     its first alternative is the rule name @('dec-digit'),
     so for a decimal digit the CST has a @('dec-digit') subtree."))
  (b* (((mv tree1 input1) (lex-dec-digit input))
       ((when (not (reserrp tree1)))
        (mv (abnf::make-tree-nonleaf
             :rulename? (abnf::rulename "hex-digit")
             :branches (list (list tree1)))
            input1))
       ((mv nat? input1) (abnf::parse-next input))
       ((when (reserrp nat?))
        (mv (reserrf-push nat?) (nat-list-fix input)))
       (nat (lnfix nat?))
       ((unless (or (and (<= #x41 nat) (<= nat #x46))
                    (and (<= #x61 nat) (<= nat #x66))))
        (mv (reserrf (list :found nat :required "hex-digit"))
            (nat-list-fix input))))
    (mv (abnf::make-tree-nonleaf
         :rulename? (abnf::rulename "hex-digit")
         :branches (list (list (abnf::tree-leafterm (list nat)))))
        input1))
  ///

  (defret len-of-lex-hex-digit-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-hex-digit-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear)

  (defret input-decomposition-of-lex-hex-digit
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal" :in-theory (enable abnf::parse-next
                                       abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (defret cst-matchp-of-lex-hex-digit
    (implies (not (reserrp tree))
             (cst-matchp tree "hex-digit"))
    :hints (("Goal"
             :in-theory
             (enable abnf::parse-next
                     cst-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-terminatedp-of-lex-dec-digit
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-match-element-p
                     abnf::tree-match-num-val-p))))

  (defret tree-terminatedp-of-lex-hex-digit
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :hints (("Goal" :use cst-matchp-of-lex-hex-digit
                    :in-theory (enable cst-matchp)))))

