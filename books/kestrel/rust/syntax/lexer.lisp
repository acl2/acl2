(defsection def-lex-digit/underscore-fns
  :short "Event macros to define the lexing functions for
          the digit-or-underscore groups of the integer literal rules."
  :long
  (xdoc::topstring
   (xdoc::p
    "Each of the rules
     @('dec-literal'), @('bin-literal'),
     @('oct-literal'), and @('hex-literal')
     uses an anonymous group @('( <radix>-digit / \"_\" )').
     For each radix, we generate:
     a lexing function for one group instance;
     a lexing function for an underscore-only group instance
     (used for the part of a radix-prefixed literal
     before its first digit); and
     (separately, via @(tsee def-lex-repetition))
     lexing functions for @('*') repetitions of the group."))

  (defmacro def-lex-digit/underscore-group (fn-name digit-fn group-string)
    (b* ((len<=-thm (acl2::packn-pos (list 'len-of- fn-name '-<=) fn-name))
         (len<-thm (acl2::packn-pos (list 'len-of- fn-name '-<) fn-name))
         (decomp-thm (acl2::packn-pos (list 'input-decomposition-of- fn-name)
                                      fn-name))
         (term-thm (acl2::packn-pos (list 'tree-terminatedp-of- fn-name)
                                    fn-name))
         (match-thm (acl2::packn-pos (list 'cst-matchp-of- fn-name) fn-name))
         (digit-match-thm (acl2::packn-pos (list 'cst-matchp-of- digit-fn)
                                           fn-name))
         (digit-term-thm (acl2::packn-pos (list 'tree-terminatedp-of-
                                               digit-fn)
                                          fn-name)))
      `(define ,fn-name ((input nat-listp))
         :returns (mv (tree abnf::tree-resultp)
                      (rest-input nat-listp))
         :short ,(acl2::concatenate 'acl2::string
                                    "Lex a @('" group-string "').")
         (b* (((mv tree1 input1) (,digit-fn input))
              ((when (not (reserrp tree1)))
               (mv (abnf::make-tree-nonleaf
                    :rulename? nil
                    :branches (list (list tree1)))
                   input1))
              ((mv tree1 input1) (abnf::parse-ichars "_" input))
              ((when (reserrp tree1))
               (mv (reserrf-push tree1) (nat-list-fix input))))
           (mv (abnf::make-tree-nonleaf
                :rulename? nil
                :branches (list (list tree1)))
               input1))
         ///
         (defret ,len<=-thm
           (<= (len rest-input) (len input))
           :rule-classes :linear)
         (defret ,len<-thm
           (implies (not (reserrp tree))
                    (< (len rest-input) (len input)))
           :rule-classes :linear)
         (defret ,decomp-thm
           (implies (not (reserrp tree))
                    (equal (append (abnf::tree->string tree) rest-input)
                           (nat-list-fix input)))
           :hints (("Goal"
                    :in-theory (enable input-decomposition-of-parse-ichars
                                       abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))
         (defret ,match-thm
