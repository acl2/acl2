(define lex-punctuation-string ((chars stringp) (input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex a specific punctuation string
          into a @('punctuation') CST."
  (b* (((mv tree1 input1) (abnf::parse-ichars chars input))
       ((when (reserrp tree1))
        (mv (reserrf-push tree1) (nat-list-fix input))))
    (mv (abnf::make-tree-nonleaf
         :rulename? (abnf::rulename "punctuation")
         :branches (list (list tree1)))
        input1))
  ///

  (defret len-of-lex-punctuation-string-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-punctuation-string-<
    (implies (and (not (reserrp tree))
                  (consp (acl2::explode chars)))
             (< (len rest-input) (len input)))
    :rule-classes :linear)

  (defret input-decomposition-of-lex-punctuation-string
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal" :in-theory (enable input-decomposition-of-parse-ichars
                                       abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lex-punctuation ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex a @('punctuation')."
  :long
  (xdoc::topstring
   (xdoc::p
    "We dispatch on the first character,
     and within each dispatch arm we try
     longer punctuation strings before shorter ones,
     to satisfy maximal munch [SC1]
     (e.g. @('>>=') lexes as one token,
     not as @('>') or @('>>') followed by more).")
   (xdoc::p
    "Note that @('/') is handled here,
     but the comment starts @('//') and @('/*')
     are recognized by the lexeme dispatch before
     punctuation lexing is tried,
     so no special care for them is needed here."))
  (b* ((input (nat-list-fix input))
       ((unless (consp input))
        (mv (reserrf (list :end-of-input :required "punctuation")) input))
       (nat (lnfix (car input))))
    (case nat
      (#x2b (lex-punctuation-cascade (list "+=" "+") input)) ; +
      (#x2d (lex-punctuation-cascade (list "->" "-=" "-") input)) ; -
      (#x2a (lex-punctuation-cascade (list "*=" "*") input)) ; *
      (#x2f (lex-punctuation-cascade (list "/=" "/") input)) ; /
      (#x25 (lex-punctuation-cascade (list "%=" "%") input)) ; %
      (#x5e (lex-punctuation-cascade (list "^=" "^") input)) ; ^
      (#x21 (lex-punctuation-cascade (list "!=" "!") input)) ; !
      (#x26 (lex-punctuation-cascade (list "&&" "&=" "&") input)) ; &
      (#x7c (lex-punctuation-cascade (list "||" "|=" "|") input)) ; |
      (#x3c (lex-punctuation-cascade (list "<<=" "<<" "<=" "<-" "<")
                                     input)) ; <
      (#x3e (lex-punctuation-cascade (list ">>=" ">>" ">=" ">") input)) ; >
      (#x3d (lex-punctuation-cascade (list "==" "=>" "=") input)) ; =
      (#x40 (lex-punctuation-cascade (list "@") input)) ; @
      (#x5f (lex-punctuation-cascade (list "_") input)) ; _
      (#x2e (lex-punctuation-cascade (list "..=" "..." ".." ".") input)) ; .
      (#x2c (lex-punctuation-cascade (list ",") input)) ; ,
      (#x3b (lex-punctuation-cascade (list ";") input)) ; ;
      (#x3a (lex-punctuation-cascade (list "::" ":") input)) ; :
      (#x23 (lex-punctuation-cascade (list "#") input)) ; #
      (#x24 (lex-punctuation-cascade (list "$") input)) ; $
      (#x3f (lex-punctuation-cascade (list "?") input)) ; ?
      (#x7e (lex-punctuation-cascade (list "~") input)) ; ~
      (t (mv (reserrf (list :found nat :required "punctuation")) input))))
  :prepwork
  ((define lex-punctuation-cascade ((stringlist string-listp)
                                    (input nat-listp))
     :returns (mv (tree abnf::tree-resultp)
                  (rest-input nat-listp))
     :parents nil
     :guard-hints (("Goal" :in-theory (enable string-listp)))
     :measure (len stringlist)
     (b* ((stringlist (string-list-fix stringlist))
          ((when (atom stringlist))
           (mv (reserrf (list :no-punctuation-matched))
               (nat-list-fix input)))
          ((mv tree input1) (lex-punctuation-string (car stringlist) input))
          ((when (not (reserrp tree))) (mv tree input1)))
       (lex-punctuation-cascade (cdr stringlist) input))
     ///
     (defret len-of-lex-punctuation-cascade-<=
       (<= (len rest-input) (len input))
       :rule-classes :linear
       :hints (("Goal"
                :induct t
                :in-theory (enable lex-punctuation-cascade))))
     (defret input-decomposition-of-lex-punctuation-cascade
       (implies (not (reserrp tree))
                (equal (append (abnf::tree->string tree) rest-input)
                       (nat-list-fix input)))
       :hints (("Goal"
                :induct t
                :in-theory
                (enable lex-punctuation-cascade
                        input-decomposition-of-lex-punctuation-string))))))
  ///

  (defret len-of-lex-punctuation-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-punctuation-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear
    :hints (("Goal"
             :in-theory (enable lex-punctuation-cascade
                                lex-punctuation-string))))

  (defret input-decomposition-of-lex-punctuation
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal"
             :in-theory
             (enable input-decomposition-of-lex-punctuation-cascade))))

  (defret cst-matchp-of-lex-punctuation
    (implies (not (reserrp tree))
             (cst-matchp tree "punctuation"))
    :hints (("Goal"
             :in-theory
             (enable lex-punctuation-cascade
                     lex-punctuation-string
                     cst-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-of-parse-ichars-elem
                     tree-terminatedp-of-parse-ichars
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-list-match-element-p
                     abnf::numrep-match-repeat-range-p))))

  (defret tree-terminatedp-of-lex-punctuation
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :hints (("Goal" :use cst-matchp-of-lex-punctuation
                    :in-theory (enable cst-matchp)))))

