(define lex-outer-line-doc ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex an @('outer-line-doc')."
  :long
  (xdoc::topstring
   (xdoc::p
    "After the @('///'), the optional content part
     requires a @('not-slash-lf') character first;
     if it is absent (e.g. at end of line),
     the option CST is empty."))
  (b* (((mv tree1 input1) (abnf::parse-ichars "///" input))
       ((when (reserrp tree1))
        (mv (reserrf-push tree1) (nat-list-fix input)))
       ((mv tree2 input2) (lex-not-slash-lf input1))
       ((when (reserrp tree2)) ; empty option
        (mv (abnf::make-tree-nonleaf
             :rulename? (abnf::rulename "outer-line-doc")
             :branches (list (list tree1)
                             (list (abnf::make-tree-nonleaf
                                    :rulename? nil
                                    :branches nil))))
            input1))
       ((mv trees3 input3) (lex-*-not-lf input2)))
    (mv (abnf::make-tree-nonleaf
         :rulename? (abnf::rulename "outer-line-doc")
         :branches (list (list tree1)
                         (list (abnf::make-tree-nonleaf
                                :rulename? nil
                                :branches (list (list tree2) trees3)))))
        input3))
  ///

  (defret len-of-lex-outer-line-doc-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-outer-line-doc-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear)

  (defret input-decomposition-of-lex-outer-line-doc
