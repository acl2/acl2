;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lex-comment ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex a @('comment')."
  :long
  (xdoc::topstring
   (xdoc::p
    "The alternative is chosen by lookahead,
     realizing maximal munch [SC1] for
     the @('//') / @('///') / @('//!') / @('////') quirks:
     @('/*') starts a block comment;
     @('//!') starts an inner line doc comment;
     @('///') starts an outer line doc comment,
     unless a fourth @('/') follows,
     in which case the (longer) plain line comment wins;
     any other @('//') starts a plain line comment."))
  (b* ((input (nat-list-fix input))
       ((when (prefixp (list #x2f #x2a) input)) ; /*
        (b* (((mv tree input1) (lex-block-comment input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "comment")
               :branches (list (list tree)))
              input1)))
       ((when (prefixp (list #x2f #x2f #x21) input)) ; //!
        (b* (((mv tree input1) (lex-inner-line-doc input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "comment")
               :branches (list (list tree)))
              input1)))
       ((when (and (prefixp (list #x2f #x2f #x2f) input)
                   (not (prefixp (list #x2f #x2f #x2f #x2f) input)))) ; ///
        (b* (((mv tree input1) (lex-outer-line-doc input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "comment")
               :branches (list (list tree)))
              input1)))
       ((mv tree input1) (lex-line-comment input))
       ((when (reserrp tree)) (mv (reserrf-push tree) input)))
    (mv (abnf::make-tree-nonleaf
         :rulename? (abnf::rulename "comment")
         :branches (list (list tree)))
        input1))
  ///

  (defret len-of-lex-comment-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-comment-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear)

  (defret input-decomposition-of-lex-comment
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal" :in-theory (enable abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (defret cst-matchp-of-lex-comment
    (implies (not (reserrp tree))
             (cst-matchp tree "comment"))
    :hints (("Goal"
             :in-theory
             (enable cst-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-terminatedp-of-lex-block-comment
                     tree-terminatedp-of-lex-inner-line-doc
                     tree-terminatedp-of-lex-outer-line-doc
                     tree-terminatedp-of-lex-line-comment
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-list-match-element-p
                     abnf::numrep-match-repeat-range-p))))

  (defret tree-terminatedp-of-lex-comment
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :hints (("Goal" :use cst-matchp-of-lex-comment
                    :in-theory
                    (union-theories (theory 'acl2::minimal-theory)
                                    '((:definition cst-matchp$)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lex-token ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex a @('token')."
  :long
  (xdoc::topstring
   (xdoc::p
    "The alternative is chosen by lookahead at the first character
     (and the second one for @('r#')):
     @('r#') attempts a raw identifier,
     falling back to an identifier
     (which for e.g. @('r#1') lexes @('r')
     and then fails via [SC8] below,
     since @('1') is not an identifier start);
     a letter starts an identifier or keyword;
     an underscore starts an identifier if
     an identifier-continue character follows,
     otherwise it is punctuation;
     a decimal digit starts an integer literal;
     a bracket character is a delimiter;
     anything else is attempted as punctuation.")
   (xdoc::p
    "After lexing a (non-raw) identifier or keyword,
     the reserved prefix side condition [SC8] applies:
     if the next character is @('#'), @('\\''), or @('\"'),
     the input is rejected
     (e.g. @('foo#bar') does not lex in the supported editions).
     Genuine raw identifiers are not affected,
     because @('r#') followed by an identifier start
     lexes as a raw identifier."))
  (b* ((input (nat-list-fix input))
       ((mv nat? &) (abnf::parse-next input))
       ((when (reserrp nat?))
        (mv (reserrf-push nat?) input))
       (nat (lnfix nat?))
       ((when (prefixp (list #x72 #x23) input)) ; r#
        (b* (((mv tree input1) (lex-raw-identifier input))
             ((when (not (reserrp tree)))
              (mv (abnf::make-tree-nonleaf
                   :rulename? (abnf::rulename "token")
                   :branches (list (list tree)))
                  input1)))
          (lex-token-identifier-or-keyword input)))
       ((when (or (and (<= #x41 nat) (<= nat #x5a)) ; letter
                  (and (<= #x61 nat) (<= nat #x7a))
                  (eql nat #x5f))) ; underscore
        (b* (((mv tree input1) (lex-token-identifier-or-keyword input))
             ((when (not (reserrp tree))) (mv tree input1))
             ((unless (eql nat #x5f)) (mv tree input1))
             ;; lone underscore: punctuation
             ((mv tree input1) (lex-punctuation input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "token")
               :branches (list (list tree)))
              input1)))
       ((when (and (<= #x30 nat) (<= nat #x39))) ; digit
        (b* (((mv tree input1) (lex-integer-literal input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "token")
               :branches (list (list tree)))
              input1)))
       ((when (or (eql nat #x28) (eql nat #x29) ; ( )
                  (eql nat #x5b) (eql nat #x5d) ; [ ]
                  (eql nat #x7b) (eql nat #x7d))) ; { }
        (b* (((mv tree input1) (lex-delimiter input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "token")
               :branches (list (list tree)))
              input1)))
       ((mv tree input1) (lex-punctuation input))
       ((when (reserrp tree)) (mv (reserrf-push tree) input)))
    (mv (abnf::make-tree-nonleaf
         :rulename? (abnf::rulename "token")
         :branches (list (list tree)))
        input1))
  :prepwork
  ((define lex-token-identifier-or-keyword ((input nat-listp))
     :returns (mv (tree abnf::tree-resultp)
                  (rest-input nat-listp))
     :parents nil
     (b* ((input (nat-list-fix input))
          ((mv tree input1) (lex-identifier-or-keyword input))
          ((when (reserrp tree)) (mv (reserrf-push tree) input))
          ((when (or (prefixp (list #x23) input1) ; # [SC8]
                     (prefixp (list #x27) input1) ; ' [SC8]
                     (prefixp (list #x22) input1))) ; " [SC8]
           (mv (reserrf (list :reserved-prefix
                              (abnf::tree->string tree)))
               input)))
       (mv (abnf::make-tree-nonleaf
            :rulename? (abnf::rulename "token")
            :branches (list (list tree)))
           input1))
     ///
     (defret len-of-lex-token-identifier-or-keyword-<=
       (<= (len rest-input) (len input))
       :rule-classes :linear)
     (defret len-of-lex-token-identifier-or-keyword-<
       (implies (not (reserrp tree))
                (< (len rest-input) (len input)))
       :rule-classes :linear)
     (defret input-decomposition-of-lex-token-identifier-or-keyword
       (implies (not (reserrp tree))
                (equal (append (abnf::tree->string tree) rest-input)
                       (nat-list-fix input)))
       :hints (("Goal" :in-theory (enable abnf::tree->string
                                          abnf::tree-list->string
                                          abnf::tree-list-list->string))))
     (defret cst-matchp-of-lex-token-identifier-or-keyword
       (implies (not (reserrp tree))
                (cst-matchp tree "token"))
       :hints (("Goal"
                :in-theory
                (enable cst-matchp
                        tree-match-of-make-tree-nonleaf-elem
                        tree-match-element-p-when-cst-matchp$
                        tree-terminatedp-of-lex-identifier-or-keyword
                        abnf::tree-terminatedp
                        abnf::tree-list-terminatedp
                        abnf::tree-list-list-terminatedp
                        abnf::tree-list-list-match-alternation-p
                        abnf::tree-list-list-match-concatenation-p
                        abnf::tree-list-match-repetition-p
                        abnf::tree-list-match-element-p
                        abnf::numrep-match-repeat-range-p))))
     (defret tree-terminatedp-of-lex-token-identifier-or-keyword
       (implies (not (reserrp tree))
                (abnf::tree-terminatedp tree))
       :hints (("Goal" :use cst-matchp-of-lex-token-identifier-or-keyword
                       :in-theory
                       (union-theories (theory 'acl2::minimal-theory)
                                       '((:definition cst-matchp$))))))))
  ///

  (defret len-of-lex-token-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-token-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear)

  (defret input-decomposition-of-lex-token
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal" :in-theory (enable abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (defret cst-matchp-of-lex-token
    (implies (not (reserrp tree))
             (cst-matchp tree "token"))
    :hints (("Goal"
             :in-theory
             (enable cst-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-terminatedp-of-lex-raw-identifier
                     tree-terminatedp-of-lex-integer-literal
                     tree-terminatedp-of-lex-punctuation
                     tree-terminatedp-of-lex-delimiter
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-list-match-element-p
                     abnf::numrep-match-repeat-range-p))))

  (defret tree-terminatedp-of-lex-token
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :hints (("Goal" :use cst-matchp-of-lex-token
                    :in-theory
                    (union-theories (theory 'acl2::minimal-theory)
                                    '((:definition cst-matchp$)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lex-lexeme ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex a @('lexeme')."
  :long
  (xdoc::topstring
   (xdoc::p
    "Whitespace is attempted first
     (it fails immediately on a non-whitespace character);
     then, if the input starts with @('//') or @('/*'),
     a comment is lexed (it cannot be a token);
     otherwise a token is lexed."))
  (b* (((mv tree input1) (lex-whitespace input))
       ((when (not (reserrp tree)))
        (mv (abnf::make-tree-nonleaf
             :rulename? (abnf::rulename "lexeme")
             :branches (list (list tree)))
            input1))
       (input (nat-list-fix input))
       ((when (or (prefixp (list #x2f #x2f) input)
                  (prefixp (list #x2f #x2a) input)))
        (b* (((mv tree input1) (lex-comment input))
             ((when (reserrp tree)) (mv (reserrf-push tree) input)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "lexeme")
               :branches (list (list tree)))
              input1)))
       ((mv tree input1) (lex-token input))
       ((when (reserrp tree)) (mv (reserrf-push tree) input)))
    (mv (abnf::make-tree-nonleaf
         :rulename? (abnf::rulename "lexeme")
         :branches (list (list tree)))
        input1))
  ///

  (defret len-of-lex-lexeme-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-lexeme-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear)

  (defret input-decomposition-of-lex-lexeme
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal" :in-theory (enable abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (defret cst-matchp-of-lex-lexeme
    (implies (not (reserrp tree))
             (cst-matchp tree "lexeme"))
    :hints (("Goal"
             :in-theory
             (enable cst-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-terminatedp-of-lex-whitespace
                     tree-terminatedp-of-lex-comment
                     tree-terminatedp-of-lex-token
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-list-match-element-p
                     abnf::numrep-match-repeat-range-p))))

  (defret tree-terminatedp-of-lex-lexeme
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :hints (("Goal" :use cst-matchp-of-lex-lexeme
                    :in-theory
                    (union-theories (theory 'acl2::minimal-theory)
                                    '((:definition cst-matchp$)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(def-lex-repetition lex-*-lexeme
  lex-lexeme "lexeme" "*lexeme")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lexemize-rust ((input nat-listp))
  :returns (trees abnf::tree-list-resultp)
  :short "Lex the input into a list of lexeme CSTs."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the top-level lexing function:
     it lexes as many lexemes as possible [SC1],
     and it fails if any input remains.")
   (xdoc::p
    "The returned CSTs are terminated,
     they match the @('lexeme') rule,
     and their strings concatenate to the input:
     see the theorems below.
     The further properties in @(tsee lexing-okp)
     (maximal munch and the other side conditions)
     are future work."))
  (b* (((mv trees rest-input) (lex-*-lexeme input))
       ((when (consp rest-input))
        (reserrf (list :cannot-lex-rest-of-input rest-input))))
    trees)
  ///

  (defret tree-list-terminatedp-of-lexemize-rust
    (implies (not (reserrp trees))
             (abnf::tree-list-terminatedp trees)))

  (defret cst-list-elem-matchp-of-lexemize-rust
    (implies (not (reserrp trees))
             (cst-list-elem-matchp trees "lexeme")))

  (defret input-coverage-of-lexemize-rust
    (implies (not (reserrp trees))
             (equal (abnf::tree-list->string trees)
                    (nat-list-fix input)))
    :hints (("Goal"
             :use (input-decomposition-of-lex-*-lexeme
                   nat-listp-of-lex-*-lexeme.rest-input)
             :in-theory (disable input-decomposition-of-lex-*-lexeme
                                 nat-listp-of-lex-*-lexeme.rest-input)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lexemize-rust-from-string ((string stringp))
  :returns (trees abnf::tree-list-resultp)
  :short "Lex an ACL2 string into a list of lexeme CSTs."
  :long
  (xdoc::topstring
   (xdoc::p
    "The string's character codes become the input;
     since ACL2 characters have codes below 256,
     this covers all ASCII inputs
     (the current grammar slice is ASCII-only anyway,
     except that non-ASCII whitespace and comment content
     would need Unicode input,
     which comes with the UTF-8 layer)."))
  (lexemize-rust (acl2::string=>nats (str-fix string))))
