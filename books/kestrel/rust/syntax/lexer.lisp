(define lex-line-comment ((input nat-listp))
  :returns (mv (tree abnf::tree-resultp)
               (rest-input nat-listp))
  :short "Lex a @('line-comment')."
  :long
  (xdoc::topstring
   (xdoc::p
    "After the @('//'), the optional content part starts with
     either a character that is not @('/'), @('!'), or a line feed,
     or a second @('//');
     the latter makes @('////...') a plain line comment
     (see the grammar and @(tsee lex-comment))."))
  (b* (((mv tree1 input1) (abnf::parse-ichars "//" input))
       ((when (reserrp tree1))
        (mv (reserrf-push tree1) (nat-list-fix input)))
       ((mv tree2 input2) (lex-not-slash-bang-lf input1))
       ((mv tree2 input2) (if (reserrp tree2)
                              (abnf::parse-ichars "//" input1)
                            (mv tree2 input2)))
       ((when (reserrp tree2)) ; empty option
        (mv (abnf::make-tree-nonleaf
             :rulename? (abnf::rulename "line-comment")
             :branches (list (list tree1)
                             (list (abnf::make-tree-nonleaf
                                    :rulename? nil
                                    :branches nil))))
            input1))
       (group-tree (abnf::make-tree-nonleaf
                    :rulename? nil
                    :branches (list (list tree2))))
       ((mv trees3 input3) (lex-*-not-lf input2)))
    (mv (abnf::make-tree-nonleaf
         :rulename? (abnf::rulename "line-comment")
         :branches (list (list tree1)
                         (list (abnf::make-tree-nonleaf
                                :rulename? nil
                                :branches (list (list group-tree) trees3)))))
        input3))
  ///

  (defret len-of-lex-line-comment-<=
    (<= (len rest-input) (len input))
    :rule-classes :linear)

  (defret len-of-lex-line-comment-<
    (implies (not (reserrp tree))
             (< (len rest-input) (len input)))
    :rule-classes :linear)

  (defret input-decomposition-of-lex-line-comment
    (implies (not (reserrp tree))
             (equal (append (abnf::tree->string tree) rest-input)
                    (nat-list-fix input)))
    :hints (("Goal" :in-theory (enable input-decomposition-of-parse-ichars
                                       abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (defret cst-matchp-of-lex-line-comment
    (implies (not (reserrp tree))
             (cst-matchp tree "line-comment"))
    :hints (("Goal"
             :in-theory
             (enable cst-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-of-make-tree-nonleaf-group-elem
                     tree-match-of-make-tree-nonleaf-option-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-list-match-element-p-when-cst-list-elem-matchp$
                     tree-list-match-repetition-p-when-cst-list-rep-matchp$
                     tree-match-of-parse-ichars-elem
                     tree-terminatedp-of-parse-ichars
                     tree-terminatedp-of-lex-not-slash-bang-lf
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-list-match-element-p
                     abnf::numrep-match-repeat-range-p))))

  (defret tree-terminatedp-of-lex-line-comment
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :hints (("Goal" :use cst-matchp-of-lex-line-comment
                    :in-theory (enable cst-matchp)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defines lex-block-comment-fns
  :short "Lexing functions for (nested) block comments."
  :long
  (xdoc::topstring
   (xdoc::p
    "Rust block comments nest,
     so these functions are mutually recursive:
     a @('block-comment') contains @('block-item')s,
     and a @('block-item') may be a @('block-comment').
     The item repetition stops at the first point where
     the remaining input starts with @('*/'),
     which closes the current comment:
     this realizes the [SC2] side condition
     (see @(see extra-grammatical-restrictions)).")
   (xdoc::p
    "The termination measure pairs the input length with
     a rank that orders the functions at equal input length;
     the item repetition recurses only when
     the item consumed some input,
     which the @(tsee mbt) test makes available
     to the termination proof.
     Guard verification is deferred until
     the length theorems are available."))
  :verify-guards nil

  (define lex-block-comment ((input nat-listp))
    :returns (mv (tree abnf::tree-resultp)
                 (rest-input nat-listp))
    :measure (acl2::two-nats-measure (len input) 0)
    (b* (((mv tree-open input1) (abnf::parse-ichars "/*" input))
         ((when (reserrp tree-open))
          (mv (reserrf-push tree-open) (nat-list-fix input)))
         ((mv trees-items input2) (lex-*-block-item input1))
         ((mv tree-close input3) (abnf::parse-ichars "*/" input2))
         ((when (reserrp tree-close))
          (mv (reserrf (list :unclosed-block-comment))
              (nat-list-fix input))))
      (mv (abnf::make-tree-nonleaf
           :rulename? (abnf::rulename "block-comment")
           :branches (list (list tree-open)
                           trees-items
                           (list tree-close)))
          input3)))

  (define lex-block-item ((input nat-listp))
    :returns (mv (tree abnf::tree-resultp)
                 (rest-input nat-listp))
    :measure (acl2::two-nats-measure (len input) 1)
    (b* ((input (nat-list-fix input))
         ((when (prefixp (list #x2f #x2a) input)) ; starts with /*
          (b* (((mv tree input1) (lex-block-comment input))
               ((when (reserrp tree)) (mv (reserrf-push tree) input)))
            (mv (abnf::make-tree-nonleaf
                 :rulename? (abnf::rulename "block-item")
                 :branches (list (list tree)))
                input1)))
         ((mv tree input1) (lex-not-star-slash input))
         ((when (not (reserrp tree)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "block-item")
               :branches (list (list tree)))
              input1))
         ((mv tree input1) (abnf::parse-ichars "*" input))
         ((when (not (reserrp tree)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "block-item")
               :branches (list (list tree)))
              input1))
         ((mv tree input1) (abnf::parse-ichars "/" input))
         ((when (not (reserrp tree)))
          (mv (abnf::make-tree-nonleaf
               :rulename? (abnf::rulename "block-item")
               :branches (list (list tree)))
              input1)))
      (mv (reserrf (list :found :end-of-input :required "block-item"))
          input)))

  (define lex-*-block-item ((input nat-listp))
    :returns (mv (trees abnf::tree-listp)
                 (rest-input nat-listp))
    :measure (acl2::two-nats-measure (len input) 2)
    (b* ((input (nat-list-fix input))
         ((when (prefixp (list #x2a #x2f) input)) ; stop before */ [SC2]
          (mv nil input))
         ((mv tree input1) (lex-block-item input))
         ((when (reserrp tree)) (mv nil input))
         ((unless (mbt (< (len input1) (len input)))) (mv nil input))
         ((mv trees input2) (lex-*-block-item input1)))
      (mv (cons tree trees) input2)))

  ///

  (std::defret-mutual len-of-lex-block-comment-fns-<=
    (defret len-of-lex-block-comment-<=
      (<= (len rest-input) (len input))
      :rule-classes :linear
      :fn lex-block-comment)
    (defret len-of-lex-block-item-<=
      (<= (len rest-input) (len input))
      :rule-classes :linear
      :fn lex-block-item)
    (defret len-of-lex-*-block-item-<=
      (<= (len rest-input) (len input))
      :rule-classes :linear
      :fn lex-*-block-item)
    :hints (("Goal"
             :expand ((lex-block-comment input)
                      (lex-block-item input)
                      (lex-*-block-item input))
             :in-theory (enable lex-block-comment
                                lex-block-item
                                lex-*-block-item))))

  (std::defret-mutual len-of-lex-block-comment-fns-<
    (defret len-of-lex-block-comment-<
      (implies (not (reserrp tree))
               (< (len rest-input) (len input)))
      :rule-classes :linear
      :fn lex-block-comment)
    (defret len-of-lex-block-item-<
      (implies (not (reserrp tree))
               (< (len rest-input) (len input)))
      :rule-classes :linear
      :fn lex-block-item)
    (defret len-of-lex-*-block-item-<-trivial
      t
      :rule-classes nil
      :fn lex-*-block-item)
    :hints (("Goal"
             :expand ((lex-block-comment input)
                      (lex-block-item input)
                      (lex-*-block-item input))
             :in-theory (enable lex-block-comment
                                lex-block-item
                                lex-*-block-item))))

  (verify-guards lex-block-comment)

  (std::defret-mutual input-decomposition-of-lex-block-comment-fns
    (defret input-decomposition-of-lex-block-comment
      (implies (not (reserrp tree))
               (equal (append (abnf::tree->string tree) rest-input)
                      (nat-list-fix input)))
      :fn lex-block-comment)
    (defret input-decomposition-of-lex-block-item
      (implies (not (reserrp tree))
               (equal (append (abnf::tree->string tree) rest-input)
                      (nat-list-fix input)))
      :fn lex-block-item)
    (defret input-decomposition-of-lex-*-block-item
      (equal (append (abnf::tree-list->string trees) rest-input)
             (nat-list-fix input))
      :fn lex-*-block-item)
    :hints (("Goal"
             :expand ((lex-block-comment input)
                      (lex-block-item input)
                      (lex-*-block-item input))
             :in-theory (enable lex-block-comment
                                lex-block-item
                                lex-*-block-item
                                input-decomposition-of-parse-ichars
                                       abnf::tree->string
                                       abnf::tree-list->string
                                       abnf::tree-list-list->string))))

  (std::defret-mutual cst-matchp-of-lex-block-comment-fns
    (defret cst-matchp-of-lex-block-comment
      (implies (not (reserrp tree))
               (cst-matchp tree "block-comment"))
      :fn lex-block-comment)
    (defret cst-matchp-of-lex-block-item
      (implies (not (reserrp tree))
               (cst-matchp tree "block-item"))
      :fn lex-block-item)
    (defret cst-list-elem-matchp-of-lex-*-block-item
      (cst-list-elem-matchp trees "block-item")
      :fn lex-*-block-item)
    :hints (("Goal"
             :expand ((lex-block-comment input)
                      (lex-block-item input)
                      (lex-*-block-item input))
             :in-theory
             (enable lex-block-comment
                     lex-block-item
                     lex-*-block-item
                     cst-matchp
                     cst-list-elem-matchp
                     tree-match-of-make-tree-nonleaf-elem
                     tree-match-element-p-when-cst-matchp$
                     tree-list-match-element-p-when-cst-list-elem-matchp$
                     tree-match-of-parse-ichars-elem
                     tree-terminatedp-of-parse-ichars
                     tree-terminatedp-of-lex-not-star-slash
                     abnf::tree-terminatedp
                     abnf::tree-list-terminatedp
                     abnf::tree-list-list-terminatedp
                     abnf::tree-list-list-match-alternation-p
                     abnf::tree-list-list-match-concatenation-p
                     abnf::tree-list-match-repetition-p
                     abnf::tree-list-match-element-p
                     abnf::numrep-match-repeat-range-p))))

  (defret tree-terminatedp-of-lex-block-comment
    (implies (not (reserrp tree))
             (abnf::tree-terminatedp tree))
    :fn lex-block-comment
    :hints (("Goal" :use cst-matchp-of-lex-block-comment
