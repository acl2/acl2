; The fixtype of source units and its result fixtype.
; These come before the controlled configuration below
; because the proofs generated by fty::defresult
; rely on the default theory.

(fty::defprod source-unit
  :parents (source-units)
  :short "Fixtype of source units."
  :long
  (xdoc::topstring
   (xdoc::p
    "A source unit consists of
     a label, which is the name of the file, or any other name:
     it is there for messages, and does not identify the source unit;
     the edition in which the text was tokenized;
     the source text (see @(tsee source-text));
     and the lexemes of the text, each with its span.")
   (xdoc::p
    "The lexemes are all of them, in the order of the text:
     the tokens, the whitespace, the comments,
     and first of all the shebang, if the text starts with one.
     See @(tsee source-unit-wfp) for how they relate to the text."))
  ((label string)
   (edition rust::edition)
   (source source-text)
   (lexemes lexeme+span-list))
  :pred source-unitp)

(fty::defresult source-unit-result
  :parents (source-units)
  :short "Fixtype of errors and source units."
  :ok source-unit
  :pred source-unit-resultp)

; See lexer.lisp for why :no-function nil (fty::reserrf uses __function__).
(acl2::controlled-configuration :no-function nil)

; These rules bridge the fty::defresult idiom to the underlying types,
; as in lexer.lisp and tokenizer.lisp.
(local (in-theory (enable acl2::nat-listp-when-result-not-error
                          acl2::stringp-when-result-not-error
                          abnf::tree-listp-when-result-not-error
                          lexeme+span-listp-when-result-not-error
                          token+span-listp-when-result-not-error
                          source-textp-when-result-not-error
                          source-unitp-when-result-not-error
                          byte-listp-when-result-not-error)))

; For the guards of str::cat with more than two strings.
(local (in-theory (enable string-listp)))

(defrulel nat-list-fix-of-nthcdr
  (equal (nat-list-fix (nthcdr n x))
         (nthcdr n (nat-list-fix x)))
  :induct (nthcdr n x)
  :enable (nthcdr nat-list-fix))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defxdoc+ source-units
  :parents (syntax-for-tools)
  :short "Rust source units: a source text with its lexemes."
  :long
  (xdoc::topstring
   (xdoc::p
    "A source unit is what we keep of a source file once it is read:
     its text, and every lexeme of the text with its span.
     The spans of tokens, and later of syntax trees,
     are offsets into the text of a source unit (see @(see spans)).
     They do not refer to the file, which may change after it is read;
     the source unit does not change.
     So tokens and trees need not hold their own text,
     nor the whitespace and the comments around them:
     all of it is in the source unit, where their spans say.")
   (xdoc::p
    "A source unit (see @(tsee source-unit)) has
     a label, the edition, the source text,
     and the lexemes with their spans.
     The source text is that of @(see input-format):
     the code points of the file,
     with a record of the byte order mark and the carriage returns
     that are not among them,
     from which the bytes of the file can be reproduced.
     The lexemes are the tokens, the whitespace, and the comments,
     in the order of the text.
     If the text starts with a shebang,
     the shebang is the first lexeme, and lexing starts after it;
     no other lexeme is a shebang.")
   (xdoc::p
    "@(tsee source-unit-from-file) reads a file into a source unit;
     @(tsee source-unit-from-bytes) and @(tsee source-unit-from-source-text)
     start from the bytes of a file and from a source text.
     @(tsee source-unit-tokens) gives the tokens with their spans,
     which is what the token-tree builder and the parser take,
     and @(tsee source-unit-token-trees) gives the token trees.
     The span of a token is the one that it has among the lexemes:
     it does not depend on whether the whitespace and the comments
     are kept.")
   (xdoc::h3 "What a source unit guarantees")
   (xdoc::p
    "A source unit is well-formed (see @(tsee source-unit-wfp))
     when its lexemes tile its text:
     their spans are adjacent, from the start of the text to its end,
     and the text has, at the span of each lexeme,
     the code points that the lexeme has
     according to its own components (see @(tsee lexeme-text)).
     The functions that make source units return well-formed ones.
     For a well-formed source unit we prove the following.")
   (xdoc::ul
    (xdoc::li
     "The lexemes give back the text:
      the code points of the lexemes, one after the other,
      are those of the text
      (@(tsee lexeme+span-list-code-points-of-source-unit->lexemes)).
      So the fixtypes of lexemes and tokens lose nothing of it.")
    (xdoc::li
     "Each lexeme is in the text where its span says
      (@(tsee lexeme+span-list-located-p-of-source-unit->lexemes)),
      and so is each token
      (@(tsee token+span-list-located-p-of-source-unit-tokens)).")
    (xdoc::li
     "Each token in the token trees is in the text where its span says,
      including the delimiters of each group
      (@(tsee token+span-list-located-p-of-source-unit-token-trees))."))
   (xdoc::p
    "With the theorem about source texts
     (see @(tsee source-text-to-bytes)),
     this goes down to the bytes:
     a well-formed source unit determines its file.")
   (xdoc::p
    "The functions that make source units ensure well-formedness
     by checking it, on the source unit that they have built,
     and returning an error if the check fails.
     That the check never fails,
     which is a statement about the tokenizer
     (every lexeme that it makes has the text that was lexed),
     is not proved yet.
     It has not failed on any input of our tests
     (see @(see differential-testing)).")
   (xdoc::h3 "Lines and columns")
   (xdoc::p
    "The line and the column of an offset
     are computed from the text of the source unit
     (see @(tsee position-of-offset) and @(tsee source-unit-text)).
     The lines are those of the file:
     each line feed of the file is in the text,
     and so is a shebang, which is within the first line.
     The columns count the code points of a line;
     a byte order mark, which is not in the text, is not counted.")
   (xdoc::h3 "Identity")
   (xdoc::p
    "The label of a source unit is a name for messages.
     What identifies its content is a digest of the file
     (see @(tsee source-unit-digest)),
     which is computed from the source unit when it is needed.")
   (xdoc::p
    "A span does not say which source unit it refers to.
     This is enough as long as the tokens of a source unit
     are used with that unit.
     When several source units are held together,
     as the files of a crate will be,
     spans will have to say which one they are in."))
  :order-subtopics t
  :default-parent t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The text of tokens and of lexemes.

(define int-lit-text ((lit int-litp))
  :returns (text stringp)
  :short "Text of an integer literal."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the radix prefix, if any, the digits, and the suffix."))
  (b* (((int-lit lit)))
    (str::cat (radix-case lit.radix :dec "" :bin "0b" :oct "0o" :hex "0x")
              lit.digits
              lit.suffix)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define float-lit-text ((lit float-litp))
  :returns (text stringp)
  :short "Text of a float literal."
  (b* (((float-lit lit)))
    (str::cat lit.text lit.suffix)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define char-lit-text ((lit char-litp))
  :returns (text stringp)
  :short "Text of a character or byte literal."
  (b* (((char-lit lit)))
    (str::cat (if lit.byte "b'" "'") lit.text "'" lit.suffix)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define str-lit-text ((lit str-litp))
  :returns (text stringp)
  :short "Text of a string literal, of any kind, raw or not."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the prefix of the kind, if any;
     for a raw literal, @('r') and its @('#') characters;
     the text between double quotes;
     for a raw literal, its @('#') characters again;
     and the suffix."))
  (b* (((str-lit lit))
       (prefix (str-kind-case lit.kind :plain "" :byte "b" :c "c"))
       ((unless lit.raw)
        (str::cat prefix "\"" lit.text "\"" lit.suffix))
       (hashes (acl2::implode (make-list lit.raw :initial-element #\#))))
    (str::cat prefix "r" hashes "\"" lit.text "\"" hashes lit.suffix)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lit-text ((lit litp))
  :returns (text stringp)
  :short "Text of a literal."
  (lit-case lit
            :int (int-lit-text lit.int)
            :float (float-lit-text lit.float)
            :char (char-lit-text lit.char)
            :str (str-lit-text lit.str)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define token-text ((token tokenp))
  :returns (text stringp)
  :short "Text of a token."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the token as it is written in a source text,
     computed from the components of the token alone.
     The text of a raw identifier starts with @('r#'),
     and that of a lifetime with a single quote, or with @(''r#') if raw.
     A doc comment has its markers:
     @('///') or @('//!') for a line doc comment,
     and for a block doc comment
     @('/**') or @('/*!'), and @('*/') at the end.")
   (xdoc::p
    "Like the text in the components of tokens,
     the result is a string that holds UTF-8."))
  (token-case
   token
   :ident (if token.raw (str::cat "r#" token.name) token.name)
   :keyword token.name
   :lifetime (str::cat (if token.raw "'r#" "'") token.name)
   :lit (lit-text token.lit)
   :punct token.value
   :open-delim (delim-case token.delim :paren "(" :bracket "[" :brace "{")
   :close-delim (delim-case token.delim :paren ")" :bracket "]" :brace "}")
   :doc-comment (b* ((outer (doc-style-case token.style :outer t :inner nil)))
                  (if token.block
                      (str::cat (if outer "/**" "/*!") token.content "*/")
                    (str::cat (if outer "///" "//!") token.content)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lexeme-text ((lexeme lexemep))
  :returns (text stringp)
  :short "Text of a lexeme."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the lexeme as it is written in a source text,
     computed from the components of the lexeme alone
     (see @(tsee token-text) for tokens).
     A comment has its markers:
     @('//') for a line comment,
     and @('/*') and @('*/') for a block comment.
     A shebang starts with @('#!')."))
  (lexeme-case
   lexeme
   :token (token-text lexeme.token)
   :whitespace lexeme.content
   :comment (if lexeme.block
                (str::cat "/*" lexeme.content "*/")
              (str::cat "//" lexeme.content))
   :shebang (str::cat "#!" lexeme.content)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lexeme-code-points ((lexeme lexemep))
  :returns (nats nat-listp)
  :short "Code points of the text of a lexeme."
  :long
  (xdoc::topstring
   (xdoc::p
    "The text of the lexeme (see @(tsee lexeme-text)) is decoded.
     If it is not valid UTF-8, there are no code points;
     this does not happen for the lexemes
     that the tokenizer makes from the code points of a source text."))
  (b* ((nats (utf-8-string-to-code-points (lexeme-text lexeme))))
    (if (reserrp nats)
        nil
      nats))

  ///

  (defret true-listp-of-lexeme-code-points
    (true-listp nats)
    :rule-classes :type-prescription
    :hints (("Goal"
             :use nat-listp-of-lexeme-code-points
             :in-theory (disable nat-listp-of-lexeme-code-points
                                 lexeme-code-points)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define token-code-points ((token tokenp))
  :returns (nats nat-listp)
  :short "Code points of the text of a token."
  (lexeme-code-points (lexeme-token token)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Lexemes that tile a text.

(define lexeme+span-list-tiles-p ((lexemes lexeme+span-listp)
                                  (text nat-listp)
                                  (offset natp))
  :returns (yes/no booleanp)
  :short "Check if lexemes with spans tile a text
          that starts at a given offset."
  :long
  (xdoc::topstring
   (xdoc::p
    "The text is the rest of a source text, from the given offset.
     The lexemes tile it when
     the span of the first lexeme starts at the given offset;
     the span of each other lexeme starts
     where the span of the lexeme before it ends;
     the span of the last lexeme ends where the text ends;
     no span is empty;
     and the text has, at the span of each lexeme,
     the code points of that lexeme
     (see @(tsee lexeme-code-points)).
     So the spans are in order and adjacent, and they cover the text,
     which consists of the code points of the first lexeme,
     followed by those of the second one, and so on to the last one."))
  (b* ((lexemes (lexeme+span-list-fix lexemes))
       (text (nat-list-fix text))
       (offset (lnfix offset))
       ((when (endp lexemes)) (endp text))
       ((lexeme+span lexeme+span) (car lexemes))
       (span lexeme+span.span)
       (nats (lexeme-code-points lexeme+span.lexeme)))
    (and (equal (span->start span) offset)
         (< (span->start span) (span->end span))
         (equal (span-length span) (len nats))
         (prefixp nats text)
         (lexeme+span-list-tiles-p (cdr lexemes)
                                   (nthcdr (span-length span) text)
                                   (span->end span))))
  :measure (len lexemes))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lexeme+span-list-shebang-free-p ((lexemes lexeme+span-listp))
  :returns (yes/no booleanp)
  :short "Check if no lexeme of a list is a shebang."
  (b* ((lexemes (lexeme+span-list-fix lexemes))
       ((when (endp lexemes)) t))
    (and (not (lexeme-case (lexeme+span->lexeme (car lexemes)) :shebang))
         (lexeme+span-list-shebang-free-p (cdr lexemes))))
  :measure (len lexemes))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lexeme+span-list-code-points ((lexemes lexeme+span-listp))
  :returns (nats nat-listp)
  :short "Code points of the texts of a list of lexemes,
          one after the other."
  (b* ((lexemes (lexeme+span-list-fix lexemes))
       ((when (endp lexemes)) nil))
    (append (lexeme-code-points (lexeme+span->lexeme (car lexemes)))
            (lexeme+span-list-code-points (cdr lexemes))))
  :measure (len lexemes))

;;;;;;;;;;;;;;;;;;;;

(defrule lexeme+span-list-code-points-when-tiles-p
  :short "Lexemes that tile a text give back the text."
  (implies (lexeme+span-list-tiles-p lexemes text offset)
           (equal (lexeme+span-list-code-points lexemes)
                  (nat-list-fix text)))
  :induct (lexeme+span-list-tiles-p lexemes text offset)
  :enable (lexeme+span-list-tiles-p
           lexeme+span-list-code-points)
  :prep-lemmas
  ((defrule append-when-prefixp-and-len
     (implies (and (prefixp x y)
                   (equal (len x) n))
              (equal (append x (nthcdr n y))
                     y)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lexeme+span-located-p ((lexeme+span lexeme+span-p) (text nat-listp))
  :returns (yes/no booleanp)
  :short "Check if the span of a lexeme locates the lexeme in a text."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the case when the code points of the text at the span
     (see @(tsee span-text))
     are the code points of the lexeme
     (see @(tsee lexeme-code-points))."))
  (b* (((lexeme+span lexeme+span)))
    (equal (span-text lexeme+span.span text)
           (lexeme-code-points lexeme+span.lexeme))))

;;;;;;;;;;;;;;;;;;;;

(define lexeme+span-list-located-p ((lexemes lexeme+span-listp)
                                    (text nat-listp))
  :returns (yes/no booleanp)
  :short "Check if the span of each lexeme of a list
          locates the lexeme in a text."
  (b* ((lexemes (lexeme+span-list-fix lexemes))
       ((when (endp lexemes)) t))
    (and (lexeme+span-located-p (car lexemes) text)
         (lexeme+span-list-located-p (cdr lexemes) text)))
  :measure (len lexemes))

;;;;;;;;;;;;;;;;;;;;

(defrule lexeme+span-list-located-p-when-tiles-p
  :short "Each of the lexemes that tile a text is where its span says."
  (implies (lexeme+span-list-tiles-p lexemes text 0)
           (lexeme+span-list-located-p lexemes text))
  :use (:instance lemma (offset 0))
  :prep-lemmas
  (; The induction of the tiling predicate,
   ; without the text, which the lemma has in another form.
   (defun induction (lexemes offset)
     (declare (xargs :measure (len lexemes)))
     (if (atom lexemes)
         offset
       (induction (cdr lexemes)
                  (span->end (lexeme+span->span (car lexemes))))))
   (defrule take-when-prefixp-and-len
     (implies (and (prefixp x y)
                   (equal (len x) n))
              (equal (take n y)
                     (true-list-fix x))))
   (defrule +-of-span->start-and-span-length
     (implies (< (span->start span) (span->end span))
              (equal (+ (span->start span) (span-length span))
                     (span->end span)))
     :enable (span-length nfix))
   (defruled lemma
     (implies (and (natp offset)
                   (lexeme+span-list-tiles-p
                    lexemes (nthcdr offset (nat-list-fix text)) offset))
              (lexeme+span-list-located-p lexemes text))
     :induct (induction lexemes offset)
     :expand (lexeme+span-list-tiles-p lexemes (nthcdr offset text) offset)
     :enable (lexeme+span-list-located-p
              lexeme+span-located-p
              span-text))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define token+span-located-p ((token+span token+span-p) (text nat-listp))
  :returns (yes/no booleanp)
  :short "Check if the span of a token locates the token in a text."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the case when the code points of the text at the span
     are the code points of the token
     (see @(tsee token-code-points))."))
  (b* (((token+span token+span)))
    (equal (span-text token+span.span text)
           (token-code-points token+span.token))))

;;;;;;;;;;;;;;;;;;;;

(define token+span-list-located-p ((tokens token+span-listp)
                                   (text nat-listp))
  :returns (yes/no booleanp)
  :short "Check if the span of each token of a list
          locates the token in a text."
  (b* ((tokens (token+span-list-fix tokens))
       ((when (endp tokens)) t))
    (and (token+span-located-p (car tokens) text)
         (token+span-list-located-p (cdr tokens) text)))
  :measure (len tokens))

;;;;;;;;;;;;;;;;;;;;

(defrule token+span-list-located-p-of-lexeme+span-list->tokens
  :short "The tokens among lexemes that are where their spans say
          are where their spans say."
  (implies (lexeme+span-list-located-p lexemes text)
           (token+span-list-located-p (lexeme+span-list->tokens lexemes)
                                      text))
  :induct (lexeme+span-list->tokens lexemes)
  :enable (lexeme+span-list->tokens
           lexeme+span-list-located-p
           lexeme+span-located-p
           token+span-list-located-p
           token+span-located-p
           token-code-points
           lexeme-code-points
           lexeme-text))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Source units.

(define source-unit-text ((unit source-unitp))
  :returns (text nat-listp)
  :short "Text of a source unit."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the text of its source text:
     the code points that the spans of the source unit refer to."))
  (source-text->text (source-unit->source unit)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define source-unit-wfp ((unit source-unitp))
  :returns (yes/no booleanp)
  :short "Check if a source unit is well-formed."
  :long
  (xdoc::topstring
   (xdoc::p
    "A source unit is well-formed when
     the code points of its text are Unicode scalar values;
     its lexemes tile its text, from offset 0
     (see @(tsee lexeme+span-list-tiles-p));
     and only its first lexeme may be a shebang.")
   (xdoc::p
    "So in a well-formed source unit
     the lexemes lose nothing of the text:
     each one, from its components alone, gives back its code points,
     which are the ones at its span,
     and all of them together give back the text.
     With the source text, which gives back the bytes of the file
     (see @(tsee source-text-to-bytes)),
     the lexemes of a source unit determine its file.")
   (xdoc::p
    "This predicate does not say that the lexemes are
     the ones that the lexer and the tokenizer make of the text;
     that is for the specification of lexing to say
     (see @(tsee lexing-okp))."))
  (b* (((source-unit unit))
       (text (source-text->text unit.source)))
    (and (uni-scalar-value-listp text)
         (lexeme+span-list-tiles-p unit.lexemes text 0)
         (lexeme+span-list-shebang-free-p (cdr unit.lexemes)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define source-unit-from-source-text ((source source-textp)
                                      (edition rust::editionp)
                                      (label stringp))
  :returns (unit source-unit-resultp)
  :short "Lex and tokenize a source text into a source unit."
  :long
  (xdoc::topstring
   (xdoc::p
    "If the text starts with a shebang (see @(tsee shebang-length)),
     the first lexeme is that shebang,
     and the text after it is lexed and tokenized;
     the spans are offsets into the whole text.
     Otherwise the whole text is lexed and tokenized.
     It is an error if the lexer or the tokenizer rejects the text.")
   (xdoc::p
    "Before the source unit is returned,
     it is checked to be well-formed (see @(tsee source-unit-wfp)),
     and it is an error if it is not.
     So every source unit that this function returns is well-formed,
     as the theorem below says.
     We have not proved that the check always succeeds,
     that is, that the tokenizer never makes
     a lexeme whose text differs from what was lexed;
     it has succeeded on every input that we have tried
     (see @(see differential-testing))."))
  (b* ((text (source-text->text source))
       (shebang (shebang-length text))
       (trees (lexemize-rust (nthcdr shebang text)))
       ((when (reserrp trees)) (reserrf-push trees))
       ((fty::okf lexemes) (lexeme-csts-to-lexemes trees shebang edition))
       ((fty::okf lexemes)
        (b* (((when (equal shebang 0)) lexemes)
             ((fty::okf content)
              (code-points-to-utf-8-string (nthcdr 2 (take shebang text)))))
          (cons (make-lexeme+span
                 :lexeme (lexeme-shebang content)
                 :span (make-span :start 0 :end shebang))
                lexemes)))
       (unit (make-source-unit :label label
                               :edition edition
                               :source source
                               :lexemes lexemes))
       ((unless (source-unit-wfp unit))
        (reserrf (list :lexemes-do-not-give-back-the-text))))
    unit)
  :guard-hints (("Goal" :in-theory (enable nfix)))

  ///

  (defret source-unit-wfp-of-source-unit-from-source-text
    (implies (not (reserrp unit))
             (source-unit-wfp unit)))

  (defret source-unit->source-of-source-unit-from-source-text
    (implies (not (reserrp unit))
             (equal (source-unit->source unit)
                    (source-text-fix source)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define source-unit-from-bytes ((bytes byte-listp)
                                (edition rust::editionp)
                                (label stringp))
  :returns (unit source-unit-resultp)
  :short "Turn the bytes of a source file into a source unit."
  :long
  (xdoc::topstring
   (xdoc::p
    "The bytes are turned into a source text
     (see @(tsee source-text-from-bytes)),
     which is lexed and tokenized
     (see @(tsee source-unit-from-source-text)).
     It is an error if the bytes are not valid UTF-8,
     or if the lexer or the tokenizer rejects the text."))
  (b* ((source (source-text-from-bytes bytes))
       ((when (reserrp source)) (reserrf-push source)))
    (source-unit-from-source-text source edition label))

  ///

  (defret source-unit-wfp-of-source-unit-from-bytes
    (implies (not (reserrp unit))
             (source-unit-wfp unit)))

  (defret source-unit->source-of-source-unit-from-bytes
    (implies (not (reserrp unit))
             (equal (source-unit->source unit)
                    (source-text-from-bytes bytes)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define source-unit-from-file ((path stringp)
                               (edition rust::editionp)
                               state)
  :returns (mv (unit source-unit-resultp) state)
  :short "Read a source file into a source unit."
  :long
  (xdoc::topstring
   (xdoc::p
    "It is an error if the file cannot be read,
     if its content is not valid UTF-8,
     or if the lexer or the tokenizer rejects its text.
     The label of the source unit is the path.
     A relative path is relative to
     the connected book directory (see @(tsee cbd))."))
  (b* ((path (str-fix path))
       ((mv source state) (source-text-from-file path state))
       ((when (reserrp source)) (mv (reserrf-push source) state)))
    (mv (source-unit-from-source-text source edition path) state))

  ///

  (defret source-unit-wfp-of-source-unit-from-file
    (implies (not (reserrp unit))
             (source-unit-wfp unit))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define source-unit-tokens ((unit source-unitp))
  :returns (tokens token+span-listp)
  :short "Tokens of a source unit, with their spans."
  :long
  (xdoc::topstring
   (xdoc::p
    "These are its lexemes without the whitespace, the comments
     that are not doc comments, and the shebang
     (see @(tsee lexeme+span-list->tokens)).
     Their spans are those of the lexemes:
     offsets into the text of the source unit."))
  (lexeme+span-list->tokens (source-unit->lexemes unit)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define source-unit-token-trees ((unit source-unitp))
  :returns (trees token-tree-list-resultp)
  :short "Token trees of a source unit."
  :long
  (xdoc::topstring
   (xdoc::p
    "The tokens of the source unit are grouped by their delimiters
     (see @(tsee build-token-trees)).
     It is an error if the delimiters do not match."))
  (build-token-trees (source-unit-tokens unit)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; What holds of a well-formed source unit.

(defrule lexeme+span-list-code-points-of-source-unit->lexemes
  :short "The lexemes of a well-formed source unit give back its text."
  (implies (source-unit-wfp unit)
           (equal (lexeme+span-list-code-points (source-unit->lexemes unit))
                  (source-unit-text unit)))
  :enable (source-unit-wfp source-unit-text))

;;;;;;;;;;;;;;;;;;;;

(defrule lexeme+span-list-located-p-of-source-unit->lexemes
  :short "Each lexeme of a well-formed source unit
          is in the text where its span says."
  (implies (source-unit-wfp unit)
           (lexeme+span-list-located-p (source-unit->lexemes unit)
                                       (source-unit-text unit)))
  :enable (source-unit-wfp source-unit-text))

;;;;;;;;;;;;;;;;;;;;

(defrule token+span-list-located-p-of-source-unit-tokens
  :short "Each token of a well-formed source unit
          is in the text where its span says."
  (implies (source-unit-wfp unit)
           (token+span-list-located-p (source-unit-tokens unit)
                                      (source-unit-text unit)))
  :enable source-unit-tokens)

;;;;;;;;;;;;;;;;;;;;

(defrule token+span-list-located-p-of-source-unit-token-trees
  :short "Each token in the token trees of a well-formed source unit
          is in the text where its span says."
  :long
  (xdoc::topstring
   (xdoc::p
    "This includes the delimiters of each group,
     which a token tree holds as the two spans of the group:
     flattening the trees gives the tokens back
     (see @(tsee token-tree-list->tokens))."))
  (b* ((trees (source-unit-token-trees unit)))
    (implies (and (source-unit-wfp unit)
                  (not (reserrp trees)))
             (token+span-list-located-p (token-tree-list->tokens trees)
                                        (source-unit-text unit))))
  :enable source-unit-token-trees)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Digest.

(defrulel all-unsigned-byte-p-8-when-byte-listp
  (implies (byte-listp x)
           (acl2::all-unsigned-byte-p 8 x))
  :induct t
  :enable (byte-listp bytep acl2::all-unsigned-byte-p))

(defrulel byte-listp-when-all-unsigned-byte-p-8
  (implies (and (acl2::all-unsigned-byte-p 8 x)
                (true-listp x))
           (byte-listp x))
  :induct t
  :enable (byte-listp bytep acl2::all-unsigned-byte-p))

;;;;;;;;;;;;;;;;;;;;

(define source-unit-digest ((unit source-unitp))
  :returns (digest byte-list-resultp)
  :short "Digest of the file of a source unit."
  :long
  (xdoc::topstring
   (xdoc::p
    "This is the SHA-256 hash, as 32 bytes,
     of the bytes of the file that the source unit came from,
     which its source text determines
     (see @(tsee source-text-to-bytes)).
     It identifies the content of the source unit:
     the label of a source unit is only a name,
     and a file of that name may since have changed.
     For a file on disk, it is what the command
     @('shasum -a 256') prints, in hexadecimal.")
   (xdoc::p
    "The digest is computed from the source unit when asked for;
     it is not a component of the source unit.
     It is an error if the source text has a code point
     that is not a Unicode scalar value,
     which does not happen in a well-formed source unit."))
  (b* (((fty::okf bytes) (source-text-to-bytes (source-unit->source unit)))
       ((unless (<= (len bytes) sha2::*sha-256-max-message-bytes*))
        (reserrf (list :too-long (len bytes)))))
    (sha2::sha-256-bytes bytes)))

;;;;;;;;;;;;;;;;;;;;

(defrule source-unit-digest-of-source-unit-from-bytes
  :short "The digest of a source unit made from the bytes of a file
          is the SHA-256 hash of those bytes."
  (b* ((unit (source-unit-from-bytes bytes edition label)))
    (implies (and (not (reserrp unit))
                  (<= (len bytes) sha2::*sha-256-max-message-bytes*))
             (equal (source-unit-digest unit)
                    (sha2::sha-256-bytes (byte-list-fix bytes)))))
  :enable (source-unit-digest
           source-unit-from-bytes
           not-reserrp-when-byte-listp))
