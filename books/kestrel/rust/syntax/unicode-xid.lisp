;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define xid-start-p ((nat natp))
  :returns (yes/no booleanp)
  :short "Check if a code point has the XID_Start property."
  (nat-in-codepoint-ranges-p nat *xid-start-ranges*))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define xid-continue-p ((nat natp))
  :returns (yes/no booleanp)
  :short "Check if a code point has the XID_Continue property."
  (nat-in-codepoint-ranges-p nat *xid-continue-ranges*))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; ASCII letters start identifiers; underscore and digits only continue.

(assert-event (xid-start-p (char-code #\a)))
(assert-event (xid-start-p (char-code #\Z)))
(assert-event (not (xid-start-p (char-code #\_))))
(assert-event (xid-continue-p (char-code #\_)))
(assert-event (not (xid-start-p (char-code #\0))))
(assert-event (xid-continue-p (char-code #\9)))
(assert-event (not (xid-continue-p (char-code #\space))))
(assert-event (not (xid-continue-p (char-code #\-))))

; Non-ASCII letters start; combining marks only continue.

(assert-event (xid-start-p #x3bb)) ; GREEK SMALL LETTER LAMBDA
(assert-event (xid-start-p #x4e00)) ; CJK UNIFIED IDEOGRAPH-4E00
(assert-event (xid-start-p #x00e9)) ; LATIN SMALL LETTER E WITH ACUTE
(assert-event (not (xid-start-p #x0301))) ; COMBINING ACUTE ACCENT
(assert-event (xid-continue-p #x0301))

; ZWNJ and ZWJ are in XID_Continue in the modern UCD
; (UTS #39 security profiles exclude them, but UAX #31 does not);
; whether rustc's identifier acceptance matches raw XID_Continue here
; is to be settled by differential testing when [SC4] is wired in.

(assert-event (not (xid-start-p #x200d))) ; ZERO WIDTH JOINER
(assert-event (xid-continue-p #x200d))

; Not identifier characters at all: emoji, surrogates' area.

(assert-event (not (xid-continue-p #x1f600))) ; GRINNING FACE
(assert-event (not (xid-start-p #xd800)))
(assert-event (not (xid-continue-p #x10ffff)))
