;
; Author: Eric McCarthy (bendyarm on GitHub)
;===============================================================================

; This grammar covers the lexical structure of Rust
; [Reference; rustc 1.87.0] for a first slice:
; whitespace, comments (except block doc comments),
; identifiers (ASCII-only for now), lifetimes,
; integer and float literals,
; character, byte, string, byte-string, and C-string literals
; (including their raw forms), punctuation, and delimiters.
; Not yet covered: block doc comments and the shebang line.

; The input to this grammar is a sequence of Unicode scalar values,
; i.e. code points excluding the surrogate range %xD800-DFFF;
; all character ranges below exclude surrogates.
; UTF-8 decoding is outside the grammar.

; Literal text strings containing letters use the RFC 7405
; case-sensitive form %s"..." since Rust is case-sensitive.

; Keywords are deliberately not enumerated in this grammar:
; keyword classification is edition-dependent (see [SC6]),
; so it cannot be expressed in a static grammar;
; the rule identifier-or-keyword covers both.

; Extra-grammatical side conditions are labeled [SCn] at their
; points of relevance below; each has (or will have) a declarative
; specification in extra-grammatical-restrictions.lisp:
;
; [SC1] Maximal munch: at each point of the input, among the valid
;       lexemes (grammar match plus the other side conditions) that
;       match a prefix of the remaining input, lexing takes a
;       longest one.
; [SC2] Block comment closing: the block-comment rule below
;       overapproximates; a valid block comment ends at the first
;       point where its "/*"-"*/" nesting depth returns to zero.
;       (This condition constrains the candidate set over which
;       [SC1] maximizes; without it, maximal munch would overshoot
;       to a later "*/".)
; [SC3] Bare carriage return: CR not immediately followed by LF
;       must not occur in doc comments; not yet formalized.
;       (The literal rules below exclude it from literals too,
;       except within a string continuation.)
; [SC4] Identifiers: the ASCII-only identifier rules below are
;       placeholders for Unicode XID_Start / XID_Continue
;       (Unicode 16.0.0) with NFC normalization.  The XID tables
;       now exist (unicode-xid.lisp); these rules will be replaced
;       once the grammar and lexer use them.
; [SC5] Raw identifiers: the identifier-or-keyword part of a
;       raw-identifier or raw-lifetime must not be "crate",
;       "self", "super", or "Self".
; [SC6] Keyword classification: an identifier-or-keyword token that
;       is a strict or reserved keyword of the current edition
;       (see keywords.lisp) is a keyword token, not an identifier.
; [SC7] Reserved numeric forms: certain forms are reserved and must
;       be rejected rather than lexed as a number literal followed
;       by more input
;       [Reference; reserved forms similar to number literals]:
;       (a) text that starts with "0b", "0o", or "0x" but is not a
;       bin-literal, oct-literal, or hex-literal with an optional
;       suffix, e.g. "0b_" (no binary digits), "0b123" (a decimal
;       digit after the binary digits), and "0b1e" (there are no
;       binary float literals); by the rules alone, each of these
;       is the dec-literal "0" with a suffix;
;       (b) a bin-literal, oct-literal, or hex-literal without a
;       suffix, immediately followed by a "." that is not itself
;       followed by ".", "_", or an identifier-start, e.g. "0x1.5"
;       (there are no hexadecimal float literals);
;       (c) an integer-literal or float-literal immediately
;       followed by "e" or "E", e.g. "1e", "1.0e+", and "2em"
;       (an exponent without digits).
; [SC8] Reserved prefixes: an identifier-or-keyword (not a raw
;       identifier), or a lone "_", immediately followed by "#",
;       "'", or a double quote is a reserved prefix, which must be
;       rejected [Reference; reserved prefixes] in both supported
;       editions, 2021 and 2024.  Genuine
;       raw-identifier forms like r#ident are not affected: they
;       lex as single raw-identifier lexemes.  Nor are literal
;       prefixes like the "b" of b"..." or the "br" of br#"..."#:
;       under [SC1] a valid literal lexes as a single lexeme, and
;       when the literal is invalid, rustc rejects the input too.
;       Likewise, a lifetime-token other than a raw-lifetime,
;       immediately followed by "#", is a reserved lifetime prefix,
;       which must be rejected.  [Reference; reserved prefixes]
;       exempts 'r, but rustc rejects 'r# when no raw lifetime
;       follows (e.g. 'r#1, and 'r#_ since a lone "_" is not an
;       identifier); we follow rustc.
; [SC9] Unicode escapes: the value of a unicode-escape, read as
;       hexadecimal ignoring underscores, must be a Unicode scalar
;       value (at most %x10FFFF, and outside %xD800-DFFF); in a
;       c-string-literal it must also be nonzero.
; [SC10] Raw string termination: the raw-*-content rules below
;       overapproximate their bodies.  A raw literal with n "#"
;       before its opening double quote ends at the first double
;       quote followed by n "#", so the side condition is that its
;       body contains no such sequence; also, n must be at most 255.
; [SC11] Underscore after a literal: a character, byte, string,
;       byte-string, or C-string literal (raw or not) immediately
;       followed by "_" must be rejected.  rustc's lexer reads such
;       a "_" as the literal's suffix and rejects it.  In
;       [Reference; suffixes], a suffix has the form of an
;       identifier, and a lone "_" is not an identifier, so the "_"
;       would lex as a separate token; we follow rustc.  After a
;       number literal, maximal munch absorbs any "_" into the
;       digits or the suffix (and a float literal that ends with
;       its period is not followed by "_", by [SC14]).
; [SC12] Lifetimes and character literals: a lifetime-token (raw
;       or not) immediately followed by "'" must be rejected.
;       rustc reads such text, e.g. 'ab', as a character literal
;       with more than one character, and rejects it.
; [SC13] String continuations: a string-continue takes the whole
;       run of tabs, line feeds, carriage returns, and spaces after
;       its line feed.  That is, in its literal it is not
;       immediately followed by a tab, line feed, or space as a
;       character of the literal, which the rules alone allow.
; [SC14] Float literals ending with a period: a float-literal that
;       consists of a dec-literal and "." is not immediately
;       followed by ".", "_", or an identifier-start.  So "1..2" is
;       "1", "..", "2", and "1.max" is "1", ".", "max".  (Like
;       [SC2], this condition constrains the candidate set over
;       which [SC1] maximizes; unlike [SC2], it depends on the
;       input after the candidate.)
;
; Where [Reference] and rustc differ, this grammar follows rustc;
; the xdoc topic reference-vs-rustc (in grammar.lisp) lists the
; cases.

;-------------------------------------------------------------------------------
; Lexemes
;-------------------------------------------------------------------------------

lexeme = whitespace / comment / token ; [SC1]

token = identifier-or-keyword ; [SC6]
      / raw-identifier
      / lifetime-token
      / char-literal
      / byte-literal
      / string-literal
      / byte-string-literal
      / c-string-literal
      / raw-string-literal
      / raw-byte-string-literal
      / raw-c-string-literal
      / integer-literal
      / float-literal
      / punctuation
      / delimiter

;-------------------------------------------------------------------------------
; Whitespace
;-------------------------------------------------------------------------------

; The whitespace characters are those of [Reference; whitespace].
; Note that they include two bidirectional marks (%x200E-200F),
; a lexical-security concern to revisit.

whitespace = 1*whitespace-char

whitespace-char = %x9 ; horizontal tab
                / %xA ; line feed
                / %xB ; vertical tab
                / %xC ; form feed
                / %xD ; carriage return
                / %x20 ; space
                / %x85 ; next line
                / %x200E ; left-to-right mark
                / %x200F ; right-to-left mark
                / %x2028 ; line separator
                / %x2029 ; paragraph separator

;-------------------------------------------------------------------------------
; Comments
;-------------------------------------------------------------------------------

; Under maximal munch [SC1], these rules reproduce rustc's
; classification quirks: "//" and "////..." are plain line comments
; (on "////...", line-comment matches more input than
; outer-line-doc's "///"), "///" begins an outer line doc comment,
; and "//!" begins an inner line doc comment.

comment = line-comment
        / outer-line-doc
        / inner-line-doc
        / block-comment

line-comment = "//" [ ( not-slash-bang-lf / "//" ) *not-lf ]

outer-line-doc = "///" [ not-slash-lf *not-lf ] ; [SC3]

inner-line-doc = "//!" *not-lf ; [SC3]

; Block comments nest: block-item includes block-comment.
; The rule overapproximates: see [SC2].

block-comment = "/*" *block-item "*/" ; [SC2]

block-item = block-comment
           / not-star-slash
           / "*"
           / "/"

;-------------------------------------------------------------------------------
; Identifiers
;-------------------------------------------------------------------------------

; A lone "_" is not an identifier; it is punctuation.
; ASCII-only for now: see [SC4].

identifier-or-keyword = identifier-start *identifier-continue ; [SC8]
                      / "_" 1*identifier-continue

identifier-start = ascii-letter ; [SC4]

identifier-continue = ascii-letter / dec-digit / "_" ; [SC4]

raw-identifier = %s"r#" identifier-or-keyword ; [SC5]

;-------------------------------------------------------------------------------
; Lifetimes
;-------------------------------------------------------------------------------

; A lifetime or loop label is a single quote followed by an
; identifier or keyword (keywords are allowed, e.g. 'static), by a
; lone "_" (the placeholder lifetime), or by "r#" and an identifier
; or keyword (a raw lifetime).  When a single quote, one character,
; and another single quote form a character literal, the character
; literal is the longer lexeme, so it wins under [SC1].

lifetime-token = "'" identifier-or-keyword ; [SC8] [SC12]
               / "'_" ; [SC8] [SC12]
               / raw-lifetime ; [SC12]

raw-lifetime = %s"'r#" identifier-or-keyword ; [SC5]

;-------------------------------------------------------------------------------
; Integer literals
;-------------------------------------------------------------------------------

integer-literal = ( dec-literal
                  / bin-literal
                  / oct-literal
                  / hex-literal )
                  [ suffix-no-e ] ; [SC7]

dec-literal = dec-digit *( dec-digit / "_" )

bin-literal = %s"0b" *( bin-digit / "_" ) bin-digit *( bin-digit / "_" )

oct-literal = %s"0o" *( oct-digit / "_" ) oct-digit *( oct-digit / "_" )

hex-literal = %s"0x" *( hex-digit / "_" ) hex-digit *( hex-digit / "_" )

; A suffix is identifier-shaped text immediately after the digits;
; any such suffix lexes [Reference; suffixes], with validity
; checked in later phases.  On integer literals the suffix must not
; start with "e" or "E" (which would be a float exponent), hence
; this rule.  Nor does it start with "_": the digit rules above
; take every "_" that follows the digits, as rustc's lexer does.
; ([Reference; suffixes] also lets a suffix start with "_", which
; makes e.g. 1_a ambiguous, and 1_e the integer 1 with suffix _e,
; which rustc rejects.)

suffix-no-e = ascii-letter-no-e *identifier-continue

;-------------------------------------------------------------------------------
; Float literals
;-------------------------------------------------------------------------------

; A float literal is a decimal literal followed by a period, by a
; period and a fraction, or by an exponent, with or without a
; period and a fraction before the exponent.  A literal that ends
; with its period takes no suffix, and the rule for it
; overapproximates: see [SC14].  Float literals have no radix
; prefix, and an exponent has at least one digit: see [SC7].

float-literal = dec-literal "." ; [SC14]
              / dec-literal "." dec-literal [ suffix-no-e ] ; [SC7]
              / dec-literal [ "." dec-literal ] float-exponent
                [ suffix-no-underscore ]

float-exponent = ( %s"e" / %s"E" ) [ "+" / "-" ]
                 *( dec-digit / "_" ) dec-digit *( dec-digit / "_" )

; After an exponent, a suffix may start with "e" or "E": 1e2e3 is
; a float literal with suffix e3.  As after any digits, a suffix
; does not start with "_".

suffix-no-underscore = identifier-start *identifier-continue

;-------------------------------------------------------------------------------
; Character and string literals
;-------------------------------------------------------------------------------

; Any literal may carry a suffix [Reference; suffixes]; its validity
; is checked in later phases.  As for integer literals, a suffix is
; identifier-shaped text immediately after the literal.

suffix = identifier-or-keyword ; [SC11]

; A character literal holds one character or one escape.  Tab, line
; feed, and carriage return must be escaped; so must the quote
; character itself and the backslash.

char-literal = "'" ( char-literal-char
                   / quote-escape
                   / ascii-escape
                   / unicode-escape )
               "'" [ suffix ]

; A byte literal is like a character literal, restricted to ASCII,
; with byte escapes instead of ASCII and unicode escapes.

byte-literal = %s"b'" ( ascii-for-char / byte-escape ) "'" [ suffix ]

; String literals may span lines.  A backslash immediately before a
; line feed starts a string continuation, which extends over the
; tabs, line feeds, carriage returns, and spaces that follow.
; A carriage return must not occur anywhere else in a literal:
; the CR LF pairs of the source have been normalized to LF
; before lexing, and any other CR is rejected there.

string-literal = dquote *( string-literal-char
                       / quote-escape
                       / ascii-escape
                       / unicode-escape
                       / string-continue )
                 dquote [ suffix ]

byte-string-literal = %s"b" dquote *( ascii-for-string
                                  / byte-escape
                                  / string-continue )
                      dquote [ suffix ]

; C string literals (stabilized in Rust 1.77, for editions 2021 and
; 2024) denote NUL-terminated strings, so they must not contain NUL,
; whether written directly or as an escape [SC9].

c-string-literal = %s"c" dquote *( c-string-literal-char
                               / c-byte-escape
                               / unicode-escape ; [SC9]
                               / string-continue )
                   dquote [ suffix ]

; The raw forms have no escapes.  The recursion puts the same
; number n of "#" before the opening double quote and after the
; closing one; e.g. n = 2 in r##"a"#b"##, whose body is a"#b.
; The body rule overapproximates: in a valid raw literal, the body
; contains no double quote followed by n "#", because the literal
; ends at the first such sequence.  See [SC10].

raw-string-literal = %s"r" raw-string-content [ suffix ]

raw-string-content = dquote *raw-string-char dquote ; [SC10]
                   / "#" raw-string-content "#"

raw-byte-string-literal = %s"br" raw-byte-string-content [ suffix ]

raw-byte-string-content = dquote *ascii-for-raw dquote ; [SC10]
                        / "#" raw-byte-string-content "#"

raw-c-string-literal = %s"cr" raw-c-string-content [ suffix ]

raw-c-string-content = dquote *raw-c-string-char dquote ; [SC10]
                     / "#" raw-c-string-content "#"

; Escapes.  An ASCII escape "\x" takes at most %x7F; a byte escape
; "\x" takes any byte.  A unicode escape has one to six hexadecimal
; digits, each optionally followed by underscores [SC9].

quote-escape = "\'" / "\" dquote

ascii-escape = %s"\x" oct-digit hex-digit
             / %s"\n" / %s"\r" / %s"\t" / "\\" / "\0"

byte-escape = %s"\x" hex-digit hex-digit
            / %s"\n" / %s"\r" / %s"\t" / "\\" / "\0"
            / "\'" / "\" dquote

; In C strings, "\0" and "\x00" are excluded.

c-byte-escape = %s"\x" ( nonzero-hex-digit hex-digit
                       / "0" nonzero-hex-digit )
              / %s"\n" / %s"\r" / %s"\t" / "\\"
              / "\'" / "\" dquote

unicode-escape = %s"\u{" 1*6( hex-digit *"_" ) "}" ; [SC9]

; A string continuation takes the whole run of whitespace after the
; line feed; rustc skips that run when it evaluates the literal.
; The characters of the run other than CR are also string
; characters, so the rules alone also allow a shorter continuation
; followed by whitespace characters of the string; [SC13] excludes
; that.

string-continue = "\" lf *skipped-whitespace-char ; [SC13]

;-------------------------------------------------------------------------------
; Punctuation and delimiters
;-------------------------------------------------------------------------------

; The 47 punctuation tokens of [Reference; punctuation],
; including the lone underscore, and including "<-" and "~",
; which are currently unused by the language but lex as tokens.
; Under [SC1], e.g. ">>=" lexes as one token, and "_a" lexes as
; an identifier rather than as "_" followed by "a".

punctuation = "+" / "-" / "*" / "/" / "%" / "^" / "!" / "&" / "|"
            / "&&" / "||" / "<<" / ">>"
            / "+=" / "-=" / "*=" / "/=" / "%=" / "^=" / "&=" / "|="
            / "<<=" / ">>="
            / "=" / "==" / "!=" / ">" / "<" / ">=" / "<="
            / "@" / "_" / "." / ".." / "..." / "..="
            / "," / ";" / ":" / "::"
            / "->" / "=>" / "<-"
            / "#" / "$" / "?" / "~"

delimiter = "(" / ")" / "[" / "]" / "{" / "}"

;-------------------------------------------------------------------------------
; Character classes
;-------------------------------------------------------------------------------

ascii-letter = %x41-5A / %x61-7A

ascii-letter-no-e = %x41-44 / %x46-5A / %x61-64 / %x66-7A

dec-digit = %x30-39

bin-digit = %x30-31

oct-digit = %x30-37

hex-digit = dec-digit / %x41-46 / %x61-66

not-lf = %x0-9 / %xB-D7FF / %xE000-10FFFF

not-slash-bang-lf = %x0-9 / %xB-20 / %x22-2E / %x30-D7FF / %xE000-10FFFF

not-slash-lf = %x0-9 / %xB-2E / %x30-D7FF / %xE000-10FFFF

not-star-slash = %x0-29 / %x2B-2E / %x30-D7FF / %xE000-10FFFF

nonzero-hex-digit = %x31-39 / %x41-46 / %x61-66

dquote = %x22 ; double quote

lf = %xA ; line feed

; The whitespace that a string continuation extends over:

skipped-whitespace-char = %x9 ; horizontal tab
                        / %xA ; line feed
                        / %xD ; carriage return
                        / %x20 ; space

; Any character except tab, LF, CR, single quote, and backslash:

char-literal-char = %x0-8 / %xB-C / %xE-26 / %x28-5B / %x5D-D7FF
                  / %xE000-10FFFF

; Any character except CR, double quote, and backslash:

string-literal-char = %x0-C / %xE-21 / %x23-5B / %x5D-D7FF
                    / %xE000-10FFFF

; Any character except NUL, CR, double quote, and backslash:

c-string-literal-char = %x1-C / %xE-21 / %x23-5B / %x5D-D7FF
                      / %xE000-10FFFF

; Any character except CR:

raw-string-char = %x0-C / %xE-D7FF / %xE000-10FFFF

; Any character except NUL and CR:

raw-c-string-char = %x1-C / %xE-D7FF / %xE000-10FFFF

; ASCII except tab, LF, CR, single quote, and backslash:

ascii-for-char = %x0-8 / %xB-C / %xE-26 / %x28-5B / %x5D-7F

; ASCII except CR, double quote, and backslash:

ascii-for-string = %x0-C / %xE-21 / %x23-5B / %x5D-7F

; ASCII except CR:

ascii-for-raw = %x0-C / %xE-7F
