; This book was produced by Claude and passed along by Eric Smith.  It
; illustrates a soundness bug fixed before ACL2 Version 8.8.

; The guard on partial-functions-table checked the events supporting each entry
; but not the raw Lisp definition stored as the last element of the entry,
; which is what (memoize fn :total fn-limit) installs as the code for fn.  So a
; table event could store any definition, which then ran in place of fn.

(in-package "ACL2")

(include-book "std/testing/must-fail" :dir :system)

(defun f-limit (x limit)
  (declare (type (integer 0 *) limit)
           (xargs :measure (nfix limit)))
  (if (zp limit)
      0
    (let ((limit (1- limit)))
      (if (atom x)
          7
        (f-limit (cdr x) limit)))))

(defthm f-limit-is-0-or-7
  (or (equal (f-limit x limit) 0)
      (equal (f-limit x limit) 7))
  :rule-classes nil)

; The following three events are exactly those generated by (memoize-partial
; f).

(defchoose f-limit-change (large) (x limit)
  (and (natp large)
       (<= limit large)
       (not (equal (f-limit x limit)
                   (f-limit x large)))))

(defchoose f-limit-stable (limit) (x)
  (and (natp limit)
       (equal (f-limit x limit)
              (f-limit x (f-limit-change x limit)))))

(defun f (x)
  (declare (xargs :guard t))
  (f-limit x (nfix (non-exec (f-limit-stable x)))))

(defthm f-is-0-or-7
  (or (equal (f x) 0)
      (equal (f x) 7))
  :hints (("Goal" :use (:instance f-limit-is-0-or-7
                                  (limit (nfix (f-limit-stable x))))))
  :rule-classes nil)

; Before the fix, the table event below was accepted although its stored
; definition of f is bogus, and then (f '(a b c)) evaluated to 99.

(must-fail
 (encapsulate
   ()
   (table partial-functions-table 'f-limit
          '((f f-limit f-limit-change f-limit-stable
               (defun f (x) (declare (ignore x)) 99))))
   (memoize 'f :total 'f-limit)
   (defthm nil-proved
     nil
     :hints (("Goal" :use (:instance f-is-0-or-7 (x '(a b c)))))
     :rule-classes nil)))

; The table event generated by memoize-partial is still accepted.

(memoize-partial f)

(assert-event (equal (f '(a b c)) 7))
