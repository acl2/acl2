; This book is based on an example produced by Claude and passed along by Eric
; Smith.  It illustrates a soundness bug fixed before ACL2 Version 8.8.  The
; bug was in the raw definition of the keys function for a stobj-table field,
; generated by defstobj-field-fns-raw-defs (basis-a.lisp).  Previously the raw
; function returned the actual keys of the underlying hash table.  But this
; table used stand-in symbols, not the actual names of the stobjs expected by
; the logical characterization.  The raw definition has now been fixed to map
; the stand-in symbols back to the stobj names before returning the keys.

(in-package "ACL2")

(include-book "std/testing/must-fail" :dir :system)

(defstobj st (stt :type (stobj-table)))
(defstobj sub)

(defund k ()
  (declare (xargs :guard t))
  (with-local-stobj st
    (mv-let (v st)
      (stobj-let ((sub (stt-get 'sub st (create-sub)) stt-put))
                 (sub)
                 sub
                 (mv (stt-keys st) st))
      v)))

; By the logical definitions, the keys of the stobj-table are the stobj names.
(defthm k-by-definition
  (equal (k) '(sub))
  :rule-classes nil
  :hints (("Goal" :in-theory (e/d ((:definition k))
                                  ((:executable-counterpart k))))))

; Previously, this theorem would fail, since (k) evaluated to a list of
; stand-ins such as '(sub325).
(defthm k-by-execution
  (equal (k) '(sub))
  :rule-classes nil
  :hints (("Goal" :in-theory (e/d ((:executable-counterpart k))
                                  ((:definition k))))))

(must-fail
 (defthm k-is-not-sub-by-execution
   (not (equal (car (k)) 'sub))
   :rule-classes nil))
