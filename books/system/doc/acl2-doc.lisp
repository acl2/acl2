; Using ACL2 Version 7.2, the following script introduces a metafunction that
; rewrites a term to a ``term'' containing a :program mode function.  We even
; prove the :well-formedness-guarantee theorem for it.  Then we demonstrate a
; thm that produces a checkpoint that contains a :program mode function.  These
; events are all to be carried out before our fix to the bug discussed below,
; "The handling of metafunctions allowed an invariant to be violated...".
;
;   (defun prog-mode-fn (x)
;     (declare (xargs :mode :program))
;     x)
;
;   (defun target-fn (x flg)
;     (if (equal flg t)
;         x
;         nil))
;
;   (defun flag-hider (x)
;     (declare (ignore x))
;     t)
;
;   ; Now we introduce the metafunction simp which transforms (target-fn ... T)
;   ; to (target-fn ... (flag-hider (prog-mode-fn ...))) and we can prove this
;   ; correct without needing anything about prog-mode-fn because flag-hider is
;   ; identically T.
;
;   (defun simp (x)
;     (cond ((and (consp x)
;                 (eq (car x) 'target-fn)
;                 (equal (caddr x) *t*))
;            (list 'target-fn
;                  (cadr x)
;                  (list 'flag-hider
;                        (list 'prog-mode-fn (cadr x)))))
;           (t x)))
;
;   (defevaluator sev sev-lst ((target-fn x flg) (flag-hider x)))
;
;   (defthm simp-correct
;     (equal (sev x a)
;            (sev (simp x) a))
;     :rule-classes ((:meta :trigger-fns (target-fn))))
;
;   ; This next event is optional: whether we know simp produces a termp or we
;   ; do the runtime check after simp is applied, the result is the same: in
;   ; the thm below a :program mode function symbol is introduced into the
;   ; theorem.
;
;   (defthm simp-is-well-formed
;     (implies (and (termp x w)
;                   (arities-okp '((TARGET-FN . 2)
;                                  (PROG-MODE-FN . 1)
;                                  (FLAG-HIDER . 1))
;                                w))
;              (termp (simp x) w))
;     :rule-classes nil)
;
;   (in-theory (disable target-fn
;                       flag-hider
;                       (:type-prescription flag-hider)))
;
;   (thm (equal (target-fn x t) xxx))
;
;   *** Key checkpoint at the top level: ***
;
;   Goal'
;   (EQUAL (TARGET-FN X (FLAG-HIDER (PROG-MODE-FN X)))
;          XXX)

