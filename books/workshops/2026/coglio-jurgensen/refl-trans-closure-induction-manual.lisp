(in-package "ACL2")

(include-book "centaur/fty/top" :dir :system)
(include-book "std/util/defund-sk" :dir :system)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; This book follows from 'refl-trans-closure-induction-attempts.lisp'.
; We manually build events like the ones generated by 'definductive',
; as an enhancement of those shown in 'refl-trans-closure-manual.lisp',
; which highlights the rule induction scheme generated by 'definductive',
; and its use in the proof from 'refl-trans-closure-induction-attempts.lisp'.

; Some of this material is shown in Section 4.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; These are the same as in refl-trans-closure-manual.lisp.

(defstub r (* *) => *)

(fty::deftagsum r*-proof
  (:base (x y))
  (:refl (x))
  (:trans (x y z (premise1-proof r*-proof) (premise2-proof r*-proof)))
  :pred r*-proofp
  :xvar proof)

(defund r*-proof-validp (proof a b)
  (declare (xargs :guard (r*-proofp proof)
                  :measure (r*-proof-count proof)))
  (r*-proof-case
   proof
   :base (and (r proof.x proof.y)
              (equal a proof.x)
              (equal b proof.y))
   :refl (and (equal a proof.x)
              (equal b proof.x))
   :trans (and (equal a proof.x)
               (equal b proof.z)
               (r*-proof-validp proof.premise1-proof proof.x proof.y)
               (r*-proof-validp proof.premise2-proof proof.y proof.z))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The definition of r* changes, compared to refl-trans-closure-manual.lisp.
; It has a new condition, namely that the proof tree is minimal in size.
; Note that this does *not* change the meaning of r*:
; a minimal proof tree exists exactly when any proof tree exists (see below).
; Note that a minimal proof tree need not be unique:
; there may exist multiple (valid) proof trees for the same conclusion
; with the same size;
; uniqueness is not required for our purposes.

(defund-sk r*-proof-minimalp (proof a b)
  (forall (proof2)
          (implies (and (r*-proofp proof2)
                        (r*-proof-validp proof2 a b))
                   (<= (r*-proof-count proof)
                       (r*-proof-count proof2)))))

(defund-sk r* (a b)
  (exists (proof)
          (and (r*-proofp proof)
               (r*-proof-validp proof a b)
               (r*-proof-minimalp proof a b))) ; new condition
  :skolem-name r*-proof)

; The r*-suff theorem is now harder to use,
; because of the additional minimality hypothesis.
; But we can prove an alternative theorem without that hypothesis,
; which is like the r*-suff in refl-trans-closure-manual.lisp.
; Note that r*-descend below always finds a minimal proof,
; because if the current one is not minimal,
; r*-proof-minimalp gives us a smaller witness proof to try.

(encapsulate ()

  (local
    (defun r*-descend (proof a b)
      (declare (xargs :measure (r*-proof-count proof)
                      :hints (("Goal"
                                :use (:instance r*-proof-minimalp
                                                (proof proof) (a a) (b b))))))
      (if (and (r*-proofp proof)
               (r*-proof-validp proof a b)
               (not (r*-proof-minimalp proof a b)))
          (r*-descend (r*-proof-minimalp-witness proof a b) a b)
        nil)))

  ;; A version of r*-suff that drops the unnecessary minimality hypothesis.
  ;; The validity hypothesis comes first so that,
  ;; when this is used as a rewrite rule,
  ;; free-variable matching binds PROOF from it
  ;; rather than from the weaker recognizer hypothesis
  ;; (which the witness also satisfies, sending the match down a dead end).
  (defthm r*-when-proof-validp
    (implies (and (r*-proof-validp proof a b)
                  (r*-proofp proof))
             (r* a b))
    :hints (("Goal"
             :induct (r*-descend proof a b)
             :in-theory (enable r*-suff r*-proof-minimalp)))))

; The r*-proof is indeed minimal among valid proofs (if it itself is valid).

(defthm r*-proof-count-bound
  (implies (and (r*-proofp proof)
                (r*-proof-validp proof a b))
           (<= (r*-proof-count (r*-proof a b))
               (r*-proof-count proof)))
  :rule-classes ((:linear :trigger-terms ((r*-proof-count (r*-proof a b)))))
  :hints (("Goal"
           :use ((:instance r* (a a) (b b))
                 (:instance r*-proof-minimalp-necc
                            (proof (r*-proof a b))
                            (proof2 proof))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; These are almost the same as in refl-trans-closure-manual.lisp,
; except that we use r*-when-proof-validp above instead of r*-suff.

(defthmd r*-base
  (implies (r x y)
           (r* x y))
  :hints (("Goal"
           :in-theory (enable r*-proof-validp)
           :use (:instance r*-when-proof-validp
                           (proof (r*-proof-base x y))
                           (a x)
                           (b y)))))

(defthmd r*-refl
  (r* x x)
  :hints (("Goal"
           :in-theory (enable r*-proof-validp)
           :use (:instance r*-when-proof-validp
                           (proof (r*-proof-refl x))
                           (a x)
                           (b x)))))

(defthmd r*-trans
  (implies (and (r* x y)
                (r* y z))
           (r* x z))
  :hints (("Goal"
           :in-theory (enable r*-proof-validp)
           :expand ((r* x y)
                    (r* y z))
           :use (:instance r*-when-proof-validp
                           (proof (r*-proof-trans x y z
                                                  (r*-proof x y)
                                                  (r*-proof y z)))
                           (a x)
                           (b z)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; This is the induction scheme.

(defun r*-induct (a b)
  (declare (xargs :measure (r*-proof-count (r*-proof a b))
                  :hints
                  (("Goal"
                    :expand ((r*-proof-validp (r*-proof a b) a b))
                    :use ((:instance r*-proof-count-bound
                                     (proof (r*-proof-trans->premise1-proof
                                             (r*-proof a b)))
                                     (a (r*-proof-trans->x (r*-proof a b)))
                                     (b (r*-proof-trans->y (r*-proof a b))))
                          (:instance r*-proof-count-bound
                                     (proof (r*-proof-trans->premise2-proof
                                             (r*-proof a b)))
                                     (a (r*-proof-trans->y (r*-proof a b)))
                                     (b (r*-proof-trans->z (r*-proof a b)))))
                    :in-theory (enable r*)))))
  (and (r* a b)
       (let ((proof (r*-proof a b)))
         (r*-proof-case proof
                        :base nil
                        :refl nil
                        :trans (list (r*-induct proof.x proof.y)
                                     (r*-induct proof.y proof.z))))))

; The induction rule, so that a plain :induct hint on (r* a b) works.

(defthm r*-induction
  t
  :rule-classes ((:induction :pattern (r* a b)
                             :scheme (r*-induct a b))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; This is the example introduced in refl-trans-closure-induction-attempts.lisp,
; i.e. that we have a function f that preserves r.

(encapsulate
  (((f *) => *))

  (local (defun f (x) x))

  (defthm r-of-f
    (implies (r x y)
             (r (f x) (f y)))))

; This is the proof that f also preserves r*, using the above induction scheme.

(defthm r*-of-f
  (implies (r* a b)
           (r* (f a) (f b)))
  :hints (("Goal"
           ;; The :induct hint uses r*-induction to suggest (r*-induct a b).
           :induct (r* a b)
           ;; We may need better rules to avoid such :expand hints.
           :expand ((r* a b)
                    (r*-proof-validp (r*-proof a b) a b))
           :in-theory (enable r*-base
                              r*-refl
                              r*-trans))))
