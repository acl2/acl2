(in-package "ACL2")

(include-book "std/util/definductive" :dir :system)
(include-book "std/testing/must-fail" :dir :system)
(include-book "std/testing/must-succeed-star" :dir :system)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; This file provides motivation for the inference rule induction principle
; that is fleshed out in the file refl-trans-closure-induction-manual.lisp,
; and described in general terms in Sections 4 and 5.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Take the reflexive and transitive closure of some relation r.

(defstub r (* *) => *)

(definductive refl-trans-closure
  :preds ((r* a b))
  :irules ((base ((r x y)) (r* x y))
           (refl () (r* x x))
           (trans ((r* x y) (r* y z)) (r* x z))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Let's say we have some function `f` that preserves relation `r`.

(encapsulate
  (((f *) => *))

  (local (defun f (x) x))

  (defthm r-of-f
    (implies (r x y)
             (r (f x) (f y)))))

; Then it should be the case that it also preserves r*. This is provable by
; induction on r*.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Below, we go through various approaches attempting this proof.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Of course, we cannot induct "directly" on `r*`; it is not recursive and
; therefore does not have an induction rune.
(must-fail
  (thm
    (implies (r* a b)
             (r* (f a) (f b)))
    :hints (("Goal" :induct (r* a b)
                    :in-theory (enable (:i r*)))))
  :with-output-off nil)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; What we want to do is induct according to the recursive structure of
; `r*-proof-validp`. But this requires a value for the proof tree witness.
; Providing the actual value does not suggest an induction scheme.
(must-fail
  (thm
    (implies (r* a b)
             (r* (f a) (f b)))
    :hints (("Goal" :induct (r*-proof-validp (r*-proof a b) a b)
                    :in-theory (enable r*
                                       r*-proof-validp))))
  :with-output-off nil)

; Inducting with an arbitrary proof tree doesn't work either. We end up with a
; disconnect between the proof tree we are inducting over and the one
; witnessing `(r* a b)`.
(must-fail
  (thm (implies (r* a b)
                (r* (f a) (f b)))
      :hints (("Goal" :induct (r*-proof-validp proof a b)
                      :in-theory (enable r*
                                         r*-proof-validp
                                         r*-base-validp
                                         r*-refl-validp
                                         r*-trans-validp
                                         r*-base
                                         r*-refl
                                         r*-trans))))
  :with-output-off nil)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; One successful approach is to first prove an auxilliary lemma in which the
; proof tree does appear transparently as an arbitrary variable.

(must-succeed*
  (defthm r*-of-f-when-proof-validp
    (implies (r*-proof-validp proof a b)
             (r* (f a) (f b)))
    :hints (("Goal" :induct (r*-proof-validp proof a b)
                    :in-theory (enable r*-proof-validp
                                       r*-base-validp
                                       r*-refl-validp
                                       r*-trans-validp
                                       r*-base
                                       r*-refl
                                       r*-trans))))

  ;; Then the general theorem follows quickly.

  (defthm r*-of-f
    (implies (r* a b)
             (r* (f a) (f b)))
    :hints (("Goal" :in-theory (enable r*)))))

; However, this approach wasn't ideal. We'd like to be able to prove r*-of-f
; more directly without having to go through auxiliary lemmas and dealing with
; the validity recognizer explicitly.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Ultimately, we want an induction scheme to use with r* that doesn't mention
; a proof tree in the arguments. Such an induction scheme is generated by
; definductive, and repeated as a redundant event below.

(define r*-induct (a b)
  :measure (r*-proof-count (r*-proof a b))
  (and (r* a b)
       (let ((proof (r*-proof a b)))
         (r*-proof-case proof
                        (:base nil)
                        (:refl nil)
                        (:trans (let ((x proof.x) (y proof.y) (z proof.z))
                                  (declare (ignorable x y z))
                                  (list (r*-induct x y)
                                        (r*-induct y z)))))))
  :verify-guards nil)

; Instead of taking a proof tree argument, we use the choice function to find a
; witness at each step, and use the size of the witness as the function
; measure. For this to work as a measure, the choice function must pick a
; smaller proof tree at each step. For this reason, we constrain r* to choose
; the smallest proof tree it can. See refl-trans-closure-induction-manual.lisp
; for more details.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Finally, we note that we *could* avoid the auxilliary lemma
; r*-of-f-when-proof-validp without the induction scheme above, by first
; generalizing the proof tree. Doing so however requires complicated clause
; processors and computed hints that we would rather avoid.

(must-succeed*
  (local (include-book "clause-processors/generalize" :dir :system))

  (local
    (defun r*-generalize-hint-cont (a b id clause)
      (declare (xargs :guard t :verify-guards nil))
      (cond
        ;; Backstop: do not act inside the induction.
        ((not (null (access clause-id id :pool-lst))) nil)
        ;; Stage 2: generalize the witness, and the minimality conjunct that
        ;; came with it, to fresh variables. The freshness test also keeps
        ;; this stage from looping: without it, a clause processor call that
        ;; the processor declines to perform would leave the clause unchanged
        ;; and fire this same hint again.
        ((and (member-equal
                (list 'not (list 'r*-proof-validp (list 'r*-proof a b) a b))
                clause)
              (not (intersectp-equal '(gen-proof gen-minimalp)
                                     (all-vars1-lst clause nil))))
         (list :computed-hint-replacement
               (list (list 'r*-generalize-hint-cont
                           (list 'quote a) (list 'quote b)
                           'id 'clause))
               :clause-processor
               (list 'simple-generalize-cp
                     'clause
                     (list 'quote
                           (list (cons (list 'r*-proof-minimalp
                                             (list 'r*-proof a b) a b)
                                       'gen-minimalp)
                                 (cons (list 'r*-proof a b)
                                       'gen-proof))))))
        ;; Stage 3: induct along the recognizer at the fresh variable.
        ((member-equal (list 'not (list 'r*-proof-validp 'gen-proof a b))
                       clause)
         (list :induct (list 'r*-proof-validp 'gen-proof a b)))
        (t nil))))

  (local
    (defun r*-generalize-hint-fn (a b goal-spec id clause)
      (declare (xargs :guard t :verify-guards nil))
      ;; Stage 1, at the designated goal only.
      (and (equal (string-for-tilde-@-clause-id-phrase id) goal-spec)
           (member-equal (list 'not (list 'r* a b)) clause)
           (list :computed-hint-replacement
                 (list (list 'r*-generalize-hint-cont
                             (list 'quote a) (list 'quote b)
                             'id 'clause))
                 :expand (list (list :with 'r* (list 'r* a b)))
                 :in-theory '(e/d (r*-proof-validp
                                   r*-base-validp
                                   r*-refl-validp
                                   r*-trans-validp
                                   r*-base
                                   r*-refl
                                   r*-trans)
                                  (r*))))))

  (local
    (defmacro r*-generalize-hint (a b &key (goal '"Goal"))
      (list 'r*-generalize-hint-fn
            (list 'quote a) (list 'quote b) goal 'id 'clause)))

  (defthm r*-of-f
    (implies (r* a b)
             (r* (f a) (f b)))
    :hints ((r*-generalize-hint a b))))
